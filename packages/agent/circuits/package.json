{
  "name": "agent-circuits",
  "version": "1.0.0",
  "description": "ZK circuits for agent identity verification",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "generate-solidity": "npx snarkjs zkey export solidityverifier build/agent-identity_final.zkey build/AgentIdentityVerifier.sol",
    "deploy:base-sepolia": "forge script DeployAgentIdentityVerifier --rpc-url base_sepolia --broadcast",
    "deploy:monad-testnet": "forge script DeployAgentIdentityVerifier --rpc-url monad_testnet --broadcast",
    "test": "vitest run"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/snarkjs": "^0.7.9",
    "poseidon-lite": "^0.3.0",
    "vitest": "^3.0.0"
  }
}
