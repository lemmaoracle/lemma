---
import Layout from "../../layouts/Layout.astro";
import type { Locale } from "../../i18n/translations";

const locale: Locale = "en";
const slug = "ai-models-attack-resistance";
const title = "Six AI models, one identical attack \u2014 capability vs. attack resistance | Lemma";
const description = "We ran the same five attack scenarios against Fable 5 (Fable5), Opus 4.8, GPT-5.5, DeepSeek v4 Pro, Qwen3.7 Max and Kimi-K2.6. The result didn't track model strength.";
const ogImage = `https://lemma.frame00.com/og/compare/${slug}/${locale}.png`;
---
<Layout locale={locale} metaType="page" pagePath={`/compare/${slug}/`} title={title} description={description} ogImage={ogImage}>

