<script is:inline>
(function(){
  var rm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(rm){ document.querySelectorAll('.flow svg').forEach(function(s){ try{ s.pauseAnimations && s.pauseAnimations(); }catch(e){} }); }
  var blocks = document.querySelectorAll('section>.wrap, .impact>.wrap');
  function activate(el){
    el.classList.add('in');
    el.querySelectorAll('.fill[data-w]').forEach(function(f){ f.style.width = f.dataset.w; });
    el.querySelectorAll('[data-count]').forEach(function(e){
      var target = parseFloat(e.dataset.count), suf = e.dataset.suffix || '';
      if(isNaN(target)) return;
      if(rm){ e.textContent = target + suf; return; }
      var dur = 1000, t0 = null;
      requestAnimationFrame(function step(t){
        if(!t0) t0 = t;
        var p = Math.min(1, (t - t0) / dur);
        e.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + suf;
        if(p < 1) requestAnimationFrame(step);
      });
    });
  }
  try{
    if(rm || !('IntersectionObserver' in window)){ blocks.forEach(activate); return; }
    var io = new IntersectionObserver(function(es){ es.forEach(function(en){ if(en.isIntersecting){ activate(en.target); io.unobserve(en.target); } }); }, {threshold:0.16, rootMargin:'0px 0px -8% 0px'});
    blocks.forEach(function(b){ io.observe(b); });
  }catch(e){ blocks.forEach(activate); }
})();
</script>

<style is:global>

  :root{
    --font-display:"Cormorant Garamond","Noto Serif JP",Georgia,serif; --font-body:"DM Sans","Hiragino Sans","Noto Sans JP",sans-serif;
    --brown:#8B4513; --brown-d:#6b350f; --ink:#1c1a17; --muted:#6f675e; --line:#e7e0d6;
    --bg:#fbf8f3; --card:#fff; --cream:#f4ece0;
    --green:#2f7d4f; --green-bg:#e7f3ec; --red:#c0392b; --red-bg:#fbe9e6;
    --amber:#b5841f; --amber-bg:#f7eed8; --gray:#8a8178; --gray-bg:#efeae2; --dark:#1d1710;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:var(--font-body);color:var(--ink);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
  a{color:var(--brown);text-decoration:none}
  code{font-family:"SF Mono",ui-monospace,Menlo,monospace}
  .mock{background:#221a12;color:#f0e6d6;text-align:center;font-size:12.5px;padding:9px;letter-spacing:.03em}
  .topbar{border-bottom:1px solid var(--line);background:rgba(251,248,243,.92);backdrop-filter:blur(6px);position:sticky;top:0;z-index:20}
  .topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:58px}
  .logo{font-family:Georgia,serif;font-weight:600;font-size:21px;color:var(--brown)}
  .logo sup{font-size:11px}
  .navcta{font-size:13px;font-weight:700;color:#fff;background:var(--brown);border:1px solid var(--brown-d);padding:8px 16px;border-radius:8px;box-shadow:0 4px 13px rgba(139,69,19,.24);transition:transform .15s ease,box-shadow .2s ease}
  .navcta:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(139,69,19,.32);color:#fff}
  .hero{padding:52px 0 8px}
  .kicker{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--brown);font-weight:700;margin-bottom:16px}
  h1{font-size:clamp(28px,4vw,42px);line-height:1.16;letter-spacing:-.015em;margin-bottom:16px;max-width:900px}
  h1 .hl{color:var(--brown)}
  .lede{font-size:17px;color:#3a352f;max-width:720px}
  .lede b{color:var(--ink)}
  /* versus */
  .vs{display:grid;grid-template-columns:1fr 64px 1fr;gap:0;align-items:stretch;margin:32px 0 6px}
  .vs .side{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px}
  .vs .side .vn{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:700}
  .vs .side .nm{font-size:22px;font-weight:700;margin-top:6px;letter-spacing:-.01em}
  .vs .side .vd{font-size:12px;color:var(--muted);margin-top:2px}
  .vs .side .res{margin-top:16px;font-size:13.5px;color:#4a443d}
  .vs .side .tag{display:inline-block;font-size:12px;font-weight:700;padding:4px 11px;border-radius:99px;margin-top:14px}
  .vs .side.fa .tag{background:var(--amber-bg);color:var(--amber)}
  .vs .side.ki .tag{background:var(--red-bg);color:var(--red)}
  .vs .mid{display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-style:italic;font-size:22px;color:var(--brown)}
  @media(max-width:680px){.vs{grid-template-columns:1fr;gap:12px}.vs .mid{padding:6px}}
  .fcap{margin-top:14px;font-size:12.5px;color:var(--muted)}
  section{padding:48px 0;border-top:1px solid var(--line)}
  h2{font-size:25px;margin-bottom:10px;letter-spacing:-.01em}
  .sub{color:var(--muted);font-size:15px;margin-bottom:24px;max-width:760px}
  .step{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--brown);font-weight:700;margin-bottom:8px}
  .scn{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
  .scn .c{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 14px}
  .scn .c .n{font-size:12px;font-weight:700;color:var(--brown);margin-bottom:7px}
  .scn .c h4{font-size:14px;margin-bottom:5px} .scn .c p{font-size:12.5px;color:#4a443d}
  /* fable callout */
  .fable{background:#fff;border:1px solid var(--line);border-left:4px solid var(--red);border-radius:12px;padding:22px 24px}
  .fable .lab{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:8px}
  .fable h3{font-size:19px;margin-bottom:6px}
  .fable .probes{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
  .fable .pr{background:var(--red-bg);border-radius:10px;padding:14px 16px}
  .fable .pr .q{font-size:12.5px;color:var(--muted);margin-bottom:6px}
  .fable .pr .a{font-size:13.5px;color:#7a3127;font-weight:600}
  @media(max-width:680px){.fable .probes{grid-template-columns:1fr}.scn{grid-template-columns:1fr 1fr}}
  .pull{font-size:23px;font-weight:600;letter-spacing:-.01em;margin-top:8px;padding-left:18px;border-left:4px solid var(--brown);color:var(--ink)}
  /* impact band */
  .impact{background:var(--dark);color:#f4ece0;margin:0}
  .impact .wrap{padding:52px 24px}
  .impact .lead2{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#a8927a;font-weight:700;margin-bottom:18px}
  .impact .grid{display:grid;grid-template-columns:1fr 1fr;gap:0}
  .impact .cell{padding:8px 28px}
  .impact .cell:first-child{border-right:1px solid #43372a}
  .impact .huge{font-size:clamp(50px,8.5vw,86px);font-weight:800;line-height:.95;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .impact .r{color:#e8927f} .impact .g{color:#7fcf9b}
  .impact .small{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#a8927a;font-weight:700;margin-bottom:6px}
  .impact .cap{font-size:14.5px;color:#cbbba2;margin-top:12px;max-width:380px}
  @media(max-width:680px){.impact .grid{grid-template-columns:1fr}.impact .cell:first-child{border-right:none;border-bottom:1px solid #43372a;padding-bottom:26px;margin-bottom:22px}}
  .flow{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px;overflow-x:auto}
  .flow svg{min-width:680px;width:100%;height:auto;display:block}
  /* product */
  .product{background:linear-gradient(180deg,#fff,#fbf3ea);border:1px solid var(--brown);border-radius:16px;padding:28px 30px;margin-bottom:8px}
