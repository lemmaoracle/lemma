---
import PillarDetailTemplate from "../../templates/PillarDetailTemplate.astro";
import PillarDetailV4 from "../../templates/PillarDetailV4.astro";
import { getPillarV4Body, getPillarV4Meta } from "../../config/pillarsV4";
import { getAllPillars, getPillarBySlug } from "../../data/pillars";
import { getUseCasesBySlugs } from "../../data/useCases";
import { getAllPosts } from "../../data/blog";
import { getTranslations } from "../../i18n/translations";

export async function getStaticPaths() {
  const pillars = getAllPillars();
  const allPosts = await getAllPosts("en");

  const paths = await Promise.all(
    pillars.map(async (pillar) => {
      const useCases = await getUseCasesBySlugs(pillar.useCaseSlugs, "en");

      // Filter recent posts by pillar tags
      const recentPosts = allPosts
        .filter((post) => {
          if (!post.tags || post.tags.length === 0) return false;
          return pillar.tags.some((tag) =>
            post.tags?.some((postTag) => postTag.toLowerCase().includes(tag.toLowerCase())),
          );
        })
        .slice(0, 3);

      const otherPillars = pillars.filter((p) => p.slug !== pillar.slug);

      return {
        params: { slug: pillar.slug },
        props: { pillar, useCases, recentPosts, otherPillars },
      };
    }),
  );

  return paths;
}

interface Props {
  pillar: import("../../data/pillars").Pillar;
  useCases: readonly import("../../data/useCases").UseCase[];
  recentPosts: readonly import("../../data/blog").BlogPost[];
  otherPillars: readonly import("../../data/pillars").Pillar[];
}

const { pillar, useCases, recentPosts, otherPillars } = Astro.props;
const locale = "en" as const;
const t = getTranslations(locale);
const base = "";
const pillarT = t.pillars;

// v4 rollout: render the new page when an EN body exists; else legacy template.
const v4Body = getPillarV4Body(pillar.slug, "en");
const v4Meta = getPillarV4Meta(pillar.slug);
---

{v4Body && v4Meta ? (
  <PillarDetailV4
    locale={locale}
    t={t}
    base={base}
    pillar={pillar}
    body={v4Body}
    metaTitle={v4Meta.title.en}
    metaDescription={v4Meta.description.en}
  />
) : (
  <PillarDetailTemplate
    locale={locale}
    t={t}
    base={base}
    pillar={pillar}
    useCases={useCases}
    recentPosts={recentPosts}
    otherPillars={otherPillars}
    pillarT={pillarT}
  />
)}
