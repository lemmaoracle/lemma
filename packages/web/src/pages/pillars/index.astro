---
import PillarsHubV2 from "../../templates/PillarsHubV2.astro";
import { getTranslations } from "../../i18n/translations";
import bodyEn from "../../config/pillars-hub-v2/index.en.html?raw";

const locale = "en";
const t = getTranslations(locale);
const base = "";
const metaTitle =
  "Trust infrastructure for AI — cryptographic proof for provenance, AI decisions, authority & regulatory attributes | Lemma";
const metaDescription =
  "Trust infrastructure for AI. Four axes — provenance, AI decisions, agent authority, regulatory attributes — return a cryptographic proof for the data AI uses. Add one layer to your existing workflow and proof rides every step.";
---

<PillarsHubV2
  locale={locale}
  t={t}
  base={base}
  body={bodyEn}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
/>
