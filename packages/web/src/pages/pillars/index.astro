---
// /pillars — the canonical product page for the Lemma API (製品ページ実装指示 v1 /
// モック v18). Shares ProductPageTemplate with /ja/pillars; the old
// LemmaApiTemplate design was retired from this route. The short-lived
// /lemma-api route was removed earlier.
import ProductPageTemplate from "../../templates/ProductPageTemplate.astro";
import { getTranslations } from "../../i18n/translations";

const locale = "en";
const t = getTranslations(locale);
const base = "";
---

<ProductPageTemplate
  locale={locale}
  t={t}
  base={base}
  pagePath="/pillars/"
  ogImage="https://lemma.frame00.com/og/pillars/en.png"
/>
