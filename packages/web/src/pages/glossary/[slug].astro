---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { getTranslations } from "../../i18n/translations";
import type { GlossaryTerm } from "../../data/glossary";
import {
  GLOSSARY_TERMS_EN,
  getGlossaryTermEn,
  getEnCategoryLabel,
} from "../../data/glossary.en";
import { DISCOVERY_CALL, DISCOVERY_CALL_URL } from "../../config/cta";

export function getStaticPaths() {
  return GLOSSARY_TERMS_EN.map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

interface Props {
  term: GlossaryTerm;
}

const { term } = Astro.props as Props;
const locale = "en";
const t = getTranslations(locale);
const base = "";
const pagePath = `/glossary/${term.slug}/`;

const title = `${term.nameEn} — Lemma Oracle Glossary`;
const description = term.description;
const implementationHeading = term.implementationHeading ?? "Lemma Oracle implementation";
const categoryLabel = getEnCategoryLabel(term.category);

const SITE = "https://lemma.frame00.com";
const pageUrl = `${SITE}/glossary/${term.slug}/`;
const definedTermJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term.nameEn,
  alternateName: term.nameJa,
  description: term.description,
  inDefinedTermSet: `${SITE}/glossary/`,
  url: pageUrl,
  termCode: term.slug,
  inLanguage: "en",
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma Oracle", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Glossary", item: `${SITE}/glossary/` },
    { "@type": "ListItem", position: 3, name: term.nameEn, item: pageUrl },
  ],
};
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  title={title}
  description={description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(definedTermJsonLd)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />

  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="term">
    <section class="term-header">
      <div class="term-header-inner">
        <nav class="term-breadcrumb" aria-label="breadcrumb">
          <a href="/">Home</a><span class="term-breadcrumb-sep">/</span>
          <a href="/glossary/">Glossary</a><span class="term-breadcrumb-sep">/</span>
          <span>{term.nameEn}</span>
        </nav>
        <div class="term-header-category">{categoryLabel}</div>
        <h1 class="term-header-h1">{term.nameEn}</h1>
        <div class="term-header-en">{term.nameJa}</div>
        <p class="term-header-lead" set:html={term.lead}></p>
      </div>
    </section>

    <section class="term-body">
      <div class="term-body-inner">
        <h2>Definition</h2>
        {term.definition.map((p) => <p set:html={p}></p>)}
        <h2>{implementationHeading}</h2>
        {term.implementation.map((p) => <p set:html={p}></p>)}
      </div>
    </section>

    <section class="term-related">
      <div class="term-related-inner">
        <div class="term-related-label">Related</div>
        <h2>Related terms</h2>
        <div class="term-related-list">
          {term.related.map((rel) => {
            const target = getGlossaryTermEn(rel.slug);
            const name = target?.nameEn ?? rel.slug;
            return (
              <a class="term-related-item" href={`/glossary/${rel.slug}/`}>
                <div class="term-related-item-term">{name}</div>
                <div class="term-related-item-desc">{rel.desc}</div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="term-cta">
      <div class="term-cta-inner">
        <span class="term-cta-eyebrow">Get started</span>
        <h2 class="term-cta-h2">{term.ctaH2}</h2>
        <div class="term-cta-row">
          <a class="term-cta-primary" href={DISCOVERY_CALL_URL.en} target="_blank" rel="noopener">{DISCOVERY_CALL.en.buttonLabel}</a>
          <a
            class="term-cta-secondary"
            href="https://tally.so/r/7RJXdR"
            target="_blank"
            rel="noopener"
          >Download whitepaper</a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .term { background: var(--white); color: var(--gray-800); }

  /* HEADER */
  .term-header { padding: 128px 8% 48px; }
  .term-header-inner { max-width: 820px; margin: 0 auto; }
  .term-breadcrumb {
    font-family: var(--font-body);
    color: var(--gray-500);
    font-size: 12px;
    letter-spacing: 0.06em;
    margin-bottom: 28px;
  }
  .term-breadcrumb a {
    color: var(--gray-700);
    text-decoration: none;
    transition: color 0.2s;
  }
  .term-breadcrumb a:hover { color: var(--accent); }
  .term-breadcrumb-sep { margin: 0 8px; color: var(--gray-500); }
  .term-header-category {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .term-header-h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--gray-800);
    margin: 0 0 12px;
  }
  .term-header-en {
    font-family: var(--font-body);
    color: var(--gray-700);
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin-bottom: 24px;
  }
  .term-header-lead {
    font-family: var(--font-body);
    color: var(--gray-800);
    font-size: 18px;
    line-height: 1.75;
    font-weight: 400;
    max-width: 720px;
    border-left: 2px solid var(--accent);
    padding-left: 20px;
    margin: 0;
  }
  .term-header-lead :global(a) {
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
    text-decoration: none;
  }
  .term-header-lead :global(a:hover) { border-bottom-color: var(--accent); }

  /* BODY */
  .term-body { padding: 24px 8% 96px; }
  .term-body-inner { max-width: 820px; margin: 0 auto; }
  .term-body h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--gray-800);
    margin: 56px 0 20px;
  }
  .term-body h2:first-child { margin-top: 16px; }
  .term-body p {
    font-family: var(--font-body);
    color: var(--gray-800);
    font-size: 16px;
    line-height: 1.85;
    margin: 0 0 18px;
  }
  .term-body :global(code) {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: "SF Mono", Menlo, Monaco, "Courier New", monospace;
    font-size: 0.92em;
    color: var(--accent);
  }
  .term-body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
    text-decoration: none;
  }
  .term-body :global(a:hover) { border-bottom-color: var(--accent); }
  .term-body :global(strong) {
    font-weight: 500;
    color: var(--gray-800);
  }

  /* RELATED */
  .term-related {
    background: var(--gray-50);
    padding: 64px 8%;
    border-top: 1px solid var(--gray-200);
  }
  .term-related-inner { max-width: 820px; margin: 0 auto; }
  .term-related-label {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .term-related h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 500;
    color: var(--gray-800);
    margin: 0 0 28px;
  }
  .term-related-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--gray-200);
    border: 1px solid var(--gray-200);
  }
  .term-related-item {
    background: var(--white);
    padding: 22px 24px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
  }
  .term-related-item:hover { background: var(--accent-bg); }
  .term-related-item-term {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--gray-800);
    margin-bottom: 4px;
  }
  .term-related-item-desc {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--gray-700);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .term-related-list { grid-template-columns: 1fr; }
  }

  /* CTA */
  .term-cta {
    background: var(--black);
    color: #fff;
    padding: 96px 8%;
    text-align: center;
  }
  .term-cta-inner { max-width: 640px; margin: 0 auto; }
  .term-cta-eyebrow {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 24px;
    display: block;
  }
  .term-cta-h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 500;
    color: #fff;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 32px;
  }
  .term-cta-row {
    display: inline-flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .term-cta-primary,
  .term-cta-secondary {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .term-cta-primary {
    background: #fff;
    color: var(--gray-800);
    padding: 16px 36px;
  }
  .term-cta-primary:hover { background: var(--accent); color: #fff; }
  .term-cta-secondary {
    background: transparent;
    color: #fff;
    padding: 15px 35px;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .term-cta-secondary:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 640px) {
    .term-header { padding: 112px 6% 32px; }
    .term-body { padding: 16px 6% 64px; }
    .term-related { padding: 48px 6%; }
    .term-cta { padding: 72px 6%; }
  }
</style>
