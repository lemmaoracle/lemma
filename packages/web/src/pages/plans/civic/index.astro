---
/**
 * Lemma Civic — plan page for government & the public sector (B2B2G) (EN).
 *
 * EN mirror of /ja/plans/civic/. Buyer-facing, product-fit framing, FDE-led
 * (talk first), pricing on request (no ¥ / no figures).
 *
 * Permission gate: PRE-permission at launch. The MizuDAkO engagement must not
 * appear anywhere —
 *   - no achievement badge in the hero
 *   - §6 shows an "illustrative scenario" (NOT a case study); no water-infra /
 *     civic-participation / municipality-name context
 * After permission (press-release linked) the badge + a real case study replace
 * those; see the "POST-permission:" comments.
 *
 * Accent = saddle brown #8B4513 (matches the global --accent).
 */
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import HubSpotDrawer from "../../../components/HubSpotDrawer.astro";
import CivicIcon from "../../../components/civic/CivicIcon.astro";
import { getTranslations } from "../../../i18n/translations";
import { DISCOVERY_CALL_URL } from "../../../config/cta";

const locale = "en" as const;
const t = getTranslations(locale);
const base = "" as const;

const contactUrl = DISCOVERY_CALL_URL[locale];
const useCasesUrl = `${base}/solutions/use-cases/`;

const metaTitle =
  "Lemma Civic — Turn public-sector records into data you can trust your AI with | Plan for government & public services";
const metaDesc =
  "Give the records your public-sector operations generate — front desk, benefits, civic participation — verifiable authenticity without revealing their contents. No personal data exposed, no change to how you already work. For government and public services (B2B2G), tiered by the number of sites.";

const doItems = [
  {
    icon: "check",
    h: "Verify eligibility without revealing the contents",
    p: "Confirm eligibility, age, or qualifications — without exposing personal data.",
  },
  {
    icon: "history",
    h: "Tamper-proof provenance records",
    p: "Unalterable records for audit and accountability.",
  },
  {
    icon: "template",
    h: "Start small with standard templates",
    p: "Pick one workflow from ready-made public-sector templates.",
  },
] as const;

const flowItems = [
  {
    n: "01",
    icon: "inbox",
    h: "Collect",
    lead: "Residents and businesses submit records",
    p: "Through the same applications and activities as always — no new steps.",
  },
  {
    n: "02",
    icon: "shield-check",
    h: "Verify",
    lead: "Staff confirm without seeing the contents",
    p: "Confirm only that it meets the criteria and is genuine, then proceed.",
  },
  {
    n: "03",
    icon: "database",
    h: "Keep & use",
    lead: "Stored tamper-proof, ready for AI",
    p: "Kept in a form you can verify later — for audits and for AI alike.",
  },
] as const;

const tiers = [
  { name: "Tier 1", range: "1–3 sites" },
  { name: "Tier 2", range: "4–10 sites" },
  { name: "Tier 3", range: "11+ sites (custom)" },
];

const steps = [
  {
    n: "01",
    h: "Get in touch",
    lead: "Start with a conversation",
    p: "A 30-minute talk works too. No sensitive information required.",
  },
  {
    n: "02",
    h: "PoC",
    lead: "Prove it in a bounded scope",
    p: "Build and validate one scenario.",
  },
  {
    n: "03",
    h: "Production",
    lead: "Roll out without changing your operations",
    p: "Layer it in front — it runs alongside what you already have.",
  },
];

const useCases = [
  "Eligibility proof for subsidies and benefits (Payments)",
  "Eligibility proof for public services (Front desk)",
  "Proof of records and quotes for long-term contracts (Contracts)",
  "Proof of qualified staffing and safety training (Workforce)",
];
---

<Layout
  locale={locale}
  title={metaTitle}
  description={metaDesc}
  metaType="page"
  pagePath="/plans/civic/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="cv-page">
    <div class="cv-container">

      <!-- §1 HERO -->
      <section class="cv-hero">
        <div class="cv-hero-tags">
          <span class="cv-hero-badge">
            <span class="cv-hero-badge-tag">Plan</span>
            <span class="cv-hero-badge-name">Lemma Civic</span>
          </span>
          <span class="cv-hero-seg">Government &amp; public sector (B2B2G)</span>
        </div>
        <h1 class="cv-h1">
          Turn everyday public-sector records<br />
          <span class="cv-accent">into data AI can safely use.</span>
        </h1>
        <p class="cv-lead">
          For the records your front line generates — service desks, benefits, welfare consultations, civic participation — Lemma adds tamper-proof provenance and authenticity, without ever revealing what's inside. The result is a data foundation your AI can rely on: no personal information exposed, and no change to how you already work.
        </p>
        <div class="cv-hero-cta">
          <a href={contactUrl} class="cv-btn-primary" target="_blank" rel="noopener">Contact us</a>
          <span class="cv-hero-cta-note">Start with a conversation — about fit, scope, or pricing.</span>
        </div>
        {/*
          POST-permission: only when press-release-linked, place the achievement
          badge here. Pre-permission it is omitted to avoid identifying the
          engagement. Wording lives in the Wave 1 spec, not in this source.
        */}
      </section>

      <!-- §2 What this plan does -->
      <section class="cv-section" aria-labelledby="cv-do-h">
        <p class="cv-section-label">What this plan does</p>
        <h2 class="cv-section-h" id="cv-do-h">Pass on the certainty, not the contents.</h2>
        <div class="cv-do-grid">
          {doItems.map((item) => (
            <article class="cv-do-card">
              <span class="cv-do-icon"><CivicIcon name={item.icon} size={28} /></span>
              <h3 class="cv-do-h3">{item.h}</h3>
              <p class="cv-do-p">{item.p}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- §3 Bridge -->
      <section class="cv-bridge">
        <span class="cv-bridge-icon"><CivicIcon name="shield-check" size={32} color="#F5EBDC" /></span>
        <blockquote class="cv-bridge-quote">
          Hold nothing, leak nothing. Delegate the work — keep the proof.
        </blockquote>
        <p class="cv-bridge-body">
          Lemma sits between your front line and your AI, passing along only the certainty — never the contents. It takes on the hard parts, so you can keep working exactly as you do today and hand it off with confidence.
        </p>
      </section>

      <!-- §4 How it works -->
      <section class="cv-section" aria-labelledby="cv-flow-h">
        <p class="cv-section-label">How it works (no change to daily operations)</p>
        <h2 class="cv-section-h" id="cv-flow-h">No new steps to learn.</h2>
        <ol class="cv-flow-grid">
          {flowItems.map((item) => (
            <li class="cv-flow-card">
              <span class="cv-flow-head">
                <CivicIcon name={item.icon} size={22} />
                <span class="cv-flow-n">{item.n} {item.h}</span>
              </span>
              <h3 class="cv-flow-h3">{item.lead}</h3>
              <p class="cv-flow-p">{item.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- §5 Who it's for & plan structure -->
      <section class="cv-section cv-tiers" aria-labelledby="cv-tiers-h">
        <p class="cv-section-label">Who it's for &amp; plan structure</p>
        <h2 class="cv-section-h" id="cv-tiers-h">Tiered by number of sites.</h2>
        <p class="cv-tiers-body">
          For municipalities, public utilities, and businesses delivering citizen-facing services under a B2B2G model. Rollouts across multiple sites or municipalities are covered by tiers that scale with the number of sites.
        </p>
        <div class="cv-tiers-grid">
          {tiers.map((tier) => (
            <div class="cv-tier-card">
              <span class="cv-tier-name">{tier.name}</span>
              <span class="cv-tier-range">{tier.range}</span>
            </div>
          ))}
        </div>
        <p class="cv-tiers-note">
          Annual contract, priced by the number of sites. Upgrade to a higher tier as sites or usage grow. Built on standard circuits and templates.
        </p>
      </section>

      {/* §6 Use case (pre-permission = illustrative scenario).
          POST-permission (press-release linked): replace with a real case study —
          wording lives in the Wave 1 spec §6 (identifying context is withheld
          pre-permission, so it is not written here). JSX comment → not emitted to HTML. */}
      <section class="cv-case" aria-labelledby="cv-case-h">
        <span class="cv-case-label">Use case [illustrative scenario]</span>
        <h2 class="cv-case-h" id="cv-case-h">Proving eligibility for subsidies and benefits</h2>
        <p class="cv-case-body">
          Prove only that the eligibility requirements are met — without disclosing income or attributes — so the issuing body can verify it. A representative Civic use case that can be built from standard templates.
        </p>
      </section>

      <!-- §7 How we engage -->
      <section class="cv-section" aria-labelledby="cv-steps-h">
        <p class="cv-section-label">How we engage (we build it with you — without stopping your operations)</p>
        <h2 class="cv-section-h" id="cv-steps-h">Start small, scale without disruption.</h2>
        <ol class="cv-steps-grid">
          {steps.map((step) => (
            <li class="cv-step-card">
              <span class="cv-step-n">{step.n}</span>
              <h3 class="cv-step-h3">{step.h}</h3>
              <p class="cv-step-lead">{step.lead}</p>
              <p class="cv-step-p">{step.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- §8 Use cases in this plan -->
      <section class="cv-uc" aria-labelledby="cv-uc-h">
        <p class="cv-section-label">Use cases in this plan</p>
        <h2 class="cv-section-h" id="cv-uc-h">Pick by the problem you're solving.</h2>
        <ul class="cv-uc-list">
          {useCases.map((uc) => (
            <li class="cv-uc-item">{uc}</li>
          ))}
        </ul>
        <a href={useCasesUrl} class="cv-uc-all">See all →</a>
      </section>

      <!-- §9 Close -->
      <section class="cv-close">
        <div class="cv-close-band">
          <h2 class="cv-close-h2">We don't deploy and walk away.</h2>
          <p class="cv-close-sub">Our engineers embed with your team and stay alongside you. Talk to us about deployment — and about integrating with your operations and systems.</p>
          <a href={contactUrl} class="cv-btn-primary" target="_blank" rel="noopener">Contact us</a>
        </div>
      </section>

    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cv-page {
    --cv-display: "Sora", system-ui, sans-serif;
    --cv-body: "Sora", system-ui, sans-serif;
    --cv-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --cv-text-1: #1a1a1a;
    --cv-text-2: #3a3a3a;
    --cv-text-3: #5a5a5a;
    --cv-text-4: #9a9a9a;
    background: var(--lemma-cream);
    color: var(--cv-text-2);
    font-family: var(--cv-body);
    font-weight: 400;
    line-height: 1.7;
    margin-top: 64px;
    padding: 0 0 24px;
  }

  .cv-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .cv-accent { color: var(--accent); }

  /* ─── shared section heads ─── */
  .cv-section-label {
    font-family: var(--cv-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cv-section-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .cv-section-h {
    font-family: var(--cv-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }

  /* ─── §1 HERO ─── */
  .cv-hero {
    padding: 72px 0 56px;
  }
  .cv-hero-tags {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 26px;
  }
  .cv-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--lemma-brown-light);
    border: 1px solid rgba(139, 69, 19, 0.22);
    padding: 7px 8px 7px 14px;
    border-radius: 999px;
    box-shadow: 0 2px 10px rgba(139, 69, 19, 0.08);
  }
  .cv-hero-badge-tag {
    font-family: var(--cv-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.75;
    border-right: 1px solid rgba(139, 69, 19, 0.28);
    padding-right: 10px;
  }
  .cv-hero-badge-name {
    font-family: var(--cv-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--lemma-cream);
    background: var(--accent);
    padding: 3px 12px;
    border-radius: 999px;
  }
  .cv-hero-seg {
    font-family: var(--cv-display);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--cv-text-3);
  }
  .cv-h1 {
    font-family: var(--cv-display);
    font-size: clamp(32px, 5vw, 50px);
    font-weight: 700;
    line-height: 1.12;
    color: var(--black);
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    max-width: 920px;
  }
  .cv-lead {
    font-size: 16px;
    color: var(--cv-text-2);
    line-height: 1.8;
    margin: 0 0 32px;
    max-width: 720px;
  }
  .cv-hero-cta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .cv-hero-cta-note {
    font-size: 12.5px;
    color: var(--cv-text-3);
  }

  /* ─── primary button ─── */
  .cv-btn-primary {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--lemma-cream);
    font-family: var(--cv-display);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 14px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.18s;
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.18);
  }
  .cv-btn-primary:hover { background: #6e3610; }

  /* ─── generic section spacing ─── */
  .cv-section {
    padding: 56px 0;
    border-top: 0.5px solid var(--lemma-line);
  }

  /* ─── §2 cards ─── */
  .cv-do-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .cv-do-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 28px 26px;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cv-do-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(139, 69, 19, 0.06);
  }
  .cv-do-icon {
    display: block;
    line-height: 0;
    margin: 0 0 14px;
  }
  .cv-do-h3 {
    font-family: var(--cv-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .cv-do-p {
    font-size: 14px;
    color: var(--cv-text-3);
    line-height: 1.7;
    margin: 0;
  }

  /* ─── §3 bridge ─── */
  .cv-bridge {
    margin: 0;
    padding: 64px 40px;
    background: #0f0f0f;
    color: var(--lemma-cream);
    border-radius: 20px;
    text-align: center;
  }
  .cv-bridge-icon {
    display: inline-flex;
    line-height: 0;
    margin: 0 0 10px;
  }
  .cv-bridge-quote {
    font-family: var(--cv-display);
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--lemma-cream);
    margin: 0 0 20px;
  }
  .cv-bridge-body {
    font-size: 15px;
    line-height: 1.8;
    color: rgba(252, 250, 245, 0.72);
    margin: 0 auto;
    max-width: 660px;
  }

  /* ─── §4 / §7 numbered steps ─── */
  .cv-flow-grid,
  .cv-steps-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .cv-flow-card,
  .cv-step-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 26px 24px;
  }
  .cv-flow-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
    line-height: 0;
  }
  .cv-flow-head .cv-flow-n {
    margin: 0;
  }
  .cv-flow-n,
  .cv-step-n {
    font-family: var(--cv-mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    display: block;
    line-height: 1.3;
    margin: 0 0 14px;
  }
  .cv-flow-h3,
  .cv-step-h3 {
    font-family: var(--cv-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 6px;
  }
  .cv-step-lead {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--cv-text-2);
    margin: 0 0 8px;
  }
  .cv-flow-p,
  .cv-step-p {
    font-size: 13px;
    color: var(--cv-text-3);
    line-height: 1.7;
    margin: 0;
  }

  /* ─── §5 tiers ─── */
  .cv-tiers-body {
    font-size: 15px;
    color: var(--cv-text-2);
    line-height: 1.8;
    margin: 0 0 28px;
    max-width: 760px;
  }
  .cv-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin: 0 0 22px;
  }
  .cv-tier-card {
    background: var(--lemma-cream-deep);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cv-tier-name {
    font-family: var(--cv-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cv-tier-range {
    font-family: var(--cv-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
  }
  .cv-tiers-note {
    font-size: 12.5px;
    color: var(--cv-text-3);
    line-height: 1.7;
    margin: 0;
  }

  /* ─── §6 case ─── */
  .cv-case {
    margin: 56px 0;
    padding: 40px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 18px;
    position: relative;
    overflow: hidden;
  }
  .cv-case::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .cv-case-label {
    display: inline-flex;
    font-family: var(--cv-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lemma-cream);
    background: var(--accent);
    padding: 4px 11px;
    border-radius: 999px;
    margin: 0 0 16px;
  }
  .cv-case-h {
    font-family: var(--cv-display);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .cv-case-body {
    font-size: 14.5px;
    color: var(--cv-text-2);
    line-height: 1.8;
    margin: 0;
    max-width: 720px;
  }

  /* ─── §8 use cases ─── */
  .cv-uc-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 10px;
  }
  .cv-uc-item {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 14px;
    color: var(--cv-text-2);
    line-height: 1.5;
  }
  .cv-uc-all {
    font-family: var(--cv-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(139, 69, 19, 0.4);
    transition: color 0.15s, border-color 0.15s;
  }
  .cv-uc-all:hover { color: #6e3610; border-color: var(--accent); }

  /* ─── §9 close ─── */
  .cv-close {
    padding: 72px 0 0;
    border-top: 0.5px solid var(--lemma-line);
    text-align: center;
  }
  .cv-close-band {
    margin: 0 0 40px;
    padding: 52px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }
  .cv-close-band::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 96px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 3px;
  }
  .cv-close-h2 {
    font-family: var(--cv-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0 0 14px;
  }
  .cv-close-sub {
    font-size: 14.5px;
    color: var(--cv-text-2);
    line-height: 1.75;
    margin: 0 auto 28px;
    max-width: 560px;
  }

  /* ─── responsive ─── */
  @media (max-width: 720px) {
    .cv-container { padding: 0 22px; }
    .cv-hero { padding: 48px 0 40px; }
    .cv-bridge { padding: 48px 24px; }
    .cv-case { padding: 32px 24px; }
    .cv-close-band { padding: 40px 24px; }
  }
</style>
