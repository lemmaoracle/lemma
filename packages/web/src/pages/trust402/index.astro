<!-- v9 — play the Allow/Deny log once on viewport entry -->
<script is:inline>
  (function () {
    var log = document.getElementById('scopeLog');
    if (!log || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { log.classList.add('play'); io.disconnect(); }
      });
    }, { threshold: 0.35 });
    io.observe(log);
  })();
</script>

