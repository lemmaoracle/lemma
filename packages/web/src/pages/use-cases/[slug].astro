---
import UseCaseDetailTemplate from "../../templates/UseCaseDetailTemplate.astro";
import { getAllUseCases, getUseCaseBySlug } from "../../data/useCases";
import { getPillarBySlug } from "../../data/pillars";
import { getTranslations } from "../../i18n/translations";

export async function getStaticPaths() {
  const useCases = await getAllUseCases();

  const paths = useCases.map((useCase) => {
    const pillar = getPillarBySlug(useCase.pillar);

    return {
      params: { slug: useCase.slug },
      props: { useCase, pillar },
    };
  });

  return paths;
}

interface Props {
  useCase: import("../../data/useCases").UseCase;
  pillar: import("../../data/pillars").Pillar | undefined;
}

const { useCase, pillar } = Astro.props;
const locale = "en" as const;
const t = getTranslations(locale);
const base = "";
const pillarT = t.pillars;
const useCaseT = t.useCases;

// Fallback pillar if not found
const fallbackPillar = {
  slug: "verifiable-origin" as const,
  title: "Verifiable Origin",
  slogan: "Cryptographically valid ≠ semantically right",
  subtitle: { en: "Incident-grade Data Trust", ja: "インシデント級のデータ信頼" },
  problemStatement: { en: "", ja: "" },
  whyNow: { en: "", ja: "" },
  howLemmaFits: { en: [], ja: [] },
  useCaseSlugs: [],
  primaryCTA: { label: "Talk to us", href: "/services", type: "talk-to-us" as const },
  order: 1,
  tags: [],
};

const actualPillar = pillar ?? fallbackPillar;
---

<UseCaseDetailTemplate
  locale={locale}
  t={t}
  base={base}
  useCase={useCase}
  pillar={actualPillar}
  pillarT={pillarT}
  useCaseT={useCaseT}
/>
