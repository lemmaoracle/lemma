---
/* 日本語はデザイン移行版（AuthenticityJaTemplate）。英語 /authenticity/ は
   従来の AuthenticityTemplate のまま——今回は JA を先行させる判断のため。 */
import AuthenticityJaTemplate from "../../templates/AuthenticityJaTemplate.astro";
import { getTranslations } from "../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
---

<AuthenticityJaTemplate locale={locale} t={t} base={base} />
