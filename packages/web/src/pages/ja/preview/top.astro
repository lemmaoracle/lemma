---
/**
 * `/ja/preview/top/` — 新トップページ案の社内プレビュー。
 *
 * noindex ＋ sitemap 除外（astro.config.mjs の filter で `/preview/` を落とす）。
 * サイト内のどこからもリンクしない。EN 版は作らない（指示 v1 §1）。
 */
import PreviewTopTemplate from "../../../templates/PreviewTopTemplate.astro";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
---

<PreviewTopTemplate locale={locale} t={t} base={base} />
