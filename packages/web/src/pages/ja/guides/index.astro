---
import GuidesIndexTemplate from "../../../templates/GuidesIndexTemplate.astro";
import CoreCryptoSections from "../../../components/CoreCryptoSections.astro";
import { getBlogSections } from "../../../data/blog";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";

const sections = await getBlogSections(locale);

/* 並び順: 実装ジャーニー順 (まず触る→定義→暗号化→証明→開示→クエリ→来歴)。
   上の「仕組み」3フェーズ (発行→開示→検証) と同じ流れに揃える。
   未知の slug は末尾に日付順で落ちる。 */
const GUIDE_ORDER = [
  "dashboard-quickstart",
  "define-your-domain-as-a-schema",
  "encrypt-everything-expose-nothing",
  "prove-facts-with-zero-knowledge",
  "disclose-only-what-ai-needs",
  "query-verified-attributes",
  "provenance-that-never-disappears",
];
const orderOf = (slug: string) => {
  const i = GUIDE_ORDER.indexOf(slug);
  return i === -1 ? GUIDE_ORDER.length : i;
};
const guides = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "ガイド" || p.category === "Guides")
  .slice()
  .sort((a, b) => orderOf(a.slug) - orderOf(b.slug));
const foundations = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "基盤" || p.category === "Foundations");
---

<GuidesIndexTemplate locale={locale} t={t} base={base} guides={guides} foundations={foundations}>
  {
    /*
    製品ページ（/ja/pillars/）の「仕組み」と「独自の暗号技術、3つの中核」を
    そのまま移設した帯。図（インライン SVG）が本体なので、リンクに置き換えず
    丸ごと持ってくる。3つの中核側は #core-crypto を維持（既存の被リンク先）。
  */
  }
  {
    /*
    「仕組み」「3つの中核」を /ja/pillars/ からまるまる移植したもの（図版込み）。
    仕様書 CTA は既定だと /ja/guides（このページ自身）を指してしまうため、
    実体である仕様ドキュメントへ向ける。
  */
  }
  <CoreCryptoSections
    slot="feature"
    locale={locale}
    base={base}
    coresId="core-crypto"
    specsHref={`${base}/blog/lemma-oracle-specs`}
  />
</GuidesIndexTemplate>
