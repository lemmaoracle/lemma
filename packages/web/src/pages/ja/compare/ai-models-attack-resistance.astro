  .bar .track{background:var(--gray-bg);border-radius:7px;height:26px;position:relative;overflow:hidden}
  .bar .fill{height:100%;border-radius:7px;background:linear-gradient(90deg,#d65a48,#c0392b);display:flex;align-items:center;justify-content:flex-end;padding-right:9px;color:#fff;font-size:12px;font-weight:700}
  .bar.refuse .fill{background:repeating-linear-gradient(45deg,#e7d6b0,#e7d6b0 6px,#efe2c4 6px,#efe2c4 12px);color:var(--amber)}
  .bar .val{font-size:14px;font-weight:700;text-align:right;font-variant-numeric:tabular-nums}
  .barnote{font-size:12.5px;color:var(--muted);margin-top:14px;padding-top:14px;border-top:1px dashed var(--line)}
  .barnote b{color:var(--amber)}
  .pull{font-size:23px;font-weight:600;letter-spacing:-.01em;margin-top:30px;padding-left:18px;border-left:4px solid var(--brown);color:var(--ink)}
  /* impact band */
  .impact{background:var(--dark);color:#f4ece0;margin:0}
  .impact .wrap{padding:52px 24px}
  .impact .lead2{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#a8927a;font-weight:700;margin-bottom:18px}
  .impact .grid{display:grid;grid-template-columns:1fr 1fr;gap:0}
  .impact .cell{padding:8px 28px}
  .impact .cell:first-child{border-right:1px solid #43372a}
  .impact .huge{font-size:clamp(50px,8.5vw,86px);font-weight:800;line-height:.95;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .impact .r{color:#e8927f} .impact .g{color:#7fcf9b}
  .impact .small{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#a8927a;font-weight:700;margin-bottom:6px}
  .impact .cap{font-size:14.5px;color:#cbbba2;margin-top:12px;max-width:380px}
  @media(max-width:680px){.impact .grid{grid-template-columns:1fr}.impact .cell:first-child{border-right:none;border-bottom:1px solid #43372a;padding-bottom:26px;margin-bottom:22px}}
  /* flow */
  .flow{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px;overflow-x:auto}
  .flow svg{min-width:680px;width:100%;height:auto;display:block}
  /* poc steps */
  .poc{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:4px}
  .poc .s{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 16px;position:relative}
  .poc .s .n{font-family:Georgia,serif;font-size:15px;color:var(--brown);font-weight:700}
  .poc .s h4{font-size:14.5px;margin:6px 0 5px}
  .poc .s p{font-size:12.5px;color:#4a443d}
  @media(max-width:760px){.poc{grid-template-columns:1fr 1fr}}
  @media(max-width:460px){.poc{grid-template-columns:1fr}}
  /* layer2 defense contrast (dark) */
  .cx{display:grid;gap:0;border:1px solid #3a2f22;border-radius:14px;overflow:hidden;background:var(--dark)}
  .cxrow{display:grid;grid-template-columns:150px 1fr 1.15fr}
  .cxrow>div{padding:13px 16px;border-bottom:1px solid #3a2f22}
  .cxrow:last-child>div{border-bottom:none}
  .cxrow.hd>div{background:#2a2117;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#cbb89a;font-weight:700}
  .cxs{font-weight:700;font-size:14px;color:#f4ece0;display:flex;align-items:center;gap:6px;border-right:1px solid #3a2f22}
  .cxd{font-size:13.5px;color:#bcae98;border-right:1px solid #3a2f22}
  .cxb{font-size:13.5px;color:#e8927f}
  .cxd.none{color:#f0a89a;font-weight:700;background:rgba(192,57,43,.16)}
  .cx .lbl{display:none;font-size:10.5px;color:#9a8c79;font-weight:700;letter-spacing:.06em;margin-bottom:4px;text-transform:uppercase}
  @media(max-width:680px){.cxrow.hd{display:none}.cxrow{grid-template-columns:1fr}.cxrow>div{border-right:none}.cxs{border-bottom:1px solid #3a2f22}.cx .lbl{display:block}}
  /* one-line code */
  .oneline{background:var(--dark);border-radius:12px;padding:18px 20px;margin-top:18px;font-family:"SF Mono",ui-monospace,Menlo,monospace;font-size:13.5px;color:#e3d6c0;overflow-x:auto}
  .oneline .cm{color:#9a8c79} .oneline .kw{color:#e0b48a} .oneline .ok{color:#7fcf9b}
  /* ---- social-engineering singularity: void → shield motif ---- */
  .singularity{position:relative;overflow:hidden;margin-top:18px;background:linear-gradient(135deg,#241a12,#15100a);border:1px solid #4a3a26;border-radius:18px;padding:34px 30px}
  .singularity .sg-glow{position:absolute;top:-45%;left:50%;transform:translateX(-50%);width:560px;height:420px;background:radial-gradient(circle,rgba(199,154,106,.20),transparent 62%);pointer-events:none}
  .singularity>*{position:relative}
  .sg-eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#e0b48a;font-weight:700;margin-bottom:10px}
  .singularity h3{font-family:var(--font-display);font-size:clamp(22px,3.4vw,30px);font-weight:600;color:#f4ece0;line-height:1.26;letter-spacing:-.01em;margin-bottom:24px;max-width:680px}
  .sg-motif{display:flex;align-items:stretch;gap:16px;flex-wrap:wrap;margin:4px 0 22px}
  .sg-stage{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;flex:1;min-width:150px;padding:24px 16px;border-radius:14px;border:1px solid #3a2f22;background:rgba(244,236,224,.03);text-align:center}
  .sg-stage.armed{border-color:#5a4630;background:rgba(199,154,106,.09);box-shadow:0 10px 36px rgba(199,154,106,.16)}
  .sg-stage svg{filter:drop-shadow(0 4px 14px rgba(0,0,0,.4))}
  .sg-stage.armed svg{filter:drop-shadow(0 4px 20px rgba(199,154,106,.5));animation:sgpulse 2.6s ease-in-out infinite}
  .sg-stage .sg-lab{font-size:14.5px;font-weight:700;letter-spacing:.01em}
  .sg-stage.void .sg-lab{color:#a8927a}
  .sg-stage.armed .sg-lab{color:#f4ece0}
  .sg-arrow{display:flex;align-items:center;font-size:26px;color:#e0b48a;font-weight:700;flex:0 0 auto}
  .sg-body{font-size:14px;color:#cbbba2;max-width:680px;line-height:1.72}
  .sg-body b{color:#f0e6d6}
  @keyframes sgpulse{0%,100%{filter:drop-shadow(0 4px 16px rgba(199,154,106,.32))}50%{filter:drop-shadow(0 6px 26px rgba(199,154,106,.7))}}
  @media(max-width:700px){.sg-motif{flex-direction:column;gap:12px}.sg-arrow{transform:rotate(90deg);justify-content:center}.sg-stage{width:100%}}
  /* ---- eq pipeline: sequential animated flow ---- */
  .eq .box.atk{--gl:rgba(192,57,43,.30)} .eq .box.add{--gl:rgba(199,154,106,.36)} .eq .box.res{--gl:rgba(47,125,79,.30)}
  .eq .box{animation:eqp 3.6s ease-in-out infinite}
  .eq .box.add{animation-delay:1.2s} .eq .box.res{animation-delay:2.4s}
  @keyframes eqp{0%,38%,100%{box-shadow:0 6px 18px rgba(40,30,16,.06)}12%,24%{box-shadow:0 12px 36px var(--gl)}}
  /* eq connectors: attack packets flow and are BLOCKED at the proof gate (the shield/wall) */
  .eq .op{position:relative;width:54px;height:22px;flex:0 0 auto;align-self:center;font-size:0;color:transparent;animation:none}
  .eq .op::before{content:"";position:absolute;top:50%;left:3px;right:9px;height:2px;transform:translateY(-50%);background:repeating-linear-gradient(90deg,#c79a6a 0 5px,transparent 5px 10px);opacity:.55}
  /* arrow 1 (attack → gate): right end is the gate's barrier; packets stop dead here */
  .eq .op:first-of-type::after{content:"";position:absolute;top:50%;right:2px;width:4px;height:20px;transform:translateY(-50%);border-radius:2px;background:linear-gradient(180deg,#e0b48a,#8B4513);box-shadow:0 0 9px rgba(199,154,106,.65)}
  .eq .op:first-of-type .pkt{position:absolute;top:50%;left:0;width:9px;height:9px;margin-top:-4.5px;border-radius:50%;background:#c0392b;box-shadow:0 0 10px rgba(192,57,43,.85);animation:flowblock 1.9s cubic-bezier(.45,0,.85,1) infinite}
  .eq .op:first-of-type .pkt:nth-child(2){animation-delay:.95s}
  @keyframes flowblock{0%{left:0;opacity:0;transform:scale(.6)}12%{opacity:1;transform:scale(1)}64%{left:calc(100% - 17px);opacity:1;transform:scale(1)}76%{left:calc(100% - 17px);transform:scale(1.4);opacity:1}100%{left:calc(100% - 17px);opacity:0;transform:scale(.4)}}
  /* arrow 2 (gate → result): plain arrowhead, no flow — the attack was already stopped */
  .eq .op:last-of-type::after{content:"";position:absolute;top:50%;right:2px;width:0;height:0;transform:translateY(-50%);border-left:8px solid #c79a6a;border-top:5px solid transparent;border-bottom:5px solid transparent}
  .eq .op:last-of-type .pkt{display:none}
  /* eq result: block/stop emphasis — static icon (no movement) */
  .eq .box.res{border-width:2px}
  .eq .box.res .ic.stop{font-size:30px;line-height:1}
  .eq .box.res .blocktag{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.05em;color:#fff;background:var(--green);padding:3px 11px;border-radius:99px;margin:0 0 8px;box-shadow:0 2px 8px rgba(47,125,79,.3)}
  /* make the Lemma proof gate the hero of the equation; calm the flanks */
  .eq .box.atk,.eq .box.res,.eq .box.add{animation:none}
  .eq .box.res{border-width:1px}
  .eq .box.add{border:2px solid #e0b48a;background:linear-gradient(180deg,#fff,#fbeede);box-shadow:0 16px 46px rgba(199,154,106,.34)!important;position:relative;z-index:2}
  .eq .box.add::after{content:"";position:absolute;inset:-3px;border-radius:15px;pointer-events:none;animation:gatepulse 2.4s ease-in-out infinite}
  @keyframes gatepulse{0%,100%{box-shadow:0 0 0 1px rgba(224,180,138,.4),0 0 22px rgba(199,154,106,.32)}50%{box-shadow:0 0 0 1px rgba(224,180,138,.72),0 0 42px rgba(199,154,106,.62)}}
  .eq .box.add .ic{font-size:28px}
  .eq .box.add .t{font-size:14px}
  @media (prefers-reduced-motion: reduce){.eq .box,.eq .box.add::after,.eq .op:first-of-type .pkt,.sg-stage.armed svg{animation:none}.eq .op:first-of-type .pkt{opacity:1;left:50%}.eq .box.add::after{box-shadow:0 0 0 1px rgba(224,180,138,.6),0 0 30px rgba(199,154,106,.45)}}
  /* method = quiet footnote: dark/subdued so it doesn't read as a highlight */
  #method{background:#1a130c;border-top:1px solid #3a2f22}
  #method h2{color:#cbbba2;font-size:20px}
  #method .sub{color:#9a8c79}
  #method .method{color:#bcae98}
  #method .method li{border-bottom-color:#3a2f22}
  #method .method li b{color:#e6d8c2}
  #method .method a{color:#e0b48a}
  #method .honest{background:rgba(244,236,224,.04);border:1px solid #3a2f22;color:#9a8c79}
  #method .honest b{color:#e6d8c2}
  #method code{background:rgba(244,236,224,.08);color:#e0b48a;padding:1px 5px;border-radius:4px}
  /* ---- 06 Solution: brown branded band — Lemma as THE solution ---- */
  #adopt{background:linear-gradient(180deg,#2c2015,#1f1610);border-top:1px solid #4a3a26}
  #adopt .step{color:#e9b682}
  #adopt h2{color:#f7f1e7}
  #adopt .sub{color:#cbbba2}
  #adopt .pull{color:#f4ece0;border-left-color:#c79a6a}
