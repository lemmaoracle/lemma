  .honest{background:var(--cream);border-radius:12px;padding:20px 24px;font-size:13px;color:#5b5249;margin-top:22px}
  .honest b{color:var(--ink)}
  footer{border-top:1px solid #3a2f22;background:var(--dark);padding:48px 0 30px;color:#cbbba2;font-size:13px}
  .ft-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:18px;padding-bottom:26px;border-bottom:1px solid #3a2f22}
  .ft-brand{max-width:380px}
