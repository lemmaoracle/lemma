    color:var(--ink);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
  a{color:var(--brown);text-decoration:none}
  code,.mono{font-family:"SF Mono",ui-monospace,Menlo,Consolas,monospace}
  .mock{background:#221a12;color:#f0e6d6;text-align:center;font-size:12.5px;padding:9px;letter-spacing:.03em}
  .topbar{border-bottom:1px solid var(--line);background:rgba(251,248,243,.92);backdrop-filter:blur(6px);position:sticky;top:0;z-index:20}
  .topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:58px}
  .logo{font-family:Georgia,serif;font-weight:600;font-size:21px;color:var(--brown)}
  .logo sup{font-size:11px}
  .navcta{font-size:13px;font-weight:700;color:#fff;background:var(--brown);border:1px solid var(--brown-d);padding:8px 16px;border-radius:8px;box-shadow:0 4px 13px rgba(139,69,19,.24);transition:transform .15s ease,box-shadow .2s ease}
  .navcta:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(139,69,19,.32);color:#fff}
  /* hero */
  .hero{padding:52px 0 8px}
  .kicker{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--brown);font-weight:700;margin-bottom:16px}
  h1{font-size:clamp(28px,4vw,42px);line-height:1.16;letter-spacing:-.015em;margin-bottom:16px;max-width:920px}
  h1 .hl{color:var(--brown)}
  .lede{font-size:17px;color:#3a352f;max-width:730px}
  .lede b{color:var(--ink)}
  /* setup grid (hero) */
  .setupwrap{margin:32px 0 6px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px}
  .setupgrid{display:grid;grid-template-columns:150px repeat(5,1fr);gap:6px;min-width:560px}
  .setupgrid .gh{font-size:11px;color:var(--muted);text-align:center;padding:4px 2px;line-height:1.25;align-self:end}
  .setupgrid .gm{font-size:13px;font-weight:600;display:flex;align-items:center;padding-right:8px}
  .setupgrid .gc{height:34px;border-radius:7px;background:var(--cream);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:#c3b49a;font-size:14px}
  .setupscroll{overflow-x:auto}
  .fcap{margin-top:14px;font-size:12.5px;color:var(--muted)}
  /* hero test board */
  .board{margin:30px 0 0;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .board-h{display:flex;justify-content:space-between;align-items:center;gap:10px;background:var(--dark);color:#e3d6c0;padding:11px 18px;font-size:12px;font-family:"SF Mono",ui-monospace,Menlo,monospace;letter-spacing:.03em}
  .board-h span:first-child{font-weight:700;letter-spacing:.18em;color:#f4ece0}
  .boardscroll{overflow-x:auto;padding:18px}
  .bgrid{display:grid;grid-template-columns:160px repeat(5,1fr);gap:7px;min-width:580px}
  .bgrid .gh{font-size:10.5px;color:var(--muted);text-align:center;align-self:end;padding:0 2px 5px;line-height:1.2;font-weight:600}
  .bgrid .gm{font-size:13px;font-weight:700;display:flex;flex-direction:column;justify-content:center}
