    --bg:#fbf8f3; --card:#fff; --cream:#f4ece0;
    --green:#2f7d4f; --green-bg:#e7f3ec; --red:#c0392b; --red-bg:#fbe9e6;
    --amber:#b5841f; --amber-bg:#f7eed8; --gray:#8a8178; --gray-bg:#efeae2;
    --dark:#1d1710; --term-dim:#b9a98f;
  }
  *{box-sizing:border-box;margin:0;padding:0}
