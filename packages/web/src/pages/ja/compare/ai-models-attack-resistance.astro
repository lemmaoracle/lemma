  .ft-soc{display:flex;gap:10px;margin-top:14px}
  .ft-soc a{font-size:12px;font-weight:700;color:#e6cba6;border:1px solid #4a3a26;border-radius:6px;padding:5px 10px;background:rgba(244,236,224,.04)}
  .ft-soc a:hover{color:#fff}
  .ft-cols{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;padding:28px 0}
  .ft-cols h5{font-size:12px;letter-spacing:.04em;color:#f4ece0;font-weight:700;margin-bottom:10px}
