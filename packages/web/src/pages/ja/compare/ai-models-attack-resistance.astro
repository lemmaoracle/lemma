  #adopt .legend{color:#cbbba2}
  #adopt .oneline{border:1px solid #4a3a26}
  #adopt .product,#adopt .singularity,#adopt .oneline,#adopt .ctacard{box-shadow:0 16px 44px rgba(0,0,0,.36)}
  #adopt .panel,#adopt .tbox,#adopt .poc .s{box-shadow:0 12px 32px rgba(0,0,0,.24)}
  /* matrix */
  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px 14px 0 0;border-bottom:none;padding:14px 18px;display:flex;gap:20px;flex-wrap:wrap;align-items:center}
  .ctl{display:flex;align-items:center;gap:9px}
  .ctl label{font-size:12.5px;color:var(--muted);font-weight:600}
  .seg{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden}
  .seg button{border:none;background:var(--card);padding:7px 14px;font-size:13px;cursor:pointer;color:var(--muted);font-weight:600}
  .seg button.on{background:var(--brown);color:#fff}
  select{font-size:13px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);cursor:pointer}
  .tbox{overflow-x:auto;border:1px solid var(--line);border-radius:0 0 14px 14px;background:var(--card)}
  table{border-collapse:collapse;width:100%;min-width:720px;font-size:14px}
  thead th{background:var(--cream);padding:12px 10px;font-weight:600;font-size:12.5px;color:#5b5249;border-bottom:1px solid var(--line);text-align:center;white-space:nowrap}
  thead th.model{text-align:left;width:200px;position:sticky;left:0;background:var(--cream);z-index:2}
  tbody td{padding:11px 10px;border-bottom:1px solid #f1ebe1;border-left:1px solid #f4eee5;text-align:center}
  tbody td.model{text-align:left;position:sticky;left:0;background:var(--card);z-index:1;font-weight:600}
  tbody td.model small{display:block;font-weight:400;color:var(--muted);font-size:11.5px}
  tbody tr:last-child td{border-bottom:none}
  tbody tr.sec td.model{color:var(--green)} tbody tr.sec{background:#fcfdfc}
  .pill{display:inline-block;font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:99px;white-space:nowrap}
  .p-break{color:var(--red);background:var(--red-bg)} .p-no{color:var(--gray);background:var(--gray-bg)}
  .p-refuse{color:var(--amber);background:var(--amber-bg)} .p-block{color:var(--green);background:var(--green-bg)}
  .scoretag{font-weight:700;font-variant-numeric:tabular-nums}
  .legend{display:flex;flex-wrap:wrap;gap:15px;margin-top:14px;font-size:12.5px;color:var(--muted)}
  .legend span{display:flex;align-items:center;gap:7px}
  /* equation */
  .eq{display:flex;align-items:stretch;gap:12px;flex-wrap:wrap;margin-top:8px}
  .eq .box{flex:1;min-width:150px;border:1px solid var(--line);border-radius:12px;padding:16px 18px;background:var(--card)}
  .eq .box.add{border-color:var(--brown);background:linear-gradient(180deg,#fff,#fbf3ea)}
  .eq .box.res{border-color:var(--green);background:var(--green-bg)}
  .eq .box .t{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:8px}
  .eq .box.add .t{color:var(--brown)} .eq .box.res .t{color:var(--green)}
  .eq .box ul{list-style:none;font-size:13px}
  .eq .box li{padding:3px 0;color:#4a443d} .eq .box li b{color:var(--ink)}
  .eq .op{display:flex;align-items:center;font-size:24px;color:var(--muted)}
  /* cta */
  .cta{background:linear-gradient(180deg,#fff,var(--cream));border:1px solid var(--line);border-radius:16px;padding:36px}
  .cta h2{font-size:24px} .cta p{color:#4a443d;max-width:620px;margin:10px 0 22px;font-size:15px}
  .btn{display:inline-block;background:var(--brown);color:#fff;font-weight:600;font-size:15px;padding:13px 26px;border-radius:10px;border:1px solid var(--brown-d)}
  .btn.ghost{background:transparent;color:var(--brown);margin-left:8px}
  .fine{font-size:12px;color:var(--muted);margin-top:14px}
  .method{font-size:13.5px;color:#4a443d}
