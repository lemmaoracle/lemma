  .pname{font-family:Georgia,serif;font-size:38px;font-weight:700;color:var(--brown);margin-top:14px;line-height:1}
  .ptag{font-size:17px;font-weight:600;margin-top:8px}
  .pdesc{font-size:14.5px;color:#4a443d;margin-top:12px;max-width:760px}
  .pstd{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
  .pstd span{font-size:11.5px;font-family:"SF Mono",ui-monospace,Menlo,monospace;background:#fff;border:1px solid var(--line);border-radius:6px;padding:5px 10px;color:#5b5249}
  /* two-path cta */
  .ctas{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:24px}
  .ctacard{background:linear-gradient(180deg,#fff,var(--cream));border:1px solid var(--line);border-top:3px solid var(--brown);border-radius:16px;padding:28px}
  .ctacard.alt{background:var(--dark);border:1px solid #3a2f22;border-top:3px solid #c79a6a}
  .ctak{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--brown);font-weight:700;margin-bottom:8px}
  .ctacard h3{font-size:19px;margin-bottom:8px}
  .ctacard p{font-size:14px;color:#4a443d;margin-bottom:18px}
  .ctacard.alt .ctak{color:#e0b48a}
  .ctacard.alt h3{color:#f4ece0}
  .ctacard.alt p{color:#cbbba2}
  .ctacard.alt .fine{color:#a8927a}
  .ctacard.alt .fine a{color:#e6cba6}
  .ctacard.alt .btn{background:#f4ece0;color:#2a2117;border-color:#f4ece0}
  @media(max-width:760px){.ctas{grid-template-columns:1fr}}
  /* fable callout */
  .fable{background:#fff;border:1px solid var(--line);border-left:4px solid var(--red);border-radius:12px;padding:22px 24px;margin-top:8px}
  .fable .lab{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:8px}
  .fable h3{font-size:19px;margin-bottom:6px}
  .fable .probes{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
  .fable .pr{background:var(--red-bg);border-radius:10px;padding:14px 16px}
  .fable .pr .q{font-size:12.5px;color:var(--muted);margin-bottom:6px}
  .fable .pr .a{font-size:13.5px;color:#7a3127;font-weight:600}
  @media(max-width:680px){.fable .probes{grid-template-columns:1fr}}
  /* sections */
  section{padding:48px 0;border-top:1px solid var(--line)}
  h2{font-size:25px;margin-bottom:10px;letter-spacing:-.01em}
  .sub{color:var(--muted);font-size:15px;margin-bottom:24px;max-width:760px}
  .step{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--brown);font-weight:700;margin-bottom:8px}
  /* scenario cards */
  .scn{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
  .scn .c{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 14px}
  .scn .c .n{font-size:12px;font-weight:700;color:var(--brown);margin-bottom:7px}
  .scn .c h4{font-size:14px;margin-bottom:5px} .scn .c p{font-size:12.5px;color:#4a443d}
  .setupline{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
  .chip{font-size:12.5px;background:var(--cream);border:1px solid var(--line);border-radius:99px;padding:6px 13px;color:#5b5249}
  /* bar chart */
  .bars{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px 26px}
  .bar{display:grid;grid-template-columns:130px 1fr 54px;align-items:center;gap:14px;padding:9px 0}
  .bar .name{font-size:13.5px;font-weight:600}
