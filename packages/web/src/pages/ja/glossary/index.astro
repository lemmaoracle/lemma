---
/**
 * Glossary index (JA) — v24 chrome.
 *
 * Mirror of /glossary/index.astro for the JA locale. Same v24 styling,
 * JA-resolved labels (nameJa, JA category headings).
 */
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import { getTranslations } from "../../../i18n/translations";
import {
  GLOSSARY_TERMS,
  getGlossaryByCategory,
} from "../../../data/glossary";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const pagePath = "/glossary/";
const groups = getGlossaryByCategory();

const title = "用語集 — Lemma Oracle";
const description =
  "Lemma Oracle が扱う暗号レイヤ、検証可能AI、エージェントプロトコル、規制適合の中核用語。23 用語を製品文脈と一次ソースで解説。";

const SITE = "https://lemma.frame00.com";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma Oracle", item: `${SITE}/ja/` },
    { "@type": "ListItem", position: 2, name: "用語集", item: `${SITE}/ja/glossary/` },
  ],
};
const definedTermSetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Lemma Oracle 用語集",
  inLanguage: "ja",
  url: `${SITE}/ja/glossary/`,
  hasDefinedTerm: GLOSSARY_TERMS.map((term) => ({
    "@type": "DefinedTerm",
    name: term.nameJa,
    alternateName: term.nameEn,
    url: `${SITE}/ja/glossary/${term.slug}/`,
  })),
};
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  title={title}
  description={description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(definedTermSetJsonLd)}
  />

  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="gl-page">
    <div class="gl-container">
      <section class="gl-hero">
        <div class="gl-eyebrow">用語集</div>
        <h1 class="gl-h1">用語集</h1>
        <p class="gl-hero-sub">
          Lemma Oracle が扱う暗号レイヤ、検証可能 AI、エージェントプロトコル、規制適合の中核用語。製品文脈に直結する定義のみを掲載する。
        </p>
      </section>

      {groups.map((group) => {
        const labelParts = group.label.split(" · ");
        const numberPart = labelParts[0] ?? group.label;
        const titlePart = labelParts.slice(1).join(" · ") || group.label;
        return (
          <section class="gl-category" id={`cat-${group.category}`}>
            <div class="gl-category-head">
              <div class="gl-category-no">{numberPart}</div>
              <h2 class="gl-category-h2">{titlePart}</h2>
              <div class="gl-category-count">{group.terms.length} 件</div>
            </div>
            <p class="gl-category-sub">{group.description}</p>
            <div class="gl-grid">
              {group.terms.map((term) => (
                <a class="gl-card" href={`/ja/glossary/${term.slug}/`}>
                  <h3 class="gl-card-term">{term.nameJa}</h3>
                  <p class="gl-card-desc">{term.description}</p>
                  <span class="gl-card-cta">開く →</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .gl-page {
    --gl-display: "Sora", system-ui, sans-serif;
    --gl-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --gl-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --gl-text-1: #1a1a1a;
    --gl-text-2: #3a3a3a;
    --gl-text-3: #5a5a5a;
    --gl-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--gl-text-2);
    font-family: var(--gl-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }

  .gl-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .gl-hero {
    padding: 60px 0 56px;
  }
  .gl-eyebrow {
    font-family: var(--gl-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gl-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gl-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .gl-h1 {
    font-family: var(--gl-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.03em;
    max-width: 920px;
  }
  .gl-hero-sub {
    font-size: 16px;
    color: var(--gl-text-2);
    margin: 0;
    line-height: 1.75;
    max-width: 680px;
  }

  /* ─── CATEGORY ─── */
  .gl-category {
    margin: 0 0 64px;
  }
  .gl-category:last-child {
    margin-bottom: 0;
  }
  .gl-category-head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-bottom: 16px;
    margin: 0 0 12px;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .gl-category-no {
    font-family: var(--gl-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .gl-category-no::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .gl-category-h2 {
    font-family: var(--gl-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin: 0;
  }
  .gl-category-count {
    font-family: var(--gl-mono);
    font-size: 12px;
    color: var(--gl-text-4);
    margin-left: auto;
    flex-shrink: 0;
    padding-bottom: 4px;
  }
  .gl-category-sub {
    font-size: 14.5px;
    color: var(--gl-text-3);
    line-height: 1.7;
    margin: 0 0 28px;
    max-width: 720px;
  }

  /* ─── CARD GRID ─── */
  .gl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .gl-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 22px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .gl-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gl-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .gl-card:hover::before {
    width: 100%;
  }
  .gl-card-term {
    font-family: var(--gl-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.45;
    margin: 0;
  }
  .gl-card-desc {
    font-size: 12.5px;
    color: var(--gl-text-3);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gl-card-cta {
    font-family: var(--gl-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 12px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .gl-card:hover .gl-card-cta {
    transform: translateX(3px);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .gl-h1 {
      font-size: 42px;
    }
    .gl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gl-category-h2 {
      font-size: 24px;
    }
    .gl-category-head {
      flex-wrap: wrap;
      gap: 10px;
    }
  }
  @media (max-width: 720px) {
    .gl-container {
      padding: 0 24px;
    }
    .gl-hero {
      padding: 40px 0 36px;
    }
    .gl-h1 {
      font-size: 32px;
    }
    .gl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
