---
/**
 * Glossary per-term page (JA) — v24 chrome.
 *
 * Mirror of /glossary/[slug].astro for JA locale.
 */
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import { getTranslations } from "../../../i18n/translations";
import {
  GLOSSARY_TERMS,
  getGlossaryTerm,
  type GlossaryTerm,
} from "../../../data/glossary";
import { DISCOVERY_CALL, DISCOVERY_CALL_URL } from "../../../config/cta";

export function getStaticPaths() {
  return GLOSSARY_TERMS.map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

interface Props {
  term: GlossaryTerm;
}

const { term } = Astro.props as Props;
const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const pagePath = `/glossary/${term.slug}/`;

const title = `${term.nameJa} — Lemma 用語集`;
const description = term.description;
const implementationHeading = term.implementationHeading ?? "Lemma での実装";

const SITE = "https://lemma.frame00.com";
const pageUrl = `${SITE}/ja/glossary/${term.slug}/`;
const definedTermJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term.nameJa,
  alternateName: term.nameEn,
  description: term.description,
  inDefinedTermSet: `${SITE}/ja/glossary/`,
  url: pageUrl,
  termCode: term.slug,
  inLanguage: "ja",
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma", item: `${SITE}/ja/` },
    { "@type": "ListItem", position: 2, name: "用語集", item: `${SITE}/ja/glossary/` },
    { "@type": "ListItem", position: 3, name: term.nameJa, item: pageUrl },
  ],
};
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  title={title}
  description={description}
  canonicalOverride={term.canonicalOverride}
  noindexFollow={term.noindexFollow}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(definedTermJsonLd)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />

  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="gt-page">
    <div class="gt-container">
      <nav class="gt-breadcrumb" aria-label="breadcrumb">
        <a href="/ja/">ホーム</a>
        <span class="gt-breadcrumb-sep">/</span>
        <a href="/ja/glossary/">用語集</a>
        <span class="gt-breadcrumb-sep">/</span>
        <span>{term.nameJa}</span>
      </nav>

      <section class="gt-hero">
        <div class="gt-eyebrow">用語集 · {term.category}</div>
        <h1 class="gt-h1">{term.nameJa}</h1>
        <div class="gt-name-alt">{term.nameEn}</div>
        <p class="gt-lead" set:html={term.lead}></p>
      </section>

      <article class="gt-body">
        <h2>定義</h2>
        {term.definition.map((p) => <p set:html={p}></p>)}
        <h2>{implementationHeading}</h2>
        {term.implementation.map((p) => <p set:html={p}></p>)}
      </article>

      <section class="gt-related">
        <div class="gt-related-label">関連する用語</div>
        <div class="gt-related-grid">
          {term.related.map((rel) => {
            const target = getGlossaryTerm(rel.slug);
            const name = target?.nameJa ?? rel.slug;
            return (
              <a class="gt-related-card" href={`/ja/glossary/${rel.slug}/`}>
                <div class="gt-related-name">{name}</div>
                <div class="gt-related-desc">{rel.desc}</div>
              </a>
            );
          })}
        </div>
      </section>

      <section class="gt-cta">
        <div class="gt-cta-eyebrow">はじめる</div>
        <h2 class="gt-cta-h2">{term.ctaH2}</h2>
        <div class="gt-cta-row">
          <a
            class="gt-cta-primary"
            href={DISCOVERY_CALL_URL.ja}
            target="_blank"
            rel="noopener"
          >{DISCOVERY_CALL.ja.buttonLabel}</a>
          <a
            class="gt-cta-secondary"
            href="https://tally.so/r/xX0VYv"
            target="_blank"
            rel="noopener"
          >ホワイトペーパーをダウンロード</a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .gt-page {
    --gt-display: "Sora", system-ui, sans-serif;
    --gt-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --gt-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --gt-text-1: #1a1a1a;
    --gt-text-2: #3a3a3a;
    --gt-text-3: #5a5a5a;
    --gt-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--gt-text-2);
    font-family: var(--gt-body);
    font-weight: 400;
    line-height: 1.85;
    padding: 0 0 96px;
    margin-top: 64px;
  }

  .gt-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── BREADCRUMB ─── */
  .gt-breadcrumb {
    font-family: var(--gt-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gt-text-4);
    padding: 36px 0 0;
  }
  .gt-breadcrumb a {
    color: var(--gt-text-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .gt-breadcrumb a:hover {
    color: var(--accent);
  }
  .gt-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .gt-hero {
    padding: 32px 0 48px;
  }
  .gt-eyebrow {
    font-family: var(--gt-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gt-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .gt-h1 {
    font-family: var(--gt-display);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--black);
    letter-spacing: -0.025em;
    margin: 0 0 10px;
  }
  .gt-name-alt {
    font-family: var(--gt-body);
    font-size: 14.5px;
    color: var(--gt-text-3);
    margin: 0 0 28px;
    letter-spacing: 0.01em;
  }
  .gt-lead {
    font-size: 16px;
    line-height: 1.85;
    color: var(--gt-text-1);
    margin: 0;
    padding: 0 0 0 20px;
    border-left: 2px solid var(--accent);
    max-width: 720px;
  }
  .gt-lead :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s;
  }
  .gt-lead :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  /* ─── BODY ─── */
  .gt-body h2 {
    font-family: var(--gt-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 56px 0 24px;
  }
  .gt-body p {
    font-size: 15px;
    line-height: 1.9;
    color: var(--gt-text-2);
    margin: 0 0 20px;
  }
  .gt-body :global(strong) {
    font-weight: 500;
    color: var(--black);
  }
  .gt-body :global(em) {
    font-style: italic;
  }
  .gt-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
    overflow-wrap: anywhere;
  }
  .gt-body :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }
  .gt-body :global(code) {
    font-family: var(--gt-mono);
    font-size: 0.86em;
    background: var(--lemma-cream-deep);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    color: var(--gt-text-1);
  }

  /* ─── RELATED ─── */
  .gt-related {
    margin: 64px 0 0;
    padding: 32px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .gt-related-label {
    font-family: var(--gt-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gt-text-3);
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gt-related-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .gt-related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .gt-related-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 12px;
    padding: 18px 22px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .gt-related-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(139, 69, 19, 0.06);
  }
  .gt-related-name {
    font-family: var(--gt-display);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
  }
  .gt-related-desc {
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--gt-text-3);
  }

  /* ─── CTA ─── */
  .gt-cta {
    margin: 64px 0 0;
    padding: 36px 32px;
    background: var(--lemma-cream-deep);
    border-radius: 16px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .gt-cta::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .gt-cta-eyebrow {
    font-family: var(--gt-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }
  .gt-cta-h2 {
    font-family: var(--gt-display);
    font-size: clamp(22px, 2.8vw, 28px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.4;
    letter-spacing: -0.015em;
    margin: 0 0 24px;
  }
  .gt-cta-row {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gt-cta-primary,
  .gt-cta-secondary {
    font-family: var(--gt-display);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 12px 26px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .gt-cta-primary {
    background: var(--accent);
    color: var(--lemma-cream);
    border: 0;
  }
  .gt-cta-primary:hover {
    background: #6e3610;
  }
  .gt-cta-secondary {
    background: var(--white);
    color: var(--accent);
    border: 0.5px solid var(--lemma-line);
  }
  .gt-cta-secondary:hover {
    border-color: var(--accent);
    background: var(--lemma-brown-light);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 720px) {
    .gt-container {
      padding: 0 24px;
    }
    .gt-hero {
      padding: 24px 0 36px;
    }
    .gt-h1 {
      font-size: 32px;
    }
    .gt-body h2 {
      font-size: 22px;
    }
    .gt-related-grid {
      grid-template-columns: 1fr;
    }
    .gt-cta {
      padding: 28px 22px;
    }
  }
</style>
