---
import BlogIndexTemplate from "../../../templates/BlogIndexTemplate.astro";
import { getBlogSections, isDocCategory } from "../../../data/blog";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const blogPath = "/ja/blog";
const sections = await getBlogSections(locale);

const articles = (
  sections.find((s) => s.section === "記事" || s.section === "エッセイ" || s.section === "Essays")?.posts ?? []
).filter((p) => !isDocCategory(p.category));
const changelog = (
  sections.find((s) => s.section === "変更履歴" || s.section === "Changelog")?.posts ?? []
).filter((p) => !isDocCategory(p.category));

// All category-filterable entries (articles + changelog), newest first.
const entries = [...articles, ...changelog].sort((a, b) =>
  a.date > b.date ? -1 : 1,
);

const featured = articles[0];
const recent = articles.slice(1, 7);
---

<BlogIndexTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  entries={entries}
  featured={featured}
  recent={recent}
  changelog={changelog}
/>
