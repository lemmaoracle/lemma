---
import BlogIndexTemplate from "../../../templates/BlogIndexTemplate.astro";
import { getBlogSections } from "../../../data/blog";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const blogPath = "/ja/blog";
const sections = await getBlogSections(locale);

const filterSection = sections.find(
  (s) => s.section === "エッセイ" || s.section === "Essays",
);
const allEssays = filterSection?.posts ?? [];
const essays = allEssays.filter(
  (p) =>
    p.category !== "ガイド" &&
    p.category !== "Guides" &&
    p.category !== "基盤" &&
    p.category !== "Foundations",
);
const guides = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "ガイド" || p.category === "Guides");
const foundations = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "基盤" || p.category === "Foundations");

const featured = essays[0];
const recent = essays.slice(1, 7);
const archive = essays.slice(7);
---

<BlogIndexTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  featured={featured}
  recent={recent}
  archive={archive}
  guides={guides}
  foundations={foundations}
/>
