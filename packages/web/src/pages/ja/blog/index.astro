---
import BlogIndexTemplate from "../../../templates/BlogIndexTemplate.astro";
import { getBlogSections, isDocCategory } from "../../../data/blog";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const blogPath = "/ja/blog";
const sections = await getBlogSections(locale);

const articles = (
  sections.find((s) => s.section === "記事" || s.section === "エッセイ" || s.section === "Essays")?.posts ?? []
).filter((p) => !isDocCategory(p.category));
const changelog = (
  sections.find((s) => s.section === "変更履歴" || s.section === "Changelog")?.posts ?? []
).filter((p) => !isDocCategory(p.category));

// All category-filterable entries (articles + changelog), newest first.
const entries = [...articles, ...changelog].sort((a, b) =>
  a.date > b.date ? -1 : 1,
);

// Featured / Recent draw from *all* entries, not just the Essays section.
// Announcements default to `section: Changelog` (see data/blog.ts), so
// selecting from Essays alone kept the newest post off the top of the index
// whenever it was an announcement — it only showed in the Changelog list.
const featured = entries[0];
const recent = entries.slice(1, 7);

// Anything already surfaced above is dropped from the Changelog list so the
// same post never renders twice on one page.
const promotedSlugs = new Set(entries.slice(0, 7).map((p) => p.slug));
const changelogRest = changelog.filter((p) => !promotedSlugs.has(p.slug));
---

<BlogIndexTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  entries={entries}
  featured={featured}
  recent={recent}
  changelog={changelogRest}
/>
