---
/**
 * Critical Brief のセルフチェック（2026-10-24・日本語だけ）。
 *
 * 記事の点検チェックリストを、狙われた業務ごとにまとめて、画面の中で
 * はい／いいえ／分からない で答えてもらう。Excel で配ると一気に出回るので
 * ファイルは渡さず、登録も求めない。回答はこのブラウザの中だけで扱い
 * （localStorage に下書きとして残すだけ）、どこにも送らない。
 *
 * 見込み客の情報は、結果を見て不安になった人の「メールで相談」から受ける
 * （Tally 2jE9dj を新しいタブで開き、選んだ業務と「はい」と言い切れなかった
 * 項目の id だけを隠しフィールドで渡す）。記事から来たとき（?from=slug）は、
 * その記事の業務を選んだ状態で開き、その記事の項目に印を付ける。
 */
import { getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Navigation from "../../../../components/Navigation.astro";
import Footer from "../../../../components/FooterRenewal.astro";
import { getTranslations } from "../../../../i18n/translations";
import { CONSULT_FORM_URL, BRIEF_WEEKLY_URL } from "../../../../config/cta";
import type { BriefEntry } from "../../../../data/criticalBriefs";
import { selfCheckGroups, selfCheckItemCount } from "../../../../lib/briefSelfCheck";

const locale = "ja" as const;
const base = "/ja";
const t = getTranslations(locale);
const briefs = (await getCollection("critical-briefs")) as BriefEntry[];
const groups = selfCheckGroups(briefs);
const total = selfCheckItemCount(groups);
const briefCount = new Set(groups.flatMap((g) => g.items.flatMap((i) => i.sources.map((x) => x.id)))).size;
const pad = (no: number) => String(no).padStart(3, "0");
// LP の事例のカード（2026-10-24）。見出しや画像に被害組織の名前は出さず、記事へつなぐ。
const CASES = [
  { slug: "158-portland-water-bureau-vendor-bank-change", fig: "670", unit: "万ドル", kind: "振込先の変更", text: "米国の市。取引先を装う相手に取引先登録の振込先を変えられ、工事代金が別の口座へ送られた。" },
  { slug: "159-zuu-business-chat-executive-impersonation-transfer", fig: "9,600", unit: "万円", kind: "役員を装う指示", text: "国内の上場企業。社内のチャットで役員を装った送金の指示が届き、同じ日のうちに外部の口座へ振り込まれた。" },
  { slug: "084-hong-kong-deepfake-video-call-fraud", fig: "約 HK$2", unit: "億", kind: "偽のビデオ会議", text: "香港の拠点。本社の CFO を装った録画のビデオ会議の指示で、15 回に分けて送金された。" },
  { slug: "162-hatena-police-impersonation-remote-transfer", fig: "約 11.8", unit: "億円", kind: "警察を名乗る電話", text: "国内の上場企業。経理の責任者の PC が遠隔操作され、社内の資金移動を経て外部へ送られた。" },
];
// よくある質問（画面と FAQPage の構造化データの両方に使う）。
const FAQ = [
  { q: "答えは、どこかに送られますか", a: "送られません。答えはこのブラウザに残るだけです。メールで相談するときだけ、選んだ業務と、言い切れない項目の番号をフォームに添えます。" },
  { q: "担当外の項目は、どう答えればよいですか", a: "「分からない」を選んでください。結果に、その業務について社内で誰に聞けばよいかを出します。" },
  { q: "結果は、診断や点数ですか", a: "いいえ。実際に起きた事例から作った、点検の目安です。点数やランクは付けません。" },
  { q: "相談は無料ですか。製品の案内は来ますか", a: "無料です。お返事はメールだけで、お電話はしません。お返事に、Lemma（照合できたものだけを通す仕組み）のご案内を添えることがあります。" },
  { q: "お返事はいつ届きますか", a: "3 営業日以内に、メールでお返事します。届かないときは、迷惑メールのフォルダもご確認ください。" },
  { q: "答えを残したくないときは", a: "結果の下の「答えを消す」を押すと、このブラウザに残った答えをすべて消します。" },
];
const site = "https://lemma.frame00.com";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: `${site}/ja/` },
      { "@type": "ListItem", position: 2, name: "Critical Brief", item: `${site}/ja/critical/briefs/` },
      { "@type": "ListItem", position: 3, name: "不正の手口セルフチェック", item: `${site}/ja/critical/self-check/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "不正の手口セルフチェック",
    url: `${site}/ja/critical/self-check/`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    inLanguage: "ja",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
    publisher: { "@type": "Organization", name: "FRAME00株式会社" },
  },
];
// 相談の例（サービスデザイン・営業の案・2026-10-24）。押すとフォームの「いちばん気になる点」に入る。
const CONSULT_EXAMPLES = [
  "「分からない」だった項目を、社内で誰に聞けばよいか知りたい",
  "振込先の変更の照合を、少ない人数の経理で回す方法を知りたい",
  "委託先との取り決めに、何を足せばよいか知りたい",
];
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/critical/self-check/"
  localesAvailable={["ja"]}
  title={`ビジネスメール詐欺・不正送金の対策チェックリスト（実例 ${total} 項目・無料）｜Lemma`}
  ogTitle="実際に起きた不正の手口が、自社で通らないかをセルフチェック｜Lemma"
  jsonLd={jsonLd}
  description={`振込先の変更、社長や役員を装う送金の指示、偽のビデオ会議。国内外で実際に起きた ${briefCount} 件の事案から作った ${total} 項目で、自社の経理・承認・アカウント管理を業務ごとにセルフチェックできます。登録は不要です。`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <main class="ck">
    <section class="lp-hero">
      <div class="lp-in lp-hero-in">
        <div class="lp-hero-tx">
          <p class="lp-kicker">ビジネスメール詐欺・不正送金の対策チェックリスト ・ 無料 ・ 登録不要</p>
          <h1>実際に起きた不正の手口が、<br /><mark>自社で通らないか</mark>を<br />セルフチェック</h1>
          <p class="lp-lead">
            振込先の変更、上長を名乗る送金の指示、アカウントの追加。国内外で実際に起きた {briefCount} 件の事案から、{total} のチェック項目を作りました。担当の業務を選んで、はい／いいえで答えるだけです。
          </p>
          <div class="lp-cta">
            <a class="lp-btn" href="#start" data-lp-start>無料でセルフチェックを始める</a>
            <a class="lp-btn lp-btn--ghost" href="#cases">どんな事例から作ったか</a>
          </div>
          <ul class="lp-ticks">
            <li>登録は要りません</li>
            <li>答えはどこにも送りません</li>
            <li>気になる点は無料でメール相談</li>
          </ul>
        </div>
        <div class="lp-mock" aria-hidden="true">
          <div class="lp-mock-h"><span>振込先・口座の変更</span><span>10 項目</span></div>
          <div class="lp-mock-r"><p>振込先の変更を、メールの中の連絡先ではなく、登録済みの連絡先で確認しているか。</p><b class="is-yes">はい</b></div>
          <div class="lp-mock-r"><p>振込先が変わった直後の支払いを、照合が済むまで保留にしているか。</p><b class="is-no">いいえ</b></div>
          <div class="lp-mock-r"><p>取引先ごとに、登録を変えてよい担当者の一覧があるか。</p><b class="is-un">分からない</b></div>
          <div class="lp-mock-f">言い切れない項目 <strong>2</strong><span>次の一歩：経理・財務の責任者に聞いてみましょう</span></div>
        </div>
      </div>
    </section>

    <section class="lp-cases" id="cases" aria-labelledby="lp-cases-h">
      <div class="lp-in">
        <p class="lp-sec-k">実際に起きた事案</p>
        <h2 id="lp-cases-h">ビジネスメール詐欺・不正送金は、ふだんの業務連絡の顔をして届きます</h2>
        <div class="lp-case-grid">
          {CASES.map((c) => (
            <a class="lp-case" href={`/ja/critical/briefs/${c.slug}/`}>
              <span class="lp-case-k">{c.kind}</span>
              <span class="lp-case-fig">{c.fig}<small>{c.unit}</small></span>
              <span class="lp-case-tx">{c.text}</span>
              <span class="lp-case-more">事例を読む →</span>
            </a>
          ))}
        </div>
        <p class="lp-cases-note">どの事案でも、指示や変更が本物かを別の経路で照合する前に、支払いが通っていました。セルフチェックの項目は、こうした「通ってしまった所」から作っています。</p>
      </div>
    </section>

    <section class="lp-how" aria-labelledby="lp-how-h">
      <div class="lp-in">
        <p class="lp-sec-k">使い方</p>
        <h2 id="lp-how-h">業務別チェックリストの使い方（3 つの手順）</h2>
        <ol class="lp-steps">
          <li><b>担当の業務を選ぶ</b><span>振込先の変更、承認、アカウントの管理など 7 つから。いくつ選んでもかまいません。</span></li>
          <li><b>はい／いいえ／分からない で答える</b><span>規程や手順のとおりに回っていれば「はい」。担当外は「分からない」で大丈夫です。</span></li>
          <li><b>言い切れない項目と、次の一歩が分かる</b><span>社内で誰に聞けばよいかも出します。気になる点は、無料でメール相談できます。</span></li>
        </ol>
      </div>
    </section>

    <div class="ck-tool" id="start">
    <p class="ck-print-head" data-ck-print-head></p>
    <p class="ck-done" data-ck-done hidden>相談を受け付けました。3 営業日以内に、ご記入のメールアドレスへお返事します。届かないときは、迷惑メールのフォルダもご確認ください。</p>
    <p class="lp-sec-k">セルフチェック</p>
    <h2 class="ck-tool-h">あなたの業務で、点検してみましょう</h2>
    <p class="ck-privacy">答えはどこにも送りません。このブラウザに残るので、共用のパソコンでは最後に「答えを消す」を押してください。</p>

    <section class="ck-step" aria-labelledby="ck-s1">
      <h2 id="ck-s1"><span class="ck-n">1</span>点検する業務を選ぶ</h2>
      <div class="ck-ops" role="group" aria-label="業務">
        {groups.map((g) => (
          <button type="button" class="ck-op" data-op={g.key} aria-pressed="false">
            <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
            <span class="ck-op-l">{g.label}</span>
            <span class="ck-op-c">{g.items.length} 項目</span>
          </button>
        ))}
      </div>
      <p class="ck-hint" data-ck-empty>まずは担当の業務を 1 つ選んでください。あとから足せます。外しても、答えは残ります。</p>
    </section>

    <section class="ck-step" aria-labelledby="ck-s2" data-ck-items hidden>
      <h2 id="ck-s2"><span class="ck-n">2</span>はい／いいえ／分からない で答える</h2>
      <ul class="ck-hint ck-rules">
        <li>規程や手順で決まっていて、そのとおりに回っていれば「はい」です。1 つの項目に 2 つのことが書いてあるときは、両方そろっているときだけ「はい」です。</li>
        <li>担当外の言葉が出たり、社内で確認できなかったりする項目は「分からない」で大丈夫です。誰に聞けばよいかを結果に出します。</li>
        <li>押した答えをもう一度押すと、答えを外せます。いくつかの業務に当てはまる項目は、1 か所にまとめて出しています。</li>
      </ul>
      {groups.map((g) => (
        <div class="ck-group" data-group={g.key} hidden>
          <h3 class="ck-gh">{g.label}</h3>
          <ol class="ck-list">
            {g.items.map((it) => (
              <li class="ck-item" data-item={it.id} data-src={it.sources.map((x) => x.id).join(" ")}>
                <div class="ck-q">
                  <p>{it.text}</p>
                  <div class="ck-src">
                    <span class="ck-from">いま読んでいた記事の項目</span>
                    <span class="ck-src-l">事例</span>
                    {it.sources.map((x) => (
                      <a href={`/ja/critical/briefs/${x.id}/`} target="_blank" rel="noopener" title={x.title}>No.{pad(x.no)}</a>
                    ))}
                  </div>
                </div>
                <div class="ck-ans" role="radiogroup" aria-label={it.text}>
                  <button type="button" role="radio" aria-checked="false" data-v="yes">はい</button>
                  <button type="button" role="radio" aria-checked="false" data-v="no">いいえ</button>
                  <button type="button" role="radio" aria-checked="false" data-v="unsure">分からない</button>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="ck-step ck-result" aria-labelledby="ck-s3" data-ck-result hidden>
      <h2 id="ck-s3"><span class="ck-n">3</span>結果</h2>
      <p class="ck-sum" data-ck-sum></p>
      <div data-ck-gaps></div>
      <div class="ck-consult">
        <div class="ck-consult-tx">
          <b>言い切れなかった項目を、メールで相談する</b>
          <span>「はい」と言い切れなかった項目について、ほかの事例での手当ての例と、社内で確認する順番を、メールでお返事します。FRAME00 の担当者が AI も使って下書きし、目を通してから、3 営業日以内にお送りします。</span>
          <ul class="ck-promise">
            <li>費用はかかりません</li>
            <li>お返事に、Lemma のご案内を添えることがあります</li>
            <li>お返事はメールだけで、お電話はしません</li>
            <li>3 営業日以内にお返事します</li>
          </ul>
          <div class="ck-ex">
            <span>相談の例（押すと、フォームに入った状態で開きます）</span>
            {CONSULT_EXAMPLES.map((q) => (
              <a href={CONSULT_FORM_URL} target="_blank" rel="noopener" data-ck-consult data-q={q}>{q}</a>
            ))}
          </div>
          <small>いま被害が起きている・振り込んでしまった、というときは、このフォームを待たずに、取引銀行と警察（最寄りの警察署か #9110）にすぐご連絡ください。</small>
          <small data-ck-attach>答えの中身は送られません。選んだ業務と、言い切れない項目の番号だけをフォームに添えます。</small>
        </div>
        <a class="ck-btn" data-ck-consult href={CONSULT_FORM_URL} target="_blank" rel="noopener">無料でメール相談する<span aria-hidden="true"> →</span></a>
      </div>
      <div class="ck-tools">
        <button type="button" class="ck-sub" data-ck-print>結果を印刷する</button>
        <button type="button" class="ck-sub" data-ck-reset>答えを消す</button>
        <a class="ck-sub" href={BRIEF_WEEKLY_URL} target="_blank" rel="noopener">新しい事例をメールで受け取る</a>
      </div>
      <p class="ck-print-only">
        相談・最新のチェック項目：https://lemma.frame00.com/ja/critical/self-check/
      </p>
      <section class="ck-faq" aria-labelledby="ck-faq-h">
        <h3 id="ck-faq-h">よくある質問</h3>
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
      <p class="ck-note">
        この点検は、公開情報をもとにした事案の構造分析から作ったもので、特定の組織への監査・診断・助言ではありません。網羅性・正確性や、不正を防ぐ効果は保証しません。© 2026 FRAME00株式会社
      </p>
    </section>

    </div>

    <section class="lp-list" aria-labelledby="lp-list-h">
      <div class="lp-in">
        <p class="lp-sec-k">一覧</p>
        <h2 id="lp-list-h">業務別 チェック項目の一覧</h2>
        <p class="lp-list-lead">セルフチェックの {total} 項目を、業務ごとに並べました。答えるときは、上のセルフチェックで業務を選んでください。</p>
        <div class="lp-list-grid">
          {groups.map((g) => (
            <section class="lp-list-g">
              <h3>{g.label}の不正対策チェック<span>{g.items.length} 項目</span></h3>
              <ul>
                {g.items.map((it) => (
                  <li>{it.text}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-lemma" aria-labelledby="lp-lemma-h">
      <div class="lp-in lp-lemma-in">
        <div>
          <p class="lp-sec-k lp-sec-k--on">Lemma について</p>
          <h2 id="lp-lemma-h">人の注意だけに頼らず、<br />照合できたものだけを通す</h2>
          <p>
            このセルフチェックは、Lemma（FRAME00株式会社）が作っています。Lemma は、振込先の変更や送金の承認、アカウントの追加など、業務の手前で「本物だと照合できたものだけを通す」仕組みを作っています。照合したことが記録として残るので、あとから確認できます。
          </p>
        </div>
        <div class="lp-lemma-cta">
          <a class="lp-btn" href={CONSULT_FORM_URL} target="_blank" rel="noopener" data-ck-consult>無料でメール相談する</a>
          <a class="lp-btn lp-btn--light" href="/ja/">Lemma を見る</a>
        </div>
      </div>
    </section>

    <section class="lp-final">
      <div class="lp-in">
        <h2>まずは、担当の業務の 5 分から。</h2>
        <a class="lp-btn" href="#start" data-lp-start>無料でセルフチェックを始める</a>
      </div>
    </section>

    <div class="ck-bar" data-ck-bar hidden>
      <span data-ck-progress></span>
      <a href="#ck-s3" class="ck-bar-btn">結果を見る</a>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script is:inline>
  (function () {
    var KEY = "lemma_selfcheck_v2";
    var root = document.querySelector(".ck");
    if (!root) return;
    var state = { ops: [], ans: {} };
    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || "null");
      if (saved && saved.ans) state = { ops: saved.ops || [], ans: saved.ans };
    } catch (e) {}
    var params = new URLSearchParams(location.search);
    var from = params.get("from");
    // 分からなかった項目を、社内で誰に聞くか（業務ごと）。
    var ASK = {
      "payment-change": "経理・財務の責任者",
      approval: "経理・財務の責任者",
      "account-admin": "情報システムの担当",
      "data-access": "情報システムの担当",
      delivery: "配信や発送を担う部署",
      disclosure: "情報システムか法務の担当",
      other: "委託先との契約の担当",
    };
    // 相談のフォームから戻ったとき（?form=consult）。
    if (params.get("form") === "consult") root.querySelector("[data-ck-done]").hidden = false;
    var started = false;
    function save() {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (e) {}
    }
    function ev(name, params) {
      if (typeof window.gtag === "function") window.gtag("event", name, params || {});
    }
    var $ = function (s, el) { return (el || root).querySelector(s); };
    var $$ = function (s, el) { return Array.prototype.slice.call((el || root).querySelectorAll(s)); };

    // 記事から来たとき：その記事の項目に印を付けて各業務の先頭へ寄せ、
    // その記事のいちばん近い業務を選ぶ。
    if (from) {
      var mine = $$(".ck-item").filter(function (li) {
        return (li.getAttribute("data-src") || "").split(" ").indexOf(from) >= 0;
      });
      mine.slice().reverse().forEach(function (li) {
        li.classList.add("is-from");
        li.parentNode.insertBefore(li, li.parentNode.firstChild);
      });
      if (mine.length) {
        var g = mine[0].closest("[data-group]").getAttribute("data-group");
        if (state.ops.indexOf(g) < 0) state.ops.push(g);
      }
    }

    function render() {
      $$(".ck-op").forEach(function (b) {
        b.setAttribute("aria-pressed", String(state.ops.indexOf(b.getAttribute("data-op")) >= 0));
      });
      $$("[data-group]").forEach(function (g) {
        g.hidden = state.ops.indexOf(g.getAttribute("data-group")) < 0;
      });
      var any = state.ops.length > 0;
      $("[data-ck-items]").hidden = !any;
      $("[data-ck-result]").hidden = !any;
      $("[data-ck-bar]").hidden = !any;
      $("[data-ck-empty]").hidden = any;
      // 複数の業務に出る項目は、選んだ業務のうち最初の 1 か所にだけ出す。
      var seen = {};
      var shown = [];
      $$(".ck-item").forEach(function (li) {
        var id = li.getAttribute("data-item");
        var inOpen = !li.closest("[data-group]").hidden;
        li.hidden = inOpen && !!seen[id];
        if (inOpen && !seen[id]) {
          seen[id] = true;
          shown.push(li);
        }
        var v = state.ans[id];
        $$("[data-v]", li).forEach(function (b) {
          b.setAttribute("aria-checked", String(b.getAttribute("data-v") === v));
        });
        li.setAttribute("data-state", v || "");
      });
      var answered = 0;
      var gaps = [];
      shown.forEach(function (li) {
        var v = state.ans[li.getAttribute("data-item")];
        if (v) answered++;
        if (v === "no" || v === "unsure") gaps.push(li);
      });
      $("[data-ck-progress]").textContent =
        answered + " / " + shown.length + " 項目 回答済み　・　言い切れない項目 " + gaps.length;
      var unsure = gaps.filter(function (li) { return state.ans[li.getAttribute("data-item")] === "unsure"; }).length;
      $("[data-ck-sum]").innerHTML = !answered
        ? "まだ答えていません。上の項目に答えると、ここに「はい」と言い切れない項目が、業務ごとの次の一歩とあわせてまとまります。"
        : (gaps.length
            ? "答えた " + answered + " 項目のうち、<b>" + gaps.length + " 項目は、まだ「はい」と言い切れません。</b>下に、業務ごとの次の一歩をまとめました。"
            : "答えた " + answered + " 項目は、すべて「はい」でした。") +
          (answered < shown.length ? "（まだ答えていない項目が " + (shown.length - answered) + " 項目あります）" : "") +
          (unsure ? "<br><span class=\"ck-soft\">「分からない」があるのは普通のことです。社内で誰が知っているかが分かれば、それだけで一歩進みます。</span>" : "");
      var box = $("[data-ck-gaps]");
      box.innerHTML = "";
      var byGroup = {};
      gaps.forEach(function (li) {
        var g = li.closest("[data-group]");
        var key = g.getAttribute("data-group");
        if (!byGroup[key]) {
          byGroup[key] = document.createElement("div");
          byGroup[key].className = "ck-gap";
          var h = document.createElement("b");
          h.textContent = g.querySelector(".ck-gh").textContent;
          byGroup[key].appendChild(h);
          var next = document.createElement("p");
          next.className = "ck-next";
          byGroup[key].appendChild(next);
          byGroup[key].appendChild(document.createElement("ul"));
          box.appendChild(byGroup[key]);
        }
        var v = state.ans[li.getAttribute("data-item")];
        var item = document.createElement("li");
        item.innerHTML = '<span class="ck-tag ck-tag--' + v + '">' + (v === "no" ? "いいえ" : "分からない") + "</span>";
        item.appendChild(document.createTextNode(li.querySelector("p").textContent));
        var src = li.querySelector(".ck-src").cloneNode(true);
        var mark = src.querySelector(".ck-from");
        if (mark) mark.remove();
        src.className = "ck-gap-src";
        item.appendChild(src);
        byGroup[key].querySelector("ul").appendChild(item);
      });
      // 業務ごとの次の一歩（1 業務に 1 行まで）。いいえがあれば事例を読む、
      // 分からないだけなら社内で誰に聞くか。
      Object.keys(byGroup).forEach(function (key) {
        var hasNo = byGroup[key].querySelector(".ck-tag--no");
        byGroup[key].querySelector(".ck-next").textContent = hasNo
          ? "次の一歩：元の事例を読み、自社で同じ手順になっていないかを確認しましょう。"
          : "次の一歩：" + (ASK[key] || "担当の部署") + "に、この項目について聞いてみましょう。";
      });
      var opLabels = state.ops.map(function (k) {
        var b = $('.ck-op[data-op="' + k + '"] .ck-op-l');
        return b ? b.textContent : k;
      });
      $("[data-ck-attach]").textContent =
        "答えの中身は送られません。フォームに添えるのは、選んだ業務（" + opLabels.join("、") + "）と、言い切れない項目 " +
        gaps.length + " 件の番号だけです。";
      var gapIds = gaps.map(function (li) { return li.getAttribute("data-item"); }).join(",").slice(0, 900);
      $$("[data-ck-consult]").forEach(function (link) {
        var u = new URL(link.getAttribute("href"));
        u.searchParams.set("ops", state.ops.join(","));
        u.searchParams.set("gaps", gapIds);
        u.searchParams.set("ref", from ? "selfcheck_from_brief" : "selfcheck");
        if (link.getAttribute("data-q")) u.searchParams.set("q", link.getAttribute("data-q"));
        link.href = u.toString();
      });
    }

    root.addEventListener("click", function (e) {
      var op = e.target.closest(".ck-op");
      if (op) {
        var k = op.getAttribute("data-op");
        var i = state.ops.indexOf(k);
        if (i >= 0) state.ops.splice(i, 1);
        else state.ops.push(k);
        save();
        render();
        return;
      }
      var b = e.target.closest(".ck-ans [data-v]");
      if (b) {
        var id = b.closest(".ck-item").getAttribute("data-item");
        var v = b.getAttribute("data-v");
        if (state.ans[id] === v) delete state.ans[id];
        else state.ans[id] = v;
        if (!started) {
          started = true;
          ev("self_check_start", { from_brief: from || undefined });
        }
        save();
        render();
        return;
      }
      if (e.target.closest("[data-ck-print]")) {
        ev("self_check_print");
        var labels = state.ops.map(function (k) {
          var b = $('.ck-op[data-op="' + k + '"] .ck-op-l');
          return b ? b.textContent : k;
        });
        $("[data-ck-print-head]").textContent =
          "セルフチェックの結果（" + new Date().toLocaleDateString("ja-JP") + "）　業務：" + labels.join("、");
        window.print();
        return;
      }
      if (e.target.closest("[data-ck-reset]")) {
        if (!window.confirm("このブラウザに残っている答えを、すべて消します。よろしいですか。")) return;
        state.ans = {};
        save();
        render();
        return;
      }
      if (e.target.closest("[data-ck-consult]")) {
        ev("self_check_consult", { ops: state.ops.join(","), gaps: $$(".ck-gap li").length, example: !!e.target.closest("[data-q]") });
      }
    });

    // 結果まで読んだら 1 回だけ数える。
    var counted = false;
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (x) {
          if (!x.isIntersecting || counted || x.target.hidden) return;
          counted = true;
          ev("self_check_result", {
            ops: state.ops.join(","),
            answered: Object.keys(state.ans).length,
            gaps: $$(".ck-gap li").length,
          });
        });
      }).observe($("[data-ck-result]"));
    }

    render();
    if (from) {
      var target = $(".ck-item.is-from:not([hidden])");
      if (target) setTimeout(function () { target.scrollIntoView({ block: "center" }); }, 60);
    }
  })();
</script>

