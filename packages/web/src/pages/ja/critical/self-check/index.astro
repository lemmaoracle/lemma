---
/**
 * Critical Brief のセルフチェック（2026-10-24・日本語だけ）。
 *
 * 記事の点検チェックリストを、狙われた場面（業務の分け方）ごとにまとめて、画面の中で
 * はい／いいえ／分からない で答えてもらう。担当を選ぶと場面がまとめて選ばれ、
 * 「お急ぎ点検」か「じっくり点検」かを選んでから答える。Excel で配ると一気に出回るので
 * ファイルは渡さず、登録も求めない。回答は localStorage に下書きとして残し、
 * リサーチ用に「どの項目にどう答えたか」だけを GA4 のイベント（self_check_answer）で
 * 集計する（会社や個人は分からない形）。
 *
 * 見込み客の情報は、結果を見て不安になった人の「メールで相談」から受ける
 * （Tally 2jE9dj を新しいタブで開き、選んだ場面と要確認（いいえ・分からない）の
 * 項目の id だけを隠しフィールドで渡す）。記事から来たとき（?from=slug）は、
 * その記事の場面を選んだ状態で開き（担当は選ばず全項目）、その記事の項目に印を付ける。
 */
import { getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Navigation from "../../../../components/Navigation.astro";
import Footer from "../../../../components/FooterRenewal.astro";
import { getTranslations } from "../../../../i18n/translations";
import { CONSULT_FORM_URL, BRIEF_WEEKLY_URL } from "../../../../config/cta";
import type { BriefEntry } from "../../../../data/criticalBriefs";
import { selfCheckGroups, selfCheckItemCount } from "../../../../lib/briefSelfCheck";

const locale = "ja" as const;
const base = "/ja";
const t = getTranslations(locale);
const briefs = (await getCollection("critical-briefs")) as BriefEntry[];
const groups = selfCheckGroups(briefs);
const total = selfCheckItemCount(groups);
// ヒーローの「この会社は何か」：分析して公開している事案の数（公開済みの Brief）。
const analyzed = briefs.filter((b) => b.data.status === "published").length;
const pad = (no: number) => String(no).padStart(3, "0");
// LP の事例のカード（2026-10-24）。見出しや画像に被害組織の名前は出さず、記事へつなぐ。
const CASES = [
  { slug: "158-portland-water-bureau-vendor-bank-change", fig: "670", unit: "万ドル", kind: "振込先の変更", text: "米国の市。取引先を装う相手に取引先登録の振込先を変えられ、工事代金が別の口座へ送られた。" },
  { slug: "159-zuu-business-chat-executive-impersonation-transfer", fig: "9,600", unit: "万円", kind: "役員を装う指示", text: "国内の上場企業。社内のチャットで役員を装った送金の指示が届き、同じ日のうちに外部の口座へ振り込まれた。" },
  { slug: "084-hong-kong-deepfake-video-call-fraud", fig: "約 HK$2", unit: "億", kind: "偽のビデオ会議", text: "香港の拠点。本社の CFO を装った録画のビデオ会議の指示で、15 回に分けて送金された。" },
  { slug: "162-hatena-police-impersonation-remote-transfer", fig: "約 11.8", unit: "億円", kind: "警察を名乗る電話", text: "国内の上場企業。経理の責任者の PC が遠隔操作され、社内の資金移動を経て外部へ送られた。" },
];
// 「あなたの担当は？」（CLUBS の LP の「例を選ぶと、その人の1週間に切り替わる」に
// ならう・2026-10-24）。担当を選ぶと、その担当に届きそうな連絡と、実際に起きたこと、
// 先に見てほしい 2 項目が出る。
// お客さまから見た「業務」は担当（経理など）なので、狙われた業務の分け方は「場面」と
// 呼ぶ（2026-10-25）。担当を選ぶと、その担当で起こりうる場面（ops）をまとめて選び、
// 進め方を「お急ぎ点検」（quick・場面をまたいで大事な項目）か「じっくり点検」
// （場面の全項目）から選んでもらう。
const CH_ICON: Record<string, string> = {
  mail: '<rect x="3" y="5" width="16" height="12" rx="2"/><path d="M3.5 6l7.5 6 7.5-6"/>',
  chat: '<path d="M4 5h14v9H9l-4 3.5V14H4z"/>',
  notice: '<path d="M6 15V10a5 5 0 0110 0v5l1.5 2h-13z"/><path d="M9.5 19a1.6 1.6 0 003 0"/>',
  report: '<path d="M6 3.5h7l3.5 3.5v11.5H6z"/><path d="M13 3.5V7h3.5M8.5 11h5M8.5 14h5"/>',
};
const PERSONAS = [
  {
    key: "acct",
    tab: "経理・財務",
    msg: "振込先の口座が変わりました。今月分から、こちらにお願いします。",
    tag: "取引先のなりすまし",
    ch: "mail",
    chLabel: "メール",
    av: "商",
    sender: "株式会社〇〇商事 経理部",
    addr: "keiri@oo-shoji.example",
    subject: "【重要】お振込先変更のお願い",
    real: "米国の市では、この形の連絡で、工事代金 670 万ドルが別の口座へ送られました。",
    slug: "158-portland-water-bureau-vendor-bank-change",
    checks: ["振込先の変更を、メールの中ではなく登録済みの連絡先で確認しているか", "変わった直後の支払いを、照合が済むまで保留にしているか"],
    ops: ["payment-change", "approval", "delivery"],
    quick: ["p1", "p2", "a1", "a4", "p3", "p8", "a5"],
  },
  {
    key: "exec",
    tab: "経営・管理職",
    msg: "至急、この口座に送金してください。社内にはまだ内密に。",
    tag: "社長・役員のなりすまし",
    ch: "chat",
    chLabel: "社内チャット",
    av: "代",
    sender: "代表取締役",
    addr: "10:42",
    subject: "",
    real: "国内の上場企業では、チャットで役員を装った指示に従い、同じ日に 9,600 万円が振り込まれました。",
    slug: "159-zuu-business-chat-executive-impersonation-transfer",
    checks: ["送金の指示を、届いた経路とは別の手段で本人に照合しているか", "振込の作成と承認を、別の人が行っているか"],
    ops: ["approval", "payment-change", "disclosure"],
    quick: ["a1", "a4", "a2", "a3", "p2", "a6", "s3"],
  },
  {
    key: "it",
    tab: "情報システム",
    msg: "取引先の担当者を 1 名、追加しました。",
    tag: "偽の担当者の登録",
    ch: "notice",
    chLabel: "取引先管理システムの通知",
    av: "通",
    sender: "取引先ポータル",
    addr: "自動送信",
    subject: "担当者が追加されました",
    real: "米国の市では、偽の担当者が取引先の登録に加えられ、振込先が書き換えられて 152 万ドルが送られました。",
    slug: "160-baltimore-workday-supplier-contact-bank-change",
    checks: ["管理者や担当者が追加されたとき、担当者に知らせが届くか", "使っていない入口や広すぎる権限を、定期的に閉じているか"],
    ops: ["account-admin", "data-access", "disclosure"],
    quick: ["c1", "c2", "c3", "c4", "c10", "e3", "d3", "d1"],
  },
  {
    key: "ga",
    tab: "総務・内部統制",
    msg: "お預かりした機器は、作業のあと、すべて破砕しました。",
    tag: "不正な持ち出し",
    ch: "report",
    chLabel: "委託先の作業報告書",
    av: "報",
    sender: "〇〇リサイクル株式会社",
    addr: "PDF・1 ページ",
    subject: "データ消去・破砕 完了報告書",
    real: "国内の病院では、破砕したはずの電子カルテの HDD の一部が、ネットオークションで落札されました。",
    slug: "065-hokkaido-hospital-hdd-disposal",
    checks: ["委託先の「消した」という説明を、消去の記録や写真で確認しているか", "委託先の再委託や転売を、事前に知る取り決めがあるか"],
    ops: ["other", "data-access", "delivery", "disclosure"],
    quick: ["d4", "d5", "o1", "d12", "e1", "s2", "c12"],
  },
];
// よくある質問（画面と FAQPage の構造化データの両方に使う）。
const FAQ = [
  { q: "回答は、どう扱われますか", a: "どの項目にどう回答したかは、会社や個人が特定されない形で集計し、事例の分析とチェック項目の改善に使います。会社名やメールアドレスを伺うのは、メールでご相談いただく場合だけです。" },
  { q: "担当外の項目は、どう答えればよいですか", a: "「分からない」を選んでください。結果の「確認が必要な項目」に並ぶので、担当部署への確認にお使いください。" },
  { q: "点数は、何を表しますか", a: "答えた項目のうち「はい」の割合を、100 点満点にしたものです。実際に起きた事例から作った点検の目安で、他社との比較ではありません。" },
  { q: "相談は無料ですか。製品の案内は来ますか", a: "無料です。お返事はメールだけで、お電話はしません。お返事に、Lemma（本物だと確認できたものだけを通す仕組み）のご案内を添えることがあります。ご案内は、メールに返信して「停止」とお伝えいただければ止めます。" },
  { q: "お返事はいつ届きますか", a: "3 営業日以内に、メールでお返事します。届かないときは、迷惑メールのフォルダもご確認ください。" },
  { q: "回答を残したくない場合は", a: "結果の下の「回答を消す」を押すと、このブラウザに残っている回答をすべて消去します。" },
];
const site = "https://lemma.frame00.com";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: `${site}/ja/` },
      { "@type": "ListItem", position: 2, name: "Critical Brief", item: `${site}/ja/critical/briefs/` },
      { "@type": "ListItem", position: 3, name: "不正の手口セルフチェック", item: `${site}/ja/critical/self-check/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "不正の手口セルフチェック",
    url: `${site}/ja/critical/self-check/`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    inLanguage: "ja",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
    publisher: { "@type": "Organization", name: "FRAME00株式会社" },
  },
];
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/critical/self-check/"
  localesAvailable={["ja"]}
  title={`ビジネスメール詐欺・不正送金の対策チェックリスト（実例 ${total} 項目・無料）｜Lemma`}
  ogTitle="なりすましによる不正送金を、止められていますか。担当別セルフチェック｜Lemma"
  jsonLd={jsonLd}
  description={`振込先の変更、社長や役員を装う送金の指示、偽のビデオ会議。国内外で実際に起きた事案から作った ${total} 項目で、経理・経営・情報システム・総務の担当ごとにセルフチェックできます。登録は不要です。`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <main class="ck">
    <section class="lp-hero">
      <div class="lp-in lp-hero-in">
        <div class="lp-hero-tx">
          <p class="lp-kicker">ビジネスメール詐欺・不正送金の対策チェックリスト</p>
          <h1>なりすましによる<br />不正送金を、<br /><mark>止められていますか。</mark></h1>
          <p class="lp-lead">実際の事案から作ったチェック項目で、担当ごとに点検。<br />お急ぎなら 3 分。</p>
          <div class="lp-cta">
            <a class="lp-btn" href="#who">無料でチェックする</a>
          </div>
          <ul class="lp-ticks">
            <li>無料</li>
            <li>登録不要</li>
          </ul>
          <div class="lp-proof">
            <div><b>{analyzed}<small>件</small></b><span>分析した<br />実際の事案</span></div>
            <div><b>{total}<small>項目</small></b><span>事案から作った<br />チェック項目</span></div>
            <div><b>毎週</b><span>新しい事案を<br />追加</span></div>
          </div>
          <p class="lp-by">
            国内外のサイバー攻撃・不正の事案を分析し、手口と対策を公開している
            <a href="/ja/critical/briefs/">Lemma Critical Brief</a> から作りました。
          </p>
        </div>
        <div class="lp-mock" aria-hidden="true">
          <div class="lp-mock-h"><span>振込先・口座の変更</span><span>10 項目</span></div>
          <div class="lp-mock-r"><i class="is-yes">✓</i><p>振込先の変更を、登録済みの連絡先で確認しているか。</p></div>
          <div class="lp-mock-r"><i class="is-no">✕</i><p>変わった直後の支払いを、照合が済むまで保留にしているか。</p></div>
          <div class="lp-mock-r"><i class="is-un">?</i><p>登録を変えてよい担当者の一覧があるか。</p></div>
          <div class="lp-mock-f"><strong>33</strong> 点<span>システムや業務の抜け漏れを点検し、対策を進めることをおすすめします</span></div>
        </div>
      </div>
    </section>

    <section class="lp-who" id="who" aria-labelledby="lp-who-h">
      <div class="lp-in">
        <h2 id="lp-who-h">あなたの担当は？</h2>
        <p class="lp-who-sub">選ぶと、その担当を狙ったなりすましや攻撃の手口に切り替わります。</p>
        <div class="lp-tabs" role="tablist" aria-label="担当">
          {PERSONAS.map((p, i) => (
            <button type="button" role="tab" class="lp-tab" data-lp-tab={p.key} aria-selected={i === 0 ? "true" : "false"}>{p.tab}</button>
          ))}
        </div>
        {PERSONAS.map((p, i) => (
          <div class="lp-panel" role="tabpanel" data-lp-panel={p.key} hidden={i !== 0}>
            <div class="lp-msg">
              <span class="lp-tag">⚠ {p.tag}</span>
              <div class={`lp-win lp-win--${p.ch}`}>
                <div class="lp-win-bar">
                  <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CH_ICON[p.ch]} />
                  <span>{p.chLabel}</span>
                </div>
                <div class="lp-win-head">
                  <span class="lp-win-av" aria-hidden="true">{p.av}</span>
                  <span class="lp-win-who"><b>{p.sender}</b><small>{p.addr}</small></span>
                </div>
                {p.subject && <p class="lp-win-subj">{p.subject}</p>}
                <p class="lp-bubble">「{p.msg}」</p>
              </div>
            </div>
            <div class="lp-real">
              <span class="lp-real-k">実際に起きたこと</span>
              <p>{p.real} <a href={`/ja/critical/briefs/${p.slug}/`}>事例を読む →</a></p>
              <span class="lp-real-k">まず、この 2 つ</span>
              <ul>
                {p.checks.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              <a class="lp-btn" href="#start" data-persona={p.key}>{p.tab}でチェックする<span aria-hidden="true"> →</span></a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="lp-figs" aria-label="実際に起きた事案">
      <div class="lp-in">
        <p class="lp-figs-h">なりすましで実際に起きた送金事故</p>
        <div class="lp-figs-row">
          {CASES.map((c) => (
            <a class="lp-fig" href={`/ja/critical/briefs/${c.slug}/`}>
              <b>{c.fig}<small>{c.unit}</small></b>
              <span>{c.kind}</span>
              <em>No.{c.slug.slice(0, 3)} を読む →</em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="ck-tool" id="start">
    <p class="ck-print-head" data-ck-print-head></p>
    <p class="ck-done" data-ck-done hidden>相談を受け付けました。3 営業日以内に、ご記入のメールアドレスへお返事します。届かないときは、迷惑メールのフォルダもご確認ください。</p>
    <h2 class="ck-tool-h">セルフチェック</h2>

    <section class="ck-step" aria-labelledby="ck-s1">
      <h2 id="ck-s1"><span class="ck-n">1</span>担当を選ぶ</h2>
      <div class="ck-who" role="group" aria-label="担当">
        {PERSONAS.map((p) => (
          <button type="button" class="ck-who-b" data-persona={p.key} data-ops={p.ops.join(",")} data-quick={p.quick.join(",")} aria-pressed="false">{p.tab}</button>
        ))}
      </div>
      <p class="ck-scenes" data-ck-scenes>
        <span class="ck-scenes-k">ねらわれやすい場面</span>
        <span class="ck-chips" data-ck-scenes-l></span>
        <button type="button" class="ck-link" data-ck-edit></button>
      </p>
      <div class="ck-ops" role="group" aria-label="場面" data-ck-ops hidden>
        {groups.map((g) => (
          <button type="button" class="ck-op" data-op={g.key} aria-pressed="false">
            <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
            <span class="ck-op-l">{g.label}</span>
            <span class="ck-op-c">{g.items.length} 項目</span>
          </button>
        ))}
      </div>
    </section>

    <section class="ck-step" aria-labelledby="ck-s2m" data-ck-mode hidden>
      <h2 id="ck-s2m"><span class="ck-n">2</span>進め方を選ぶ</h2>
      <div class="ck-modes" role="group" aria-label="進め方">
        <button type="button" class="ck-mode" data-mode="quick" aria-pressed="false">
          <b>お急ぎ点検</b>
          <span data-ck-mode-c="quick"></span>
        </button>
        <button type="button" class="ck-mode" data-mode="full" aria-pressed="false">
          <b>じっくり点検</b>
          <span data-ck-mode-c="full"></span>
        </button>
      </div>
    </section>

    <section class="ck-step" aria-labelledby="ck-s2" data-ck-items hidden>
      <h2 id="ck-s2"><span class="ck-n" data-ck-n>3</span>チェック項目に答える</h2>
      <dl class="ck-legend">
        <div><dt class="is-yes">はい</dt><dd>決まっていて、そのとおりに運用している</dd></div>
        <div><dt class="is-no">いいえ</dt><dd>決まっていない・運用していない</dd></div>
        <div><dt class="is-un">分からない</dt><dd>担当外・社内で確認できない</dd></div>
      </dl>
      <p class="ck-hint ck-legend-note">1 つの項目に 2 つの内容があるときは、両方を満たすときだけ「はい」。もう一度押すと取り消せます。</p>
      {groups.map((g) => (
        <div class="ck-group" data-group={g.key} hidden>
          <h3 class="ck-gh">{g.label}</h3>
          <ol class="ck-list">
            {g.items.map((it) => (
              <li class="ck-item" data-item={it.id} data-src={it.sources.map((x) => x.id).join(" ")}>
                <div class="ck-q">
                  <p>{it.text}</p>
                  <div class="ck-src">
                    <span class="ck-from">いま読んでいた記事の項目</span>
                    <span class="ck-src-l">事例</span>
                    {it.sources.map((x) => (
                      <a href={`/ja/critical/briefs/${x.id}/`} target="_blank" rel="noopener" title={x.title}>No.{pad(x.no)}</a>
                    ))}
                  </div>
                </div>
                <div class="ck-ans" role="radiogroup" aria-label={it.text}>
                  <button type="button" role="radio" aria-checked="false" data-v="yes">はい</button>
                  <button type="button" role="radio" aria-checked="false" data-v="no">いいえ</button>
                  <button type="button" role="radio" aria-checked="false" data-v="unsure">分からない</button>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="ck-step ck-result" aria-labelledby="ck-s3" data-ck-result hidden>
      <h2 id="ck-s3"><span class="ck-n" data-ck-n>4</span>結果</h2>
      <p class="ck-sum" data-ck-sum></p>
      <div class="ck-score" data-ck-score hidden>
        <div class="ck-score-n"><b data-ck-score-n></b><span>点</span></div>
        <div class="ck-score-bar" aria-hidden="true"><i data-ck-score-bar></i></div>
        <p class="ck-score-msg" data-ck-score-msg></p>
        <p class="ck-score-help">自社での確認や見直しが難しい場合は、メールでご相談いただけます。</p>
        <a class="ck-btn" data-ck-consult href={CONSULT_FORM_URL} target="_blank" rel="noopener"><svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="16" height="12" rx="2"/><path d="M3.5 6l7.5 6 7.5-6"/></svg>メールで相談する（無料）<span aria-hidden="true">→</span></a>
      </div>
      <button type="button" class="ck-more" data-ck-more hidden></button>
      <div data-ck-gaps></div>
      <div class="ck-tools">
        <button type="button" class="ck-sub" data-ck-print>結果を PDF で保存</button>
        <button type="button" class="ck-sub" data-ck-reset>回答を消す</button>
        <a class="ck-sub" href={BRIEF_WEEKLY_URL} target="_blank" rel="noopener">新しい事例をメールで受け取る</a>
      </div>
      <p class="ck-fine">
        相談のお返事は、FRAME00 の担当者からメールで 3 営業日以内にお送りします。お返事に Lemma のご案内を添えることがあります（返信で止められます）。被害が発生している場合は、取引銀行と警察（#9110）に直ちにご連絡ください。
      </p>
      <p class="ck-print-only">
        相談・最新のチェック項目：https://lemma.frame00.com/ja/critical/self-check/
      </p>
    </section>

    <section class="ck-faq" aria-labelledby="ck-faq-h">
      <h3 id="ck-faq-h">よくある質問</h3>
      {FAQ.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
    <p class="ck-note">
      この点検と、メールでのお返事は、公開された事例にもとづく一般的な情報の提供で、特定の組織への監査・診断・助言ではありません。網羅性・正確性や、不正を防ぐ効果は保証しません。© 2026 FRAME00株式会社
    </p>
    </div>

    <section class="lp-list" aria-labelledby="lp-list-h">
      <div class="lp-in">
        <p class="lp-sec-k">一覧</p>
        <h2 id="lp-list-h">場面別 チェック項目の一覧</h2>
        <details class="lp-list-more">
        <summary>全 {total} 項目を見る</summary>
        <div class="lp-list-grid">
          {groups.map((g) => (
            <section class="lp-list-g">
              <h3>{g.label}の不正対策チェック<span>{g.items.length} 項目</span></h3>
              <ul>
                {g.items.map((it) => (
                  <li>{it.text}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        </details>
      </div>
    </section>

    <section class="lp-lemma" aria-labelledby="lp-lemma-h">
      <div class="lp-in lp-lemma-in">
        <div>
          <p class="lp-sec-k lp-sec-k--on">Lemma について</p>
          <h2 id="lp-lemma-h">人の注意だけに頼らず、<br />照合できたものだけを通す</h2>
          <p>
            振込先の変更や送金の承認の手前で、本物だと照合できたものだけを通す。Lemma（FRAME00株式会社）は、その仕組みを作っています。
          </p>
        </div>
        <div class="lp-lemma-cta">
          <a class="lp-btn" href={CONSULT_FORM_URL} target="_blank" rel="noopener" data-ck-consult>無料でメール相談する</a>
          <a class="lp-btn lp-btn--light" href="/ja/">Lemma を見る</a>
        </div>
      </div>
    </section>

    <section class="lp-final">
      <div class="lp-in">
        <h2>まずは、あなたの担当の 3 分から。</h2>
        <a class="lp-btn" href="#who">無料でチェックする</a>
      </div>
    </section>

    <div class="ck-bar" data-ck-bar hidden>
      <span class="ck-bar-tx" data-ck-progress></span>
      <a href="#ck-s3" class="ck-bar-btn" data-ck-bar-btn>結果を見る</a>
      <span class="ck-bar-meter" aria-hidden="true"><i data-ck-meter></i></span>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script is:inline>
  (function () {
    var KEY = "lemma_selfcheck_v2";
    var root = document.querySelector(".ck");
    if (!root) return;
    // persona：選んだ担当（無ければ場面を手で選んだか記事から来た＝全項目）。
    // mode：quick（お急ぎ点検）／full（じっくり点検）。
    var state = { ops: [], ans: {}, persona: null, mode: null };
    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || "null");
      if (saved && saved.ans) {
        state = { ops: saved.ops || [], ans: saved.ans, persona: saved.persona || null, mode: saved.mode || null };
      }
    } catch (e) {}
    var editing = false;
    var params = new URLSearchParams(location.search);
    var from = params.get("from");
    // 相談のフォームから戻ったとき（?form=consult）。
    if (params.get("form") === "consult") root.querySelector("[data-ck-done]").hidden = false;
    var started = false;
    var toolInView = false;
    function save() {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (e) {}
    }
    function ev(name, params) {
      if (typeof window.gtag === "function") window.gtag("event", name, params || {});
    }
    var $ = function (s, el) { return (el || root).querySelector(s); };
    var $$ = function (s, el) { return Array.prototype.slice.call((el || root).querySelectorAll(s)); };

    // 記事から来たとき：その記事の項目に印を付けて各場面の先頭へ寄せ、
    // その記事のいちばん近い場面を選ぶ。
    if (from) {
      var mine = $$(".ck-item").filter(function (li) {
        return (li.getAttribute("data-src") || "").split(" ").indexOf(from) >= 0;
      });
      mine.slice().reverse().forEach(function (li) {
        li.classList.add("is-from");
        li.parentNode.insertBefore(li, li.parentNode.firstChild);
      });
      if (mine.length) {
        var g = mine[0].closest("[data-group]").getAttribute("data-group");
        if (state.ops.indexOf(g) < 0) state.ops.push(g);
        if (state.persona && state.mode === "quick") state.mode = "full";
      }
    }
    function personaBtn(key) {
      return key ? $('.ck-who-b[data-persona="' + key + '"]') : null;
    }
    function quickOf(key) {
      var b = personaBtn(key);
      var out = {};
      if (b) b.getAttribute("data-quick").split(",").forEach(function (id) { out[id] = true; });
      return out;
    }
    function minutes(n) {
      return Math.max(1, Math.round((n * 25) / 60));
    }
    function choosePersona(key) {
      var b = personaBtn(key);
      if (!b) return;
      state.persona = key;
      state.ops = b.getAttribute("data-ops").split(",");
      state.mode = null;
      editing = false;
      save();
      render();
      ev("self_check_persona_start", { persona: key, ops: state.ops.join(",") });
    }

    function render() {
      $$(".ck-op").forEach(function (b) {
        b.setAttribute("aria-pressed", String(state.ops.indexOf(b.getAttribute("data-op")) >= 0));
      });
      $$(".ck-who-b").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-persona") === state.persona));
      });
      var any = state.ops.length > 0;
      var persona = personaBtn(state.persona) ? state.persona : null;
      // 担当を選んだときは進め方を選んでから答える。場面を手で選んだときは全項目。
      var ready = any && (!persona || !!state.mode);
      var quick = persona && state.mode === "quick" ? quickOf(persona) : null;
      // 場面：担当を選ぶと自動で選ばれる。「変える」で足したり外したりできる。
      var labels = state.ops.map(function (k) {
        var l = $('.ck-op[data-op="' + k + '"] .ck-op-l');
        return l ? l.textContent : k;
      });
      var sl = $("[data-ck-scenes-l]");
      sl.innerHTML = "";
      labels.forEach(function (l) {
        var c = document.createElement("span");
        c.className = "ck-chip";
        c.textContent = l;
        sl.appendChild(c);
      });
      $("[data-ck-scenes]").querySelector(".ck-scenes-k").hidden = !any;
      $("[data-ck-edit]").textContent = editing ? "閉じる" : any ? "変える" : "担当にないときは、場面から選ぶ";
      $("[data-ck-ops]").hidden = !editing;
      $("[data-ck-mode]").hidden = !(any && persona);
      $$("[data-ck-n]").forEach(function (n, i) { n.textContent = String(i + (persona ? 3 : 2)); });
      $("[data-ck-items]").hidden = !ready;
      $("[data-ck-result]").hidden = !ready;
      // 下の固定バーは、セルフチェックが画面に入っているときだけ（LP の上では出さない）。
      $("[data-ck-bar]").hidden = !ready || !toolInView;
      // 複数の場面に出る項目は、選んだ場面のうち最初の 1 か所にだけ出す。
      // お急ぎ点検のときは、その担当の quick の項目だけを出す。
      var seen = {};
      var shown = [];
      var all = [];
      var quickAll = persona ? quickOf(persona) : {};
      var quickN = 0;
      $$(".ck-item").forEach(function (li) {
        var id = li.getAttribute("data-item");
        var inOpen = state.ops.indexOf(li.closest("[data-group]").getAttribute("data-group")) >= 0;
        var first = inOpen && !seen[id];
        if (first) {
          seen[id] = true;
          all.push(li);
          if (quickAll[id]) quickN++;
        }
        var vis = first && (!quick || !!quick[id]);
        li.hidden = !vis;
        if (vis) shown.push(li);
        var v = state.ans[id];
        $$("[data-v]", li).forEach(function (b) {
          b.setAttribute("aria-checked", String(b.getAttribute("data-v") === v));
        });
        li.setAttribute("data-state", v || "");
      });
      $$("[data-group]").forEach(function (g) {
        g.hidden = !$(".ck-item:not([hidden])", g);
      });
      $('[data-ck-mode-c="quick"]').textContent = quickN + " 項目・約 " + minutes(quickN) + " 分";
      $('[data-ck-mode-c="full"]').textContent = all.length + " 項目・約 " + minutes(all.length) + " 分";
      $$(".ck-mode").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-mode") === state.mode));
      });
      var rest = all.length - shown.length;
      $("[data-ck-more]").hidden = !quick || rest <= 0;
      $("[data-ck-more]").textContent = "残りの " + rest + " 項目も点検する →";
      var answered = 0;
      var gaps = [];
      shown.forEach(function (li) {
        var v = state.ans[li.getAttribute("data-item")];
        if (v) answered++;
        if (v === "no" || v === "unsure") gaps.push(li);
      });
      // 下のバー：あと何項目か（答え終わったら結果へ誘う）。各項目に「n / 全体」。
      var left = shown.length - answered;
      $("[data-ck-progress]").innerHTML = left
        ? "あと <b>" + left + "</b> 項目<small>" + answered + " / " + shown.length + "</small>"
        : "<b>すべて回答しました</b>";
      $("[data-ck-meter]").style.width = (shown.length ? (answered / shown.length) * 100 : 0) + "%";
      $("[data-ck-bar]").classList.toggle("is-done", !left && shown.length > 0);
      $("[data-ck-bar-btn]").textContent = left ? "結果を見る" : "結果を見る →";
      shown.forEach(function (li, i) {
        li.querySelector(".ck-q").setAttribute("data-n", i + 1 + " / " + shown.length);
      });
      var unsure = gaps.filter(function (li) { return state.ans[li.getAttribute("data-item")] === "unsure"; }).length;
      $("[data-ck-sum]").textContent = !answered
        ? "上の項目に回答すると、ここに点数が表示されます。"
        : (quick ? "お急ぎ点検（" + shown.length + " 項目）の結果です。" : "") +
          (answered < shown.length
            ? "未回答の項目が " + (shown.length - answered) + " 項目あります。回答済みの項目で点数を出しています。"
            : "");
      // 点数（答えた項目のうち「はい」の割合を 100 点満点で）と、点数ごとの軽い説明。
      var yes = answered - gaps.length;
      $("[data-ck-score]").hidden = !answered;
      if (answered) {
        var score = Math.round((yes / answered) * 100);
        $("[data-ck-score-n]").textContent = String(score);
        $("[data-ck-score-bar]").style.width = score + "%";
        // 点数ごとの軽い説明（「備えができています」とは言わない：責任が持てないため）。
        // 1 項目でも「いいえ」「分からない」があれば、警戒が要ると先に言う。
        var msg =
          score === 100
            ? "チェックした範囲の項目は、すべて「はい」でした。手口は年々増えているため、システムや業務に新たな抜け漏れがないか、定期的な点検をおすすめします。"
            : "「いいえ」「分からない」の項目が 1 つでもあると、実際の事案と同じ手口で、送金事故や情報の流出が起きるおそれがあります。" +
              (score >= 40
                ? "システムや業務の抜け漏れを点検し、対策を進めることをおすすめします。"
                : "システムや業務の抜け漏れを点検し、早めに対策を進めることをおすすめします。");
        $("[data-ck-score-msg]").textContent =
          msg + (unsure * 2 >= answered ? "「分からない」が多い場合は、まず担当部署にご確認ください。" : "");
      }
      // 確認したい項目（いいえを先に）。業務ごとにまとめ、元の事例へのリンクを添える。
      gaps.sort(function (a, b) {
        var va = state.ans[a.getAttribute("data-item")] === "no" ? 0 : 1;
        var vb = state.ans[b.getAttribute("data-item")] === "no" ? 0 : 1;
        return va - vb;
      });
      var box = $("[data-ck-gaps]");
      box.innerHTML = gaps.length ? '<p class="ck-gaps-h">確認が必要な項目</p>' : "";
      var byGroup = {};
      gaps.forEach(function (li) {
        var g = li.closest("[data-group]");
        var key = g.getAttribute("data-group");
        if (!byGroup[key]) {
          byGroup[key] = document.createElement("div");
          byGroup[key].className = "ck-gap";
          var h = document.createElement("b");
          h.textContent = g.querySelector(".ck-gh").textContent;
          byGroup[key].appendChild(h);
          byGroup[key].appendChild(document.createElement("ul"));
          box.appendChild(byGroup[key]);
        }
        var v = state.ans[li.getAttribute("data-item")];
        var item = document.createElement("li");
        item.innerHTML = '<span class="ck-tag ck-tag--' + v + '">' + (v === "no" ? "いいえ" : "分からない") + "</span>";
        item.appendChild(document.createTextNode(li.querySelector("p").textContent));
        var src = li.querySelector(".ck-src").cloneNode(true);
        var mark = src.querySelector(".ck-from");
        if (mark) mark.remove();
        src.className = "ck-gap-src";
        item.appendChild(src);
        byGroup[key].querySelector("ul").appendChild(item);
      });
      // 「いいえ」と「分からない」を分けて渡す（返事が変わるため）。長すぎるときは項目の境目で切る。
      var idsOf = function (v) {
        var out = "";
        gaps.forEach(function (li) {
          var id = li.getAttribute("data-item");
          if (state.ans[id] !== v) return;
          var next = out ? out + "," + id : id;
          if (next.length <= 600) out = next;
        });
        return out;
      };
      var gapIds = idsOf("no") + (idsOf("unsure") ? "|" + idsOf("unsure") : "");
      $$("[data-ck-consult]").forEach(function (link) {
        var u = new URL(link.getAttribute("href"));
        u.searchParams.set("ops", state.ops.join(","));
        u.searchParams.set("gaps", gapIds);
        u.searchParams.set("no", idsOf("no"));
        u.searchParams.set("unsure", idsOf("unsure"));
        u.searchParams.set("ref", from ? "selfcheck_from_brief" : "selfcheck");
        if (link.getAttribute("data-q")) u.searchParams.set("q", link.getAttribute("data-q"));
        link.href = u.toString();
      });
    }

    root.addEventListener("click", function (e) {
      var tab = e.target.closest("[data-lp-tab]");
      if (tab) {
        var key = tab.getAttribute("data-lp-tab");
        $$("[data-lp-tab]").forEach(function (t) { t.setAttribute("aria-selected", String(t === tab)); });
        $$("[data-lp-panel]").forEach(function (p) { p.hidden = p.getAttribute("data-lp-panel") !== key; });
        ev("self_check_persona", { persona: key });
        return;
      }
      var who = e.target.closest("[data-persona]");
      if (who) {
        // 担当：その担当の場面をまとめて選び、進め方を聞く（前に選んだ場面は外す。答えは残る）。
        choosePersona(who.getAttribute("data-persona"));
        return;
      }
      var mode = e.target.closest("[data-mode]");
      if (mode) {
        state.mode = mode.getAttribute("data-mode");
        save();
        render();
        ev("self_check_mode", { mode: state.mode, persona: state.persona });
        var first = $(".ck-item:not([hidden])");
        if (first) first.closest("[data-group]").scrollIntoView({ block: "start", behavior: "smooth" });
        return;
      }
      if (e.target.closest("[data-ck-more]")) {
        state.mode = "full";
        save();
        render();
        ev("self_check_more", { persona: state.persona });
        var next = $$(".ck-item:not([hidden])").filter(function (li) { return !state.ans[li.getAttribute("data-item")]; })[0];
        if (next) next.scrollIntoView({ block: "center", behavior: "smooth" });
        return;
      }
      if (e.target.closest("[data-ck-edit]")) {
        editing = !editing;
        render();
        return;
      }
      var op = e.target.closest(".ck-op");
      if (op) {
        var k = op.getAttribute("data-op");
        var i = state.ops.indexOf(k);
        if (i >= 0) state.ops.splice(i, 1);
        else state.ops.push(k);
        save();
        render();
        return;
      }
      var b = e.target.closest(".ck-ans [data-v]");
      if (b) {
        var id = b.closest(".ck-item").getAttribute("data-item");
        var v = b.getAttribute("data-v");
        var fresh = !state.ans[id];
        if (state.ans[id] === v) delete state.ans[id];
        else state.ans[id] = v;
        if (!started) {
          started = true;
          ev("self_check_start", { from_brief: from || undefined });
        }
        // リサーチ用：どの項目にどう答えたか（会社や個人は分からない形・GA4 の
        // カスタムディメンション check_item / check_answer で集計）。
        if (state.ans[id]) {
          ev("self_check_answer", {
            check_item: id,
            check_answer: state.ans[id],
            check_op: b.closest("[data-group]").getAttribute("data-group"),
          });
        }
        save();
        render();
        // 初めて答えた項目なら、次の未回答の項目が画面の下にあるとき、そこまで送る。
        if (fresh) {
          var cur = b.closest(".ck-item");
          var list = $$(".ck-item:not([hidden])");
          var nxt = list.slice(list.indexOf(cur) + 1).filter(function (li) { return !state.ans[li.getAttribute("data-item")]; })[0];
          if (nxt && nxt.getBoundingClientRect().top > window.innerHeight * 0.62) {
            setTimeout(function () { nxt.scrollIntoView({ block: "center", behavior: "smooth" }); }, 180);
          }
        }
        return;
      }
      if (e.target.closest("[data-ck-print]")) {
        ev("self_check_print");
        var labels = state.ops.map(function (k) {
          var b = $('.ck-op[data-op="' + k + '"] .ck-op-l');
          return b ? b.textContent : k;
        });
        $("[data-ck-print-head]").textContent =
          "セルフチェックの結果（" + new Date().toLocaleDateString("ja-JP") + "）　場面：" + labels.join("、");
        window.print();
        return;
      }
      if (e.target.closest("[data-ck-reset]")) {
        if (!window.confirm("このブラウザに残っている回答を、すべて消去します。よろしいですか。")) return;
        state.ans = {};
        save();
        render();
        return;
      }
      if (e.target.closest("[data-ck-consult]")) {
        ev("self_check_consult", { ops: state.ops.join(","), gaps: $$(".ck-gap li").length, example: !!e.target.closest("[data-q]") });
      }
    });

    // 結果まで読んだら 1 回だけ数える。
    var counted = false;
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (x) {
          if (!x.isIntersecting || counted || x.target.hidden) return;
          counted = true;
          ev("self_check_result", {
            ops: state.ops.join(","),
            answered: Object.keys(state.ans).length,
            gaps: $$(".ck-gap li").length,
          });
        });
      }).observe($("[data-ck-result]"));
    }

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        toolInView = es[0].isIntersecting;
        render();
      }).observe($(".ck-tool"));
    }
    render();
    if (from) {
      var target = $(".ck-item.is-from:not([hidden])");
      if (target) setTimeout(function () { target.scrollIntoView({ block: "center" }); }, 60);
    }
  })();
</script>

<style>
  .ck {
    /* ボタンの角（DESIGN.md のボタン）。ラベルは丸のまま。 */
    --btn-r: 4px;
    padding: 0 0 120px;
    color: #16190f;
    background: #fbfaf5;
  }
  .ck-tool {
    max-width: 960px;
    margin: 24px auto 0;
    padding: 44px 56px 48px;
    background: #fff;
    border: 1px solid #e3e6dc;
    border-radius: 24px;
    box-shadow: 0 18px 50px rgba(47, 55, 47, 0.08);
