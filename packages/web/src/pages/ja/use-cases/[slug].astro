---
import UseCaseDetailTemplate from "../../../templates/UseCaseDetailTemplate.astro";
import { getAllUseCases, getUseCasesBySlugs } from "../../../data/useCases";
import { getPillarBySlug } from "../../../data/pillars";
import { getTranslations } from "../../../i18n/translations";

export async function getStaticPaths() {
  const useCases = await getAllUseCases("ja");

  const paths = await Promise.all(
    useCases.map(async (useCase) => {
      const pillar = getPillarBySlug(useCase.pillar);
      const relatedUseCases = await getUseCasesBySlugs(useCase.relatedUseCases, "ja");

      return {
        params: { slug: useCase.slug },
        props: { useCase, pillar, relatedUseCases },
      };
    }),
  );

  return paths;
}

interface Props {
  useCase: import("../../../data/useCases").UseCase;
  pillar: import("../../../data/pillars").Pillar | undefined;
  relatedUseCases: ReadonlyArray<import("../../../data/useCases").UseCase>;
}

const { useCase, pillar, relatedUseCases } = Astro.props;
const locale = "ja" as const;
const t = getTranslations(locale);
const base = "/ja";
const pillarT = t.pillars;
const useCaseT = t.useCases;

// Fallback pillar if not found
const fallbackPillar = {
  slug: "verifiable-origin" as const,
  title: { en: "Verifiable Origin", ja: "来歴証明" },
  slogan: { en: "Cryptographically valid ≠ semantically right", ja: "暗号論理的に有効 ≠ 意味的に正しい" },
  subtitle: { en: "Incident-grade Data Trust", ja: "インシデント級のデータ信頼" },
  problemStatement: { en: "", ja: "" },
  whyNow: { en: "", ja: "" },
  howLemmaFits: { en: [], ja: [] },
  useCaseSlugs: [],
  primaryCTA: { label: "お問い合わせ", href: "/ja/services", type: "talk-to-us" as const },
  order: 1,
  tags: [],
};

const actualPillar = pillar ?? fallbackPillar;
---

<UseCaseDetailTemplate
  locale={locale}
  t={t}
  base={base}
  useCase={useCase}
  pillar={actualPillar}
  pillarT={pillarT}
  useCaseT={useCaseT}
  relatedUseCases={relatedUseCases}
/>