---
/**
 * Lemma Civic — 公共・自治体（B2B2G）向けプランページ（JA）。
 *
 * Wave 1 / Civic 確定コピー（買い手向け商品フィット型、FDE 相談先行、価格はご相談ベース）。
 *
 * 許諾（permission）ゲート: 公開時点は「許諾前」。MizuDAkO 案件は一切出さない —
 *   - ヒーローの実績バッジは掲出しない
 *   - §6 は「導入事例」ではなく「活用例（想定シナリオ）」を掲出し、
 *     水インフラ／住民参加／自治体名の文脈は出さない
 * 許諾後（プレスリリース連動）に実績バッジ掲出＋導入事例へ差し替える。該当箇所に
 * "許諾後:" コメントを残してある。
 *
 * アクセント = サンドブラウン #8B4513（グローバル --accent と一致）。価格・¥ は出さない。
 */
import Layout from "../../../../layouts/Layout.astro";
import Navigation from "../../../../components/Navigation.astro";
import Footer from "../../../../components/Footer.astro";
import HubSpotDrawer from "../../../../components/HubSpotDrawer.astro";
import CivicIcon from "../../../../components/civic/CivicIcon.astro";
import { getTranslations } from "../../../../i18n/translations";
import { DISCOVERY_CALL_URL } from "../../../../config/cta";

const locale = "ja" as const;
const t = getTranslations(locale);
const base = "/ja" as const;

const contactUrl = DISCOVERY_CALL_URL[locale];
const useCasesUrl = `${base}/solutions/use-cases/`;

const metaTitle =
  "Lemma Civic — 自治体の記録を、AI に任せられる確かなデータに｜公共・自治体向けプラン";
const metaDesc =
  "窓口・給付・住民参加など自治体の現場で生まれる記録に、中身を見せずに真正性を付与。個人情報を見せず、いつもの運用のまま AI 活用へ。公共・自治体（B2B2G）向け、拠点数ベースの段階プラン。";

const doItems = [
  {
    icon: "check",
    h: "資格・条件を中身を見せず確認",
    p: "受給資格・年齢・資格などを、個人情報を出さずに。",
  },
  {
    icon: "history",
    h: "改ざん不能な来歴の記録",
    p: "監査と説明責任のための、書き換えられない記録。",
  },
  {
    icon: "template",
    h: "標準テンプレートで小さく",
    p: "公共向けひな型から、特定の業務ひとつを選んで。",
  },
] as const;

const flowItems = [
  {
    n: "01",
    icon: "inbox",
    h: "集める",
    lead: "住民・事業者が記録を出す",
    p: "いつもの申請・活動のまま。新しい操作は増えません。",
  },
  {
    n: "02",
    icon: "shield-check",
    h: "確かめる",
    lead: "職員は中身を見ずに確認",
    p: "「条件を満たす・本物である」だけを確認して処理を進める。",
  },
  {
    n: "03",
    icon: "database",
    h: "残す・活かす",
    lead: "改ざんなく残り、AI に使える",
    p: "監査でも AI 活用でも、後から検証できる形で残ります。",
  },
] as const;

const tiers = [
  { name: "Tier 1", range: "1〜3 拠点" },
  { name: "Tier 2", range: "4〜10 拠点" },
  { name: "Tier 3", range: "11+ 拠点（カスタム）" },
];

const steps = [
  {
    n: "01",
    h: "お問い合わせ",
    lead: "ご相談・ご検討から",
    p: "30 分の対話も。機微情報の開示は不要。",
  },
  {
    n: "02",
    h: "PoC",
    lead: "区切った範囲で実証",
    p: "1 シナリオで実装・検証。",
  },
  {
    n: "03",
    h: "本番",
    lead: "既存運用を変えず展開",
    p: "前段に重ねるだけ。共存運用。",
  },
];

const useCases = [
  "補助金・給付の受給資格証明（給付）",
  "公共サービスの適格性証明（窓口）",
  "長期契約の記録・見積の証明（契約）",
  "有資格者の配置・安全教育の証明（人材）",
];
---

<Layout
  locale={locale}
  title={metaTitle}
  description={metaDesc}
  metaType="page"
  pagePath="/plans/civic/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="cv-page">
    <div class="cv-container">

      <!-- §1 HERO -->
      <section class="cv-hero">
        <div class="cv-hero-tags">
          <span class="cv-hero-badge">
            <span class="cv-hero-badge-tag">プラン</span>
            <span class="cv-hero-badge-name">Lemma Civic</span>
          </span>
          <span class="cv-hero-seg">公共・自治体（B2B2G）</span>
        </div>
        <h1 class="cv-h1">
          自治体の現場で生まれる記録を、<br />
          <span class="cv-accent">AI が安全に使えるデータに。</span>
        </h1>
        <p class="cv-lead">
          窓口対応・給付・福祉相談・住民参加など、現場で生まれる記録に、中身を見せずに改ざん不能な来歴と真正性を付与します。個人情報を見せずに、AI が安心して使えるデータ基盤を、いつもの運用を変えずに構築できます。
        </p>
        <div class="cv-hero-cta">
          <a href={contactUrl} class="cv-btn-primary" target="_blank" rel="noopener">問い合わせる</a>
          <span class="cv-hero-cta-note">導入のご相談・お見積もり・ご検討から。</span>
        </div>
        {/*
          許諾後: プレスリリース連動でのみ、ここに実績バッジを掲出する。
          <p class="cv-hero-badge">● 〔中山間地域の自治体〕で、実証から本番運用へ ── 〔水インフラ事業者〕と。</p>
          公開時点（許諾前）は案件特定を避けるため掲出しない。
        */}
      </section>

      <!-- §2 このプランでできること -->
      <section class="cv-section" aria-labelledby="cv-do-h">
        <p class="cv-section-label">このプランでできること</p>
        <h2 class="cv-section-h" id="cv-do-h">中身を見せずに、確かさだけを渡す。</h2>
        <div class="cv-do-grid">
          {doItems.map((item) => (
            <article class="cv-do-card">
              <span class="cv-do-icon"><CivicIcon name={item.icon} size={28} /></span>
              <h3 class="cv-do-h3">{item.h}</h3>
              <p class="cv-do-p">{item.p}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- §3 安心のひと息（つなぎ） -->
      <section class="cv-bridge">
        <span class="cv-bridge-icon"><CivicIcon name="shield-check" size={32} color="#F5EBDC" /></span>
        <blockquote class="cv-bridge-quote">
          持たないから、流出しない。任せても、証拠は残る。
        </blockquote>
        <p class="cv-bridge-body">
          Lemma が現場と AI の間に入り、中身は渡さずに「確かさ」だけを受け渡します。むずかしい処理は引き受けるので、いつもの業務のまま、安心して任せられます。
        </p>
      </section>

      <!-- §4 運用イメージ -->
      <section class="cv-section" aria-labelledby="cv-flow-h">
        <p class="cv-section-label">運用イメージ（いつもの業務のまま）</p>
        <h2 class="cv-section-h" id="cv-flow-h">新しい操作は、増えません。</h2>
        <ol class="cv-flow-grid">
          {flowItems.map((item) => (
            <li class="cv-flow-card">
              <span class="cv-flow-head">
                <CivicIcon name={item.icon} size={22} />
                <span class="cv-flow-n">{item.n} {item.h}</span>
              </span>
              <h3 class="cv-flow-h3">{item.lead}</h3>
              <p class="cv-flow-p">{item.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- §5 対象とプラン構成 -->
      <section class="cv-section cv-tiers" aria-labelledby="cv-tiers-h">
        <p class="cv-section-label">対象とプラン構成</p>
        <h2 class="cv-section-h" id="cv-tiers-h">拠点数に応じた、段階プラン。</h2>
        <p class="cv-tiers-body">
          自治体・公益事業者、および B2B2G で市民向けサービスを提供する事業者向けです。複数拠点・複数自治体への展開にも、拠点数に応じた段階プランで対応します。
        </p>
        <div class="cv-tiers-grid">
          {tiers.map((tier) => (
            <div class="cv-tier-card">
              <span class="cv-tier-name">{tier.name}</span>
              <span class="cv-tier-range">{tier.range}</span>
            </div>
          ))}
        </div>
        <p class="cv-tiers-note">
          年契約・拠点数ベース。拠点や利用が増えたら上位ティアへアップグレード。標準サーキット・テンプレート構成。
        </p>
      </section>

      {/* §6 活用例（許諾前 = 想定シナリオ）。
          許諾後（プレスリリース連動）に「導入事例」へ差し替える — 差し替え文面は
          Wave 1 スペックの §6 を参照（特定につながる文脈は許諾前に出さないため、ここには
          書かない）。このブロックは JSX コメントなので出力 HTML には残らない。 */}
      <section class="cv-case" aria-labelledby="cv-case-h">
        <span class="cv-case-label">活用例 ［想定シナリオ］</span>
        <h2 class="cv-case-h" id="cv-case-h">補助金・給付の受給資格証明</h2>
        <p class="cv-case-body">
          所得や属性の中身を出さず「受給要件を満たす」ことだけを証明し、給付主体が検証できます。標準テンプレートで構成できる、Civic の代表的な使い方です。
        </p>
      </section>

      <!-- §7 進め方 -->
      <section class="cv-section" aria-labelledby="cv-steps-h">
        <p class="cv-section-label">進め方（一緒に作る・既存運用は止めない）</p>
        <h2 class="cv-section-h" id="cv-steps-h">小さく始めて、止めずに広げる。</h2>
        <ol class="cv-steps-grid">
          {steps.map((step) => (
            <li class="cv-step-card">
              <span class="cv-step-n">{step.n}</span>
              <h3 class="cv-step-h3">{step.h}</h3>
              <p class="cv-step-lead">{step.lead}</p>
              <p class="cv-step-p">{step.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- §8 このプランのユースケース（課題から選べる・リンク集約） -->
      <section class="cv-uc" aria-labelledby="cv-uc-h">
        <p class="cv-section-label">このプランのユースケース</p>
        <h2 class="cv-section-h" id="cv-uc-h">課題から選べます。</h2>
        <ul class="cv-uc-list">
          {useCases.map((uc) => (
            <li class="cv-uc-item">{uc}</li>
          ))}
        </ul>
        <a href={useCasesUrl} class="cv-uc-all">すべて見る →</a>
      </section>

      <!-- §9 締め -->
      <section class="cv-close">
        <div class="cv-close-band">
          <h2 class="cv-close-h2">導入して終わり、にはしません。</h2>
          <p class="cv-close-sub">エンジニアが現場に入り、PoC から本番まで伴走します。むずかしいところはお任せいただき、いつもの運用のまま、AI が安心して使えるデータ基盤を揃えます。</p>
          <a href={contactUrl} class="cv-btn-primary" target="_blank" rel="noopener">問い合わせる</a>
        </div>
      </section>

    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cv-page {
    --cv-display: "Sora", system-ui, sans-serif;
    --cv-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --cv-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --cv-text-1: #1a1a1a;
    --cv-text-2: #3a3a3a;
    --cv-text-3: #5a5a5a;
    --cv-text-4: #9a9a9a;
    background: var(--lemma-cream);
    color: var(--cv-text-2);
    font-family: var(--cv-body);
    font-weight: 400;
    line-height: 1.7;
    margin-top: 64px;
    padding: 0 0 24px;
  }

  .cv-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .cv-accent { color: var(--accent); }

  /* ─── shared section heads ─── */
  .cv-section-label {
    font-family: var(--cv-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cv-section-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .cv-section-h {
    font-family: var(--cv-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }

  /* ─── §1 HERO ─── */
  .cv-hero {
    padding: 72px 0 56px;
  }
  .cv-hero-tags {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 26px;
  }
  .cv-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--lemma-brown-light);
    border: 1px solid rgba(139, 69, 19, 0.22);
    padding: 7px 8px 7px 14px;
    border-radius: 999px;
    box-shadow: 0 2px 10px rgba(139, 69, 19, 0.08);
  }
  .cv-hero-badge-tag {
    font-family: var(--cv-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.75;
    border-right: 1px solid rgba(139, 69, 19, 0.28);
    padding-right: 10px;
  }
  .cv-hero-badge-name {
    font-family: var(--cv-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--lemma-cream);
    background: var(--accent);
    padding: 3px 12px;
    border-radius: 999px;
  }
  .cv-hero-seg {
    font-family: var(--cv-display);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--cv-text-3);
  }
  .cv-h1 {
    font-family: var(--cv-display);
    font-size: clamp(32px, 5vw, 50px);
    font-weight: 700;
    line-height: 1.22;
    color: var(--black);
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    max-width: 920px;
  }
  .cv-lead {
    font-size: 16px;
    color: var(--cv-text-2);
    line-height: 1.9;
    margin: 0 0 32px;
    max-width: 720px;
  }
  .cv-hero-cta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .cv-hero-cta-note {
    font-size: 12.5px;
    color: var(--cv-text-3);
  }

  /* ─── primary button ─── */
  .cv-btn-primary {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--lemma-cream);
    font-family: var(--cv-display);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 14px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.18s;
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.18);
  }
  .cv-btn-primary:hover { background: #6e3610; }

  /* ─── generic section spacing ─── */
  .cv-section {
    padding: 56px 0;
    border-top: 0.5px solid var(--lemma-line);
  }

  /* ─── §2 できること ─── */
  .cv-do-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .cv-do-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 28px 26px;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cv-do-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(139, 69, 19, 0.06);
  }
  .cv-do-icon {
    display: block;
    line-height: 0;
    margin: 0 0 14px;
  }
  .cv-do-h3 {
    font-family: var(--cv-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .cv-do-p {
    font-size: 14px;
    color: var(--cv-text-3);
    line-height: 1.8;
    margin: 0;
  }

  /* ─── §3 つなぎ ─── */
  .cv-bridge {
    margin: 0;
    padding: 64px 40px;
    background: #0f0f0f;
    color: var(--lemma-cream);
    border-radius: 20px;
    text-align: center;
  }
  .cv-bridge-icon {
    display: inline-flex;
    line-height: 0;
    margin: 0 0 10px;
  }
  .cv-bridge-quote {
    font-family: var(--cv-display);
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--lemma-cream);
    margin: 0 0 20px;
  }
  .cv-bridge-body {
    font-size: 15px;
    line-height: 1.95;
    color: rgba(252, 250, 245, 0.72);
    margin: 0 auto;
    max-width: 660px;
  }

  /* ─── §4 / §7 numbered steps ─── */
  .cv-flow-grid,
  .cv-steps-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .cv-flow-card,
  .cv-step-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 26px 24px;
  }
  .cv-flow-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
    line-height: 0;
  }
  .cv-flow-head .cv-flow-n {
    margin: 0;
  }
  .cv-flow-n,
  .cv-step-n {
    font-family: var(--cv-mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    display: block;
    line-height: 1.3;
    margin: 0 0 14px;
  }
  .cv-flow-h3,
  .cv-step-h3 {
    font-family: var(--cv-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 6px;
  }
  .cv-step-lead {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--cv-text-2);
    margin: 0 0 8px;
  }
  .cv-flow-p,
  .cv-step-p {
    font-size: 13px;
    color: var(--cv-text-3);
    line-height: 1.75;
    margin: 0;
  }

  /* ─── §5 tiers ─── */
  .cv-tiers-body {
    font-size: 15px;
    color: var(--cv-text-2);
    line-height: 1.9;
    margin: 0 0 28px;
    max-width: 760px;
  }
  .cv-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin: 0 0 22px;
  }
  .cv-tier-card {
    background: var(--lemma-cream-deep);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cv-tier-name {
    font-family: var(--cv-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cv-tier-range {
    font-family: var(--cv-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
  }
  .cv-tiers-note {
    font-size: 12.5px;
    color: var(--cv-text-3);
    line-height: 1.8;
    margin: 0;
  }

  /* ─── §6 case (想定シナリオ) ─── */
  .cv-case {
    margin: 56px 0;
    padding: 40px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 18px;
    position: relative;
    overflow: hidden;
  }
  .cv-case::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .cv-case-label {
    display: inline-flex;
