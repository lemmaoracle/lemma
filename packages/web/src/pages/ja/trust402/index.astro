<style>
:root {
  --lemma-black: #000000; --lemma-text-1: #1A1A1A; --lemma-text-2: #3A3A3A;
  --lemma-text-3: #5A5A5A; --lemma-text-4: #9A9A9A;
  --lemma-brown: #4B6B0F; --lemma-brown-light: #EEF6D0;
  --lemma-cream: #FCFAF5; --lemma-cream-deep: #F2EEDF;
  --lemma-line: #E5E5E5; --t402-green: #B6F500;
  --legacy-bg: #ECEBE5; --legacy-border: #B5AFA0; --legacy-text: #6E6957;
  --code-bg: #1A1612; --code-text: #D4CFC4;
  --font-display: 'Sora', system-ui, sans-serif;
  --font-body: 'Noto Sans JP', system-ui, sans-serif;
  --font-mono: 'Space Mono', ui-monospace, monospace;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--lemma-cream); color: var(--lemma-text-2); font-family: var(--font-body); font-weight: 400; line-height: 1.7; -webkit-font-smoothing: antialiased; }
.container { max-width: 1100px; margin: 0 auto; padding: 0 40px; }

/* === HERO (Seal-style: text + code + 2 cards + trust line) === */
.hero { padding: 60px 0 56px; max-width: 1020px; }
.eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--lemma-text-3); margin: 0 0 28px; display: flex; align-items: center; gap: 12px; }
.eyebrow::before { content: ""; display: inline-block; width: 28px; height: 1px; background: var(--lemma-brown); }
.eyebrow .accent { color: var(--lemma-brown); font-weight: 500; }
.h1 { font-family: var(--font-display); font-size: 64px; font-weight: 700; line-height: 0.96; margin: 0 0 26px; color: var(--lemma-black); letter-spacing: -0.04em; max-width: 720px; }
.h1 .accent { color: var(--lemma-brown); }
.hero-sub { font-size: 17px; color: var(--lemma-text-2); margin: 0 0 36px; line-height: 1.7; max-width: 600px; }
.hero-sub .k { color: var(--lemma-black); font-weight: 500; }

/* Hero code block + GIF demo side by side */
.hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 24px; margin: 0 0 44px; align-items: start; }
.hero-code { background: var(--lemma-text-1); border-radius: 14px; padding: 22px 26px; font-family: var(--font-mono); font-size: 13px; line-height: 1.85; color: #E8E2D4; overflow-x: auto; }
.hero-code .kw { color: #D4A574; }
.hero-code .str { color: #E5C9A1; }
.hero-code .fn { color: #F0DCB5; }
.hero-code .var { color: #FCFAF5; }
.hero-code .com { color: #7A7468; }
/* v8 — code-block dual view (mobile collapses to 1 line + expand button) */
.hero-code-mini { display: none; }
.hero-code-full { display: block; white-space: pre; font-family: inherit; font-size: inherit; line-height: inherit; color: inherit; margin: 0; }
.hero-code-expand { display: none; }
@media (max-width: 720px) {
  .hero-code-full { display: none; }
  .hero-code-mini { display: block; }
  .hero-code-expand {
    display: inline-block; margin-top: 14px;
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em;
    color: #A89C8E; background: transparent;
    border: 0.5px solid #3a3025; border-radius: 6px;
    padding: 6px 12px; cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .hero-code-expand:hover { color: #E8E2D4; border-color: #5a4d3d; }
  .hero-code.expanded .hero-code-full { display: block; }
  .hero-code.expanded .hero-code-mini { display: none; }
  .hero-code.expanded .hero-code-expand { display: none; }
}
.hero-demo { background: #0A0F0E; border-radius: 14px; padding: 0; overflow: hidden; position: relative; border: 0.5px solid rgba(0,0,0,0.1); }
.hero-demo::before { content: "DEMO · live"; position: absolute; top: 12px; right: 14px; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.22em; color: rgba(252,250,245,0.55); padding: 4px 9px; background: rgba(75, 107, 15,0.7); border-radius: 4px; z-index: 2; }
.hero-demo-frame { aspect-ratio: 16 / 10; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding: 22px 22px 18px; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; }
.hero-demo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* === Animated terminal demo === */
.term-line { display: block; opacity: 0; animation: term-line-in 0.4s ease forwards, term-cycle 14s ease infinite; }
.term-line .prompt { color: #5EE08E; font-weight: 500; margin-right: 8px; }
.term-line .cmd { color: rgba(252,250,245,0.92); }
.term-line .ok { color: #5EE08E; }
.term-line .ng { color: #D88A6B; }
.term-line .info { color: rgba(252,250,245,0.55); }
.term-line .accent { color: #E5C9A1; }
.term-line .meta { color: rgba(252,250,245,0.4); font-size: 10.5px; }
.term-line.success { color: #5EE08E; font-weight: 500; padding-top: 2px; }
.term-line.spacer { height: 4px; }
.term-line.cursor { color: #5EE08E; }
.term-line.cursor::after { content: "▏"; animation: caret 1s steps(1) infinite; }
@keyframes caret { 50% { opacity: 0; } }
@keyframes term-line-in { from { opacity: 0; transform: translateX(-4px); } to { opacity: 1; transform: translateX(0); } }
@keyframes term-cycle {
  0%, 70% { opacity: 1; }
  85%, 95% { opacity: 0; }
  100% { opacity: 1; }
}
.term-line:nth-child(1)  { animation-delay: 0.1s, 0s; }
.term-line:nth-child(2)  { animation-delay: 1.0s, 0s; }
.term-line:nth-child(3)  { animation-delay: 1.6s, 0s; }
.term-line:nth-child(4)  { animation-delay: 2.4s, 0s; }
.term-line:nth-child(5)  { animation-delay: 3.2s, 0s; }
.term-line:nth-child(6)  { animation-delay: 4.0s, 0s; }
.term-line:nth-child(7)  { animation-delay: 4.8s, 0s; }
.term-line:nth-child(8)  { animation-delay: 5.6s, 0s; }
.term-line:nth-child(9)  { animation-delay: 6.4s, 0s; }
.term-line:nth-child(10) { animation-delay: 6.8s, 0s; }
@media (prefers-reduced-motion: reduce) {
  .term-line { animation: none; opacity: 1; }
  .term-line.cursor::after { animation: none; }
}
@media (max-width: 760px) { .hero-grid { grid-template-columns: 1fr; } }

/* Hero 2 cards — v8 icon-led variant */
.t-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 760px; margin: 0 0 44px; }
.t-card {
  position: relative; background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 16px;
  padding: 30px 26px 26px;
  display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
  text-decoration: none; color: inherit;
  transition: border-color .2s, transform .2s, box-shadow .2s;
}
.t-card:hover { border-color: var(--lemma-brown); transform: translateY(-2px); box-shadow: 0 12px 30px rgba(75, 107, 15, 0.08); }
.t-card-icon { color: var(--lemma-brown); }
.t-card-icon svg { width: 52px; height: 52px; display: block; }
.t-card-title { font-family: var(--font-display); font-size: 19px; font-weight: 700; color: var(--lemma-black); line-height: 1.3; letter-spacing: -0.018em; margin: 0; }
.t-card-line { font-size: 13.5px; color: var(--lemma-text-3); line-height: 1.7; margin: 0; }
.t-card-btn { font-family: var(--font-display); font-size: 13px; font-weight: 500; color: var(--lemma-brown); margin-top: auto; padding-top: 4px; }
.t-card-badge { position: absolute; top: 16px; right: 16px; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.18em; color: var(--lemma-brown); background: var(--lemma-brown-light); padding: 4px 10px; border-radius: 999px; text-transform: uppercase; }
@media (max-width: 720px) {
  .t-cards { grid-template-columns: 1fr; gap: 12px; }
  .t-card { padding: 26px 22px; }
  .t-card-icon svg { width: 44px; height: 44px; }
}

.trust { font-size: 13px; color: var(--lemma-text-3); line-height: 1.8; padding-top: 26px; border-top: 0.5px solid var(--lemma-line); max-width: 720px; font-family: var(--font-mono); letter-spacing: 0.04em; }
.trust .strong { color: var(--lemma-black); font-weight: 500; }
.trust .dot { color: var(--lemma-brown); }

@media (max-width: 720px) { .h1 { font-size: 40px; } }

/* === DIFF strip: Trust402 = x402 + ... === */
.diff-strip { max-width: 1020px; margin: 0 0 64px; padding: 0; }
.diff-row { background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 18px; padding: 24px 28px; display: grid; grid-template-columns: 1fr auto 2fr auto 2fr; gap: 18px; align-items: stretch; position: relative; }
.diff-row::before { content: ""; position: absolute; top: 0; left: 0; height: 3px; width: 56px; background: var(--lemma-brown); border-radius: 0 0 3px 0; }
.diff-cell { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; border-radius: 12px; }
.diff-cell.base { background: var(--lemma-cream-deep); }
.diff-cell.add { background: var(--lemma-brown-light); }
.diff-cell.result { background: #2C2620; color: #FCFAF5; }
.diff-label { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--lemma-brown); font-weight: 500; }
.diff-cell.result .diff-label { color: rgba(252,250,245,0.55); }
.diff-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; background: rgba(75, 107, 15,0.12); color: var(--lemma-brown); margin: 4px 0; }
.diff-name { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: var(--lemma-text-1); letter-spacing: -0.005em; margin-top: auto; }
.diff-plus, .diff-equals { display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 28px; font-weight: 300; color: var(--lemma-brown); padding: 0 4px; }
.diff-add-list { display: flex; flex-direction: column; gap: 6px; margin-top: 2px; }
.diff-add-item { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: baseline; }
.diff-add-key { font-family: var(--font-mono); font-size: 11.5px; color: var(--lemma-brown); font-weight: 500; letter-spacing: 0.02em; }
.diff-add-mono { font-family: var(--font-body); font-size: 11px; color: var(--lemma-text-2); }
.diff-result-pill { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 13.5px; font-weight: 500; color: var(--lemma-cream); line-height: 1.5; letter-spacing: -0.005em; }
.diff-result-dot { width: 7px; height: 7px; border-radius: 50%; background: #5EE08E; flex-shrink: 0; }
.diff-result-mono { font-family: var(--font-mono); font-size: 10.5px; color: rgba(252,250,245,0.55); letter-spacing: 0.04em; margin-top: auto; }
@media (max-width: 880px) {
  .diff-row { grid-template-columns: 1fr; gap: 12px; }
  .diff-plus, .diff-equals { padding: 6px 0; }
}

/* === Section base === */
.section-block { margin: 0 0 80px; max-width: 1020px; }
.section-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--lemma-text-3); margin: 0 0 18px; display: flex; align-items: center; gap: 12px; }
.section-eyebrow::before { content: ""; display: inline-block; width: 28px; height: 1px; background: var(--lemma-brown); }
.section-h2 { font-family: var(--font-display); font-size: 40px; font-weight: 700; color: var(--lemma-black); letter-spacing: -0.03em; line-height: 1.08; margin: 0 0 20px; }
.section-h2 .accent { color: var(--lemma-brown); }
.section-sub { font-size: 15px; line-height: 1.75; color: var(--lemma-text-2); margin: 0 0 36px; max-width: 660px; }
.section-sub .k { color: var(--lemma-black); font-weight: 500; }

/* === §1 Without / With Trust402 === */
.impact-comparison { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0; align-items: stretch; }
.impact-panel { border-radius: 18px; padding: 26px 26px 28px; display: flex; flex-direction: column; gap: 16px; }
.impact-panel.before { background: var(--legacy-bg); border: 0.5px dashed var(--legacy-border); filter: saturate(0.65); }
.impact-panel.after { background: var(--lemma-cream); border: 0.5px solid var(--lemma-brown); box-shadow: 0 6px 28px rgba(75, 107, 15, 0.08); }
.impact-panel svg { width: 100%; height: auto; display: block; }
.impact-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
.impact-label::before { content: ""; display: block; width: 22px; height: 1px; }
.impact-panel.before .impact-label { color: var(--legacy-text); }
.impact-panel.before .impact-label::before { background: var(--legacy-text); }
.impact-panel.after .impact-label { color: var(--lemma-brown); }
.impact-panel.after .impact-label::before { background: var(--lemma-brown); }
.impact-summary { font-family: var(--font-display); font-size: 15px; font-weight: 500; line-height: 1.5; letter-spacing: -0.01em; }
.impact-panel.before .impact-summary { color: var(--legacy-text); }
.impact-panel.after .impact-summary { color: var(--lemma-black); }
.impact-panel.after .impact-summary .k { color: var(--lemma-brown); }
.migrate-bridge { display: flex; align-items: center; justify-content: center; width: 56px; }
@keyframes travel-pay { 0%{transform:translateX(-12px);opacity:0} 18%{opacity:1} 82%{opacity:1} 100%{transform:translateX(82px);opacity:0} }
.travel-pay-bare, .travel-pay-proof { animation: travel-pay 4s cubic-bezier(0.4,0,0.2,1) infinite; }
@keyframes pulse-soft { 0%,100%{transform:scale(1)} 50%{transform:scale(1.08)} }
.proof-pulse { transform-origin: center; transform-box: fill-box; animation: pulse-soft 2.4s ease-in-out infinite; }
@keyframes server-fade { 0%,100%{opacity:0.55} 50%{opacity:1} }
.server-record-fade { animation: server-fade 3s ease-in-out infinite; }
.server-record-fade:nth-child(odd) { animation-delay: 0s; }
.server-record-fade:nth-child(even) { animation-delay: 0.8s; }
.server-record-fade:nth-child(3n) { animation-delay: 1.5s; }
@media (prefers-reduced-motion: reduce) {
  .travel-pay-bare, .travel-pay-proof { animation: none; transform: translateX(35px); opacity: 1; }
  .proof-pulse, .server-record-fade { animation: none; }
}
@media (max-width: 720px) {
  .impact-comparison { grid-template-columns: 1fr; gap: 18px; }
  .migrate-bridge { width: 100%; padding: 4px 0; }
  .migrate-bridge svg { transform: rotate(90deg); }
}

/* === §2 How it works (visual flow) === */
.mech-block { background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 18px; padding: 40px 36px; }
.mech-svg { width: 100%; height: auto; display: block; }
.mech-caption { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--lemma-text-3); text-align: center; margin: 24px 0 0; padding-top: 20px; border-top: 0.5px solid var(--lemma-line); display: flex; align-items: center; justify-content: center; gap: 12px; }
.mech-caption .accent { color: var(--lemma-brown); font-weight: 500; }
/* v8 — mechanism mobile vertical cards (replace SVG ≤720px) */
.mech-mobile { display: none; flex-direction: column; gap: 12px; }
.mech-mstep { background: var(--lemma-cream); border: 0.5px solid var(--lemma-brown); border-radius: 14px; padding: 22px 22px; display: flex; align-items: center; gap: 16px; }
.mech-mlabel { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.24em; color: var(--lemma-brown); font-weight: 500; flex-shrink: 0; width: 56px; }
.mech-micon { color: var(--lemma-brown); flex-shrink: 0; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
.mech-mtitle { font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--lemma-text-1); line-height: 1.4; }
.mech-marrow { display: flex; justify-content: center; padding: 4px 0; color: var(--lemma-brown); }
.mech-marrow svg { width: 18px; height: 22px; }
.mech-mdash { stroke-dasharray: 6 4; animation: dashflow-v 1.6s linear infinite; }
@keyframes dashflow-v { to { stroke-dashoffset: -20; } }
@media (prefers-reduced-motion: reduce) { .mech-mdash { animation: none; } }
@media (max-width: 720px) {
  .mech-svg { display: none; }
  .mech-mobile { display: flex; }
  .mech-block { padding: 28px 18px; }
}
/* §2 step-flow dashflow arrows (v28 mech-step tone) */
.trust402-flow-arrow { stroke-dasharray: 6 4; animation: dashflow 1.6s linear infinite; }
@keyframes dashflow { to { stroke-dashoffset: -20; } }
@media (prefers-reduced-motion: reduce) { .trust402-flow-arrow { animation: none; } }
@keyframes pay-flow { 0%{transform:translateX(-10px);opacity:0} 25%{opacity:1} 75%{opacity:1} 100%{transform:translateX(75px);opacity:0} }
.pay-flow-dot { animation: pay-flow 3s cubic-bezier(0.4,0,0.2,1) infinite; }
.pay-flow-dot:nth-of-type(2) { animation-delay: 1s; }
.pay-flow-dot:nth-of-type(3) { animation-delay: 2s; }
@media (prefers-reduced-motion: reduce) { .pay-flow-dot { animation: none; opacity: 1; } }

/* === §3 Trust402 + Lemma context block === */
.context-block { background: var(--lemma-cream-deep); border-radius: 18px; padding: 40px 44px; display: grid; grid-template-columns: 1fr 1.2fr; gap: 36px; align-items: start; position: relative; }
.context-block::before { content: ""; position: absolute; top: 0; left: 0; height: 3px; width: 64px; background: var(--lemma-brown); border-radius: 0 0 3px 0; }
.context-left { display: flex; flex-direction: column; gap: 14px; }
.context-eyebrow { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--lemma-brown); font-weight: 500; }
.context-h3 { font-family: var(--font-display); font-size: 26px; font-weight: 600; color: var(--lemma-black); letter-spacing: -0.02em; line-height: 1.2; margin: 0; }
.context-h3 .accent { color: var(--lemma-brown); }
.context-desc { font-size: 14.5px; line-height: 1.85; color: var(--lemma-text-2); margin: 0; }
.context-desc .k { color: var(--lemma-black); font-weight: 500; }
.context-link { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; color: var(--lemma-brown); text-decoration: none; margin-top: 8px; transition: transform 0.2s; display: inline-block; }
.context-link:hover { transform: translateX(3px); }
.context-features { display: flex; flex-direction: column; gap: 12px; }
.ctx-card {
  background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 12px;
  padding: 18px 22px;
  display: grid; grid-template-columns: 32px 1fr; column-gap: 16px; row-gap: 4px;
  align-items: start;
  transition: border-color .15s, transform .15s;
}
.ctx-card:hover { border-color: var(--lemma-brown); }
.ctx-icon { color: var(--lemma-brown); grid-row: 1 / span 3; align-self: start; padding-top: 2px; }
.ctx-icon svg { width: 28px; height: 28px; display: block; }
.ctx-name { font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--lemma-black); letter-spacing: -0.005em; }
.ctx-desc { font-size: 13px; color: var(--lemma-text-3); margin: 0; line-height: 1.6; }
.ctx-mono { font-family: var(--font-mono); font-size: 10.5px; color: var(--lemma-brown); background: var(--lemma-brown-light); padding: 2px 8px; border-radius: 4px; letter-spacing: 0.04em; justify-self: start; margin-top: 2px; }
@media (max-width: 760px) { .context-block { grid-template-columns: 1fr; gap: 24px; padding: 28px 26px; } }
@media (max-width: 720px) {
  .ctx-card { padding: 16px 18px; column-gap: 14px; grid-template-columns: 28px 1fr; }
  .ctx-icon svg { width: 24px; height: 24px; }
}

/* === §4 Use cases — supplementary, compact === */
.uc-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 12px; }
.uc-card { background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 12px; padding: 18px 18px 16px; display: flex; flex-direction: column; gap: 10px; transition: border-color 0.2s, transform 0.2s; }
.uc-card:hover { border-color: rgba(75, 107, 15,0.4); transform: translateY(-2px); }
.uc-card-icon { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: var(--lemma-brown-light); border-radius: 8px; color: var(--lemma-brown); }
.uc-card-title { font-family: var(--font-display); font-size: 13.5px; font-weight: 600; color: var(--lemma-black); letter-spacing: -0.005em; line-height: 1.35; margin: 0; }
.uc-card-desc { font-size: 11.5px; color: var(--lemma-text-3); line-height: 1.6; margin: 0; }
@media (max-width: 880px) { .uc-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px) { .uc-grid { grid-template-columns: 1fr; } }

/* === §4 Plans brief === */
.plans-brief { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 12px; margin: 0 0 24px; }
.plan-brief-card { background: var(--lemma-cream-deep); border-radius: 12px; padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
.plan-brief-card .name { font-family: var(--font-display); font-size: 14.5px; font-weight: 600; color: var(--lemma-black); letter-spacing: -0.005em; margin: 0; }
.plan-brief-card .desc { font-size: 11.5px; color: var(--lemma-text-3); line-height: 1.6; margin: 0; flex: 1; }
.plan-brief-card .status { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--lemma-brown); margin: 6px 0 0; }
.plans-brief-cta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
.plans-brief-cta-primary { background: var(--lemma-brown); color: var(--lemma-cream); padding: 12px 26px; border-radius: 999px; font-family: var(--font-display); font-size: 13px; font-weight: 500; text-decoration: none; }
.plans-brief-cta-secondary { color: var(--lemma-text-2); font-size: 13px; text-decoration: none; font-family: var(--font-display); font-weight: 500; }
.plans-brief-cta-secondary:hover { color: var(--lemma-brown); }
@media (max-width: 880px) { .plans-brief { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px) { .plans-brief { grid-template-columns: 1fr; } }

/* === §5 FAQ === */
.faq-list { display: flex; flex-direction: column; gap: 0; border-top: 0.5px solid var(--lemma-line); }
.faq-item { padding: 22px 0; border-bottom: 0.5px solid var(--lemma-line); }
.faq-q { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--lemma-black); letter-spacing: -0.01em; margin: 0 0 8px; display: flex; align-items: baseline; gap: 12px; }
.faq-q::before { content: "Q."; font-family: var(--font-mono); font-size: 11px; color: var(--lemma-brown); letter-spacing: 0.1em; font-weight: 500; }
.faq-a { font-size: 13.5px; color: var(--lemma-text-2); line-height: 1.8; margin: 0; padding-left: 30px; }
.faq-a .k { color: var(--lemma-black); font-weight: 500; }
.faq-a code { font-family: var(--font-mono); font-size: 12px; background: var(--lemma-cream-deep); padding: 2px 6px; border-radius: 4px; color: var(--lemma-brown); }

/* === Vision close (v28 closing tone) === */
.vision { background: #0A0807; color: var(--lemma-cream); padding: 128px 40px; margin-top: 64px; text-align: center; }
.vision .container { max-width: 880px; padding: 0; }
.vision-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--lemma-brown); margin: 0 0 22px; }
.vision-h2 { font-family: var(--font-display); font-size: 56px; font-weight: 700; line-height: 1.12; margin: 0 0 28px; letter-spacing: -0.028em; color: var(--lemma-cream); font-style: normal; }
.vision-h2 .accent { color: var(--lemma-brown-light); }
.vision-sub { font-family: var(--font-display); font-size: 17px; color: rgba(252,250,245,0.8); margin: 0 auto 44px; max-width: 560px; line-height: 1.7; }
.vision-cta { display: flex; gap: 22px; justify-content: center; flex-wrap: wrap; }
.vision-cta-primary { background: var(--lemma-brown); color: var(--lemma-cream); padding: 14px 32px; border-radius: 999px; font-family: var(--font-display); font-size: 14px; font-weight: 500; text-decoration: none; }
.vision-cta-secondary { color: rgba(252,250,245,0.7); font-size: 14px; text-decoration: none; font-family: var(--font-display); padding: 12px 16px; }
.vision-cta-secondary:hover { color: var(--lemma-cream); }
@media (max-width: 720px) { .vision { padding: 80px 24px; } .vision-h2 { font-size: 38px; } }

/* === Mobile responsive (≤720px) — keep the page legible at phone widths === */
@media (max-width: 720px) {
  .container { padding: 0 24px; }
  .hero { padding: 32px 0 28px; }
  .eyebrow { font-size: 10px; letter-spacing: 0.18em; margin-bottom: 18px; }
  .hero-sub { font-size: 15.5px; margin-bottom: 24px; }
  /* mobile: lead with the animated terminal — hide the static code snippet so the hero isn't two stacked dark text blocks */
  .hero-code { display: none; }
  .hero-grid { margin-bottom: 28px; }
  .hero-demo-frame { padding: 16px 16px 14px; font-size: 10.5px; line-height: 1.5; }
  .hero-cards { gap: 14px; margin-bottom: 32px; }
  .hero-card { padding: 22px 20px 20px; }
  .trust { font-size: 11.5px; padding-top: 22px; }
  .diff-row { padding: 22px 20px; }
  .diff-cell { padding: 14px 14px; }
  .section-block { margin-bottom: 56px; }
  .section-h2 { font-size: 28px; line-height: 1.18; }
  .section-sub { font-size: 14px; }
  .mech-block { padding: 28px 18px; }
  .mech-caption { font-size: 9.5px; gap: 8px; flex-wrap: wrap; }
  .context-h3 { font-size: 22px; }
  .uc-card { padding: 22px 20px; }
  .uc-card-title { font-size: 15.5px; }
  .plans-brief { gap: 10px; }
  .plan-brief-card { padding: 16px 18px; }
  .faq-q { font-size: 14.5px; }
  .faq-a { font-size: 13px; padding-left: 22px; }
}
@media (max-width: 480px) {
  .h1 { font-size: 32px; }
  .section-h2 { font-size: 26px; }
  .hero-card-h3 { font-size: 16px; }
}

/* ============================================================
   v9 — Scope-first benefit layout (A hero clause / B 実行範囲 /
   D mid-CTA / E FAQ link / F consult line)
   ============================================================ */

/* A — hero sub new clause */
.hero-sub .k-new { color: var(--lemma-black); font-weight: 700; border-bottom: 2px solid var(--lemma-brown); padding-bottom: 1px; }

/* B — 実行範囲 (full-bleed band, Formula 直後) */
.scope-section { padding: 88px 0; background: var(--lemma-cream-deep); border-top: 0.5px solid var(--lemma-line); border-bottom: 0.5px solid var(--lemma-line); margin: 0 0 80px; }
.scope-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--lemma-brown); margin: 0 0 18px; display: flex; align-items: center; gap: 12px; }
.scope-eyebrow::before { content: ""; display: inline-block; width: 28px; height: 1px; background: var(--lemma-brown); }
.scope-grid { display: grid; grid-template-columns: 5fr 6fr; gap: 56px; align-items: start; }
.scope-h { font-family: var(--font-display); font-size: 40px; font-weight: 700; color: var(--lemma-black); letter-spacing: -0.03em; line-height: 1.18; margin: 0 0 18px; }
.scope-lead { font-size: 15px; color: var(--lemma-text-3); line-height: 1.9; margin: 0 0 32px; }
.scope-lead .k { color: var(--lemma-black); font-weight: 500; }
.scope-lead .k-new { color: var(--lemma-black); font-weight: 700; border-bottom: 2px solid var(--lemma-brown); padding-bottom: 1px; }
.scope-cards { display: flex; flex-direction: column; gap: 12px; }
.scope-card { background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 14px; padding: 20px 24px; transition: border-color 0.15s; display: flex; gap: 18px; align-items: flex-start; }
.scope-card:hover { border-color: var(--lemma-brown); }
.sc-icon { color: var(--lemma-brown); flex-shrink: 0; margin-top: 3px; }
.sc-icon svg { width: 32px; height: 32px; display: block; }
.sc-body { flex: 1; }
.sc-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; }
.sc-no { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em; color: var(--lemma-brown); }
.sc-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; color: var(--lemma-black); letter-spacing: -0.015em; margin: 0; }
.sc-desc { font-size: 13px; color: var(--lemma-text-3); line-height: 1.7; margin: 0 0 10px; }
.sc-mono { font-family: var(--font-mono); font-size: 11px; color: var(--lemma-brown); background: var(--lemma-brown-light); padding: 3px 10px; border-radius: 4px; letter-spacing: 0.04em; }
.scope-right { position: sticky; top: 96px; }
.scope-log { background: var(--code-bg); border-radius: 14px; padding: 18px 22px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.6; box-shadow: 0 18px 50px rgba(0,0,0,0.30); }
.log-bar { display: flex; align-items: center; gap: 6px; padding-bottom: 12px; border-bottom: 0.5px solid rgba(255,255,255,0.08); margin-bottom: 8px; }
.log-bar .dot { width: 9px; height: 9px; border-radius: 50%; background: #3A3025; }
.log-title { margin-left: 8px; font-size: 10px; letter-spacing: 0.14em; color: #6A655D; }
.log-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; color: #8FBC8F; }
.log-live .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #8FBC8F; box-shadow: 0 0 6px rgba(143,188,143,0.8); }
/* verification-stream entries: head → proof check → verdict */
.log-entry { padding: 11px 0; border-bottom: 0.5px solid rgba(255,255,255,0.06); }
.log-entry:last-of-type { border-bottom: none; }
.le-head { display: flex; align-items: baseline; gap: 10px; }
.le-mark { font-weight: 700; }
.le-call { color: var(--code-text); }
.le-amt { margin-left: auto; color: #9A938A; }
.le-proof { font-size: 11.5px; color: #7C766C; margin: 5px 0 0; padding-left: 22px; }
.le-proof .le-k { color: #6A655D; letter-spacing: 0.08em; margin-right: 7px; }
.le-note { color: #6A655D; }
.le-result { display: flex; align-items: center; gap: 8px; font-size: 12px; margin: 6px 0 0; padding-left: 22px; }
.le-badge { margin-left: auto; display: inline-block; font-size: 9.5px; letter-spacing: 0.16em; padding: 3px 9px; border-radius: 5px; font-weight: 700; }
.log-entry.ok .le-mark, .log-entry.ok .le-pass, .log-entry.ok .le-result { color: #8FBC8F; }
.le-badge.ok { color: #0A0F0E; background: #8FBC8F; }
.log-entry.ng .le-mark, .log-entry.ng .le-fail, .log-entry.ng .le-result { color: #C97B4A; }
.log-entry.ng .le-call { text-decoration: line-through; text-decoration-color: rgba(201,123,74,0.5); color: #9A938A; }
.le-badge.ng { color: #FCFAF5; background: #C97B4A; }
@media (prefers-reduced-motion: no-preference) {
  /* staged reveal — nth-of-type 1 is .log-bar, entries are 2/3/4 */
  .scope-log.play .log-entry { opacity: 0; animation: logIn 0.5s ease forwards; }
  .scope-log.play .log-entry:nth-of-type(2) { animation-delay: 0.40s; }
  .scope-log.play .log-entry:nth-of-type(3) { animation-delay: 1.00s; }
  .scope-log.play .log-entry:nth-of-type(4) { animation-delay: 1.60s; }
  /* blocked verdict slams in + the result line flashes brown once */
  .scope-log.play .log-entry.ng .le-badge { animation: badgeSlam 0.5s cubic-bezier(0.2,0.8,0.2,1.4) backwards; }
  .scope-log.play .log-entry.ng .le-result { animation: blockFlash 0.7s ease backwards; }
  .scope-log.play .log-entry:nth-of-type(3) .le-badge,
  .scope-log.play .log-entry:nth-of-type(3) .le-result { animation-delay: 1.25s; }
  .scope-log.play .log-entry:nth-of-type(4) .le-badge,
  .scope-log.play .log-entry:nth-of-type(4) .le-result { animation-delay: 1.85s; }
  .log-live .live-dot { animation: livePulse 1.6s ease-in-out infinite; }
}
@keyframes logIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
@keyframes blockFlash { 0% { background: rgba(201,123,74,0.30); border-radius: 6px; } 100% { background: transparent; } }
@keyframes badgeSlam { 0% { opacity: 0; transform: scale(0.55); } 60% { transform: scale(1.1); } 100% { opacity: 1; transform: scale(1); } }
@keyframes livePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
.scope-trustline { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--lemma-text-4); margin: 18px 2px 0; }
.scope-trustline .led { color: var(--lemma-brown); }

/* D — mid CTA (ユースケース末尾) */
.mid-cta { margin-top: 40px; padding: 36px 40px; background: #fff; border: 0.5px solid var(--lemma-line); border-radius: 18px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.mid-cta-line { font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--lemma-black); margin: 0; letter-spacing: -0.015em; }
.mid-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }
.mid-cta-btns a { font-family: var(--font-display); font-size: 14px; font-weight: 500; text-decoration: none; padding: 13px 26px; border-radius: 999px; }
.mid-cta-btns a.primary { background: var(--lemma-black); color: var(--lemma-cream); }
.mid-cta-btns a.secondary { background: transparent; color: var(--lemma-text-1); border: 0.5px solid var(--lemma-text-1); }

/* E — FAQ answer link */
.faq-a a { color: var(--lemma-brown); text-underline-offset: 3px; }

/* F — consult line on dark vision close */
.cta-consult { margin-top: 26px; font-size: 12.5px; color: rgba(252,250,245,0.5); }
.cta-consult a { color: rgba(252,250,245,0.78); text-decoration: underline; text-underline-offset: 3px; }

/* v9 responsive */
@media (max-width: 720px) {
  .scope-section { padding: 56px 0; margin-bottom: 56px; }
  .scope-grid { grid-template-columns: 1fr; gap: 36px; }
  .scope-right { order: -1; position: static; }
  .scope-h { font-size: 28px; line-height: 1.2; }
  .scope-log { font-size: 12px; padding: 16px 16px 18px; }
  .sc-icon svg { width: 28px; height: 28px; }
  .scope-card { gap: 14px; padding: 18px 18px; }
  .le-proof, .le-result { padding-left: 18px; }
  .le-proof { font-size: 11px; }
  .mid-cta { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
}

/* === two-way branch hero (rebrand) === */
.t402-standards { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--lemma-text-3); margin: 0 0 40px; }
.t402-standards::before { content: "\25CF "; color: var(--t402-green); }
.path-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 760px; margin: 0; }
.path-card { position: relative; background: #fff; border: 0.5px solid var(--lemma-line); border-top: 3px solid var(--t402-green); border-radius: 16px; padding: 32px 28px 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; text-decoration: none; color: inherit; transition: transform .2s, box-shadow .2s, border-color .2s; }
.path-card:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(0,0,0,0.07); border-color: var(--t402-green); }
.path-tag { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; color: var(--lemma-brown); }
.path-icon { color: var(--lemma-black); }
.path-icon svg { width: 52px; height: 58px; display: block; }
.path-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--lemma-black); line-height: 1.2; letter-spacing: -0.02em; margin: 0; }
.path-btn { font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--lemma-brown); margin-top: auto; padding-top: 6px; }
.pay-demo { max-width: 1020px; margin: 0 0 64px; }
@media (max-width: 720px) { .path-cards { grid-template-columns: 1fr; } }

/* === hub hero v2 — dark umbrella (matches prototype) === */
.hub-hero-v2 { background: #1F1E1A; color: #ECEBE3; padding: clamp(116px, 13vh, 150px) 8% 84px; }
.hub-hero-v2 .inner { max-width: 1240px; margin: 0 auto; }
.hub-hero-v2 .hero-grid2 { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
.hub-hero-v2 .eyebrow2 { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; background: var(--t402-green); color: #1F1E1A; padding: 3px 10px; border-radius: 4px; margin-bottom: 22px; }
.hub-hero-v2 h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 6vw, 74px); line-height: 1.04; letter-spacing: -0.03em; margin: 0 0 26px; max-width: 14ch; color: #fff; }
.hub-hero-v2 h1 .g { color: var(--t402-green); }
.hub-hero-v2 .hero-sub2 { font-size: clamp(16px, 1.4vw, 19px); color: rgba(236,235,227,0.66); max-width: 56ch; line-height: 1.7; margin: 0 0 36px; }
.hub-hero-v2 .hero-sub2 em { font-style: italic; }
.hub-hero-v2 .cta-row2 { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
.hub-hero-v2 .btn2 { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 13.5px; font-weight: 700; padding: 14px 28px; border-radius: 999px; cursor: pointer; border: 1.5px solid transparent; text-decoration: none; transition: background .2s, color .2s, border-color .2s, transform .2s; }
.hub-hero-v2 .btn2.primary { background: var(--t402-green); color: #1F1E1A; }
.hub-hero-v2 .btn2.primary:hover { background: #8FBF00; transform: translateY(-1px); }
.hub-hero-v2 .btn2.ghost { background: transparent; color: #ECEBE3; border-color: rgba(236,235,227,0.2); }
.hub-hero-v2 .btn2.ghost:hover { border-color: #ECEBE3; }
.hub-hero-v2 .btn-ic { width: 16px; height: 16px; }
.hub-hero-v2 .trust-bar { display: flex; flex-wrap: wrap; gap: 10px 12px; align-items: center; font-family: var(--font-mono); font-size: 12px; color: rgba(236,235,227,0.5); }
.hub-hero-v2 .trust-bar .std { padding: 3px 10px; border: 1px solid rgba(236,235,227,0.14); border-radius: 6px; }
.hub-hero-v2 .trust-bar .bazaar { color: var(--t402-green); }
.hub-hero-v2 .term { background: #131210; color: #ECEBE3; border-radius: 10px; font-family: var(--font-mono); font-size: 13.5px; line-height: 1.9; padding: 18px 22px; overflow-x: auto; border: 1px solid rgba(236,235,227,0.12); }
.hub-hero-v2 .term .p, .hub-hero-v2 .term .ok { color: var(--t402-green); }
.hub-hero-v2 .term .dim { color: rgba(236,235,227,0.45); }
.hub-hero-v2 .doors { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; }
.hub-hero-v2 .door { background: rgba(236,235,227,0.04); border: 1px solid rgba(236,235,227,0.12); border-top: 3px solid var(--t402-green); border-radius: 14px; padding: 32px 30px; transition: background .2s, transform .2s; display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: inherit; }
.hub-hero-v2 .door:hover { background: rgba(236,235,227,0.08); transform: translateY(-3px); }
.hub-hero-v2 .door-tag { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; color: var(--t402-green); }
.hub-hero-v2 .door h3 { font-family: var(--font-display); font-size: 23px; font-weight: 700; color: #fff; margin: 0; line-height: 1.22; }
.hub-hero-v2 .door p { color: rgba(236,235,227,0.6); font-size: 14px; margin: 0; flex: 1; }
.hub-hero-v2 .door .link-arrow2 { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--t402-green); display: inline-flex; align-items: center; gap: 6px; }
.hub-hero-v2 .door-ic { height: 56px; width: auto; color: #ECEBE3; }
.hub-hero-v2 .ic { display: inline-block; vertical-align: middle; }
@media (max-width: 900px) { .hub-hero-v2 .hero-grid2 { grid-template-columns: 1fr; gap: 32px; } }
@media (max-width: 820px) { .hub-hero-v2 .doors { grid-template-columns: 1fr; } }

/* === hub body v2 — prototype sections (sub-brand), scoped .t402b === */
.t402b { --green:#B6F500; --green-link:#4B6B0F; --green-deep:#8FBF00; --ink:#1F1E1A; --ink-soft:#4A4942; --muted:#6F6E66; --surface:#ECEBE3; --surface-2:#F5F4EE; --card:#FFFFFF; --border:#D8D6CC; --border-dk:rgba(236,235,227,0.12); --term-fg:#ECEBE3; --font-serif:'Cormorant Garamond',Georgia,serif; color:var(--ink); }
.t402b section { padding: 92px 8%; }
.t402b .inner { max-width: 1240px; margin: 0 auto; }
.t402b .section-dark { background: var(--ink); color: var(--term-fg); }
.t402b .section-dark h2, .t402b .section-dark h3 { color: var(--term-fg); }
.t402b .section-gray { background: var(--surface); }
.t402b .sec-head { max-width: 720px; margin-bottom: 52px; }
.t402b .sec-head h2 { font-family: var(--font-display); font-size: clamp(28px,4vw,44px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; margin: 0 0 16px; color: var(--ink); }
.t402b .section-dark .sec-head h2 { color: var(--term-fg); }
.t402b .sec-head h2 em { font-style: italic; color: var(--green-link); }
.t402b .section-dark .sec-head h2 em { color: var(--green); }
.t402b .sec-head p { font-size: 16px; color: var(--ink-soft); line-height: 1.75; margin: 0; }
.t402b .section-dark .sec-head p { color: rgba(236,235,227,0.6); }
.t402b .eyebrow-plain { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; color: var(--green-link); margin-bottom: 18px; }
.t402b .eyebrow-plain::before { content: ""; width: 16px; height: 2px; background: currentColor; display: block; }
.t402b .eyebrow-plain.on-dark { color: var(--green); }
.t402b .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 13.5px; font-weight: 700; padding: 14px 28px; border-radius: 999px; cursor: pointer; border: 1.5px solid transparent; text-decoration: none; transition: background .2s,color .2s,border-color .2s,transform .2s; }
.t402b .btn-primary { background: var(--green); color: var(--ink); }
.t402b .btn-primary:hover { background: var(--green-deep); transform: translateY(-1px); }
.t402b .btn-ghost { background: transparent; color: var(--ink); border-color: var(--border); }
.t402b .btn-ghost.on-dark { color: var(--term-fg); border-color: var(--border-dk); }
.t402b .btn-ghost.on-dark:hover { border-color: var(--term-fg); }
.t402b .link-arrow { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--green-link); display: inline-flex; align-items: center; gap: 6px; }
.t402b .link-arrow.on-dark { color: var(--green); }
/* equation */
.t402b .equation { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px; }
.t402b .eq-item { flex: 1; min-width: 150px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
.t402b .eq-item .lab { font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--green-link); margin-bottom: 6px; }
.t402b .eq-item .sub { font-size: 13px; color: var(--muted); }
.t402b .eq-op { display: flex; align-items: center; font-family: var(--font-display); font-size: 26px; font-weight: 300; color: var(--green-link); }
.t402b .eq-result { flex: 1.4; min-width: 180px; background: var(--green); border-radius: 12px; padding: 20px; color: var(--ink); }
.t402b .eq-result .lab { font-family: var(--font-mono); font-size: 12px; font-weight: 700; margin-bottom: 6px; }
/* cards */
.t402b .cards { display: grid; gap: 16px; }
.t402b .cards.c3 { grid-template-columns: repeat(3,1fr); }
.t402b .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 30px 28px; transition: border-color .2s, transform .2s, box-shadow .2s; }
.t402b .card:hover { border-color: var(--green); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,0.06); }
.t402b .card .num { font-family: var(--font-mono); font-size: 12px; color: var(--green-link); font-weight: 700; margin-bottom: 12px; }
.t402b .card h3 { font-family: var(--font-display); font-size: 19px; font-weight: 700; margin: 0 0 10px; color: var(--ink); }
.t402b .card p { font-size: 14px; color: var(--ink-soft); margin: 0; }
.t402b .chip { display: inline-block; font-family: var(--font-mono); font-size: 11.5px; color: var(--green-link); background: var(--surface); padding: 4px 10px; border-radius: 6px; }
.t402b .card .chip { margin-top: 14px; }
.t402b .card .cardic { display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: 13px; background: rgba(182,245,0,0.16); color: var(--ink); margin-bottom: 16px; }
.t402b .card .cardic svg { width: 27px; height: 27px; }
/* accident scenario (risk) */
.t402b .risk-pivot { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--green); border-radius: 12px; padding: 18px 22px; }
.t402b .risk-line { font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }
.t402b .risk-pivot .chip { background: var(--surface-2); }
.t402b .risk-metaphor { font-family: var(--font-display); font-weight: 300; font-size: clamp(21px, 2.8vw, 32px); letter-spacing: -0.02em; line-height: 1.4; color: var(--ink); margin: 40px 0 0; }
.t402b .risk-metaphor .hl { color: var(--green-link); }
.t402b #risk .callout { margin-top: 22px; }
/* steps */
.t402b .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
.t402b .step { background: rgba(236,235,227,0.04); border: 1px solid var(--border-dk); border-radius: 14px; padding: 26px 24px; }
.t402b .step .num { font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--green); margin-bottom: 12px; }
.t402b .step h3 { font-family: var(--font-display); font-size: 16px; font-weight: 700; margin: 0 0 8px; color: var(--term-fg); }
.t402b .step p { font-size: 13.5px; color: rgba(236,235,227,0.6); margin: 0; }
.t402b .callout { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); margin-top: 18px; }
.t402b .callout.on-dark { color: rgba(236,235,227,0.5); }
/* tiers */
.t402b .tiers { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
.t402b .pchips { display: flex; flex-wrap: wrap; gap: 9px; margin: -24px 0 40px; }
.t402b .pchip { font-family: var(--font-mono); font-size: 12px; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 13px; color: var(--ink-soft); }
.t402b .pchip.key { background: var(--green); border-color: var(--green-deep); color: var(--ink); font-weight: 700; }
.t402b .tier { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 30px 26px; display: flex; flex-direction: column; }
.t402b .tier.featured { border-color: var(--green); border-top: 3px solid var(--green); }
.t402b .tier .tname { font-family: var(--font-display); font-size: 20px; font-weight: 700; margin-bottom: 4px; }
.t402b .tier .tpos { font-size: 13px; color: var(--muted); margin-bottom: 18px; min-height: 38px; }
.t402b .tier .tprice { font-family: var(--font-mono); font-size: 22px; font-weight: 700; margin-bottom: 4px; }
.t402b .tier .tprice small { font-size: 12px; color: var(--muted); font-weight: 400; }
.t402b .tier .tmeter { font-family: var(--font-mono); font-size: 12px; color: var(--green-link); margin: 8px 0 14px; min-height: 38px; }
.t402b .tier .tlist { list-style: none; margin: 0 0 16px; padding: 0; font-size: 13px; color: var(--ink-soft); }
.t402b .tier .tlist li { padding: 5px 0 5px 20px; position: relative; border-bottom: 1px dotted var(--border); }
.t402b .tier .tlist li:last-child { border-bottom: none; }
.t402b .tier .tlist li::before { content: "✓"; position: absolute; left: 0; color: var(--green-deep); font-family: var(--font-mono); }
.t402b .tier .tlist li.soon { color: var(--muted); }
.t402b .tier .tlist li.soon::before { content: "◷"; color: var(--muted); }
.t402b .tier .tstate { margin-top: auto; padding-top: 14px; font-family: var(--font-mono); font-size: 11.5px; color: var(--green-link); }
.t402b .tier .tcontact { margin-top: auto; padding-top: 14px; font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--green-link); text-decoration: none; }
.t402b .tier .tpay { font-family: var(--font-mono); font-size: 11px; color: var(--muted); margin-top: 10px; }
/* Institutional — dark (ink) card */
.t402b .tier.inst { background: var(--ink); color: var(--surface); border-color: var(--ink); }
.t402b .tier.inst .tpos { color: #a8a79e; }
.t402b .tier.inst .tprice { color: var(--green); }
.t402b .tier.inst .tprice small { color: #a8a79e; }
.t402b .tier.inst .tmeter { color: #d7f58a; }
.t402b .tier.inst .tlist { color: #d8d7ce; }
.t402b .tier.inst .tlist li { border-bottom-color: #3a3934; }
.t402b .tier.inst .tlist li::before { color: var(--green); }
.t402b .tier.inst .tlist li.soon { color: #8b8a80; }
.t402b .tier.inst .tstate, .t402b .tier.inst .tcontact { color: var(--green); }
.t402b .tier.inst .tpay { color: #8b8a80; }
/* how billing works */
.t402b .bill-h { font-family: var(--font-display); font-weight: 700; font-size: 20px; margin: 48px 0 16px; color: var(--ink); }
.t402b .bill { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
.t402b .bcell { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
.t402b .bcell .bnum { font-family: var(--font-mono); font-size: 13px; font-weight: 700; color: var(--green-link); }
.t402b .bcell .btitle { font-family: var(--font-display); font-weight: 700; font-size: 15.5px; margin: 8px 0 6px; color: var(--ink); }
.t402b .bcell .btext { font-size: 13.5px; color: var(--ink-soft); line-height: 1.7; }
.t402b .pnote { margin-top: 22px; font-size: 12.5px; color: var(--muted); border-left: 3px solid var(--border); padding: 4px 0 4px 14px; max-width: 860px; }
/* closing */
.t402b .closing { text-align: center; background: var(--ink); color: var(--term-fg); padding: 110px 8%; }
.t402b .closing h2 { font-family: var(--font-display); font-size: clamp(30px,4.5vw,52px); font-weight: 800; margin: 0 0 14px; color: var(--term-fg); }
.t402b .closing .closing-sub { font-size: 15.5px; color: rgba(236,235,227,0.62); line-height: 1.8; max-width: 46ch; margin: 16px auto 0; }
.t402b .closing .rule { width: 44px; height: 2px; background: var(--green); margin: 26px auto; }
.t402b .closing .cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
/* reveal */
.t402b .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s, transform .6s; }
.t402b .reveal.on { opacity: 1; transform: none; }
@media (max-width: 1024px) { .t402b .cards.c3 { grid-template-columns: repeat(2,1fr); } .t402b .steps { grid-template-columns: repeat(2,1fr); } .t402b .tiers { grid-template-columns: repeat(2,1fr); } .t402b .bill { grid-template-columns: 1fr; } }
@media (max-width: 900px) { .t402b .equation { flex-direction: column; } .t402b .eq-op { justify-content: center; } }
@media (max-width: 680px) { .t402b .cards.c3 { grid-template-columns: 1fr; } .t402b .tiers { grid-template-columns: 1fr; } }

/* fixed Pay/Sell/Dashboard switcher */
.t402-switch { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 200; display: flex; gap: 4px; background: #1F1E1A; padding: 5px; border-radius: 999px; box-shadow: 0 8px 30px rgba(0,0,0,0.28); }
.t402-switch-btn { font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: lowercase; color: #ECEBE3; padding: 9px 20px; border-radius: 999px; text-decoration: none; transition: background .2s, color .2s; white-space: nowrap; }
.t402-switch-btn:hover { color: #fff; }
.t402-switch-btn.active { background: var(--t402-green); color: #1F1E1A; }
@media (max-width: 560px) { .t402-switch-btn { padding: 8px 15px; } }
  .t402-switch-badge { font-family: var(--font-mono); font-size: 8.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--t402-green); border: 1px solid var(--t402-green); border-radius: 999px; padding: 1px 5px; margin-left: 7px; vertical-align: middle; }
</style>
