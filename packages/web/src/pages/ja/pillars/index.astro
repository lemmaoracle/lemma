---
// /ja/pillars — Lemma の製品ページ（製品ページ実装指示 v1 / モック v18）。
// 新規ページは作らず、この既存ハブを製品ページとして使う。英語の /pillars は
// これまでどおり LemmaApiTemplate のまま（このテンプレートは日本語専用）。
import ProductPageTemplate from "../../../templates/ProductPageTemplate.astro";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
---

<ProductPageTemplate
  locale={locale}
  t={t}
  base={base}
  pagePath="/pillars/"
  ogImage="https://lemma.frame00.com/og/pillars/ja.png"
/>
