---
import PillarsHubTemplate from "../../../templates/PillarsHubTemplate.astro";
import { getAllPillars } from "../../../data/pillars";
import { getTranslations } from "../../../i18n/translations";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const pillars = getAllPillars();
const pillarT = t.pillars;
---

<PillarsHubTemplate
  locale={locale}
  t={t}
  base={base}
  pillars={pillars}
  pillarT={pillarT}
/>
