---
import PillarsHubV2 from "../../../templates/PillarsHubV2.astro";
import { getTranslations } from "../../../i18n/translations";
import bodyJa from "../../../config/pillars-hub-v2/index.ja.html?raw";

const locale = "ja";
const t = getTranslations(locale);
const base = "/ja";
const metaTitle = "AI のための信頼インフラ — 来歴・AI 判断・権限・規制属性に暗号証明 | Lemma";
const metaDescription =
  "AI のための信頼インフラ。来歴・AI 判断・権限・規制属性の 4 軸で、AI が使うデータに暗号証明を返す。既存ワークフローに 1 レイヤー加えるだけで、全工程に証明が乗ります。";
---

<PillarsHubV2
  locale={locale}
  t={t}
  base={base}
  body={bodyJa}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
/>
