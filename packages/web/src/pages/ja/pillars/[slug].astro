---
import PillarDetailV4 from "../../../templates/PillarDetailV4.astro";
import { getPillarV4Body, getPillarV4Meta } from "../../../config/pillarsV4";
import { getAllPillars } from "../../../data/pillars";
import { getTranslations } from "../../../i18n/translations";

export async function getStaticPaths() {
  // Only pillars with a v4 body render a detail page.
  return getAllPillars()
    .filter((pillar) => getPillarV4Body(pillar.slug, "ja"))
    .map((pillar) => ({ params: { slug: pillar.slug }, props: { pillar } }));
}

interface Props {
  pillar: import("../../../data/pillars").Pillar;
}

const { pillar } = Astro.props;
const locale = "ja" as const;
const t = getTranslations(locale);
const base = "/ja";
const body = getPillarV4Body(pillar.slug, locale)!;
const meta = getPillarV4Meta(pillar.slug)!;
---

<PillarDetailV4
  locale={locale}
  t={t}
  base={base}
  pillar={pillar}
  body={body}
  metaTitle={meta.title.ja}
  metaDescription={meta.description.ja}
/>
