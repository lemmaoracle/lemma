---
/**
 * /ja/industries/ — Industries landing (JA new build).
 *
 * Sections:
 *   1. Hero — Industries eyebrow / two-line H1 / sub / Discovery Call + Whitepaper CTAs
 *   2. Three product cards — Lemma Civic / Critical / Compliance with targets list
 *   3. Use Cases preview — 3 industry-anchored cards + "all use cases" link
 *   4. Closing CTA — Discovery Call + Whitepaper
 *
 * Locale-pinned to JA; the EN counterpart `/industries/` is a separate
 * follow-up. Meta is set in-line on Layout so it does not depend on
 * SOLUTIONS.meta (which still holds the Industries strings on `/ja/solutions/`
 * from the Phase 1 PR — left untouched here, separate cleanup).
 */
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import HubSpotDrawer from "../../../components/HubSpotDrawer.astro";
import { getTranslations } from "../../../i18n/translations";
import { DISCOVERY_CALL_URL } from "../../../config/cta";

const locale = "ja" as const;
const t = getTranslations(locale);
const base = "/ja" as const;

const discoveryUrl = DISCOVERY_CALL_URL[locale];
const whitepaperUrl = "https://tally.so/r/xX0VYv";

const metaTitle = "Industries — Civic · Critical · Compliance | Lemma";
const metaDesc =
  "公共インフラ・製造業・規制金融に最適化した Civic / Critical / Compliance の 3 製品ライン。データを持たないままで、業界の現場に信頼インフラを実装。";
---

<Layout
  locale={locale}
  title={metaTitle}
  description={metaDesc}
  metaType="page"
  pagePath="/industries/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="ind-page">
    <div class="ind-container">

      <section class="ind-hero">
        <p class="ind-eyebrow">For Enterprise · Industries</p>
        <h1 class="ind-h1">
          信頼インフラを、<br />
          <span class="accent">業界の現場へ</span>。
        </h1>
        <p class="ind-sub">
          公共インフラ・製造業・規制金融に最適化した
          <span class="k">Civic / Critical / Compliance</span>
          の 3 つの製品ライン。AI と業務の交差点で起きる機密性・説明責任・規制対応の課題を、データを動かさずに解きほぐします。
        </p>
        <div class="ind-hero-ctas">
          <a href={discoveryUrl} class="btn-primary" target="_blank" rel="noopener">導入相談へ →</a>
          <a href={whitepaperUrl} class="btn-secondary" target="_blank" rel="noopener">ホワイトペーパー DL</a>
        </div>
      </section>

      <section class="ind-products" aria-labelledby="ind-products-h">
        <h2 class="ind-products-h" id="ind-products-h">3 つの製品ライン</h2>

        <article class="ind-card">
          <h3 class="ind-card-name">Lemma Civic</h3>
          <p class="ind-card-tagline">公共・公益サービスのための信頼インフラ</p>
          <p class="ind-card-desc">
            属性証明・参加証明・透明性 — 行政手続のデジタル化と、住民データを集約しないままでの行政間連携を実現します。
          </p>
          <ul class="ind-card-targets">
            <li>自治体・公共サービス</li>
            <li>行政手続デジタル化</li>
            <li>選挙・調査の透明性</li>
          </ul>
          <a href={`${base}/pricing/`} class="ind-card-cta">プランを見る →</a>
        </article>

        <article class="ind-card">
          <h3 class="ind-card-name">Lemma Critical</h3>
          <p class="ind-card-tagline">基幹インフラの信頼インフラ</p>
          <p class="ind-card-desc">
            水道・電力・通信などの運用ログを、機密性を保ったまま規制当局・監査人へ証明します。能動的サイバー防御法対応にも。
          </p>
          <ul class="ind-card-targets">
            <li>水道・電力・通信</li>
            <li>製造業・基幹システム</li>
            <li>規制対応・第三者監査</li>
          </ul>
          <a href={`${base}/pricing/`} class="ind-card-cta">プランを見る →</a>
        </article>

        <article class="ind-card">
          <h3 class="ind-card-name">Lemma Compliance</h3>
          <p class="ind-card-tagline">規制対応・データ保護の信頼インフラ</p>
          <p class="ind-card-desc">
            KYC / AML・CBAM・EUDR・AI Act など、規制属性を原本データを開示せずに選択的に証明できる設計。
          </p>
          <ul class="ind-card-targets">
            <li>金融・暗号資産取引所</li>
            <li>サプライチェーン ESG</li>
            <li>AI ガバナンス・規制対応</li>
          </ul>
          <a href={`${base}/pricing/`} class="ind-card-cta">プランを見る →</a>
        </article>
      </section>

      <section class="ind-uc" aria-labelledby="ind-uc-h">
        <p class="ind-uc-eyebrow">業界別ユースケース</p>
        <h2 class="ind-uc-h" id="ind-uc-h">業務の入口から、信頼インフラを。</h2>
        <p class="ind-uc-sub">現場で先に詰まる場所から、Lemma を導入できます。</p>

        <div class="ind-uc-grid">
          <a href={`${base}/solutions/use-cases/ai-audit-log-proof/`} class="ind-uc-card">
            <span class="ind-uc-cat">AI · 監査</span>
            <h3 class="ind-uc-title">AI 監査ログ証明</h3>
            <p class="ind-uc-line">LLM の入出力履歴を、内容を見せずに「規定通り動いた」だけ証明。</p>
          </a>

          <a href={`${base}/solutions/use-cases/kyc-aml-selective-disclosure/`} class="ind-uc-card">
            <span class="ind-uc-cat">本人確認 · 選択的開示</span>
            <h3 class="ind-uc-title">KYC/AML 選択的開示</h3>
            <p class="ind-uc-line">本人確認情報を共有せず、必要な属性だけを証明。</p>
          </a>

          <a href={`${base}/solutions/use-cases/supply-chain-esg/`} class="ind-uc-card">
            <span class="ind-uc-cat">サプライチェーン · ESG</span>
            <h3 class="ind-uc-title">サプライチェーン ESG 証明</h3>
            <p class="ind-uc-line">調達先の情報を集めずに、ESG 基準充足を多階層で証明。</p>
          </a>

          <a href={`${base}/solutions/use-cases/`} class="ind-uc-card all-link">
            <span class="ind-uc-cat">All Use Cases</span>
            <h3 class="ind-uc-title">ユースケース一覧 →</h3>
            <p class="ind-uc-line">すべての業務適用パターンを見る。</p>
          </a>
        </div>
      </section>

      <section class="ind-closing">
        <h2 class="ind-closing-h">
          業務の現場から、<br />
          <span class="accent">信頼インフラを始める</span>。
        </h2>
        <p class="ind-closing-sub">
          要件をお聞かせください。最適な製品ラインと導入プロセスをご提案します。
        </p>
        <div class="ind-closing-ctas">
          <a href={discoveryUrl} class="btn-brown-pill" target="_blank" rel="noopener">導入相談へ →</a>
          <a href={whitepaperUrl} class="ind-closing-link" target="_blank" rel="noopener">ホワイトペーパー →</a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  :root {
    --lemma-black: #000;
    --lemma-text-1: #1a1a1a;
    --lemma-text-2: #3a3a3a;
    --lemma-text-3: #5a5a5a;
    --lemma-brown: #8b4513;
    --lemma-brown-light: #f5ebdc;
    --lemma-cream: #fcfaf5;
    --lemma-cream-deep: #f2eedf;
    --lemma-line: #e5e5e5;
  }

  .ind-page {
    background: var(--lemma-cream);
    color: var(--lemma-text-1);
    font-family: "Noto Sans JP", system-ui, sans-serif;
    line-height: 1.7;
  }

  .ind-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Hero ────────────────────────────────────────────────────── */
  .ind-hero {
    padding: 64px 0 56px;
    max-width: 880px;
  }

  .ind-eyebrow {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--lemma-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ind-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--lemma-brown);
  }

  .ind-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--lemma-black);
    margin: 0 0 24px;
  }
  .ind-h1 .accent {
    color: var(--lemma-brown);
  }

  .ind-sub {
    font-size: 17px;
    line-height: 1.8;
    color: var(--lemma-text-2);
    margin: 0 0 32px;
    max-width: 740px;
  }
  .ind-sub .k {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.92em;
    background: var(--lemma-brown-light);
    color: var(--lemma-brown);
    padding: 1px 6px;
    border-radius: 3px;
  }

  .ind-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    background: var(--lemma-brown);
    color: #fff;
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    padding: 12px 22px;
    border-radius: 999px;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .btn-primary:hover {
    background: #6e360f;
  }

  .btn-secondary {
    display: inline-block;
    color: var(--lemma-brown);
    border: 1px solid var(--lemma-brown);
    background: transparent;
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    padding: 11px 21px;
    border-radius: 999px;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .btn-secondary:hover {
    background: var(--lemma-brown-light);
  }

  /* ── Products grid ───────────────────────────────────────────── */
  .ind-products {
    padding: 56px 0;
    border-top: 1px solid var(--lemma-line);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .ind-products-h {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    margin: 0 0 8px;
    color: var(--lemma-black);
    letter-spacing: -0.02em;
  }

  .ind-card {
    background: var(--lemma-cream-deep);
    padding: 28px 24px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ind-card-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    margin: 0;
    color: var(--lemma-black);
    letter-spacing: -0.02em;
  }
  .ind-card-tagline {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lemma-brown);
    margin: 0;
  }
  .ind-card-desc {
    font-size: 15px;
    line-height: 1.75;
    color: var(--lemma-text-2);
    margin: 0;
    flex: 1;
  }
  .ind-card-targets {
    margin: 0;
    padding-left: 18px;
    color: var(--lemma-text-2);
    font-size: 14px;
    line-height: 1.85;
  }
  .ind-card-targets li {
    margin: 0;
  }

  .ind-card-cta {
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    color: var(--lemma-brown);
    text-decoration: none;
    margin-top: 4px;
    letter-spacing: 0.02em;
  }
  .ind-card-cta:hover {
    text-decoration: underline;
  }

  /* ── Use Cases preview ───────────────────────────────────────── */
  .ind-uc {
    padding: 56px 0;
    border-top: 1px solid var(--lemma-line);
  }
  .ind-uc-eyebrow {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--lemma-text-3);
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ind-uc-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--lemma-brown);
  }
  .ind-uc-h {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--lemma-black);
    margin: 0 0 14px;
  }
  .ind-uc-sub {
    font-size: 15px;
    color: var(--lemma-text-2);
    margin: 0 0 32px;
  }

  .ind-uc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ind-uc-card {
    display: block;
    background: #fff;
    border: 1px solid var(--lemma-line);
    border-radius: 10px;
    padding: 22px 22px 24px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .ind-uc-card:hover {
    border-color: var(--lemma-brown);
  }

  .ind-uc-cat {
    display: inline-block;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lemma-brown);
    background: var(--lemma-brown-light);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .ind-uc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.35;
    color: var(--lemma-black);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .ind-uc-line {
    font-size: 14px;
    color: var(--lemma-text-2);
    margin: 0;
    line-height: 1.7;
  }

  .ind-uc-card.all-link {
    background: var(--lemma-cream-deep);
    border-style: dashed;
  }

  /* ── Closing ─────────────────────────────────────────────────── */
  .ind-closing {
    padding: 64px 0 80px;
    border-top: 1px solid var(--lemma-line);
    text-align: center;
  }

  .ind-closing-h {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--lemma-black);
    margin: 0 0 16px;
  }
  .ind-closing-h .accent {
    color: var(--lemma-brown);
  }

  .ind-closing-sub {
    font-size: 16px;
    color: var(--lemma-text-2);
    margin: 0 0 28px;
  }

  .ind-closing-ctas {
    display: flex;
    gap: 18px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-brown-pill {
    display: inline-block;
    background: var(--lemma-brown);
    color: #fff;
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    padding: 12px 26px;
    border-radius: 999px;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .btn-brown-pill:hover {
    background: #6e360f;
  }

  .ind-closing-link {
    color: var(--lemma-brown);
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .ind-closing-link:hover {
    text-decoration: underline;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 880px) {
    .ind-container {
      padding: 0 24px;
    }
    .ind-h1 {
      font-size: 40px;
    }
    .ind-closing-h {
      font-size: 28px;
    }
    .ind-products {
      grid-template-columns: 1fr;
    }
    .ind-uc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
