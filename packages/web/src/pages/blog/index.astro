---
import BlogIndexTemplate from "../../templates/BlogIndexTemplate.astro";
import { getBlogSections } from "../../data/blog";
import { getTranslations } from "../../i18n/translations";

const locale = "en";
const t = getTranslations(locale);
const base = "";
const blogPath = "/blog";
const sections = await getBlogSections(locale);

const isDoc = (p: { category: string }) =>
  p.category === "Guides" || p.category === "Foundations";

const essays = (sections.find((s) => s.section === "Essays")?.posts ?? []).filter(
  (p) => !isDoc(p),
);
const changelog = (sections.find((s) => s.section === "Changelog")?.posts ?? []).filter(
  (p) => !isDoc(p),
);
// All category-filterable entries (essays + changelog), newest first.
// Feeds the category pills + the filtered card grid.
const entries = [...essays, ...changelog].sort((a, b) => (a.date > b.date ? -1 : 1));

const guides = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "Guides");
const foundations = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "Foundations");

const featured = essays[0];
const recent = essays.slice(1, 7);
const archive = essays.slice(7);
---

<BlogIndexTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  essays={entries}
  featured={featured}
  recent={recent}
  archive={archive}
  changelog={changelog}
  guides={guides}
  foundations={foundations}
/>
