---
import BlogIndexTemplate from "../../templates/BlogIndexTemplate.astro";
import { byDateDesc, getBlogSections, isDocCategory } from "../../data/blog";
import { getTranslations } from "../../i18n/translations";

const locale = "en";
const t = getTranslations(locale);
const base = "";
const blogPath = "/blog";
const sections = await getBlogSections(locale);

const articles = (
  sections.find((s) => s.section === "Essays")?.posts ?? []
).filter((p) => !isDocCategory(p.category));
const changelog = (
  sections.find((s) => s.section === "Changelog")?.posts ?? []
).filter((p) => !isDocCategory(p.category));

// All category-filterable entries (articles + changelog), newest first.
// Feeds the filter pills + the hidden filtered grid.
const entries = [...articles, ...changelog].sort(byDateDesc);

// Featured / Recent draw from *all* entries, not just the Essays section.
// Announcements default to `section: Changelog` (see data/blog.ts), so
// selecting from Essays alone kept the newest post off the top of the index
// whenever it was an announcement — it only showed in the Changelog list.
// Featured is pinned to the case study (`tags: case-study`). Letting it
// compete on recency pushes the case study out every time an article ships,
// but this slot exists to show the product in real use, so its character is
// fixed (same reasoning as the Latest news trio). With several case studies
// the newest wins; with none, it falls back to the newest entry.
const featured = entries.find((p) => p.tags?.includes("case-study")) ?? entries[0];
// Whatever lands in Featured must not repeat in Recent — the old slice(1, 7)
// assumed featured was entries[0], which no longer holds.
const recent = entries.filter((p) => p.slug !== featured?.slug).slice(0, 6);

// A release / Announcements post promoted into Featured or Recent stays in the
// Changelog list as well — the list is the release history and should read as
// complete, so the duplicate is intentional.
---

<BlogIndexTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  entries={entries}
  featured={featured}
  recent={recent}
  changelog={changelog}
/>
