---
import BlogIndexTemplate from "../../templates/BlogIndexTemplate.astro";
import { getBlogSections } from "../../data/blog";
import { getTranslations } from "../../i18n/translations";

const locale = "en";
const t = getTranslations(locale);
const base = "";
const blogPath = "/blog";
const sections = await getBlogSections(locale);

const allEssays = sections.find((s) => s.section === "Essays")?.posts ?? [];
const essays = allEssays.filter(
  (p) => p.category !== "Guides" && p.category !== "Foundations",
);
const guides = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "Guides");
const foundations = sections
  .flatMap((s) => s.posts)
  .filter((p) => p.category === "Foundations");

const featured = essays[0];
const recent = essays.slice(1, 7);
const archive = essays.slice(7);
---

<BlogIndexTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  essays={essays}
  featured={featured}
  recent={recent}
  archive={archive}
  guides={guides}
  foundations={foundations}
/>
