---
import BlogCategoryTemplate from "../../../templates/BlogCategoryTemplate.astro";
import { getAllPosts, BLOG_CATEGORIES, categorySlug } from "../../../data/blog";
import { getTranslations } from "../../../i18n/translations";

export async function getStaticPaths() {
  const posts = await getAllPosts("en");
  const groups = BLOG_CATEGORIES.map((category) => ({
    category,
    items: posts.filter((p) => p.category === category),
  })).filter((g) => g.items.length > 0);
  const available = groups.map((g) => g.category);
  return groups.map((g) => ({
    params: { category: categorySlug(g.category) },
    props: { category: g.category, posts: g.items, categories: available },
  }));
}

interface Props {
  category: string;
  posts: import("../../../data/blog").BlogPost[];
  categories: string[];
}

const { category, posts, categories } = Astro.props as Props;
const locale = "en" as const;
const t = getTranslations(locale);
const base = "";
const blogPath = "/blog";
---

<BlogCategoryTemplate
  locale={locale}
  t={t}
  base={base}
  blogPath={blogPath}
  category={category}
  categories={categories}
  posts={posts}
/>
