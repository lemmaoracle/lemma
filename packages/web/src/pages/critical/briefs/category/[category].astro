---
import { getCollection, type CollectionEntry } from "astro:content";
import BriefArchiveTemplate, {
  type ArchiveCard,
} from "../../../../templates/BriefArchiveTemplate.astro";
import {
  categoryLabel,
  categoryDescription,
  type CategorySlug,
} from "../../../../data/criticalBriefs";
import { getEnBriefMap } from "../../../../data/getEnBriefMap";

/**
 * Category archives are generated only for categories that have at
 * least one Brief surfacing through them (via either primary_category
 * or secondary_categories). Pillar archives carry the "framework is
 * complete" signal for empty layers; categories without Briefs return
 * 404 until content lands.
 */
export async function getStaticPaths() {
  const all = await getCollection("critical-briefs");
  const enById = await getEnBriefMap();
  const used = new Set<CategorySlug>();
  for (const b of all) {
    used.add(b.data.primary_category as CategorySlug);
    for (const sc of b.data.secondary_categories) {
      used.add(sc as CategorySlug);
    }
  }
  return Array.from(used).map((category) => {
    const cards: ArchiveCard[] = all
      .filter(
        (b) =>
          b.data.primary_category === category ||
          (b.data.secondary_categories as ReadonlyArray<string>).includes(
            category,
          ),
      )
      .sort(
        (a, b) => b.data.published.getTime() - a.data.published.getTime(),
      )
      .map((brief) => ({
        // Prefer EN body for card TL;DR when an EN translation exists.
        brief: enById.get(brief.id) ?? brief,
        source:
          brief.data.primary_category === category
            ? ("primary" as const)
            : ("secondary" as const),
      }));
    return {
      params: { category },
      props: { category, cards },
    };
  });
}

interface Props {
  category: CategorySlug;
  cards: ReadonlyArray<ArchiveCard>;
}

const { category, cards } = Astro.props as Props;
const locale = "en";
---

<BriefArchiveTemplate
  locale={locale}
  kind="category"
  slug={category}
  eyebrow="Lemma Critical Brief / Category archive"
  heading={categoryLabel(category, locale)}
  description={categoryDescription(category, locale)}
  cards={cards}
/>
