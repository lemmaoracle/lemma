---
/**
 * 共通フッター v2（製品ページ移行 実装指示 v2.1 §4 — 全ページに効く）。
 *
 * スレート地＋ライムの環境光。上段=ロゴ＋タグライン／右にダッシュボードと
 * ソーシャル（下辺ヘアライン）、中段=4列（製品／開発者向け／リソース／会社・
 * 列見出しは Space Mono 9.5px＋13×2px のライムのバー）、下段=© は mono 大文字。
 *
 * §4.2 の判断:
 *  - 製品列は Lemma API / Trust402 / Seal / CLUBS ↗ / 料金 の5項目。
 *    プラン3本 (Civic/Critical/Compliance) は製品でないため外す（→ /pricing に集約。
 *    孤立の扱いは Phase5 の料金整理で判断 = §4.4）。
 *  - ラベルは「Lemma API」（飛び先 /pillars のタイトルが Lemma API のため。
 *    Phase1 v2 の「Lemma に変える」記録から差し戻し）。
 *  - ホワイトペーパーは配布物が存在しないため削除。Trust402 の二重掲載を解消。
 *  - CLUBS は外部リンクの印つきでフッターのみ（ナビには入れない = §1.6）。
 *
 * 旧 `Footer.astro` はこのコンポーネントへのディスパッチャになった（v2.1 §4.3:
 * ナビが新DSなのでフッターだけ旧のままだと上下で質感が食い違う）。
 */
import type { Locale, Translations } from "../i18n/translations";
import LemmaOracle from "./LemmaOracle.astro";
import { DASHBOARD_URL } from "../config/cta";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  footerT: Translations["footer"];
  base: string;
  /** ダッシュボードボタン/リンクの飛び先の差し替え (Trust402 面が使用)。 */
  dashboardUrl?: string;
}

const { locale, footerT, base, dashboardUrl } = Astro.props;
const dashHref = dashboardUrl ?? DASHBOARD_URL;
const isJa = locale === "ja";
const L = (path: string) => (base ? `${base}${path}` : path);

const currentPath = Astro.url.pathname;
const languageSwitchHref = isJa
  ? currentPath.replace(/^\/ja/, "") || "/"
  : `/ja${currentPath}`;
const languageSwitchLabel = isJa ? "English" : "日本語";

const brandLines = isJa
  ? ["AI時代に、何が本物かを証明する。", "発行は一度。検証は、無料で何度でも。"]
  : ["Prove what's real in the age of AI.", "Issue once. Verify free, any number of times."];

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  dot?: boolean;
}

const columns: ReadonlyArray<{ heading: string; links: FooterLink[] }> = [
  {
    heading: isJa ? "製品" : "Products",
    links: [
      { label: "Lemma API", href: L("/pillars") },
      { label: "Trust402", href: L("/trust402/") },
      { label: "Seal", href: L("/seal/") },
      { label: "CLUBS", href: "https://clubs.place", external: true },
      { label: isJa ? "料金" : "Pricing", href: L("/pricing") },
    ],
  },
  {
    heading: isJa ? "開発者向け" : "Developers",
    links: [
      { label: isJa ? "ダッシュボード" : "Dashboard", href: dashHref, external: true },
      { label: isJa ? "仕様書" : "Specs", href: L("/guides") },
      { label: isJa ? "検証センター" : "Verification center", href: L("/verify/") },
      { label: "GitHub", href: "https://github.com/lemmaoracle", external: true },
      { label: "Smithery", href: "https://smithery.ai/servers/lemmaoracle/lemma", external: true },
    ],
  },
  {
    heading: isJa ? "リソース" : "Resources",
    links: [
      { label: "Critical Brief", href: L("/critical/briefs"), dot: true },
      { label: isJa ? "ブログ" : "Blog", href: L("/blog") },
      { label: isJa ? "業界別ソリューション" : "Solutions by industry", href: L("/solutions/use-cases") },
      { label: isJa ? "用語集" : "Glossary", href: L("/glossary") },
      { label: "FAQ", href: L("/faq") },
    ],
  },
  {
    heading: isJa ? "会社" : "Company",
    links: [
      {
        label: isJa ? "運営会社" : "About us",
        href: isJa ? "https://corp.frame00.com/" : "https://corp.frame00.com/index-en",
        external: true,
      },
      {
        label: isJa ? "お問い合わせ" : "Contact",
        href: isJa ? "https://tally.so/r/EkBqDX" : "https://tally.so/r/Pd2Rl5",
        external: true,
      },
      {
        label: isJa ? "ニュースレター" : "Newsletter",
        href: isJa ? "https://tally.so/r/EkMj82" : "https://tally.so/r/rjvN2X",
        external: true,
      },
      { label: isJa ? "真正性とは" : "What is authenticity", href: L("/authenticity") },
      { label: languageSwitchLabel, href: languageSwitchHref },
    ],
  },
];
---

<footer class="rfooter">
  <div class="rfooter-wrap">
    <div class="rfooter-head">
      <div class="rfooter-brand">
        <a href={base || "/"} class="rfooter-logo" aria-label="Lemma">
          <LemmaOracle class="rfooter-mark" />
        </a>
        <p>
          {brandLines[0]}<br />{brandLines[1]}
        </p>
      </div>
      <div class="rfooter-actions">
        <a class="rfooter-dash" href={dashHref} target="_blank" rel="noopener">
          {isJa ? "ダッシュボード" : "Dashboard"} <span class="rfooter-ext">↗</span>
        </a>
        <div class="rfooter-social">
          <a href="https://x.com/lemmaoracle" target="_blank" rel="noopener" aria-label="X">X</a>
          <a href="https://github.com/lemmaoracle" target="_blank" rel="noopener" aria-label="GitHub">GH</a>
          <a href="https://www.linkedin.com/company/lemmaoracle/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
        </div>
      </div>
    </div>

    <div class="rfooter-cols">
      {columns.map((col) => (
        <div class="rfooter-col">
          <h4>{col.heading}</h4>
          {col.links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener" : undefined}
            >
              {link.dot && <span class="rfooter-dot">●</span>}
              {link.label}
              {link.external && <span class="rfooter-ext">↗</span>}
            </a>
          ))}
        </div>
      ))}
    </div>

    <div class="rfooter-bottom">
      <span class="rfooter-copy">© 2026 FRAME00, INC.</span>
      <span class="rfooter-bottom-links">
        <a href={L("/privacy")}>{footerT.privacy}</a>
        <a href={L("/terms")}>{footerT.terms}</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .rfooter {
    --ok: #a8e010;
    --font-mono: "Space Mono", monospace;

    position: relative;
    overflow: hidden;
    margin-top: 80px;
    padding: 52px 0 28px;
    background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%);
    font-family: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
  }
  /* 環境光。`inset:0` の楕円グラデなので輪郭が出ない。 */
  .rfooter::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      90% 130% at 8% -30%,
      rgba(168, 224, 16, 0.14),
      rgba(168, 224, 16, 0) 60%
    );
  }
  .rfooter-wrap {
    position: relative;
    z-index: 2;
    max-width: calc(1180px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
  }

  /* ── 上段: ブランド＋アクション、下辺ヘアライン ── */
  .rfooter-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    padding-bottom: 30px;
    margin-bottom: 34px;
    border-bottom: 1px solid #4a544b;
  }
  .rfooter-logo {
    display: inline-flex;
    color: #ebefe6;
    text-decoration: none;
  }
  .rfooter-mark {
    height: 26px;
    width: auto;
    display: block;
    color: currentColor;
  }
  .rfooter-brand p {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.9;
    color: #9ba296;
  }
  .rfooter-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .rfooter-dash {
    font-family: "Noto Sans JP", "Space Grotesk", sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    color: #0f1412;
    background: var(--ok);
    border-radius: 6px;
    padding: 10px 20px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: filter 0.18s;
  }
  .rfooter-dash:hover {
    filter: brightness(1.06);
  }
  .rfooter-dash .rfooter-ext {
    color: inherit;
  }
  .rfooter-social {
    display: flex;
    gap: 8px;
  }
  .rfooter-social a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #c3cabb;
    text-decoration: none;
    border: 1px solid #4a544b;
    border-radius: 7px;
    padding: 7px 11px;
    transition: 0.15s;
  }
  .rfooter-social a:hover {
    color: #fff;
    border-color: #8b9285;
  }

  /* ── 中段: 4列 ── */
  .rfooter-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 36px;
  }
  .rfooter-col h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8b9285;
  }
  /* 列見出しのライムのバー（節見出しのラベルと同じ部品 = §4.3） */
  .rfooter-col h4::before {
    content: "";
    flex: none;
    width: 13px;
    height: 2px;
    background: var(--ok);
  }
  .rfooter-col a {
    display: block;
    padding: 6px 0;
    font-size: 13px;
    line-height: 1.6;
    color: #c3cabb;
    text-decoration: none;
    transition: color 0.15s;
  }
  .rfooter-col a:hover {
    color: #ffffff;
  }
  .rfooter-dot {
    color: var(--ok);
    font-size: 8px;
    margin-right: 6px;
    vertical-align: 1px;
  }
  .rfooter-ext {
    font-family: var(--font-mono);
    font-size: 10px;
    margin-left: 5px;
    color: #8b9285;
  }

  /* ── 下段 ── */
  .rfooter-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid #4a544b;
  }
  .rfooter-copy {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b9285;
  }
  .rfooter-bottom-links {
    display: flex;
    gap: 20px;
  }
  .rfooter-bottom-links a {
    font-size: 11.5px;
    color: #b6bdb1;
    text-decoration: none;
    transition: color 0.15s;
  }
  .rfooter-bottom-links a:hover {
    color: #fff;
  }

  @media (max-width: 860px) {
    .rfooter-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 520px) {
    .rfooter {
      padding: 44px 0 26px;
    }
    .rfooter-cols {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
</style>
