---
import type { Locale } from "../i18n/translations";
import { getTranslations } from "../i18n/translations";
import { DISCOVERY_CALL, DISCOVERY_CALL_URL } from "../config/cta";

export interface CtaSectionProps {
  tag?: string;
  h2?: string;
  h2Em?: string;
  p?: string;
  ctaText?: string;
  ctaLink?: string;
  wpText?: string;
  wpLink?: string;
  bgImageSrc?: string;
  locale?: Locale;
  base?: string;
  /**
   * When true, render Whitepaper as the filled primary CTA and the
   * Discovery Call link as the outline secondary. Default false so
   * Pricing / FAQ keep Discovery Call as the filled primary (Discovery
   * Call is the real conversion event there). Home passes true so the
   * site-wide WP-primary funnel (nav + home hero + /services) stays
   * consistent.
   */
  wpPrimary?: boolean;
}

const {
  locale = "en",
  tag,
  h2,
  h2Em,
  p,
  ctaText,
  // `base` is accepted for caller-shape parity (Index/Pricing/FAQ pass
  // it through their own template plumbing) but isn't needed here — the
  // default ctaLink below is an absolute Tally URL, not a base-relative
  // path.
  base: _base = "",
  // Default `ctaLink` points to the Discovery Call Tally form directly
  // so the CTA's label and destination agree. Pricing / FAQ rely on
  // this default; home does too once it drops its old override.
  ctaLink = DISCOVERY_CALL_URL[locale],
  wpText,
  wpLink = locale === "ja" ? "https://tally.so/r/xX0VYv" : "https://tally.so/r/7RJXdR",
  bgImageSrc,
  wpPrimary = false,
} = Astro.props as CtaSectionProps;

const t = getTranslations(locale);

const finalTag = tag ?? t.ctaSection.finalTag;
const finalH2 = h2 ?? t.ctaSection.finalH2;
const finalH2Em = h2Em ?? t.ctaSection.finalH2Em;
const finalP = p ?? t.ctaSection.finalP;
const finalCtaText = ctaText ?? DISCOVERY_CALL[locale].buttonLabel;
const finalWpText = wpText ?? t.ctaSection.finalWpText;
---

<section class="cta-section reveal">
  {
    bgImageSrc ? (
      <>
        <div class="cta-bg" style={`background-image: url(${bgImageSrc})`} />
        <div class="cta-overlay" />
      </>
    ) : null
  }
  <div class="cta-inner">
    <div class="cta-eyebrow">{finalTag}</div>
    <h2>
      <span set:html={finalH2}></span>
      <br />
      <em>{finalH2Em}</em>
    </h2>
    <div class="cta-rule"></div>
    <p set:html={finalP}></p>
    <div class="cta-btns">
      {/* `wpLink` is a Tally URL of shape https://tally.so/r/<id>; extract the
         id and trigger the popup via data-tally-open instead of navigating. */}
      {wpPrimary ? (
        <>
          <button type="button" class="btn-cta" data-tally-open={wpLink.replace(/^.*\/r\//, "")} data-tally-emoji-text="">{finalWpText}</button>
          <a href={ctaLink} class="btn-cta-outline" target={ctaLink.startsWith("http") ? "_blank" : undefined} rel={ctaLink.startsWith("http") ? "noopener" : undefined}>{finalCtaText}</a>
        </>
      ) : (
        <>
          <a href={ctaLink} class="btn-cta" target={ctaLink.startsWith("http") ? "_blank" : undefined} rel={ctaLink.startsWith("http") ? "noopener" : undefined}>{finalCtaText}</a>
          <button type="button" class="btn-cta-outline" data-tally-open={wpLink.replace(/^.*\/r\//, "")} data-tally-emoji-text="">{finalWpText}</button>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    background: #000;
    padding: 160px 10%;
    text-align: center;
    overflow: hidden;
  }
  .cta-bg {
    position: absolute;
    inset: 0;
    background: center/cover no-repeat;
    filter: saturate(0.35) brightness(0.55);
  }
  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.76);
  }
  .cta-inner {
    position: relative;
    z-index: 2;
  }
  .cta-eyebrow {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #8b4513;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .cta-section h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 66px);
    font-weight: 300;
    line-height: 1.08;
    color: #fff;
    margin-bottom: 8px;
  }
  /* Issue #150: Japanese needs more leading than Latin display type. */
  :root[lang="ja"] .cta-section h2 {
    line-height: 1.3;
  }
  .cta-section h2 em {
    font-style: italic;
  }
  .cta-rule {
    width: 40px;
    height: 1px;
    background: #8b4513;
    margin: 32px auto;
  }
  .cta-section p {
    font-size: 14px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.4);
    max-width: 380px;
    margin: 0 auto 48px;
  }
  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn-cta {
    background: #fff;
    color: #000;
    padding: 16px 44px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    display: inline-block;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .btn-cta:hover {
    background: #8b4513;
    color: #fff;
  }
  .btn-cta-outline {
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    padding: 15px 44px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.28);
    cursor: pointer;
    display: inline-block;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .btn-cta-outline:hover {
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }
  .reveal.on {
    opacity: 1;
    transform: translateY(0);
  }
  @media (max-width: 768px) {
    .cta-section {
      padding: 100px 6%;
    }
    .cta-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cta-btns {
      flex-direction: column;
      align-items: center;
    }
    /* Issue #151: keep uppercase CTAs readable on mobile.
       Bump from 12px to 13.5px and stretch buttons to full width so the
       tap target stays comfortably above the 44px minimum. */
    .btn-cta,
    .btn-cta-outline {
      font-size: 13.5px;
      letter-spacing: 0.14em;
      padding: 16px 32px;
      width: 100%;
      max-width: 320px;
      text-align: center;
    }
  }
</style>
