---
/**
 * Pricing hero — mono Products & Pricing eyebrow + 64px 2-line H1
 * (line 2 in accent brown) + 18px sub + mono trust line.
 */
import type { Locale } from "../../i18n/translations";
import { PRICING } from "../../data/pricing";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const h = PRICING.hero;
const anchors = locale === "ja"
  ? [{ l: "エンタープライズ", href: "#ent" }, { l: "Lemma API", href: "#api" }, { l: "Trust402", href: "#t402" }]
  : [{ l: "Enterprise", href: "#ent" }, { l: "Lemma API", href: "#api" }, { l: "Trust402", href: "#t402" }];

function emphasize(s: string): string {
  const terms = ["Lemma"];
  let out = s;
  for (const t of terms) {
    out = out.split(t).join(`<span class="k">${t}</span>`);
  }
  return out;
}
---

<section class="ph-hero">
  <div class="ph-eyebrow">{h.eyebrow[locale]}</div>
  <h1 class="ph-h1">
    {h.h1Lines[locale][0]}<br />
    <span class="accent">{h.h1Lines[locale][1]}</span>
  </h1>
  <p class="ph-sub" set:html={emphasize(h.sub[locale])} />
  <nav class="ph-anchors" aria-label={locale === "ja" ? "価格セクション" : "Pricing sections"}>
    {anchors.map((a, i) => (
      <Fragment>
        {i > 0 && <span class="ph-anchor-sep">·</span>}
        <a href={a.href}>{a.l}</a>
      </Fragment>
    ))}
  </nav>
</section>

<style>
  .ph-hero {
    padding: 64px 0 24px;
  }
  .ph-eyebrow {
    font-family: var(--pr-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--pr-text-3);
    margin: 0 0 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ph-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .ph-h1 {
    font-family: var(--pr-display);
    font-size: 64px;
    font-weight: 700;
    line-height: 0.98;
    margin: 0 0 28px;
    color: var(--black);
    letter-spacing: -0.04em;
  }
  :root[lang="ja"] .ph-h1 {
    line-height: 1.15;
  }
  .ph-h1 .accent {
    color: var(--accent);
  }
  .ph-sub {
    font-size: 18px;
    line-height: 1.7;
    color: var(--pr-text-2);
    margin: 0 0 36px;
    max-width: 700px;
  }
  .ph-sub :global(.k) {
    color: var(--black);
    font-weight: 500;
  }
  .ph-anchors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-family: var(--pr-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
  }
  .ph-anchors a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .ph-anchors a:hover { border-bottom-color: var(--accent); }
  .ph-anchor-sep { color: var(--pr-text-4); }
  @media (max-width: 720px) {
    .ph-h1 { font-size: 44px; }
    .ph-sub { font-size: 16px; }
  }
</style>
