---
/**
 * Pricing hero — mono Products & Pricing eyebrow + 64px 2-line H1
 * (line 2 in accent brown) + 18px sub + mono trust line.
 */
import type { Locale } from "../../i18n/translations";
import { PRICING } from "../../data/pricing";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const h = PRICING.hero;

function emphasize(s: string): string {
  const terms = ["Lemma"];
  let out = s;
  for (const t of terms) {
    out = out.split(t).join(`<span class="k">${t}</span>`);
  }
  return out;
}
---

<section class="ph-hero">
  <div class="ph-eyebrow">{h.eyebrow[locale]}</div>
  <h1 class="ph-h1">
    {h.h1Lines[locale][0]}<br />
    <span class="accent">{h.h1Lines[locale][1]}</span>
  </h1>
  <p class="ph-sub" set:html={emphasize(h.sub[locale])} />
</section>

<style>
  .ph-hero {
    padding: 64px 0 56px;
  }
  .ph-eyebrow {
    font-family: var(--pr-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--pr-text-3);
    margin: 0 0 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ph-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .ph-h1 {
    font-family: var(--pr-display);
    font-size: 64px;
    font-weight: 700;
    line-height: 0.98;
    margin: 0 0 28px;
    color: var(--black);
    letter-spacing: -0.04em;
  }
  :root[lang="ja"] .ph-h1 {
    line-height: 1.15;
  }
  .ph-h1 .accent {
    color: var(--accent);
  }
  .ph-sub {
    font-size: 18px;
    line-height: 1.7;
    color: var(--pr-text-2);
    margin: 0 0 36px;
    max-width: 700px;
  }
  .ph-sub :global(.k) {
    color: var(--black);
    font-weight: 500;
  }
  .ph-trust {
    margin: 38px 0 0;
    padding-top: 22px;
    border-top: 0.5px solid var(--lemma-line);
    font-family: var(--pr-mono);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    color: var(--pr-text-3);
  }
  .ph-trust .strong {
    color: var(--black);
    font-weight: 500;
  }
  .ph-trust .dot {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .ph-h1 { font-size: 44px; }
    .ph-sub { font-size: 16px; }
  }
</style>
