---
/**
 * §4 — Compare matrix (4 plan × 12 standard features). Option Packs
 * are intentionally NOT here — they live as their own axis in §3.
 */
import type { Locale } from "../../i18n/translations";
import { PRICING } from "../../data/pricing";

interface Props { locale: Locale; base?: string }
const { locale } = Astro.props as Props;
const c = PRICING.compare;
const isJa = locale === "ja";

type Cell = (typeof c.rows)[number]["civic"];

function cellText(cell: Cell, lc: Locale): string {
  if (cell.kind === "yes") return "◆";
  if (cell.kind === "no") return "—";
  return cell.label[lc];
}

// Enterprise-only comparison — Trust402 has its own block (#t402), so its
// column is dropped here. Collapsed by default: it's supporting detail, not a
// headline section.
const planCols = c.planColLabels.filter((l) => l !== "Trust402");
---

<details class="pr-fold pc-fold">
  <summary class="pr-fold-summary">{isJa ? "機能を比較する（Civic / Critical / Compliance）" : "Compare features (Civic / Critical / Compliance)"}</summary>
  <div class="pr-fold-body">
    <div class="pc-wrap">
      <table class="pc-table">
        <thead>
          <tr>
            <th class="pc-feature-col">{c.featureColLabel[locale]}</th>
            {planCols.map((label) => (
              <th class="pc-plan-col">{label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {c.rows.map((row) => (
            <tr>
              <td class="pc-feature">{row.feature[locale]}</td>
              {([row.civic, row.critical, row.compliance] as const).map((cell) => (
                <td class={`pc-plan${cell.kind === "no" ? " pc-none" : ""}${cell.kind === "tier" ? " pc-tier" : ""}`}>
                  {cellText(cell, locale)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {/* 凡例 — 「カスタム開発」の定義は商談での工数説明が変わるため省略しない
        （事実修正 2026-08-02） */}
    <p class="pc-legend">
      {isJa
        ? "凡例: ◆ = 標準対応 ／ カスタム開発 = 共通回路（data-commitment）＋開示選択レイヤの実装 ／ SCHEDULED = 提供予定（時期未確定）"
        : "Legend: ◆ = standard. Custom build = the shared data-commitment circuit plus a disclosure-selection layer. SCHEDULED = planned, timing not yet fixed."}
    </p>
  </div>
</details>

<style>
  .pc-wrap {
    overflow-x: auto;
    border-radius: 16px;
  }
  .pc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    overflow: hidden;
  }
  .pc-table th,
  .pc-table td {
    padding: 16px 18px;
    text-align: left;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .pc-table th {
    font-family: var(--pr-display);
    font-weight: 600;
    color: var(--black);
    font-size: 13px;
    background: var(--lemma-cream-deep);
    letter-spacing: -0.005em;
  }
  .pc-feature-col {
    color: var(--pr-text-3) !important;
    font-weight: 500 !important;
  }
  .pc-plan-col {
    text-align: center;
    color: var(--accent) !important;
  }
  .pc-feature {
    color: var(--pr-text-1);
  }
  .pc-plan {
    text-align: center;
    color: var(--accent);
    font-family: var(--pr-mono);
    font-size: 14px;
    font-weight: 500;
  }
  .pc-none {
    color: var(--pr-text-4);
    font-size: 13px;
  }
  .pc-legend {
    margin: 12px 2px 0;
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--pr-text-3, #7a7568);
  }
  .pc-tier {
    font-family: var(--pr-display);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--pr-text-2);
  }
  .pc-table tr:last-child td {
    border-bottom: 0;
  }
  .pc-trust402-link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .pc-trust402-link:hover {
    border-bottom-color: var(--accent);
  }
  .pc-note {
    margin: 16px 2px 0;
    font-size: 12.5px;
    color: var(--pr-text-3);
    line-height: 1.6;
  }
  .pc-note a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }
  .pc-table tr:hover td {
    background: var(--lemma-cream);
  }
  @media (max-width: 720px) {
    .pc-table th,
    .pc-table td {
      padding: 12px;
      font-size: 12.5px;
    }
  }
</style>
