---
/**
 * Pricing Vision close — dark band, centered, 2 CTAs.
 * Visually identical to SolutionsVisionClose; kept as a separate
 * component so the copy data binding stays component-local.
 */
import type { Locale } from "../../i18n/translations";
import { PRICING } from "../../data/pricing";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const v = PRICING.visionClose;
---

<section class="pv-section">
  <div class="pv-inner">
    <div class="pv-eyebrow">{v.eyebrow[locale]}</div>
    <h2 class="pv-h2">
      {v.h2Head[locale]}<br />
      <span class="accent">{v.h2Accent[locale]}</span>
    </h2>
    <p class="pv-sub">{v.sub[locale]}</p>
    <div class="pv-cta">
      <a href={v.ctaPrimary.href[locale]} class="pv-cta-primary" target="_blank" rel="noopener">
        {v.ctaPrimary.label[locale]}
      </a>
      <a href={v.ctaSecondary.href[locale]} class="pv-cta-secondary" target="_blank" rel="noopener">
        {v.ctaSecondary.label[locale]}
      </a>
    </div>
  </div>
</section>

<style>
  .pv-section {
    background: #0f0f0f;
    color: var(--lemma-cream);
    padding: 88px 0 80px;
    margin-top: 64px;
    text-align: center;
  }
  .pv-inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .pv-eyebrow {
    font-family: var(--pr-mono);
    font-size: 10.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(252, 250, 245, 0.5);
    margin: 0 0 22px;
  }
  .pv-h2 {
    font-family: var(--pr-display);
    font-size: 48px;
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 28px;
    letter-spacing: -0.03em;
    color: var(--lemma-cream);
  }
  :root[lang="ja"] .pv-h2 { line-height: 1.3; }
  .pv-h2 .accent { color: var(--accent); }
  .pv-sub {
    font-size: 15px;
    color: rgba(252, 250, 245, 0.7);
    margin: 0 auto 36px;
    max-width: 560px;
    line-height: 1.7;
  }
  .pv-cta {
    display: flex;
    gap: 22px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .pv-cta-primary {
    background: var(--accent);
    color: var(--lemma-cream);
    padding: 14px 32px;
    border-radius: 999px;
    font-family: var(--pr-display);
    font-size: 14px;
    font-weight: 500;
  }
  .pv-cta-secondary {
    color: rgba(252, 250, 245, 0.7);
    font-family: var(--pr-display);
    font-size: 14px;
    padding: 12px 16px;
    transition: color 0.15s;
  }
  .pv-cta-secondary:hover {
    color: var(--lemma-cream);
  }
  @media (max-width: 720px) {
    .pv-section { padding: 64px 0 60px; }
    .pv-h2 { font-size: 36px; }
    .pv-inner { padding: 0 24px; }
  }
</style>
