---
/**
 * §3 — Option Packs. 3 cards (variant a/b/c) with goal-axis H3 + meta,
 * followed by a single availability note.
 */
import type { Locale } from "../../i18n/translations";
import { PRICING } from "../../data/pricing";
import PricingIcon from "./PricingIcon.astro";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const p = PRICING.packs;
const isJa = locale === "ja";

function emphasizeNote(s: string): string {
  // Surface a handful of brand-aligned terms in black + 500 inside the
  // otherwise grey note body.
  const terms = [
    "Critical / Compliance",
    "Civic は対象外",
    "Tier 1 も対象外",
    "Civic",
    "Tier 1",
  ];
  let out = s;
  for (const t of terms) {
    if (!out.includes(`<span class="k">${t}</span>`)) {
      out = out.split(t).join(`<span class="k">${t}</span>`);
    }
  }
  return out;
}
---

<details class="pr-fold pk-fold">
  <summary class="pr-fold-summary">{isJa ? "拡張パック（Critical / Compliance Tier2+）" : "Option Packs (Critical / Compliance Tier 2+)"}</summary>
  <div class="pr-fold-body">
    <p class="pk-note" set:html={emphasizeNote(p.note[locale])} />
    <ul class="pk-rows">
      {p.items.map((pack) => (
        <li class="pk-row">
          <span class="pk-row-letter" aria-hidden="true">
            <PricingIcon name={pack.icon} size={16} />
          </span>
          <div class="pk-row-text">
            <span class="pk-row-name">{pack.letter} · {pack.name[locale]}</span>
            <span class="pk-row-goal">{pack.goalLines[locale].join(" · ")}</span>
          </div>
          <span class="pk-row-tier">{pack.tier[locale]}</span>
        </li>
      ))}
    </ul>
  </div>
</details>

<style>
  /* Compact collapsed-pack list (the big 3-card layout below is retired). */
  .pk-note {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--pr-text-3);
  }
  .pk-note :global(.k) { color: var(--black); font-weight: 500; }
  .pk-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .pk-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 4px;
    border-top: 0.5px solid var(--lemma-line);
  }
  .pk-row:first-child { border-top: none; }
  .pk-row-letter {
    flex: none;
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: var(--lemma-brown-light, #f3ece4);
    color: var(--accent);
  }
  .pk-row-text { flex: 1; display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .pk-row-name { font-family: var(--pr-display); font-weight: 600; font-size: 14px; color: var(--black); }
  .pk-row-goal { font-size: 12.5px; color: var(--pr-text-3); line-height: 1.5; }
  .pk-row-tier {
    flex: none;
    font-family: var(--pr-mono);
    font-size: 11px;
    color: var(--pr-text-4);
    text-align: right;
    max-width: 40%;
  }
  @media (max-width: 640px) { .pk-row-tier { display: none; } }

  .pk-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 18px;
    margin: 0 0 24px;
  }

  .pk-card {
    border-radius: 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
    border: 0.5px solid var(--lemma-line);
  }
  .pk-card:hover {
    box-shadow: 0 14px 36px rgba(139, 69, 19, 0.08);
    transform: translateY(-2px);
  }

  /* 3 colour variants (white / cream-deep / brown-light) with matching
     bar + icon-circle tone. */
  .pk-card--a { background: var(--white); }
  .pk-card--a .pk-top         { background: var(--accent); }
  .pk-card--a .pk-icon-circle { background: var(--accent); color: var(--lemma-cream); }

  .pk-card--b { background: var(--lemma-cream-deep); border-color: #D4C5A8; }
  .pk-card--b .pk-top         { background: #6B4220; }
  .pk-card--b .pk-icon-circle { background: #6B4220; color: var(--lemma-cream); }

  .pk-card--c { background: var(--lemma-brown-light); border-color: #D4B89E; }
  .pk-card--c .pk-top         { background: #B26B3E; }
  .pk-card--c .pk-icon-circle { background: #B26B3E; color: var(--lemma-cream); }

  .pk-top { height: 4px; width: 100%; }
  .pk-body {
    padding: 26px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }
  .pk-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .pk-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pk-letter-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pk-letter {
    font-family: var(--pr-mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pr-text-3);
    font-weight: 500;
  }
  .pk-name {
    font-family: var(--pr-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--pr-text-3);
    letter-spacing: -0.005em;
    margin: 0;
  }
  .pk-goal {
    font-family: var(--pr-display);
    font-size: 21px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 4px 0 0;
  }
  :root[lang="ja"] .pk-goal { line-height: 1.4; }
  .pk-desc {
    font-size: 13.5px;
    color: var(--pr-text-2);
    line-height: 1.75;
    margin: 0;
    padding: 14px 0;
    border-top: 0.5px solid rgba(0, 0, 0, 0.08);
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.08);
  }
  .pk-desc :global(.k) {
    color: var(--black);
    font-weight: 500;
  }
  .pk-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
  }
  .pk-meta-row {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 12.5px;
  }
  .pk-meta-label {
    font-family: var(--pr-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pr-text-3);
    font-weight: 500;
    min-width: 80px;
  }
  .pk-meta-value {
    color: var(--pr-text-1);
    flex: 1;
    line-height: 1.55;
    font-weight: 500;
  }

  .pk-note {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 12px;
    padding: 18px 24px;
    font-size: 13px;
    color: var(--pr-text-2);
    line-height: 1.7;
    margin: 24px 0 0;
  }
  .pk-note :global(.k) {
    color: var(--black);
    font-weight: 500;
  }

  @media (max-width: 880px) {
    .pk-grid { grid-template-columns: 1fr; }
  }
</style>
