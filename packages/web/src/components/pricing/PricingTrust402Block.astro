---
/**
 * /pricing #t402 — Trust402 block (agent line).
 *
 * The 4-plan table is the shared <Trust402Tiers> component (single source
 * T402_PRICING), so /pricing and the Trust402 product pages never drift. This
 * wrapper adds the pricing-page section chrome + a note + links to the two
 * product pages (Pay / Sell). Copy is inline-bilingual (mirrors the other
 * pricing components).
 */
import type { Locale } from "../../i18n/translations";
import Trust402Tiers from "../trust402/Trust402Tiers.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";
const payHref = `${base}/trust402/`;
const sellHref = `${base}/trust402/sell/`;

const t = isJa
  ? {
      eyebrow: "Trust402 — エージェント向け",
      h2: "x402 に信頼を添える、自己サーブの4プラン。",
      sub: "AI エージェントの支払い（Pay）と、成果の出品（Sell）。同じ発行枠で両方まかなえます。",
      note: "Pay と Sell は 1 つの発行枠を共有 — どのプランでも両方使えます。検証は常に無料、販売手数料は 0%。",
      linkPay: "Trust402 · Pay を見る →",
      linkSell: "Trust402 · Sell を見る →",
    }
  : {
      eyebrow: "Trust402 — for agents",
      h2: "Trust on top of x402 — four self-serve plans.",
      sub: "Pay (agent payments) and Sell (list your work). One issuance allowance covers both.",
      note: "Pay and Sell share one issuance allowance — every plan covers both. Verification is always free; 0% commission on sales.",
      linkPay: "See Trust402 · Pay →",
      linkSell: "See Trust402 · Sell →",
    };
---

<section class="t402b" id="t402" aria-label={t.eyebrow}>
  <div class="pr-section-eyebrow">{t.eyebrow}</div>
  <h2 class="pr-section-h2">{t.h2}</h2>
  <p class="pr-section-sub">{t.sub}</p>

  <Trust402Tiers locale={locale} />

  <p class="t402b-note">{t.note}</p>
  <div class="t402b-links">
    <a href={payHref}>{t.linkPay}</a>
    <a href={sellHref}>{t.linkSell}</a>
  </div>
</section>

<style>
  .t402b { scroll-margin-top: 120px; }
  .t402b-note {
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.75;
    color: var(--pr-text-3, #5a5a5a);
    border-left: 3px solid var(--lemma-line, #e6e1d6);
    padding: 4px 0 4px 14px;
    max-width: 820px;
  }
  .t402b-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
  }
  .t402b-links a {
    font-family: var(--pr-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .t402b-links a:hover { text-decoration: underline; }
</style>
