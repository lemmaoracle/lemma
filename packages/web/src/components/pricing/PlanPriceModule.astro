---
/**
 * Plans & pricing module (v13 — confirmed).
 *
 * Placed at the top of the pricing page and in each plan page's
 * "選び方・価格" section. Uses global brand tokens (--accent #8B4513,
 * --lemma-*) so it renders correctly inside both the pricing-page and
 * plan-page CSS contexts.
 *
 * Invariant rules (do not change without product sign-off):
 *   - Civic is the only plan with a public price. Critical / Compliance are
 *     individual-quote only — NEVER show a lower bound for them.
 *   - Fixed terms: 専用の証明 (all plans) / 標準テンプレート (Civic) ·
 *     カスタム開発 (Critical/Compliance) / 月額利用料 / 初期構築.
 *   - No Web3 words (mainnet, gas, etc.). No ownership words like "Lemma の基盤"
 *     (avoids an on-prem misread).
 *   - Do not imply per-use-case multiplication (×N).
 *   - "標準テンプレート" is a Civic-plan-wide attribute (a tag), never a
 *     parenthetical on the 初期構築 line.
 *   - Pricing basis: quote E230 / Civic Tier 1 ¥50,000 monthly, standard ZK
 *     circuit ¥800,000.
 */
import type { Locale } from "../../i18n/translations";
import { SEGMENT_URLS } from "../../config/navigation";
import { DISCOVERY_CALL_URL } from "../../config/cta";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const isJa = locale === "ja";

const civicHref = SEGMENT_URLS.civic[locale];
const inquiryHref = DISCOVERY_CALL_URL[locale];

const t = isJa
  ? {
      eyebrow: "プランと価格",
      h2: "月額利用料 ＋ ユースケースの初期構築。",
      lead: "価格を決めるのは、規模（拠点数・施設数・機関規模）と、やりたいこと（ユースケース）の内容です。",
      civic: { seg: "公共・自治体（B2B2G）", tag: "標準テンプレート構成", monthly: "月額利用料", unit: "/月〜", setup: "初期構築", setupUnit: "〜", cta: "詳しく →" },
      critical: { seg: "基幹インフラ・製造", quote: "個別見積", desc: "カスタム開発・オンプレミス・業務継続性を前提に構成します。", cta: "相談する →" },
      compliance: { seg: "金融・FinTech", quote: "個別見積", desc: "カスタム開発・規制対応・監査証跡を前提に構成します。", cta: "相談する →" },
      cta: "問い合わせる",
      standards: "対応標準：MCP / A2A / x402 / C2PA / W3C VC",
      proof: "ETHGlobal ファイナリスト ・ OpenClaw Security Challenge ファイナリスト ・ Trusted Web 準拠",
    }
  : {
      eyebrow: "Plans & pricing",
      h2: "A monthly platform fee + per-use-case setup.",
      lead: "Pricing is set by scale (sites, facilities, organization size) and what you want to do (your use cases).",
      civic: { seg: "Public · Government (B2B2G)", tag: "Standard templates", monthly: "Monthly fee", unit: "/mo+", setup: "Initial setup", setupUnit: "+", cta: "Learn more →" },
      critical: { seg: "Critical infrastructure · Manufacturing", quote: "Custom quote", desc: "Configured for custom development, on-premises, and business continuity.", cta: "Talk to us →" },
      compliance: { seg: "Finance · FinTech", quote: "Custom quote", desc: "Configured for custom development, regulatory compliance, and audit trails.", cta: "Talk to us →" },
      cta: "Contact us",
      standards: "Standards: MCP / A2A / x402 / C2PA / W3C VC",
      proof: "ETHGlobal finalist · OpenClaw Security Challenge finalist · Trusted Web compliant",
    };
---

<section class="ppm" aria-label={t.eyebrow}>
  <div class="ppm-eyebrow">{t.eyebrow}</div>
  <h2 class="ppm-h2">{t.h2}</h2>
  <p class="ppm-lead">{t.lead}</p>

  <div class="ppm-grid">
    <a class="ppm-card ppm-card--featured" href={civicHref}>
      <div class="ppm-name">Lemma Civic</div>
      <div class="ppm-seg">{t.civic.seg}</div>
      <span class="ppm-tag">{t.civic.tag}</span>
      <div class="ppm-prices">
        <div class="ppm-price-row">
          <span class="ppm-price-label">{t.civic.monthly}</span>
          <span class="ppm-price">¥50,000<span class="ppm-unit">{t.civic.unit}</span></span>
        </div>
        <div class="ppm-price-row">
          <span class="ppm-price-label">{t.civic.setup}</span>
          <span class="ppm-price">¥800,000<span class="ppm-unit">{t.civic.setupUnit}</span></span>
        </div>
      </div>
      <span class="ppm-link">{t.civic.cta}</span>
    </a>

    <a class="ppm-card" href={inquiryHref} target="_blank" rel="noopener">
      <div class="ppm-name">Lemma Critical</div>
      <div class="ppm-seg">{t.critical.seg}</div>
      <div class="ppm-quote">{t.critical.quote}</div>
      <p class="ppm-desc">{t.critical.desc}</p>
      <span class="ppm-link">{t.critical.cta}</span>
    </a>

    <a class="ppm-card" href={inquiryHref} target="_blank" rel="noopener">
      <div class="ppm-name">Lemma Compliance</div>
      <div class="ppm-seg">{t.compliance.seg}</div>
      <div class="ppm-quote">{t.compliance.quote}</div>
      <p class="ppm-desc">{t.compliance.desc}</p>
      <span class="ppm-link">{t.compliance.cta}</span>
    </a>
  </div>

  <div class="ppm-notes">
    {isJa ? (
      <Fragment>
        <p><strong>月額利用料</strong>は、規模に応じた段階価格体系です。それに加えて、やりたいことに合わせた<strong>専用の証明を用意する初期構築費用</strong>がかかります。</p>
        <p>Civic は標準テンプレートで構成します。Critical / Compliance はカスタム開発・規制対応・業務継続性などで要件が増えるため、個別にお見積もりします。詳しい内訳は、お見積もり時にご説明します。</p>
      </Fragment>
    ) : (
      <Fragment>
        <p>The <strong>monthly fee</strong> follows a tiered structure based on scale. On top of that, an <strong>initial setup fee builds the dedicated proofs</strong> for what you want to do.</p>
        <p>Civic is configured from standard templates. Critical / Compliance add custom development, regulatory compliance, and business continuity, so we quote them individually. We walk through the breakdown at quote time.</p>
      </Fragment>
    )}
  </div>

  <div class="ppm-proof">
    <p>{t.proof}</p>
    <p>{t.standards}</p>
  </div>

  <div class="ppm-cta-row">
    <a class="ppm-button" href={inquiryHref} target="_blank" rel="noopener">{t.cta}</a>
  </div>
</section>

<style>
  .ppm {
    --ppm-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --ppm-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    background: var(--white, #fff);
    border: 0.5px solid var(--lemma-line, #e6e1d6);
    border-radius: 20px;
    padding: 40px;
    max-width: 1100px;
    margin: 0 auto;
    font-family: var(--ppm-body);
    color: var(--lemma-text-2, #3a3a3a);
  }
  :root[lang="en"] .ppm { --ppm-body: "Sora", "Noto Sans JP", system-ui, sans-serif; }

  .ppm-eyebrow {
    font-family: var(--ppm-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 0 0 10px;
  }
  .ppm-h2 {
    font-family: var(--ppm-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black, #1a1a1a);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 14px;
  }
  .ppm-lead {
    font-size: 15px;
    line-height: 1.75;
    color: var(--lemma-text-3, #5a5a5a);
    margin: 0 0 28px;
    max-width: 760px;
  }

  .ppm-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .ppm-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--white, #fff);
    border: 0.5px solid var(--lemma-line, #e6e1d6);
    border-radius: 16px;
    padding: 28px 26px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .ppm-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 8px 24px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .ppm-card--featured {
    border: 1.5px solid var(--accent);
  }
  .ppm-name {
    font-family: var(--ppm-display);
    font-size: 21px;
    font-weight: 700;
    color: var(--black, #1a1a1a);
  }
  .ppm-seg {
    font-size: 13px;
    color: var(--lemma-text-3, #5a5a5a);
    margin-bottom: 6px;
  }
  .ppm-tag {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    background: var(--lemma-brown-light, #f3ece4);
    border-radius: 999px;
    padding: 4px 12px;
    margin-bottom: 6px;
  }
  .ppm-prices { display: flex; flex-direction: column; gap: 12px; margin: 6px 0 4px; }
  .ppm-price-row { display: flex; flex-direction: column; gap: 2px; }
  .ppm-price-label { font-size: 12px; color: var(--lemma-text-4, #9a9a9a); }
  .ppm-price {
    font-family: var(--ppm-display);
    font-size: 26px;
    font-weight: 700;
    color: var(--black, #1a1a1a);
    letter-spacing: -0.01em;
  }
  .ppm-unit { font-size: 14px; font-weight: 500; color: var(--lemma-text-3, #5a5a5a); margin-left: 2px; }
  .ppm-quote {
    font-family: var(--ppm-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--black, #1a1a1a);
    margin: 4px 0 2px;
  }
  .ppm-desc {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--lemma-text-2, #3a3a3a);
    margin: 0;
  }
  .ppm-link {
    margin-top: auto;
    padding-top: 16px;
    font-family: var(--ppm-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .ppm-notes {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 0.5px solid var(--lemma-line, #e6e1d6);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ppm-notes p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--lemma-text-2, #3a3a3a);
  }
  .ppm-notes strong { color: var(--black, #1a1a1a); font-weight: 600; }

  .ppm-proof {
    margin-top: 24px;
    text-align: center;
  }
  .ppm-proof p {
    margin: 4px 0;
    font-size: 13px;
    color: var(--lemma-text-4, #9a9a9a);
    line-height: 1.6;
  }

  .ppm-cta-row { margin-top: 24px; text-align: center; }
  .ppm-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--lemma-cream, #fcfaf5);
    font-family: var(--ppm-display);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 40px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ppm-button:hover { background: #6e3610; }

  @media (max-width: 860px) {
    .ppm { padding: 28px 22px; }
    .ppm-grid { grid-template-columns: 1fr; }
    .ppm-h2 { font-size: 24px; }
  }
</style>
