---
/**
 * /pricing #api (EN) ・ /ja/pricing/api/ — Lemma developer block.
 *
 * 単価非公開 (2026-08-03 判断): 発行課金の受け取り手段 (本番課金) が未設計の
 * 段階で単価を公開すると「できると言っている」状態になるため、クラス別単価
 * テーブル・Developer (PAYG ¥0) カード・quota/grade 定額プラン露出をすべて
 * 取り下げ。公開するのは「検証は無料」「Sandbox は無料で使える」という事実と
 * 仕様書・Discovery への導線のみ。単価の single source (config/proofClasses.ts)
 * は保持 — 課金基盤が整った時点でテーブルを戻す。
 * (Trust402 は x402 経由で受領可能なため公開を維持 — PricingTrust402Block)
 */
import type { Locale } from "../../i18n/translations";
import { DASHBOARD_URL } from "../../config/cta";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";
const specsHref = `${base}/guides`;

const t = isJa
  ? {
      eyebrow: "Lemma — 開発者向け",
      h2: "ZK 証明の発行 API。検証は無料。",
      sub: "来歴・認証・権限・推論・属性の証明を、生の API で発行。検証は常に無料 — 支払うのは発行のときだけ、という料金設計です。",
      privateH: "発行の単価と課金は、現在非公開です",
      privateP: "課金（支払いの受け取り）の提供準備が整っていないため、単価は公開していません。準備が整い次第、このページで公開します。",
      freeH: "いま、無料でできること",
      freeItems: [
        "testnet の Sandbox で、発行と検証をそのまま試す",
        "証明の検証 — 本番でも常に無料・アカウント不要",
        "仕様書で API の全体像を確認する",
      ],
      ctaSandbox: "Sandbox で試す（testnet・無料）",
      ctaSpecs: "仕様書を読む →",
      note: "概念・発行手順の詳細は各証明ページに集約しています。先行して本番導入をご検討の場合は、エンタープライズの Discovery からご相談ください。",
    }
  : {
      eyebrow: "Lemma — for developers",
      h2: "The ZK proof issuance API. Verification free.",
      sub: "Issue proofs of provenance, authentication, authority, inference, and attributes from the raw API. Verification is always free — the pricing model charges only at issuance.",
      privateH: "Issuance rates and billing are not public yet",
      privateP: "Payment collection for issuance is still being built, so we do not publish rates. They will be published here once billing is ready.",
      freeH: "Free today",
      freeItems: [
        "Try issuance and verification on the testnet Sandbox",
        "Verify proofs — always free in production, no account needed",
        "Read the specs for the full API surface",
      ],
      ctaSandbox: "Try the Sandbox (testnet · free)",
      ctaSpecs: "Read the specs →",
      note: "Concepts and issuance steps are consolidated on each proof page. For early production rollouts, start from the enterprise Discovery call.",
    };
---

<section class="api" id="api" aria-label={t.eyebrow}>
  <div class="pr-section-eyebrow">{t.eyebrow}</div>
  <h2 class="pr-section-h2">{t.h2}</h2>
  <p class="pr-section-sub">{t.sub}</p>

  <div class="api-private">
    <p class="api-private-h">{t.privateH}</p>
    <p class="api-private-p">{t.privateP}</p>
  </div>

  <div class="api-free-box">
    <p class="api-free-h">{t.freeH}</p>
    <ul class="api-free-list">
      {t.freeItems.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  <div class="api-cta-row">
    <a class="api-btn" href={DASHBOARD_URL} target="_blank" rel="noopener">{t.ctaSandbox}</a>
    <a class="api-btn api-btn--ghost" href={specsHref}>{t.ctaSpecs}</a>
  </div>

  <p class="api-note">{t.note}</p>
</section>

<style>
  .api { --api-mono: var(--pr-mono, "Space Mono", monospace); scroll-margin-top: 120px; }

  .api-private {
    background: var(--white, #fff);
    border: 0.5px solid var(--lemma-line, #e6e1d6);
    border-left: 3px solid var(--accent);
    border-radius: 14px;
    padding: 20px 24px;
    max-width: 640px;
  }
  .api-private-h { font-family: var(--pr-display); font-weight: 700; font-size: 16px; color: var(--black, #1a1a1a); margin: 0 0 6px; }
  .api-private-p { font-size: 13.5px; line-height: 1.8; color: var(--pr-text-2, #3a3a3a); margin: 0; }

  .api-free-box {
    margin-top: 20px; padding: 18px 22px; max-width: 640px;
    background: var(--lemma-cream, #fcfaf5);
    border: 0.5px dashed var(--lemma-line, #d8d2c4);
    border-radius: 14px;
  }
  .api-free-h { font-family: var(--pr-display); font-weight: 700; font-size: 14.5px; color: var(--black, #1a1a1a); margin: 0; }
  .api-free-list { margin: 10px 0 0; padding-left: 18px; }
  .api-free-list li { font-size: 13.5px; line-height: 1.9; color: var(--pr-text-2, #3a3a3a); }

  .api-cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .api-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent); color: var(--lemma-cream, #fcfaf5);
    font-family: var(--pr-display); font-size: 14.5px; font-weight: 600;
    padding: 12px 26px; border-radius: 12px; text-decoration: none; transition: background 0.2s;
  }
  .api-btn:hover { background: #6e3610; }
  .api-btn--ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .api-btn--ghost:hover { background: var(--lemma-brown-light, #f3ece4); }

  .api-note { margin-top: 18px; font-size: 13px; line-height: 1.75; color: var(--pr-text-3, #5a5a5a); max-width: 760px; }
</style>
