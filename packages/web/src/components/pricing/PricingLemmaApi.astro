---
/**
 * /pricing #api — Lemma API block (developer line).
 *
 * The raw ZK-proof issuance API: metered per proof issued, verification always
 * free. Shows the per-proof-class rate table (the canonical rates live here on
 * /pricing) and the coming-soon quota/grade subscriptions. Production billing
 * is backend-pending, so it carries a "近日公開" label + Sandbox entry only —
 * no live production-billing CTA (phase-1 rule).
 *
 * Per-class concept/issuance detail is NOT re-explained here; each class links
 * to its canonical pillar page. Copy is inline-bilingual (mirrors
 * PlanPriceModule) so no pricing.ts interface change is needed.
 */
import type { Locale } from "../../i18n/translations";
import { DASHBOARD_URL } from "../../config/cta";
import { PROOF_CLASSES, proofClassHref, proofClassName } from "../../config/proofClasses";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";
const specsHref = `${base}/guides`;

// Per-proof-class rates + canonical links come from the shared single source
// (config/proofClasses.ts) so /pricing, /lemma-api and the pillar pages stay
// consistent. Rates are working values — confirm with CTO.
const classes = PROOF_CLASSES.map((c) => ({
  name: proofClassName(c, locale),
  blurb: c.blurb[locale],
  rate: c.rate,
  href: proofClassHref(c, base),
}));

const t = isJa
  ? {
      eyebrow: "Lemma — 開発者向け",
      h2: "ZK 証明の発行 API。従量課金、検証は無料。",
      sub: "来歴・認証・権限・推論・属性の証明を、生の API で発行。検証は常に無料 — 支払うのは発行のときだけ。",
      devName: "Developer",
      devTag: "PAYG",
      devPrice: "¥0",
      devUnit: "/月",
      devDesc: "月額なし。証明の発行ごとに x402 で都度決済。検証は常に無料。",
      tableH: "証明クラス別 発行単価",
      freeNote: "検証は常に無料",
      refPrice: "参考価格です。",
      colClass: "証明クラス",
      colRate: "発行単価 (USD)",
      colLink: "詳細（証明ページ）",
      soonH: "定額プラン（準備中）",
      quota: "quota（発行枠）: Builder $49 / Studio 〜$499・tier 割引",
      grade: "grade（managed）: G1 ¥30–50k / G2 ¥100–300k",
      ctaSandbox: "Sandbox で試す（testnet・無料）",
      ctaSpecs: "仕様書を読む →",
      note: "本番課金は近日公開 — 単価は正式公開時に確定します。まずは testnet の Sandbox で無料でお試しいただけます。単価・概念・発行手順の詳細は各証明ページに集約しています。導入のご相談はエンタープライズの Discovery からどうぞ。",
    }
  : {
      eyebrow: "Lemma — for developers",
      h2: "The ZK proof issuance API. Usage-based, verification free.",
      sub: "Issue proofs of provenance, authentication, authority, inference, and attributes from the raw API. Verification is always free — you pay only to issue.",
      devName: "Developer",
      devTag: "PAYG",
      devPrice: "$0",
      devUnit: "/mo",
      devDesc: "No monthly fee. Each proof settles per issuance via x402. Verification is always free.",
      tableH: "Per-proof-class issuance rates",
      freeNote: "Verification is always free",
      refPrice: "Reference pricing.",
      colClass: "Proof class",
      colRate: "Rate (USD)",
      colLink: "Detail (proof)",
      soonH: "Flat-rate plans (in preparation)",
      quota: "quota: Builder $49 / Studio up to $499 · tiered discounts",
      grade: "grade (managed): G1 ¥30–50k / G2 ¥100–300k",
      ctaSandbox: "Try the Sandbox (testnet · free)",
      ctaSpecs: "Read the specs →",
      note: "Production billing is coming soon — final rates are set at public launch. Start free on the testnet Sandbox. Rates, concepts, and issuance steps are consolidated on each proof page. For guided rollouts, start from the enterprise Discovery call.",
    };
---

<section class="api" id="api" aria-label={t.eyebrow}>
  <div class="pr-section-eyebrow">{t.eyebrow}</div>
  <h2 class="pr-section-h2">{t.h2}</h2>
  <p class="pr-section-sub">{t.sub}</p>

  <div class="api-dev">
    <div class="api-dev-head">
      <span class="api-dev-name">{t.devName}</span>
      <span class="api-dev-tag">{t.devTag}</span>
    </div>
    <div class="api-dev-price">{t.devPrice}<span class="api-dev-unit">{t.devUnit}</span></div>
    <p class="api-dev-desc">{t.devDesc}</p>
  </div>

  <div class="api-table-h">{t.tableH}<span class="api-free">{t.freeNote}</span></div>
  <p class="api-ref">{t.refPrice}</p>
  <div class="api-table-wrap">
    <table class="api-table">
      <thead>
        <tr>
          <th>{t.colClass}</th>
          <th>{t.colRate}</th>
          <th>{t.colLink}</th>
        </tr>
      </thead>
      <tbody>
        {classes.map((c) => (
          <tr>
            <td class="api-cls">
              <span class="api-cls-name">{c.name}</span>
              <span class="api-cls-blurb">{c.blurb}</span>
            </td>
            <td class="api-rate">{c.rate}</td>
            <td><a class="api-cls-link" href={c.href}>→</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="api-soon">
    <div class="api-soon-head">
      <span>{t.soonH}</span>
    </div>
    <ul class="api-soon-list">
      <li>{t.quota}</li>
      <li>{t.grade}</li>
    </ul>
  </div>

  <div class="api-cta-row">
    <a class="api-btn" href={DASHBOARD_URL} target="_blank" rel="noopener">{t.ctaSandbox}</a>
    <a class="api-btn api-btn--ghost" href={specsHref}>{t.ctaSpecs}</a>
  </div>

  <p class="api-note">{t.note}</p>
</section>

<style>
  .api { --api-mono: var(--pr-mono, "Space Mono", monospace); scroll-margin-top: 120px; }
  .api-dev {
    background: var(--white, #fff);
    border: 0.5px solid var(--lemma-line, #e6e1d6);
    border-radius: 16px;
    padding: 24px 26px;
    max-width: 460px;
  }
  .api-dev-head { display: flex; align-items: center; gap: 10px; }
  .api-dev-name { font-family: var(--pr-display); font-size: 19px; font-weight: 700; color: var(--black, #1a1a1a); }
  .api-dev-tag {
    font-family: var(--api-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
    color: var(--accent); background: var(--lemma-brown-light, #f3ece4);
    border-radius: 999px; padding: 3px 10px;
  }
  .api-dev-price { font-family: var(--api-mono); font-size: 30px; font-weight: 700; color: var(--black, #1a1a1a); margin: 8px 0 4px; }
  .api-dev-unit { font-size: 14px; font-weight: 400; color: var(--pr-text-3, #5a5a5a); margin-left: 2px; }
  .api-dev-desc { font-size: 13.5px; line-height: 1.7; color: var(--pr-text-2, #3a3a3a); margin: 0; }

  .api-table-h { font-family: var(--pr-display); font-weight: 700; font-size: 16px; color: var(--black, #1a1a1a); margin: 32px 0 6px; display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; }
  .api-free { font-family: var(--api-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; color: var(--accent); text-transform: none; }
  .api-ref { font-size: 11.5px; line-height: 1.5; color: var(--pr-text-3, #7a7568); margin: 0 0 12px; }
  .api-table-wrap { overflow-x: auto; }
  .api-table { width: 100%; border-collapse: collapse; background: var(--white, #fff); border: 0.5px solid var(--lemma-line, #e6e1d6); border-radius: 14px; overflow: hidden; }
  .api-table th {
    text-align: left; font-family: var(--api-mono); font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--pr-text-3, #5a5a5a);
    padding: 12px 18px; border-bottom: 0.5px solid var(--lemma-line, #e6e1d6); background: var(--lemma-cream, #fcfaf5);
  }
  .api-table td { padding: 12px 18px; border-bottom: 0.5px solid var(--lemma-line, #e6e1d6); font-size: 14px; }
  .api-table tr:last-child td { border-bottom: none; }
  .api-cls { display: flex; flex-direction: column; gap: 2px; }
  .api-cls-name { font-family: var(--pr-display); font-weight: 700; color: var(--black, #1a1a1a); }
  .api-cls-blurb { font-size: 12.5px; color: var(--pr-text-3, #5a5a5a); }
  .api-rate { font-family: var(--api-mono); font-weight: 700; color: var(--accent); }
  .api-cls-link { color: var(--accent); font-family: var(--api-mono); font-weight: 700; }

  .api-soon {
    margin-top: 24px; padding: 18px 22px;
    background: var(--lemma-cream, #fcfaf5);
    border: 0.5px dashed var(--lemma-line, #d8d2c4);
    border-radius: 14px;
  }
  .api-soon-head { display: flex; align-items: center; gap: 10px; font-family: var(--pr-display); font-weight: 700; font-size: 15px; color: var(--black, #1a1a1a); }
  .api-soon-list { margin: 12px 0 0; padding-left: 18px; }
  .api-soon-list li { font-size: 13.5px; line-height: 1.9; color: var(--pr-text-2, #3a3a3a); }

  .api-cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .api-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent); color: var(--lemma-cream, #fcfaf5);
    font-family: var(--pr-display); font-size: 14.5px; font-weight: 600;
    padding: 12px 26px; border-radius: 12px; text-decoration: none; transition: background 0.2s;
  }
  .api-btn:hover { background: #6e3610; }
  .api-btn--ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .api-btn--ghost:hover { background: var(--lemma-brown-light, #f3ece4); }

  .api-note { margin-top: 18px; font-size: 13px; line-height: 1.75; color: var(--pr-text-3, #5a5a5a); max-width: 760px; }

  @media (max-width: 720px) {
    .api-dev { max-width: none; }
  }
</style>
