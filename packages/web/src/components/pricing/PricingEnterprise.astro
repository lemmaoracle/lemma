---
/**
 * §1 — Enterprise plans (Civic / Critical / Compliance) as a 3-card row.
 */
import type { Locale } from "../../i18n/translations";
import { PRICING } from "../../data/pricing";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const e = PRICING.enterprise;
---

<section class="pe-section">
  <div class="pr-section-eyebrow">{e.eyebrow[locale]}</div>
  <h2 class="pr-section-h2">
    {e.h2Head[locale]}<br />
    <span class="accent">{e.h2Accent[locale]}</span>
  </h2>
  <p class="pr-section-sub">{e.sub[locale]}</p>

  <div class="pe-grid">
    {e.plans.map((plan) => (
      <article class="pe-card">
        <div class="pe-segment">{plan.segment[locale]}</div>
        <h3 class="pe-name">{plan.name}</h3>
        <p class="pe-tagline">{plan.tagline[locale]}</p>
        <div class="pe-bestfor">
          <span class="pe-bestfor-label">{e.bestForLabel[locale]}</span>
          {plan.bestFor[locale]}
        </div>
        <ul class="pe-features">
          {plan.features[locale].map((f) => <li>{f}</li>)}
        </ul>
        <div class="pe-tiers">
          {plan.tiers.map((t) => (
            <div class="pe-tier">
              <span class="pe-tier-no">{t.no}</span>
              <span class="pe-tier-scope">{t.scope[locale]}</span>
            </div>
          ))}
        </div>
        <p class="pe-pricing">{plan.pricingModel[locale]}</p>
        <div class="pe-cta">
          <a class="pe-cta-primary" href={plan.ctaPrimary.href[locale]} target="_blank" rel="noopener">
            {plan.ctaPrimary.label[locale]}
          </a>
          <a class="pe-cta-secondary" href={plan.ctaSecondary.href[locale]} target="_blank" rel="noopener">
            {plan.ctaSecondary.label[locale]}
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .pe-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
  }
  .pe-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 18px;
    padding: 36px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .pe-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 56px;
    background: var(--accent);
    transition: width 0.35s;
  }
  .pe-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 14px 36px rgba(139, 69, 19, 0.08);
    transform: translateY(-3px);
  }
  .pe-card:hover::before {
    width: 100%;
  }
  .pe-segment {
    font-family: var(--pr-mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pe-segment::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .pe-name {
    font-family: var(--pr-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
  }
  .pe-tagline {
    font-family: var(--pr-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--pr-text-3);
    margin: 0;
  }
  .pe-bestfor {
    font-size: 13.5px;
    color: var(--pr-text-2);
    line-height: 1.75;
    margin: 0;
    padding: 16px 0;
    border-top: 0.5px solid var(--lemma-line);
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .pe-bestfor-label {
    font-family: var(--pr-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    display: block;
    margin-bottom: 6px;
  }
  .pe-features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pe-features li {
    position: relative;
    padding-left: 22px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--pr-text-1);
  }
  .pe-features li::before {
    content: "◆";
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--accent);
    font-size: 10px;
  }
  .pe-tiers {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 16px 0 0;
    border-top: 0.5px solid var(--lemma-line);
    margin-top: auto;
  }
  .pe-tier {
    font-family: var(--pr-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--lemma-brown-light);
    padding: 6px 10px;
    border-radius: 6px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex: 1;
    min-width: 0;
    text-align: center;
    line-height: 1.3;
  }
  .pe-tier-no { font-weight: 500; }
  .pe-tier-scope {
    font-family: var(--pr-display);
    font-size: 11px;
    color: var(--pr-text-3);
    font-weight: 500;
    letter-spacing: 0;
  }
  .pe-pricing {
    font-size: 12px;
    color: var(--pr-text-3);
    line-height: 1.6;
    margin: 0;
    padding: 14px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .pe-cta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }
  .pe-cta-primary {
    background: var(--accent);
    color: var(--lemma-cream);
    padding: 12px 22px;
    border-radius: 999px;
    font-family: var(--pr-display);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    transition: transform 0.2s;
  }
  .pe-cta-primary:hover {
    transform: translateY(-1px);
  }
  .pe-cta-secondary {
    font-family: var(--pr-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--pr-text-3);
    text-align: center;
    transition: color 0.15s;
    padding: 4px;
  }
  .pe-cta-secondary:hover {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .pe-grid { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
