---
/**
 * Global footer dispatcher — 共通フッター v2 (製品ページ移行 v2.1 §4) へ委譲。
 *
 * 旧 v28 フッター (クリーム/スレート・プラン3本を製品列に掲載) は §4 で退役。
 * 全テンプレートがこのパスを import しているため、呼び出し側は無改修で
 * FooterRenewal (共通フッター v2) に切り替わる。
 */
import type { Locale, Translations } from "../i18n/translations";
import FooterRenewal from "./FooterRenewal.astro";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  footerT: Translations["footer"];
  base: string;
  /** Trust402 面などがダッシュボードの飛び先を差し替えるための旧契約 (S1)。 */
  dashboardUrl?: string;
  /** 対向ロケールの同じ面が無い場合に言語切替を隠す。 */
  otherLocaleAvailable?: boolean;
}

const { locale, t, footerT, base, dashboardUrl, otherLocaleAvailable } = Astro.props;
---

<FooterRenewal
  locale={locale}
  t={t}
  footerT={footerT}
  base={base}
  dashboardUrl={dashboardUrl}
  otherLocaleAvailable={otherLocaleAvailable}
/>
