---
/**
 * Global Footer — v28 redesign.
 *
 * Dark slim footer with 5-column grid:
 *   1. Brand: logo + tagline + Dashboard CTA button + social icons
 *   2. "Lemma について" — trust layers + use cases
 *   3. "製品" — Seal / Lemma Civic / Critical / Compliance / Trust402 / pricing
 *   4. "開発者向け" — Trust402 / Dashboard / specs / GitHub / Smithery
 *   5. "リソース" — Critical Brief (●) / blog / whitepaper / glossary / FAQ
 *      + "会社" — about / contact / language switch
 *
 * Bottom row: copyright + privacy + terms.
 *
 * Column headings ("Lemma について" etc.) are inlined per locale rather than
 * pulling from t.nav.* because the footer column intent ("about Lemma") is
 * distinct from the nav label intent ("trust infrastructure" page).
 */
import type { Locale, Translations } from "../i18n/translations";
import LemmaOracle from "./LemmaOracle.astro";
import NewsletterEmbed from "./NewsletterEmbed.astro";

const TALLY_WHITEPAPER_ID: Record<Locale, string> = {
  ja: "xX0VYv",
  en: "7RJXdR",
};
import { DISCOVERY_CALL_URL } from "../config/cta";
import { SEGMENT_URLS } from "../config/navigation";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  footerT: Translations["footer"];
  base: string;
}

const { locale, t, footerT, base } = Astro.props;
const isJa = locale === "ja";

const blogPath = base ? `${base}/blog` : "/blog";
const faqPath = base ? `${base}/faq` : "/faq";
const pricingPath = base ? `${base}/pricing` : "/pricing";
const servicesPath = base ? `${base}/solutions` : "/solutions";
const pillarsPath = base ? `${base}/pillars` : "/pillars";
const useCasesPath = base ? `${base}/solutions/use-cases` : "/solutions/use-cases";
const glossaryPath = base ? `${base}/glossary` : "/glossary";
const privacyPath = base ? `${base}/privacy` : "/privacy";
const termsPath = base ? `${base}/terms` : "/terms";
const briefsPath = base ? `${base}/critical/briefs` : "/critical/briefs";
const guidesPath = base ? `${base}/guides` : "/guides";
const sealHref = base ? `${base}/seal/` : "/seal/";
const homePath = base || "/";
const contactPath = DISCOVERY_CALL_URL[locale];
const trust402Href = base ? `${base}/trust402/` : "/trust402/";
const dashboardUrl = "https://dashboard.lemma.workers.dev";
const whitepaperHref = "https://tally.so/r/xX0VYv";
const aboutUsHref =
  isJa ? "https://corp.frame00.com/" : "https://corp.frame00.com/index-en";
const githubHref = "https://github.com/lemmaoracle";
const smitheryHref = "https://smithery.ai/servers/lemmaoracle/lemma";
const currentPath = Astro.url.pathname;
const languageSwitchHref =
  isJa ? currentPath.replace(/^\/ja/, "") || "/" : `/ja${currentPath}`;
const languageSwitchLabel = isJa ? t.languageEn : t.languageJa;

const C = isJa ? {
  aboutLemma: "Lemma について",
  trustLayers: "4 つの軸",
  useCases: "ユースケース",
  products: "製品",
  developers: "開発者向け",
  resources: "リソース",
  company: "会社",
  dashboardCta: "ダッシュボード",
  criticalBrief: "Critical Brief",
} : {
  aboutLemma: "About Lemma",
  trustLayers: "Four axes",
  useCases: "Use cases",
  products: "Products",
  developers: "For developers",
  resources: "Resources",
  company: "Company",
  dashboardCta: "Dashboard",
  criticalBrief: "Critical Brief",
};
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">

      <!-- BRAND COLUMN -->
      <div class="site-footer-brand">
        <a class="site-footer-logo" href={homePath} aria-label="Lemma">
          <LemmaOracle class="h-[42px] w-auto" />
        </a>
        <p class="site-footer-tagline">{footerT.tagline}</p>
        <a href={dashboardUrl} class="site-footer-dashboard-btn" target="_blank" rel="noopener">
          {C.dashboardCta} <span class="site-footer-dashboard-arr">↗</span>
        </a>
        <div class="site-footer-social">
          <a href="https://x.com/lemmaoracle" target="_blank" rel="noopener" aria-label="X">X</a>
          <a href={githubHref} target="_blank" rel="noopener" aria-label="GitHub">GH</a>
          <a href="https://www.linkedin.com/company/lemmaoracle/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
        </div>
      </div>

      <!-- COL: Lemma について -->
      <div class="site-footer-col">
        <h4>{C.aboutLemma}</h4>
        <ul>
          <li><a href={pillarsPath}>{C.trustLayers}</a></li>
          <li><a href={useCasesPath}>{C.useCases}</a></li>
        </ul>
      </div>

      <!-- COL: 製品 -->
      <div class="site-footer-col">
        <h4>{C.products}</h4>
        <ul>
          <li><a href={sealHref}>Seal</a></li>
          <li><a href={SEGMENT_URLS.civic[locale]}>{t.mega.products.civic}</a></li>
          <li><a href={SEGMENT_URLS.critical[locale]}>{t.mega.products.critical}</a></li>
          <li><a href={SEGMENT_URLS.compliance[locale]}>{t.mega.products.compliance}</a></li>
          <li><a href={trust402Href} target="_blank">{t.mega.products.trust402}</a></li>
          <li><a href={pricingPath}>{t.mega.products.pricing}</a></li>
        </ul>
      </div>

      <!-- COL: 開発者向け -->
      <div class="site-footer-col">
        <h4>{C.developers}</h4>
        <ul>
          <li><a href={trust402Href} target="_blank">{t.mega.products.trust402}</a></li>
          <li><a href={dashboardUrl} target="_blank" rel="noopener">{C.dashboardCta}</a></li>
          <li><a href={guidesPath}>{footerT.specs}</a></li>
          <li><a href={githubHref} target="_blank" rel="noopener">GitHub <span class="site-footer-ext">↗</span></a></li>
          <li><a href={smitheryHref} target="_blank" rel="noopener">Smithery <span class="site-footer-ext">↗</span></a></li>
        </ul>
      </div>

      <!-- COL: リソース + 会社 -->
      <div class="site-footer-col">
        <h4>{C.resources}</h4>
        <ul>
          <li><a href={briefsPath}><span class="site-footer-dot">●</span> {C.criticalBrief}</a></li>
          <li><a href={blogPath}>{t.mega.resources.blog}</a></li>
          <li><button type="button" class="site-footer-tally" data-tally-open={TALLY_WHITEPAPER_ID[locale]} data-tally-emoji-text="">{t.mega.resources.whitepaper}</button></li>
          <li><a href={glossaryPath}>{t.mega.resources.glossary}</a></li>
          <li><a href={faqPath}>{t.mega.resources.faq}</a></li>
        </ul>
        <h5>{C.company}</h5>
        <ul>
          <li><a href={aboutUsHref} target="_blank" rel="noopener">{footerT.aboutUs}</a></li>
          <li><a href={contactPath} target="_blank" rel="noopener">{footerT.contact}</a></li>
          <li><a href={languageSwitchHref}>{languageSwitchLabel}</a></li>
        </ul>
      </div>

    </div>

    <div class="site-footer-newsletter">
      <NewsletterEmbed locale={locale} placement="site-footer" />
    </div>

    <div class="site-footer-bottom">
      <div class="site-footer-copy">{footerT.copyright}</div>
      <div class="site-footer-bottom-links">
        <a href={privacyPath}>{footerT.privacy}</a>
        <a href={termsPath}>{footerT.terms}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0A0807;
    color: #8a857d;
    padding: 96px 0 40px;
    border-top: 0.5px solid rgba(255, 255, 255, 0.08);
    font-family: "Sora", system-ui, sans-serif;
  }
  .site-footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .site-footer-top {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.1fr 1.1fr 1.2fr;
    gap: 48px;
    padding-bottom: 64px;
  }

  /* BRAND COLUMN */
  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .site-footer-brand .site-footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #FCFAF5;
  }
  .site-footer-tagline {
    font-family: "Noto Sans JP", "Sora", system-ui, sans-serif;
    color: #6a655d;
    font-size: 13px;
    line-height: 1.75;
    max-width: 240px;
    margin: 0;
  }
  .site-footer-dashboard-btn {
    background: var(--accent, #8B4513);
    color: #FCFAF5;
    padding: 16px 24px;
    border-radius: 12px;
    font-family: "Sora", system-ui, sans-serif;
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: background 0.15s;
    width: fit-content;
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.4);
  }
  .site-footer-dashboard-btn:hover {
    background: #6B340E;
  }
  .site-footer-dashboard-arr {
    font-size: 12px;
    opacity: 0.85;
  }

  .site-footer-social {
    display: flex;
    gap: 8px;
  }
  .site-footer-social a {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0.5px solid #2a2520;
    border-radius: 8px;
    color: #8a857d;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .site-footer-social a:hover {
    color: #FCFAF5;
    border-color: #4a4540;
  }

  /* COLUMNS */
  .site-footer-col h4 {
    font-family: "Sora", system-ui, sans-serif;
    font-size: 14.5px;
    color: #FCFAF5;
    margin: 0 0 20px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .site-footer-col h5 {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: #4a4540;
    margin: 32px 0 16px;
    font-weight: 400;
    text-transform: uppercase;
  }
  .site-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .site-footer-col li a {
    font-family: "Sora", system-ui, sans-serif;
    font-size: 13.5px;
    color: #8a857d;
    text-decoration: none;
    transition: color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .site-footer-col li a:hover {
    color: #FCFAF5;
  }
  .site-footer-tally {
    font-family: "Sora", system-ui, sans-serif;
    font-size: 13.5px;
    color: #8a857d;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s;
  }
  .site-footer-tally:hover {
    color: #FCFAF5;
  }
  .site-footer-newsletter {
    padding: 36px 0 0;
    border-top: 0.5px solid #1a1714;
    margin-top: 24px;
    max-width: 560px;
  }
  .site-footer-dot {
    color: #F5EBDC;
    font-size: 8px;
  }
  .site-footer-ext {
    font-size: 10.5px;
    opacity: 0.6;
  }

  /* BOTTOM */
  .site-footer-bottom {
    padding-top: 36px;
    border-top: 0.5px solid #1a1714;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .site-footer-copy {
    font-family: "Sora", system-ui, sans-serif;
    font-size: 12.5px;
    color: #4a4540;
  }
  .site-footer-bottom-links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
  .site-footer-bottom-links a {
    font-family: "Sora", system-ui, sans-serif;
    font-size: 12.5px;
    color: #8a857d;
    text-decoration: none;
    transition: color 0.15s;
  }
  .site-footer-bottom-links a:hover {
    color: #FCFAF5;
  }

  @media (max-width: 980px) {
    .site-footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 40px 32px;
    }
  }
  @media (max-width: 700px) {
    .site-footer {
      padding: 72px 0 32px;
    }
    .site-footer-inner {
      padding: 0 24px;
    }
    .site-footer-top {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 48px;
    }
    .site-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
