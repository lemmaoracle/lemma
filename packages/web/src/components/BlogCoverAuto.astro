---
/**
 * カバーの分岐点: coverPhoto が public/ に実在すれば写真、無ければ従来の
 * 抽象パターン（BlogCover）。一覧・カードのサムネイル用。
 *
 * 写真の色調・暗いヴェール・ライムの走査線はここの scoped CSS で掛ける
 * （入稿ファイルは無加工 — 刷新指示 §C-3）。走査線は「検証済み」の記号で、
 * 写真と抽象が一覧で隣り合っても同じシリーズに見えるための要
 * （カバー写真調達リスト §1.2）。位置・太さは CSS 変数で、呼び出し側が
 * 文脈に応じて上書きできる（例: 72px ミニサムネは 1px）。
 *
 * サイズ・角丸・影は使う側が持つ（BlogCover と同じ流儀）。使う側の
 * セレクタは `svg` と `.cover-photo` の両方を対象にすること。
 */
import BlogCover from "./BlogCover.astro";
import { resolveCoverImage } from "../lib/coverPhoto";

interface Props {
  readonly category: string;
  readonly slug: string;
  readonly coverPhoto?: string;
  /** frontmatter `cover`（サイト内絶対パスのときだけカバーとして使う）。 */
  readonly cover?: string;
}

const { category, slug, coverPhoto, cover } = Astro.props;
const photoSrc = resolveCoverImage({ coverPhoto, cover });
---

{photoSrc ? (
  <span class="cover-photo" aria-hidden="true">
    <img src={photoSrc} alt="" loading="lazy" />
  </span>
) : (
  <BlogCover category={category} slug={slug} />
)}

<style>
  .cover-photo {
    --cover-scan-top: 62%;
    --cover-scan-height: 2px;
    position: relative;
    display: block;
    overflow: hidden;
  }
  .cover-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: sepia(0.16) saturate(0.62) hue-rotate(-8deg) contrast(1.04);
  }
  /* 暗いヴェール — ユースケース索引サムネ（usecases-v14 の .ux-thv）と同一。
     刷新指示 §C-3 の灰緑ヴェールでは業界ページの写真より鮮やかに見える、
     という作者フィードバック（2026-08-04）でこちらに揃えた。 */
  .cover-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      200deg,
      rgba(16, 22, 17, 0.06) 0%,
      rgba(16, 22, 17, 0.3) 62%,
      rgba(16, 22, 17, 0.52) 100%
    );
    pointer-events: none;
  }
  /* ライムの走査線。ホバー時は使う側がわずかに明滅させる（記号が
     「反応する」だけ — 派手にしない）ため、transition を持たせておく。 */
  .cover-photo::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: var(--cover-scan-top);
    height: var(--cover-scan-height);
    background: var(--ok, #a8e010);
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.18s, box-shadow 0.18s;
  }
</style>
