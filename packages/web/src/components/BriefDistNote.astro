---
/**
 * Brief detail page — Distribution note (§9 in the mockup heading numbering;
 * rendered as template-owned content rather than from markdown so the
 * boilerplate stays consistent across all Briefs).
 */
import type { Locale } from "../i18n/translations";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface BriefDistNoteLabels {
  heading: string;
  body: string;
  discoveryCallLabel: string;
  whitepaperLabel: string;
}

export interface BriefDistNoteProps {
  locale: Locale;
  labels: BriefDistNoteLabels;
}

const { locale, labels } = Astro.props as BriefDistNoteProps;
const tallyWhitepaperId = locale === "ja" ? "xX0VYv" : "7RJXdR";
const newsletterUrl =
  locale === "ja"
    ? "https://tally.so/r/EkMj82?ref=brief-cta"
    : "https://tally.so/r/rjvN2X?ref=brief-cta";
const newsletterLabel = locale === "ja" ? "✉️ ニュースレター" : "✉️ Newsletter";
---

<section class="dist-note" aria-labelledby="distribution-heading">
  <h2 id="distribution-heading" class="dist-h3">{labels.heading}</h2>
  <p class="dist-text">{labels.body}</p>
  <nav class="dist-links" aria-label={labels.heading}>
    <a href={DISCOVERY_CALL_URL[locale]} target="_blank" rel="noopener">
      {labels.discoveryCallLabel} →
    </a>
    <button type="button" class="dist-tally" data-tally-open={tallyWhitepaperId} data-tally-emoji-text="">
      {labels.whitepaperLabel} →
    </button>
    {/* Newsletter stays a plain external link rather than a Tally popup so
       the `?ref=brief-cta` query lands in Tally insights as the source. */}
    <a href={newsletterUrl} target="_blank" rel="noopener">
      {newsletterLabel} →
    </a>
  </nav>
</section>

<style>
  .dist-note {
    --bd-display: "Sora", system-ui, sans-serif;
    --bd-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --bd-mono: "Space Mono", ui-monospace, SFMono-Regular, monospace;
    background: var(--lemma-cream-deep);
    border-radius: 14px;
    padding: 28px 32px;
    margin: 64px 0 0;
    font-family: var(--bd-body);
  }
  :root[lang="en"] .dist-note {
    --bd-body: "Sora", system-ui, sans-serif;
  }
  .dist-h3 {
    font-family: var(--bd-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .dist-text {
    font-size: 13.5px;
    color: #3a3a3a;
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .dist-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-family: var(--bd-mono);
    font-size: 11px;
  }
  .dist-links a,
  .dist-links .dist-tally {
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.05em;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
  }
  .dist-links a:hover,
  .dist-links .dist-tally:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .dist-note {
      padding: 24px 22px;
    }
  }
</style>
