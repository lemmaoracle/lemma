---
/**
 * 抽象カバー（リニューアル先行のデザイン移行で使う共通のカバー図）。
 *
 * 左＝証明の付いていない同じ見た目のもの、縦線をはさんで右＝証明の付いた
 * もの、を表す。**装飾**なので中身は読み上げ対象にしない（aria-hidden）。
 *
 * ここに1つだけ置いているのは、真正性ページと記事（v2）で同じ絵を出すため。
 * SVG の中で id を参照している（グラデーション・パターン）ので、**1ページに
 * 2つ置くと id が衝突する**。いまはどちらの面も1枚だけ。
 *
 * スタイルは自前で持つ（親の scoped style は子コンポーネントの要素に効かない）。
 */
---

<figure class="proof-cover" aria-hidden="true">
  <svg viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="pcbg" x1="0" y1="0" x2="0.4" y2="1">
        <stop offset="0" stop-color="#3C443D"></stop>
        <stop offset="55%" stop-color="#333B34"></stop>
        <stop offset="100%" stop-color="#2E362F"></stop>
      </linearGradient>
      <radialGradient id="pcglow" cx="88%" cy="6%" r="62%">
        <stop offset="0" stop-color="#A8E010" stop-opacity=".22"></stop>
        <stop offset="1" stop-color="#A8E010" stop-opacity="0"></stop>
      </radialGradient>
      <pattern id="pcgrid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path
          d="M40 0H0V40"
          fill="none"
          stroke="#FFFFFF"
          stroke-opacity=".05"
          stroke-width="1"></path>
      </pattern>
    </defs>
    <rect width="1200" height="630" fill="url(#pcbg)"></rect>
    <rect width="1200" height="630" fill="url(#pcgrid)"></rect>
    <rect width="1200" height="630" fill="url(#pcglow)"></rect>
    <g transform="translate(1200,0) scale(-1,1)">
      <g stroke-linejoin="round">
        <rect
          x="96"
          y="150"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".08"
          stroke="#A8E010"
          stroke-opacity=".75"
          stroke-width="2"></rect>
        <circle cx="214" cy="150" r="15" fill="#A8E010"></circle>
        <rect
          x="96"
          y="330"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".08"
          stroke="#A8E010"
          stroke-opacity=".75"
          stroke-width="2"></rect>
        <circle cx="214" cy="330" r="15" fill="#A8E010"></circle>
        <rect
          x="266"
          y="240"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".08"
          stroke="#A8E010"
          stroke-opacity=".75"
          stroke-width="2"></rect>
        <circle cx="384" cy="240" r="15" fill="#A8E010"></circle>
        <rect
          x="436"
          y="150"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".05"
          stroke="#FFFFFF"
          stroke-opacity=".16"
          stroke-width="2"></rect>
        <rect
          x="436"
          y="330"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".05"
          stroke="#FFFFFF"
          stroke-opacity=".16"
          stroke-width="2"></rect>
      </g>
      <line x1="620" y1="70" x2="620" y2="560" stroke="#A8E010" stroke-width="3"
      ></line>
      <g stroke-linejoin="round" opacity=".62">
        <rect
          x="700"
          y="150"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="700"
          y="330"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="870"
          y="240"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="870"
          y="60"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="1040"
          y="150"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="1040"
          y="330"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="700"
          y="500"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
        <rect
          x="870"
          y="420"
          width="118"
          height="118"
          rx="26"
          fill="#FFFFFF"
          fill-opacity=".04"
          stroke="#FFFFFF"
          stroke-opacity=".14"
          stroke-width="2"></rect>
      </g>
    </g>
  </svg>
</figure>

<style>
  .proof-cover {
    margin: 30px 0 0;
  }
  .proof-cover svg {
    width: 100%;
    aspect-ratio: 1200 / 630;
    display: block;
    border-radius: 14px;
    border: 1px solid #e1e3dd;
    box-shadow: 0 18px 44px rgba(24, 36, 26, 0.12);
  }
</style>
