---
/**
 * "Cite this Brief" box — three citation formats (Plain text / BibTeX / APA)
 * selectable via tabs, with a one-click copy button per tab.
 *
 * Vanilla JS:
 *   - Tab click swaps the active panel via [hidden] toggle
 *   - Copy button uses navigator.clipboard.writeText on the active panel
 *     and shows a short "Copied" affordance for ~1.5s
 *
 * One <CiteBriefBox /> per page is the expected usage; the script uses
 * the closest [data-cite-box] container so multiple instances would
 * still work.
 */
import type { Locale } from "../i18n/translations";

export interface CiteBriefBoxProps {
  locale: Locale;
  briefNo: string; // already zero-padded, e.g. "001"
  titleForCitation: string;
  year: number;
  briefUrl: string;
  briefSlug: string; // e.g. "001-kelpdao-rseth"
}

const { locale, briefNo, titleForCitation, year, briefUrl, briefSlug } =
  Astro.props as CiteBriefBoxProps;

const isJa = locale === "ja";

const plainText =
  `Lemma Critical Team. (${year}).\n` +
  `"${titleForCitation}".\n` +
  `Lemma Critical Brief No.${briefNo}. Lemma / FRAME00, Inc.\n` +
  `${briefUrl}`;

const bibtex =
  `@techreport{lemma_critical_${briefNo},\n` +
  `  author      = {{Lemma Critical Team}},\n` +
  `  title       = {${titleForCitation}},\n` +
  `  number      = {${briefNo}},\n` +
  `  year        = {${year}},\n` +
  `  institution = {Lemma / FRAME00, Inc.},\n` +
  `  url         = {${briefUrl}}\n` +
  `}`;

const apa =
  `Lemma Critical Team. (${year}).\n` +
  `${titleForCitation} (Lemma Critical Brief No.${briefNo}). ` +
  `Lemma / FRAME00, Inc.\n` +
  `${briefUrl}`;

const labels = isJa
  ? {
      heading: "この Brief を引用する",
      eyebrow: "Cite this Brief",
      copy: "コピー",
      copied: "コピーしました",
      copyAria: "選択中の引用形式をコピー",
    }
  : {
      heading: "Cite this Brief",
      eyebrow: "Citation",
      copy: "Copy",
      copied: "Copied",
      copyAria: "Copy the active citation format",
    };

const id = `cite-${briefSlug}`;
---

<section class="cite-box" data-cite-box aria-labelledby={`${id}-heading`}>
  <div class="cite-head">
    <h2 id={`${id}-heading`} class="cite-heading">{labels.heading}</h2>
    <div class="cite-tabs" role="tablist">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-cite-tab="plain"
        class="cite-tab cite-tab-active"
      >
        Plain text
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-cite-tab="bibtex"
        class="cite-tab"
      >
        BibTeX
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-cite-tab="apa"
        class="cite-tab"
      >
        APA
      </button>
    </div>
  </div>

  <div class="cite-panels">
    <pre class="cite-panel" data-cite-panel="plain" aria-live="polite"><code>{plainText}</code></pre>
    <pre class="cite-panel" data-cite-panel="bibtex" hidden><code>{bibtex}</code></pre>
    <pre class="cite-panel" data-cite-panel="apa" hidden><code>{apa}</code></pre>
    <button
      type="button"
      class="cite-copy"
      data-cite-copy
      aria-label={labels.copyAria}
      data-copy-label={labels.copy}
      data-copied-label={labels.copied}
    >
      <span class="cite-copy-text">{labels.copy}</span>
    </button>
  </div>
</section>

<script>
  type CiteBox = HTMLElement & { dataset: { citeBox?: string } };

  function setupCiteBoxes() {
    const boxes = document.querySelectorAll<CiteBox>("[data-cite-box]");
    boxes.forEach((box) => {
      const tabs = box.querySelectorAll<HTMLButtonElement>("[data-cite-tab]");
      const panels = box.querySelectorAll<HTMLElement>("[data-cite-panel]");
      const copyBtn = box.querySelector<HTMLButtonElement>("[data-cite-copy]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const targetKey = tab.dataset.citeTab;
          tabs.forEach((t) => {
            const isActive = t.dataset.citeTab === targetKey;
            t.classList.toggle("cite-tab-active", isActive);
            t.setAttribute("aria-selected", isActive ? "true" : "false");
          });
          panels.forEach((p) => {
            const isActive = p.dataset.citePanel === targetKey;
            if (isActive) {
              p.removeAttribute("hidden");
            } else {
              p.setAttribute("hidden", "");
            }
          });
        });
      });

      if (copyBtn) {
        copyBtn.addEventListener("click", async () => {
          const active = box.querySelector<HTMLElement>(
            "[data-cite-panel]:not([hidden])",
          );
          if (!active) return;
          const text = active.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            const span = copyBtn.querySelector<HTMLElement>(".cite-copy-text");
            if (!span) return;
            const original = copyBtn.dataset.copyLabel ?? "Copy";
            const copied = copyBtn.dataset.copiedLabel ?? "Copied";
            span.textContent = copied;
            copyBtn.classList.add("cite-copy-active");
            setTimeout(() => {
              span.textContent = original;
              copyBtn.classList.remove("cite-copy-active");
            }, 1500);
          } catch (_err) {
            // Clipboard API can fail in non-HTTPS contexts (local file://,
            // some embedded views). Surface silently — no fallback selection.
          }
        });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCiteBoxes, { once: true });
  } else {
    setupCiteBoxes();
  }
</script>

<style>
  /* モック `lemma_brief_article_mock_v5.html` の `.cite` の面:
     白カード（1px枠＋角丸12px）／ヘッダー行に見出し＋右へタブ（選択中は
     蛍光地に墨文字）／本文はモノスペース。トークンの値は BriefTemplate と
     同じもの。 */
  .cite-box {
    --cite-serif: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --cite-mono: "Space Mono", monospace;
    --cite-ok: #a8e010;
    --cite-ok-ink: #6f9c00;
    --cite-ink: #0f1412;
    --cite-tx: #12140e;
    --cite-tx-soft: #2f332b;
    --cite-muted: #5c6156;
    --cite-line: #e1e3dd;
    margin: 40px 0 0;
    background: #fff;
    border: 1px solid var(--cite-line);
    border-radius: 12px;
    overflow: hidden;
  }
  .cite-head {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 14px 18px;
    border-bottom: 1px solid var(--cite-line);
  }
  .cite-heading {
    font-family: var(--cite-serif);
    font-weight: 600;
    font-size: 14px;
    color: var(--cite-tx);
    margin: 0;
    letter-spacing: 0.03em;
  }

  .cite-tabs {
    margin-left: auto;
    display: flex;
    gap: 6px;
  }
  .cite-tab {
    font-family: var(--cite-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--cite-muted);
    border: 1px solid var(--cite-line);
    border-radius: 99px;
    padding: 4px 11px;
    cursor: pointer;
    background: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .cite-tab:hover {
    color: var(--cite-tx);
    border-color: rgba(124, 175, 0, 0.5);
  }
  .cite-tab-active,
  .cite-tab-active:hover {
    background: var(--cite-ok);
    border-color: var(--cite-ok);
    color: var(--cite-ink);
  }

  .cite-panel {
    margin: 0;
    padding: 16px 18px 6px;
    background: none;
    color: var(--cite-tx-soft);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
    font-family: var(--cite-mono);
    font-size: 11.5px;
    line-height: 1.85;
  }
  .cite-panel code {
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    padding: 0;
    border: none;
  }

  .cite-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 4px 18px 14px;
    font-family: var(--cite-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--cite-ok-ink);
    background: none;
    border: 1px solid var(--cite-line);
    border-radius: 99px;
    padding: 5px 12px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .cite-copy:hover,
  .cite-copy-active {
    border-color: rgba(124, 175, 0, 0.5);
    color: var(--cite-tx);
  }

  @media (max-width: 560px) {
    .cite-tabs {
      margin-left: 0;
    }
    .cite-panel {
      font-size: 10.5px;
    }
  }
</style>
