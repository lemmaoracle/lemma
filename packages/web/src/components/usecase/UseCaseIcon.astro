---
/**
 * Use case hub — compact 32×32 business-image icon for a UC card.
 *
 * One shared 13-icon system (Lemma_UC_hub_icons_PR.md): same theme → same
 * icon, in the TOP/Solutions axis icon language (saddle-brown line-art on a
 * cream chip, with green / rust accents). Pass the UC `slug`; the component
 * resolves it to an icon via SLUG_TO_ICON and renders the chip + inline SVG.
 * Unmapped slugs render nothing, so the card simply falls back to no icon.
 *
 * SVGs are language-independent, so the same mapping drives JA and EN hubs.
 */
type IconId =
  | "docs-certified"
  | "agent-face"
  | "multi-agent"
  | "agent-yen"
  | "scales"
  | "checklist"
  | "shield"
  | "id-check"
  | "store-network"
  | "certificate-seal"
  | "benefit-hand"
  | "chain"
  | "bridge";

interface Props {
  slug: string;
}

const { slug } = Astro.props as Props;

// UC slug → icon. Same theme shares an icon (Lemma_UC_hub_icons_PR.md §2,
// plus the 3 P2 additions from Lemma_P2_UC_addition_PR.md §6).
const SLUG_TO_ICON: Readonly<Record<string, IconId>> = {
  // §01 AIに生データを渡さず任せる
  "ai-document-isolation": "agent-face",
  "ai-audit-log-proof": "checklist",
  "rag-content-provenance": "docs-certified",
  "rag-source-attestation": "docs-certified",
  "prompt-injection-detection": "shield",
  "ai-act-compliance-attestation": "checklist",
  "model-version-attestation": "agent-face",
  // §02 記録・契約・承認を後から証明する
  "long-term-contract-record": "scales",
  "internal-control-approval-proof": "checklist",
  "incident-response-record": "shield",
  "financial-data-exfiltration": "shield",
  // §03 取引相手・仕入先を確かめる
  "counterparty-screening": "scales",
  "kyc-aml-selective-disclosure": "id-check",
  "customer-flag-need-to-know": "shield",
  "age-eligibility-verification": "id-check",
  "store-network-compliance": "store-network",
  "supplier-credential-verification": "certificate-seal",
  // §04 サプライチェーンの来歴・適合を証明する
  "supply-chain-component-provenance": "chain",
  "supply-chain-esg": "chain",
  // §05 資格・実績・受給資格を証明する
  "credential-presentation": "certificate-seal",
  "qualified-worker-attestation": "certificate-seal",
  "work-fitness-attestation": "certificate-seal",
  "benefit-eligibility-proof": "benefit-hand",
  // §06 エージェント・決済の権限を証明する
  "multi-agent-workflows": "multi-agent",
  "delegated-treasury": "agent-yen",
  "x402-commerce": "bridge",
  "defi-bridge-verification": "bridge",
  "agent-expense-approval": "agent-yen",
  "agent-procurement": "agent-yen",
  "agent-api-billing": "agent-yen",
  "agent2agent-settlement": "multi-agent",
};

// Inner SVG markup per icon (32×32 viewBox). Brand palette: cream #FCFAF5,
// saddle brown #8B4513, green #5C7A4A, rust #B8501F.
const ICONS: Readonly<Record<IconId, string>> = {
  "docs-certified": `
    <rect x="5" y="10" width="16" height="18" rx="1.5" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <rect x="8" y="7" width="16" height="18" rx="1.5" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <rect x="11" y="4" width="16" height="18" rx="1.5" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <rect x="13" y="7" width="12" height="1.5" fill="#8B4513"/>
    <line x1="13" y1="12" x2="23" y2="12" stroke="#8B4513" stroke-width="0.8" opacity="0.6"/>
    <line x1="13" y1="15" x2="21" y2="15" stroke="#8B4513" stroke-width="0.8" opacity="0.6"/>
    <circle cx="23" cy="20" r="4" fill="#5C7A4A" stroke="#FCFAF5" stroke-width="1.2"/>
    <path d="M 21,20 L 22.5,21.5 L 25,18.5" stroke="#FCFAF5" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  "agent-face": `
    <line x1="16" y1="7" x2="16" y2="4" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="16" cy="3" r="1.2" fill="#8B4513"/>
    <rect x="6" y="7" width="20" height="20" rx="3" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.5"/>
    <circle cx="12" cy="15" r="1.5" fill="#8B4513"/>
    <circle cx="20" cy="15" r="1.5" fill="#8B4513"/>
    <line x1="13" y1="21" x2="19" y2="21" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>`,
  "multi-agent": `
    <rect x="3" y="8" width="14" height="14" rx="2" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <circle cx="7" cy="13" r="1" fill="#8B4513"/>
    <circle cx="13" cy="13" r="1" fill="#8B4513"/>
    <line x1="8" y1="18" x2="12" y2="18" stroke="#8B4513" stroke-width="1.2" stroke-linecap="round"/>
    <rect x="15" y="13" width="14" height="14" rx="2" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <circle cx="19" cy="18" r="1" fill="#8B4513"/>
    <circle cx="25" cy="18" r="1" fill="#8B4513"/>
    <line x1="20" y1="23" x2="24" y2="23" stroke="#8B4513" stroke-width="1.2" stroke-linecap="round"/>
    <path d="M 14,14 L 16,17" stroke="#8B4513" stroke-width="1.2" stroke-dasharray="1,1" fill="none"/>`,
  "agent-yen": `
    <rect x="3" y="6" width="18" height="18" rx="2.5" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <circle cx="9" cy="13" r="1.2" fill="#8B4513"/>
    <circle cx="15" cy="13" r="1.2" fill="#8B4513"/>
    <line x1="10" y1="18" x2="14" y2="18" stroke="#8B4513" stroke-width="1.3" stroke-linecap="round"/>
    <circle cx="24" cy="22" r="5" fill="#5C7A4A" stroke="#FCFAF5" stroke-width="1.4"/>
    <text x="24" y="25" text-anchor="middle" font-family="Sora, sans-serif" font-size="7" font-weight="700" fill="#FCFAF5">¥</text>`,
  "scales": `
    <line x1="16" y1="4" x2="16" y2="28" stroke="#8B4513" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="8" y1="9" x2="24" y2="9" stroke="#8B4513" stroke-width="1.5"/>
    <path d="M 6,14 L 10,14 L 8,11 Z" fill="#8B4513"/>
    <path d="M 4,15 L 12,15 L 10,18 L 6,18 Z" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.2"/>
    <path d="M 22,14 L 26,14 L 24,11 Z" fill="#8B4513"/>
    <path d="M 20,15 L 28,15 L 26,18 L 22,18 Z" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.2"/>
    <circle cx="16" cy="26" r="1.5" fill="#8B4513"/>`,
  "checklist": `
    <rect x="6" y="4" width="20" height="24" rx="1.5" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <line x1="9" y1="9" x2="11" y2="9" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="11" y1="9" x2="12" y2="10" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="14" y1="9" x2="22" y2="9" stroke="#8B4513" stroke-width="1"/>
    <line x1="9" y1="14" x2="11" y2="14" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="11" y1="14" x2="12" y2="15" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="14" y1="14" x2="20" y2="14" stroke="#8B4513" stroke-width="1"/>
    <line x1="9" y1="19" x2="11" y2="19" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="11" y1="19" x2="12" y2="20" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="14" y1="19" x2="22" y2="19" stroke="#8B4513" stroke-width="1"/>
    <line x1="9" y1="24" x2="11" y2="24" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="11" y1="24" x2="12" y2="25" stroke="#5C7A4A" stroke-width="1.5"/>
    <line x1="14" y1="24" x2="20" y2="24" stroke="#8B4513" stroke-width="1"/>`,
  "shield": `
    <path d="M 16,4 L 26,7 L 26,16 Q 26,22 16,28 Q 6,22 6,16 L 6,7 Z" fill="#8B4513" stroke="#8B4513" stroke-width="1.4"/>
    <path d="M 11,15 L 14,18 L 21,11" stroke="#FCFAF5" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  "id-check": `
    <rect x="4" y="8" width="24" height="16" rx="2" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <circle cx="10" cy="14" r="2.5" fill="#8B4513"/>
    <path d="M 6,21 Q 6,17 10,17 Q 14,17 14,21" fill="#8B4513"/>
    <line x1="17" y1="13" x2="25" y2="13" stroke="#8B4513" stroke-width="1.2"/>
    <line x1="17" y1="16" x2="23" y2="16" stroke="#8B4513" stroke-width="1.2"/>
    <circle cx="24" cy="22" r="4" fill="#5C7A4A" stroke="#FCFAF5" stroke-width="1.2"/>
    <path d="M 22,22 L 23.5,23.5 L 26,20.5" stroke="#FCFAF5" stroke-width="1.3" fill="none" stroke-linecap="round"/>`,
  "store-network": `
    <rect x="3" y="14" width="9" height="14" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <path d="M 3,14 L 12,14 L 10,8 L 5,8 Z" fill="#8B4513"/>
    <rect x="6" y="20" width="3" height="8" fill="#8B4513"/>
    <rect x="14" y="11" width="11" height="17" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <path d="M 14,11 L 25,11 L 23,5 L 16,5 Z" fill="#8B4513"/>
    <rect x="18" y="19" width="3" height="9" fill="#8B4513"/>
    <rect x="27" y="16" width="3" height="12" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.2"/>`,
  "certificate-seal": `
    <rect x="5" y="4" width="22" height="20" rx="1" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <rect x="8" y="8" width="10" height="2" fill="#8B4513"/>
    <line x1="8" y1="13" x2="22" y2="13" stroke="#8B4513" stroke-width="0.8"/>
    <line x1="8" y1="16" x2="18" y2="16" stroke="#8B4513" stroke-width="0.8"/>
    <line x1="8" y1="19" x2="20" y2="19" stroke="#8B4513" stroke-width="0.8"/>
    <circle cx="23" cy="22" r="5" fill="none" stroke="#B8501F" stroke-width="1.8"/>
    <circle cx="23" cy="22" r="3" fill="none" stroke="#B8501F" stroke-width="1"/>
    <path d="M 21,22 L 22.5,23.5 L 25,20.5" stroke="#B8501F" stroke-width="1.5" fill="none" stroke-linecap="round"/>`,
  "benefit-hand": `
    <rect x="6" y="12" width="14" height="10" rx="1.5" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.4"/>
    <circle cx="13" cy="17" r="3" fill="#5C7A4A"/>
    <text x="13" y="20" text-anchor="middle" font-family="Sora, sans-serif" font-size="6" font-weight="700" fill="#FCFAF5">¥</text>
    <path d="M 21,18 Q 23,16 25,18 Q 26,19 26,21 L 26,24 Q 26,26 24,26 L 21,26" stroke="#8B4513" stroke-width="1.4" fill="#FCFAF5"/>
    <path d="M 22,21 Q 22,19 24,19" stroke="#8B4513" stroke-width="1" fill="none"/>`,
  "chain": `
    <ellipse cx="9" cy="12" rx="5" ry="3" fill="none" stroke="#8B4513" stroke-width="1.8"/>
    <ellipse cx="16" cy="20" rx="5" ry="3" fill="none" stroke="#8B4513" stroke-width="1.8"/>
    <ellipse cx="23" cy="12" rx="5" ry="3" fill="none" stroke="#8B4513" stroke-width="1.8"/>`,
  "bridge": `
    <circle cx="6" cy="16" r="3" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.5"/>
    <circle cx="26" cy="16" r="3" fill="#FCFAF5" stroke="#8B4513" stroke-width="1.5"/>
    <path d="M 9,16 L 23,16" stroke="#8B4513" stroke-width="1.5"/>
    <path d="M 13,11 L 19,11" stroke="#8B4513" stroke-width="1.2" stroke-dasharray="2,1"/>
    <path d="M 13,21 L 19,21" stroke="#8B4513" stroke-width="1.2" stroke-dasharray="2,1"/>
    <path d="M 11,8 L 16,8 L 14,11 Z" fill="#5C7A4A"/>
    <path d="M 21,24 L 16,24 L 18,21 Z" fill="#5C7A4A"/>`,
};

const iconId = SLUG_TO_ICON[slug];
const inner = iconId ? ICONS[iconId] : undefined;
---

{inner && (
  <div class="uc-card-icon" data-icon={iconId}>
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={inner} />
  </div>
)}

<style>
  .uc-card-icon {
    width: 32px;
    height: 32px;
    margin-bottom: 12px;
    background: var(--lemma-cream-deep);
    border: 0.5px solid var(--lemma-line);
    border-radius: 6px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .uc-card-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
