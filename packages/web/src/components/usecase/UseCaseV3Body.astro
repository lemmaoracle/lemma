                      <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                    </svg>
                  </div>
                  <div class="ucv-persona-role">{p.role[locale]}</div>
                  <p class="ucv-persona-quote">{isJa ? `「${p.quote.ja}」` : `“${p.quote.en}”`}</p>
                </li>
              ))}
            </ul>
          </Fragment>
        ) : audienceSection && (
          <Fragment>
            <div class="ucv-eye">{C.s1Eye}</div>
            <h2 class="ucv-h2">{audienceSection.title || C.s1H2}</h2>
            {audienceIntro && <p class="ucv-band-lead" set:html={audienceIntro} />}
            {audienceBullets.length > 0 ? (
              <ul class="ucv-personas">
                {audienceBullets.slice(0, 3).map((b) => (
                  <li class="ucv-persona">
                    <div class="ucv-persona-avatar" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4" fill="currentColor" />
                        <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                      </svg>
                    </div>
                    <p class="ucv-persona-quote" set:html={b} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="ucv-audience ucv-steps-body" set:html={audienceSection.body} />
            )}
          </Fragment>
        )}
      </div>
    </section>
  )}

  <!-- §2 — authored Before/After cards, or derived approach. -->
  {(v3 || approachSection) && (
    <section class="ucv-band" aria-label={C.ariaApproach}>
      <div class="ucv-container">
        <div class="ucv-emph">
          <div class="ucv-eye">{C.s2EyeShift}</div>
          <h2 class="ucv-h2">{C.s2H2}</h2>

          <p class="ucv-band-lead">{C.s2Catch}</p>
          {/* §2 は 3 段。①照合そのものの図（境界線を引き、原本は内側に
              留まり証明だけが越えることを線で見せる。語数は最小限）→
              ②「渡すもの」だけの新旧比較 → ③仕組みの節。文章で読ませる形は
              分かりにくいという判断で、この順に組み直した。
              中身は config/useCaseFlow.ts（未登録の UC は C.flow の一般形）。 */}
          <div class="ucv-cf">
            <div class="ucv-cf-zone ucv-cf-zone--in">
              <div class="ucv-cf-zk">{flow.insideLabel}</div>
              <div class="ucv-cf-srcs">
                <div class="ucv-cf-src">
                  <b>{flow.aLabel}</b>
                  <ul>{flow.aItems.map((i) => <li>{i}</li>)}</ul>
                </div>
                <div class="ucv-cf-src">
                  <b>{flow.bLabel}</b>
                  <ul>{flow.bItems.map((i) => <li>{i}</li>)}</ul>
                </div>
              </div>
              <div class="ucv-cf-merge"><span>{flow.opLabel}</span></div>
              <ul class="ucv-cf-res">
                {flow.results.map((r) => <li>{r}</li>)}
              </ul>
            </div>

            <div class="ucv-cf-cross">
              <span class="chip">{flow.crossLabel}</span>
              <span class="arw" aria-hidden="true"><i></i><s></s></span>
              <span class="note">{flow.boundaryNote}</span>
            </div>

            <div class="ucv-cf-zone ucv-cf-zone--out">
              <div class="ucv-cf-zk">{flow.outsideLabel}</div>
              <div class="ucv-cf-verdict">
                <div class="seal">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                    <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                    <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="t">{C.hiwVerdict}</div>
                {isJa && <div class="en">NOT TAMPERED</div>}
              </div>
              <b class="ucv-cf-to">{flow.toLabel}</b>
              <p class="ucv-cf-tonote">{flow.toNote}</p>
            </div>
          </div>

          {/* 比較はここ 1 点だけ。チップを並べると新旧が対等に見えてしまい、
              データの重さの差が出ない。帯の長さで落差そのものを見せる。 */}
          <div class="ucv-pay">
            <div class="ucv-pay-h">{C.payHead}</div>
            <p class="ucv-pay-lead">{flow.payLead}</p>
            <div class="ucv-pay-row ucv-pay-row--was">
              <div class="hd"><span class="mk" aria-hidden="true">✕</span>{C.flowWasTag}：{flow.wasTitle}</div>
              <p class="dt">{flow.wasDetail}</p>
              <div class="bar"><span style="width:100%"></span><em>{flow.wasVolume}</em></div>
            </div>
            <div class="ucv-pay-row ucv-pay-row--now">
              <div class="hd"><span class="mk" aria-hidden="true">✓</span>{C.flowNowTag}：{flow.nowTitle}</div>
              <p class="dt">{flow.nowDetail}</p>
              <div class="bar"><span style="width:2.5%"></span><em>{flow.nowVolume}</em></div>
            </div>
          </div>

          <section class="ucv-mech">
            <div class="ucv-mech-eye">{C.mechEye}</div>
            <h3 class="ucv-mech-h">{C.mechH}</h3>
            {/* 散文の羅列だと読まれないので、要点 3 つを先に立てる。
                しるしは順に 鍵（原本を出さない）→ 証明（渡るもの）→ 検証。 */}
            <ol class="ucv-mech-pts">
              {flow.mechPoints.map((m, i) => (
                <li>
                  <span class="ic" aria-hidden="true">
                    {i === 0 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <rect x="4.5" y="10.5" width="15" height="10" rx="2" stroke-width="1.4" />
                        <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke-width="1.4" stroke-linecap="round" />
                      </svg>
                    )}
                    {i === 1 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M6 3.5h8l4 4V20a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 20V4a.5.5 0 0 1 .5-.5Z" stroke-width="1.4" stroke-linejoin="round" />
                        <path d="M14 3.5V8h4" stroke-width="1.4" stroke-linejoin="round" />
                        <path d="M9 14.5l2 2 4-4.5" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {i === 2 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M13 3 5.5 13.5H11L10.5 21 18.5 10H13z" stroke-width="1.4" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <b>{m.t}</b>
                  <p>{m.d}</p>
                </li>
              ))}
            </ol>
            <details class="ucv-mech-more">
              <summary>{C.mechMore}</summary>
              {v3 ? (
                <p class="ucv-mech-body">{v3.approach[locale]}</p>
              ) : (
                <div class="ucv-mech-body" set:html={approachBody} />
              )}
              {/* 柱ページへの導線は開いた中に置く。畳んだ状態で
                  「詳しい仕組みを読む」と 2 つ並ぶと役割が重なるため。 */}
              <a class="ucv-info-link" href={`${pillarsPath}/${PILLAR_ANCHOR[pillar.slug] ?? ""}`}>{C.approachLink}</a>
            </details>
          </section>

        </div>
      </div>
    </section>
  )}

  <!-- §3 選定基準 — common comparison table -->
  <section class="ucv-band ucv-band--deep" aria-label={C.ariaCriteria}>
    <div class="ucv-container">
      <div class="ucv-eye">{C.s3Eye}</div>
      <h2 class="ucv-h2">{C.s3H2}</h2>
      <p class="ucv-band-lead" set:html={C.s3Lead} />
      <div class="ucv-table-wrap">
        <table class="ucv-table">
          <thead>
            <tr>
              <th>{C.thMethod}</th>
              <th>{C.thPass}</th>
              <th>{C.thVerify}</th>
              <th>{C.thTamper}</th>
              <th class="why">{C.thWhy}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>{C.rowAccess}</td><td>△</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowAccessWhy}</td></tr>
            <tr><td>{C.rowMask}</td><td>△</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowMaskWhy}</td></tr>
            <tr><td>{C.rowEnc}</td><td class="ok">✓</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowEncWhy}</td></tr>
            {compareRow && (
              <tr><td>{compareRow}</td><td>△</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowExtraWhy}</td></tr>
            )}
            <tr class="is-lemma">
              <td><span class="ucv-lemma-name">{C.lemmaName}</span><span class="ucv-only">{C.onlyTag}</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td class="why">{C.rowLemmaWhy}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- §4 進め方 — 業界ページ HIW と同型のスレート帯・3カラム -->
  <section class="ucv-band ucv-band--slate" aria-label={C.ariaSteps}>
    <div class="ucv-container">
      <div class="ucv-eye">{C.s4Eye}</div>
      <h2 class="ucv-h2">{C.s4Title}</h2>
      <div class="ucv-hiw">

        <div class="ucv-hiw-step">
          <div class="ucv-hiw-shot">
            <div class="ucv-mini">
              <div class="ucv-mini-bar">{C.hiw1Bar}</div>
              <div class="ucv-mini-body">
                <div class="ucv-mini-row"><span>{C.hiwProveLab}</span><b>{hideProve ? hideProve.prove : useCase.title}</b></div>
                {hideProve && <div class="ucv-mini-row"><span>{C.hiwHideLab}</span><b>{hideProve.hide}</b></div>}
              </div>
            </div>
          </div>
          <span class="ucv-hiw-n">01 — {C.s4Steps[0].a}</span><span class="ucv-hiw-t">{C.s4Steps[0].t}</span>
          <span class="ucv-hiw-d">{C.s4Steps[0].d}</span>
        </div>

        <div class="ucv-hiw-step">
          <div class="ucv-hiw-shot">
            <div class="ucv-mini">
              <div class="ucv-mini-bar">{C.hiw2Bar}</div>
              <div class="ucv-mini-body">
                <div class="ucv-mini-row"><span>{C.hiwSentLab}</span><b>{C.hiwSentVal}</b></div>
                <div class="ucv-mini-row"><span>{C.hiwDocLab}</span><b>{C.hiwDocVal}</b></div>
                <div class="ucv-mini-ok">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="11" stroke-width="1.4" />
                    <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {C.hiwIssued}
                </div>
              </div>
            </div>
          </div>
          <span class="ucv-hiw-n">02 — {C.s4Steps[1].a}</span><span class="ucv-hiw-t">{C.s4Steps[1].t}</span>
          <span class="ucv-hiw-d">{C.s4Steps[1].d}</span>
        </div>

        <div class="ucv-hiw-step">
          <div class="ucv-hiw-shot">
            <div class="ucv-mini">
              <div class="ucv-mini-bar">{C.hiw3Bar}</div>
              <div class="ucv-mini-verdict">
                <div class="seal">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                    <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                    <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="t">{C.hiwVerdict}</div>
                {isJa && <div class="en">NOT TAMPERED</div>}
                <div class="chk"><span>{C.hiwChk1}</span><span>{C.hiwChk2}</span><span>{C.hiwChk3}</span></div>
              </div>
            </div>
          </div>
          <span class="ucv-hiw-n">03 — {C.s4Steps[2].a}</span><span class="ucv-hiw-t">{C.s4Steps[2].t}</span>
          <span class="ucv-hiw-d">{C.s4Steps[2].d}</span>
        </div>

      </div>
      <p class="ucv-steps-note">{C.s4Note}</p>
      <div class="ucv-cta-card">
        <p class="ucv-cta-card-h">{C.ctaCardH}</p>
        {invite && <div class="ucv-steps-invite" set:html={invite} />}
        <a class="ucv-uc-cta-btn" href={isJa ? `https://tally.so/r/EkBqDX?uc=${useCase.slug}` : `https://tally.so/r/Pd2Rl5?uc=${useCase.slug}`} target="_blank" rel="noopener">
          {isJa ? "このユースケースについて、問い合わせる →" : "Talk to us about this use case →"}
        </a>
      </div>
    </div>
  </section>

  <!-- §5 関連 + §6 業務から探す — 1帯2カラム -->
  <section class="ucv-band ucv-band--deep" aria-label={C.ariaRelated}>
    <div class="ucv-container ucv-crossnav">
      <div>
        <h2 class="ucv-h3">{relatedSection?.title ?? C.s5H2}</h2>
        {relatedUseCases.length > 0 && (
          <div class="ucv-bytask-list">
            {relatedUseCases.map((r) => (
              <a class="ucv-bytask-row" href={`${useCasesPath}/${r.slug}/`}>{r.title}</a>
            ))}
          </div>
        )}
      </div>
      {taskGroup && bytaskMembers.length > 0 && (
        <div>
          <h2 class="ucv-h3" id="ucv-bytask-h">業務から探す</h2>
          <p class="ucv-bytask-sub">同じ課題｜{taskGroup.heading}</p>
          <div class="ucv-bytask-list">
            {bytaskMembers.map((m) => (
              <a class="ucv-bytask-row" href={`${useCasesPath}/${m.slug}/`}>{m.title}</a>
            ))}
          </div>
        </div>
      )}
    </div>
    <div class="ucv-container ucv-ucnav">
      <p class="ucv-ucnav-lead">{isJa ? "お探しの業界・課題に合わせた事例が見つかります" : "Find the case that matches your industry and problem"}</p>
      <a class="ucv-btn ucv-btn--ghost" href={`${useCasesPath}/`}>{isJa ? "課題や業種から業務ユースケースを探す（全36件） →" : "Browse all 36 use cases →"}</a>
    </div>
  </section>

  {/* EN のみ製品クロージングを残す（§4 の主CTAが JA 限定のため）。
      JA の Discovery Call 帯は §4 の問い合わせと同一行動につき統合・撤去。 */}
  {!isJa && (
    <section class="ucv-closing" aria-label="Try Lemma">
      <div class="ucv-closing-inner">
        <p class="ucv-closing-eyebrow">TRY LEMMA</p>
        <h2 class="ucv-closing-h">Run it <span class="accent">yourself</span>.</h2>
        <p class="ucv-closing-sub">No sales call needed — start hands-on with Lemma's products.</p>
        <div class="ucv-closing-ctas">
          <a href={sealHref} class="ucv-closing-pill">Try Seal →</a>
          <a href={trust402Href} class="ucv-closing-link">Trust402 reference implementation →</a>
        </div>
      </div>
    </section>
  )}
</main>

<style>
  /* ============================================================
     UC 詳細 v4 — 業界ページ (indv1 / usecases-index v14) と同一の
     デザインシステム。トークン・字組み・部品の値は
     industry-v1.css / 業界モック確定版から写している。
     上書きは .ucv-page 内に限定。
     ============================================================ */
  .ucv-page {
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #ffffff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --ok: #a8e010;
    --ok-light: #4e7a00;
    --ok-ink: #6f9c00;
    --err: #c25438;
    --line: #e1e3dd;
    --dline-2: #d9ddd7;
    --sh-s: 0 4px 14px rgba(14, 18, 16, 0.06);
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.1);
    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.9;
    margin-top: 64px;
    padding: 0;
  }
  .ucv-container { max-width: calc(1180px + 12vw); margin: 0 auto; padding: 0 6vw; }
  a { text-decoration: none; color: inherit; }

  /* ---------- breadcrumb ---------- */
  .ucv-breadcrumb { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; padding: 34px 0 0; font-size: 12px; color: var(--muted); }
  .ucv-breadcrumb a { color: var(--muted); }
  .ucv-breadcrumb a:hover { color: var(--ok-light); }
  .ucv-bc-sep { color: var(--dline-2); margin: 0 2px; }

  /* ---------- hero ---------- */
  .ucv-hero { display: grid; grid-template-columns: minmax(0, 1fr) 470px; gap: 42px; align-items: center; padding: 22px 0 44px; }
  .ucv-uc-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ok-ink); margin: 20px 0 12px; }
  .ucv-h1 { font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(26px, 3.2vw, 38px); line-height: 1.5; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 16px; overflow-wrap: anywhere; }
  .ucv-lead { font-size: 15px; line-height: 2; color: var(--tx-soft); margin: 0 0 18px; max-width: 52ch; }
  .ucv-meta { display: flex; gap: 18px; flex-wrap: wrap; align-items: baseline; margin: 0 0 20px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; color: var(--muted); }
  .ucv-plan { color: var(--muted); }
  .ucv-plan b { color: var(--ok-light); font-weight: 400; }
  .ucv-plan:hover b { text-decoration: underline; }
  .ucv-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ucv-btn { display: inline-block; text-decoration: none; font-weight: 500; font-size: 14px; border-radius: 6px; padding: 14px 30px; cursor: pointer; border: 1px solid transparent; transition: 0.18s; font-family: var(--font-body); letter-spacing: 0.05em; }
  .ucv-btn--primary { background: var(--ok); color: var(--ink); font-weight: 600; box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35); }
  .ucv-btn--primary:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .ucv-btn--ghost { color: var(--tx-soft); border-color: #d5dad3; background: rgba(255, 255, 255, 0.5); }
  .ucv-btn--ghost:hover { border-color: var(--ok-ink); color: var(--tx); }

  /* hero 右 — 検証画面カード（スレート） */
  .ucv-ui { position: relative; overflow: hidden; border-radius: 14px; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); box-shadow: 0 26px 60px rgba(22, 30, 24, 0.28); }
  .ucv-ui::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(125% 78% at 92% -18%, rgba(168, 224, 16, 0.16), rgba(168, 224, 16, 0) 62%); }
  .ucv-ui > * { position: relative; z-index: 2; }
  .ucv-ui-bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; border-bottom: 1px solid #4a544b; }
  .ucv-ui-dot { width: 8px; height: 8px; border-radius: 50%; background: #4a544b; }
  .ucv-ui-url { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; color: #8b9285; margin-left: 6px; }
  .ucv-ui-body { padding: 20px 20px 18px; }
  .ucv-uv-head { display: flex; align-items: center; gap: 13px; margin-bottom: 16px; }
  .ucv-uv-seal { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; flex: none; border: 1.5px solid rgba(168, 224, 16, 0.55); background: rgba(168, 224, 16, 0.09); color: var(--ok); }
  .ucv-uv-t { font-family: var(--font-serif-jp); font-weight: 600; font-size: 17px; line-height: 1.45; color: #ebefe6; }
  .ucv-uv-en { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; color: #8b9285; margin-top: 4px; }
  .ucv-uv-row { display: flex; align-items: baseline; gap: 12px; padding: 8px 0; border-top: 1px solid rgba(74, 84, 75, 0.6); }
  .ucv-uv-row .l { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; color: #8b9285; flex: none; }
  .ucv-uv-row .r { font-size: 11.5px; line-height: 1.7; color: #e3e8dc; }
  .ucv-uv-chk { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 12px; padding-top: 11px; border-top: 1px solid #4a544b; font-size: 10.5px; color: #bcc3b6; }
  .ucv-uv-chk span::before { content: "✓ "; color: var(--ok); }

  /* ---------- section chrome ---------- */
  .ucv-band { padding: 52px 0 56px; }
  .ucv-band--deep { background: var(--lite-2); }
  .ucv-eye { display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .ucv-h2 { display: block; font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(23px, 2.7vw, 32px); line-height: 1.5; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 18px; word-break: keep-all; }
  .ucv-band-lead { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); max-width: 62ch; margin: 0 0 22px; }
  .ucv-band-lead strong { color: var(--tx); font-weight: 600; }

  /* ---------- §1 personas ---------- */
  .ucv-personas { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 24px 0 0; padding: 0; }
  .ucv-persona { background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); padding: 20px 20px 18px; margin: 0; }
  .ucv-persona-avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--lite-2); color: var(--ok-light); margin-bottom: 12px; }
  .ucv-persona-role { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--ok-ink); margin-bottom: 8px; }
  .ucv-persona-quote { font-size: 13.5px; line-height: 1.85; color: var(--tx-soft); margin: 0; }
  .ucv-audience { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); max-width: 62ch; }

  /* ---------- §2 before/after ---------- */
  .ucv-emph { border-left: 3px solid var(--ok); padding-left: clamp(18px, 3vw, 34px); }
  /* §2 図解 — 枠1枚を細罫で 2〜3 面に割る。以前は照合バンド＋操作画面＋
     検証画面で箱が6つ並び、読む順番が立たなかった。番号で順路を示す。 */
  /* §2 ①照合の図 — 破線の境界で「自社のなか / 相手のところ」を割り、
     原本は内側に留まり、証明だけが境界を越えることを線で見せる。 */
  .ucv-cf { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(150px, 0.7fr) minmax(0, 0.95fr); align-items: center; gap: 0; margin: 26px 0 0; background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); padding: 22px; }
  .ucv-cf-zone { min-width: 0; }
  .ucv-cf-zk { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.16em; color: var(--muted); margin-bottom: 12px; }

  /* 2 つの源 → 合流 → 結果 */
  .ucv-cf-srcs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .ucv-cf-src { border: 1px solid var(--line); border-radius: 9px; padding: 11px 13px 12px; background: var(--lite-2); }
  .ucv-cf-src b { display: block; font-family: var(--font-serif-jp); font-weight: 600; font-size: 13px; line-height: 1.5; color: var(--tx); margin-bottom: 6px; }
  .ucv-cf-src ul { list-style: none; margin: 0; padding: 0; }
  .ucv-cf-src li { font-size: 11.5px; line-height: 1.75; color: var(--tx-soft); }
  /* 合流点。上に細い横罫を渡し、中央から下へ落とす。 */
  .ucv-cf-merge { position: relative; height: 46px; display: grid; place-items: center; }
  .ucv-cf-merge::before { content: ""; position: absolute; left: 25%; right: 25%; top: 11px; height: 1px; background: var(--line); }
  .ucv-cf-merge::after { content: ""; position: absolute; left: 50%; top: 11px; width: 1px; height: 34px; background: var(--line); }
  .ucv-cf-merge span { position: relative; z-index: 2; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--ok-ink); background: rgba(168, 224, 16, 0.16); border: 1px solid rgba(124, 175, 0, 0.4); border-radius: 999px; padding: 4px 14px; }
  .ucv-cf-res { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ucv-cf-res li { position: relative; padding: 8px 12px 8px 32px; border-radius: 8px; background: rgba(168, 224, 16, 0.12); font-family: var(--font-serif-jp); font-weight: 600; font-size: 14px; line-height: 1.6; color: var(--ok-ink); }
  .ucv-cf-res li::before { content: ""; position: absolute; left: 13px; top: 12px; width: 5px; height: 10px; border: solid currentColor; border-width: 0 1.8px 1.8px 0; transform: rotate(42deg); box-sizing: border-box; }

  /* 境界と、そこを越えるもの */
  .ucv-cf-cross { position: relative; display: grid; place-items: center; gap: 7px; padding: 0 14px; align-self: stretch; }
  .ucv-cf-cross::before { content: ""; position: absolute; left: 50%; top: -22px; bottom: -22px; border-left: 1px dashed #b9bfb4; }
  .ucv-cf-cross .chip { position: relative; z-index: 2; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em; color: #1d2a00; background: var(--ok); border-radius: 999px; padding: 5px 12px; text-align: center; }
  .ucv-cf-cross .arw { position: relative; z-index: 2; width: 100%; height: 12px; }
  .ucv-cf-cross .arw i { position: absolute; left: 0; right: 9px; top: 5px; height: 2px; background: var(--ok-light); }
  .ucv-cf-cross .arw s { position: absolute; right: 0; top: 0; width: 0; height: 0; border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 10px solid var(--ok-light); }
  .ucv-cf-cross .note { position: relative; z-index: 2; background: var(--card); padding: 3px 6px; font-size: 10.5px; line-height: 1.6; color: var(--muted); text-align: center; }

  /* 相手のところ */
  .ucv-cf-zone--out { padding-left: 4px; }
  .ucv-cf-verdict { text-align: center; border: 1px solid rgba(124, 175, 0, 0.45); border-radius: 10px; padding: 14px 12px 12px; }
  .ucv-cf-verdict .seal { width: 34px; height: 34px; border-radius: 50%; margin: 0 auto 8px; display: grid; place-items: center; border: 1.4px solid rgba(124, 175, 0, 0.5); background: rgba(168, 224, 16, 0.09); color: var(--ok-ink); }
  .ucv-cf-verdict .t { font-family: var(--font-serif-jp); font-weight: 600; font-size: 13px; color: var(--tx); }
  .ucv-cf-verdict .en { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.16em; color: var(--muted); margin-top: 3px; }
  .ucv-cf-to { display: block; margin-top: 12px; font-family: var(--font-serif-jp); font-weight: 600; font-size: 13px; line-height: 1.55; color: var(--tx); }
  .ucv-cf-tonote { margin: 4px 0 0; font-size: 11.5px; line-height: 1.75; color: var(--tx-soft); }

  /* §2 ②「渡すもの」— チップを並べると新旧が対等に見えるので、帯の長さで
     データの重さの落差そのものを見せる。 */
  .ucv-pay { margin: 20px 0 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--card); }
  .ucv-pay-h { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; color: var(--muted); padding: 11px 18px; background: var(--lite-2); border-bottom: 1px solid var(--line); }
  .ucv-pay-lead { margin: 0; padding: 16px 18px 4px; font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(15px, 1.6vw, 17.5px); line-height: 1.7; letter-spacing: 0.02em; color: var(--tx); }
  .ucv-pay-row { padding: 14px 18px 16px; }
  .ucv-pay-row--now { border-top: 1px solid var(--line); }
  .ucv-pay-row .hd { display: flex; align-items: center; gap: 8px; font-family: var(--font-serif-jp); font-weight: 600; font-size: 14px; line-height: 1.5; }
  .ucv-pay-row .mk { display: grid; place-items: center; width: 17px; height: 17px; border-radius: 50%; font-size: 10px; line-height: 1; flex: none; }
  .ucv-pay-row--was .hd { color: var(--muted); }
  .ucv-pay-row--was .mk { background: #dfe3dc; color: #6b7166; }
  .ucv-pay-row--now .hd { color: var(--tx); }
  .ucv-pay-row--now .mk { background: var(--ok); color: #1d2a00; }
  .ucv-pay-row .dt { margin: 6px 0 0; font-size: 12.5px; line-height: 1.8; }
  .ucv-pay-row--was .dt { color: var(--muted); }
  .ucv-pay-row--now .dt { color: var(--tx-soft); }
  /* 量の帯。従来は目一杯、Lemma はごく短く。 */
  .ucv-pay-row .bar { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .ucv-pay-row .bar span { display: block; height: 10px; border-radius: 3px; min-width: 9px; flex: none; }
  .ucv-pay-row .bar em { font-style: normal; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; white-space: nowrap; }
  .ucv-pay-row--was .bar span { flex: 1; }
  .ucv-pay-row--was .bar span { background: repeating-linear-gradient(90deg, #c3c9bf 0 4px, #d4d9cf 4px 7px); }
  .ucv-pay-row--was .bar em { color: var(--muted); }
  .ucv-pay-row--now .bar span { background: var(--ok); }
  .ucv-pay-row--now .bar em { color: var(--ok-ink); }

  /* §2 ③仕組み — 散文の羅列をやめ、要点 3 つを先に立てる。散文は
     details に畳んで、読みたい人だけが開く。 */
  .ucv-mech { margin: 30px 0 0; }
  .ucv-mech-eye { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.2em; color: var(--ok-light); margin-bottom: 8px; }
  .ucv-mech-h { font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(18px, 2vw, 22px); line-height: 1.6; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 20px; }
  .ucv-mech-pts { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; }
  .ucv-mech-pts li { background: var(--card); border: 1px solid var(--line); border-top: 2px solid var(--ok); border-radius: 2px 2px 11px 11px; box-shadow: var(--sh-s); padding: 18px 18px 20px; }
  .ucv-mech-pts .ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: rgba(168, 224, 16, 0.14); color: var(--ok-ink); margin-bottom: 12px; }
  .ucv-mech-pts .ic svg { width: 19px; height: 19px; }
  .ucv-mech-pts b { display: block; font-family: var(--font-serif-jp); font-weight: 600; font-size: 15.5px; line-height: 1.55; color: var(--tx); margin-bottom: 8px; }
  .ucv-mech-pts p { margin: 0; font-size: 12.5px; line-height: 1.9; color: var(--tx-soft); }

  .ucv-mech-more { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 14px; }
  .ucv-mech-more > summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; color: var(--muted); }
  .ucv-mech-more > summary::-webkit-details-marker { display: none; }
  .ucv-mech-more > summary::before { content: "+"; width: 15px; height: 15px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; font-family: var(--font-body); font-size: 11px; line-height: 1; color: var(--ok-light); }
  .ucv-mech-more[open] > summary::before { content: "−"; }
  .ucv-mech-more > summary:hover { color: var(--tx); }
  .ucv-mech-body { margin: 14px 0 0; font-size: 13.5px; line-height: 1.95; color: var(--tx-soft); max-width: 68ch; }
  .ucv-mech-body :global(p) { margin: 0 0 10px; }
  .ucv-mech-body :global(p:last-child) { margin-bottom: 0; }
  .ucv-info-link { display: inline-block; margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--ok-light); border-bottom: 1px solid rgba(124, 175, 0, 0.35); }
  .ucv-info-link:hover { border-bottom-color: var(--ok-light); }


  /* ---------- §3 table ---------- */
  .ucv-table-wrap { overflow-x: auto; margin: 22px 0 0; }
  .ucv-table { width: 100%; border-collapse: collapse; font-size: 13px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--sh-s); }
  .ucv-table th { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; font-weight: 400; color: var(--muted); text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--dline-2); background: var(--card); }
  .ucv-table th:not(:first-child), .ucv-table td:not(:first-child) { text-align: center; }
  .ucv-table th.why, .ucv-table td.why { text-align: left; font-size: 12px; color: var(--muted); }
  .ucv-table td { padding: 13px 14px; border-bottom: 1px solid var(--line); color: var(--tx-soft); line-height: 1.6; }
  .ucv-table tr:last-child td { border-bottom: none; }
  .ucv-table td.no { color: var(--err); }
  .ucv-table td.ok, .ucv-check { color: var(--ok-light); font-weight: 700; }
  .ucv-table .is-lemma td { background: var(--lite-2); }
  .ucv-table .is-lemma td:first-child { border-left: 3px solid var(--ok); }
  .ucv-lemma-name { font-weight: 600; color: var(--ok-light); }
  .ucv-only { display: inline-block; margin-left: 8px; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; color: #fff; background: var(--ok-light); border-radius: 999px; padding: 2px 8px; vertical-align: middle; }

  /* ---------- §4 HIW（業界ページと同型・スレート帯） ---------- */
  .ucv-band--slate { position: relative; overflow: hidden; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); }
  .ucv-band--slate::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 90% at 88% -20%, rgba(168, 224, 16, 0.16), rgba(168, 224, 16, 0) 62%); }
  .ucv-band--slate > * { position: relative; z-index: 2; }
  .ucv-band--slate .ucv-eye { color: #8b9285; }
  .ucv-band--slate .ucv-h2 { color: #ebefe6; }
  .ucv-hiw { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 26px; }
  .ucv-hiw-step { display: flex; flex-direction: column; gap: 9px; }
  .ucv-hiw-shot { border-radius: 12px; overflow: hidden; background: rgba(255, 255, 255, 0.05); border: 1px solid #4a544b; margin-bottom: 14px; aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 18px; }
  .ucv-hiw-n { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--ok); }
  .ucv-hiw-t { font-family: var(--font-serif-jp); font-weight: 600; font-size: 16px; color: #ebefe6; }
  .ucv-hiw-t::before { content: ""; display: block; width: 22px; height: 2px; border-radius: 2px; background: var(--ok); margin-bottom: 10px; }
  .ucv-hiw-d { font-size: 12.8px; line-height: 1.85; color: #bcc3b6; }
  .ucv-mini { width: 100%; background: var(--card); border: 1px solid var(--line); border-radius: 9px; overflow: hidden; box-shadow: 0 8px 22px rgba(24, 36, 26, 0.1); }
  .ucv-mini-bar { padding: 8px 12px; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; color: var(--muted); }
  .ucv-mini-body { padding: 12px; }
  .ucv-mini-row { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--line); font-size: 11px; line-height: 1.7; }
  .ucv-mini-row:first-child { border-top: none; }
  .ucv-mini-row span { color: var(--muted); flex: none; }
  .ucv-mini-row b { font-weight: 400; color: var(--tx); text-align: right; }
  .ucv-mini-ok { margin-top: 9px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em; color: var(--ok-ink); background: rgba(168, 224, 16, 0.1); border: 1px solid rgba(124, 175, 0, 0.4); border-radius: 99px; padding: 4px 9px; }
  .ucv-mini-verdict { padding: 14px; text-align: center; }
  .ucv-mini-verdict .seal { width: 34px; height: 34px; border-radius: 50%; margin: 2px auto 9px; display: grid; place-items: center; border: 1.4px solid rgba(124, 175, 0, 0.5); background: rgba(168, 224, 16, 0.09); color: var(--ok-ink); }
  .ucv-mini-verdict .t { font-family: var(--font-serif-jp); font-weight: 600; font-size: 13px; color: var(--tx); }
  .ucv-mini-verdict .en { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.16em; color: var(--muted); margin-top: 3px; }
  .ucv-mini-verdict .chk { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 10px; padding-top: 9px; border-top: 1px solid var(--line); font-size: 9px; color: var(--muted); }
  .ucv-band--slate .ucv-steps-note { color: #9ba296; }

  /* ---------- §4 steps ---------- */
  .ucv-steps-body { max-width: 76ch; }
  .ucv-steps-body :global(p) { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); margin: 0 0 14px; }
  .ucv-steps-body :global(ol) { list-style: none; counter-reset: ucstep; margin: 8px 0 0; padding: 0; }
  .ucv-steps-body :global(ol > li) { counter-increment: ucstep; position: relative; padding: 14px 0 14px 46px; border-bottom: 1px solid var(--line); font-size: 13.5px; line-height: 1.8; color: var(--tx-soft); }
  .ucv-steps-body :global(ol > li)::before { content: counter(ucstep, decimal-leading-zero); position: absolute; left: 0; top: 17px; font-family: var(--font-mono); font-size: 11px; color: var(--ok-light); }
  .ucv-steps-body :global(li strong) { color: var(--tx); font-weight: 600; }
  .ucv-steps-body :global(a) { color: var(--ok-light); border-bottom: 1px solid rgba(124, 175, 0, 0.35); }
  .ucv-steps-note { font-size: 12.5px; color: var(--muted); margin: 14px 0 0; }
  .ucv-steps-invite { margin-top: 0; }
  .ucv-steps-invite :global(p) { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); margin: 0; }
  .ucv-cta-card { margin-top: 28px; max-width: 780px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 26px 30px 28px; box-shadow: var(--sh-m); }
  .ucv-cta-card-h { font-family: var(--font-serif-jp); font-weight: 600; font-size: 17px; color: var(--tx); margin: 0 0 8px; }
  .ucv-cta-card .ucv-steps-invite :global(p) { color: var(--tx-soft); font-size: 13.5px; }
  .ucv-cta-card .ucv-uc-cta-btn { margin-top: 18px; }
  .ucv-uc-cta-btn { display: inline-block; text-decoration: none; font-weight: 600; font-size: 14px; border-radius: 6px; padding: 14px 30px; border: 1px solid transparent; transition: 0.18s; letter-spacing: 0.05em; background: var(--ok); color: var(--ink); box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35); }
  .ucv-uc-cta-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }

  /* ---------- §5 related — 行リスト（業務から探すと同一） ---------- */

  /* ---------- closing ---------- */
  .ucv-closing { position: relative; overflow: hidden; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); padding: 72px 0 68px; text-align: center; }
  .ucv-closing::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 90% at 88% -20%, rgba(168, 224, 16, 0.16), rgba(168, 224, 16, 0) 62%); }
  .ucv-closing-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; padding: 0 6vw; }
  .ucv-closing-eyebrow { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.22em; color: #8b9285; margin: 0 0 14px; }
  .ucv-closing-h { font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(24px, 3vw, 34px); line-height: 1.5; letter-spacing: 0.03em; color: #ebefe6; margin: 0 0 14px; word-break: keep-all; }
  .ucv-closing-h .accent { color: var(--ok); }
  .ucv-closing-sub { font-size: 13.5px; line-height: 2; color: #bcc3b6; margin: 0 0 26px; }
  .ucv-closing-ctas { display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .ucv-closing-pill { display: inline-block; text-decoration: none; font-weight: 600; font-size: 14px; border-radius: 6px; padding: 14px 30px; letter-spacing: 0.05em; background: var(--ok); color: var(--ink); box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35); transition: 0.18s; }
  .ucv-closing-pill:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .ucv-closing-link { background: none; border: none; cursor: pointer; font-family: var(--font-body); font-size: 13px; letter-spacing: 0.04em; color: #bcc3b6; border-bottom: 1px solid rgba(168, 224, 16, 0.35); padding: 0 0 2px; transition: 0.18s; }
  .ucv-closing-link:hover { color: var(--ok); }


  /* ---------- responsive ---------- */
  @media (max-width: 1020px) {
    .ucv-cf { grid-template-columns: 1fr; }
    .ucv-cf-cross { padding: 16px 0; }
    .ucv-cf-cross::before { left: 0; right: 0; top: 50%; bottom: auto; border-left: none; border-top: 1px dashed #b9bfb4; }
    .ucv-cf-cross .arw { width: 12px; height: 30px; justify-self: center; }
    .ucv-cf-cross .arw i { left: 5px; right: auto; top: 0; bottom: 9px; width: 2px; height: auto; }
    .ucv-cf-cross .arw s { right: auto; left: 0; top: auto; bottom: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 10px solid var(--ok-light); border-bottom: none; }
    .ucv-cf-zone--out { padding-left: 0; }
