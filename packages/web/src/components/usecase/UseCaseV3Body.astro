---
/**
 * Use Case detail — v3 body (JA only).
 *
 * Renders the compressed 5-section v3 page (see config/useCaseV3.ts and the
 * v3 PR spec). Only invoked when the slug has a v3 config entry AND the
 * locale is JA; every other surface keeps the long-form template.
 *
 * Structure:
 *   Hero            breadcrumb · pillar tag · H1 · HIDE→PROVE · lead · meta
 *   Credibility     ink-dark full-bleed strip (common across all UCs)
 *   §1 推進担当の声  cream-deep · 3 persona cards (from v3 config)
 *   §2 変化         cream · emphasized · Before/After + approach callout
 *   §3 選定基準      cream-deep · common 4-row comparison table
 *   §4 進め方        cream · existing "next" markdown (ORIGINAL numbered list)
 *   §5 関連          cream-deep · related cards → Solutions bridge → final CTA
 *
 * Crypto scheme names stay out of the body; the §2 callout links to /guides
 * for the technical reader. The final CTA drops the Critical Brief link.
 */
import type { UseCase } from "../../data/useCases";
import type { Pillar } from "../../data/pillars";
import type { HideProvePair } from "../../config/useCaseHideProve";
import type { UseCaseV3 } from "../../config/useCaseV3";
import SolutionsBridge from "../SolutionsBridge.astro";
import { DISCOVERY_CALL_URL } from "../../config/cta";

export interface UseCaseV3BodyProps {
  base: string;
  useCase: UseCase;
  pillar: Pillar;
  useCaseTitle: string;
  relatedUseCases: ReadonlyArray<UseCase>;
  hideProve: HideProvePair | undefined;
  /** Authored hooks (§1 personas + §2 Before/After). Undefined for UCs that
   * are rendered in derived mode — §1 falls back to the audience section and
   * §2 to the approach section, with no Before/After cards. */
  v3: UseCaseV3 | undefined;
  ucBridgeHref: string;
  ucBridgeCta: string;
}

const {
  base,
  useCase,
  pillar,
  useCaseTitle,
  relatedUseCases,
  hideProve,
  v3,
  ucBridgeHref,
  ucBridgeCta,
} = Astro.props as UseCaseV3BodyProps;

const useCasesPath = `${base}/solutions/use-cases`;
const pillarsPath = `${base}/pillars`;
const guidesHref = `${base}/guides`;
// v3 is JA only, so the closing books the JA Discovery Call.
const discoveryUrl = DISCOVERY_CALL_URL.ja;

// §4 / §5 reuse the existing markdown sections by key.
// The 進め方 section is "next" on ai-document-isolation (a 5-step list) but
// "cta" on the other 7 UCs (a Discovery-led prose section). Fall back so §4
// renders on all of them.
const nextSection =
  useCase.sections.find((s) => s.key === "next") ??
  useCase.sections.find((s) => s.key === "cta");
// For the "cta" variant keep only the first paragraph — a modest, use-case-
// matched invitation ("…御社の構造を聞かせてください。…開示は必要ありません。"),
// at the level of ai-document-isolation's closing line. The follow-up
// paragraph (NDA 締結・規制マッピング・参照アーキテクチャ・PoC 設計) over-claims
// for this surface, and the trailing link row duplicates the TALK button.
const nextBody = (() => {
  if (!nextSection) return "";
  if (nextSection.key !== "cta") return nextSection.body;
  const firstPara = nextSection.body.match(/<p>[\s\S]*?<\/p>/);
  return firstPara ? firstPara[0] : nextSection.body;
})();
// Normalize the §4 heading to 「進め方」 — the "cta" section title is a
// Discovery-Call headline that reads oddly here; ai-document-isolation's is
// already "進め方".
const nextTitle =
  nextSection && nextSection.key === "next" ? nextSection.title : "進め方";
const relatedSection = useCase.sections.find((s) => s.key === "related");

// ── Authored vs derived mode ──────────────────────────────────────────
// UCs with a v3 config entry render authored §1 persona quotes + §2
// Before/After cards. The rest derive §1 from the audience section and §2
// from the approach section (no fabricated Before/After data).
const authored = !!v3;
const audienceSection = useCase.sections.find((s) => s.key === "audience");
const approachSection = useCase.sections.find((s) => s.key === "approach");

// Derived §2 approach text: strip crypto scheme names so the body stays
// jargon-light (the v3 surface hides scheme names; spec link covers depth).
function stripSchemes(html: string): string {
  return html
    .replace(
      /(?:BBS\+|Poseidon|Groth16|Circom|PLONK)(?:\s*over\s*(?:BLS12-?381|BN254|[A-Za-z0-9-]+))?(?:\s*回路)?\s*(?:で|を|により|の|上で)?/g,
      "",
    )
    .replace(/AES-?GCM\s*(?:で|を|により)?/g, "")
    .replace(/\(\s*CID\s*\)/g, "")
    .replace(/\(\s*Circ[^)]*\)/g, "")
    .replace(/（\s*）/g, "")
    .replace(/、\s*、/g, "、")
    .replace(/\s{2,}/g, " ");
}
const approachBody = approachSection ? stripSchemes(approachSection.body) : "";

// Derived §1: the audience section is an intro paragraph + a short bullet
// list. Render the bullets as persona-style cards for visual parity with the
// authored persona quotes.
const audienceHtml = audienceSection?.body ?? "";
const audienceIntro = audienceHtml.match(/<p>([\s\S]*?)<\/p>/)?.[1]?.trim() ?? "";
const audienceBullets = [...audienceHtml.matchAll(/<li>([\s\S]*?)<\/li>/g)].map((m) =>
  m[1].trim(),
);
// Derived §2 carries the HIDE→PROVE pair as the Before/After visual, so the
// hero device is dropped on derived pages (it would otherwise repeat).
const showHeroHp = !!hideProve && authored;
const showDerivedBa = !authored && !!hideProve;

/** Trim an abstract to its first sentence for related cards. */
function firstSentence(text: string): string {
  const m = text.match(/^([^。.!?！？]+[。.!?！？])/);
  return (m?.[1] ?? text).trim();
}
---

<main class="ucv-page">
  <div class="ucv-container">
    <nav class="ucv-breadcrumb" aria-label="breadcrumb">
      <a href={base || "/"}>ホーム</a>
      <span class="ucv-bc-sep">/</span>
      <a href={useCasesPath}>活用シーン</a>
      <span class="ucv-bc-sep">/</span>
      <span>{useCaseTitle}</span>
    </nav>

    <header class="ucv-hero">
      <a class="ucv-pillar-tag" href={`${pillarsPath}/${pillar.slug}`}>
        <span class="ucv-pillar-dot" aria-hidden="true"></span>
        P{pillar.order} · {pillar.title.ja}
      </a>
      <h1 class="ucv-h1">{useCase.title}</h1>

      {showHeroHp && (
        <div class="ucv-hp" aria-label="HIDE と PROVE の対比">
          <div class="ucv-hp__cell ucv-hp__cell--hide">
            <span class="ucv-hp__lab">Hide ── 隠す</span>
            <span class="ucv-hp__val">{hideProve.hide}</span>
          </div>
          <div class="ucv-hp__arrow" aria-hidden="true">→</div>
          <div class="ucv-hp__cell ucv-hp__cell--prove">
            <span class="ucv-hp__lab">Prove ── 証明する</span>
            <span class="ucv-hp__val">{hideProve.prove}</span>
          </div>
        </div>
      )}

      <p class="ucv-lead">{useCase.abstract}</p>

      <div class="ucv-meta">
        {useCase.targetVerticals.length > 0 && (
          <span class="ucv-verticals">{useCase.targetVerticals.join(" · ")}</span>
        )}
        <span class="ucv-rt">{useCase.readingTime} 分</span>
      </div>
    </header>
  </div>

  <!-- Credibility strip — full-bleed ink dark, common across all UCs. -->
  <div class="ucv-cred">
    <div class="ucv-cred-inner">
      <span class="ucv-cred-dot" aria-hidden="true"></span>
      <span><b>live in production since 2025</b> · 公共インフラ PoC 稼働中 · ETHGlobal AI Agents 2026 Finalist</span>
    </div>
  </div>

  <!-- §1 — authored persona quotes, or derived from the audience section. -->
  {(v3 || audienceSection) && (
    <section class="ucv-band ucv-band--deep" aria-label="読者">
      <div class="ucv-container">
        {v3 ? (
          <Fragment>
            <div class="ucv-eye">01 · 課題認識</div>
            <h2 class="ucv-h2">推進担当の、3 つの声。</h2>
            <ul class="ucv-personas">
              {v3.personas.map((p) => (
                <li class="ucv-persona">
                  <div class="ucv-persona-avatar" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="8" r="4" fill="currentColor" />
                      <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                    </svg>
                  </div>
                  <div class="ucv-persona-role">{p.role}</div>
                  <p class="ucv-persona-quote">「{p.quote}」</p>
                </li>
              ))}
            </ul>
          </Fragment>
        ) : audienceSection && (
          <Fragment>
            <div class="ucv-eye">01 · 想定読者</div>
            <h2 class="ucv-h2">このページは、こんな方のために。</h2>
            {audienceIntro && <p class="ucv-band-lead" set:html={audienceIntro} />}
            {audienceBullets.length > 0 ? (
              <ul class="ucv-personas">
                {audienceBullets.map((b) => (
                  <li class="ucv-persona">
                    <div class="ucv-persona-avatar" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4" fill="currentColor" />
                        <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                      </svg>
                    </div>
                    <p class="ucv-persona-quote" set:html={b} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="ucv-audience ucv-steps-body" set:html={audienceSection.body} />
            )}
          </Fragment>
        )}
      </div>
    </section>
  )}

  <!-- §2 — authored Before/After cards, or derived approach. -->
  {(v3 || approachSection) && (
    <section class="ucv-band" aria-label="アプローチ">
      <div class="ucv-container">
        <div class="ucv-emph">
          <div class="ucv-eye">{v3 || showDerivedBa ? "02 · 変化" : "02 · アプローチ"}</div>
          <h2 class="ucv-h2">原本を渡すか、事実だけを渡すか。</h2>

          {showDerivedBa && hideProve && (
            <div class="ucv-ba ucv-ba--concept">
              <div class="ucv-ba-card ucv-ba-card--before">
                <div class="ucv-ba-label">Without Lemma</div>
                <div class="ucv-ba-title">原本・中身をそのまま渡す</div>
                <p class="ucv-ba-claim">{hideProve.hide}</p>
                <div class="ucv-ba-flow">↓ すべて外部・AI へ渡る</div>
              </div>

              <div class="ucv-ba-arrow" aria-hidden="true">→</div>

              <div class="ucv-ba-card ucv-ba-card--after">
                <div class="ucv-ba-label">With Lemma</div>
                <div class="ucv-ba-title">事実だけを証明付きで渡す</div>
                <p class="ucv-ba-claim ucv-ba-claim--prove">{hideProve.prove}</p>
                <div><span class="ucv-ba-badge">✓ ZK VALID</span></div>
                <div class="ucv-ba-flow ucv-ba-flow--after">↓ 必要な事実だけ</div>
              </div>
            </div>
          )}

          {v3 && (
            <Fragment>
              <p class="ucv-band-lead">AI に渡すものが変われば、漏洩のリスクごと消える。</p>
              <div class="ucv-ba">
                <div class="ucv-ba-card ucv-ba-card--before">
                  <div class="ucv-ba-label">Without Lemma</div>
                  <div class="ucv-ba-title">原本をそのまま渡す</div>
                  <dl class="ucv-ba-rows">
                    {v3.without.map((row) => (
                      <div class="ucv-ba-row">
                        <dt>{row.k}:</dt>
                        <dd>{row.v}</dd>
                      </div>
                    ))}
                  </dl>
                  <div class="ucv-ba-flow">↓ すべて AI・外部へ渡る</div>
                </div>

                <div class="ucv-ba-arrow" aria-hidden="true">→</div>

                <div class="ucv-ba-card ucv-ba-card--after">
                  <div class="ucv-ba-label">With Lemma</div>
                  <div class="ucv-ba-title">事実だけを渡す</div>
                  <dl class="ucv-ba-rows">
                    {v3.withProof.map((row) => (
                      <div class={`ucv-ba-row${row.strong || row.badge ? " is-key" : ""}`}>
                        <dt>{row.k}:</dt>
                        <dd>
                          {row.badge ? (
                            <span class="ucv-ba-badge">{row.v}</span>
                          ) : (
                            <span class={row.strong ? "ucv-ba-strong" : ""}>{row.v}</span>
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  <div class="ucv-ba-flow ucv-ba-flow--after">↓ 必要な事実だけ AI へ渡る</div>
                </div>
              </div>
            </Fragment>
          )}

          <div class="ucv-approach">
            {v3 ? (
              <p>{v3.approach}</p>
            ) : (
              <div class="ucv-approach-body" set:html={approachBody} />
            )}
            <a class="ucv-approach-link" href={guidesHref}>技術詳細を見る ↗</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- §3 選定基準 — common comparison table -->
  <section class="ucv-band ucv-band--deep" aria-label="選定基準">
    <div class="ucv-container">
      <div class="ucv-eye">03 · 選定基準</div>
      <h2 class="ucv-h2">3 つの基準で、選ぶ。</h2>
      <p class="ucv-band-lead">
        「中身を出さず渡す」「独立検証」「改ざん不能」の<strong>3 つが同時に要る</strong>業務こそが Lemma の領域です。
      </p>
      <div class="ucv-table-wrap">
        <table class="ucv-table">
          <thead>
            <tr>
              <th>手段</th>
              <th>中身を出さず渡す</th>
              <th>独立検証</th>
              <th>改ざん不能</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>アクセス制御のみ</td><td>△</td><td class="no">✗</td><td class="no">✗</td></tr>
            <tr><td>マスキング / 匿名化</td><td>△</td><td class="no">✗</td><td class="no">✗</td></tr>
            <tr><td>暗号化のみ</td><td class="ok">✓</td><td class="no">✗</td><td class="no">✗</td></tr>
            <tr class="is-lemma">
              <td><span class="ucv-lemma-name">Lemma（ZK 証明）</span><span class="ucv-only">唯一 3 つ揃う</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- §4 進め方 — existing markdown (ORIGINAL numbered list) -->
  {nextSection && (
    <section class="ucv-band" aria-label="進め方">
      <div class="ucv-container">
        <div class="ucv-eye">04 · 進め方</div>
        <h2 class="ucv-h2">{nextTitle}</h2>
        <div class="ucv-steps-body" set:html={nextBody} />
        <!-- UC-specific TALK CTA — books the same Discovery Call form, but
             tags the submission with this use case's slug (?uc=) for per-UC
             attribution. The §5 Solutions bridge stays the EXPLORE path. -->
        <div class="ucv-uc-cta">
          <a class="ucv-uc-cta-btn" href={`https://tally.so/r/EkBqDX?uc=${useCase.slug}`} target="_blank" rel="noopener">
            このユースケースについて、問い合わせる →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- §5 関連ユースケース -->
  <section class="ucv-band ucv-band--deep" aria-label="関連ユースケース">
    <div class="ucv-container">
      <div class="ucv-eye">05 · 関連ユースケース</div>
      <h2 class="ucv-h2">{relatedSection?.title ?? "関連ユースケース"}</h2>
      {relatedUseCases.length > 0 && (
        <ul class="ucv-related">
          {relatedUseCases.map((r) => (
            <li>
              <a class="ucv-related-card" href={`${useCasesPath}/${r.slug}`}>
                <span class="ucv-related-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <line x1="9" y1="8" x2="15" y2="8" />
                    <line x1="9" y1="12" x2="15" y2="12" />
                    <line x1="9" y1="16" x2="13" y2="16" />
                  </svg>
                </span>
                <h3 class="ucv-related-title">{r.title}</h3>
                <p class="ucv-related-abstract">{firstSentence(r.abstract)}</p>
                <span class="ucv-related-cta">ユースケースを見る →</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <SolutionsBridge
    href={ucBridgeHref}
    eyebrow="より広い活用シーン"
    h2="このユースケースを含む、活用シーンの全体像。"
    sub="業界・業務領域ごとの活用シーンと、4 つの軸で整理しています。"
    ctaLabel={ucBridgeCta}
  />

  <!-- Closing — Discovery Call (mirrors the TOP / Solutions dark closing). -->
  <section class="ucv-closing" aria-label="Discovery Call">
    <div class="ucv-closing-inner">
      <p class="ucv-closing-eyebrow">DISCOVERY CALL</p>
      <h2 class="ucv-closing-h">まずは、<span class="accent">30 分の対話</span>から。</h2>
      <p class="ucv-closing-sub">Lemma の機能や活用場面について、ご質問にお答えします。技術的な詳細や機微情報の開示は不要です。</p>
      <div class="ucv-closing-ctas">
        <a href={discoveryUrl} class="ucv-closing-pill" target="_blank" rel="noopener">Discovery Call を予約 →</a>
        <button type="button" class="ucv-closing-link" data-tally-open="xX0VYv" data-tally-emoji-text="">ホワイトペーパー DL →</button>
      </div>
    </div>
  </section>
</main>

<style>
  .ucv-page {
    --ucv-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --ucv-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --ucv-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ucv-text-1: #1a1a1a;
    --ucv-text-2: #3a3a3a;
    --ucv-text-3: #5a5a5a;
    --ucv-text-4: #9a9a9a;
    --ucv-green: #5C7A4A;

    background: var(--lemma-cream);
    color: var(--ucv-text-2);
    font-family: var(--ucv-body);
    font-weight: 400;
    line-height: 1.75;
    margin-top: 64px;
    /* No bottom padding — the dark closing band sits flush against the
       footer (any padding here shows as a cream strip above it). */
    padding: 0;
  }

  .ucv-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── BREADCRUMB ─── */
  .ucv-breadcrumb {
    font-family: var(--ucv-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ucv-text-4);
    padding: 36px 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .ucv-breadcrumb a {
    color: var(--ucv-text-3);
    transition: color 0.15s;
  }
  .ucv-breadcrumb a:hover { color: var(--accent); }
  .ucv-bc-sep { color: var(--lemma-line); margin: 0 8px; }

  /* ─── HERO ─── */
  .ucv-hero {
    padding: 28px 0 44px;
    max-width: 820px;
  }
  .ucv-pillar-tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--ucv-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
    transition: color 0.15s;
  }
  .ucv-pillar-tag:hover { color: #6e3610; }
  .ucv-pillar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .ucv-h1 {
    font-family: var(--ucv-display);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0 0 24px;
  }
  .ucv-lead {
    font-size: 16px;
    color: var(--ucv-text-1);
    line-height: 1.9;
    margin: 24px 0 24px;
    max-width: 720px;
    padding: 2px 0 2px 16px;
    border-left: 2px solid var(--accent);
  }
  .ucv-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--ucv-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ucv-text-4);
  }
  .ucv-verticals { color: var(--ucv-text-3); }
  .ucv-rt::before {
    content: "·";
    margin-right: 12px;
    color: var(--lemma-line);
  }

  /* HIDE → PROVE device (live format — 2 cells + arrow). */
  .ucv-hp {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    margin: 0 0 8px;
    max-width: 720px;
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
  }
  .ucv-hp__cell {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .ucv-hp__cell--hide { background: var(--lemma-cream-deep); }
  .ucv-hp__lab {
    font-family: var(--ucv-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .ucv-hp__cell--hide .ucv-hp__lab { color: var(--ucv-text-3); }
