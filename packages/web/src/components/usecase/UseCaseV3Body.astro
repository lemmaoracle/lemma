        { a: "自社", t: "証明する記録を決める", d: "提出のたびに説明や照会が生まれている記録・フローを、まず1つ選びます。" },
        { a: "自社 → 相手", t: "発行を組み込む", d: "記録が確定した時点で API を1回呼びます。記録の本文は送りません。" },
        { a: "相手・第三者", t: "相手が確かめる", d: "受け取った側はリンクを開くだけ。アカウントもキーも要りません。" },
