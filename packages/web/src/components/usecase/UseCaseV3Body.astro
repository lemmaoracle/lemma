      hiwDocLab: "記録の本文", hiwDocVal: "送信されません", hiwIssued: "発行しました　0x68d4…9f01",
      hiw3Bar: "受け取った側の画面", hiwVerdict: "改ざんされていません",
      hiwChk1: "署名の一致", hiwChk2: "改ざんの有無", hiwChk3: "発行者",
      s5H2: "関連ユースケース",
    }
  : {
      bcHome: "Home", bcUC: "Use Cases", readUnit: "min read",
      credMid: "Public-infrastructure PoC in production",
      hpAria: "HIDE versus PROVE", hpHide: "Hide", hpProve: "Prove",
      ariaReaders: "The problem", ariaApproach: "The shift", ariaCriteria: "How to choose",
      ariaSteps: "How it works", ariaRelated: "Related use cases",
      s1Eye: "01 · WHO IT'S FOR", s1H2: "Who this is for.",
      s1AuthEye: "01 · THE PROBLEM", s1AuthH2: "Three voices from the front line.",
      s2EyeShift: "02 · THE SHIFT", s2EyeApproach: "02 · APPROACH",
      s2H2: "Hand over the source, or just the facts?",
      s2Lead: "Change what reaches the AI, and the leakage risk goes with it.",
      s2Catch: "Nothing changes on the floor. Everything changes for the receiver.",
      s2OpBar: "Your team's screen — the system you already use",
      s2OpRow1: "The usual action", s2OpRow1v: "Enter the record, hit save",
      s2OpRow2: "On save", s2OpRow2v: "a proof is attached (one API call behind the scenes)",
      s2OpRow3: "The document", s2OpRow3v: "never sent",
      s2OpCap: "Your team just saves, as always.",
      s2Link: "Proof link",
      s2VfBar: "Their browser — the verification screen",
      s2AfterFact: "Proven fact", s2VfHidden: "not shown",
      s2VfKey: "Login / keys", s2VfKeyVal: "not needed",
      s2VfCap: "They just open a link.",
      baBeforeTitle: "Hand over the raw source", baAfterTitle: "Share only the proven facts",
      baFlowBefore: "↓ all of it reaches the AI / outside", baFlowAfter: "↓ only the necessary facts",
      baDataBeforeTitle: "Hand over the original", baDataAfterTitle: "Hand over just the facts",
      baDataFlowBefore: "↓ all of it goes to the AI / outside", baDataFlowAfter: "↓ only the necessary facts to the AI",
      approachLink: "See the technical details ↗",
      s3Eye: "03 · HOW TO CHOOSE", s3H2: "Why the usual methods fall short.",
      s3Lead: "Only work that needs all three at once — pass without exposing, independent verification, tamper-evidence — is Lemma's domain.",
      thMethod: "Method", thPass: "Pass without exposing", thVerify: "Independent verification", thTamper: "Tamper-evident",
      rowAccess: "Access control / permissions", rowMask: "Masking / redacted copies", rowEnc: "Encrypt and store / send",
      thWhy: "What happens",
      rowAccessWhy: "\u201CSomeone inside could have edited it\u201D remains possible",
      rowMaskWhy: "Redaction work grows; the original is still unproven",
      rowEncWhy: "To verify, the receiver needs it disclosed after all",
      rowExtraWhy: "Detection only — the receiver still cannot verify independently",
      rowLemmaWhy: "The receiver just opens a link",
      lemmaName: "Lemma (ZK proof)", onlyTag: "the only one with all 3",
      s4Eye: "04 · HOW IT WORKS", s4Title: "How it works — and how to start.",
      ctaCardH: "Start with a 30-minute call.",
      s4Steps: [
        { a: "you", t: "Choose the record to prove", d: "Start with the one flow where hand-offs cost you the most explaining." },
        { a: "you → them", t: "Add issuance", d: "Call the API once when the record is finalized. The document itself is never sent." },
        { a: "them", t: "Let the receiver verify", d: "They open a link — no account, no keys." },
      ],
      s4Note: "We help design disclosure scope and retention, run the PoC, and support production.",
      hiw1Bar: "What you prove", hiwProveLab: "Prove", hiwHideLab: "Keep hidden",
      hiw2Bar: "Issue the proof", hiwSentLab: "Sent", hiwSentVal: "hash only",
      hiwDocLab: "The document", hiwDocVal: "never sent", hiwIssued: "Issued 0x68d4…9f01",
      hiw3Bar: "The verifier's screen", hiwVerdict: "Not tampered",
      hiwChk1: "Signature", hiwChk2: "Integrity", hiwChk3: "Issuer",
      s5H2: "Related use cases",
    };

// スラッグ単位のコピー上書き（config/useCaseCopyOverride.ts）。登録の無い UC は
// 空オブジェクトが返るので、共有コピーがそのまま出る。
const C = { ...BASE_C, ...getUseCaseCopyOverride(useCase.slug, locale) } as typeof BASE_C;

// §2 冒頭の照合バンド（config/useCaseCollation.ts）。登録のある UC にだけ出る。
const collation = getUseCaseCollation(useCase.slug, locale);

const useCasesPath = `${base}/solutions/use-cases`;
const pillarsPath = `${base}/pillars`;
// 柱の配下ページは /pillars のタブへ統合 (製品ページ移行 v2.7 §5.4)
const PILLAR_ANCHOR: Record<string, string> = {
  "verifiable-origin": "#provenance",
  "agent-authority-proof": "#authority",
  "verifiable-ai": "#inference",
  "regulatory-attribute-proof": "#attribute",
};


// 対応プラン — links to the matching plan page. DRAFT map in useCasePlanMap.ts.
const planKey = USE_CASE_PLAN[useCase.slug];
const planName: Readonly<Record<string, string>> = {
  civic: "Lemma Civic",
  critical: "Lemma Critical",
  compliance: "Lemma Compliance",
};
const faqHref = `${base}/faq/`;

// §4 / §5 reuse the existing markdown sections by key.
// The 進め方 section is "next" on ai-document-isolation (a 5-step list) but
// "cta" on the other 7 UCs (a Discovery-led prose section). Fall back so §4
// renders on all of them.
const nextSection =
  useCase.sections.find((s) => s.key === "next") ??
  useCase.sections.find((s) => s.key === "cta");
// For the "cta" variant keep only the first paragraph — a modest, use-case-
// matched invitation ("…御社の構造を聞かせてください。…開示は必要ありません。"),
// at the level of ai-document-isolation's closing line. The follow-up
// paragraph (NDA 締結・規制マッピング・参照アーキテクチャ・PoC 設計) over-claims
// for this surface, and the trailing link row duplicates the TALK button.
// §4 の「個別の一行」— cta 変種は先頭の控えめな誘い文、next 変種（ol 主体）は
// 末尾の締め段落を使う。どちらも無ければ共通3ステップ＋補足のみで閉じる。
const invite = (() => {
  if (!nextSection) return "";
  const paras = nextSection.body.match(/<p>[\s\S]*?<\/p>/g) ?? [];
  if (paras.length === 0) return "";
  return nextSection.key === "cta" ? paras[0] : paras[paras.length - 1];
})();
const relatedSection = useCase.sections.find((s) => s.key === "related");

// ── Authored vs derived mode ──────────────────────────────────────────
// UCs with a v3 config entry render authored §1 persona quotes + §2
// Before/After cards. The rest derive §1 from the audience section and §2
// from the approach section (no fabricated Before/After data).
const authored = !!v3;
const audienceSection = useCase.sections.find((s) => s.key === "audience");
const approachSection = useCase.sections.find((s) => s.key === "approach");

// Derived §2 approach text: strip crypto scheme names so the body stays
// jargon-light (the v3 surface hides scheme names; spec link covers depth).
function stripSchemes(html: string): string {
  return html
    .replace(
      /(?:BBS\+|Poseidon|Groth16|Circom|PLONK)(?:\s*over\s*(?:BLS12-?381|BN254|[A-Za-z0-9-]+))?(?:\s*回路)?\s*(?:で|を|により|の|上で)?/g,
      "",
    )
    .replace(/AES-?GCM\s*(?:で|を|により)?/g, "")
    .replace(/\(\s*CID\s*\)/g, "")
    .replace(/\(\s*Circ[^)]*\)/g, "")
    .replace(/（\s*）/g, "")
    .replace(/、\s*、/g, "、")
    .replace(/\s{2,}/g, " ");
}
const approachBody = approachSection ? stripSchemes(approachSection.body) : "";

// Derived §1: the audience section is an intro paragraph + a short bullet
// list. Render the bullets as persona-style cards for visual parity with the
// authored persona quotes.
const audienceHtml = audienceSection?.body ?? "";
const audienceIntro = audienceHtml.match(/<p>([\s\S]*?)<\/p>/)?.[1]?.trim() ?? "";
const audienceBullets = [...audienceHtml.matchAll(/<li>([\s\S]*?)<\/li>/g)].map((m) =>
  m[1].trim(),
);

/** Trim an abstract to its first sentence for related cards. */
function firstSentence(text: string): string {
  const m = text.match(/^([^。.!?！？]+[。.!?！？])/);
  return (m?.[1] ?? text).trim();
}
// 「業務から探す」— §5 関連カードに出した slug は除外して重複を避ける。
const bytaskMembers = taskGroupMembers.filter(
  (m) => !relatedUseCases.some((r) => r.slug === m.slug),
);
---

<main class="ucv-page">
  <div class="ucv-container">
    <nav class="ucv-breadcrumb" aria-label="breadcrumb">
      <a href={base || "/"}>{C.bcHome}</a>
      <span class="ucv-bc-sep">/</span>
      <a href={useCasesPath}>{C.bcUC}</a>
      <span class="ucv-bc-sep">/</span>
      <span>{useCase.title}</span>
    </nav>

    <header class="ucv-hero">
      <div class="ucv-hero-tx">
        <div class="ucv-uc-label">{isJa ? "業務ユースケース" : "Use case"}{pillar && ` — ${pillar.title[locale]}`}</div>
        <h1 class="ucv-h1">{useCase.title}</h1>
        <p class="ucv-lead">{useCase.abstract}</p>

        <div class="ucv-meta">
          {useCase.targetVerticals.length > 0 && (
            <span class="ucv-verticals">{useCase.targetVerticals.join(" · ")}</span>
          )}
          {planKey && (
            <a class="ucv-plan" href={SEGMENT_URLS[planKey][locale]}>{isJa ? "対応プラン" : "Plan"} <b>{planName[planKey]}</b></a>
          )}
        </div>
        <div class="ucv-hero-ctas">
          <a class="ucv-btn ucv-btn--primary" href={isJa ? `https://tally.so/r/EkBqDX?uc=${useCase.slug}` : `https://tally.so/r/Pd2Rl5?uc=${useCase.slug}`} target="_blank" rel="noopener">{isJa ? "このユースケースについて、問い合わせる" : "Talk to us about this use case"}</a>
          <a class="ucv-btn ucv-btn--ghost" href={`${base}/verify/`}>{isJa ? "証明を1件、検証してみる" : "Verify a proof"}</a>
        </div>
      </div>

      {/* 受け取った側の見え方 — 汎用の検証画面カード（データはラベルのみ。
          開示された事実は HIDE→PROVE の prove 文をそのまま使う）。 */}
      <div class="ucv-ui" aria-hidden="true">
        <div class="ucv-ui-bar"><span class="ucv-ui-dot"></span><span class="ucv-ui-dot"></span><span class="ucv-ui-dot"></span>
          <span class="ucv-ui-url">{isJa ? "受け取った側の検証画面" : "The verifier's screen"}</span></div>
        <div class="ucv-ui-body">
          <div class="ucv-uv-head">
            <span class="ucv-uv-seal">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div><div class="ucv-uv-t">{isJa ? "改ざんされていません" : "Not tampered"}</div>{isJa && <div class="ucv-uv-en">NOT TAMPERED</div>}</div>
          </div>
          {hideProve && (
            <div class="ucv-uv-row"><span class="l">{C.s2AfterFact}</span><span class="r">{hideProve.prove}</span></div>
          )}
          <div class="ucv-uv-row"><span class="l">{isJa ? "発行元への照会" : "Issuer round-trip"}</span><span class="r">{isJa ? "不要" : "Not needed"}</span></div>
          <div class="ucv-uv-row"><span class="l">{isJa ? "証明のサイズ" : "Proof size"}</span><span class="r">{isJa ? "約200バイト" : "~200 bytes"}</span></div>
          <div class="ucv-uv-chk">
            <span>{isJa ? "署名の一致" : "Signature"}</span>
            <span>{isJa ? "改ざんの有無" : "Integrity"}</span>
            <span>{isJa ? "発行者の確認" : "Issuer"}</span>
          </div>
        </div>
      </div>
    </header>
  </div>

  <!-- §1 — authored persona quotes, or derived from the audience section. -->
  {(v3 || audienceSection) && (
    <section class="ucv-band ucv-band--deep" aria-label={C.ariaReaders}>
      <div class="ucv-container">
        {v3 ? (
          <Fragment>
            <div class="ucv-eye">{C.s1AuthEye}</div>
            <h2 class="ucv-h2">{C.s1AuthH2}</h2>
            <ul class="ucv-personas">
              {v3.personas.map((p) => (
                <li class="ucv-persona">
                  <div class="ucv-persona-avatar" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="8" r="4" fill="currentColor" />
                      <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                    </svg>
                  </div>
                  <div class="ucv-persona-role">{p.role[locale]}</div>
                  <p class="ucv-persona-quote">{isJa ? `「${p.quote.ja}」` : `“${p.quote.en}”`}</p>
                </li>
              ))}
            </ul>
          </Fragment>
        ) : audienceSection && (
          <Fragment>
            <div class="ucv-eye">{C.s1Eye}</div>
            <h2 class="ucv-h2">{audienceSection.title || C.s1H2}</h2>
            {audienceIntro && <p class="ucv-band-lead" set:html={audienceIntro} />}
            {audienceBullets.length > 0 ? (
              <ul class="ucv-personas">
                {audienceBullets.slice(0, 3).map((b) => (
                  <li class="ucv-persona">
                    <div class="ucv-persona-avatar" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4" fill="currentColor" />
                        <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                      </svg>
                    </div>
                    <p class="ucv-persona-quote" set:html={b} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="ucv-audience ucv-steps-body" set:html={audienceSection.body} />
            )}
          </Fragment>
        )}
      </div>
    </section>
  )}

  <!-- §2 — authored Before/After cards, or derived approach. -->
  {(v3 || approachSection) && (
    <section class="ucv-band" aria-label={C.ariaApproach}>
      <div class="ucv-container">
        <div class="ucv-emph">
          <div class="ucv-eye">{C.s2EyeShift}</div>
          <h2 class="ucv-h2">{C.s2H2}</h2>

          <p class="ucv-band-lead">{C.s2Catch}</p>
          {collation && (
            <div class="ucv-col">
              <div class="ucv-col-grid">
                <div class="ucv-col-card">
                  <div class="ucv-col-bar">{collation.aLabel}</div>
                  <ul class="ucv-col-list">
                    {collation.aItems.map((i) => <li>{i}</li>)}
                  </ul>
                </div>
                <div class="ucv-col-op" aria-hidden="true">
                  <span class="mk">×</span>
                  <span class="lab">{collation.opLabel}</span>
                </div>
                <div class="ucv-col-card">
                  <div class="ucv-col-bar">{collation.bLabel}</div>
                  <ul class="ucv-col-list">
                    {collation.bItems.map((i) => <li>{i}</li>)}
                  </ul>
                </div>
              </div>
              <div class="ucv-col-down" aria-hidden="true">↓</div>
              <div class="ucv-col-out">
                <div class="ucv-col-out-k">{collation.outLabel}</div>
                <p class="ucv-col-out-v">{collation.outValue}</p>
                <p class="ucv-col-out-n">{collation.outNote}</p>
              </div>
            </div>
          )}
          <div class="ucv-ba">
            <div class="ucv-ba-col">
              <p class="ucv-ba-cap">① {C.s2OpCap}</p>
              <div class="ucv-ba-card">
                <div class="ucv-ba-bar"><span class="d"></span><span class="d"></span><span class="d"></span>{C.s2OpBar}</div>
                <dl class="ucv-ba-rows">
                  <div class="ucv-ba-row"><dt>{C.s2OpRow1}</dt><dd>{C.s2OpRow1v}</dd></div>
                  <div class="ucv-ba-row"><dt>{C.s2OpRow2}</dt><dd><span class="ucv-ba-strong">{C.s2OpRow2v}</span></dd></div>
                  <div class="ucv-ba-row"><dt>{C.s2OpRow3}</dt><dd>{C.s2OpRow3v}</dd></div>
                </dl>
              </div>
            </div>

            <div class="ucv-ba-arrow" aria-hidden="true"><span class="lab">{C.s2Link}</span><span>→</span></div>

            <div class="ucv-ba-col">
              <p class="ucv-ba-cap">② {C.s2VfCap}</p>
              <div class="ucv-ba-card ucv-ba-card--after">
                <div class="ucv-ba-bar"><span class="d"></span><span class="d"></span><span class="d"></span>{C.s2VfBar}</div>
                <div class="ucv-mini-verdict">
                  <div class="seal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                      <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                      <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                  <div class="t">{C.hiwVerdict}</div>
                  {isJa && <div class="en">NOT TAMPERED</div>}
                </div>
                <dl class="ucv-ba-rows">
                  {hideProve && (
                    <div class="ucv-ba-row"><dt>{C.s2AfterFact}</dt><dd><span class="ucv-ba-strong">{hideProve.prove}</span></dd></div>
                  )}
                  {hideProve && (
                    <div class="ucv-ba-row"><dt>{hideProve.hide}</dt><dd>{C.s2VfHidden}</dd></div>
                  )}
                  <div class="ucv-ba-row"><dt>{C.s2VfKey}</dt><dd>{C.s2VfKeyVal}</dd></div>
                </dl>
              </div>
            </div>
          </div>

          <div class="ucv-approach">
            <div class="ucv-approach-h">{isJa ? "なぜ Lemma か" : "Why Lemma"}</div>
            <ul class="ucv-why">
              <li><b>{isJa ? "本文は出さない" : "The document stays private"}</b>{isJa ? " — 記録の本文（個人情報・機微データ）は送信も開示もしません。" : " — the record itself is never sent or disclosed."}</li>
              <li><b>{isJa ? "相手が独立に検証" : "Independent verification"}</b>{isJa ? " — 受け取った側はリンクを開くだけ。アカウントもキーも不要です。" : " — the receiver just opens a link. No account, no keys."}</li>
              <li><b>{isJa ? "書き換えは検知" : "Edits are detected"}</b>{isJa ? " — 1文字の書き換えも、検証の時点で一致しなくなります。" : " — even a one-character edit fails verification."}</li>
            </ul>
            {v3 ? (
              <p>{v3.approach[locale]}</p>
            ) : (
              <div class="ucv-approach-body" set:html={approachBody} />
            )}
            <a class="ucv-approach-link" href={`${pillarsPath}/${PILLAR_ANCHOR[pillar.slug] ?? ""}`}>{C.approachLink}</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- §3 選定基準 — common comparison table -->
  <section class="ucv-band ucv-band--deep" aria-label={C.ariaCriteria}>
    <div class="ucv-container">
      <div class="ucv-eye">{C.s3Eye}</div>
      <h2 class="ucv-h2">{C.s3H2}</h2>
      <p class="ucv-band-lead" set:html={C.s3Lead} />
      <div class="ucv-table-wrap">
        <table class="ucv-table">
          <thead>
            <tr>
              <th>{C.thMethod}</th>
              <th>{C.thPass}</th>
              <th>{C.thVerify}</th>
              <th>{C.thTamper}</th>
              <th class="why">{C.thWhy}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>{C.rowAccess}</td><td>△</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowAccessWhy}</td></tr>
            <tr><td>{C.rowMask}</td><td>△</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowMaskWhy}</td></tr>
            <tr><td>{C.rowEnc}</td><td class="ok">✓</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowEncWhy}</td></tr>
            {compareRow && (
              <tr><td>{compareRow}</td><td>△</td><td class="no">✗</td><td class="no">✗</td><td class="why">{C.rowExtraWhy}</td></tr>
            )}
            <tr class="is-lemma">
              <td><span class="ucv-lemma-name">{C.lemmaName}</span><span class="ucv-only">{C.onlyTag}</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td class="why">{C.rowLemmaWhy}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- §4 進め方 — 業界ページ HIW と同型のスレート帯・3カラム -->
  <section class="ucv-band ucv-band--slate" aria-label={C.ariaSteps}>
    <div class="ucv-container">
      <div class="ucv-eye">{C.s4Eye}</div>
      <h2 class="ucv-h2">{C.s4Title}</h2>
      <div class="ucv-hiw">

        <div class="ucv-hiw-step">
          <div class="ucv-hiw-shot">
            <div class="ucv-mini">
              <div class="ucv-mini-bar">{C.hiw1Bar}</div>
              <div class="ucv-mini-body">
                <div class="ucv-mini-row"><span>{C.hiwProveLab}</span><b>{hideProve ? hideProve.prove : useCase.title}</b></div>
                {hideProve && <div class="ucv-mini-row"><span>{C.hiwHideLab}</span><b>{hideProve.hide}</b></div>}
              </div>
            </div>
          </div>
          <span class="ucv-hiw-n">01 — {C.s4Steps[0].a}</span><span class="ucv-hiw-t">{C.s4Steps[0].t}</span>
          <span class="ucv-hiw-d">{C.s4Steps[0].d}</span>
        </div>

        <div class="ucv-hiw-step">
          <div class="ucv-hiw-shot">
            <div class="ucv-mini">
              <div class="ucv-mini-bar">{C.hiw2Bar}</div>
              <div class="ucv-mini-body">
                <div class="ucv-mini-row"><span>{C.hiwSentLab}</span><b>{C.hiwSentVal}</b></div>
                <div class="ucv-mini-row"><span>{C.hiwDocLab}</span><b>{C.hiwDocVal}</b></div>
                <div class="ucv-mini-ok">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="11" stroke-width="1.4" />
                    <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {C.hiwIssued}
                </div>
              </div>
            </div>
          </div>
          <span class="ucv-hiw-n">02 — {C.s4Steps[1].a}</span><span class="ucv-hiw-t">{C.s4Steps[1].t}</span>
          <span class="ucv-hiw-d">{C.s4Steps[1].d}</span>
        </div>

        <div class="ucv-hiw-step">
          <div class="ucv-hiw-shot">
            <div class="ucv-mini">
              <div class="ucv-mini-bar">{C.hiw3Bar}</div>
              <div class="ucv-mini-verdict">
                <div class="seal">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                    <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                    <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="t">{C.hiwVerdict}</div>
                {isJa && <div class="en">NOT TAMPERED</div>}
                <div class="chk"><span>{C.hiwChk1}</span><span>{C.hiwChk2}</span><span>{C.hiwChk3}</span></div>
              </div>
            </div>
          </div>
          <span class="ucv-hiw-n">03 — {C.s4Steps[2].a}</span><span class="ucv-hiw-t">{C.s4Steps[2].t}</span>
          <span class="ucv-hiw-d">{C.s4Steps[2].d}</span>
        </div>

      </div>
      <p class="ucv-steps-note">{C.s4Note}</p>
      <div class="ucv-cta-card">
        <p class="ucv-cta-card-h">{C.ctaCardH}</p>
        {invite && <div class="ucv-steps-invite" set:html={invite} />}
        <a class="ucv-uc-cta-btn" href={isJa ? `https://tally.so/r/EkBqDX?uc=${useCase.slug}` : `https://tally.so/r/Pd2Rl5?uc=${useCase.slug}`} target="_blank" rel="noopener">
          {isJa ? "このユースケースについて、問い合わせる →" : "Talk to us about this use case →"}
        </a>
      </div>
    </div>
  </section>

  <!-- §5 関連 + §6 業務から探す — 1帯2カラム -->
  <section class="ucv-band ucv-band--deep" aria-label={C.ariaRelated}>
    <div class="ucv-container ucv-crossnav">
      <div>
        <h2 class="ucv-h3">{relatedSection?.title ?? C.s5H2}</h2>
        {relatedUseCases.length > 0 && (
          <div class="ucv-bytask-list">
            {relatedUseCases.map((r) => (
              <a class="ucv-bytask-row" href={`${useCasesPath}/${r.slug}/`}>{r.title}</a>
            ))}
          </div>
        )}
      </div>
      {taskGroup && bytaskMembers.length > 0 && (
        <div>
          <h2 class="ucv-h3" id="ucv-bytask-h">業務から探す</h2>
          <p class="ucv-bytask-sub">同じ課題｜{taskGroup.heading}</p>
          <div class="ucv-bytask-list">
            {bytaskMembers.map((m) => (
              <a class="ucv-bytask-row" href={`${useCasesPath}/${m.slug}/`}>{m.title}</a>
            ))}
          </div>
        </div>
      )}
    </div>
    <div class="ucv-container ucv-ucnav">
      <p class="ucv-ucnav-lead">{isJa ? "お探しの業界・課題に合わせた事例が見つかります" : "Find the case that matches your industry and problem"}</p>
      <a class="ucv-btn ucv-btn--ghost" href={`${useCasesPath}/`}>{isJa ? "課題や業種から業務ユースケースを探す（全36件） →" : "Browse all 36 use cases →"}</a>
    </div>
  </section>

  {/* EN のみ製品クロージングを残す（§4 の主CTAが JA 限定のため）。
      JA の Discovery Call 帯は §4 の問い合わせと同一行動につき統合・撤去。 */}
  {!isJa && (
    <section class="ucv-closing" aria-label="Try Lemma">
      <div class="ucv-closing-inner">
        <p class="ucv-closing-eyebrow">TRY LEMMA</p>
        <h2 class="ucv-closing-h">Run it <span class="accent">yourself</span>.</h2>
        <p class="ucv-closing-sub">No sales call needed — start hands-on with Lemma's products.</p>
        <div class="ucv-closing-ctas">
          <a href={sealHref} class="ucv-closing-pill">Try Seal →</a>
          <a href={trust402Href} class="ucv-closing-link">Trust402 reference implementation →</a>
        </div>
      </div>
    </section>
  )}
</main>

<style>
  /* ============================================================
     UC 詳細 v4 — 業界ページ (indv1 / usecases-index v14) と同一の
     デザインシステム。トークン・字組み・部品の値は
     industry-v1.css / 業界モック確定版から写している。
     上書きは .ucv-page 内に限定。
     ============================================================ */
  .ucv-page {
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #ffffff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --ok: #a8e010;
    --ok-light: #4e7a00;
    --ok-ink: #6f9c00;
    --err: #c25438;
    --line: #e1e3dd;
    --dline-2: #d9ddd7;
    --sh-s: 0 4px 14px rgba(14, 18, 16, 0.06);
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.1);
    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.9;
    margin-top: 64px;
    padding: 0;
  }
  .ucv-container { max-width: calc(1180px + 12vw); margin: 0 auto; padding: 0 6vw; }
  a { text-decoration: none; color: inherit; }

  /* ---------- breadcrumb ---------- */
  .ucv-breadcrumb { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; padding: 34px 0 0; font-size: 12px; color: var(--muted); }
  .ucv-breadcrumb a { color: var(--muted); }
  .ucv-breadcrumb a:hover { color: var(--ok-light); }
  .ucv-bc-sep { color: var(--dline-2); margin: 0 2px; }

  /* ---------- hero ---------- */
  .ucv-hero { display: grid; grid-template-columns: minmax(0, 1fr) 470px; gap: 42px; align-items: center; padding: 22px 0 44px; }
  .ucv-uc-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ok-ink); margin: 20px 0 12px; }
  .ucv-h1 { font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(26px, 3.2vw, 38px); line-height: 1.5; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 16px; overflow-wrap: anywhere; }
  .ucv-lead { font-size: 15px; line-height: 2; color: var(--tx-soft); margin: 0 0 18px; max-width: 52ch; }
  .ucv-meta { display: flex; gap: 18px; flex-wrap: wrap; align-items: baseline; margin: 0 0 20px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; color: var(--muted); }
  .ucv-plan { color: var(--muted); }
  .ucv-plan b { color: var(--ok-light); font-weight: 400; }
  .ucv-plan:hover b { text-decoration: underline; }
  .ucv-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ucv-btn { display: inline-block; text-decoration: none; font-weight: 500; font-size: 14px; border-radius: 6px; padding: 14px 30px; cursor: pointer; border: 1px solid transparent; transition: 0.18s; font-family: var(--font-body); letter-spacing: 0.05em; }
  .ucv-btn--primary { background: var(--ok); color: var(--ink); font-weight: 600; box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35); }
  .ucv-btn--primary:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .ucv-btn--ghost { color: var(--tx-soft); border-color: #d5dad3; background: rgba(255, 255, 255, 0.5); }
  .ucv-btn--ghost:hover { border-color: var(--ok-ink); color: var(--tx); }

  /* hero 右 — 検証画面カード（スレート） */
  .ucv-ui { position: relative; overflow: hidden; border-radius: 14px; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); box-shadow: 0 26px 60px rgba(22, 30, 24, 0.28); }
  .ucv-ui::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(125% 78% at 92% -18%, rgba(168, 224, 16, 0.16), rgba(168, 224, 16, 0) 62%); }
  .ucv-ui > * { position: relative; z-index: 2; }
  .ucv-ui-bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; border-bottom: 1px solid #4a544b; }
  .ucv-ui-dot { width: 8px; height: 8px; border-radius: 50%; background: #4a544b; }
  .ucv-ui-url { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; color: #8b9285; margin-left: 6px; }
  .ucv-ui-body { padding: 20px 20px 18px; }
  .ucv-uv-head { display: flex; align-items: center; gap: 13px; margin-bottom: 16px; }
  .ucv-uv-seal { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; flex: none; border: 1.5px solid rgba(168, 224, 16, 0.55); background: rgba(168, 224, 16, 0.09); color: var(--ok); }
  .ucv-uv-t { font-family: var(--font-serif-jp); font-weight: 600; font-size: 17px; line-height: 1.45; color: #ebefe6; }
  .ucv-uv-en { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; color: #8b9285; margin-top: 4px; }
  .ucv-uv-row { display: flex; align-items: baseline; gap: 12px; padding: 8px 0; border-top: 1px solid rgba(74, 84, 75, 0.6); }
  .ucv-uv-row .l { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; color: #8b9285; flex: none; }
  .ucv-uv-row .r { font-size: 11.5px; line-height: 1.7; color: #e3e8dc; }
  .ucv-uv-chk { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 12px; padding-top: 11px; border-top: 1px solid #4a544b; font-size: 10.5px; color: #bcc3b6; }
  .ucv-uv-chk span::before { content: "✓ "; color: var(--ok); }

  /* ---------- section chrome ---------- */
  .ucv-band { padding: 52px 0 56px; }
  .ucv-band--deep { background: var(--lite-2); }
  .ucv-eye { display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .ucv-h2 { display: block; font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(23px, 2.7vw, 32px); line-height: 1.5; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 18px; word-break: keep-all; }
  .ucv-band-lead { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); max-width: 62ch; margin: 0 0 22px; }
  .ucv-band-lead strong { color: var(--tx); font-weight: 600; }

  /* ---------- §1 personas ---------- */
  .ucv-personas { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 24px 0 0; padding: 0; }
  .ucv-persona { background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); padding: 20px 20px 18px; margin: 0; }
  .ucv-persona-avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--lite-2); color: var(--ok-light); margin-bottom: 12px; }
  .ucv-persona-role { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--ok-ink); margin-bottom: 8px; }
  .ucv-persona-quote { font-size: 13.5px; line-height: 1.85; color: var(--tx-soft); margin: 0; }
  .ucv-audience { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); max-width: 62ch; }

  /* ---------- §2 before/after ---------- */
  .ucv-emph { border-left: 3px solid var(--ok); padding-left: clamp(18px, 3vw, 34px); }
  /* §2 照合バンド — 「A と B を照合する」を先に絵にする（config/useCaseCollation.ts）。 */
  .ucv-col { margin: 26px 0 26px; }
  .ucv-col-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .ucv-col-card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); overflow: hidden; }
  .ucv-col-bar { padding: 10px 14px; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; color: var(--muted); }
  .ucv-col-list { margin: 0; padding: 6px 18px 14px; list-style: none; }
  .ucv-col-list li { position: relative; padding: 8px 0 8px 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--tx); }
  .ucv-col-list li:first-child { border-top: none; }
  .ucv-col-list li::before { content: ""; position: absolute; left: 0; top: 50%; width: 6px; height: 1px; background: var(--line); }
  .ucv-col-op { display: grid; place-items: center; align-content: center; gap: 6px; color: var(--ok-light); }
  .ucv-col-op .mk { font-size: 20px; line-height: 1; }
