      <span class="ucv-bc-sep">/</span>
      <span>{useCase.title}</span>
    </nav>

    <header class="ucv-hero">
      <div class="ucv-hero-tx">
        <div class="ucv-uc-label">{isJa ? "業務ユースケース" : "Use case"}{pillar && ` — ${pillar.title[locale]}`}</div>
        <h1 class="ucv-h1">{useCase.title}</h1>
        <p class="ucv-lead">{useCase.abstract}</p>

        <div class="ucv-meta">
          {useCase.targetVerticals.length > 0 && (
            <span class="ucv-verticals">{useCase.targetVerticals.join(" · ")}</span>
          )}
          {planKey && (
            <a class="ucv-plan" href={SEGMENT_URLS[planKey][locale]}>{isJa ? "対応プラン" : "Plan"} <b>{planName[planKey]}</b></a>
          )}
        </div>
        <div class="ucv-hero-ctas">
          <a class="ucv-btn ucv-btn--primary" href={isJa ? `https://tally.so/r/EkBqDX?uc=${useCase.slug}` : `https://tally.so/r/Pd2Rl5?uc=${useCase.slug}`} target="_blank" rel="noopener">{isJa ? "このユースケースについて、問い合わせる" : "Talk to us about this use case"}</a>
          <a class="ucv-btn ucv-btn--ghost" href={`${base}/verify/`}>{isJa ? "証明を1件、検証してみる" : "Verify a proof"}</a>
        </div>
      </div>

      {/* 受け取った側の見え方 — 汎用の検証画面カード（データはラベルのみ。
          開示された事実は HIDE→PROVE の prove 文をそのまま使う）。 */}
      <div class="ucv-ui" aria-hidden="true">
        <div class="ucv-ui-bar"><span class="ucv-ui-dot"></span><span class="ucv-ui-dot"></span><span class="ucv-ui-dot"></span>
          <span class="ucv-ui-url">{isJa ? "受け取った側の検証画面" : "The verifier's screen"}</span></div>
        <div class="ucv-ui-body">
          <div class="ucv-uv-head">
            <span class="ucv-uv-seal">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div><div class="ucv-uv-t">{isJa ? "改ざんされていません" : "Not tampered"}</div>{isJa && <div class="ucv-uv-en">NOT TAMPERED</div>}</div>
          </div>
          {hideProve && (
            <div class="ucv-uv-row"><span class="l">{C.s2AfterFact}</span><span class="r">{hideProve.prove}</span></div>
          )}
          <div class="ucv-uv-row"><span class="l">{isJa ? "発行元への照会" : "Issuer round-trip"}</span><span class="r">{isJa ? "不要" : "Not needed"}</span></div>
          <div class="ucv-uv-row"><span class="l">{isJa ? "証明のサイズ" : "Proof size"}</span><span class="r">{isJa ? "約200バイト" : "~200 bytes"}</span></div>
          <div class="ucv-uv-chk">
            <span>{isJa ? "署名の一致" : "Signature"}</span>
            <span>{isJa ? "改ざんの有無" : "Integrity"}</span>
            <span>{isJa ? "発行者の確認" : "Issuer"}</span>
          </div>
        </div>
      </div>
    </header>
  </div>

  <!-- §1 — authored persona quotes, or derived from the audience section. -->
  {(v3 || audienceSection) && (
    <section class="ucv-band ucv-band--deep" aria-label={C.ariaReaders}>
      <div class="ucv-container">
        {v3 ? (
          <Fragment>
            <div class="ucv-eye">{C.s1AuthEye}</div>
            <h2 class="ucv-h2">{C.s1AuthH2}</h2>
            <ul class="ucv-personas">
              {v3.personas.map((p) => (
                <li class="ucv-persona">
                  <div class="ucv-persona-avatar" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
