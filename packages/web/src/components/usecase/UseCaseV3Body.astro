---
/**
 * Use Case detail — v3 body (JA only).
 *
 * Renders the compressed 5-section v3 page (see config/useCaseV3.ts and the
 * v3 PR spec). Only invoked when the slug has a v3 config entry AND the
 * locale is JA; every other surface keeps the long-form template.
 *
 * Structure:
 *   Hero            breadcrumb · pillar tag · H1 · HIDE→PROVE · lead · meta
 *   Credibility     ink-dark full-bleed strip (common across all UCs)
 *   §1 推進担当の声  cream-deep · 3 persona cards (from v3 config)
 *   §2 変化         cream · emphasized · Before/After + approach callout
 *   §3 選定基準      cream-deep · common 4-row comparison table
 *   §4 進め方        cream · existing "next" markdown (ORIGINAL numbered list)
 *   §5 関連          cream-deep · related cards → Solutions bridge → final CTA
 *
 * Crypto scheme names stay out of the body; the §2 callout links to /guides
 * for the technical reader. The final CTA drops the Critical Brief link.
 */
import type { Locale } from "../../i18n/translations";
import type { UseCase } from "../../data/useCases";
import type { Pillar } from "../../data/pillars";
import type { HideProvePair } from "../../config/useCaseHideProve";
import type { UseCaseV3 } from "../../config/useCaseV3";
import type { UseCaseBeforeAfter } from "../../config/useCaseBeforeAfter";
import SolutionsBridge from "../SolutionsBridge.astro";
import { DISCOVERY_CALL_URL } from "../../config/cta";
import { USE_CASE_PLAN } from "../../data/useCasePlanMap";
import { SEGMENT_URLS } from "../../config/navigation";

export interface UseCaseV3BodyProps {
  taskGroup?: { readonly id: string; readonly heading: string } | undefined;
  taskGroupMembers?: ReadonlyArray<{ readonly slug: string; readonly title: string }>;
  locale: Locale;
  base: string;
  useCase: UseCase;
  pillar: Pillar;
  useCaseTitle: string;
  relatedUseCases: ReadonlyArray<UseCase>;
  hideProve: HideProvePair | undefined;
  /** Authored hooks (§1 personas + §2 Before/After). Undefined for UCs that
   * are rendered in derived mode — §1 falls back to the audience section and
   * §2 to the approach section, with no Before/After cards. */
  v3: UseCaseV3 | undefined;
  /** §2 Before/After data for derived UCs (no personas) — renders the same
   * key:value table the authored path uses. Ignored when `v3` is present. */
  beforeAfter: UseCaseBeforeAfter | undefined;
  /** §3 table extra "detection / monitoring only" row label for
   * cyber-relevant UCs; undefined keeps the common 3-row table. */
  compareRow: string | undefined;
  ucBridgeHref: string;
  ucBridgeCta: string;
}

const {
  locale,
  base,
  useCase,
  pillar,
  useCaseTitle,
  relatedUseCases,
  hideProve,
  v3,
  beforeAfter,
  compareRow,
  ucBridgeHref,
  ucBridgeCta, taskGroup, taskGroupMembers = [] } = Astro.props as UseCaseV3BodyProps;

const isJa = locale === "ja";
const sealHref = `${base}/seal/`;
const trust402Href = `${base}/trust402/`;

// Locale-resolved chrome. Authored §1/§2 strings stay hardcoded JA — the
// authored path only renders for JA (v3 config is JA-gated). EN UCs all
// render in derived mode, so only the common + derived strings are localized.
const C = isJa
  ? {
      bcHome: "ホーム", bcUC: "活用シーン", readUnit: "分",
      credMid: "公共インフラ PoC 稼働中",
      hpAria: "HIDE と PROVE の対比", hpHide: "Hide ── 隠す", hpProve: "Prove ── 証明する",
      ariaReaders: "読者", ariaApproach: "アプローチ", ariaCriteria: "選定基準",
      ariaSteps: "進め方", ariaRelated: "関連ユースケース",
      s1Eye: "01 · 想定読者", s1H2: "このページは、こんな方のために。",
      s1AuthEye: "01 · 課題認識", s1AuthH2: "推進担当の、3 つの声。",
      s2EyeShift: "02 · 変化", s2EyeApproach: "02 · アプローチ",
      s2H2: "原本を渡すか、事実だけを渡すか。",
      s2Lead: "AI に渡すものが変われば、漏洩のリスクごと消える。",
      baBeforeTitle: "原本・中身をそのまま渡す", baAfterTitle: "事実だけを証明付きで渡す",
      baFlowBefore: "↓ すべて外部・AI へ渡る", baFlowAfter: "↓ 必要な事実だけ",
      baDataBeforeTitle: "原本をそのまま渡す", baDataAfterTitle: "事実だけを渡す",
      baDataFlowBefore: "↓ すべて AI・外部へ渡る", baDataFlowAfter: "↓ 必要な事実だけ AI へ渡る",
      approachLink: "技術詳細を見る ↗",
      s3Eye: "03 · 選定基準", s3H2: "3 つの基準で、選ぶ。",
      s3Lead: "「中身を出さず渡す」「独立検証」「書き換えの検知」の 3 つが同時に要る業務こそが Lemma の領域です。",
      thMethod: "手段", thPass: "中身を出さず渡す", thVerify: "独立検証", thTamper: "書き換えを検知",
      rowAccess: "アクセス制御のみ", rowMask: "マスキング / 匿名化", rowEnc: "暗号化のみ",
      lemmaName: "Lemma（ZK 証明）", onlyTag: "唯一 3 つ揃う",
      s4Eye: "04 · 進め方", s4Title: "進め方",
      s5Eye: "05 · 関連ユースケース", s5H2: "関連ユースケース", relatedCta: "ユースケースを見る →",
      faqLead: "残った疑問は、", faqLinkLabel: "よくある質問（FAQ）→",
      bridgeEye: "より広い活用シーン",
      bridgeH2: "このユースケースを含む、活用シーンの全体像。",
      bridgeSub: "業界・業務領域ごとの活用シーンと、5つの証明で整理しています。",
    }
  : {
      bcHome: "Home", bcUC: "Use Cases", readUnit: "min read",
      credMid: "Public-infrastructure PoC in production",
      hpAria: "HIDE versus PROVE", hpHide: "Hide", hpProve: "Prove",
      ariaReaders: "Who it's for", ariaApproach: "Approach", ariaCriteria: "How to choose",
      ariaSteps: "How it works", ariaRelated: "Related use cases",
      s1Eye: "01 · WHO IT'S FOR", s1H2: "Who this is for.",
      s1AuthEye: "01 · THE PROBLEM", s1AuthH2: "Three voices from the front line.",
      s2EyeShift: "02 · THE SHIFT", s2EyeApproach: "02 · APPROACH",
      s2H2: "Hand over the source, or just the facts?",
      s2Lead: "Change what reaches the AI, and the leakage risk goes with it.",
      baBeforeTitle: "Hand over the raw source", baAfterTitle: "Share only the proven facts",
      baFlowBefore: "↓ all of it reaches the AI / outside", baFlowAfter: "↓ only the necessary facts",
      baDataBeforeTitle: "Hand over the original", baDataAfterTitle: "Hand over just the facts",
      baDataFlowBefore: "↓ all of it goes to the AI / outside", baDataFlowAfter: "↓ only the necessary facts to the AI",
      approachLink: "See the technical details ↗",
      s3Eye: "03 · HOW TO CHOOSE", s3H2: "Choose on three criteria.",
      s3Lead: "Only work that needs all three at once — pass without exposing, independent verification, tamper-evidence — is Lemma's domain.",
      thMethod: "Method", thPass: "Pass without exposing", thVerify: "Independent verification", thTamper: "Tamper-evident",
      rowAccess: "Access control only", rowMask: "Masking / anonymization", rowEnc: "Encryption only",
      lemmaName: "Lemma (ZK proof)", onlyTag: "the only one with all 3",
      s4Eye: "04 · HOW IT WORKS", s4Title: "How it works",
      s5Eye: "05 · RELATED", s5H2: "Related use cases", relatedCta: "View use case →",
      faqLead: "Still have questions?", faqLinkLabel: "See the FAQ →",
      bridgeEye: "The bigger picture",
      bridgeH2: "The bigger picture this use case belongs to.",
      bridgeSub: "We map use scenarios across industries and workflows by the five proofs.",
    };

// Resolve a Before/After data value for the active locale (vEn overrides v).
const rv = (row: { v: string; vEn?: string }): string =>
  !isJa && row.vEn ? row.vEn : row.v;

const useCasesPath = `${base}/solutions/use-cases`;
const pillarsPath = `${base}/pillars`;

// 対応プラン — links to the matching plan page. DRAFT map in useCasePlanMap.ts.
const planKey = USE_CASE_PLAN[useCase.slug];
const planName: Readonly<Record<string, string>> = {
  civic: "Lemma Civic",
  critical: "Lemma Critical",
  compliance: "Lemma Compliance",
};
const faqHref = `${base}/faq/`;
// v3 is JA only, so the closing books the JA Discovery Call.
const discoveryUrl = DISCOVERY_CALL_URL.ja;

// §4 / §5 reuse the existing markdown sections by key.
// The 進め方 section is "next" on ai-document-isolation (a 5-step list) but
// "cta" on the other 7 UCs (a Discovery-led prose section). Fall back so §4
// renders on all of them.
const nextSection =
  useCase.sections.find((s) => s.key === "next") ??
  useCase.sections.find((s) => s.key === "cta");
// For the "cta" variant keep only the first paragraph — a modest, use-case-
// matched invitation ("…御社の構造を聞かせてください。…開示は必要ありません。"),
// at the level of ai-document-isolation's closing line. The follow-up
// paragraph (NDA 締結・規制マッピング・参照アーキテクチャ・PoC 設計) over-claims
// for this surface, and the trailing link row duplicates the TALK button.
const nextBody = (() => {
  if (!nextSection) return "";
  if (nextSection.key !== "cta") return nextSection.body;
  const firstPara = nextSection.body.match(/<p>[\s\S]*?<\/p>/);
  return firstPara ? firstPara[0] : nextSection.body;
})();
// Normalize the §4 heading to 「進め方」 — the "cta" section title is a
// Discovery-Call headline that reads oddly here; ai-document-isolation's is
// already "進め方".
const nextTitle =
  nextSection && nextSection.key === "next" ? nextSection.title : C.s4Title;
const relatedSection = useCase.sections.find((s) => s.key === "related");

// ── Authored vs derived mode ──────────────────────────────────────────
// UCs with a v3 config entry render authored §1 persona quotes + §2
// Before/After cards. The rest derive §1 from the audience section and §2
// from the approach section (no fabricated Before/After data).
const authored = !!v3;
const audienceSection = useCase.sections.find((s) => s.key === "audience");
const approachSection = useCase.sections.find((s) => s.key === "approach");

// Derived §2 approach text: strip crypto scheme names so the body stays
// jargon-light (the v3 surface hides scheme names; spec link covers depth).
function stripSchemes(html: string): string {
  return html
    .replace(
      /(?:BBS\+|Poseidon|Groth16|Circom|PLONK)(?:\s*over\s*(?:BLS12-?381|BN254|[A-Za-z0-9-]+))?(?:\s*回路)?\s*(?:で|を|により|の|上で)?/g,
      "",
    )
    .replace(/AES-?GCM\s*(?:で|を|により)?/g, "")
    .replace(/\(\s*CID\s*\)/g, "")
    .replace(/\(\s*Circ[^)]*\)/g, "")
    .replace(/（\s*）/g, "")
    .replace(/、\s*、/g, "、")
    .replace(/\s{2,}/g, " ");
}
const approachBody = approachSection ? stripSchemes(approachSection.body) : "";

// Derived §1: the audience section is an intro paragraph + a short bullet
// list. Render the bullets as persona-style cards for visual parity with the
// authored persona quotes.
const audienceHtml = audienceSection?.body ?? "";
const audienceIntro = audienceHtml.match(/<p>([\s\S]*?)<\/p>/)?.[1]?.trim() ?? "";
const audienceBullets = [...audienceHtml.matchAll(/<li>([\s\S]*?)<\/li>/g)].map((m) =>
  m[1].trim(),
);
// §2 Before/After key:value table data: from the authored config, or — for
// derived UCs — the data-only map. Either renders the same table.
const baData = v3 ?? beforeAfter;
const showDataBa = !!baData;
// Hero HIDE→PROVE device shows whenever §2 renders the data table (the chip
// pair and the table never duplicate the same surface). Concept-card fallback
// only for UCs that have a HIDE→PROVE pair but no Before/After data.
const showHeroHp = !!hideProve && showDataBa;
const showDerivedBa = !showDataBa && !!hideProve;

/** Trim an abstract to its first sentence for related cards. */
function firstSentence(text: string): string {
  const m = text.match(/^([^。.!?！？]+[。.!?！？])/);
  return (m?.[1] ?? text).trim();
}
---

<main class="ucv-page">
  <div class="ucv-container">
    <nav class="ucv-breadcrumb" aria-label="breadcrumb">
      <a href={base || "/"}>{C.bcHome}</a>
      <span class="ucv-bc-sep">/</span>
      <a href={useCasesPath}>{C.bcUC}</a>
      <span class="ucv-bc-sep">/</span>
      <span>{useCase.title}</span>
    </nav>

    <header class="ucv-hero">
      <div class="ucv-hero-tx">
        <div class="ucv-uc-label">{isJa ? "ユースケース" : "Use case"}{pillar && ` — ${pillar.title[locale]}`}</div>
        <h1 class="ucv-h1">{useCase.title}</h1>
        <p class="ucv-lead">{useCase.abstract}</p>

        <div class="ucv-meta">
          {useCase.targetVerticals.length > 0 && (
            <span class="ucv-verticals">{useCase.targetVerticals.join(" · ")}</span>
          )}
          {planKey && (
            <a class="ucv-plan" href={SEGMENT_URLS[planKey][locale]}>{isJa ? "対応プラン" : "Plan"} <b>{planName[planKey]}</b></a>
          )}
        </div>
        <div class="ucv-hero-ctas">
          {isJa && (
            <a class="ucv-btn ucv-btn--primary" href={`https://tally.so/r/EkBqDX?uc=${useCase.slug}`} target="_blank" rel="noopener">このユースケースについて、問い合わせる</a>
          )}
          <a class="ucv-btn ucv-btn--ghost" href={`${base}/verify/`}>{isJa ? "証明を1件、検証してみる" : "Verify a proof"}</a>
        </div>
      </div>

      {/* 受け取った側の見え方 — 汎用の検証画面カード（データはラベルのみ。
          開示された事実は HIDE→PROVE の prove 文をそのまま使う）。 */}
      <div class="ucv-ui" aria-hidden="true">
        <div class="ucv-ui-bar"><span class="ucv-ui-dot"></span><span class="ucv-ui-dot"></span><span class="ucv-ui-dot"></span>
          <span class="ucv-ui-url">{isJa ? "受け取った側の検証画面" : "The verifier's screen"}</span></div>
        <div class="ucv-ui-body">
          <div class="ucv-uv-head">
            <span class="ucv-uv-seal">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="11" stroke-width="1.1" />
                <circle cx="12" cy="12" r="8.2" stroke-width=".7" opacity=".45" />
                <path d="M8 12.2l2.7 2.7L16.2 9.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div><div class="ucv-uv-t">{isJa ? "改ざんされていません" : "Not tampered"}</div>{isJa && <div class="ucv-uv-en">NOT TAMPERED</div>}</div>
          </div>
          {hideProve && (
            <div class="ucv-uv-row"><span class="l">{isJa ? "証明された事実" : "Proven fact"}</span><span class="r">{hideProve.prove}</span></div>
          )}
          <div class="ucv-uv-row"><span class="l">{isJa ? "発行元への照会" : "Issuer round-trip"}</span><span class="r">{isJa ? "不要" : "Not needed"}</span></div>
          <div class="ucv-uv-row"><span class="l">{isJa ? "証明のサイズ" : "Proof size"}</span><span class="r">{isJa ? "約200バイト" : "~200 bytes"}</span></div>
          <div class="ucv-uv-chk">
            <span>{isJa ? "署名の一致" : "Signature"}</span>
            <span>{isJa ? "改ざんの有無" : "Integrity"}</span>
            <span>{isJa ? "発行者の確認" : "Issuer"}</span>
          </div>
        </div>
      </div>
    </header>
  </div>

  <!-- §1 — authored persona quotes, or derived from the audience section. -->
  {(v3 || audienceSection) && (
    <section class="ucv-band ucv-band--deep" aria-label={C.ariaReaders}>
      <div class="ucv-container">
        {v3 ? (
          <Fragment>
            <div class="ucv-eye">{C.s1AuthEye}</div>
            <h2 class="ucv-h2">{C.s1AuthH2}</h2>
            <ul class="ucv-personas">
              {v3.personas.map((p) => (
                <li class="ucv-persona">
                  <div class="ucv-persona-avatar" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="8" r="4" fill="currentColor" />
                      <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                    </svg>
                  </div>
                  <div class="ucv-persona-role">{p.role[locale]}</div>
                  <p class="ucv-persona-quote">{isJa ? `「${p.quote.ja}」` : `“${p.quote.en}”`}</p>
                </li>
              ))}
            </ul>
          </Fragment>
        ) : audienceSection && (
          <Fragment>
            <div class="ucv-eye">{C.s1Eye}</div>
            <h2 class="ucv-h2">{audienceSection.title || C.s1H2}</h2>
            {audienceIntro && <p class="ucv-band-lead" set:html={audienceIntro} />}
            {audienceBullets.length > 0 ? (
              <ul class="ucv-personas">
                {audienceBullets.slice(0, 3).map((b) => (
                  <li class="ucv-persona">
                    <div class="ucv-persona-avatar" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4" fill="currentColor" />
                        <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" fill="currentColor" />
                      </svg>
                    </div>
                    <p class="ucv-persona-quote" set:html={b} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="ucv-audience ucv-steps-body" set:html={audienceSection.body} />
            )}
          </Fragment>
        )}
      </div>
    </section>
  )}

  <!-- §2 — authored Before/After cards, or derived approach. -->
  {(v3 || approachSection) && (
    <section class="ucv-band" aria-label={C.ariaApproach}>
      <div class="ucv-container">
        <div class="ucv-emph">
          <div class="ucv-eye">{showDataBa || showDerivedBa ? C.s2EyeShift : C.s2EyeApproach}</div>
          <h2 class="ucv-h2">{C.s2H2}</h2>

          {showDerivedBa && hideProve && (
            <div class="ucv-ba ucv-ba--concept">
              <div class="ucv-ba-card ucv-ba-card--before">
                <div class="ucv-ba-label">Without Lemma</div>
                <div class="ucv-ba-title">{C.baBeforeTitle}</div>
                <p class="ucv-ba-claim">{hideProve.hide}</p>
                <div class="ucv-ba-flow">{C.baFlowBefore}</div>
              </div>

              <div class="ucv-ba-arrow" aria-hidden="true">→</div>

              <div class="ucv-ba-card ucv-ba-card--after">
                <div class="ucv-ba-label">With Lemma</div>
                <div class="ucv-ba-title">{C.baAfterTitle}</div>
                <p class="ucv-ba-claim ucv-ba-claim--prove">{hideProve.prove}</p>
                <div><span class="ucv-ba-badge">✓ ZK VALID</span></div>
                <div class="ucv-ba-flow ucv-ba-flow--after">{C.baFlowAfter}</div>
              </div>
            </div>
          )}

          {showDataBa && baData && (
            <Fragment>
              <p class="ucv-band-lead">{C.s2Lead}</p>
              <div class="ucv-ba">
                <div class="ucv-ba-card ucv-ba-card--before">
                  <div class="ucv-ba-label">Without Lemma</div>
                  <div class="ucv-ba-title">{C.baDataBeforeTitle}</div>
                  <dl class="ucv-ba-rows">
                    {baData.without.map((row) => (
                      <div class="ucv-ba-row">
                        <dt>{row.k}:</dt>
                        <dd>{rv(row)}</dd>
                      </div>
                    ))}
                  </dl>
                  <div class="ucv-ba-flow">{C.baDataFlowBefore}</div>
                </div>

                <div class="ucv-ba-arrow" aria-hidden="true">→</div>

                <div class="ucv-ba-card ucv-ba-card--after">
                  <div class="ucv-ba-label">With Lemma</div>
                  <div class="ucv-ba-title">{C.baDataAfterTitle}</div>
                  <dl class="ucv-ba-rows">
                    {baData.withProof.map((row) => (
                      <div class={`ucv-ba-row${row.strong || row.badge ? " is-key" : ""}`}>
                        <dt>{row.k}:</dt>
                        <dd>
                          {row.badge ? (
                            <span class="ucv-ba-badge">{rv(row)}</span>
                          ) : (
                            <span class={row.strong ? "ucv-ba-strong" : ""}>{rv(row)}</span>
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  <div class="ucv-ba-flow ucv-ba-flow--after">{C.baDataFlowAfter}</div>
                </div>
              </div>
            </Fragment>
          )}

          <div class="ucv-approach">
            {v3 ? (
              <p>{v3.approach[locale]}</p>
            ) : (
              <div class="ucv-approach-body" set:html={approachBody} />
            )}
            <a class="ucv-approach-link" href={`${pillarsPath}/${pillar.slug}`}>{C.approachLink}</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- §3 選定基準 — common comparison table -->
  <section class="ucv-band ucv-band--deep" aria-label={C.ariaCriteria}>
    <div class="ucv-container">
      <div class="ucv-eye">{C.s3Eye}</div>
      <h2 class="ucv-h2">{C.s3H2}</h2>
      <p class="ucv-band-lead" set:html={C.s3Lead} />
      <div class="ucv-table-wrap">
        <table class="ucv-table">
          <thead>
            <tr>
              <th>{C.thMethod}</th>
              <th>{C.thPass}</th>
              <th>{C.thVerify}</th>
              <th>{C.thTamper}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>{C.rowAccess}</td><td>△</td><td class="no">✗</td><td class="no">✗</td></tr>
            <tr><td>{C.rowMask}</td><td>△</td><td class="no">✗</td><td class="no">✗</td></tr>
            <tr><td>{C.rowEnc}</td><td class="ok">✓</td><td class="no">✗</td><td class="no">✗</td></tr>
            {compareRow && (
              <tr><td>{compareRow}</td><td>△</td><td class="no">✗</td><td class="no">✗</td></tr>
            )}
            <tr class="is-lemma">
              <td><span class="ucv-lemma-name">{C.lemmaName}</span><span class="ucv-only">{C.onlyTag}</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
              <td><span class="ucv-check">✓</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- §4 進め方 — existing markdown (ORIGINAL numbered list) -->
  {nextSection && (
    <section class="ucv-band" aria-label={C.ariaSteps}>
      <div class="ucv-container">
        <div class="ucv-eye">{C.s4Eye}</div>
        <h2 class="ucv-h2">{nextTitle}</h2>
        <div class="ucv-steps-body" set:html={nextBody} />
        {/* UC-specific TALK CTA — JA only. The form books a Discovery Call;
            EN has no call staff, so EN closes on the product CTAs instead. */}
        {isJa && (
          <div class="ucv-uc-cta">
            <a class="ucv-uc-cta-btn" href={`https://tally.so/r/EkBqDX?uc=${useCase.slug}`} target="_blank" rel="noopener">
              このユースケースについて、問い合わせる →
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- §5 関連ユースケース -->
  <section class="ucv-band ucv-band--deep" aria-label={C.ariaRelated}>
    <div class="ucv-container">
      <div class="ucv-eye">{C.s5Eye}</div>
      <h2 class="ucv-h2">{relatedSection?.title ?? C.s5H2}</h2>
      {relatedUseCases.length > 0 && (
        <ul class="ucv-related">
          {relatedUseCases.map((r) => (
            <li>
              <a class="ucv-related-card" href={`${useCasesPath}/${r.slug}`}>
                <span class="ucv-related-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <line x1="9" y1="8" x2="15" y2="8" />
                    <line x1="9" y1="12" x2="15" y2="12" />
                    <line x1="9" y1="16" x2="13" y2="16" />
                  </svg>
                </span>
                <h3 class="ucv-related-title">{r.title}</h3>
                <p class="ucv-related-abstract">{firstSentence(r.abstract)}</p>
                <span class="ucv-related-cta">{C.relatedCta}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="ucv-faq-link">{C.faqLead} <a href={faqHref}>{C.faqLinkLabel}</a></p>
    </div>
  </section>

  <SolutionsBridge
    href={ucBridgeHref}
    eyebrow={C.bridgeEye}
    h2={C.bridgeH2}
    sub={C.bridgeSub}
    ctaLabel={ucBridgeCta}
  />

  {/* Closing — JA books a Discovery Call; EN has no call staff, so it sends
      visitors to the products to try them hands-on (Seal + Trust402). */}
  {isJa ? (
    <section class="ucv-closing" aria-label="Discovery Call">
      <div class="ucv-closing-inner">
        <p class="ucv-closing-eyebrow">DISCOVERY CALL</p>
        <h2 class="ucv-closing-h">まずは、<span class="accent">30 分の対話</span>から。</h2>
        <p class="ucv-closing-sub">Lemma の機能や活用場面について、ご質問にお答えします。技術的な詳細や機微情報（個人情報や機密情報など）の開示は不要です。</p>
        <div class="ucv-closing-ctas">
          <a href={discoveryUrl} class="ucv-closing-pill" target="_blank" rel="noopener">Discovery Call を予約 →</a>
          <button type="button" class="ucv-closing-link" data-tally-open="xX0VYv" data-tally-emoji-text="">ホワイトペーパー DL →</button>
        </div>
      </div>
    </section>
  ) : (
    <section class="ucv-closing" aria-label="Try Lemma">
      <div class="ucv-closing-inner">
        <p class="ucv-closing-eyebrow">TRY LEMMA</p>
        <h2 class="ucv-closing-h">Run it <span class="accent">yourself</span>.</h2>
        <p class="ucv-closing-sub">No sales call needed — start hands-on with Lemma's products.</p>
        <div class="ucv-closing-ctas">
          <a href={sealHref} class="ucv-closing-pill">Try Seal →</a>
          <a href={trust402Href} class="ucv-closing-link">Trust402 reference implementation →</a>
        </div>
      </div>
    </section>
  )}

  {pillar && (
    <div class="ucv-pillar-foot-wrap">
      <a class="ucv-pillar-foot" href={`${pillarsPath}/${pillar.slug}`}>
        {locale === "ja" ? "仕組みについて知る" : "Learn how it works"} — {pillar.title[locale]} →
      </a>
    </div>
  )}
  {taskGroup && taskGroupMembers.length > 0 && (
    <section class="ucv-bytask" aria-labelledby="ucv-bytask-h">
      <div class="ucv-bytask-inner">
        <div class="ucv-bytask-k">Use cases — by task</div>
        <h2 class="ucv-bytask-h" id="ucv-bytask-h">業務から探す</h2>
        <p class="ucv-bytask-sub">{taskGroup.id}｜{taskGroup.heading} — 同じ課題のユースケース</p>
        <div class="ucv-bytask-list">
          {taskGroupMembers.map((m) => (
            <a class="ucv-bytask-row" href={`${useCasesPath}/${m.slug}/`}>{m.title}</a>
          ))}
        </div>
        <a class="ucv-bytask-all" href={`${useCasesPath}/`}>ユースケース一覧 — 業務から探す（全36件） →</a>
      </div>
    </section>
  )}
</main>

<style>
  /* ============================================================
     UC 詳細 v4 — 業界ページ (indv1 / usecases-index v14) と同一の
     デザインシステム。トークン・字組み・部品の値は
     industry-v1.css / 業界モック確定版から写している。
     上書きは .ucv-page 内に限定。
     ============================================================ */
  .ucv-page {
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #ffffff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --ok: #a8e010;
    --ok-light: #4e7a00;
    --ok-ink: #6f9c00;
    --err: #c25438;
    --line: #e1e3dd;
    --dline-2: #d9ddd7;
    --sh-s: 0 4px 14px rgba(14, 18, 16, 0.06);
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.1);
    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.9;
    margin-top: 64px;
    padding: 0;
  }
  .ucv-container { max-width: calc(1180px + 12vw); margin: 0 auto; padding: 0 6vw; }
  a { text-decoration: none; color: inherit; }

  /* ---------- breadcrumb ---------- */
  .ucv-breadcrumb { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; padding: 34px 0 0; font-size: 12px; color: var(--muted); }
  .ucv-breadcrumb a { color: var(--muted); }
  .ucv-breadcrumb a:hover { color: var(--ok-light); }
  .ucv-bc-sep { color: var(--dline-2); margin: 0 2px; }

  /* ---------- hero ---------- */
  .ucv-hero { display: grid; grid-template-columns: minmax(0, 1fr) 470px; gap: 42px; align-items: center; padding: 22px 0 44px; }
  .ucv-uc-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ok-ink); margin: 20px 0 12px; }
  .ucv-h1 { font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(26px, 3.2vw, 38px); line-height: 1.5; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 16px; overflow-wrap: anywhere; }
  .ucv-lead { font-size: 15px; line-height: 2; color: var(--tx-soft); margin: 0 0 18px; max-width: 52ch; }
  .ucv-meta { display: flex; gap: 18px; flex-wrap: wrap; align-items: baseline; margin: 0 0 20px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; color: var(--muted); }
  .ucv-plan { color: var(--muted); }
  .ucv-plan b { color: var(--ok-light); font-weight: 400; }
  .ucv-plan:hover b { text-decoration: underline; }
  .ucv-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ucv-btn { display: inline-block; text-decoration: none; font-weight: 500; font-size: 14px; border-radius: 6px; padding: 14px 30px; cursor: pointer; border: 1px solid transparent; transition: 0.18s; font-family: var(--font-body); letter-spacing: 0.05em; }
  .ucv-btn--primary { background: var(--ok); color: var(--ink); font-weight: 600; box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35); }
  .ucv-btn--primary:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .ucv-btn--ghost { color: var(--tx-soft); border-color: #d5dad3; background: rgba(255, 255, 255, 0.5); }
  .ucv-btn--ghost:hover { border-color: var(--ok-ink); color: var(--tx); }

  /* hero 右 — 検証画面カード（スレート） */
  .ucv-ui { position: relative; overflow: hidden; border-radius: 14px; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); box-shadow: 0 26px 60px rgba(22, 30, 24, 0.28); }
  .ucv-ui::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(125% 78% at 92% -18%, rgba(168, 224, 16, 0.16), rgba(168, 224, 16, 0) 62%); }
  .ucv-ui > * { position: relative; z-index: 2; }
  .ucv-ui-bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; border-bottom: 1px solid #4a544b; }
  .ucv-ui-dot { width: 8px; height: 8px; border-radius: 50%; background: #4a544b; }
  .ucv-ui-url { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; color: #8b9285; margin-left: 6px; }
  .ucv-ui-body { padding: 20px 20px 18px; }
  .ucv-uv-head { display: flex; align-items: center; gap: 13px; margin-bottom: 16px; }
  .ucv-uv-seal { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; flex: none; border: 1.5px solid rgba(168, 224, 16, 0.55); background: rgba(168, 224, 16, 0.09); color: var(--ok); }
  .ucv-uv-t { font-family: var(--font-serif-jp); font-weight: 600; font-size: 17px; line-height: 1.45; color: #ebefe6; }
  .ucv-uv-en { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; color: #8b9285; margin-top: 4px; }
  .ucv-uv-row { display: flex; align-items: baseline; gap: 12px; padding: 8px 0; border-top: 1px solid rgba(74, 84, 75, 0.6); }
  .ucv-uv-row .l { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; color: #8b9285; flex: none; }
  .ucv-uv-row .r { font-size: 11.5px; line-height: 1.7; color: #e3e8dc; }
  .ucv-uv-chk { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 12px; padding-top: 11px; border-top: 1px solid #4a544b; font-size: 10.5px; color: #bcc3b6; }
  .ucv-uv-chk span::before { content: "✓ "; color: var(--ok); }

  /* ---------- section chrome ---------- */
  .ucv-band { padding: 52px 0 56px; }
  .ucv-band--deep { background: var(--lite-2); }
  .ucv-eye { display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .ucv-h2 { display: block; font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(23px, 2.7vw, 32px); line-height: 1.5; letter-spacing: 0.03em; color: var(--tx); margin: 0 0 18px; word-break: keep-all; }
  .ucv-band-lead { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); max-width: 62ch; margin: 0 0 22px; }
  .ucv-band-lead strong { color: var(--tx); font-weight: 600; }

  /* ---------- §1 personas ---------- */
  .ucv-personas { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 24px 0 0; padding: 0; }
  .ucv-persona { background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); padding: 20px 20px 18px; margin: 0; }
  .ucv-persona-avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--lite-2); color: var(--ok-light); margin-bottom: 12px; }
  .ucv-persona-role { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--ok-ink); margin-bottom: 8px; }
  .ucv-persona-quote { font-size: 13.5px; line-height: 1.85; color: var(--tx-soft); margin: 0; }
  .ucv-audience { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); max-width: 62ch; }

  /* ---------- §2 before/after ---------- */
  .ucv-emph { border-left: 3px solid var(--ok); padding-left: clamp(18px, 3vw, 34px); }
  .ucv-ba { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 16px; align-items: stretch; margin: 26px 0 0; }
  .ucv-ba-arrow { display: grid; place-items: center; color: var(--ok-light); font-size: 17px; }
  .ucv-ba-card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); overflow: hidden; display: flex; flex-direction: column; }
  .ucv-ba-card--after { border-color: rgba(124, 175, 0, 0.45); }
  .ucv-ba-label { display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); padding: 12px 18px 2px; }
  .ucv-ba-card--after .ucv-ba-label { color: var(--ok-light); }
  .ucv-ba-title { font-family: var(--font-serif-jp); font-weight: 600; font-size: 15.5px; color: var(--tx); padding: 0 18px 12px; border-bottom: 1px solid var(--line); }
  .ucv-ba-claim { font-size: 13.5px; line-height: 1.8; color: var(--tx-soft); padding: 14px 18px 0; margin: 0; }
  .ucv-ba-claim--prove { color: var(--tx); font-weight: 600; }
  .ucv-ba-rows { margin: 4px 0 0; padding: 0 18px; flex: 1; }
  .ucv-ba-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 9px 0; border-top: 1px solid var(--line); }
  .ucv-ba-row:first-child { border-top: none; }
  .ucv-ba-row dt { font-family: var(--font-mono); font-size: 11px; color: var(--muted); margin: 0; flex: none; }
  .ucv-ba-row dd { font-size: 13px; color: var(--tx); margin: 0; text-align: right; }
  .ucv-ba-strong { color: var(--ok-light); font-weight: 600; }
  .ucv-ba-badge { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: var(--ok-light); border: 1px solid rgba(124, 175, 0, 0.45); background: rgba(168, 224, 16, 0.1); border-radius: 999px; padding: 2px 10px; }
  .ucv-ba-flow { padding: 9px 18px; border-top: 1px solid var(--line); font-size: 11px; color: var(--muted); margin-top: 12px; }
  .ucv-ba-flow--after { color: var(--ok-light); }
  .ucv-ba--concept .ucv-ba-card > div:last-child { margin-top: auto; }

  .ucv-approach { margin: 30px 0 0; background: var(--lite-2); border-left: 3px solid var(--ok); border-radius: 0 10px 10px 0; padding: 20px 24px; }
  .ucv-band--deep .ucv-approach { background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--ok); }
  .ucv-approach p, .ucv-approach-body { font-size: 14px; line-height: 1.9; color: var(--tx-soft); margin: 0; }
  .ucv-approach-body :global(p) { margin: 0 0 10px; }
  .ucv-approach-body :global(p:last-child) { margin-bottom: 0; }
  .ucv-approach-link { display: inline-block; margin-top: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--ok-light); border-bottom: 1px solid rgba(124, 175, 0, 0.35); }
  .ucv-approach-link:hover { border-bottom-color: var(--ok-light); }

  /* ---------- §3 table ---------- */
  .ucv-table-wrap { overflow-x: auto; margin: 22px 0 0; }
  .ucv-table { width: 100%; border-collapse: collapse; font-size: 13px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--sh-s); }
  .ucv-table th { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; font-weight: 400; color: var(--muted); text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--dline-2); background: var(--card); }
  .ucv-table th:not(:first-child), .ucv-table td:not(:first-child) { text-align: center; }
  .ucv-table td { padding: 13px 14px; border-bottom: 1px solid var(--line); color: var(--tx-soft); line-height: 1.6; }
  .ucv-table tr:last-child td { border-bottom: none; }
  .ucv-table td.no { color: var(--err); }
  .ucv-table td.ok, .ucv-check { color: var(--ok-light); font-weight: 700; }
  .ucv-table .is-lemma td { background: var(--lite-2); }
  .ucv-table .is-lemma td:first-child { border-left: 3px solid var(--ok); }
  .ucv-lemma-name { font-weight: 600; color: var(--ok-light); }
  .ucv-only { display: inline-block; margin-left: 8px; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; color: #fff; background: var(--ok-light); border-radius: 999px; padding: 2px 8px; vertical-align: middle; }

  /* ---------- §4 steps ---------- */
  .ucv-steps-body { max-width: 76ch; }
  .ucv-steps-body :global(p) { font-size: 14.5px; line-height: 1.9; color: var(--tx-soft); margin: 0 0 14px; }
  .ucv-steps-body :global(ol) { list-style: none; counter-reset: ucstep; margin: 8px 0 0; padding: 0; }
  .ucv-steps-body :global(ol > li) { counter-increment: ucstep; position: relative; padding: 14px 0 14px 46px; border-bottom: 1px solid var(--line); font-size: 13.5px; line-height: 1.8; color: var(--tx-soft); }
  .ucv-steps-body :global(ol > li)::before { content: counter(ucstep, decimal-leading-zero); position: absolute; left: 0; top: 17px; font-family: var(--font-mono); font-size: 11px; color: var(--ok-light); }
  .ucv-steps-body :global(li strong) { color: var(--tx); font-weight: 600; }
  .ucv-steps-body :global(a) { color: var(--ok-light); border-bottom: 1px solid rgba(124, 175, 0, 0.35); }
  .ucv-uc-cta { margin-top: 30px; }
  .ucv-uc-cta-btn { display: inline-block; text-decoration: none; font-weight: 600; font-size: 14px; border-radius: 6px; padding: 14px 30px; border: 1px solid transparent; transition: 0.18s; letter-spacing: 0.05em; background: var(--ok); color: var(--ink); box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35); }
  .ucv-uc-cta-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }

  /* ---------- §5 related ---------- */
  .ucv-related { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 24px 0 0; padding: 0; max-width: 900px; }
  .ucv-related > li { margin: 0; padding: 0; }
  .ucv-related-card { position: relative; display: block; background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--sh-s); padding: 20px 22px 18px; transition: 0.18s; overflow: hidden; }
  .ucv-related-card::before { content: ""; position: absolute; top: 0; left: 0; width: 26px; height: 3px; background: var(--ok); transition: width 0.35s; }
  .ucv-related-card:hover { border-color: rgba(124, 175, 0, 0.45); transform: translateY(-2px); box-shadow: var(--sh-m); }
  .ucv-related-card:hover::before { width: 100%; }
  .ucv-related-icon { color: var(--ok-light); }
  .ucv-related-title { font-family: var(--font-serif-jp); font-weight: 600; font-size: 15px; line-height: 1.6; color: var(--tx); margin: 10px 0 6px; }
  .ucv-related-abstract { font-size: 12.5px; line-height: 1.8; color: var(--muted); margin: 0 0 10px; }
  .ucv-related-cta { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--ok-light); display: inline-block; transition: transform 0.18s; }
  .ucv-related-card:hover .ucv-related-cta { transform: translateX(3px); }
  .ucv-faq-link { margin: 26px 0 0; font-size: 12.5px; color: var(--muted); }
  .ucv-faq-link a { color: var(--ok-light); border-bottom: 1px solid rgba(124, 175, 0, 0.35); }

  /* ---------- closing ---------- */
  .ucv-closing { position: relative; overflow: hidden; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); padding: 72px 0 68px; text-align: center; }
  .ucv-closing::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 90% at 88% -20%, rgba(168, 224, 16, 0.16), rgba(168, 224, 16, 0) 62%); }
  .ucv-closing-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; padding: 0 6vw; }
  .ucv-closing-eyebrow { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.22em; color: #8b9285; margin: 0 0 14px; }
  .ucv-closing-h { font-family: var(--font-serif-jp); font-weight: 600; font-size: clamp(24px, 3vw, 34px); line-height: 1.5; letter-spacing: 0.03em; color: #ebefe6; margin: 0 0 14px; word-break: keep-all; }
  .ucv-closing-h .accent { color: var(--ok); }
  .ucv-closing-sub { font-size: 13.5px; line-height: 2; color: #bcc3b6; margin: 0 0 26px; }
  .ucv-closing-ctas { display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap; }
