      thMethod: "手段", thPass: "中身を出さず渡す", thVerify: "独立検証", thTamper: "書き換えを検知",
      rowAccess: "アクセス制御・権限管理", rowMask: "マスキング / 黒塗りで提出", rowEnc: "暗号化して保管・送付",
