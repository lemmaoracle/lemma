---
/**
 * §3 — Where this shows up in operations.
 *
 * Aligns with the v1 concept-hub mockup:
 *   - section eyebrow + 2-line H2
 *   - 2x2 grid of scenario cards (label · title · desc · UC link)
 *
 * Each card links to the matching use case slug when one is provided.
 */
import type { Locale, Translations } from "../../i18n/translations";
import type { Pillar } from "../../data/pillars";

interface Props {
  locale: Locale;
  base: string;
  pillar: Pillar;
  pillarT: Translations["pillars"];
}

const { locale, base, pillar, pillarT } = Astro.props as Props;
const hub = pillar.conceptHub;
if (!hub) return null;
const useCasesBase = base ? `${base}/solutions/use-cases` : "/solutions/use-cases";
const h2 = hub.sectionH2s[2];
---

<section class="pd-section pcs-section" id="scenarios" aria-label={pillarT.conceptSec3Label}>
  <div class="pd-section-label">{pillarT.conceptSec3Label}</div>
  {h2 && (
    <h2 class="pd-section-h2">
      {h2.head[locale]}<br />
      <span class="accent">{h2.accent[locale]}</span>
    </h2>
  )}

  <ul class="pcs-grid">
    {hub.scenarios.map((sc) => {
      const inner = (
        <Fragment>
          <div class="pcs-label">{sc.label[locale]}</div>
          <h3 class="pcs-title">{sc.title[locale]}</h3>
          <p class="pcs-desc">{sc.desc[locale]}</p>
          {sc.useCaseSlug && (
            <div class="pcs-link">{pillarT.conceptViewUseCase}</div>
          )}
        </Fragment>
      );
      return (
        <li>
          {sc.useCaseSlug ? (
            <a href={`${useCasesBase}/${sc.useCaseSlug}/`} class="pcs-item pcs-item--link">
              {inner}
            </a>
          ) : (
            <article class="pcs-item">{inner}</article>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .pcs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .pcs-grid > li {
    margin: 0;
  }
  .pcs-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 12px;
    padding: 22px 26px;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .pcs-item--link:hover {
    border-color: rgba(139, 69, 19, 0.4);
  }
  .pcs-label {
    font-family: var(--pd-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pcs-title {
    font-family: var(--pd-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.4;
    margin: 0;
  }
  .pcs-desc {
    font-size: 13px;
    line-height: 1.7;
    color: var(--pd-text-3);
    margin: 0;
    flex: 1;
  }
  .pcs-link {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-top: 6px;
  }

  @media (max-width: 720px) {
    .pcs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
