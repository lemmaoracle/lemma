---
/**
 * 4-pillar composition diagram — v2 redesign.
 *
 * Central "AI decision" node, four corner pillar nodes, dotted brown lines
 * connecting each corner to the center. Inline SVG so it scales without
 * an asset round-trip and so labels can be i18n-driven.
 */
import type { Locale, Translations } from "../../i18n/translations";

interface Props {
  locale: Locale;
  pillarT: Translations["pillars"];
}

const { locale, pillarT } = Astro.props as Props;

const corners = locale === "ja"
  ? [
      { num: "P1", label: "来歴" },
      { num: "P2", label: "AI 判断" },
      { num: "P3", label: "エージェント権限" },
      { num: "P4", label: "規制属性" },
    ]
  : [
      { num: "P1", label: "Origin" },
      { num: "P2", label: "AI Decision" },
      { num: "P3", label: "Agent Authority" },
      { num: "P4", label: "Regulatory Attribute" },
    ];
---

<section class="pcomp" aria-label={pillarT.compositionH2}>
  <div class="pcomp-label">{pillarT.compositionLabel}</div>
  <h2 class="pcomp-h2">{pillarT.compositionH2}</h2>

  <div class="pcomp-diagram">
    <svg
      viewBox="0 0 720 420"
      role="img"
      aria-labelledby="pcomp-svg-title"
      preserveAspectRatio="xMidYMid meet"
    >
      <title id="pcomp-svg-title">{pillarT.compositionH2}</title>

      <!-- Dotted brown lines: each corner ↔ center. Drawn first so they
           sit under the nodes. -->
      <g stroke="#8B4513" stroke-width="1" stroke-dasharray="3 5" fill="none" opacity="0.55">
        <line x1="120" y1="80" x2="360" y2="210" />
        <line x1="600" y1="80" x2="360" y2="210" />
        <line x1="120" y1="340" x2="360" y2="210" />
        <line x1="600" y1="340" x2="360" y2="210" />
      </g>

      <!-- Center node: AI decision -->
      <g>
        <rect
          x="260"
          y="170"
          width="200"
          height="80"
          rx="14"
          fill="#FCFAF5"
          stroke="#8B4513"
          stroke-width="1.2"
        />
        <text
          x="360"
          y="207"
          text-anchor="middle"
          font-family="'Space Mono', ui-monospace, monospace"
          font-size="10.5"
          letter-spacing="3.2"
          fill="#8B4513"
        >TRUST LAYER</text>
        <text
          x="360"
          y="234"
          text-anchor="middle"
          font-family="'Sora', sans-serif"
          font-size="18"
          font-weight="700"
          fill="#1a1a1a"
        >{pillarT.compositionCenterLabel}</text>
      </g>

      <!-- 4 corner nodes -->
      {[
        { x: 40,  y: 40,  d: corners[0] },
        { x: 520, y: 40,  d: corners[1] },
        { x: 40,  y: 300, d: corners[2] },
        { x: 520, y: 300, d: corners[3] },
      ].map(({ x, y, d }) => (
        <g>
          <rect
            x={x}
            y={y}
            width="160"
            height="80"
            rx="12"
            fill="#FFFFFF"
            stroke="#E5E5E5"
            stroke-width="0.5"
          />
          <rect
            x={x}
            y={y}
            width="36"
            height="2"
            fill="#8B4513"
          />
          <text
            x={x + 16}
            y={y + 30}
            font-family="'Space Mono', ui-monospace, monospace"
            font-size="10"
            letter-spacing="2.4"
            fill="#8B4513"
            font-weight="500"
          >{d.num}</text>
          <text
            x={x + 16}
            y={y + 56}
            font-family="'Sora', 'Noto Sans JP', sans-serif"
            font-size="14"
            font-weight="600"
            fill="#1a1a1a"
          >{d.label}</text>
        </g>
      ))}
    </svg>
  </div>

  <p class="pcomp-caption">{pillarT.compositionCaption}</p>
</section>

<style>
  .pcomp {
    margin: 64px 0 24px;
    padding: 48px 36px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .pcomp::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 96px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 3px;
  }
  .pcomp-label {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
  }
  .pcomp-h2 {
    font-family: var(--ph-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 0 auto 28px;
    max-width: 720px;
  }
  :root[lang="ja"] .pcomp-h2 {
    line-height: 1.4;
  }
  .pcomp-diagram {
    max-width: 720px;
    margin: 0 auto;
  }
  .pcomp-diagram svg {
    width: 100%;
    height: auto;
    max-width: 720px;
    display: block;
  }
  .pcomp-caption {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ph-text-4);
    margin: 22px 0 0;
  }

  @media (max-width: 720px) {
    .pcomp {
      padding: 36px 22px 28px;
    }
  }
</style>
