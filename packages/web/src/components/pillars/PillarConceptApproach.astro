---
/**
 * §2 — Lemma's role.
 *
 * Aligns with the v1 concept-hub mockup:
 *   - section eyebrow + 2-line H2
 *   - white-card block carrying a 1-paragraph lead, a 3-col bullets row,
 *     and an inline `approach-foot` link line at the bottom.
 *
 * No diagram. The 3-col bullets keep each role / distinction / availability
 * concept scannable in one row.
 */
import type { Locale, Translations } from "../../i18n/translations";
import type { Pillar } from "../../data/pillars";

interface Props {
  locale: Locale;
  base: string;
  pillar: Pillar;
  pillarT: Translations["pillars"];
}

const { locale, base, pillar, pillarT } = Astro.props as Props;
const hub = pillar.conceptHub;
if (!hub) return null;
const h2 = hub.sectionH2s[1];
---

<section class="pd-section pca-section" id="lemma-role" aria-label={pillarT.conceptSec2Label}>
  <div class="pd-section-label">{pillarT.conceptSec2Label}</div>
  {h2 && (
    <h2 class="pd-section-h2">
      {h2.head[locale]}<br />
      <span class="accent">{h2.accent[locale]}</span>
    </h2>
  )}

  <article class="pca-block">
    <p class="pca-lead">{hub.approach.lead[locale]}</p>

    <div class="pca-bullets">
      {hub.approach.bullets.map((b) => (
        <div class="pca-bullet">
          <div class="pca-bullet-label">{b.label[locale]}</div>
          <p class="pca-bullet-text">{b.text[locale]}</p>
        </div>
      ))}
    </div>

    {hub.approach.links.length > 0 && (
      <div class="pca-foot">
        →{" "}
        {hub.approach.links.map((link, i) => (
          <Fragment>
            {i > 0 && " / "}
            <a href={`${base}${link.href}`}>{link.label[locale]}</a>
          </Fragment>
        ))}
      </div>
    )}
  </article>
</section>

<style>
  .pca-block {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 32px 36px;
  }
  .pca-lead {
    font-size: 15px;
    line-height: 1.85;
    color: var(--pd-text-1);
    margin: 0 0 20px;
    max-width: 760px;
  }
  .pca-bullets {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    margin: 0 0 18px;
    padding: 22px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .pca-bullet {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pca-bullet-label {
    font-family: var(--pd-mono);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pca-bullet-text {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--pd-text-2);
    margin: 0;
  }
  .pca-bullet-text :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  .pca-foot {
    font-family: var(--pd-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin: 18px 0 0;
    padding-top: 18px;
    border-top: 0.5px solid var(--lemma-line);
  }
  .pca-foot a {
    color: var(--accent);
    text-decoration: none;
    transition: text-decoration 0.15s;
  }
  .pca-foot a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .pca-block {
      padding: 26px 22px;
    }
    .pca-bullets {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
