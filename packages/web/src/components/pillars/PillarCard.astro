---
/**
 * Pillar hub card — v2 redesign.
 *
 * Demotes the v1 poetic "X ≠ Y" tagline to an auxiliary line beside the
 * Pillar number eyebrow. The new primary message is the plain-language
 * elevator. The poetic subline sits below the elevator, separated by a
 * dashed brown rule.
 */
import type { Locale } from "../../i18n/translations";
import type { Pillar } from "../../data/pillars";

interface Props {
  locale: Locale;
  pillar: Pillar;
  href: string;
  ctaLabel: string;
}

const { locale, pillar, href, ctaLabel } = Astro.props as Props;
const numLabel = `Pillar ${String(pillar.order).padStart(2, "0")}`;
const subTitle = locale === "ja" ? pillar.title.en : pillar.title.ja;
---

<a href={href} class="pc-card">
  <div class="pc-eyebrow">
    <span class="pc-num">{numLabel}</span>
    <span class="pc-tag">{pillar.slogan[locale]}</span>
  </div>
  <h2 class="pc-title">{pillar.title[locale]}</h2>
  <div class="pc-title-sub">{subTitle}</div>
  <p class="pc-plain">{pillar.plainElevator[locale]}</p>
  <p class="pc-poetic">{pillar.subtitle[locale]}</p>
  <span class="pc-cta">{ctaLabel}</span>
</a>

<style>
  .pc-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 32px 32px 28px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
    height: 100%;
  }
  .pc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 48px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .pc-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .pc-card:hover::before {
    width: 100%;
  }

  /* Eyebrow: P-number (primary, mono brown) + poetic X ≠ Y (auxiliary,
     italic grey with a thin left rule separating it from the number). */
  .pc-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 4px;
  }
  .pc-num {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    flex-shrink: 0;
  }
  .pc-tag {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    font-style: italic;
    letter-spacing: 0.04em;
    color: var(--ph-text-4);
    padding-left: 14px;
    border-left: 0.5px solid var(--lemma-line);
  }

  .pc-title {
    font-family: var(--ph-display);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--black);
    letter-spacing: -0.025em;
    margin: 8px 0 0;
  }
  .pc-title-sub {
    font-family: var(--ph-display);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0;
    margin: 0 0 6px;
  }

  /* Plain elevator — the new primary message. */
  .pc-plain {
    font-family: var(--ph-display);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--ph-text-1);
    letter-spacing: -0.005em;
    margin: 8px 0 0;
  }

  /* Poetic subline — kept as a small italic tail under the elevator,
     separated by a dashed brown rule. */
  .pc-poetic {
    font-size: 13px;
    font-style: italic;
    line-height: 1.7;
    color: var(--ph-text-3);
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-top: 1px dashed rgba(139, 69, 19, 0.28);
  }

  .pc-cta {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 18px;
    transition: transform 0.2s;
  }
  .pc-card:hover .pc-cta {
    transform: translateX(3px);
  }

  @media (max-width: 720px) {
    .pc-card {
      padding: 28px 24px 24px;
    }
    .pc-title {
      font-size: 26px;
    }
  }
</style>
