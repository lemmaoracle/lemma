---
/**
 * §4 — Further reading.
 *
 * Aligns with the v1 concept-hub mockup:
 *   - section eyebrow + 2-line H2
 *   - 4-column navigation hub (Brief / Use Case / Product / Specs)
 *
 * No "Try" CTA — the surface is "next destination" only. Each card
 * points to a category top.
 */
import type { Locale, Translations } from "../../i18n/translations";
import type { Pillar } from "../../data/pillars";

interface Props {
  locale: Locale;
  base: string;
  pillar: Pillar;
  pillarT: Translations["pillars"];
}

const { locale, base, pillar, pillarT } = Astro.props as Props;
const hub = pillar.conceptHub;
if (!hub) return null;
const h2 = hub.sectionH2s[3];
---

<section class="pd-section pcf-section" id="further" aria-label={pillarT.conceptSec4Label}>
  <div class="pd-section-label">{pillarT.conceptSec4Label}</div>
  {h2 && (
    <h2 class="pd-section-h2">
      {h2.head[locale]}<br />
      <span class="accent">{h2.accent[locale]}</span>
    </h2>
  )}

  <ul class="pcf-grid">
    {hub.further.map((item) => (
      <li>
        <a href={`${base}${item.href}`} class="pcf-card">
          <div class="pcf-label">{item.label[locale]}</div>
          <h3 class="pcf-title">{item.title[locale]}</h3>
          <p class="pcf-desc">{item.desc[locale]}</p>
          <div class="pcf-link">→</div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .pcf-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 14px;
  }
  .pcf-grid > li {
    margin: 0;
  }
  .pcf-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 12px;
    padding: 22px 24px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
  }
  .pcf-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
  }
  .pcf-label {
    font-family: var(--pd-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pcf-title {
    font-family: var(--pd-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.4;
    margin: 0;
  }
  .pcf-desc {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--pd-text-3);
    margin: 0;
    flex: 1;
  }
  .pcf-link {
    font-family: var(--pd-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 12px;
    border-top: 0.5px solid var(--lemma-line);
  }

  @media (max-width: 880px) {
    .pcf-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .pcf-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
