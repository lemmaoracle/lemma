---
/**
 * §1 — Why this is its own category.
 *
 * Aligns with the v1 concept-hub mockup:
 *   - section eyebrow + 2-line H2 (head + brown accent span)
 *   - intro narrative paragraph
 *   - vertical list of horizontal incident cards (date | title+desc | link)
 *   - single cream-deep regulatory row (mono label + dashed-separated items)
 *
 * No diagrams, no 2x2 grid, no chips — the surface here is
 * "this category exists because these things happened."
 */
import type { Locale, Translations } from "../../i18n/translations";
import type { Pillar } from "../../data/pillars";

interface Props {
  locale: Locale;
  base: string;
  pillar: Pillar;
  pillarT: Translations["pillars"];
}

const { locale, base, pillar, pillarT } = Astro.props as Props;
const hub = pillar.conceptHub;
if (!hub) return null;
const briefBase = base ? `${base}/critical/briefs` : "/critical/briefs";
const h2 = hub.sectionH2s[0];
---

<section class="pd-section pci-section" id="why-category" aria-label={pillarT.conceptSec1Label}>
  <div class="pd-section-label">{pillarT.conceptSec1Label}</div>
  {h2 && (
    <h2 class="pd-section-h2">
      {h2.head[locale]}<br />
      <span class="accent">{h2.accent[locale]}</span>
    </h2>
  )}
  <p class="pci-intro">{hub.intro[locale]}</p>

  <div class="pci-list">
    {hub.incidents.map((incident) => {
      const inner = (
        <Fragment>
          <div class="pci-date">{incident.date}</div>
          <div class="pci-title">
            <strong>{incident.title[locale]}</strong>
            <span class="pci-desc"> — {incident.desc[locale]}</span>
          </div>
          {incident.briefSlug && <div class="pci-link">{pillarT.conceptReadBrief}</div>}
        </Fragment>
      );
      return incident.briefSlug ? (
        <a class="pci-item pci-item--link" href={`${briefBase}/${incident.briefSlug}/`}>
          {inner}
        </a>
      ) : (
        <article class="pci-item">{inner}</article>
      );
    })}
  </div>

  <div class="pci-reg">
    <span class="pci-reg-label">{pillarT.conceptRegulatoryHeading}</span>
    {hub.regulatory[locale].map((item) => (
      <span class="pci-reg-item">{item}</span>
    ))}
  </div>
</section>

<style>
  .pci-intro {
    font-size: 15px;
    line-height: 1.85;
    color: var(--pd-text-2);
    margin: 0 0 28px;
    max-width: 720px;
  }
  .pci-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0 0 24px;
  }
  .pci-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: center;
    gap: 24px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 22px 26px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .pci-item--link:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateX(2px);
  }
  .pci-date {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
  .pci-title {
    font-family: var(--pd-display);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--black);
    margin: 0;
  }
  .pci-title :global(strong) {
    font-weight: 600;
  }
  .pci-desc {
    color: var(--pd-text-3);
    font-weight: 400;
  }
  .pci-link {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--accent);
    white-space: nowrap;
  }

  /* Regulatory row — single cream-deep band, mono label + items separated
     by hairline left borders. */
  .pci-reg {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    background: var(--lemma-cream-deep);
    border-radius: 10px;
    padding: 18px 22px;
  }
  .pci-reg-label {
    font-family: var(--pd-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pd-text-4);
  }
  .pci-reg-item {
    font-family: var(--pd-display);
    font-size: 13px;
    color: var(--pd-text-1);
    padding-left: 14px;
    border-left: 1px solid var(--lemma-line);
  }

  @media (max-width: 720px) {
    .pci-item {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 18px 22px;
    }
    .pci-link {
      padding-top: 8px;
      border-top: 0.5px solid var(--lemma-line);
    }
  }
</style>
