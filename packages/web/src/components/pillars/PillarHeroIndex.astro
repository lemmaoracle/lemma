---
/**
 * Pillars hub hero — v2 redesign.
 *
 * Mono "信頼レイヤー" eyebrow + 2-line H1 + 4-sentence setup paragraph +
 * 4-questions block. Each question card is left-anchored by a 2px brown
 * rule and reads: tag → stem (display) → answer (subdued body).
 */
import type { Locale, Translations } from "../../i18n/translations";

interface Props {
  locale: Locale;
  pillarT: Translations["pillars"];
}

const { locale, pillarT } = Astro.props as Props;
---

<section class="phi-hero">
  <div class="phi-eyebrow">{pillarT.title}</div>
  <h1 class="phi-h1">
    {pillarT.heroH1Lines.map((line, i) => (
      <Fragment>
        {i > 0 && <br />}
        {line}
      </Fragment>
    ))}
  </h1>
  <p class="phi-hero-sub">{pillarT.heroSub}</p>
</section>

<section class="phi-questions" aria-label={pillarT.questionsLabel}>
  <div class="phi-questions-label">{pillarT.questionsLabel}</div>
  <ul class="phi-questions-grid">
    {pillarT.questions.map((q) => (
      <li class="phi-question">
        <div class="phi-question-tag">{q.tag}</div>
        <p class="phi-question-stem">{q.stem}</p>
        <p class="phi-question-answer">{q.answer}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .phi-hero {
    padding: 60px 0 36px;
  }
  .phi-eyebrow {
    font-family: var(--ph-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ph-text-3);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .phi-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .phi-h1 {
    font-family: var(--ph-display);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--black);
    margin: 0 0 26px;
    max-width: 920px;
  }
  :root[lang="ja"] .phi-h1 {
    line-height: 1.18;
  }
  .phi-hero-sub {
    font-size: 16px;
    color: var(--ph-text-2);
    margin: 0;
    line-height: 1.85;
    max-width: 720px;
  }

  /* ─── QUESTIONS BLOCK ─── */
  .phi-questions {
    margin: 24px 0 56px;
  }
  .phi-questions-label {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ph-text-4);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .phi-questions-label::before {
    content: "";
    display: inline-block;
    width: 18px;
    height: 1px;
    background: var(--lemma-line);
  }
  .phi-questions-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 28px;
  }
  .phi-question {
    padding: 4px 0 6px 16px;
    border-left: 2px solid var(--accent);
  }
  .phi-question-tag {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 6px;
  }
  .phi-question-stem {
    font-family: var(--ph-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--black);
    letter-spacing: -0.015em;
    margin: 0 0 4px;
  }
  .phi-question-answer {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ph-text-3);
    margin: 0;
  }

  @media (max-width: 720px) {
    .phi-hero {
      padding: 40px 0 28px;
    }
    .phi-questions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
