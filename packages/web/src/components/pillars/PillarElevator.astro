---
/**
 * Pillar elevator block — v2 redesign Stage 2.
 *
 * Cream-deep card with a 64px brown top-bar accent. Carries the plain-
 * language elevator as a 22px Sora lead (new copy added in Stage 1 data
 * extension), followed by the existing problemStatement HTML as the
 * 14.5px context paragraph.
 *
 * Placed right under the hero so the page opens with "what Lemma actually
 * does" before any section numbering begins. The block itself is not a
 * numbered .pd-section — the §N counter starts from the first numbered
 * section after this card.
 */
import type { Locale } from "../../i18n/translations";
import type { Pillar } from "../../data/pillars";

interface Props {
  locale: Locale;
  pillar: Pillar;
}

const { locale, pillar } = Astro.props as Props;
---

<section class="pe-block" aria-label={pillar.title[locale]}>
  <p class="pe-lead">{pillar.plainElevator[locale]}</p>
  <div class="pe-context" set:html={pillar.problemStatement[locale]} />
</section>

<style>
  .pe-block {
    margin: 24px 0 40px;
    padding: 36px 36px 32px;
    background: var(--lemma-cream-deep);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }
  .pe-block::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .pe-lead {
    font-family: var(--pd-display);
    font-size: clamp(19px, 2.2vw, 22px);
    font-weight: 500;
    line-height: 1.5;
    color: var(--black);
    letter-spacing: -0.015em;
    margin: 0 0 20px;
    max-width: 760px;
  }
  :root[lang="ja"] .pe-lead {
    line-height: 1.65;
  }
  .pe-context {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--pd-text-2);
    margin: 0;
    max-width: 760px;
  }
  .pe-context :global(p) {
    margin: 0 0 12px;
  }
  .pe-context :global(p:last-child) {
    margin-bottom: 0;
  }
  .pe-context :global(strong) {
    color: var(--black);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .pe-block {
      padding: 28px 22px 24px;
    }
  }
</style>
