---
/**
 * 記事の入口（2026-10-24）。日本語はセルフチェックのページへ（この記事の
 * 項目から始まる）、英語は定期のメールの登録へ。チェックリストのあとの帯と、TL;DR の
 * あとの 1 行の 2 か所（variant）。
 *
 * 対策の章を「続きは登録で」にする案も検討したが、検索から対策を探しに来た
 * 人を答えの手前で止めることになるので、本文は全部読めるままにした。
 * 点検表を Excel で配ると一気に出回るので、ファイルは渡さず画面で答えて
 * もらい、不安になった人からメールの相談を受ける。
 * 描画は記事の外で、ページを開いたときに rehype が置く目印
 * （`[data-brief-weekly-slot]` / `[data-brief-weekly-top-slot]`）へ移す。目印が
 * 無ければ出さない。行き先は config/cta.ts（`ref` で置き場所を分ける）。
 */
import {
  BRIEF_CHECKLIST_CTA_URL,
  BRIEF_DEMO_CTA_URL,
  BRIEF_TLDR_CTA_URL,
  CONSULT_FORM_URL,
  SELF_CHECK_PAGES,
  selfCheckPageFor,
} from "../config/cta";

export interface BriefWeeklyCtaProps {
  locale: "ja" | "en";
  briefId: string;
  /**
   * checklist：チェックリストのあと（帯）。top：TL;DR のあと（1 行の小さな入口）。
   * demo：proof の章立ての「いまの対策と Lemma の違い」の表のあと（導入の相談・デモ・2026-11-01）。
   */
  variant: "checklist" | "top" | "demo";
  /** 被害を受けた個人向けの窓口（frontmatter victim_desk）。あると top は相談でなく窓口の案内になる。 */
  victimDesk?: { ja: string; en: string; url: string };
  /** 記事の業務（frontmatter の operations）。飛ばすページと言い方を決める。 */
  operations?: ReadonlyArray<string>;
}

const { locale, briefId, variant, victimDesk, operations = [] } = Astro.props as BriefWeeklyCtaProps;
const isJa = locale === "ja";
// 日本語は、題材の合うセルフチェックのページがあればそこへ（いまは振込先の書き換え・
// 送金の事案だけ）。無ければメールの相談が主（2026-10-25）。英語は Tally。
const pageKey = isJa ? selfCheckPageFor(operations) : null;
const isConsult = isJa && pageKey === null;
const consultFor = (ref: string) =>
  `${CONSULT_FORM_URL}&ref=${ref}&from=${encodeURIComponent(briefId)}`;
const base = pageKey
  ? SELF_CHECK_PAGES[pageKey].path
  : isConsult
    ? consultFor(variant === "top" ? "brief_tldr" : "brief_band")
    : (variant === "top" ? BRIEF_TLDR_CTA_URL : BRIEF_CHECKLIST_CTA_URL)[locale];
const isRemittance = pageKey === "remittance";
// サイトの中のセルフチェックは同じタブ・この記事を ?from= で渡す。Tally は新しいタブ。
const external = base.startsWith("http");
const href = external ? base : `${base}?from=${encodeURIComponent(briefId)}`;
// セルフチェックの帯にだけ、メールの相談への 1 行（セルフチェックを経ずに聞きたい人へ）。
const consultHref = consultFor("brief_band");
// 押した数を分けて見る（セルフチェックへ／相談へ）。
const ev = isConsult
  ? variant === "top"
    ? "brief_tldr_consult"
    : "brief_checklist_consult"
  : variant === "top"
    ? "brief_tldr_weekly"
    : "brief_checklist_weekly";
// セルフチェックはチェックの印、メール（相談・英語の定期のメール）は封筒。
const icon = isJa && !isConsult
  ? '<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="15" height="15" rx="3" /><path d="M7.5 11.2l2.4 2.4 4.8-5" /></svg>'
  : '<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="16" height="12" rx="2" /><path d="M3.5 6l7.5 6 7.5-6" /></svg>';
const isDemo = variant === "demo";
const demoHref = isDemo ? BRIEF_DEMO_CTA_URL[locale] + `&from=${encodeURIComponent(briefId)}` : "";
// 誰向けかは本文の「注意したい業界・業務」が持つ（2026-11-01）。Proof Gate の製品ページが出たら、行き先をゲートのページにする。
const D = isJa
  ? {
      head: "Lemma の照合を、自社の業務で試す",
      sub: "どの操作の前に何を照合するかを、導入の相談やデモで具体的にご説明します。",
      btn: "導入相談・デモを依頼する",
    }
  : {
      head: "See Lemma's pre-execution check on your own workflow",
      sub: "We walk through which operations to check, and how, in an adoption call or demo.",
      btn: "Request a demo or adoption call",
    };
// 被害を受けた個人の読者が多い事案では、要点のあとの 1 行を当事者の窓口の案内にする。
const desk = variant === "top" && victimDesk ? { text: isJa ? victimDesk.ja : victimDesk.en, url: victimDesk.url } : null;
const L = isJa && isRemittance
  ? {
      head: "なりすましの不正送金が自社で通らないか、チェックする",
      sub: "振込先の書き換えや送金の指示について、実際の事案から作った項目に、はい／いいえで答えるだけ。お急ぎなら 3 分。登録は要りません。",
      btn: "不正送金の対策をチェックする",
      top: "なりすましの不正送金が自社で通らないか、チェックする（登録不要・3 分から）",
    }
  : isJa
  ? {
      head: "この手口が自社で起きないか、メールで相談する",
      sub: "この記事の手口について、自社の場合はどうかを、メールで無料で相談できます。",
      btn: "メールで相談する（無料）",
      top: "この手口について、自社の場合をメールで相談する（無料）",
    }
  : {
      head: "Get checks like these and new cases by email",
      sub: "New Critical Briefs and the points worth checking in your own organization, delivered regularly.",
      btn: "Get it by email",
      top: "Get new cases and checks like these by email",
    };
---

{desk ? (
  <p class="wk-desk" data-brief-weekly="top" data-brief={briefId}>
    <a href={desk.url} target="_blank" rel="noopener">{desk.text}</a>
  </p>
) : isDemo ? (
  <aside class="wk wk--demo" data-brief-weekly="demo" data-brief={briefId} aria-label={D.head}>
    <span class="wk-ic" aria-hidden="true">
      <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3.2l6.3 2.4v5c0 3.9-2.6 6.6-6.3 8.2-3.7-1.6-6.3-4.3-6.3-8.2v-5z" /><path d="M8 11.2l2.2 2.2 4-4.2" /></svg>
    </span>
    <span class="wk-tx">
      <b>{D.head}</b>
      <span>{D.sub}</span>
    </span>
    <a class="wk-btn" href={demoHref} target="_blank" rel="noopener" data-wk-ev="brief_table_demo">{D.btn}<span aria-hidden="true"> →</span></a>
  </aside>
) : variant === "checklist" ? (
  <aside class="wk" data-brief-weekly="checklist" data-brief={briefId} aria-label={L.head}>
    <span class="wk-ic" aria-hidden="true">
      <Fragment set:html={icon} />
    </span>
    <span class="wk-tx">
      <b>{L.head}</b>
      <span>{L.sub}</span>
      {isJa && !isConsult && (
        <a class="wk-consult" href={consultHref} target="_blank" rel="noopener" data-wk-ev="brief_band_consult">この手口について、メールで相談する（無料）</a>
      )}
    </span>
    <a class="wk-btn" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined} data-wk-ev={ev}>{L.btn}<span aria-hidden="true"> →</span></a>
  </aside>
) : (
  <a class="wk-top" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined} data-brief-weekly="top" data-brief={briefId} data-wk-ev={ev}>
    <span class="wk-ic wk-ic--s" aria-hidden="true">
      <Fragment set:html={icon} />
    </span>
    <span>{L.top}</span><span aria-hidden="true">→</span>
  </a>
)}

<script is:inline define:vars={{ variant }}>
  (function () {
    var box = document.querySelector('[data-brief-weekly="' + variant + '"]');
    if (!box) return;
    var slot = document.querySelector(
      variant === "top"
        ? "[data-brief-weekly-top-slot]"
        : variant === "demo"
          ? "[data-brief-demo-slot]"
          : "[data-brief-weekly-slot]",
    );
    if (!slot) {
      box.remove();
      return;
    }
    slot.replaceWith(box);
    var btns = box.matches("[data-wk-ev]") ? [box] : Array.prototype.slice.call(box.querySelectorAll("[data-wk-ev]"));
    btns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        if (typeof window.gtag !== "function") return;
        window.gtag("event", btn.getAttribute("data-wk-ev"), {
          brief_id: box.getAttribute("data-brief"),
          destination: btn.getAttribute("href"),
        });
      });
    });
  })();
</script>

<style>
  .wk {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 18px 0 8px;
    padding: 16px 18px;
    background: #eef7d2;
    border: 1px solid #d4e6a6;
    border-radius: 14px;
  }
  /* 被害を受けた個人向けの窓口の案内（相談の入口ではない・小さく静かに）。 */
  .wk-desk {
    margin: 4px 0 8px;
    padding: 10px 2px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--tx-soft);
  }
  .wk-desk a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* 導入の相談・デモ：表のすぐ下なので、メールの相談の帯（淡い緑）と見分けがつく白地。 */
  .wk--demo {
    background: #fff;
    border-color: #c9de8f;
  }
  .wk--demo .wk-ic {
    background: #eef7d2;
  }
  .wk-ic {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #fff;
    color: #2f372f;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wk-ic svg {
    width: 22px;
    height: 22px;
  }
  .wk-tx {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .wk-tx b {
    font-size: 15px;
    color: var(--tx);
    font-weight: 700;
    line-height: 1.5;
    color: var(--tx);
  }
  .wk-tx span {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--tx-soft);
  }
  /* 本文の中に入るので、本文のリンク色・下線に負けないよう a まで書く。 */
  .wk a.wk-consult {
    margin-top: 4px;
    font-size: 12.5px;
    font-weight: 600;
    color: #4e7a00;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wk a.wk-btn {
    margin-left: auto;
    flex: none;
    white-space: nowrap;
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    background: #2f372f;
    border-radius: 999px;
    padding: 10px 16px;
    text-decoration: none;
  }
  .wk a.wk-btn:hover {
    background: #1d231c;
    color: #fff;
  }
  /* TL;DR のあとの 1 行（読み始めを邪魔しない小ささ）。 */
  a.wk-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 8px;
    padding: 10px 2px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tx-soft);
    text-decoration: none;
  }
  a.wk-top:hover span:not(.wk-ic) {
    text-decoration: underline;
  }
  .wk-ic--s {
    width: 28px;
    height: 28px;
    background: #eef7d2;
  }
  .wk-ic--s svg {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 760px) {
    .wk {
      flex-wrap: wrap;
      padding: 14px;
    }
    .wk a.wk-btn {
      margin-left: 0;
      width: 100%;
      text-align: center;
      padding: 12px 16px;
    }
  }
</style>
