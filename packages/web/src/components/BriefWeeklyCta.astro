---
/**
 * 定期的なメールの入口（2026-10-24）。チェックリストのあとの帯と、TL;DR の
 * あとの 1 行の 2 か所（variant）。
 *
 * 対策の章を「続きは登録で」にする案も検討したが、検索から対策を探しに来た
 * 人を答えの手前で止めることになるので、本文は全部読めるままにした。
 * 登録は、持ち帰る価値（新しい事例と点検の項目）で受ける。
 * 描画は記事の外で、ページを開いたときに rehype が置く目印
 * （`[data-brief-weekly-slot]` / `[data-brief-weekly-top-slot]`）へ移す。目印が
 * 無ければ出さない。行き先は config/cta.ts（`ref` で置き場所を分ける）。
 */
import { BRIEF_CHECKLIST_CTA_URL, BRIEF_TLDR_CTA_URL } from "../config/cta";

export interface BriefWeeklyCtaProps {
  locale: "ja" | "en";
  briefId: string;
  /** checklist：チェックリストのあと（帯）。top：TL;DR のあと（1 行の小さな入口）。 */
  variant: "checklist" | "top";
}

const { locale, briefId, variant } = Astro.props as BriefWeeklyCtaProps;
const href = (variant === "top" ? BRIEF_TLDR_CTA_URL : BRIEF_CHECKLIST_CTA_URL)[locale];
const isJa = locale === "ja";
const L = isJa
  ? {
      head: "この点検の項目と、新しい事例をメールで受け取る",
      sub: "新しい Critical Brief と、自社で照合したい点を定期的にお届けします。",
      btn: "メールで受け取る",
      top: "新しい事例と点検の項目を、定期的にメールで受け取る",
    }
  : {
      head: "Get checks like these and new cases by email",
      sub: "New Critical Briefs and the points worth checking in your own organization, delivered regularly.",
      btn: "Get it by email",
      top: "Get new cases and checks like these by email",
    };
---

{variant === "checklist" ? (
  <aside class="wk" data-brief-weekly="checklist" data-brief={briefId} aria-label={L.head}>
    <span class="wk-ic" aria-hidden="true">
      <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="16" height="12" rx="2" /><path d="M3.5 6l7.5 6 7.5-6" /></svg>
    </span>
    <span class="wk-tx">
      <b>{L.head}</b>
      <span>{L.sub}</span>
    </span>
    <a class="wk-btn" href={href} target="_blank" rel="noopener" data-wk-ev="brief_checklist_weekly">{L.btn}<span aria-hidden="true"> →</span></a>
  </aside>
) : (
  <a class="wk-top" href={href} target="_blank" rel="noopener" data-brief-weekly="top" data-brief={briefId} data-wk-ev="brief_tldr_weekly">
    <span class="wk-ic wk-ic--s" aria-hidden="true">
      <svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="16" height="12" rx="2" /><path d="M3.5 6l7.5 6 7.5-6" /></svg>
    </span>
    <span>{L.top}</span><span aria-hidden="true">→</span>
  </a>
)}

<script is:inline define:vars={{ variant }}>
  (function () {
    var box = document.querySelector('[data-brief-weekly="' + variant + '"]');
    if (!box) return;
    var slot = document.querySelector(
      variant === "top" ? "[data-brief-weekly-top-slot]" : "[data-brief-weekly-slot]",
    );
    if (!slot) {
      box.remove();
      return;
    }
    slot.replaceWith(box);
    var btn = box.matches("[data-wk-ev]") ? box : box.querySelector("[data-wk-ev]");
    if (btn)
      btn.addEventListener("click", function () {
        if (typeof window.gtag !== "function") return;
        window.gtag("event", btn.getAttribute("data-wk-ev"), {
          brief_id: box.getAttribute("data-brief"),
          destination: btn.getAttribute("href"),
        });
      });
  })();
</script>

<style>
  .wk {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 18px 0 8px;
    padding: 16px 18px;
    background: #eef7d2;
    border: 1px solid #d4e6a6;
    border-radius: 14px;
  }
  .wk-ic {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #fff;
    color: #2f372f;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wk-ic svg {
    width: 22px;
    height: 22px;
  }
  .wk-tx {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .wk-tx b {
    font-size: 15px;
    color: var(--tx);
    font-weight: 700;
    line-height: 1.5;
    color: var(--tx);
  }
  .wk-tx span {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--tx-soft);
  }
  /* 本文の中に入るので、本文のリンク色・下線に負けないよう a まで書く。 */
  .wk a.wk-btn {
    margin-left: auto;
    flex: none;
    white-space: nowrap;
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    background: #2f372f;
    border-radius: 999px;
    padding: 10px 16px;
    text-decoration: none;
  }
  .wk a.wk-btn:hover {
    background: #1d231c;
    color: #fff;
  }
  /* TL;DR のあとの 1 行（読み始めを邪魔しない小ささ）。 */
  a.wk-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 8px;
    padding: 10px 2px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tx-soft);
    text-decoration: none;
  }
  a.wk-top:hover span:not(.wk-ic) {
    text-decoration: underline;
  }
  .wk-ic--s {
    width: 28px;
    height: 28px;
    background: #eef7d2;
  }
  .wk-ic--s svg {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 760px) {
    .wk {
      flex-wrap: wrap;
      padding: 14px;
    }
    .wk a.wk-btn {
      margin-left: 0;
      width: 100%;
      text-align: center;
      padding: 12px 16px;
    }
  }
</style>
