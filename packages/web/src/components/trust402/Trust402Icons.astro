---
/**
 * Trust402 icon sprite (agent robot + research glyphs), recolored from
 * the live site's agent figure for the fluorescent-green sub-brand.
 * Render once per page; reference with
 *   <svg class="ic ..."><use href="#ic-robot" /></svg>
 * Outline stroke uses currentColor; green accents use var(--green) /
 * var(--ink), so the sprite must live inside the .t402 token scope.
 */
---

<style is:global>
  /* Robot eyes: green so they read on both the dark hero and light sections
     (unstyled they default to black and vanish on dark). --green cascades
     from the .t402 scope the sprite renders inside. */
  .robot-eye { fill: var(--green); }
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <symbol id="ic-robot" viewBox="0 0 58 80">
    <circle cx="29" cy="4" r="3" class="robot-eye"></circle>
    <line x1="29" y1="7" x2="29" y2="16" stroke="currentColor" stroke-width="2.2"></line>
    <rect x="1.5" y="16" width="55" height="56" rx="9" fill="none" stroke="currentColor" stroke-width="2.4"></rect>
    <circle cx="20" cy="39" r="4" class="robot-eye"></circle>
    <circle cx="38" cy="39" r="4" class="robot-eye"></circle>
    <line x1="21" y1="57" x2="37" y2="57" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></line>
  </symbol>
  <symbol id="ic-robot-proof" viewBox="0 0 74 80">
    <circle cx="29" cy="4" r="3" class="robot-eye"></circle>
    <line x1="29" y1="7" x2="29" y2="16" stroke="currentColor" stroke-width="2.2"></line>
    <rect x="1.5" y="16" width="55" height="56" rx="9" fill="none" stroke="currentColor" stroke-width="2.4"></rect>
    <circle cx="20" cy="39" r="4" class="robot-eye"></circle>
    <circle cx="38" cy="39" r="4" class="robot-eye"></circle>
    <line x1="21" y1="57" x2="37" y2="57" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></line>
    <circle cx="58" cy="60" r="14" fill="var(--green)"></circle>
    <text x="58" y="65" text-anchor="middle" font-family="Sora,sans-serif" font-size="12" font-weight="700" fill="var(--ink)">ZK</text>
  </symbol>
  <symbol id="ic-signed" viewBox="0 0 58 80">
    <rect x="8" y="5" width="40" height="60" rx="5" fill="none" stroke="currentColor" stroke-width="2.4"></rect>
    <line x1="16" y1="19" x2="40" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    <line x1="16" y1="27" x2="40" y2="27" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    <line x1="16" y1="35" x2="30" y2="35" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    <circle cx="42" cy="60" r="15" fill="var(--green)"></circle>
    <path d="M35 60 l5 5 l9 -10" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  </symbol>
  <symbol id="ic-network" viewBox="0 0 52 52">
    <circle cx="13" cy="13" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <circle cx="39" cy="13" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <circle cx="26" cy="38" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <line x1="18" y1="16" x2="22" y2="32" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></line>
    <line x1="34" y1="16" x2="30" y2="32" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></line>
    <line x1="19" y1="13" x2="33" y2="13" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.5" stroke-dasharray="3 3"></line>
  </symbol>
  <symbol id="ic-github" viewBox="0 0 52 52">
    <path d="M26 4 C13.85 4 4 13.85 4 26 c0 9.72 6.305 17.962 15.05 20.873 c1.1 .2 1.5-.475 1.5-1.062 c0-.525-.02-1.92-.03-3.767 c-6.12 1.33-7.41-2.95-7.41-2.95 c-.99-2.53-2.42-3.2-2.42-3.2 c-1.98-1.354 .15-1.327 .15-1.327 c2.19.154 3.34 2.247 3.34 2.247 c1.94 3.327 5.1 2.367 6.35 1.811 c.2-1.41 .76-2.367 1.38-2.91 c-4.88-.554-10.02-2.444-10.02-10.87 c0-2.4 .86-4.37 2.27-5.91 c-.23-.554-.99-2.79 .21-5.82 c0 0 1.85-.59 6.07 2.26 a21.13 21.13 0 0 1 5.52-.74 c1.87.008 3.76.252 5.52.74 c4.22-2.85 6.07-2.26 6.07-2.26 c1.2 3.03 .45 5.27 .22 5.82 c1.41 1.54 2.27 3.51 2.27 5.91 c0 8.45-5.15 10.31-10.05 10.86 c.79.68 1.49 2.03 1.49 4.09 c0 2.95-.026 5.32-.026 6.04 c0 .59.4 1.27 1.51 1.06 C41.7 43.962 48 35.722 48 26 C48 13.85 38.15 4 26 4 z" fill="currentColor"></path>
  </symbol>
  <symbol id="ic-dataset" viewBox="0 0 52 52">
    <rect x="6" y="9" width="40" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="2.4"></rect>
    <line x1="6" y1="21" x2="46" y2="21" stroke="currentColor" stroke-width="2"></line>
    <line x1="6" y1="33" x2="46" y2="33" stroke="currentColor" stroke-width="2"></line>
    <line x1="22" y1="9" x2="22" y2="43" stroke="currentColor" stroke-width="2"></line>
    <rect x="8.5" y="11.5" width="11" height="7.5" fill="var(--green)"></rect>
  </symbol>
  <symbol id="ic-chart" viewBox="0 0 52 52">
    <line x1="9" y1="43" x2="43" y2="43" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></line>
    <rect x="12" y="29" width="7" height="12" rx="1.5" fill="currentColor"></rect>
    <rect x="23" y="22" width="7" height="19" rx="1.5" fill="currentColor"></rect>
    <rect x="34" y="14" width="7" height="27" rx="1.5" fill="var(--green)"></rect>
  </symbol>
  <symbol id="ic-flask" viewBox="0 0 52 52">
    <line x1="20" y1="7" x2="32" y2="7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></line>
    <path d="M23 8 v13 L12 39 a5 5 0 0 0 4.3 7.5 h19.4 a5 5 0 0 0 4.3 -7.5 L29 21 V8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"></path>
    <line x1="17" y1="33" x2="35" y2="33" stroke="var(--green)" stroke-width="2.6" stroke-linecap="round"></line>
  </symbol>
  <symbol id="ic-camera" viewBox="0 0 52 52">
    <path d="M18 16 l3 -5 h10 l3 5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"></path>
    <rect x="6" y="16" width="40" height="27" rx="5" fill="none" stroke="currentColor" stroke-width="2.4"></rect>
    <circle cx="26" cy="30" r="8" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <circle cx="26" cy="30" r="3.5" fill="var(--green)"></circle>
  </symbol>
  <symbol id="ic-pen" viewBox="0 0 52 52">
    <path d="M33 9 l10 10 L19 43 L8 46 L11 35 Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"></path>
    <line x1="29" y1="13" x2="39" y2="23" stroke="currentColor" stroke-width="2.4"></line>
    <path d="M11 35 l6 6" fill="none" stroke="var(--green)" stroke-width="2.6" stroke-linecap="round"></path>
  </symbol>
  <symbol id="ic-direct" viewBox="0 0 52 52">
    <circle cx="11" cy="26" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <circle cx="41" cy="26" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
    <line x1="18" y1="26" x2="30" y2="26" stroke="var(--green)" stroke-width="2.6" stroke-linecap="round"></line>
    <path d="M27 22 l5 4 -5 4" fill="none" stroke="var(--green)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </symbol>
  <symbol id="ic-gem" viewBox="0 0 52 52">
    <path d="M17 11 H35 L45 22 L26 42 L7 22 Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"></path>
    <line x1="7" y1="22" x2="45" y2="22" stroke="currentColor" stroke-width="2"></line>
    <path d="M17 11 L22 22 L26 42 L30 22 L35 11" fill="none" stroke="var(--green)" stroke-width="2" stroke-linejoin="round"></path>
  </symbol>
  <symbol id="ic-notebook" viewBox="0 0 52 52">
    <rect x="9" y="7" width="34" height="38" rx="5" fill="none" stroke="currentColor" stroke-width="2.4"></rect>
    <path d="M22 20 L16 26 L22 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M30 20 L36 26 L30 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    <line x1="27" y1="17" x2="25" y2="35" stroke="var(--green)" stroke-width="2.4" stroke-linecap="round"></line>
  </symbol>
</defs></svg>
