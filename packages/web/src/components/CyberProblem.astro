    fill: #ffffff;
    stroke: #c2412d;
    stroke-width: 2.5;
  }
  .latest .point-dot {
    fill: #c2412d;
  }
  .value {
    fill: #12140e;
    font-size: 13px;
    font-weight: 700;
  }
  .latest .value {
    fill: #c2412d;
    font-size: 15px;
    font-weight: 700;
  }
  .year {
    fill: #2f352b;
    font-size: 12px;
    font-weight: 600;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid #eef1eb;
    font-size: 12.5px;
    line-height: 1.6;
    color: #5c6356;
  }
  figcaption p {
    margin: 0;
  }
  .source-link {
    color: #2f352b;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 12.5px;
    font-weight: 500;
  }
  .source-link:hover {
    color: #12140e;
  }
  .bridge-banner {
    margin: 28px auto 0;
    padding: 20px 32px;
    background: #141813;
    border-radius: 16px;
    text-align: center;
  }
  .bridge-banner p {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.7;
    color: #f4f7ef;
  }
  @media (max-width: 920px) {
    .fact-cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .problem-visual-panel {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px;
    }
  }
  @media (max-width: 600px) {
    .cy-issue-section {
      padding: 72px 0;
    }
    .fact-card {
      padding: 28px 24px;
    }
    .chart-heading {
      flex-direction: column;
      align-items: flex-start;
    }
    .bridge-banner {
      padding: 18px 20px;
    }
    .bridge-banner p {
      font-size: 14.5px;
