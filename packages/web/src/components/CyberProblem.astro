---
import type { Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Reported losses, not global crime totals or AI-attributed losses.
// All seven observations use the same series in the 2025 IC3 report, p. 4.
const losses = [
  { year: 2015, billions: 1.0 },
  { year: 2020, billions: 4.2 },
  { year: 2021, billions: 6.9 },
  { year: 2022, billions: 10.3 },
  { year: 2023, billions: 12.5 },
  { year: 2024, billions: 16.6 },
  { year: 2025, billions: 20.877 },
] as const;
const firstYear = losses[0].year;
const yearSpan = losses[losses.length - 1]!.year - firstYear;
const points = losses.map((loss) => ({
  ...loss,
  x: 56 + ((loss.year - firstYear) / yearSpan) * 360,
  y: 216 - (loss.billions / 25) * 176,
}));
const slopes = points.slice(1).map((point, index) => {
  const previous = points[index]!;
  return {
    width: point.x - previous.x,
    slope: (point.y - previous.y) / (point.x - previous.x),
  };
});
// Weighted monotone interpolation preserves the values across unequal year gaps.
const tangents = points.map((_, index) => {
  const before = slopes[index - 1];
  const after = slopes[index];
  if (!before) return after!.slope;
  if (!after) return before.slope;
  if (before.slope * after.slope <= 0) return 0;
  const beforeWeight = 2 * after.width + before.width;
  const afterWeight = after.width + 2 * before.width;
  return (beforeWeight + afterWeight) / (beforeWeight / before.slope + afterWeight / after.slope);
});
const curve = points.slice(1).reduce(
  (path, point, index) => {
    const previous = points[index]!;
    const third = (point.x - previous.x) / 3;
    return (
      path +
      " C" +
      [
        previous.x + third,
        previous.y + tangents[index]! * third,
        point.x - third,
        point.y - tangents[index + 1]! * third,
        point.x,
        point.y,
      ].join(" ")
    );
  },
  "M" + points[0]!.x + " " + points[0]!.y,
);
const areaPath = `${curve} L ${points[points.length - 1]!.x} 216 L ${points[0]!.x} 216 Z`;
const valueFormat = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
const displayValue = (billions: number) =>
  valueFormat.format(billions * (locale === "ja" ? 10 : 1));
const C =
  locale === "ja"
    ? {
        eyebrow: "市場の課題",
        title: "鍵だけでは、守りきれない",
        intro:
          "AIによる模倣やなりすましが高度化し、盗まれたログイン情報や社内AIの想定外の操作が実行される事例が急増しています。境界認証を通過した後も、実行の直前で確かめる仕組みが必要です。",
        keyBadge: "従来の境界防御の限界",
        keyLabel: "ログイン時の本人確認だけでは不十分",
        keyNote:
          "フィッシングや情報漏洩で盗まれた正規の認証情報（鍵）や、権限を与えられた社内AIエージェントは、ログインの壁を正規に通過してしまいます。",
        aiSource: "AIによるなりすまし：FBIの注意喚起を見る",
        chartTitle: "ネット犯罪の申告被害額の推移（FBI IC3）",
        chartUnit: "億米ドル",
        growth: "約20倍",
        growthPeriod: "2015–2025年",
        chartDescription:
          "FBI IC3に報告されたネット犯罪の被害額。2015年10億、2020年42億、2021年69億、2022年103億、2023年125億、2024年166億、2025年208.77億米ドル。縦軸は0から250億米ドル。横軸は年数に比例。10年間で約20倍。曲線は観測値をつないだもの。",
        chartScope:
          "※FBI IC3への申告額（詐欺等を含む）。世界全体やAI起因だけの被害額ではありません。",
        source: "出典：FBI Internet Crime Report 2025, p.4",
        facts: [
          {
            stat: "約20倍",
            period: "2015–2025年",
            heading: "ネット犯罪の申告被害額が10年間で急増",
            body: "盗まれた認証情報やAIを用いた巧妙ななりすましにより、年間被害額は208億米ドル（2025年）へ達しました。",
            source: "出典：FBI Internet Crime Report 2025",
            sourceUrl: "https://www.ic3.gov/AnnualReport/Reports/2025_IC3Report.pdf#page=4",
          },
          {
            stat: "約9割",
            period: "国内大企業調査",
            heading: "大企業のAIエージェント導入で、課題を実感",
            body: "「活用する上で課題を感じる」に「非常に感じる」30.7%・「やや感じる」59.1%（n=257、生成AIを業務活用する大企業社員ベース）。",
            source: "出典：テックタッチ調べ（2025年）",
            sourceUrl: "https://prtimes.jp/main/html/rd/p/000000290.000048939.html",
          },
          {
            stat: "60%超",
            period: "セキュリティ侵害調査",
            heading: "侵入や不正操作に「正規の認証情報」が悪用",
            body: "パスワードや鍵によるログイン自体は正規に見えるため、入口の認証だけではその後の不正送金やデータ持ち出しを抑止できません。",
            source: "出典：FBI PSA / 脅威分析報告",
            sourceUrl: "https://www.ic3.gov/PSA/2025/PSA250515",
          },
        ],
        bridge: "ログインが通った後も、実行の直前で「操作の内容」を照合する関門が必要です。",
      }
    : {
        eyebrow: "THE MARKET CHALLENGE",
        title: "A key alone cannot protect every action",
        intro:
          "With AI-driven impersonation growing more convincing, legitimate credentials and autonomous tools can be misused to carry out unauthorized operations. An execution gate is required right before action takes place.",
        keyBadge: "LIMITS OF PERIMETER AUTH",
        keyLabel: "Login authentication alone is not enough",
        keyNote:
          "Stolen credentials and pre-authorized AI agents pass perimeter checks legitimately, leaving subsequent payouts and data exports unverified.",
        aiSource: "AI impersonation: View FBI advisory",
        chartTitle: "Reported internet crime losses (FBI IC3)",
        chartUnit: "US$ billions",
        growth: "~20×",
        growthPeriod: "2015–2025",
        chartDescription:
          "Internet crime losses reported to FBI IC3, in billions of US dollars: 1.0 in 2015, 4.2 in 2020, 6.9 in 2021, 10.3 in 2022, 12.5 in 2023, 16.6 in 2024 and 20.877 in 2025. The vertical axis starts at zero and ends at 25 billion US dollars. The horizontal axis is proportional to elapsed years. About twenty times the 2015 value. The curve connects observations.",
        chartScope:
          "*Losses reported to FBI IC3, including fraud. Not a global total or limited to AI-related crime.",
        source: "Source: FBI Internet Crime Report 2025, p.4",
        facts: [
          {
            stat: "~20×",
            period: "2015–2025",
            heading: "Internet crime losses surge over a 10-year span",
            body: "Driven by stolen credentials and AI-assisted fraud, reported losses reached $20.8B in 2025.",
            source: "Source: FBI Internet Crime Report 2025",
            sourceUrl: "https://www.ic3.gov/AnnualReport/Reports/2025_IC3Report.pdf#page=4",
          },
          {
            stat: "~90%",
            period: "Enterprise Survey",
            heading: "Large firms feel operational hurdles with AI agents",
            body: "89.8% of AI agent users reported challenges in deployment and safety governance (n=257, Techtouch 2025).",
            source: "Source: Techtouch Survey (2025)",
            sourceUrl: "https://techtouch.jp/resources/survey-aiagent-2025/",
          },
          {
            stat: ">60%",
            period: "Threat Landscape",
            heading: "Legitimate credentials abused in lateral attacks",
            body: "Perimeter logins appear authentic, leaving subsequent transfers and database exports undetected without an execution gate.",
            source: "Source: FBI PSA / Threat Reports",
            sourceUrl: "https://www.ic3.gov/PSA/2025/PSA250515",
          },
        ],
        bridge: "Even after authentication passes, each critical action must be verified before execution.",
      };
---

<section id="cy-difference" class="cy-issue-section" aria-labelledby="cy-difference-title">
  <div class="cy-container">
    <div class="issue-header">
      <span class="issue-eyebrow">{C.eyebrow}</span>
      <h2 id="cy-difference-title">{C.title}</h2>
      <p class="issue-intro">{C.intro}</p>
    </div>

    <!-- 3 Stat Cards on Lemma Stone Canvas -->
    <div class="fact-cards">
      {
        C.facts.map((fact) => (
          <div class="fact-card">
            <div class="fact-stat-wrap">
              <span class="fact-stat">{fact.stat}</span>
              <span class="fact-period">{fact.period}</span>
            </div>
            <h3 class="fact-heading">{fact.heading}</h3>
            <p class="fact-body">{fact.body}</p>
            <a
              class="fact-source"
              data-cy-ev="cy_issue_source"
              href={fact.sourceUrl}
              target="_blank"
              rel="noopener"
            >
              {fact.source} <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))
      }
    </div>

    <!-- Visual Comparison Panel: Perimeter Key vs Rising Crime Losses Chart -->
    <div class="problem-visual-panel">
      <div class="key-side">
        <span class="key-badge">{C.keyBadge}</span>
        <div class="key-stage" aria-hidden="true">
          <svg
            class="key-shape"
            width="88"
            height="114"
            viewBox="0 0 112 144"
            fill="none"
            focusable="false"
          >
            <defs>
              <linearGradient
                id="cy-key-outline"
                x1="24"
                y1="5"
                x2="84"
                y2="132"
                gradientUnits="userSpaceOnUse"
              >
                <stop stop-color="#2f352b"></stop>
                <stop offset=".5" stop-color="#5c6356"></stop>
                <stop offset="1" stop-color="#12140e"></stop>
              </linearGradient>
              <linearGradient
                id="cy-key-face"
                x1="28"
                y1="5"
                x2="84"
                y2="132"
                gradientUnits="userSpaceOnUse"
              >
                <stop stop-color="#cfd5c9" stop-opacity=".6"></stop>
                <stop offset="1" stop-color="#8c9484" stop-opacity=".25"></stop>
              </linearGradient>
              <path
                id="cy-key-profile"
                d="M44 58a28 28 0 1 1 24 0v58l-12 16-12-16v-6l8-8-8-8 8-8-8-8Z"></path>
            </defs>
            <g transform="translate(0 144) scale(1 -1)" stroke-linecap="round" stroke-linejoin="round">
              <use href="#cy-key-profile" fill="url(#cy-key-face)" stroke="url(#cy-key-outline)" stroke-width="2.5"></use>
              <circle cx="56" cy="22" r="5" fill="#f3f5f0" stroke="url(#cy-key-outline)" stroke-width="2"></circle>
              <path d="M62 62v53m-5-51v49" stroke="#5c6356" stroke-width="1.5"></path>
            </g>
          </svg>
        </div>
        <strong class="key-title">{C.keyLabel}</strong>
        <p class="key-desc">{C.keyNote}</p>
        <a
          class="ai-source-link"
          href="https://www.ic3.gov/PSA/2025/PSA250515"
          target="_blank"
          rel="noopener"
        >
          {C.aiSource} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <figure class="losses-chart-box" aria-labelledby="cy-loss-chart-heading">
        <div class="chart-heading">
          <div>
            <h3 id="cy-loss-chart-heading">{C.chartTitle}</h3>
          </div>
          <div class="growth-pill">
            <strong>{C.growth}</strong>
            <span>{C.growthPeriod}</span>
          </div>
        </div>
        <svg
          class="chart"
          viewBox="0 0 460 256"
          role="img"
          aria-labelledby="cy-loss-chart-title cy-loss-chart-description"
        >
          <title id="cy-loss-chart-title">{C.chartTitle}</title>
          <desc id="cy-loss-chart-description">{C.chartDescription}</desc>
          <defs>
            <linearGradient id="cy-loss-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#c2412d" stop-opacity="0.15" />
              <stop offset="100%" stop-color="#c2412d" stop-opacity="0.0" />
            </linearGradient>
          </defs>
          <text class="unit" x="16" y="20">{C.chartUnit}</text>
          {
            [0, 10, 20].map((tick) => (
              <g class="axis" aria-hidden="true">
                <line x1="48" y1={216 - (tick / 25) * 176} x2="438" y2={216 - (tick / 25) * 176} />
                <text x="38" y={220 - (tick / 25) * 176} text-anchor="end">
                  {displayValue(tick)}
                </text>
              </g>
            ))
          }
          <path d={areaPath} fill="url(#cy-loss-area)" />
          <path class="trend" d={curve}></path>
          {
            points.map((point, index) => (
              <g
                class:list={{ latest: index === points.length - 1 }}
                aria-hidden="true"
                data-loss-year={point.year}
                data-loss-billions={point.billions}
              >
                <circle
                  cx={point.x}
                  cy={point.y}
                  r={index === points.length - 1 ? 5 : 3.5}
                  class="point-dot"
                />
                {(index === 0 || index === points.length - 1) && (
                  <text class="value" x={point.x} y={point.y - 14} text-anchor="middle">
                    {displayValue(point.billions)}
                  </text>
                )}
                {(index === 0 || point.year === 2020 || index === points.length - 1) && (
                  <text class="year" x={point.x} y="244" text-anchor="middle">
                    {point.year}
                  </text>
                )}
              </g>
            ))
          }
        </svg>
        <figcaption>
          <p>{C.chartScope}</p>
          <a
            class="source-link"
            href="https://www.ic3.gov/AnnualReport/Reports/2025_IC3Report.pdf#page=4"
            target="_blank"
            rel="noopener">{C.source} <span aria-hidden="true">↗</span></a
          >
        </figcaption>
      </figure>
    </div>

    <div class="bridge-banner">
      <p>{C.bridge}</p>
    </div>
  </div>
</section>

<style>
  .cy-issue-section {
    width: 100%;
    background: #eef1eb;
    padding: 112px 0;
    color: #12140e;
    scroll-margin-top: 80px;
  }
  .cy-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  .cy-issue-section *,
  .cy-issue-section *::before,
  .cy-issue-section *::after {
    box-sizing: border-box;
  }
  .issue-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 56px;
  }
  .issue-eyebrow {
    display: inline-block;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #12140e;
    background: #dce3d5;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  h2 {
    margin: 0 0 20px;
    font-family: "Space Grotesk", "Noto Sans JP", sans-serif;
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #12140e;
    text-wrap: balance;
  }
  .issue-intro {
    max-width: 660px;
    margin: 0 auto;
    color: #2f352b;
    font-size: 16px;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .fact-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 28px;
    text-align: left;
  }
  .fact-card {
    display: flex;
    flex-direction: column;
    padding: 36px 32px;
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(18, 20, 14, 0.04);
  }
  .fact-stat-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid #eef1eb;
  }
  .fact-stat {
    font-family: "Space Grotesk", "Noto Sans JP", sans-serif;
    font-size: clamp(38px, 4vw, 48px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #12140e;
  }
  .fact-period {
    color: #464d40;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    background: #eef1eb;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .fact-heading {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.45;
    color: #12140e;
  }
  .fact-body {
    margin: 0 0 24px;
    color: #2f352b;
    font-size: 14.5px;
    line-height: 1.75;
    flex-grow: 1;
  }
  .fact-source {
    font-size: 12.5px;
    font-weight: 700;
    color: #3f6200;
    text-decoration: none;
  }
  .fact-source:hover {
    text-decoration: underline;
  }
  .problem-visual-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    align-items: stretch;
    gap: 28px;
    padding: 36px;
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 24px;
    box-shadow: 0 8px 30px rgba(18, 20, 14, 0.05);
  }
  .key-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 32px 28px;
    background: #f6f8f4;
    border: 1px solid #e1e5dd;
    border-radius: 16px;
    text-align: center;
  }
  .key-badge {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    color: #2f352b;
    background: #e3e8de;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .key-stage {
    display: grid;
    place-items: center;
    height: 124px;
    width: 100%;
  }
  .key-shape {
    display: block;
    width: 86px;
    height: auto;
  }
  .key-title {
    font-size: 17px;
    font-weight: 700;
    color: #12140e;
    line-height: 1.4;
  }
  .key-desc {
    margin: 0;
    font-size: 14px;
    color: #2f352b;
    line-height: 1.75;
    max-width: 38ch;
  }
  .ai-source-link {
    font-size: 13px;
    font-weight: 700;
    color: #3f6200;
    text-decoration: none;
    margin-top: 4px;
  }
  .ai-source-link:hover {
    text-decoration: underline;
  }
  .losses-chart-box {
    min-width: 0;
    width: 100%;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px 12px;
  }
  .chart-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .chart-heading h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    color: #12140e;
  }
  .growth-pill {
    display: flex;
    align-items: baseline;
    gap: 8px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    padding: 6px 14px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .growth-pill strong {
    color: #c2412d;
    font-family: "Space Grotesk", "Noto Sans JP", sans-serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }
  .growth-pill span {
    color: #991b1b;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    font-weight: 600;
  }
  .chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    margin-bottom: 12px;
    font-family: "Space Mono", monospace;
  }
  .unit {
    fill: #5c6356;
    font-size: 12px;
    font-weight: 600;
  }
  .axis line {
    stroke: #e1e5dd;
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .axis text {
    fill: #5c6356;
    font-size: 12px;
  }
