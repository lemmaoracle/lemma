---
/**
 * Brief detail page — "Next steps" banner.
 *
 * Pillar-aware CTA card placed at the end of the body, before BriefRelated.
 * Variant is picked from `brief.data.pillar`:
 *
 *   P1 (verifiable-origin)      developer-primary  — Trust402 lead
 *   P2 (verifiable-ai)          enterprise-primary — Discovery Call lead
 *   P3 (agent-authority)        developer-primary  — Trust402 lead
 *   P4 (regulatory-attribute)   enterprise-primary — Discovery Call lead
 *
 * The supply-chain swap noted in the design handoff (enterprise-primary
 * variant of P1 with different use cases) is deferred — none of the supply-
 * chain use case slugs exist in the registry yet.
 *
 * JA only. EN Briefs render no banner (the EN reader path uses different
 * thesis copy that the writer hasn't finalized).
 *
 * GA4 events are wired via data-ev attributes; the listener at the bottom
 * forwards each click to gtag() if it is loaded (Layout.astro wires gtag
 * when GOOGLE_ANALYTICS_ID is present).
 */
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface BriefNextStepsProps {
  pillar: "01-verifiable-origin" | "02-verifiable-ai" | "03-agent-authority" | "04-regulatory-attribute";
  briefId: string;
  base: string;
}

const { pillar, briefId, base } = Astro.props as BriefNextStepsProps;

const consultUrl = DISCOVERY_CALL_URL.ja;
const trustUrl = "/trust402/";
const whitepaperUrl = "https://tally.so/r/xX0VYv";

const ucBase = base ? `${base}/solutions/use-cases` : "/solutions/use-cases";
const pillarHubBase = base ? `${base}/pillars` : "/pillars";

type Variant = {
  pillarCode: "P1" | "P2" | "P3" | "P4";
  reader: "enterprise" | "dev";
  badge: string;
  thesis: string;
  useCases: ReadonlyArray<{ label: string; slug: string }>;
  pillarHref: string;
  pillarName: string;
};

const VARIANTS: Record<BriefNextStepsProps["pillar"], Variant> = {
  "01-verifiable-origin": {
    pillarCode: "P1",
    reader: "dev",
    badge: "Pillar 01 · 来歴証明",
    thesis: "監視を増やしても、メッセージやコードの起点の真正性は後からは復元できない。残るのは取引・取り込みの前に origin を証明する独立層です。",
    useCases: [
      { label: "DeFi ブリッジ検証", slug: "defi-bridge-verification" },
      { label: "x402 上のエージェント取引", slug: "x402-commerce" },
      { label: "RAG コンテンツ来歴", slug: "rag-content-provenance" },
    ],
    pillarHref: `${pillarHubBase}/verifiable-origin/`,
    pillarName: "Pillar 01 — 来歴証明",
  },
  "02-verifiable-ai": {
    pillarCode: "P2",
    reader: "enterprise",
    badge: "Pillar 02 · 検証可能 AI",
    thesis: "検出の精度を上げても、その判断が正当な入力と根拠で下されたことは後からは立証しにくい。残るのは判断の根拠を判断時に固定する独立層です。",
    useCases: [
      { label: "AI 監査ログ証明", slug: "ai-audit-log-proof" },
      { label: "生データを触らせず AI に使わせる", slug: "ai-document-isolation" },
      { label: "RAG ソース認証", slug: "rag-source-attestation" },
    ],
    pillarHref: `${pillarHubBase}/verifiable-ai/`,
    pillarName: "Pillar 02 — 検証可能 AI",
  },
  "03-agent-authority": {
    pillarCode: "P3",
    reader: "dev",
    badge: "Pillar 03 · エージェント権限証明",
    thesis: "実行ログを監視しても、誰の権限でどこまで許可されたかは、事前に証明がなければ後から争えない。残るのは委任を取引前に証跡化する独立層です。",
    useCases: [
      { label: "マルチエージェント・ワークフロー", slug: "multi-agent-workflows" },
      { label: "委任型トレジャリー", slug: "delegated-treasury" },
    ],
    pillarHref: `${pillarHubBase}/agent-authority-proof/`,
    pillarName: "Pillar 03 — エージェント権限証明",
  },
  "04-regulatory-attribute": {
    pillarCode: "P4",
    reader: "enterprise",
    badge: "Pillar 04 · 規制属性証明",
    thesis: "検出を増やしても、主体が要件を満たし制裁リストに載っていないことは、原データなしには示せない。残るのは属性を選択的開示で証明する独立層です。",
    useCases: [
      { label: "KYC/AML 選択的開示", slug: "kyc-aml-selective-disclosure" },
      { label: "取引先の与信・反社チェック", slug: "counterparty-screening" },
      { label: "金融データ流出防止", slug: "financial-data-exfiltration" },
    ],
    pillarHref: `${pillarHubBase}/regulatory-attribute-proof/`,
    pillarName: "Pillar 04 — 規制属性証明",
  },
};

const variant = VARIANTS[pillar];
const isEnterpriseLead = variant.reader === "enterprise";

const consultCta = { label: "導入を相談", href: consultUrl, ev: "cta_consult_click", external: true };
const trialCta = { label: "Trust402 を試す", href: trustUrl, ev: "cta_trial_click", external: true };
const textCta = { label: "ホワイトペーパー", href: whitepaperUrl, ev: "cta_whitepaper_click", external: true };

const primaryCta = isEnterpriseLead
  ? { ...consultCta, label: "導入を相談 →" }
  : { ...trialCta, label: "Trust402 を試す →" };
const ghostCta = isEnterpriseLead ? trialCta : consultCta;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `この事案から、次へ — ${variant.pillarName}`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: variant.pillarName, url: `https://lemma.frame00.com${variant.pillarHref}` },
    ...variant.useCases.map((uc, i) => ({
      "@type": "ListItem" as const,
      position: i + 2,
      name: uc.label,
      url: `https://lemma.frame00.com${ucBase}/${uc.slug}/`,
    })),
    {
      "@type": "ListItem",
      position: variant.useCases.length + 2,
      name: isEnterpriseLead ? "導入を相談 (Lemma)" : "開発者は試す (Trust402)",
      url: isEnterpriseLead ? consultUrl : trustUrl,
    },
  ],
};
---

<section
  class="lm-next"
  aria-label={`この事案から、次へ — ${variant.pillarName}`}
  data-brief={briefId}
  data-pillar={variant.pillarCode}
  data-reader={variant.reader}
>
  <div class="lm-next__wrap">
    <div class="lm-next__card">
      <div class="lm-next__top">
        <span class="lm-next__badge">{variant.badge}</span>
        <span class="lm-next__eyebrow">この事案から、次へ</span>
      </div>
      <p class="lm-next__thesis">{variant.thesis}</p>
      <nav class="lm-next__ucs" aria-label="関連ユースケース">
        {variant.useCases.map((uc) => (
          <a
            class="lm-next__uc"
            href={`${ucBase}/${uc.slug}/`}
            data-ev="uc_link_click"
            data-uc={uc.slug}
            data-cta={uc.label}
          >{uc.label}</a>
        ))}
      </nav>
      <div class="lm-next__cta">
        <a
          class="lm-next__btn lm-next__btn--primary"
          href={primaryCta.href}
          target={primaryCta.external ? "_blank" : undefined}
          rel={primaryCta.external ? "noopener" : undefined}
          data-ev={primaryCta.ev}
          data-cta={primaryCta.label}
        >{primaryCta.label}</a>
        <a
          class="lm-next__btn lm-next__btn--ghost"
          href={ghostCta.href}
          target={ghostCta.external ? "_blank" : undefined}
          rel={ghostCta.external ? "noopener" : undefined}
          data-ev={ghostCta.ev}
          data-cta={ghostCta.label}
        >{ghostCta.label}</a>
        <a
          class="lm-next__btn--text"
          href={textCta.href}
          target="_blank"
          rel="noopener"
          data-ev={textCta.ev}
          data-cta={textCta.label}
        >{textCta.label}</a>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<script is:inline>
  (function () {
    function wire() {
      var banner = document.querySelector(".lm-next");
      if (!banner) return;
      var briefId = banner.getAttribute("data-brief");
      var pillar = banner.getAttribute("data-pillar");
      var reader = banner.getAttribute("data-reader");
      banner.querySelectorAll("[data-ev]").forEach(function (el) {
        el.addEventListener("click", function () {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", el.getAttribute("data-ev"), {
            brief_id: briefId,
            pillar: pillar,
            reader_path: reader,
            cta_label: el.getAttribute("data-cta"),
            destination: el.getAttribute("href"),
            use_case: el.getAttribute("data-uc") || undefined,
          });
        });
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wire);
    } else {
      wire();
    }
  })();
</script>

<style>
  .lm-next {
    --lemma-accent-color: #8B4513;
    --lemma-ink: #2b2622;
    --lemma-muted: #6b6157;
    --lemma-line: #e7e1d8;
    --lemma-tintbg: #f6f1ea;
    --lemma-card: #ffffff;
    font-family: "Sora", system-ui, -apple-system, "Hiragino Kaku Gothic ProN", sans-serif;
    color: var(--lemma-ink);
    margin: 32px 0 8px;
  }
  .lm-next__wrap {
    background: var(--lemma-tintbg);
    border-radius: 14px;
    padding: 20px;
  }
  .lm-next__card {
    background: var(--lemma-card);
    border: 1px solid var(--lemma-line);
    border-radius: 12px;
    padding: 18px 20px;
  }
  .lm-next__top {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; margin-bottom: 10px;
  }
  .lm-next__badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500; color: #fff;
    background: var(--lemma-accent-color);
    padding: 4px 11px; border-radius: 8px;
  }
  .lm-next__eyebrow {
    font-size: 12px; color: var(--lemma-muted); letter-spacing: .02em;
  }
  .lm-next__thesis {
    font-size: 15px; line-height: 1.65;
    margin: 0 0 12px;
  }
  .lm-next__ucs {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-bottom: 14px;
  }
  .lm-next__uc {
    font-size: 13px; color: var(--lemma-muted);
    text-decoration: none;
    border: 1px solid var(--lemma-line);
    border-radius: 8px;
    padding: 5px 11px;
    transition: background .15s, border-color .15s, color .15s;
  }
  .lm-next__uc:hover {
    background: var(--lemma-tintbg);
    border-color: var(--lemma-accent-color);
    color: var(--lemma-accent-color);
  }
  .lm-next__cta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
  }
  .lm-next__btn {
    font-size: 14px; text-decoration: none;
    border-radius: 8px; padding: 8px 15px;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .lm-next__btn--primary {
    background: var(--lemma-accent-color); color: #fff;
    border: 1px solid var(--lemma-accent-color);
  }
  .lm-next__btn--ghost {
    background: transparent; color: var(--lemma-ink);
    border: 1px solid #ccc3b8;
  }
  .lm-next__btn--text {
    color: var(--lemma-muted);
    padding: 8px 4px;
    text-decoration: none;
    font-size: 13px;
  }
  @media (max-width: 640px) {
    .lm-next__top { flex-wrap: wrap; }
    .lm-next__eyebrow { width: 100%; }
  }
  @media (prefers-color-scheme: dark) {
    .lm-next {
      --lemma-ink: #ece6dd;
      --lemma-muted: #a89c8e;
      --lemma-line: #3a342d;
      --lemma-tintbg: #211d18;
      --lemma-card: #17140f;
      --lemma-accent-color: #c98a4b;
    }
    .lm-next__badge,
    .lm-next__btn--primary { color: #1a1408; }
  }
</style>
