---
/**
 * BriefCard — shared card used on Pillar / Category archives and (later)
 * the /critical/briefs/ Index page.
 *
 * Display fields (per design brief §3.2):
 *   - Brief No. + published date
 *   - Title + subtitle (split on " — ")
 *   - Pillar badge (optional — Pillar archive page suppresses it as redundant)
 *   - Category badge with `source` styling:
 *       primary    → solid (this card surfaced via primary_category)
 *       secondary  → outline (this card surfaced via secondary_categories)
 *       general    → solid (used outside category archives, e.g. Pillar)
 *   - TL;DR snippet — extracted from the body's "## TL;DR" section, capped
 *     at ~200 chars. Falls back to empty if the section is missing.
 *   - secondary_categories tags (up to 3, beyond that is collapsed silently)
 *   - "Read Brief →" cue, the entire card is a link
 */

import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/translations";
import {
  pillarLabel,
  categoryLabel,
  type CategorySlug,
  type PillarSlug,
} from "../data/criticalBriefs";
import { extractTldr } from "../data/extractTldr";

export interface BriefCardProps {
  locale: Locale;
  brief:
    | CollectionEntry<"critical-briefs">
    | CollectionEntry<"critical-briefs-en">;
  /** Pillar archives suppress this badge to avoid redundancy. */
  showPillarBadge?: boolean;
  /** How this Brief surfaced in the listing — controls primary/secondary badge styling. */
  source?: "primary" | "secondary" | "general";
}

const {
  locale,
  brief,
  showPillarBadge = true,
  source = "general",
} = Astro.props as BriefCardProps;

const isJa = locale === "ja";
const base = isJa ? "/ja" : "";

const briefNoPad = String(brief.data.brief_no).padStart(3, "0");
const localizedTitle = isJa ? brief.data.title : brief.data.title_en;
const titleParts = localizedTitle.split(" — ");
const mainTitle = titleParts[0];
const subtitle = titleParts.length > 1 ? titleParts.slice(1).join(" — ") : "";

const publishedStr = brief.data.published.toISOString().slice(0, 10);
const briefHref = `${base}/critical/briefs/${brief.id}/`;

const tldr = extractTldr(brief.body, 200);

const pillarBadge = showPillarBadge
  ? pillarLabel(brief.data.pillar as PillarSlug, locale)
  : null;

const primaryCatLabel = categoryLabel(
  brief.data.primary_category as CategorySlug,
  locale,
);

const secondaryTags = brief.data.secondary_categories
  .slice(0, 3)
  .map((c) => ({
    slug: c,
    label: categoryLabel(c as CategorySlug, locale),
  }));

const readLabel = isJa ? "Brief を読む →" : "Read Brief →";
const briefNoLabel = `No.${briefNoPad}`;
---

<a
  class={`brief-card ${source === "secondary" ? "brief-card-secondary" : ""}`}
  href={briefHref}
  data-brief-source={source}
>
  <div class="brief-card-meta">
    <span class="brief-card-no">{briefNoLabel}</span>
    <span class="brief-card-date">{publishedStr}</span>
  </div>

  <h3 class="brief-card-title">{mainTitle}</h3>
  {subtitle && <p class="brief-card-subtitle">{subtitle}</p>}

  <div class="brief-card-badges">
    {pillarBadge && <span class="brief-card-pillar">{pillarBadge}</span>}
    <span
      class={`brief-card-cat brief-card-cat-${source}`}
      data-cat-source={source}
    >
      {primaryCatLabel}
    </span>
  </div>

  {tldr && <p class="brief-card-tldr">{tldr}</p>}

  {secondaryTags.length > 0 && (
    <ul class="brief-card-tags">
      {secondaryTags.map((tag) => (
        <li class="brief-card-tag">#{tag.slug}</li>
      ))}
    </ul>
  )}

  <span class="brief-card-cta">{readLabel}</span>
</a>

<style>
  .brief-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 28px 24px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .brief-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .brief-card-secondary {
    background: var(--gray-50, #f5f5f5);
  }

  .brief-card-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray-500, #9e9e9e);
  }
  .brief-card-no {
    color: var(--accent);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .brief-card-date {
    font-variant-numeric: tabular-nums;
  }

  .brief-card-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 500;
    color: var(--black);
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.005em;
  }
  :root[lang="ja"] .brief-card-title {
    line-height: 1.45;
  }

  .brief-card-subtitle {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--gray-700, #5f5f5f);
    line-height: 1.55;
    margin: 0;
  }

  .brief-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .brief-card-pillar {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 4px 10px;
  }
  .brief-card-cat {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
  }
  /* primary / general — solid */
  .brief-card-cat-primary,
  .brief-card-cat-general {
    background: var(--black);
    color: var(--white);
  }
  /* secondary — outline */
  .brief-card-cat-secondary {
    border: 1px solid var(--gray-500, #9e9e9e);
    color: var(--gray-700, #5f5f5f);
    background: transparent;
  }

  .brief-card-tldr {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.7;
    color: var(--gray-800, #1a1a1a);
    margin: 0;
  }

  .brief-card-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .brief-card-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 11px;
    color: var(--gray-500, #9e9e9e);
  }

  .brief-card-cta {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 4px;
  }
</style>
