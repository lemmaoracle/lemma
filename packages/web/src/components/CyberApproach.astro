---
import type { Locale } from "../i18n/translations";
import verifyQr from "../assets/cyber-verify-qr.svg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Decorative sample data, not an executable ruleset or a verifiable proof.
const encodedRules = (scope: string) =>
  btoa(
    JSON.stringify({
      scope,
      ...(scope === "export"
        ? { source: "support", target: "customer-records", limit: 100, window: 900 }
        : scope === "bank"
          ? { source: "supplier", target: "payment-account", approvals: 2, window: 3600 }
          : { source: "member", target: "voucher", limit: 5000, window: 300 }),
      approval: "required",
      expiry: "configured",
    }),
  )
    .repeat(12)
    .slice(0, 1440);
const guardrailCode = (operation: string) =>
  [
    "await guardrail(",
    "  { circuitId, proof, publicSignals },",
    "  { throw: true }",
    ");",
    `await ${operation}(request);`,
  ].join("\n");
const C =
  locale === "ja"
    ? {
        title: "不正な依頼を、実行の直前で止める。",
        intro:
          "Cyber は、依頼の内容を「確認票」にまとめ、決めた条件と照合する仕組みです。システムでも、窓口でも、操作を進める前に確かめます。",
        admin: "管理者",
        preset: "あらかじめ設定",
        ruleset: "管理者のルール",
        fields: ["依頼元", "対象", "条件"],
        check: "設定した条件と照合",
        verified: "照合完了",
        expired: "期限切れ",
        rejected: "期限切れのため実行しない",
        match: "一致",
        mismatch: "不一致・期限切れ",
        formats: "業務に合わせた使い方で",
        code: "システムに組み込む",
        codeNote: "今回の依頼用の確認データを、実行直前に検証。",
        paper: "QR で確認する",
        documentLine: "依頼内容に、確認票を添えて。",
        sample: "見本",
        paperNote: "経理担当者が、依頼と確認結果を照合。",
        caption:
          "業務に取り入れる場合の例です。最後は期限切れの確認票を受け付けない例です。SDK例は確認データの検証部分で、依頼内容・許可条件との照合も組み込み先で設計します。QRの場合は担当者が結果を見て判断します。",
        accessible:
          "管理者のルールを先に用意し、利用者が提出する確認票を重ねて、実行前に照合します。最初の2例はライム色の光が一周し、確認票が右へ抜けます。最後の例は期限切れの確認票です。赤い枠で拒否を示し、左下へ落として実行を止めます。QRの場合は担当者が結果を見て判断します。",
        scenarios: [
          {
            key: "export",
            status: "valid" as const,
            mode: "code" as const,
            name: "顧客データの出力",
            actor: "サポート担当",
            request: "顧客100件をCSVに",
            rules: "出力できる顧客・項目を設定",
            values: ["サポート担当", "申請した顧客100件", "申請した項目のみ"],
            pass: "申請した100件を出力",
            stop: "範囲外の出力を止める",
            operation: "exportCustomers",
          },
          {
            key: "bank",
            status: "valid" as const,
            mode: "paper" as const,
            name: "振込先口座の変更",
            actor: "取引先",
            request: "振込先の口座を変更",
            rules: "取引先・承認者・期限を設定",
            values: ["登録済みの取引先", "変更後の振込先", "担当者の承認・期限"],
            pass: "経理が承認して口座を更新",
            stop: "経理が更新を保留",
            document: "振込先変更の依頼書",
          },
          {
            key: "points",
            status: "expired" as const,
            mode: "code" as const,
            name: "期限切れの確認票を再利用",
            actor: "第三者",
            request: "5,000ポイントを交換",
            rules: "本人・交換上限・有効期限を設定",
            values: ["会員を名乗る依頼", "5,000ポイント", "有効期限切れ"],
            pass: "商品券を発行",
            stop: "期限切れのため商品券を発行しない",
            operation: "issueVoucher",
          },
        ],
        animation: "図のアニメーションを一時停止",
        pause: "一時停止",
        play: "再生",
      }
    : {
        title: "Stop malicious requests before execution.",
        intro:
          "Cyber brings a request into a confirmation card and checks it against your rules. In software or at a service counter, check before you act.",
        admin: "Administrator",
        preset: "Set up in advance",
        ruleset: "Administrator rules",
        fields: ["Source", "Target", "Conditions"],
        check: "Check against your rules",
        verified: "Check complete",
        expired: "Expired",
        rejected: "Expired — do not execute",
        match: "Match",
        mismatch: "Mismatch or expired",
        formats: "Choose how it fits your work",
        code: "Integrate into software",
        codeNote: "Verify this request’s confirmation data before execution.",
        paper: "Check with a QR code",
        documentLine: "A confirmation card with the request.",
        sample: "Sample",
        paperNote: "Accounting staff compare the request with the result.",
        caption:
          "Illustrative workflows. The last example rejects an expired confirmation card. The SDK excerpt verifies confirmation data; the integration must also check the request and permission rules. With a QR code, staff review the result and decide whether to proceed.",
        accessible:
          "Administrator rules are prepared first. A submitted confirmation card slides over them for a check before execution. In the first two examples, lime light travels around the edge and the card exits right. The last example uses an expired card: its border glows red, then it falls left and execution is blocked. With a QR code, staff review the result and decide whether to proceed.",
        scenarios: [
          {
            key: "export",
            status: "valid" as const,
            mode: "code" as const,
            name: "Customer data export",
            actor: "Support staff",
            request: "Export 100 customers to CSV",
            rules: "Set allowed customers and fields",
            values: ["Support staff", "100 requested customers", "Requested fields only"],
            pass: "Export the requested 100",
            stop: "Stop out-of-scope exports",
            operation: "exportCustomers",
          },
          {
            key: "bank",
            status: "valid" as const,
            mode: "paper" as const,
            name: "Bank account change",
            actor: "Supplier",
            request: "Change the payment account",
            rules: "Set suppliers, approvers and expiry",
            values: ["Registered supplier", "New payment account", "Staff approval · expiry"],
            pass: "Accounting approves and updates",
            stop: "Accounting puts it on hold",
            document: "Account change request",
          },
          {
            key: "points",
            status: "expired" as const,
            mode: "code" as const,
            name: "Reusing an expired confirmation card",
            actor: "Third party",
            request: "Exchange 5,000 points",
            rules: "Set identity, limits and expiry",
            values: ["Claimed member identity", "5,000 points", "Validity period expired"],
            pass: "Issue a voucher",
            stop: "Expired: no voucher is issued",
            operation: "issueVoucher",
          },
        ],
        animation: "Pause diagram animation",
        pause: "Pause",
        play: "Play",
      };
---

<section id="cy-how" class="approach" aria-labelledby="cy-approach-title" data-cy-approach>
  <h2 id="cy-approach-title">{C.title}</h2>
  <p class="intro">{C.intro}</p>
  <figure aria-describedby="cy-approach-caption">
    <div class="sr-only">
      <p>{C.accessible}</p>
      <ol>
        {
          C.scenarios.map((scenario) => (
            <li>
              <strong>{scenario.name}</strong>: {scenario.rules}。{scenario.actor} —{" "}
              {scenario.request}。
              {scenario.status === "expired"
                ? `${C.expired}: ${scenario.stop}`
                : `${C.match}: ${scenario.pass}。${C.mismatch}: ${scenario.stop}`}
              。
            </li>
          ))
        }
      </ol>
    </div>
    <div class="boards" aria-hidden="true" data-cy-approach-board>
      {
        C.scenarios.map((scenario, index) => (
          <div
            class:list={["board", { invalid: scenario.status === "expired" }]}
            data-cy-scenario={scenario.key}
            style={`--scenario: ${index}`}
          >
            <div class="admin">
              <div class="admin-heading">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M4 7h16M4 17h16M8 4v6m8 4v6" />
                </svg>
                <>
                  <strong>{C.admin}</strong>
                  <span>{C.preset}</span>
                </>
              </div>
              <p>{scenario.rules}</p>
            </div>

            <div class="requester">
              <svg class="person" width="52" height="64" viewBox="0 0 52 64" fill="none">
                <circle cx="26" cy="16" r="10" />
                <path d="M8 56V46a18 18 0 0 1 36 0v10M16 44v12m20-12v12" />
              </svg>
              <strong>{scenario.actor}</strong>
              <span class="request-text">{scenario.request}</span>
              <span class="scenario-index">0{index + 1} / 03</span>
              <span class="incoming" />
            </div>

            <div class="card-space" data-cy-approach-tilt>
              <div class="card-tilt">
                <div class="rule-card">
                  <div class="rule-heading">
                    <strong>{C.ruleset}</strong>
                    <span>PRESET / {C.sample}</span>
                  </div>
                  <p
                    class="rule-data"
                    data-rules={encodedRules(scenario.key)}
                    data-previous-rules={encodedRules(
                      C.scenarios[(index + C.scenarios.length - 1) % C.scenarios.length]?.key ??
                        scenario.key,
                    )}
                  >
                    {encodedRules(scenario.key)}
                  </p>
                </div>
                <div class="card-slide">
                  <div class="card" data-cy-approach-card>
                    <svg class="verification-edge" fill="none">
                      <rect class="edge-trail edge-halo" x="1" y="1" rx="13" pathLength="100" />
                      <rect class="edge-trail" x="1" y="1" rx="13" pathLength="100" />
                    </svg>
                    <div class="card-top">
                      <>
                        <span>LEMMA</span>
                        <span>
                          {scenario.status === "expired" ? "EXPIRED CARD" : "CONFIRMATION CARD"}
                        </span>
                      </>
                    </div>
                    <strong class="wordmark">Cyber</strong>
                    <p class="card-label">{scenario.request}</p>
                    <dl>
                      {C.fields.map((field, fieldIndex) => (
                        <div>
                          <dt>{field}</dt>
                          <dd>{scenario.values[fieldIndex]}</dd>
                        </div>
                      ))}
                    </dl>
                    <div class="check">
                      <span class="check-mark">
                        <span class={scenario.status === "expired" ? "rejected" : "verified"}>
                          {scenario.status === "expired" ? "×" : "✓"}
                        </span>
                      </span>
                      <span class="check-copy">
                        <span class="checking">{C.check}</span>
                        <span class={scenario.status === "expired" ? "rejected" : "verified"}>
                          {scenario.status === "expired" ? C.rejected : C.verified}
                        </span>
                      </span>
                      <i />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="formats">
              <p class="formats-label">{C.formats}</p>
              <div class="format-stage">
                {scenario.mode === "code" ? (
                  <div class="format code-format">
                    <div class="format-heading">
                      <strong>{C.code}</strong>
                    </div>
                    <div class="code-sheet">
                      <div class="code-top">
                        <span />
                        <span />
                        <span />
                        <b>@lemmaoracle/verify</b>
                      </div>
                      <pre set:text={guardrailCode(scenario.operation)} />
                    </div>
                    <p class="format-note">{C.codeNote}</p>
                  </div>
                ) : (
                  <div class="format paper-format">
                    <div class="format-heading">
                      <strong>{C.paper}</strong>
                    </div>
                    <div class="paper-sheet">
                      <div class="paper-content">
                        <span class="paper-brand">CYBER / {C.sample}</span>
                        <strong>{scenario.document}</strong>
                        <span class="paper-line" />
                        <span class="paper-line short" />
                        <p>{C.documentLine}</p>
                      </div>
                      <img src={verifyQr.src} width="80" height="80" alt="" loading="lazy" />
                    </div>
                    <p class="format-note">{C.paperNote}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="motion-control">
      <button
        type="button"
        aria-label={C.animation}
        aria-pressed="false"
        data-cy-approach-toggle
        hidden
      >
        <span class="pause-label"><span aria-hidden="true">Ⅱ</span> {C.pause}</span>
        <span class="play-label"><span aria-hidden="true">▷</span> {C.play}</span>
      </button>
    </div>
    <figcaption id="cy-approach-caption">{C.caption}</figcaption>
  </figure>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-cy-approach]");
  const board = section?.querySelector<HTMLElement>("[data-cy-approach-board]");
  const cardSpace = section?.querySelector<HTMLElement>("[data-cy-approach-tilt]");
  const tilts = Array.from(section?.querySelectorAll<HTMLElement>(".card-tilt") ?? []);
  const toggle = section?.querySelector<HTMLButtonElement>("[data-cy-approach-toggle]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const ruleFields = Array.from(section?.querySelectorAll<HTMLElement>("[data-rules]") ?? []);
  const rewriteRules = () => {
    // Follow the CSS clock so rewrites share pause, offscreen and scenario timing.
    const timeline = board
      ?.querySelector<HTMLElement>(".board")
      ?.getAnimations()
      .find(
        (animation) =>
          animation instanceof CSSAnimation && animation.animationName === "scenario-show",
      );
    const time = Number(timeline?.currentTime ?? 0);
    ruleFields.forEach((field, index) => {
      const next = field.dataset.rules ?? "";
      const previous = field.dataset.previousRules ?? next;
      const phase = (((time - index * 8000) % 24000) + 24000) % 24000;
      const count = Math.min(next.length, Math.floor((phase / 650) * next.length));
      const value = next.slice(0, count) + previous.slice(count);
      field.textContent === value ? undefined : (field.textContent = value);
    });
    const enabled =
      section?.classList.contains("active") &&
      !section.classList.contains("paused") &&
      !reducedMotion.matches;
    enabled
      ? section?.setAttribute("data-rules-frame", String(requestAnimationFrame(rewriteRules)))
      : undefined;
  };
  const syncRules = () => {
    cancelAnimationFrame(Number(section?.dataset.rulesFrame ?? 0));
    reducedMotion.matches
      ? ruleFields.forEach((field) => (field.textContent = field.dataset.rules ?? ""))
      : section?.classList.contains("active") && !section.classList.contains("paused")
        ? rewriteRules()
        : undefined;
  };
  const resetTilt = () => {
    tilts.forEach((tilt) => tilt.style.removeProperty("--tilt"));
  };
  const observer =
    typeof IntersectionObserver === "undefined"
      ? undefined
      : new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              section?.classList.toggle("active", entry.isIntersecting);
              entry.isIntersecting ? undefined : resetTilt();
              syncRules();
            });
          },
          { threshold: 0.2 },
        );
  section && board && observer
    ? (section.classList.add("ready"), observer.observe(board), toggle?.removeAttribute("hidden"))
    : undefined;
  toggle?.addEventListener("click", () => {
    const paused = section?.classList.toggle("paused") ?? false;
    toggle.setAttribute("aria-pressed", String(paused));
    paused ? resetTilt() : undefined;
    syncRules();
  });
  const rotationToward = (bounds: DOMRect, x: number, y: number) => {
    const dx = x - bounds.left - bounds.width / 2;
    const dy = y - bounds.top - bounds.height / 2;
    const distance = Math.hypot(dx, dy);
    const axis = distance > 0 ? [-dy / distance, dx / distance, 0] : [0, 1, 0];
    const angle = Math.atan2(distance, bounds.width * 0.6) * (40 / Math.PI);
    return `rotate3d(${axis.join(", ")}, ${angle}deg)`;
  };
  document.addEventListener(
    "pointermove",
    (event) => {
      const enabled =
        event.pointerType === "mouse" &&
        finePointer.matches &&
        !reducedMotion.matches &&
        section?.classList.contains("active") &&
        !section.classList.contains("paused");
      const bounds = enabled ? cardSpace?.getBoundingClientRect() : undefined;
      const rotation = bounds ? rotationToward(bounds, event.clientX, event.clientY) : undefined;
      rotation ? tilts.forEach((tilt) => tilt.style.setProperty("--tilt", rotation)) : undefined;
    },
    { passive: true },
  );
  document.documentElement.addEventListener("pointerleave", resetTilt);
  window.addEventListener("blur", resetTilt);
  reducedMotion.addEventListener("change", resetTilt);
  reducedMotion.addEventListener("change", syncRules);
  finePointer.addEventListener("change", resetTilt);
</script>

<style>
  .approach {
    margin-top: 112px;
    scroll-margin-top: 100px;
  }
  .approach *,
  .approach *::before,
  .approach *::after {
    box-sizing: border-box;
  }
  h2 {
    font-family: "Space Grotesk", "Noto Sans JP", sans-serif;
    font-size: clamp(23px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 24px;
    text-wrap: balance;
    word-break: auto-phrase;
  }
  .intro {
    max-width: 640px;
    margin: 0 auto 44px;
    color: #bac1af;
    font-size: 15px;
    line-height: 1.95;
    text-wrap: pretty;
  }
  figure {
    margin: 0;
  }
  .boards {
    display: grid;
    gap: 72px;
    overflow: clip;
    overflow-clip-margin: 12px;
  }
  .board {
    --gap: clamp(24px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 330px) minmax(0, 1fr);
    column-gap: var(--gap);
    row-gap: 44px;
    align-items: center;
    padding: 0 8px;
    text-align: left;
  }
  .admin {
    grid-area: 1 / 2;
    position: relative;
    padding: 13px 16px;
    border: 1px solid #3e4435;
    border-radius: 8px;
    color: #d4d9ca;
  }
  .admin::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    height: 44px;
    border-left: 1px dashed #69725c;
  }
  .admin-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .admin-heading svg {
    stroke: #bac1af;
    stroke-width: 1.3;
    stroke-linecap: round;
    flex-shrink: 0;
  }
  .admin-heading strong {
    font-weight: 500;
  }
  .admin-heading span {
    color: #929c85;
    margin-left: auto;
    font-size: 10px;
  }
  .admin p {
    margin: 6px 0 0;
    font-size: 11px;
    color: #929c85;
  }
  .requester {
    grid-area: 2 / 1;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 8px;
    position: relative;
    text-align: center;
  }
  .person {
    stroke: #d4d9ca;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .requester strong {
    font-size: 14px;
    font-weight: 500;
  }
  .request-text {
    max-width: 100%;
    font-size: 12px;
    line-height: 1.8;
    color: #d4d9ca;
    text-wrap: balance;
  }
  .scenario-index {
    font-family: "Space Mono", monospace;
    font-size: 9px;
    color: #929c85;
    letter-spacing: 0.1em;
  }
  .incoming {
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--gap));
    width: var(--gap);
    height: 1px;
    background: #515944;
  }
  .incoming::after {
    content: "";
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid #7b866b;
    border-right: 1px solid #7b866b;
    transform: rotate(45deg);
  }
  .card-space {
    grid-area: 2 / 2;
    perspective: 900px;
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
  }
  .card-tilt {
    position: relative;
    transform: var(--tilt, rotate3d(0, 1, 0, 0deg));
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    transition: transform 160ms ease-out;
  }
  .rule-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 10px 18px 18px;
    border: 1px solid #94a88070;
    border-radius: 14px;
    background: linear-gradient(135deg, #c5e9870c, #c5e98702 55%, #9bb5780b);
    color: #929f84;
    transform: translate3d(12px, -34px, -18px);
    backface-visibility: hidden;
  }
  .rule-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 10px;
    line-height: 1.5;
  }
  .rule-heading strong {
    font-weight: 400;
  }
  .rule-heading span {
    font-family: "Space Mono", monospace;
    font-size: 7px;
    letter-spacing: 0.03em;
  }
  .rule-data {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    margin: 14px 0 0;
    font-family: "Space Mono", monospace;
    font-size: 9px;
    line-height: 1.9;
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
    mask-image: linear-gradient(#000b, #0005);
  }
  .card-slide {
    transform: translate3d(0, 0, 18px);
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
  }
  .card {
    position: relative;
    padding: 22px 24px 18px;
    border: 1px solid #ffffffb3;
    border-radius: 14px;
    color: #24312c;
    background:
      repeating-linear-gradient(115deg, #0f172a09 0 1px, transparent 1px 4px),
      linear-gradient(135deg, #fff, #e2e8f0 48%, #f8fafc 76%, #cbd5e1);
    backface-visibility: hidden;
  }
  .invalid .card {
    color: #503734;
    border-color: #e9b7a8;
    background:
      repeating-linear-gradient(115deg, #632d2410 0 1px, transparent 1px 4px),
      linear-gradient(135deg, #f4e6df, #cfb5ad 48%, #ead8cf 76%, #b9a09a);
  }
  .invalid .card-top,
  .invalid dt {
    color: #835f56;
  }
  .invalid dl > div:last-child dd {
    color: #a3342c;
  }
  .verification-edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
