---
/**
 * §1 — Three walls. Before/After 2-panel + 3 wall cards.
 */
import type { Locale } from "../../i18n/translations";
import { SOLUTIONS } from "../../data/solutions";
import SolutionsIcon from "./SolutionsIcon.astro";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const w = SOLUTIONS.walls;
---

<section class="sb-section">
  <div class="so-section-eyebrow">{w.eyebrow[locale]}</div>
  <h2 class="so-section-h2">
    {w.h2Head[locale]}<br />
    <span class="accent">{w.h2Accent[locale]}</span>
  </h2>
  <p class="so-section-sub">{w.sub[locale]}</p>

  <div class="sb-compare">
    <div class="sb-panel sb-before">
      <div class="sb-label">{w.before.label[locale]}</div>
      <h3 class="sb-h3">{w.before.title[locale]}</h3>
      <p>{w.before.desc[locale]}</p>
    </div>
    <div class="sb-arrow" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M 4 11 L 18 11 M 13 6 L 18 11 L 13 16" stroke="#8B4513" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </div>
    <div class="sb-panel sb-after">
      <div class="sb-label">{w.after.label[locale]}</div>
      <h3 class="sb-h3">{w.after.title[locale]}</h3>
      <p>{w.after.desc[locale]}</p>
    </div>
  </div>

  <div class="sb-walls">
    {w.items.map((item) => (
      <article class="sb-wall">
        <div class="sb-wall-icon">
          <SolutionsIcon name={item.icon} size={36} />
        </div>
        <div class="sb-wall-eyebrow">Wall {item.no}</div>
        <h3 class="sb-wall-title">{item.title[locale]}</h3>
        <p class="sb-wall-pain">{item.pain[locale]}</p>
        <p class="sb-wall-answer">{item.answer[locale]}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .sb-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    align-items: stretch;
    margin: 0 0 32px;
  }
  .sb-panel {
    border-radius: 18px;
    padding: 32px 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sb-before {
    background: var(--so-legacy-bg);
    border: 0.5px dashed var(--so-legacy-border);
    filter: saturate(0.7);
  }
  .sb-after {
    background: var(--lemma-cream);
    border: 0.5px solid var(--accent);
    box-shadow: 0 6px 28px rgba(139, 69, 19, 0.08);
  }
  .sb-label {
    font-family: var(--so-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sb-label::before {
    content: "";
    display: block;
    width: 22px;
    height: 1px;
  }
  .sb-before .sb-label {
    color: var(--so-legacy-text);
  }
  .sb-before .sb-label::before {
    background: var(--so-legacy-text);
  }
  .sb-after .sb-label {
    color: var(--accent);
  }
  .sb-after .sb-label::before {
    background: var(--accent);
  }
  .sb-h3 {
    font-family: var(--so-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 0 12px;
  }
  .sb-before .sb-h3 {
    color: var(--so-legacy-text);
  }
  .sb-after .sb-h3 {
    color: var(--black);
  }
  .sb-panel p {
    font-size: 13.5px;
    line-height: 1.75;
    margin: 0;
  }
  .sb-before p {
    color: var(--so-legacy-text);
  }
  .sb-after p {
    color: var(--so-text-2);
  }
  .sb-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
  }

  .sb-walls {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 18px;
  }
  .sb-wall {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 26px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
  }
  .sb-wall::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
  }
  .sb-wall-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sb-wall-eyebrow {
    font-family: var(--so-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .sb-wall-title {
    font-family: var(--so-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0;
  }
  .sb-wall-pain {
    font-size: 13.5px;
    color: var(--so-text-3);
    line-height: 1.7;
    margin: 0;
  }
  .sb-wall-answer {
    font-size: 13.5px;
    color: var(--so-text-1);
    line-height: 1.7;
    margin: 0;
    padding-top: 14px;
    border-top: 0.5px solid var(--lemma-line);
  }

  @media (max-width: 880px) {
    .sb-walls {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .sb-compare {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .sb-arrow {
      width: 100%;
      padding: 4px 0;
    }
    .sb-arrow :global(svg) {
      transform: rotate(90deg);
    }
  }
</style>
