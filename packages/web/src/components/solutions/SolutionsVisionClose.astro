---
/**
 * Vision close — dark background, centered, 2 CTAs.
 */
import type { Locale } from "../../i18n/translations";
import { SOLUTIONS } from "../../data/solutions";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const v = SOLUTIONS.visionClose;
---

<section class="sv-section">
  <div class="sv-inner">
    <div class="sv-eyebrow">{v.eyebrow[locale]}</div>
    <h2 class="sv-h2">
      {v.h2Head[locale]}<br />
      <span class="accent">{v.h2Accent[locale]}</span>
    </h2>
    <p class="sv-sub">{v.sub[locale]}</p>
    <div class="sv-cta">
      <a href={v.ctaPrimary.href} class="sv-cta-primary" target="_blank" rel="noopener">
        {v.ctaPrimary.label[locale]}
      </a>
      <a href={v.ctaSecondary.href} class="sv-cta-secondary" target="_blank" rel="noopener">
        {v.ctaSecondary.label[locale]}
      </a>
    </div>
  </div>
</section>

<style>
  .sv-section {
    background: #0f0f0f;
    color: var(--lemma-cream);
    padding: 88px 0 80px;
    /* v30: BriefAnchor (also #0f0f0f) sits directly above — drop the cream
       margin gap and use a hairline divider so the two dark bands sit flush. */
    margin-top: 0;
    border-top: 1px solid rgba(252, 250, 245, 0.08);
    text-align: center;
  }
  .sv-inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .sv-eyebrow {
    font-family: var(--so-mono);
    font-size: 10.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(252, 250, 245, 0.5);
    margin: 0 0 22px;
  }
  .sv-h2 {
    font-family: var(--so-display);
    font-size: 48px;
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 28px;
    letter-spacing: -0.03em;
    color: var(--lemma-cream);
  }
  :root[lang="ja"] .sv-h2 {
    line-height: 1.3;
  }
  .sv-h2 .accent {
    color: var(--accent);
  }
  .sv-sub {
    font-size: 15px;
    color: rgba(252, 250, 245, 0.7);
    margin: 0 auto 36px;
    max-width: 560px;
    line-height: 1.7;
  }
  .sv-cta {
    display: flex;
    gap: 22px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .sv-cta-primary {
    background: var(--accent);
    color: var(--lemma-cream);
    padding: 14px 32px;
    border-radius: 999px;
    font-family: var(--so-display);
    font-size: 14px;
    font-weight: 500;
  }
  .sv-cta-secondary {
    color: rgba(252, 250, 245, 0.7);
    font-family: var(--so-display);
    font-size: 14px;
    padding: 12px 16px;
    transition: color 0.15s;
  }
  .sv-cta-secondary:hover {
    color: var(--lemma-cream);
  }
  @media (max-width: 720px) {
    .sv-section { padding: 64px 0 60px; }
    .sv-h2 { font-size: 36px; }
    .sv-inner { padding: 0 24px; }
  }
</style>
