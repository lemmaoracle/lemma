---
/**
 * Global nav dispatcher — 全ロケール NavigationV2 (Issue #762 で EN も統一)。
 * 呼び出し側の API (locale / t / base) は不変。t は V2 では未使用だが
 * 37+ 箇所の呼び出しを変えないため受け取ったままにする。
 */
import type { Locale, Translations } from "../i18n/translations";
import NavigationV2 from "./NavigationV2.astro";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  base: string;
}

const { locale } = Astro.props;
---

<NavigationV2 locale={locale} />
