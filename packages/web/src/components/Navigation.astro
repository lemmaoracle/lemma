---
import type { Locale } from "../i18n/translations";
import type { Translations } from "../i18n/translations";
import LemmaOracle from "./LemmaOracle.astro";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  base: string;
}

const { locale, t, base } = Astro.props;
const blogPath = base ? `${base}/blog` : "/blog";
const faqPath = base ? `${base}/faq` : "/faq";
const pricingPath = base ? `${base}/pricing` : "/pricing";
const servicesPath = base ? `${base}/services` : "/services";
const pillarsPath = base ? `${base}/pillars` : "/pillars";
const useCasesPath = base ? `${base}/use-cases` : "/use-cases";
const glossaryPath = base ? `${base}/glossary` : "/glossary";
const whitepaperPath = locale === "ja"
  ? "https://tally.so/r/xX0VYv"
  : "https://tally.so/r/7RJXdR";
const githubPath = "https://github.com/lemmaoracle";
const contactPath = base ? `${base}/#contact` : "/#contact";
const homePath = base || "/";

const currentPath = Astro.url.pathname;
const languageSwitchHref =
  locale === "ja"
    ? currentPath.replace(/^\/ja/, "") || "/"
    : `/ja${currentPath}`;

const startsWith = (prefix: string): boolean =>
  prefix !== "" && currentPath.startsWith(prefix);

const isPillarsActive = startsWith(pillarsPath);
const isProductsActive =
  startsWith(servicesPath) || startsWith(pricingPath) || currentPath.startsWith("/trust402");
const isSolutionsActive = startsWith(useCasesPath);
const isResourcesActive =
  startsWith(blogPath) || startsWith(faqPath) || startsWith(glossaryPath);
---

<nav class="mega-nav" id="mainNav">
  <a href={homePath} class="mega-nav-logo">
    <LemmaOracle class="h-[26px] w-auto text-white" />
  </a>

  <!-- DESKTOP LINKS -->
  <ul class="mega-nav-links">
    <!-- 1. なぜLemmaか -->
    <li class="mega-nav-item">
      <a href={pillarsPath} class:list={["mega-nav-link has-mega", { active: isPillarsActive }]}>{t.pillars}</a>
      <div class="mega-panel">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.pillars.label}</div>
          <div class="mega-links">
            <a href={pillarsPath} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.overview}</span>
              <span class="mega-link-sub">{t.mega.pillars.overviewSub}</span>
            </a>
            <a href={`${pillarsPath}/verifiable-origin/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar01}</span>
            </a>
            <a href={`${pillarsPath}/verifiable-ai/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar02}</span>
            </a>
            <a href={`${pillarsPath}/agent-trust-chain/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar03}</span>
            </a>
            <a href={`${pillarsPath}/regulatory-attribute-proof/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar04}</span>
            </a>
          </div>
        </div>
      </div>
    </li>

    <!-- 2. 製品 -->
    <li class="mega-nav-item">
      <a href={servicesPath} class:list={["mega-nav-link has-mega", { active: isProductsActive }]}>{t.services}</a>
      <div class="mega-panel mega-panel-wide">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.products.enterprise}</div>
          <div class="mega-links">
            <a href={servicesPath} class="mega-link">
              <span class="mega-link-title">{t.mega.products.civic}</span>
              <span class="mega-link-sub">{t.mega.products.civicSub}</span>
            </a>
            <a href={servicesPath} class="mega-link">
              <span class="mega-link-title">{t.mega.products.critical}</span>
              <span class="mega-link-sub">{t.mega.products.criticalSub}</span>
            </a>
            <a href={servicesPath} class="mega-link">
              <span class="mega-link-title">{t.mega.products.compliance}</span>
              <span class="mega-link-sub">{t.mega.products.complianceSub}</span>
            </a>
          </div>
        </div>
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.products.developer}</div>
          <div class="mega-links">
            <a href="/trust402/" class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.products.trust402}</span>
              <span class="mega-link-sub">{t.mega.products.trust402Sub}</span>
            </a>
            <a href={pricingPath} class="mega-link">
              <span class="mega-link-title">{t.mega.products.pricing}</span>
              <span class="mega-link-sub">{t.mega.products.pricingSub}</span>
            </a>
          </div>
        </div>
      </div>
    </li>

    <!-- 3. ソリューション -->
    <li class="mega-nav-item">
      <a href={useCasesPath} class:list={["mega-nav-link has-mega", { active: isSolutionsActive }]}>{t.solutions}</a>
      <div class="mega-panel">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.solutions.label}</div>
          <div class="mega-links">
            <a href={useCasesPath} class="mega-link">
              <span class="mega-link-title">{t.mega.solutions.overview}</span>
            </a>
            <a href={`${useCasesPath}/ai-audit-log-proof/`} class="mega-link">
              <span class="mega-link-title">{t.mega.solutions.aiAudit}</span>
            </a>
            <a href={`${useCasesPath}/kyc-aml-selective-disclosure/`} class="mega-link">
              <span class="mega-link-title">{t.mega.solutions.kycAml}</span>
            </a>
            <a href={`${useCasesPath}/supply-chain-esg/`} class="mega-link">
              <span class="mega-link-title">{t.mega.solutions.supplyChain}</span>
            </a>
            <a href={`${useCasesPath}/defi-bridge-verification/`} class="mega-link">
              <span class="mega-link-title">{t.mega.solutions.defiBridge}</span>
            </a>
          </div>
        </div>
      </div>
    </li>

    <!-- 4. 開発者 -->
    <li class="mega-nav-item">
      <div class="mega-nav-link has-mega">{t.developers}</div>
      <div class="mega-panel">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.developers.architecture}</div>
          <div class="mega-links">
            <a href="/trust402/" class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.products.trust402}</span>
              <span class="mega-link-sub">{t.mega.developers.trust402}</span>
            </a>
            <a href={whitepaperPath} class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.developers.whitepaper}</span>
            </a>
            <a href={githubPath} class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.developers.github}</span>
            </a>
          </div>
        </div>
      </div>
    </li>

    <!-- 5. リソース -->
    <li class="mega-nav-item">
      <a href={blogPath} class:list={["mega-nav-link has-mega", { active: isResourcesActive }]}>{t.resources}</a>
      <div class="mega-panel mega-panel-right">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.resources.label}</div>
          <div class="mega-links">
            <a href={blogPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.blog}</span>
            </a>
            <a href={whitepaperPath} class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.resources.whitepaper}</span>
            </a>
            <a href={glossaryPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.glossary}</span>
            </a>
            <a href={faqPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.faq}</span>
            </a>
          </div>
        </div>
      </div>
    </li>
  </ul>

  <div class="mega-nav-right">
    <a href={languageSwitchHref} class="nav-lang">
      {locale === "ja" ? t.languageEn : t.languageJa}
    </a>
    <a href={contactPath} class="nav-cta">{t.contact}</a>
  </div>

  <!-- HAMBURGER -->
  <button class="nav-hamburger" id="navHamburger" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>

  <!-- MOBILE DRAWER -->
  <div class="nav-mobile-drawer" id="navMobileDrawer">
    <div class="mob-section">
      <div class="mob-section-header">{t.pillars} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={pillarsPath} class="mob-link">{t.mega.pillars.overview}</a>
        <a href={`${pillarsPath}/verifiable-origin/`} class="mob-link">{t.mega.pillars.pillar01}</a>
        <a href={`${pillarsPath}/verifiable-ai/`} class="mob-link">{t.mega.pillars.pillar02}</a>
        <a href={`${pillarsPath}/agent-trust-chain/`} class="mob-link">{t.mega.pillars.pillar03}</a>
        <a href={`${pillarsPath}/regulatory-attribute-proof/`} class="mob-link">{t.mega.pillars.pillar04}</a>
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.services} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={servicesPath} class="mob-link">{t.mega.products.civic}<small>{t.mega.products.civicSub}</small></a>
        <a href={servicesPath} class="mob-link">{t.mega.products.critical}<small>{t.mega.products.criticalSub}</small></a>
        <a href={servicesPath} class="mob-link">{t.mega.products.compliance}<small>{t.mega.products.complianceSub}</small></a>
        <a href="/trust402/" class="mob-link" target="_blank">{t.mega.products.trust402}<small>{t.mega.products.trust402Sub}</small></a>
        <a href={pricingPath} class="mob-link">{t.mega.products.pricing}<small>{t.mega.products.pricingSub}</small></a>
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.solutions} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={useCasesPath} class="mob-link">{t.mega.solutions.overview}</a>
        <a href={`${useCasesPath}/ai-audit-log-proof/`} class="mob-link">{t.mega.solutions.aiAudit}</a>
        <a href={`${useCasesPath}/kyc-aml-selective-disclosure/`} class="mob-link">{t.mega.solutions.kycAml}</a>
        <a href={`${useCasesPath}/supply-chain-esg/`} class="mob-link">{t.mega.solutions.supplyChain}</a>
        <a href={`${useCasesPath}/defi-bridge-verification/`} class="mob-link">{t.mega.solutions.defiBridge}</a>
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.developers} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href="/trust402/" class="mob-link" target="_blank">{t.mega.products.trust402}<small>{t.mega.developers.trust402}</small></a>
        <a href={whitepaperPath} class="mob-link" target="_blank">{t.mega.developers.whitepaper}</a>
        <a href={githubPath} class="mob-link" target="_blank">{t.mega.developers.github}</a>
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.resources} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={blogPath} class="mob-link">{t.mega.resources.blog}</a>
        <a href={whitepaperPath} class="mob-link" target="_blank">{t.mega.resources.whitepaper}</a>
        <a href={glossaryPath} class="mob-link">{t.mega.resources.glossary}</a>
        <a href={faqPath} class="mob-link">{t.mega.resources.faq}</a>
      </div>
    </div>

    <div class="mob-cta">
      <a href={contactPath} class="mob-cta-btn">{t.mega.mobile.talkToUs}</a>
    </div>

    <div class="mob-lang">
      <a href={languageSwitchHref}>{locale === "ja" ? t.languageEn : t.languageJa}</a>
    </div>
  </div>
</nav>

<style>
  .mega-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    background: #000; height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5%;
    border-bottom: 1px solid rgba(255,255,255,.06);
    transition: border-color .3s;
  }
  .mega-nav-logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }

  .mega-nav-links {
    display: flex; align-items: stretch; height: 64px;
    list-style: none; gap: 0; margin: 0; padding: 0;
  }
  .mega-nav-item { position: relative; display: flex; align-items: center; }

  .mega-nav-link {
    color: rgba(255,255,255,.5); font-size: 11px; font-weight: 400;
    letter-spacing: .1em; text-decoration: none; text-transform: uppercase;
    padding: 0 16px; height: 64px; display: flex; align-items: center; gap: 5px;
    transition: color .2s; white-space: nowrap;
    background: none; border: none; cursor: pointer; font-family: inherit;
  }
  .mega-nav-link:hover, .mega-nav-link.active { color: #fff; }
  .mega-nav-link.has-mega::after {
    content: ''; width: 4px; height: 4px;
    border-right: 1px solid currentColor; border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px); display: inline-block;
    opacity: .5; transition: transform .2s;
  }
  .mega-nav-item:hover .mega-nav-link.has-mega::after {
    transform: rotate(-135deg) translateY(-2px); opacity: 1;
  }

  .mega-nav-right {
    display: flex; align-items: center; gap: 18px;
  }
  .nav-lang {
    color: rgba(255,255,255,.5);
    font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none; transition: color .2s;
  }
  .nav-lang:hover { color: #fff; }
  .nav-cta {
    background: #fff; color: #000;
    padding: 9px 20px;
    font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase;
    text-decoration: none;
    transition: background .2s, color .2s;
  }
  .nav-cta:hover { background: var(--accent); color: #fff; }

  .mega-panel {
    display: none; position: absolute; top: 64px; left: 0;
    background: #0D0D0D;
    border: 1px solid rgba(255,255,255,.08); border-top: none;
    min-width: 280px; z-index: 999;
  }
  .mega-panel-wide {
    min-width: 520px;
    display: grid; grid-template-columns: 1fr 1fr;
  }
  .mega-panel-wide .mega-section {
    border-bottom: none;
    border-right: 1px solid rgba(255,255,255,.06);
  }
  .mega-panel-wide .mega-section:last-child { border-right: none; }
  .mega-panel-right { left: auto; right: 0; }
  .mega-nav-item:hover .mega-panel { display: block; }
  .mega-nav-item:hover .mega-panel-wide { display: grid; }

  .mega-section { padding: 20px 24px; border-bottom: 1px solid rgba(255,255,255,.06); }
  .mega-section:last-child { border-bottom: none; }
  .mega-section-label {
    font-size: 9px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase;
    color: #8B4513; margin-bottom: 14px;
  }
  .mega-links { display: flex; flex-direction: column; gap: 2px; }
  .mega-link {
    display: flex; flex-direction: column; padding: 10px 12px;
    text-decoration: none; border-left: 2px solid transparent;
    transition: border-color .15s, background .15s;
  }
  .mega-link:hover { border-left-color: #8B4513; background: rgba(255,255,255,.03); }
  .mega-link-title { font-size: 13px; color: rgba(255,255,255,.7); font-weight: 400; line-height: 1.4; margin-bottom: 2px; }
  .mega-link:hover .mega-link-title { color: #fff; }
  .mega-link-sub { font-size: 11px; color: rgba(255,255,255,.28); line-height: 1.3; }

  .nav-hamburger {
    display: none; background: none; border: none; cursor: pointer;
    padding: 8px; flex-direction: column; gap: 5px;
  }
  .nav-hamburger span {
    display: block; width: 22px; height: 1.5px; background: rgba(255,255,255,.7);
    transition: transform .25s, opacity .25s;
  }
  .nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .nav-mobile-drawer {
    display: none; position: fixed; top: 64px; left: 0; right: 0; bottom: 0;
    background: #000; z-index: 999; overflow-y: auto;
    transform: translateX(100%); transition: transform .3s cubic-bezier(.4,0,.2,1);
  }
  .nav-mobile-drawer.open { transform: translateX(0); }

  .mob-section { border-bottom: 1px solid rgba(255,255,255,.06); }
  .mob-section-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 6%; cursor: pointer;
    font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
    color: rgba(255,255,255,.7);
  }
  .mob-section-header .mob-arrow {
    width: 8px; height: 8px;
    border-right: 1px solid rgba(255,255,255,.4); border-bottom: 1px solid rgba(255,255,255,.4);
    transform: rotate(45deg); transition: transform .2s;
    flex-shrink: 0;
  }
  .mob-section.open .mob-section-header .mob-arrow { transform: rotate(-135deg); }
  .mob-section-body { display: none; padding: 0 6% 16px; }
  .mob-section.open .mob-section-body { display: block; }

  .mob-link {
    display: block; padding: 12px 0; text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,.04);
    color: rgba(255,255,255,.55); font-size: 14px; line-height: 1.3;
    transition: color .15s;
  }
  .mob-link:last-child { border-bottom: none; }
  .mob-link:hover { color: #fff; }
  .mob-link small { display: block; font-size: 11px; color: rgba(255,255,255,.28); margin-top: 2px; }

  .mob-cta { padding: 24px 6%; }
  .mob-cta-btn {
    display: block; width: 100%; padding: 16px;
    background: #fff; color: #000; text-align: center;
    font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase;
    border: none; cursor: pointer; text-decoration: none;
    transition: background .2s;
  }
  .mob-cta-btn:hover { background: #8B4513; color: #fff; }

  .mob-lang {
    padding: 16px 6%;
    font-size: 11px; color: rgba(255,255,255,.25); letter-spacing: .08em;
  }
  .mob-lang a { color: rgba(255,255,255,.35); text-decoration: none; }

  @media(max-width:1024px) {
    .mega-nav { padding: 0 6%; }
    .mega-nav-links { display: none; }
    .mega-nav-right { display: none; }
    .nav-hamburger { display: flex; }
    .nav-mobile-drawer { display: block; }
  }
</style>

<script is:inline>
  (function() {
    window.addEventListener('scroll', function() {
      var nav = document.getElementById('mainNav');
      if (nav) nav.style.borderBottomColor =
        scrollY > 60 ? 'rgba(255,255,255,.12)' : 'rgba(255,255,255,.06)';
    }, { passive: true });

    var ham = document.getElementById('navHamburger');
    var mob = document.getElementById('navMobileDrawer');
    if (ham && mob) {
      ham.addEventListener('click', function() {
        var open = mob.classList.toggle('open');
        ham.classList.toggle('open', open);
        document.body.style.overflow = open ? 'hidden' : '';
      });
    }

    document.querySelectorAll('.mob-section-header').forEach(function(hdr) {
      hdr.addEventListener('click', function() {
        var section = hdr.closest('.mob-section');
        var wasOpen = section.classList.contains('open');
        document.querySelectorAll('.mob-section.open').forEach(function(s) { s.classList.remove('open'); });
        if (!wasOpen) section.classList.add('open');
      });
    });
  })();
</script>
