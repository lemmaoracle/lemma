---
/**
 * Global nav dispatcher.
 *
 * JA は Phase 1 共通レイヤー (実装指示 v2 2026-08-03 / mock v24) の
 * 全幅パネルナビ (NavigationV2)。EN は業界ページ等の EN 版が未整備のため
 * 旧メガナビ (NavigationLegacy) を維持する。呼び出し側の API は不変。
 */
import type { Locale, Translations } from "../i18n/translations";
import NavigationLegacy from "./NavigationLegacy.astro";
import NavigationV2 from "./NavigationV2.astro";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  base: string;
}

const { locale, t, base } = Astro.props;
---

{locale === "ja" ? <NavigationV2 /> : <NavigationLegacy locale={locale} t={t} base={base} />}
