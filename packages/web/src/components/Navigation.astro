---
import type { Locale } from "../i18n/translations";
import type { Translations } from "../i18n/translations";
import LemmaOracle from "./LemmaOracle.astro";
import { DASHBOARD_URL } from "../config/cta";
import { SEGMENT_URLS } from "../config/navigation";

interface Props {
  locale: Locale;
  t: Translations["nav"];
  base: string;
}

const { locale, t, base } = Astro.props;
const blogPath = base ? `${base}/blog` : "/blog";
const faqPath = base ? `${base}/faq` : "/faq";
const pricingPath = base ? `${base}/pricing` : "/pricing";
const pillarsPath = base ? `${base}/pillars` : "/pillars";
const useCasesPath = base ? `${base}/solutions/use-cases` : "/solutions/use-cases";
const briefsPath = base ? `${base}/critical/briefs` : "/critical/briefs";
const glossaryPath = base ? `${base}/glossary` : "/glossary";
const authenticityPath = base ? `${base}/authenticity` : "/authenticity";
const guidesPath = base ? `${base}/guides` : "/guides";
const trust402Href = locale === "ja" ? "/ja/trust402/" : "/trust402/";
const trust402SellHref = `${trust402Href}sell/`;
// Phase 1: Lemma API and the Trust402 Institutional ID plan live as anchored
// blocks on /pricing (#api / #t402). The dedicated /lemma-api product node is
// phase 2 — repoint here when it ships.
const apiHref = `${pricingPath}#api`;
const t402PricingHref = `${pricingPath}#t402`;
const plansPrefix = base ? `${base}/plans` : "/plans";
const TALLY_WHITEPAPER_ID = locale === "ja" ? "xX0VYv" : "7RJXdR";
// Nav CTA routes to the self-serve Dashboard ("Get Started"), not the
// Discovery Call. The Discovery Call lives in in-page CTAs (Pillar / UC /
// Solutions §6), see DISCOVERY_CALL_URL usages elsewhere.
const getStartedHref = DASHBOARD_URL;
const homePath = base || "/";

/* Solutions mega-panel — industry headers only (JA).
   The earlier draft listed every use case under each industry; the resulting
   panel was wide enough to overlap the neighbouring Products panel and too
   dense to scan. We now show industry names only, deep-linking to the
   listing's industry filter (`#<key>`), and let the listing carry the
   per-use-case detail. Order mirrors the listing's INDUSTRY_ORDER. */
const SOLUTIONS_INDUSTRIES_JA: ReadonlyArray<{
  readonly key: string;
  readonly heading: string;
}> = [
  { key: "mfg", heading: "製造・基幹インフラ" },
  { key: "fin", heading: "金融・FinTech" },
  { key: "pub", heading: "自治体・公共" },
  { key: "sc", heading: "調達・サプライチェーン" },
  { key: "svc", heading: "サービス・小売" },
  { key: "ai", heading: "AI 導入（業種横断）" },
  { key: "dev", heading: "開発者" },
];

const currentPath = Astro.url.pathname;
const languageSwitchHref =
  locale === "ja"
    ? currentPath.replace(/^\/ja/, "") || "/"
    : `/ja${currentPath}`;

const startsWith = (prefix: string): boolean =>
  prefix !== "" && currentPath.startsWith(prefix);

const isPillarsActive = startsWith(pillarsPath);
// Plans is now the single hub — the old "Developers" lane (Seal / Trust402 /
// Dashboard / Specs) folds in here, so those paths light up Plans too.
const isPlansActive =
  startsWith(plansPrefix) ||
  startsWith(pricingPath) ||
  startsWith(base ? `${base}/seal` : "/seal") ||
  currentPath.includes("/trust402") ||
  startsWith(guidesPath);
const isSolutionsActive = startsWith(useCasesPath);
const isResourcesActive =
  startsWith(blogPath) ||
  startsWith(faqPath) ||
  startsWith(glossaryPath) ||
  startsWith(authenticityPath) ||
  currentPath.startsWith("/critical") ||
  currentPath.startsWith("/ja/critical");
---

<nav class="mega-nav" id="mainNav">
  <a href={homePath} class="mega-nav-logo">
    <LemmaOracle class="mega-nav-mark" />
  </a>

  <!-- DESKTOP LINKS -->
  <ul class="mega-nav-links">
    <!-- 1. プラン — single hub: one engine, audience-tagged columns.
         Absorbs the former "Developers" lane; Seal is folded into Lemma API
         (its /seal LP stays reachable but is not listed). -->
    <li class="mega-nav-item">
      <a href={pricingPath} class:list={["mega-nav-link has-mega", { active: isPlansActive }]}>{t.services}</a>
      <div class="mega-panel mega-panel-plans">
        <div class="mega-plans-grid">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.products.enterprise}</div>
          <div class="mega-links">
            <a href={SEGMENT_URLS.civic[locale]} class="mega-link">
              <span class="mega-link-title">{t.mega.products.civic}</span>
              <span class="mega-link-sub">{t.mega.products.civicSub}</span>
            </a>
            <a href={SEGMENT_URLS.critical[locale]} class="mega-link">
              <span class="mega-link-title">{t.mega.products.critical}</span>
              <span class="mega-link-sub">{t.mega.products.criticalSub}</span>
            </a>
            <a href={SEGMENT_URLS.compliance[locale]} class="mega-link">
              <span class="mega-link-title">{t.mega.products.compliance}</span>
              <span class="mega-link-sub">{t.mega.products.complianceSub}</span>
            </a>
          </div>
        </div>
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.products.developer}</div>
          <div class="mega-links">
            <a href={apiHref} class="mega-link">
              <span class="mega-link-title">{t.mega.products.lemmaApi}</span>
              <span class="mega-link-sub">{t.mega.products.lemmaApiSub}</span>
            </a>
          </div>
        </div>
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.products.agentDeveloper}</div>
          <div class="mega-links">
            <a href={trust402Href} class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.products.trust402Pay}</span>
              <span class="mega-link-sub">{t.mega.products.trust402PaySub}</span>
            </a>
            <a href={trust402SellHref} class="mega-link" target="_blank">
              <span class="mega-link-title">{t.mega.products.trust402Sell}</span>
              <span class="mega-link-sub">{t.mega.products.trust402SellSub}</span>
            </a>
            <a href={t402PricingHref} class="mega-link">
              <span class="mega-link-title">{t.mega.products.institutionalId}</span>
              <span class="mega-link-sub">{t.mega.products.institutionalIdSub}</span>
            </a>
          </div>
        </div>
        </div>
        <a href={pricingPath} class="mega-foot-link">▸ {t.mega.products.seeAllPricing}</a>
      </div>
    </li>

    <!-- 2. ユースケース — lands on the use-cases listing -->
    <li class="mega-nav-item">
      <a href={useCasesPath} class:list={["mega-nav-link has-mega", { active: isSolutionsActive }]}>{t.solutions}</a>
      {locale === "ja" ? (
        <div class="mega-panel">
          <div class="mega-section">
            <div class="mega-section-label">業界別</div>
            <div class="mega-links">
              <a href={useCasesPath} class="mega-link">
                <span class="mega-link-title">ユースケース一覧</span>
                <span class="mega-link-sub">業界・タスク横断で全件を見る</span>
              </a>
              {SOLUTIONS_INDUSTRIES_JA.map((g) => (
                <a href={`${useCasesPath}/#${g.key}`} class="mega-link">
                  <span class="mega-link-title">{g.heading}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="mega-panel">
          <div class="mega-section">
            <div class="mega-section-label">{t.mega.solutions.label}</div>
            <div class="mega-links">
              <a href={useCasesPath} class="mega-link">
                <span class="mega-link-title">{t.mega.solutions.overview}</span>
              </a>
              <a href={`${useCasesPath}/ai-audit-log-proof/`} class="mega-link">
                <span class="mega-link-title">{t.mega.solutions.aiAudit}</span>
              </a>
              <a href={`${useCasesPath}/kyc-aml-selective-disclosure/`} class="mega-link">
                <span class="mega-link-title">{t.mega.solutions.kycAml}</span>
              </a>
              <a href={`${useCasesPath}/supply-chain-esg/`} class="mega-link">
                <span class="mega-link-title">{t.mega.solutions.supplyChain}</span>
              </a>
              <a href={`${useCasesPath}/defi-bridge-verification/`} class="mega-link">
                <span class="mega-link-title">{t.mega.solutions.defiBridge}</span>
              </a>
            </div>
          </div>
        </div>
      )}
    </li>

    <!-- 3. 仕組み — the four pillars -->
    <li class="mega-nav-item">
      <a href={pillarsPath} class:list={["mega-nav-link has-mega", { active: isPillarsActive }]}>{t.pillars}</a>
      <div class="mega-panel">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.pillars.label}</div>
          <div class="mega-links">
            <a href={pillarsPath} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.overview}</span>
              <span class="mega-link-sub">{t.mega.pillars.overviewSub}</span>
            </a>
            <a href={`${pillarsPath}/verifiable-origin/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar01}</span>
            </a>
            <a href={`${pillarsPath}/verifiable-ai/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar02}</span>
            </a>
            <a href={`${pillarsPath}/agent-authority-proof/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar03}</span>
            </a>
            <a href={`${pillarsPath}/regulatory-attribute-proof/`} class="mega-link">
              <span class="mega-link-title">{t.mega.pillars.pillar04}</span>
            </a>
          </div>
        </div>
      </div>
    </li>

    <!-- リソース — Critical Brief leads; FAQ lives here (not top-level) -->
    <li class="mega-nav-item">
      <a href={blogPath} class:list={["mega-nav-link has-mega", { active: isResourcesActive }]}>{t.resources}</a>
      <div class="mega-panel mega-panel-wide mega-panel-right">
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.resources.label}</div>
          <div class="mega-links">
            <a href={briefsPath} class="mega-link">
              <span class="mega-link-title"><span class="mega-link-dot">●</span> {t.mega.resources.criticalBrief}</span>
            </a>
            <a href={blogPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.blog}</span>
            </a>
            <button type="button" class="mega-link mega-link-button" data-tally-open={TALLY_WHITEPAPER_ID} data-tally-emoji-text="">
              <span class="mega-link-title">{t.mega.resources.whitepaper}</span>
            </button>
            <a href={glossaryPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.glossary}</span>
            </a>
            <a href={authenticityPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.authenticity}</span>
            </a>
            <a href={faqPath} class="mega-link">
              <span class="mega-link-title">{t.mega.resources.faq}</span>
            </a>
          </div>
        </div>
        <div class="mega-section">
          <div class="mega-section-label">{t.mega.products.devResources}</div>
          <div class="mega-links">
            <a href={getStartedHref} class="mega-link" target="_blank" rel="noopener">
              <span class="mega-link-title">{t.dashboardCta}</span>
            </a>
            <a href={guidesPath} class="mega-link">
              <span class="mega-link-title">{t.mega.developers.specs}</span>
              <span class="mega-link-sub">{t.mega.developers.specsSub}</span>
            </a>
          </div>
        </div>
      </div>
    </li>
  </ul>

  <div class="mega-nav-right">
    <a href={languageSwitchHref} class="nav-lang">
      {locale === "ja" ? t.languageEn : t.languageJa}
    </a>
    <a href={getStartedHref} target="_blank" rel="noopener" class="nav-cta-pill">{t.contactCta} <span class="nav-cta-arr">↗</span></a>
  </div>

  <!-- HAMBURGER -->
  <button class="nav-hamburger" id="navHamburger" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>

  <!-- MOBILE DRAWER -->
  <div class="nav-mobile-drawer" id="navMobileDrawer">
    <div class="mob-section">
      <div class="mob-section-header">{t.services} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={SEGMENT_URLS.civic[locale]} class="mob-link">{t.mega.products.civic}<small>{t.mega.products.civicSub}</small></a>
        <a href={SEGMENT_URLS.critical[locale]} class="mob-link">{t.mega.products.critical}<small>{t.mega.products.criticalSub}</small></a>
        <a href={SEGMENT_URLS.compliance[locale]} class="mob-link">{t.mega.products.compliance}<small>{t.mega.products.complianceSub}</small></a>
        <a href={apiHref} class="mob-link">{t.mega.products.lemmaApi}<small>{t.mega.products.lemmaApiSub}</small></a>
        <a href={trust402Href} class="mob-link" target="_blank">{t.mega.products.trust402Pay}<small>{t.mega.products.trust402PaySub}</small></a>
        <a href={trust402SellHref} class="mob-link" target="_blank">{t.mega.products.trust402Sell}<small>{t.mega.products.trust402SellSub}</small></a>
        <a href={t402PricingHref} class="mob-link">{t.mega.products.institutionalId}<small>{t.mega.products.institutionalIdSub}</small></a>
        <a href={pricingPath} class="mob-link">▸ {t.mega.products.seeAllPricing}</a>
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.solutions} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        {locale === "ja" ? (
          <>
            <a href={useCasesPath} class="mob-link">ユースケース一覧<small>業界・タスク横断で全件を見る</small></a>
            {SOLUTIONS_INDUSTRIES_JA.map((g) => (
              <a href={`${useCasesPath}/#${g.key}`} class="mob-link">{g.heading}</a>
            ))}
          </>
        ) : (
          <>
            <a href={useCasesPath} class="mob-link">{t.mega.solutions.overview}</a>
            <a href={`${useCasesPath}/ai-audit-log-proof/`} class="mob-link">{t.mega.solutions.aiAudit}</a>
            <a href={`${useCasesPath}/kyc-aml-selective-disclosure/`} class="mob-link">{t.mega.solutions.kycAml}</a>
            <a href={`${useCasesPath}/supply-chain-esg/`} class="mob-link">{t.mega.solutions.supplyChain}</a>
            <a href={`${useCasesPath}/defi-bridge-verification/`} class="mob-link">{t.mega.solutions.defiBridge}</a>
          </>
        )}
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.pillars} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={pillarsPath} class="mob-link">{t.mega.pillars.overview}</a>
        <a href={`${pillarsPath}/verifiable-origin/`} class="mob-link">{t.mega.pillars.pillar01}</a>
        <a href={`${pillarsPath}/verifiable-ai/`} class="mob-link">{t.mega.pillars.pillar02}</a>
        <a href={`${pillarsPath}/agent-authority-proof/`} class="mob-link">{t.mega.pillars.pillar03}</a>
        <a href={`${pillarsPath}/regulatory-attribute-proof/`} class="mob-link">{t.mega.pillars.pillar04}</a>
      </div>
    </div>

    <div class="mob-section">
      <div class="mob-section-header">{t.resources} <span class="mob-arrow"></span></div>
      <div class="mob-section-body">
        <a href={briefsPath} class="mob-link"><span class="mob-link-dot">●</span> {t.mega.resources.criticalBrief}</a>
        <a href={blogPath} class="mob-link">{t.mega.resources.blog}</a>
        <button type="button" class="mob-link mob-link-button" data-tally-open={TALLY_WHITEPAPER_ID} data-tally-emoji-text="">{t.mega.resources.whitepaper}</button>
        <a href={glossaryPath} class="mob-link">{t.mega.resources.glossary}</a>
        <a href={faqPath} class="mob-link">{t.mega.resources.faq}</a>
        <a href={getStartedHref} class="mob-link" target="_blank" rel="noopener">{t.dashboardCta}</a>
        <a href={guidesPath} class="mob-link">{t.mega.developers.specs}<small>{t.mega.developers.specsSub}</small></a>
      </div>
    </div>

    <div class="mob-cta">
      <a href={getStartedHref} target="_blank" rel="noopener" class="mob-cta-btn">{t.mega.mobile.talkToUs}</a>
    </div>

    <div class="mob-lang">
      <a href={languageSwitchHref}>{locale === "ja" ? t.languageEn : t.languageJa}</a>
    </div>
  </div>
</nav>

<!-- v28: brand-bar — saddle-brown rail in normal flow, sits just below the sticky nav. -->
<div class="lemma-brand-bar" aria-hidden="true"></div>

<style>
  /* ─── v28: cream sticky header, Sora typography, brown active underline ─── */
  .mega-nav {
    position: sticky; top: 0; left: 0; right: 0; z-index: 1000;
    background: rgba(252, 250, 245, 0.94);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; gap: 28px;
    border-bottom: 0.5px solid var(--lemma-line, #E5E0D5);
    transition: border-color .3s;
  }
  /* ─── v28: brand-signature logo (always-on brown underline) ─── */
  .mega-nav-logo {
    display: inline-flex; align-items: center;
    text-decoration: none; flex-shrink: 0;
    color: #000;
    transition: color .15s;
    position: relative;
    height: 64px;
    padding-top: 4px;
  }
  .mega-nav-logo:hover { color: var(--accent); }
  /* Wordmark sizing scoped to the Navigation component so it doesn't depend
     on Tailwind utility classes being emitted into the page's CSS bundle —
     pages like /trust402/ have their own static `<style>` and the
     `h-[26px]` utility class would otherwise drop out of their bundle. */
  .mega-nav-mark { height: 26px; width: auto; color: currentColor; display: block; }

  /* ─── v28: compact nav — items right-aligned, smaller font, tighter gap ─── */
  .mega-nav-links {
    display: flex; align-items: stretch; height: 64px;
    list-style: none; gap: 32px; margin: 0; padding: 0; flex: 1;
    justify-content: flex-end;
  }
  .mega-nav-item { position: relative; display: flex; align-items: center; }

  .mega-nav-link {
    font-family: "Sora", system-ui, sans-serif;
    color: #2A2622;
    font-size: 14px; font-weight: 400;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: none;
    padding: 8px 0; height: 64px;
    display: inline-flex; align-items: center;
    transition: color .15s; white-space: nowrap;
    background: none; border: none; cursor: pointer;
    position: relative;
  }
  .mega-nav-link:hover { color: var(--accent); }
  .mega-nav-link.active { color: #000; font-weight: 500; }

  /* ─── v28: nav-right (lang + black pill) ─── */
  .mega-nav-right {
    display: flex; align-items: center; gap: 18px; flex-shrink: 0;
  }
  .nav-lang {
    font-family: "Sora", system-ui, sans-serif;
    color: #5A544D;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color .15s;
  }
  .nav-lang:hover { color: var(--accent); }
  .nav-cta-pill {
    background: var(--accent); color: var(--lemma-cream);
    padding: 9px 18px; border-radius: 6px;
    font-family: "Sora", system-ui, sans-serif;
    font-size: 13px; font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    transition: background .15s;
    white-space: nowrap;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .nav-cta-pill:hover { background: #6e3610; }
  .nav-cta-arr { margin-left: 2px; }

  /* ─── v28: mega-panel as a cream blur card with brown-accent typography ─── */
  .mega-panel {
    display: none; position: absolute; top: 64px; left: 0;
    background: rgba(252, 250, 245, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border: 0.5px solid var(--lemma-line, #E5E0D5);
    border-radius: 14px;
    box-shadow: 0 24px 56px rgba(43, 30, 18, 0.10);
    min-width: 300px; z-index: 999;
    padding: 8px;
    margin-top: 4px;
  }
  /* Hover bridge: fills the 4px gap between the trigger and the panel so the
     menu stays open when the cursor crosses into it. Starts at the trigger's
     bottom edge (top:-4px) and extends down past the gap — never overlaps the
     nav links above, so it doesn't interfere with neighbouring items. */
  .mega-panel::before {
    content: "";
    position: absolute;
    top: -4px; left: 0; right: 0; height: 6px;
  }
  .mega-panel-wide {
    min-width: 540px;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mega-panel-wide .mega-section {
    border-bottom: none;
    border-right: 0.5px solid var(--lemma-line, #E5E0D5);
  }
  .mega-panel-wide .mega-section:last-child { border-right: none; }
  .mega-panel-right { left: auto; right: 0; }
  /* Plans hub: two columns, each stacking two audience sections, + a
     full-width footer link. Right-anchored (opens leftward from the trigger)
     so the compact panel never runs off the right edge on desktop. */
  .mega-panel-plans { min-width: 600px; left: auto; right: 0; }
  /* Three audience columns in a row (enterprise / developer / agent). */
  .mega-plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .mega-plans-grid .mega-section { border-bottom: none; }
  /* Column dividers after the first two columns. */
  .mega-plans-grid .mega-section:nth-child(-n+2) {
    border-right: 0.5px solid var(--lemma-line, #E5E0D5);
  }
  .mega-foot-link {
    display: flex; align-items: center; gap: 6px;
    margin: 4px 6px 2px; padding: 12px 14px;
    border-top: 0.5px solid var(--lemma-line, #E5E0D5);
    border-radius: 8px; text-decoration: none;
    font-family: "Sora", system-ui, sans-serif;
    font-size: 13.5px; font-weight: 600;
    color: var(--accent, #b88746);
    transition: background .15s;
  }
  .mega-foot-link:hover { background: var(--lemma-cream-deep, #F2EEDF); }
  .mega-nav-item:hover .mega-panel { display: block; }
  .mega-nav-item:hover .mega-panel-wide { display: grid; }

  .mega-section { padding: 18px 20px 16px; border-bottom: 0.5px solid var(--lemma-line, #E5E0D5); }
  .mega-section:last-child { border-bottom: none; }
  .mega-section-label {
    font-family: "Space Mono", ui-monospace, monospace;
