---
/**
 * Brief の「この手口・この対策で探す」（2026-10-24）。
 *
 * 対策を探して記事に来た人が、記事を読み終える前でも、同じ手口・同じ対策の
 * 事例の一覧へ移れるようにする。記事のリンクではなく、アーカイブの絞り込み
 * へのカテゴリの入口（タイル）を出す。選び方は lib/briefNextRead.ts。
 *
 * 置き場所は3つ（variant）:
 *   - block：本文の「対策するには」のあと（右レールが消える 1060px 以下だけ）。
 *     描画は記事の外で、ページを開いたときに Sources の直前（rehype が置く
 *     `[data-brief-next-slot]`）へ移す。JS が無ければ本文の直後に残る。
 *   - rail：右レールの目次の下（広い画面・レールは sticky なので読む間ずっと
 *     見える）。
 *   - mobile：表紙の下の畳んだ目次の下（右レールが消える幅だけ・report）。
 *
 * 製品計画がサイトに出たら、対策をゲート（Proof Gate）の分類に差し替え、
 * ゲートのページへの入口を足す。
 */
import { FACET_ICON_ATTRS, FACET_ICON_VIEWBOX } from "../config/briefFacets";
import type { BriefFacetTiles, FacetTile } from "../lib/briefNextRead";

export interface BriefNextReadProps {
  locale: "ja" | "en";
  briefId: string;
  tiles: BriefFacetTiles;
  variant: "block" | "rail" | "mobile";
}

const { locale, briefId, tiles, variant } = Astro.props as BriefNextReadProps;
const isJa = locale === "ja";

const L = isJa
  ? {
      kicker: "対策を探している方へ",
      head: "この手口・この対策の事例を一覧で見る",
      railHead: "この手口・対策で探す",
      methods: "手口",
      controls: "対策",
      count: (n: number) => `${n} 本`,
    }
  : {
      kicker: "Looking for countermeasures",
      head: "See all cases with this method or countermeasure",
      railHead: "Browse by method or fix",
      methods: "Method",
      controls: "Countermeasure",
      count: (n: number) => `${n} brief${n === 1 ? "" : "s"}`,
    };

const groups: ReadonlyArray<{ kind: "methods" | "controls"; label: string; items: ReadonlyArray<FacetTile> }> = [
  { kind: "methods" as const, label: L.methods, items: tiles.methods },
  { kind: "controls" as const, label: L.controls, items: tiles.controls },
].filter((g) => g.items.length > 0);
---

{groups.length > 0 && (
  <aside
    class:list={["nr", `nr--${variant}`]}
    data-brief-next={variant}
    data-brief={briefId}
    aria-label={variant === "block" ? L.head : L.railHead}
  >
    {variant === "block" && <div class="nr-k">{L.kicker}</div>}
    <p class="nr-h" role="heading" aria-level={variant === "block" ? 2 : 3}>
      {variant === "block" ? L.head : L.railHead}
    </p>
    {groups.map((g) => (
      <div class="nr-g">
        <span class="nr-tag">{g.label}</span>
        <div class="nr-tiles">
          {g.items.map((t) => (
            <a
              class="nr-tile"
              href={t.href}
              data-nr-ev="brief_facet_click"
              data-place={variant}
              data-key={t.key}
              data-slug={t.slug}
            >
              <span class="nr-ic">
                <svg viewBox={FACET_ICON_VIEWBOX} {...FACET_ICON_ATTRS} aria-hidden="true" set:html={t.icon} />
              </span>
              <span class="nr-tx">
                <b>{t.label}</b>
                <span>{L.count(t.count)}</span>
              </span>
              <span class="nr-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </aside>
)}

{variant === "block" && (
  <script is:inline>
    (function () {
      var box = document.querySelector('[data-brief-next="block"]');
      var slot = document.querySelector("[data-brief-next-slot]");
      if (box && slot) slot.replaceWith(box);
      // レールと表紙の下のタイルもここで拾う（委譲・置き場所は data-place）。
      document.addEventListener("click", function (e) {
        var el = e.target instanceof Element ? e.target.closest("[data-nr-ev]") : null;
        if (!el || typeof window.gtag !== "function") return;
        var host = el.closest("[data-brief]");
        window.gtag("event", el.getAttribute("data-nr-ev"), {
          brief_id: host ? host.getAttribute("data-brief") : undefined,
          place: el.getAttribute("data-place"),
          facet: el.getAttribute("data-key") + ":" + el.getAttribute("data-slug"),
        });
      });
    })();
  </script>
)}

<style>
  /* ── 共通：タイル（一覧の「対策から読む」と同じ形） ── */
  .nr-tile {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    text-decoration: none;
    color: var(--tx);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .nr-tile:hover,
  .nr-tile:focus-visible {
    border-color: #b8cf7a;
    box-shadow: var(--sh-s);
  }
  .nr-ic {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #eef7d2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2f372f;
  }
  .nr-ic svg {
    width: 24px;
    height: 24px;
  }
  .nr-tx {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .nr-tx b {
    /* 本文の中（block）では本文のリンク色が効くので、色を明示する。 */
    color: var(--tx);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.5;
  }
  .nr-tx span {
    font-size: 11.5px;
    color: #8a9083;
  }
  .nr-arrow {
    margin-left: auto;
    color: #a3a99c;
    transition: transform 0.15s, color 0.15s;
  }
  .nr-tile:hover .nr-arrow {
    color: var(--ok-light);
    transform: translateX(3px);
  }
  .nr-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .nr-h {
    margin: 0;
    color: var(--tx);
  }

  /* ── block：本文の「対策するには」のあと。広い画面ではレールが同じものを
     読む間ずっと見せているので、レールが消える幅（1060px 以下）だけ出す。 ── */
  @media (min-width: 1061px) {
    .nr--block {
      display: none;
    }
  }
  .nr--block {
    margin: 44px 0 8px;
    padding: 22px 24px 24px;
    background: #f3f5ec;
    border: 1px solid #dfe3d2;
    border-radius: 12px;
  }
  .nr--block .nr-k {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--ok-ink);
  }
  .nr--block .nr-h {
    margin-top: 6px;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.5;
  }
  .nr--block .nr-g {
    margin-top: 16px;
  }
  .nr--block .nr-tiles {
    margin-top: 8px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  /* ── rail：右レールの目次の下 ── */
  .nr--rail {
    margin-top: 14px;
    padding: 16px 16px 14px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .nr--rail .nr-h {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
  }
  .nr--rail .nr-g {
    margin-top: 12px;
  }
  .nr--rail .nr-tiles {
    margin-top: 6px;
    display: grid;
    gap: 6px;
  }
  /* レールは幅が狭いので、アイコンを落として文字を広く取る。 */
  .nr--rail .nr-tile {
    gap: 6px;
    padding: 8px 10px;
    border-radius: 9px;
  }
  .nr--rail .nr-ic {
    display: none;
  }
  .nr--rail .nr-tx b {
    font-size: 12px;
    line-height: 1.45;
  }
  .nr--rail .nr-tx span {
    font-size: 10.5px;
  }

  /* ── mobile：表紙の下の畳んだ目次の下（右レールが消える幅だけ） ── */
  .nr--mobile {
    display: none;
  }
  @media (max-width: 1060px) {
    .nr--mobile {
      display: block;
      margin: 12px 0 0;
    }
    .nr--mobile .nr-h {
      font-size: 13px;
      font-weight: 600;
    }
    .nr--mobile .nr-g {
      margin-top: 8px;
    }
    .nr--mobile .nr-tiles {
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .nr--mobile .nr-tile {
      flex: none;
      max-width: 78%;
      gap: 8px;
      padding: 8px 12px 8px 8px;
      border-radius: 999px;
    }
    .nr--mobile .nr-ic {
      width: 26px;
      height: 26px;
      border-radius: 999px;
    }
    .nr--mobile .nr-ic svg {
      width: 16px;
      height: 16px;
    }
    .nr--mobile .nr-tile {
      align-items: center;
    }
    .nr--mobile .nr-tx {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
      min-width: 0;
    }
    .nr--mobile .nr-tx b {
      min-width: 0;
      font-size: 12.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nr--mobile .nr-tx span {
      flex: none;
      white-space: nowrap;
    }
    .nr--mobile .nr-arrow {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .nr--block {
      padding: 18px 16px 20px;
    }
    .nr--block .nr-tiles {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
