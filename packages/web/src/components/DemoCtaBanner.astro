---
import type { Locale, Translations } from "../i18n/translations";
import {
  buildDemoUrl,
  type DemoSampleId,
  type DemoSource,
} from "../config/demoSamples";

export interface Props {
  locale: Locale;
  t: Translations["demoCta"];
  sampleId: DemoSampleId;
  source: DemoSource;
  /** Optional secondary in-body pair-link to a contrasting sample (spec §3g supply-chain-esg). */
  pairSampleId?: DemoSampleId;
}

const { locale, t, sampleId, source, pairSampleId } = Astro.props;
const primaryHref = buildDemoUrl(sampleId, locale, source);
const pairHref = pairSampleId ? buildDemoUrl(pairSampleId, locale, source) : null;
---

<section class="demo-cta-banner">
  <div class="demo-cta-banner-inner">
    <div class="demo-cta-tag">{t.tag}</div>
    <h2 class="demo-cta-title">{t.title}</h2>
    <p class="demo-cta-lead">{t.lead}</p>
    <div class="demo-cta-actions">
      <a class="demo-cta-button" href={primaryHref} target="_blank" rel="noopener">
        {t.ctaLabel}
      </a>
      {
        pairHref && (
          <a class="demo-cta-pair-link" href={pairHref} target="_blank" rel="noopener">
            {t.pairLinkLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  /* v24 chrome: cream-deep card with brown top-bar accent, scoped fonts so
     JA glyphs stay in Noto Sans JP (Layout's --font-display falls back to
     Noto Serif JP = 明朝, which leaked here in the previous version). */
  .demo-cta-banner {
    --dcb-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --dcb-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --dcb-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

    margin: 48px 0 8px;
    padding: 32px 32px 28px;
    background: var(--lemma-cream-deep, #f2eedf);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    font-family: var(--dcb-body);
  }
  :root[lang="en"] .demo-cta-banner {
    --dcb-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }
  .demo-cta-banner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 3px;
    background: var(--accent, #8b4513);
    border-radius: 0 0 3px 0;
  }
  .demo-cta-banner-inner {
    max-width: 720px;
  }
  .demo-cta-tag {
    font-family: var(--dcb-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent, #8b4513);
    margin: 0 0 12px;
  }
  .demo-cta-title {
    font-family: var(--dcb-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 10px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  :root[lang="ja"] .demo-cta-title {
    line-height: 1.45;
  }
  .demo-cta-lead {
    margin: 0 0 20px;
    font-family: var(--dcb-body);
    font-size: 14px;
    line-height: 1.75;
    color: #3a3a3a;
  }
  .demo-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    align-items: center;
  }
  .demo-cta-button {
    display: inline-flex;
    align-items: center;
    background: var(--accent, #8b4513);
    color: var(--lemma-cream, #fcfaf5);
    padding: 12px 26px;
    font-family: var(--dcb-display);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .demo-cta-button:hover {
    background: #6e3610;
  }
  .demo-cta-pair-link {
    font-family: var(--dcb-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--accent, #8b4513);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.35);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }
  .demo-cta-pair-link:hover {
    color: #6e3610;
    border-bottom-color: var(--accent, #8b4513);
  }
  @media (max-width: 640px) {
    .demo-cta-banner {
      padding: 24px 22px 22px;
    }
    .demo-cta-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
