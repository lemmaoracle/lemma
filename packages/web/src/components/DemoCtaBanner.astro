---
import type { Locale, Translations } from "../i18n/translations";
import {
  buildDemoUrl,
  type DemoSampleId,
  type DemoSource,
} from "../config/demoSamples";

export interface Props {
  locale: Locale;
  t: Translations["demoCta"];
  sampleId: DemoSampleId;
  source: DemoSource;
  /** Optional secondary in-body pair-link to a contrasting sample (spec §3g supply-chain-esg). */
  pairSampleId?: DemoSampleId;
}

const { locale, t, sampleId, source, pairSampleId } = Astro.props;
const primaryHref = buildDemoUrl(sampleId, locale, source);
const pairHref = pairSampleId ? buildDemoUrl(pairSampleId, locale, source) : null;
---

<section class="demo-cta-banner">
  <div class="demo-cta-banner-inner">
    <div class="demo-cta-tag">{t.tag}</div>
    <h2 class="demo-cta-title">{t.title}</h2>
    <p class="demo-cta-lead">{t.lead}</p>
    <div class="demo-cta-actions">
      <a class="demo-cta-button" href={primaryHref} target="_blank" rel="noopener">
        {t.ctaLabel}
      </a>
      {
        pairHref && (
          <a class="demo-cta-pair-link" href={pairHref} target="_blank" rel="noopener">
            {t.pairLinkLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .demo-cta-banner {
    margin: 56px 0 8px;
    padding: 28px 32px;
    background: var(--gray-50, #f7f7f6);
    border-left: 2px solid var(--accent, #8b4513);
  }
  .demo-cta-banner-inner {
    max-width: 720px;
  }
  .demo-cta-tag {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #8b4513);
    margin-bottom: 10px;
  }
  .demo-cta-title {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 8px;
    line-height: 1.25;
  }
  :root[lang="ja"] .demo-cta-title {
    line-height: 1.4;
  }
  .demo-cta-lead {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--gray-700, #5f5f5f);
  }
  .demo-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
  }
  .demo-cta-button {
    display: inline-block;
    background: var(--black);
    color: var(--white);
    padding: 10px 22px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }
  .demo-cta-button:hover {
    background: var(--accent, #8b4513);
  }
  .demo-cta-pair-link {
    font-size: 13px;
    color: var(--gray-700, #5f5f5f);
    text-decoration: none;
    border-bottom: 1px solid var(--gray-200, #e2e2e0);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }
  .demo-cta-pair-link:hover {
    color: var(--accent, #8b4513);
    border-bottom-color: var(--accent, #8b4513);
  }
  @media (max-width: 640px) {
    .demo-cta-banner {
      padding: 22px 22px;
    }
    .demo-cta-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
