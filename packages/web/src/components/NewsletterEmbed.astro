---
/**
 * Lemma Critical Monthly newsletter — inline Tally iframe embed.
 *
 * Renders the locale-appropriate Tally form (JA: EkMj82, EN: rjvN2X) as
 * a transparent inline iframe with `dynamicHeight=1` so the iframe sizes
 * to the form contents. The `placement` prop is forwarded as a `ref`
 * query param so Tally insights can split signups by surface.
 *
 * Tally's `embed.js` (loaded from `Layout.astro`) hydrates iframes with
 * the `data-tally-src` attribute on page load.
 */
import type { Locale } from "../i18n/translations";

interface Props {
  locale: Locale;
  /** Forwarded to Tally as `ref=<placement>` for per-surface attribution. */
  placement: "site-footer" | "brief-footer" | "briefs-index" | "blog-footer";
}

const { locale, placement } = Astro.props;
const formId = locale === "ja" ? "EkMj82" : "rjvN2X";
const src = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&ref=${placement}`;
const heading = locale === "ja" ? "ニュースレター" : "Newsletter";
const lead =
  locale === "ja"
    ? "Lemma Critical Monthly — Brief とその構造分析の要点を月 1 回お届け。"
    : "Lemma Critical Monthly — the latest Critical Briefs and the structural analysis behind them, once a month.";
const title = "Lemma Critical Monthly";
---

<div class="newsletter-embed" data-placement={placement}>
  <div class="newsletter-eyebrow">{heading}</div>
  <p class="newsletter-lead">{lead}</p>
  <iframe
    data-tally-src={src}
    loading="lazy"
    width="100%"
    height="120"
    frameborder="0"
    title={title}
    class="newsletter-iframe"
  ></iframe>
</div>

<style>
  .newsletter-embed {
    padding: 24px 24px 18px;
    border: 0.5px solid var(--lemma-line, #E5E0D5);
    border-radius: 12px;
    background: var(--lemma-cream-deep, #F2EEDF);
    margin: 32px 0;
  }
  .newsletter-eyebrow {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent, #8B4513);
    margin: 0 0 10px;
    font-weight: 500;
  }
  .newsletter-lead {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--gray-700, #5F5F5F);
    margin: 0 0 14px;
    max-width: 540px;
  }
  .newsletter-iframe {
    display: block;
    border: 0;
    background: transparent;
  }
  @media (max-width: 720px) {
    .newsletter-embed { padding: 20px 18px 14px; }
  }
</style>
