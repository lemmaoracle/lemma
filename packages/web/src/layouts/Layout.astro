---
import type { Locale } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { getTranslations } from "../i18n/translations";
import MetaTags from "@/components/MetaTags";

interface Props {
  title?: string;
  /** og:title / twitter:title override. Defaults to `title`. Lets a page set a
   * search-optimized <title> while keeping a distinct social-card headline. */
  ogTitle?: string;
  description?: string;
  locale?: Locale;
  metaType?: "home" | "page" | "article";
  post?: BlogPost;
  blogPath?: string;
  pagePath?: string;
  bodyClass?: string;
  noindex?: boolean;
  /** Emit `noindex, follow` (keep internal link equity flowing) instead of
   * the default `noindex, nofollow`. For a thin page that defers to a
   * canonical elsewhere — e.g. a glossary entry deferring to its hub —
   * while still letting crawlers follow its outbound links. */
  noindexFollow?: boolean;
  /** Absolute canonical URL override. When set, the canonical link points
   * here instead of the page's own path, consolidating a thin page onto its
   * cornerstone hub. hreflang alternates are left unchanged. */
  canonicalOverride?: string;
  /** Absolute URL of a page-specific OG image (overrides the locale default). */
  ogImage?: string;
}

const { locale = "en", bodyClass, noindex, noindexFollow } = Astro.props;
const t = getTranslations(locale);
const title = Astro.props.title ?? t.layout.defaultTitle;
const ogTitle = Astro.props.ogTitle ?? title;
const description = Astro.props.description ?? t.layout.defaultDescription;
const base = locale === "ja" ? "/ja" : "";

const shouldRenderMetaTags =
  Astro.props.metaType === "home" ||
  (Astro.props.metaType === "page" && Astro.props.pagePath !== undefined) ||
  (Astro.props.metaType === "article" && Astro.props.post);

const SITE_ORIGIN = "https://lemma.frame00.com";

/**
 * Resolve the canonical path for a given locale.
 *
 * Priority:
 *   1. Explicit metaType info passed by the page (home / page / article).
 *   2. Fallback: derive from the current Astro.url.pathname by stripping
 *      the JA prefix and re-applying the target locale's prefix.
 *
 * The fallback guarantees every page gets canonical + hreflang even when
 * the calling template forgets to pass metaType (e.g. LegalTemplate before
 * this commit). OG / Twitter meta is still gated by `shouldRenderMetaTags`
 * separately so it does not start emitting partial metadata.
 */
function buildLocalePath(targetLocale: Locale): string {
  const prefix = targetLocale === "ja" ? "/ja" : "";
  if (Astro.props.metaType === "home") {
    return `${prefix}/`;
  }
  if (Astro.props.metaType === "page" && Astro.props.pagePath) {
    return `${prefix}${Astro.props.pagePath}`;
  }
  if (
    Astro.props.metaType === "article" &&
    Astro.props.post &&
    Astro.props.blogPath
  ) {
    const blogPathBase = Astro.props.blogPath.replace(/^\/ja/, "");
    return `${prefix}${blogPathBase}/${Astro.props.post.slug}`;
  }
  // Fallback: derive from current URL. Strip the JA prefix so the path
  // is locale-neutral, then re-apply the target locale's prefix.
  const neutral = Astro.url.pathname.replace(/^\/ja(\/|$)/, "/");
  return `${prefix}${neutral}`;
}

const canonicalPath = buildLocalePath(locale);
const enHref = buildLocalePath("en");
const jaHref = buildLocalePath("ja");
const canonicalHref =
  Astro.props.canonicalOverride ?? `${SITE_ORIGIN}${canonicalPath}`;

const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const msClarityId = import.meta.env.PUBLIC_MS_CLARITY_ID ?? "wpq1vh0v64";
---

<!doctype html>
<html lang={locale}>
  <head prefix="og: https://ogp.me/ns#">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && noindexFollow && <meta name="robots" content="noindex, follow" />}
    <!-- Bing Webmaster Tools site verification. Required on the home page; site-wide for robustness. Do not remove. -->
    <meta name="msvalidate.01" content="D005FBC3192939CC3D77FEE8C4E06C09" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={base ? `${base}/favicon.svg` : "/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={base ? `${base}/favicon-32.png` : "/favicon-32.png"} />
    <link rel="apple-touch-icon" sizes="256x256" href={base ? `${base}/apple-touch-icon.png` : "/apple-touch-icon.png"} />
    <meta name="theme-color" content="#8B4513" />
    <meta property="og:site_name" content="Lemma" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      shouldRenderMetaTags && Astro.props.metaType === "home" && (
        <MetaTags type="home" title={title} description={description} base={base} locale={locale} ogImage={Astro.props.ogImage} />
      )
    }
    {
      shouldRenderMetaTags && Astro.props.metaType === "page" && Astro.props.pagePath && (
        <MetaTags
          type="page"
          title={title}
          ogTitle={ogTitle}
          description={description}
          base={base}
          pagePath={Astro.props.pagePath}
          locale={locale}
          ogImage={Astro.props.ogImage}
        />
      )
    }
    {
      shouldRenderMetaTags &&
        Astro.props.metaType === "article" &&
        Astro.props.post &&
        Astro.props.blogPath && (
          <MetaTags
            type="article"
            post={Astro.props.post}
            blogPath={Astro.props.blogPath}
            locale={locale}
            ogImage={Astro.props.ogImage}
          />
        )
    }
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={`${SITE_ORIGIN}${enHref}`} />
    <link rel="alternate" hreflang="ja" href={`${SITE_ORIGIN}${jaHref}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_ORIGIN}${enHref}`} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": `${SITE_ORIGIN}/#organization`,
            name: "Lemma",
            url: SITE_ORIGIN,
            description: "Lemma is the trust infrastructure for AI — ZK-proof system for verifiable AI decisions, agent transactions, and regulatory attributes.",
            logo: {
              "@type": "ImageObject",
              url: `${SITE_ORIGIN}/favicon.svg`,
            },
            sameAs: ["https://x.com/lemmaoracle", "https://github.com/lemmaoracle"],
          },
          {
            "@type": "WebSite",
            "@id": `${SITE_ORIGIN}/#website`,
            url: `${SITE_ORIGIN}/`,
            name: "Lemma",
            description: "Trust infrastructure for AI — ZK-proof system composing four axes: data origin, AI decisions, agent authority, regulatory attributes.",
            publisher: { "@id": `${SITE_ORIGIN}/#organization` },
            inLanguage: ["en", "ja"],
          },
        ],
      })}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Tally widget runtime — required by every `data-tally-open` button and
         every `data-tally-src` iframe on the site. Loaded once, globally. -->
    <script async is:inline src="https://tally.so/widgets/embed.js"></script>
    <!-- Tally hydration fallback (per dev addendum 2026-06-04). Tally's
         `embed.js` sometimes leaves `data-tally-src` iframes with an empty
         `src` (loadEmbeds hook misses). Copy `data-tally-src` -> `src`
         ourselves on DOMContentLoaded, page-swap (View Transitions), and
         window load. Each iframe is only touched once because we skip
         anything that already has a `src`. -->
    <script is:inline>
      (function () {
        var hydrate = function () {
          var fs = document.querySelectorAll('iframe[data-tally-src]:not([src])');
          for (var i = 0; i < fs.length; i++) fs[i].src = fs[i].getAttribute('data-tally-src');
        };
        document.addEventListener('DOMContentLoaded', hydrate);
        document.addEventListener('astro:after-swap', hydrate);
        window.addEventListener('load', hydrate);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400;1,9..40,500;1,9..40,600;1,9..40,700&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700&family=Space+Mono&display=swap" rel="stylesheet" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lemma Blog (English)"
      href={new URL("rss.xml", Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lemma ブログ (日本語)"
      href={new URL("ja/rss.xml", Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lemma Critical Brief (English)"
      href={new URL("critical/briefs/feed.xml", Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lemma Critical Brief (日本語)"
      href={new URL("ja/critical/briefs/feed.xml", Astro.site)}
    />
    {
      googleAnalyticsId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
          />
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${googleAnalyticsId}');
            `}
          />
        </>
      )
    }
    {
      msClarityId && (
        <script
          is:inline
          set:html={`
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "${msClarityId}");
          `}
        />
      )
    }
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  :root {
    --black: #000000;
    --white: #FFFFFF;
    --gray-50: #F5F5F5;
    --gray-200: #E0E0E0;
    --gray-500: #9E9E9E;
    --gray-700: #5F5F5F;
    --gray-800: #1A1A1A;
    --accent: #8B4513;
    --accent-lt: #A0522D;
    --accent-bg: #F5EFE6;
    --lemma-cream: #FCFAF5;
    --lemma-cream-deep: #F2EEDF;
    --lemma-brown-light: #F5EBDC;
    --lemma-line: #E5E5E5;
    --font-display: 'Cormorant Garamond', 'Noto Serif JP', Georgia, serif;
    --font-body: 'DM Sans', 'Hiragino Sans', 'Yu Gothic', sans-serif;
  }

  html { scroll-behavior: smooth; }
  body {
    font-family: var(--font-body);
    background: var(--lemma-cream);
    color: var(--black);
    overflow-x: hidden;
  }

  /* Brand mark moved into the Navigation logo as a per-logo underline
     (see Navigation.astro .mega-nav-logo::after). The standalone
     fixed brand-bar that used to sit at top:64px was removed because
     it duplicated the new logo underline and visually attached itself
     to the menu row. */
</style>
