---
/**
 * Pillars hub — v2 redesign.
 *
 * New structure (per design brief):
 *   1. Hero: mono "信頼レイヤー" eyebrow + 2-line H1 + 4-sentence setup
 *      paragraph
 *   2. Four-questions block (2x2 grid, brown-left-ruled cards)
 *   3. Pillar cards 2x2 — each carries a plain-language elevator as the
 *      new primary message; the v1 poetic tagline drops to an eyebrow
 *      auxiliary, and the poetic subline sits below the elevator with
 *      a dashed brown separator
 *   4. Composition diagram (inline SVG) — central "AI decision" + 4
 *      corner pillars + dotted brown connectors
 *   5. Technical docs (demoted) — small eyebrow + 2-col combined list of
 *      guides + foundations
 *
 * Sub-components live in src/components/pillars/.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { Pillar } from "../data/pillars";
import type { BlogPost } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import PillarHeroIndex from "../components/pillars/PillarHeroIndex.astro";
import PillarCard from "../components/pillars/PillarCard.astro";
import PillarComposition from "../components/pillars/PillarComposition.astro";

export interface PillarsHubTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  pillars: ReadonlyArray<Pillar>;
  pillarT: Translations["pillars"];
  guides?: ReadonlyArray<BlogPost>;
  foundations?: ReadonlyArray<BlogPost>;
}

const {
  locale,
  t,
  base,
  pillars,
  pillarT,
  guides = [],
  foundations = [],
} = Astro.props as PillarsHubTemplateProps;
const blogPath = base ? `${base}/blog` : "/blog";
const pillarsPath = base ? `${base}/pillars` : "/pillars";

const technicalItems = [
  ...guides.map((g) => ({
    kind: "guide" as const,
    href: `${blogPath}/${g.slug}`,
    label: g.category,
    title: g.title,
  })),
  ...foundations.map((f) => ({
    kind: "foundation" as const,
    href: `${blogPath}/${f.slug}`,
    label: f.category,
    title: f.title,
  })),
];

const SITE = "https://lemma.frame00.com";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pillarT.title,
  description: pillarT.subtitle,
  url: `${SITE}${pillarsPath}/`,
  inLanguage: locale,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: pillars.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.title[locale],
      url: `${SITE}${pillarsPath}/${p.slug}/`,
    })),
  },
};
---

<Layout
  locale={locale}
  title={pillarT.metaTitle}
  description={pillarT.subtitle}
  metaType="page"
  pagePath="/pillars/"
  ogImage={`https://lemma.frame00.com/og/pillars/${locale}.png`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="ph-page">
    <div class="ph-container">
      <PillarHeroIndex locale={locale} pillarT={pillarT} />

      <section class="ph-grid" aria-label={pillarT.title}>
        {pillars.map((pillar) => (
          <PillarCard
            locale={locale}
            pillar={pillar}
            href={`${pillarsPath}/${pillar.slug}`}
            ctaLabel={pillarT.viewPillar}
          />
        ))}
      </section>

      <PillarComposition locale={locale} pillarT={pillarT} />

      {technicalItems.length > 0 && (
        <section class="ph-tech" aria-label={pillarT.technicalDocsLabel}>
          <div class="ph-tech-eyebrow">{pillarT.technicalDocsLabel}</div>
          <h2 class="ph-tech-h2">{pillarT.technicalDocsH2}</h2>
          <ul class="ph-tech-grid">
            {technicalItems.map((item) => (
              <li>
                <a href={item.href} class="ph-tech-row">
                  <span class="ph-tech-cat">{item.label}</span>
                  <span class="ph-tech-title">{item.title}</span>
                  <span class="ph-tech-arrow">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .ph-page {
    /* Sora carries Latin; Noto Sans JP backs JA so they don't cascade
       into the Layout-level Cormorant / Noto Serif JP stack. Variables
       are exposed unprefixed to child Pillar* components via :root-level
       cascade. */
    --ph-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --ph-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --ph-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ph-text-1: #1a1a1a;
    --ph-text-2: #3a3a3a;
    --ph-text-3: #5a5a5a;
    --ph-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--ph-text-2);
    font-family: var(--ph-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .ph-page {
    --ph-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  .ph-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── PILLAR CARD GRID ─── */
  .ph-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin: 0 0 8px;
  }

  /* ─── TECHNICAL DOCS (demoted) ─── */
  .ph-tech {
    margin: 32px 0 0;
    padding: 36px 36px 32px;
    background: var(--lemma-cream-deep);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
  }
  .ph-tech::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 48px;
    height: 2px;
    background: var(--accent);
    border-radius: 0 0 2px 0;
  }
  .ph-tech-eyebrow {
    font-family: var(--ph-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }
  .ph-tech-h2 {
    font-family: var(--ph-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 22px;
  }
  .ph-tech-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .ph-tech-grid > li {
    margin: 0;
    border-top: 0.5px solid rgba(139, 69, 19, 0.18);
  }
  .ph-tech-grid > li:nth-child(-n + 2) {
    border-top: none;
  }
  .ph-tech-row {
    display: grid;
    grid-template-columns: 110px 1fr 16px;
    align-items: baseline;
    gap: 16px;
    padding: 14px 4px;
    color: inherit;
    transition: color 0.15s;
  }
  .ph-tech-row:hover {
    color: var(--accent);
  }
  .ph-tech-cat {
    font-family: var(--ph-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ph-tech-title {
    font-family: var(--ph-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--ph-text-1);
    line-height: 1.45;
    transition: color 0.15s;
  }
  .ph-tech-row:hover .ph-tech-title {
    color: var(--accent);
  }
  .ph-tech-arrow {
    font-family: var(--ph-mono);
    font-size: 12px;
    color: var(--ph-text-4);
    text-align: right;
    transition: transform 0.2s, color 0.15s;
  }
  .ph-tech-row:hover .ph-tech-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  @media (max-width: 960px) {
    .ph-grid {
      grid-template-columns: 1fr;
    }
    .ph-tech-grid {
      grid-template-columns: 1fr;
    }
    .ph-tech-grid > li {
      border-top: 0.5px solid rgba(139, 69, 19, 0.18);
    }
    .ph-tech-grid > li:first-child {
      border-top: none;
    }
  }
  @media (max-width: 720px) {
    .ph-container {
      padding: 0 24px;
    }
    .ph-tech {
      padding: 28px 22px 24px;
    }
  }
</style>
