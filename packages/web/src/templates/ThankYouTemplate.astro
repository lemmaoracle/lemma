---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import LemmaOracle from "../components/LemmaOracle.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface ThankYouTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as ThankYouTemplateProps;
const ty = t.thankYou;

const homePath = base || "/";
const langSwitchHref =
  locale === "ja" ? "/thank-you/" : "/ja/thank-you/";
const langSwitchLabel = locale === "ja" ? "English" : "日本語";
const pdfUrl =
  locale === "ja"
    ? "https://drive.google.com/file/d/1K44qTFnM3-4Z19Dr25TxtcetdOFHnrfW/view?usp=sharing"
    : "https://drive.google.com/file/d/1TxcMr2t3NociJeZmBQs1UsCmHZsPJ5Qf/view?usp=sharing";
const tallyUrl = DISCOVERY_CALL_URL[locale];
const whitepaperFormId = locale === "ja" ? "xX0VYv" : "7RJXdR";
---

<Layout locale={locale} title={`Download — Lemma Whitepaper`} description={ty.sub} bodyClass="page-thank-you" noindex>
  <nav class="nav">
    <a href={homePath} class="nav-logo">
      <LemmaOracle class="h-[65px] w-auto text-white" />
    </a>
    <a href={langSwitchHref} class="nav-lang">{langSwitchLabel}</a>
  </nav>

  <main class="main">
    <div class="ty-eyebrow">{ty.eyebrow}</div>

    <h1 class="ty-title">
      <Fragment set:html={ty.title} /><em>{ty.titleEm}</em>
    </h1>

    <div class="ty-rule"></div>

    <p class="ty-sub">{ty.sub}</p>

    <!-- DOWNLOAD CARD -->
    <div class="dl-card">
      <div class="dl-card-label">{ty.dlCard.label}</div>
      <div class="dl-card-title"><Fragment set:html={ty.dlCard.title} /></div>
      <div class="dl-card-desc">{ty.dlCard.desc}</div>
      <a href={pdfUrl} class="btn-download" download>
        {ty.dlCard.button}
      </a>
    </div>

    <!-- NEXT STEP -->
    <div class="next-block">
      <div class="next-label">{ty.next.label}</div>
      <a href={tallyUrl} class="next-card" target="_blank">
        <div class="next-card-text">
          <h3>{ty.next.title}</h3>
          <p>{ty.next.desc}</p>
        </div>
        <div class="next-arrow">→</div>
      </a>
    </div>
  </main>

  <footer class="ty-footer">
    <span class="footer-copy">© 2026 FRAME00, Inc.</span>
    <a href={homePath} class="footer-site">lemma.frame00.com</a>
  </footer>
</Layout>

<style>
  /* Visual parity with /thanks/contact/ (ThanksContactTemplate). The reading
     column is 720px-wide, left-aligned, with no entrance animations.
     dl-card and btn-download are the only whitepaper-specific additions —
     styled in the same dark + amber surface vocabulary as next-card. */
  :global(body.page-thank-you) {
    background: #0D0905;
    color: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: "Sora", system-ui, -apple-system, sans-serif;
  }
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 6%;
  }
  .nav-logo { display: inline-flex; color: #fff; text-decoration: none; }
  .nav-logo :global(svg) { width: auto; display: block; }
  .nav-lang {
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color .2s;
  }
  .nav-lang:hover { color: #fff; }

  .main {
    flex: 1;
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: 80px 24px;
  }
  .ty-eyebrow {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
  }
  .ty-title {
    font-size: 44px;
    line-height: 1.15;
    font-weight: 300;
    margin: 18px 0 24px;
    letter-spacing: -0.01em;
  }
  .ty-title em {
    font-style: normal;
    color: #c98a4b;
    font-weight: 400;
  }
  .ty-rule {
    width: 64px;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    margin: 12px 0 28px;
  }
  .ty-sub {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 40px;
    font-family: "Noto Sans JP", "Sora", system-ui, sans-serif;
  }

  /* Whitepaper download card — same dark surface vocabulary as next-card,
     amber-leading top border + amber CTA to mark it as the primary action. */
  .dl-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 2px solid #c98a4b;
    border-radius: 12px;
    padding: 24px 22px 22px;
    margin: 0 0 40px;
  }
  .dl-card-label {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #c98a4b;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .dl-card-title {
    font-size: 20px;
    font-weight: 500;
    color: #fff;
    line-height: 1.35;
    margin: 0 0 6px;
  }
  .dl-card-desc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin: 0 0 18px;
    font-family: "Noto Sans JP", "Sora", system-ui, sans-serif;
  }
  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    background: #c98a4b;
    color: #1a1408;
    font-family: "Sora", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 8px;
    border: 1px solid #c98a4b;
    transition: background .2s, color .2s, border-color .2s;
  }
  .btn-download:hover {
    background: transparent;
    color: #c98a4b;
  }
  .btn-download::after {
    content: '↓';
    font-size: 14px;
    transition: transform .2s ease;
  }
  .btn-download:hover::after { transform: translateY(2px); }

  .next-block { margin-top: 40px; }
  .next-label {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .next-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: background .15s, border-color .15s;
    margin-bottom: 12px;
  }
  .next-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(201, 138, 75, 0.45);
  }
  .next-card-text h3 {
    font-size: 16px; font-weight: 500;
    margin: 0 0 4px; color: #fff;
  }
  .next-card-text p {
    font-size: 13px; margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-family: "Noto Sans JP", "Sora", system-ui, sans-serif;
    line-height: 1.55;
  }
  .next-arrow {
    margin-left: auto;
    color: #c98a4b;
    font-size: 18px;
  }

  .ty-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 6% 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: "Space Mono", monospace;
  }
  .footer-copy {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.06em;
  }
  .footer-site {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color .2s;
  }
  .footer-site:hover { color: rgba(255, 255, 255, 0.6); }

  @media (max-width: 640px) {
    .main { padding: 60px 6% 80px; }
    .ty-title { font-size: 32px; }
    .dl-card { padding: 22px 20px 20px; }
    .ty-footer { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>

<script is:inline define:vars={{ whitepaperFormId, locale }}>
  // GA4: whitepaper conversion. Tally redirects here on submit, so one page
  // load == one whitepaper submission. The sessionStorage guard keeps a
  // reload from double-counting. No-ops cleanly when gtag is not loaded
  // (e.g. local dev without GOOGLE_ANALYTICS_ID).
  (function () {
    if (typeof window.gtag !== "function") return;
    if (sessionStorage.getItem("cv_wp")) return;
    window.gtag("event", "whitepaper_submit", { form: whitepaperFormId, locale: locale });
    sessionStorage.setItem("cv_wp", "1");
  })();
</script>
