---
/**
 * Pillar detail — v24 chrome.
 *
 * Cream page, 1100px container, Sora display + Noto Sans JP body + Space
 * Mono labels, saddle brown accent. Section blocks numbered §NN like the
 * use-case detail. Card grids (use cases, recent posts, other pillars)
 * reuse the use-case index card vocabulary so the page reads as a single
 * surface family.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { Pillar } from "../data/pillars";
import type { UseCase } from "../data/useCases";
import type { BlogPost } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import PillarElevator from "../components/pillars/PillarElevator.astro";
import PillarConceptIncidents from "../components/pillars/PillarConceptIncidents.astro";
import PillarConceptApproach from "../components/pillars/PillarConceptApproach.astro";
import PillarConceptScenarios from "../components/pillars/PillarConceptScenarios.astro";
import PillarConceptFurther from "../components/pillars/PillarConceptFurther.astro";
import SolutionsBridge from "../components/SolutionsBridge.astro";

export interface PillarDetailTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  pillar: Pillar;
  /** v1 props kept on the interface so existing [slug] pages keep
   * compiling; the concept-hub render path no longer reads them.
   * They will fall off once the v1 callers are cleaned up. */
  useCases?: ReadonlyArray<UseCase>;
  recentPosts?: ReadonlyArray<BlogPost>;
  otherPillars?: ReadonlyArray<Pillar>;
  pillarT: Translations["pillars"];
}

const { locale, t, base, pillar, pillarT } = Astro.props as PillarDetailTemplateProps;
const pillarsPath = `${base}/pillars`;

// Bridge → Solutions「活用シーン」(§2 anchor) for this pillar's axis.
const SOL_ANCHOR: Record<string, { anchor: string; axis: { ja: string; en: string } }> = {
  "verifiable-origin": { anchor: "input-provenance", axis: { ja: "来歴証明", en: "Verifiable Origin" } },
  "agent-authority-proof": { anchor: "agent-authority", axis: { ja: "エージェント権限", en: "Agent Authority" } },
  "regulatory-attribute-proof": { anchor: "regulatory", axis: { ja: "規制属性", en: "Regulatory Attribute" } },
  "verifiable-ai": { anchor: "verifiable-ai", axis: { ja: "検証可能 AI", en: "Verifiable AI" } },
};
const solMeta = SOL_ANCHOR[pillar.slug];
const bridgeHref = solMeta ? `${base}/solutions/#${solMeta.anchor}` : `${base}/solutions/`;
const bridgeCta = solMeta
  ? (locale === "ja" ? `Solutions で ${solMeta.axis.ja}の活用シーンを見る →` : `See use scenarios for ${solMeta.axis.en} in Solutions →`)
  : (locale === "ja" ? "Solutions で活用シーンを見る →" : "See use scenarios in Solutions →");
const numLabel = `Pillar ${String(pillar.order).padStart(2, "0")}`;
const heroSubLabel = locale === "ja" ? pillar.title.en : pillar.title.ja;

const homeLabel = locale === "ja" ? "ホーム" : "Home";

const SITE = "https://lemma.frame00.com";
const pillarUrl = `${SITE}${pillarsPath}/${pillar.slug}/`;
const pageTitle = pillar.seo?.title?.[locale] ?? `${pillar.title[locale]} — ${pillar.slogan[locale]} | Lemma`;
const pageDescription = pillar.seo?.description?.[locale] ?? pillar.problemStatement[locale];
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pillar.title[locale],
  description: pageDescription || pillar.slogan[locale],
  url: pillarUrl,
  inLanguage: locale,
  author: { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Lemma" },
  publisher: { "@id": `${SITE}/#organization` },
  mainEntityOfPage: { "@type": "WebPage", "@id": pillarUrl },
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma", item: `${SITE}${base || ""}/` },
    { "@type": "ListItem", position: 2, name: pillarT.title, item: `${SITE}${pillarsPath}/` },
    { "@type": "ListItem", position: 3, name: pillar.title[locale], item: pillarUrl },
  ],
};
const faqJsonLd = pillar.faq && pillar.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pillar.faq.map((item) => ({
    "@type": "Question",
    name: item.q[locale],
    acceptedAnswer: { "@type": "Answer", text: item.a[locale] },
  })),
} : null;
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  metaType="page"
  pagePath={`/pillars/${pillar.slug}/`}
  ogImage={`https://lemma.frame00.com/og/pillars/${pillar.slug}/${locale}.png`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="pd-page">
    <div class="pd-container">
      <nav class="pd-breadcrumb" aria-label="breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="pd-breadcrumb-sep">/</span>
        <a href={pillarsPath}>{pillarT.title}</a>
        <span class="pd-breadcrumb-sep">/</span>
        <span>{pillar.title[locale]}</span>
      </nav>

      <header class="pd-hero">
        <div class="pd-eyebrow">
          <a class="pd-eyebrow-num" href={pillarsPath}>{numLabel}</a>
          <span class="pd-eyebrow-tag">{pillar.slogan[locale]}</span>
        </div>
        <h1 class="pd-h1">{pillar.title[locale]}</h1>
        <p class="pd-h1-sub">{heroSubLabel}</p>
      </header>

      <PillarElevator locale={locale} pillar={pillar} />

      <article class="pd-main">
        <PillarConceptIncidents locale={locale} base={base} pillar={pillar} pillarT={pillarT} />
        <PillarConceptApproach locale={locale} base={base} pillar={pillar} pillarT={pillarT} />
        <PillarConceptScenarios locale={locale} base={base} pillar={pillar} pillarT={pillarT} />
        <PillarConceptFurther locale={locale} base={base} pillar={pillar} pillarT={pillarT} />
      </article>

    </div>
  </main>

  <SolutionsBridge
    href={bridgeHref}
    eyebrow={locale === "ja" ? "活用シーン" : "Use scenarios"}
    h2={locale === "ja" ? "この軸を、業務でどう動かすか。" : "How does this axis run in your work?"}
    sub={locale === "ja"
      ? "業界・業務領域ごとの活用シーンと、関連ユースケースを Solutions で展開しています。"
      : "We map use scenarios across industries and workflows in Solutions, with related use cases."}
    ctaLabel={bridgeCta}
  />

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .pd-page {
    /* Sora carries Latin; Noto Sans JP backs JA so they don't cascade
       into the Layout-level Cormorant / Noto Serif JP stack. */
    --pd-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --pd-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --pd-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --pd-text-1: #1a1a1a;
    --pd-text-2: #3a3a3a;
    --pd-text-3: #5a5a5a;
    --pd-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--pd-text-2);
    font-family: var(--pd-body);
    font-weight: 400;
    line-height: 1.75;
    padding: 0 0 24px;
    margin-top: 64px;
  }
  :root[lang="en"] .pd-page {
    --pd-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  /* Concept-hub mockup uses container-narrow (820px) end-to-end. */
  .pd-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── BREADCRUMB ─── */
  .pd-breadcrumb {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pd-text-4);
    padding: 36px 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .pd-breadcrumb a {
    color: var(--pd-text-3);
    transition: color 0.15s;
  }
  .pd-breadcrumb a:hover {
    color: var(--accent);
  }
  .pd-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .pd-hero {
    padding: 36px 0 48px;
    max-width: 820px;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  /* v2 hero eyebrow: Pillar number (mono brown link) + poetic X ≠ Y tag
     (italic grey, dashed-left separator). Replaces the v1 single-link
     eyebrow + standalone slogan + attribution. */
  .pd-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 22px;
  }
  .pd-eyebrow-num {
    font-family: var(--pd-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 0.15s;
  }
  .pd-eyebrow-num:hover {
    color: #6e3610;
  }
  .pd-eyebrow-tag {
    font-family: var(--pd-mono);
    font-size: 11px;
    font-style: italic;
    letter-spacing: 0.04em;
    color: var(--pd-text-4);
    padding-left: 14px;
    border-left: 0.5px dashed rgba(139, 69, 19, 0.35);
  }
  .pd-h1 {
    font-family: var(--pd-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin: 0 0 10px;
  }
  :root[lang="ja"] .pd-h1 {
    line-height: 1.25;
  }
  /* Cross-language title (EN under JA H1, JA under EN H1). Saddle brown
     mono-display sub-title — the "Verifiable Origin" callout. */
  .pd-h1-sub {
    font-family: var(--pd-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.01em;
    margin: 0 0 32px;
  }

  /* ─── MAIN / SECTIONS ─── */
  /* Concept-hub mockup uses plain section eyebrows (no §N counter) —
     the eyebrow + 28px brown hairline + H2 with brown accent span do
     the visual sectioning. */
  .pd-main {
    padding: 0;
  }
  /* These rules need :global because the .pd-section / .pd-section-label
     / .pd-section-h2 elements live inside the PillarConcept* child
     components. Astro's default scoped style hash would otherwise miss
     them and §1-§4 render unstyled. */
  :global(.pd-section) {
    margin: 72px 0 0;
  }
  :global(.pd-section-label) {
    font-family: var(--pd-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--pd-text-3);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  :global(.pd-section-label::before) {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  /* Section H2 — head line + brown accent span on line 2. */
  :global(.pd-section-h2) {
    font-family: var(--pd-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 28px;
  }
  :global(:root[lang="ja"] .pd-section-h2) {
    line-height: 1.35;
  }
  :global(.pd-section-h2 .accent) {
    color: var(--accent);
  }

  /* ─── PROSE ─── */
  .pd-prose {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--pd-text-2);
    margin: 0 0 18px;
    max-width: 820px;
  }
  .pd-prose-lead {
    font-size: 17px;
    color: var(--pd-text-1);
    line-height: 1.9;
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }
  .pd-prose :global(strong),
  .pd-prose-lead :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  .pd-prose :global(a),
  .pd-prose-lead :global(a) {
    color: var(--accent);
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
  }
  .pd-prose :global(a:hover),
  .pd-prose-lead :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }
  .pd-prose-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── HOW LIST (saddle brown diamond bullets) ─── */
  .pd-how-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 820px;
  }
  .pd-how-list li {
    position: relative;
    padding-left: 24px;
    margin: 0 0 14px;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--pd-text-2);
  }
  .pd-how-list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  /* ─── CARD GRID (use cases / recent / other pillars) ─── */
  .pd-card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .pd-card-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .pd-card-grid > li {
    margin: 0;
  }
  .pd-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 24px 24px 20px;
    height: 100%;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .pd-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .pd-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .pd-card:hover::before {
    width: 100%;
  }
  .pd-card--compact {
    padding: 22px 22px 18px;
  }
  .pd-card-thesis {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .pd-card-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--pd-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .pd-card-meta-cat {
    color: var(--accent);
  }
  .pd-card-meta-date {
    color: var(--pd-text-4);
  }
  .pd-card-title {
    font-family: var(--pd-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.4;
    margin: 0;
  }
  .pd-card-title--sm {
    font-size: 16px;
  }
  .pd-card-abstract {
    font-size: 13px;
    line-height: 1.7;
    color: var(--pd-text-3);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pd-card-abstract--sm {
    font-size: 12.5px;
  }
  .pd-card-cta {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 14px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .pd-card:hover .pd-card-cta {
    transform: translateX(3px);
  }

  .pd-empty {
    background: var(--lemma-cream-deep);
    border-radius: 12px;
    padding: 32px 28px;
    color: var(--pd-text-3);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* ─── FAQ ─── */
  .pd-faq-list {
    margin: 0;
    padding: 0;
  }
  .pd-faq-item {
    border-top: 0.5px solid var(--lemma-line);
  }
  .pd-faq-item:last-child {
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .pd-faq-q {
    font-family: var(--pd-display);
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--black);
    margin: 0;
    padding: 22px 36px 22px 0;
    cursor: pointer;
    list-style: none;
    position: relative;
    transition: color 0.15s;
  }
  .pd-faq-q::-webkit-details-marker {
    display: none;
  }
  .pd-faq-q::marker {
    content: "";
  }
  .pd-faq-q:hover {
    color: var(--accent);
  }
  .pd-faq-q::after {
    content: "+";
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--pd-mono);
    font-size: 18px;
    font-weight: 500;
    color: var(--accent);
    transition: transform 0.2s;
  }
  .pd-faq-item[open] .pd-faq-q::after {
    content: "−";
  }
  .pd-faq-a {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--pd-text-2);
    margin: 0;
    padding: 0 0 22px;
    max-width: 820px;
  }
  .pd-faq-a :global(a) {
    color: var(--accent);
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
  }
  .pd-faq-a :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }

  /* ─── PARTNER CTA (v24 inline, replaces v22 black band) ─── */
  .pd-partner {
    margin: 40px 0 0;
    padding: 48px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 16px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .pd-partner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 96px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 3px;
  }
  .pd-partner-eyebrow {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }
  .pd-partner-h2 {
    font-family: var(--pd-display);
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }
  :root[lang="ja"] .pd-partner-h2 {
    line-height: 1.35;
  }
  .pd-partner-body {
    font-size: 14.5px;
    color: var(--pd-text-2);
    line-height: 1.8;
    margin: 0 auto 28px;
    max-width: 540px;
  }
  .pd-partner-cta {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .pd-partner-primary,
  .pd-partner-secondary {
    font-family: var(--pd-display);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 13px 30px;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .pd-partner-primary {
    background: var(--accent);
    color: var(--lemma-cream);
    border: 0;
  }
  .pd-partner-primary:hover {
    background: #6e3610;
  }
  .pd-partner-secondary {
    background: var(--white);
    color: var(--accent);
    border: 0.5px solid var(--lemma-line);
  }
  .pd-partner-secondary:hover {
    border-color: var(--accent);
    background: var(--lemma-brown-light);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .pd-card-grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }
    :global(.pd-section-h2) {
      font-size: 22px;
    }
  }
  @media (max-width: 720px) {
    .pd-container {
      padding: 0 24px;
    }
    .pd-hero {
      padding: 28px 0 36px;
    }
    .pd-main {
      padding: 32px 0 0;
    }
    :global(.pd-section) {
      padding-bottom: 40px;
      margin-bottom: 40px;
    }
    .pd-card-grid,
    .pd-card-grid--3 {
      grid-template-columns: 1fr;
    }
    .pd-partner {
      padding: 36px 24px;
    }
  }
</style>
