---
/**
 * Pillar detail — v24 chrome.
 *
 * Cream page, 1100px container, Sora display + Noto Sans JP body + Space
 * Mono labels, saddle brown accent. Section blocks numbered §NN like the
 * use-case detail. Card grids (use cases, recent posts, other pillars)
 * reuse the use-case index card vocabulary so the page reads as a single
 * surface family.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { Pillar, CTA } from "../data/pillars";
import type { UseCase } from "../data/useCases";
import type { BlogPost } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import DemoCtaBanner from "../components/DemoCtaBanner.astro";
import { DISCOVERY_CALL, DISCOVERY_CALL_URL } from "../config/cta";
import { getDemoSampleForPillar } from "../config/demoSamples";

const resolveCTA = (cta: CTA, lc: Locale): { readonly label: string; readonly href: string } =>
  cta.type === "talk-to-us"
    ? { label: DISCOVERY_CALL[lc].buttonLabel, href: DISCOVERY_CALL_URL[lc] }
    : { label: cta.label, href: cta.href };

/** Trim a use case abstract to the first sentence for the card grid. */
function firstSentence(text: string): string {
  const m = text.match(/^([^。.!?！？]+[。.!?！？])/);
  return (m?.[1] ?? text).trim();
}

export interface PillarDetailTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  pillar: Pillar;
  useCases: ReadonlyArray<UseCase>;
  recentPosts: ReadonlyArray<BlogPost>;
  otherPillars: ReadonlyArray<Pillar>;
  pillarT: Translations["pillars"];
}

const { locale, t, base, pillar, useCases, recentPosts, otherPillars, pillarT } = Astro.props as PillarDetailTemplateProps;
const pillarsPath = `${base}/pillars`;
const useCasesPath = `${base}/use-cases`;
const demoSampleId = getDemoSampleForPillar(pillar.slug);

const homeLabel = locale === "ja" ? "ホーム" : "Home";

const SITE = "https://lemma.frame00.com";
const pillarUrl = `${SITE}${pillarsPath}/${pillar.slug}/`;
const pageTitle = pillar.seo?.title?.[locale] ?? `${pillar.title[locale]} — ${pillar.slogan[locale]} | Lemma`;
const pageDescription = pillar.seo?.description?.[locale] ?? pillar.problemStatement[locale];
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pillar.title[locale],
  description: pageDescription || pillar.slogan[locale],
  url: pillarUrl,
  inLanguage: locale,
  author: { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Lemma Oracle" },
  publisher: { "@id": `${SITE}/#organization` },
  mainEntityOfPage: { "@type": "WebPage", "@id": pillarUrl },
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma Oracle", item: `${SITE}${base || ""}/` },
    { "@type": "ListItem", position: 2, name: pillarT.title, item: `${SITE}${pillarsPath}/` },
    { "@type": "ListItem", position: 3, name: pillar.title[locale], item: pillarUrl },
  ],
};
const faqJsonLd = pillar.faq && pillar.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pillar.faq.map((item) => ({
    "@type": "Question",
    name: item.q[locale],
    acceptedAnswer: { "@type": "Answer", text: item.a[locale] },
  })),
} : null;
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  metaType="page"
  pagePath={`/pillars/${pillar.slug}/`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="pd-page">
    <div class="pd-container">
      <nav class="pd-breadcrumb" aria-label="breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="pd-breadcrumb-sep">/</span>
        <a href={pillarsPath}>{pillarT.title}</a>
        <span class="pd-breadcrumb-sep">/</span>
        <span>{pillar.title[locale]}</span>
      </nav>

      <header class="pd-hero">
        <a href={pillarsPath} class="pd-eyebrow">P{pillar.order} · {pillarT.title}</a>
        <h1 class="pd-h1">{pillar.title[locale]}</h1>
        <p class="pd-slogan">{pillar.slogan[locale]}</p>
        {pillar.subtitle[locale] && (
          <p class="pd-subtitle">{pillar.subtitle[locale]}</p>
        )}
        <p class="pd-attribution">{pillarT.categoryAttribution}</p>
      </header>

      <article class="pd-main">
        <section class="pd-section">
          <div class="pd-section-label">{pillarT.blockProblem}</div>
          <p class="pd-prose pd-prose-lead" set:html={pillar.problemStatement[locale]} />
        </section>

        <section class="pd-section">
          <div class="pd-section-label">{pillarT.blockWhyNow}</div>
          <p class="pd-prose pd-prose-lead">{pillar.whyNow[locale]}</p>
        </section>

        <section class="pd-section">
          <div class="pd-section-label">{pillarT.blockHowLemmaFits}</div>
          <ul class="pd-how-list">
            {pillar.howLemmaFits[locale].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        {pillar.extraSection && (
          <section class="pd-section">
            <div class="pd-section-label">{pillar.extraSection.label[locale]}</div>
            <h2 class="pd-section-h2">{pillar.extraSection.heading[locale]}</h2>
            <div class="pd-prose-stack">
              {pillar.extraSection.paragraphs[locale].map((p) => (
                <p class="pd-prose" set:html={p} />
              ))}
            </div>
          </section>
        )}

        <section class="pd-section">
          <div class="pd-section-label">{pillarT.blockUseCases}</div>
          {useCases.length > 0 ? (
            <ul class="pd-card-grid">
              {useCases.map((uc) => (
                <li>
                  <a href={`${useCasesPath}/${uc.slug}`} class="pd-card">
                    {uc.thesis && <div class="pd-card-thesis">{uc.thesis}</div>}
                    <h3 class="pd-card-title">{uc.title}</h3>
                    <p class="pd-card-abstract">{firstSentence(uc.abstract)}</p>
                    <span class="pd-card-cta">{pillarT.viewUseCase}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="pd-empty">{pillarT.comingSoon}</p>
          )}
        </section>

        {recentPosts.length > 0 && (
          <section class="pd-section">
            <div class="pd-section-label">{pillarT.blockRecentThinking}</div>
            <ul class="pd-card-grid pd-card-grid--3">
              {recentPosts.map((post) => (
                <li>
                  <a href={`${base}/blog/${post.slug}`} class="pd-card pd-card--compact">
                    <div class="pd-card-meta">
                      <span class="pd-card-meta-cat">{post.category}</span>
                      <span class="pd-card-meta-date">{post.date}</span>
                    </div>
                    <h3 class="pd-card-title pd-card-title--sm">{post.title}</h3>
                    <p class="pd-card-abstract pd-card-abstract--sm">{post.abstract}</p>
                    <span class="pd-card-cta">{t.blog.index.readGuide}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {pillar.faq && pillar.faq.length > 0 && (
          <section class="pd-section">
            <div class="pd-section-label">FAQ</div>
            <div class="pd-faq-list">
              {pillar.faq.map((item) => (
                <details class="pd-faq-item">
                  <summary class="pd-faq-q">{item.q[locale]}</summary>
                  <div class="pd-faq-a" set:html={item.a[locale]} />
                </details>
              ))}
            </div>
          </section>
        )}

        {otherPillars.length > 0 && (
          <section class="pd-section">
            <div class="pd-section-label">{pillarT.blockOtherPillars}</div>
            <ul class="pd-card-grid pd-card-grid--3">
              {otherPillars.map((p) => (
                <li>
                  <a href={`${pillarsPath}/${p.slug}`} class="pd-card pd-card--compact">
                    <span class="pd-card-thesis">P{p.order}</span>
                    <h3 class="pd-card-title pd-card-title--sm">{p.title[locale]}</h3>
                    {p.subtitle[locale] && (
                      <p class="pd-card-abstract pd-card-abstract--sm">{p.subtitle[locale]}</p>
                    )}
                    <span class="pd-card-cta">{pillarT.viewPillar}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {demoSampleId && (
          <DemoCtaBanner
            locale={locale}
            t={t.demoCta}
            sampleId={demoSampleId}
            source="pillars"
          />
        )}

        <section class="pd-partner" aria-label={pillar.ctaCopy?.eyebrow[locale] ?? pillarT.ctaEyebrow}>
          <div class="pd-partner-eyebrow">{pillar.ctaCopy?.eyebrow[locale] ?? pillarT.ctaEyebrow}</div>
          <h2 class="pd-partner-h2">{pillar.ctaCopy?.title[locale] ?? pillarT.ctaTitle}</h2>
          <p class="pd-partner-body">{pillar.ctaCopy?.desc[locale] ?? pillarT.ctaDesc}</p>
          {(() => {
            const primary = resolveCTA(pillar.primaryCTA, locale);
            const secondary = pillar.secondaryCTA ? resolveCTA(pillar.secondaryCTA, locale) : undefined;
            return (
              <div class="pd-partner-cta">
                <a
                  href={primary.href}
                  class="pd-partner-primary"
                  target={primary.href.startsWith("http") ? "_blank" : undefined}
                  rel={primary.href.startsWith("http") ? "noopener" : undefined}
                >
                  {primary.label}
                </a>
                {secondary && (
                  <a
                    href={secondary.href}
                    class="pd-partner-secondary"
                    target={secondary.href.startsWith("http") ? "_blank" : undefined}
                    rel={secondary.href.startsWith("http") ? "noopener" : undefined}
                  >
                    {secondary.label}
                  </a>
                )}
              </div>
            );
          })()}
        </section>
      </article>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .pd-page {
    /* Sora carries Latin; Noto Sans JP backs JA so they don't cascade
       into the Layout-level Cormorant / Noto Serif JP stack. */
    --pd-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --pd-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --pd-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --pd-text-1: #1a1a1a;
    --pd-text-2: #3a3a3a;
    --pd-text-3: #5a5a5a;
    --pd-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--pd-text-2);
    font-family: var(--pd-body);
    font-weight: 400;
    line-height: 1.75;
    padding: 0 0 24px;
    margin-top: 64px;
  }
  :root[lang="en"] .pd-page {
    --pd-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  .pd-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── BREADCRUMB ─── */
  .pd-breadcrumb {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pd-text-4);
    padding: 36px 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .pd-breadcrumb a {
    color: var(--pd-text-3);
    transition: color 0.15s;
  }
  .pd-breadcrumb a:hover {
    color: var(--accent);
  }
  .pd-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .pd-hero {
    padding: 36px 0 48px;
    max-width: 820px;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .pd-eyebrow {
    font-family: var(--pd-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 20px;
    transition: color 0.15s;
  }
  .pd-eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--accent);
  }
  .pd-eyebrow:hover {
    color: #6e3610;
  }
  .pd-h1 {
    font-family: var(--pd-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 18px;
  }
  :root[lang="ja"] .pd-h1 {
    line-height: 1.25;
  }
  /* Slogan: the conceptual hook ("X ≠ Y"). Saddle brown, weight 500, not
     italic — faked italics on JA glyphs read serif-y. Brown left rule
     anchors it like the use-case thesis. */
  .pd-slogan {
    font-family: var(--pd-display);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 600;
    color: var(--accent);
    line-height: 1.5;
    margin: 0 0 22px;
    max-width: 720px;
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--accent);
  }
  .pd-subtitle {
    font-size: 15.5px;
    color: var(--pd-text-2);
    line-height: 1.8;
    margin: 0 0 18px;
    max-width: 720px;
  }
  .pd-attribution {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pd-text-4);
    margin: 0;
  }

  /* ─── MAIN / SECTIONS ─── */
  .pd-main {
    padding: 40px 0 0;
    counter-reset: pdsec;
  }
  /* Each section increments a CSS counter; the §N badge is surfaced via
     the section label below. No bottom rule between sections — the §N
     badge becomes the visual break. */
  .pd-section {
    counter-increment: pdsec;
    padding: 0 0 56px;
    margin: 0 0 56px;
  }
  .pd-section:last-of-type {
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .pd-section-label {
    font-family: var(--pd-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pd-section-label::before {
    content: "§ " counter(pdsec, decimal-leading-zero);
    color: var(--accent);
    font-family: var(--pd-mono);
    letter-spacing: 0.18em;
    flex-shrink: 0;
    border-right: 0.5px solid rgba(139, 69, 19, 0.3);
    padding-right: 12px;
  }
  .pd-section-h2 {
    font-family: var(--pd-display);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 18px;
    max-width: 820px;
  }
  :root[lang="ja"] .pd-section-h2 {
    line-height: 1.35;
  }

  /* ─── PROSE ─── */
  .pd-prose {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--pd-text-2);
    margin: 0 0 18px;
    max-width: 820px;
  }
  .pd-prose-lead {
    font-size: 17px;
    color: var(--pd-text-1);
    line-height: 1.9;
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }
  .pd-prose :global(strong),
  .pd-prose-lead :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  .pd-prose :global(a),
  .pd-prose-lead :global(a) {
    color: var(--accent);
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
  }
  .pd-prose :global(a:hover),
  .pd-prose-lead :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }
  .pd-prose-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── HOW LIST (saddle brown diamond bullets) ─── */
  .pd-how-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 820px;
  }
  .pd-how-list li {
    position: relative;
    padding-left: 24px;
    margin: 0 0 14px;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--pd-text-2);
  }
  .pd-how-list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  /* ─── CARD GRID (use cases / recent / other pillars) ─── */
  .pd-card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .pd-card-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .pd-card-grid > li {
    margin: 0;
  }
  .pd-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 24px 24px 20px;
    height: 100%;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .pd-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .pd-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .pd-card:hover::before {
    width: 100%;
  }
  .pd-card--compact {
    padding: 22px 22px 18px;
  }
  .pd-card-thesis {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .pd-card-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--pd-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .pd-card-meta-cat {
    color: var(--accent);
  }
  .pd-card-meta-date {
    color: var(--pd-text-4);
  }
  .pd-card-title {
    font-family: var(--pd-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.4;
    margin: 0;
  }
  .pd-card-title--sm {
    font-size: 16px;
  }
  .pd-card-abstract {
    font-size: 13px;
    line-height: 1.7;
    color: var(--pd-text-3);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pd-card-abstract--sm {
    font-size: 12.5px;
  }
  .pd-card-cta {
    font-family: var(--pd-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 14px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .pd-card:hover .pd-card-cta {
    transform: translateX(3px);
  }

  .pd-empty {
    background: var(--lemma-cream-deep);
    border-radius: 12px;
    padding: 32px 28px;
    color: var(--pd-text-3);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* ─── FAQ ─── */
  .pd-faq-list {
    margin: 0;
    padding: 0;
  }
  .pd-faq-item {
    border-top: 0.5px solid var(--lemma-line);
  }
  .pd-faq-item:last-child {
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .pd-faq-q {
    font-family: var(--pd-display);
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--black);
    margin: 0;
    padding: 22px 36px 22px 0;
    cursor: pointer;
    list-style: none;
    position: relative;
    transition: color 0.15s;
  }
  .pd-faq-q::-webkit-details-marker {
    display: none;
  }
  .pd-faq-q::marker {
    content: "";
  }
  .pd-faq-q:hover {
    color: var(--accent);
  }
  .pd-faq-q::after {
    content: "+";
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--pd-mono);
    font-size: 18px;
    font-weight: 500;
    color: var(--accent);
    transition: transform 0.2s;
  }
  .pd-faq-item[open] .pd-faq-q::after {
    content: "−";
  }
  .pd-faq-a {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--pd-text-2);
    margin: 0;
    padding: 0 0 22px;
    max-width: 820px;
  }
  .pd-faq-a :global(a) {
    color: var(--accent);
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
  }
  .pd-faq-a :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }

  /* ─── PARTNER CTA (v24 inline, replaces v22 black band) ─── */
  .pd-partner {
    margin: 40px 0 0;
