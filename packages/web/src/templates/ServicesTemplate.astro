---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import HeroCover from "../assets/rag.jpg";
import SolutionBg from "../assets/cover.jpg";

export interface ServicesTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as ServicesTemplateProps;
const s = t.services;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Lemma Oracle",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Cloud / API",
  description:
    locale === "ja"
      ? "ZK証明による検証可能AI・データ認証インフラ"
      : "ZK-proof infrastructure for verifiable AI and data authentication",
  offers: {
    "@type": "Offer",
    category: "SaaS",
  },
  provider: {
    "@type": "Organization",
    name: "FRAME00",
    url: "https://corp.frame00.com",
  },
  featureList: [
    "Zero-knowledge proof data verification",
    "DID-based provenance tracking",
    "Verifiable attribute extraction",
    "Agent AI trust layer",
  ],
};

const walls: ReadonlyArray<
  Readonly<{ num: string; title: string; body: string; links: ReadonlyArray<Readonly<{ text: string; href: string }>> }>
> = [
  { num: s.walls.wall1Num, title: s.walls.wall1Title, body: s.walls.wall1Body, links: s.walls.wall1Links },
  { num: s.walls.wall2Num, title: s.walls.wall2Title, body: s.walls.wall2Body, links: s.walls.wall2Links },
  { num: s.walls.wall3Num, title: s.walls.wall3Title, body: s.walls.wall3Body, links: s.walls.wall3Links },
];

const beforeRows: ReadonlyArray<readonly [string, string]> = [
  [s.beforeAfter.before1Label, s.beforeAfter.before1Text],
  [s.beforeAfter.before2Label, s.beforeAfter.before2Text],
  [s.beforeAfter.before3Label, s.beforeAfter.before3Text],
  [s.beforeAfter.before4Label, s.beforeAfter.before4Text],
  [s.beforeAfter.before5Label, s.beforeAfter.before5Text],
  [s.beforeAfter.before6Label, s.beforeAfter.before6Text],
];
const afterRows: ReadonlyArray<readonly [string, string]> = [
  [s.beforeAfter.after1Label, s.beforeAfter.after1Text],
  [s.beforeAfter.after2Label, s.beforeAfter.after2Text],
  [s.beforeAfter.after3Label, s.beforeAfter.after3Text],
  [s.beforeAfter.after4Label, s.beforeAfter.after4Text],
  [s.beforeAfter.after5Label, s.beforeAfter.after5Text],
  [s.beforeAfter.after6Label, s.beforeAfter.after6Text],
];

const checklistItems: ReadonlyArray<string> = [
  s.checklist.item1,
  s.checklist.item2,
  s.checklist.item3,
  s.checklist.item4,
  s.checklist.item5,
  s.checklist.item6,
];
---

<Layout
  locale={locale}
  title={s.title}
  description={s.metaDescription}
  metaType="page"
  pagePath="/services/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <section class="page-hero">
    <div class="page-hero-bg" style={`background-image: url(${HeroCover.src})`}></div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content reveal">
      <div class="section-tag">{s.hero.eyebrow}</div>
      <h1>{s.hero.title}</h1>
      <p class="page-hero-sub">{s.hero.sub}</p>
      <div class="hero-cta-btns">
        <a href={s.cta.hubspotFormUrl} class="btn-hero-primary" target="_blank" rel="noopener">{s.hero.ctaDownload}</a>
        <a href={s.demo.href} class="btn-hero-outline" target="_blank" rel="noopener">{s.hero.ctaDemo}</a>
      </div>
    </div>
  </section>

  <section class="problem-section reveal" id="problems">
    <div class="section-header">
      <div class="section-tag">{s.problem.label}</div>
      <h2>{s.problem.title}</h2>
      <p>{s.problem.lead}</p>
    </div>
    <table class="challenge-table">
      <thead><tr>
        <th>{s.problem.tableHeaderCategory}</th>
        <th>{s.problem.tableHeaderContent}</th>
      </tr></thead>
      <tbody>
        <tr><td><strong>{s.problem.issue1Tag}</strong></td><td>{s.problem.issue1Content}</td></tr>
        <tr><td><strong>{s.problem.issue2Tag}</strong></td><td>{s.problem.issue2Content}</td></tr>
        <tr><td><strong>{s.problem.issue3Tag}</strong></td><td>{s.problem.issue3Content}</td></tr>
        <tr><td><strong>{s.problem.issue4Tag}</strong></td><td>{s.problem.issue4Content}</td></tr>
      </tbody>
    </table>
    <p class="problem-highlight">{s.problem.highlight}</p>
  </section>

  <section class="problems-section" id="structural-barriers">
    <div class="section-header reveal">
      <div class="section-tag">{s.walls.label}</div>
      <h2>{s.walls.title}</h2>
    </div>
    <div class="problems-grid">
      {walls.map((w) => (
        <div class="problem-card reveal">
          <div class="problem-num">{w.num}</div>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
          <div class="wall-pillar-links">
            {w.links.map((link, i) => (
              <>
                {i > 0 ? <span class="wall-pillar-sep"> / </span> : <span aria-hidden="true">→ </span>}
                <a href={link.href}>{link.text}</a>
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="solution-section" id="pillars">
    <div class="solution-bg" style={`background-image: url(${SolutionBg.src})`}></div>
    <div class="solution-overlay"></div>
    <div class="solution-inner">
      <div class="section-tag" style="color:var(--accent)">{s.solution.label}</div>
      <h2>{s.solution.title}</h2>
      <p class="solution-lead">{s.solution.lead}</p>
      <div class="pillars-grid">
        {s.solution.pillars.map((p) => (
          <a href={p.href} class="pillar-card reveal">
            <div class="pillar-num">{p.num}</div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="pillar-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="solution-badge">{s.solution.badge}</div>
    </div>
  </section>

  <section class="ba-section reveal">
    <div class="section-header">
      <div class="section-tag">{s.beforeAfter.label}</div>
      <h2>{s.beforeAfter.title}</h2>
      <p>{s.beforeAfter.lead}</p>
    </div>
    <div class="ba-grid">
      <div class="ba-col">
        <div class="ba-label">{s.beforeAfter.beforeLabel}</div>
        {beforeRows.map(([label, text], i) => (
          <div class="ba-item" style={i === beforeRows.length - 1 ? "border-bottom:none" : undefined}>
            <div class="ba-item-label">{label}</div>
            <div class="ba-item-text">{text}</div>
          </div>
        ))}
      </div>
      <div class="ba-col ba-col-after">
        <div class="ba-label">{s.beforeAfter.afterLabel}</div>
        {afterRows.map(([label, text], i) => (
          <div class="ba-item" style={i === afterRows.length - 1 ? "border-bottom:none" : undefined}>
            <div class="ba-item-label">{label}</div>
            <div class="ba-item-text">{text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="check-section">
    <div class="section-header reveal">
      <div class="section-tag">{s.checklist.label}</div>
      <h2>{s.checklist.title}</h2>
      <p>{s.checklist.lead}</p>
    </div>
    <div class="check-grid">
      {checklistItems.map((item) => (
        <div class="check-item reveal"><span class="check-mark">◆</span><p>{item}</p></div>
      ))}
    </div>
  </section>

  <section class="plans-section" id="plans">
    <div class="section-header reveal">
      <div class="section-tag">{s.plans.label}</div>
      <h2>{s.plans.title}</h2>
      <p>{s.plans.lead}</p>
    </div>
    <div class="plans-grid">
      {s.plans.items.map((p) => (
        <a href={p.href} class="plan-card reveal">
          <div class="plan-name">{p.name}</div>
          <div class="plan-desc">{p.desc}</div>
          <span class="plan-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="demo-section reveal" id="demo">
    <div class="section-tag" style="color:var(--accent);justify-content:center">{s.demo.eyebrow}</div>
    <h2>{s.demo.title}</h2>
    <div class="demo-rule"></div>
    <p>{s.demo.lead}</p>
    <a href={s.demo.href} class="btn-white" target="_blank" rel="noopener">{s.demo.cta}</a>
  </section>

  <section class="dl-section reveal" id="download">
    <div class="section-tag" style="color:var(--accent);justify-content:center">Whitepaper</div>
    <h2>{s.cta.title}</h2>
    <div class="dl-rule"></div>
    <p>{s.cta.desc}</p>
    <div class="dl-list">
      <div class="dl-list-item"><p>{s.cta.wpContent1}</p></div>
      <div class="dl-list-item"><p>{s.cta.wpContent2}</p></div>
      <div class="dl-list-item"><p>{s.cta.wpContent3}</p></div>
      <div class="dl-list-item"><p>{s.cta.wpContent4}</p></div>
    </div>
    <div class="dl-cta-btns">
      <a href={s.cta.hubspotFormUrl} class="btn-white" target="_blank" rel="noopener">{s.nav.whitepaperDownload}</a>
      <a href={`${base}/#contact`} class="btn-outline-white">{s.cta.partnerCta}</a>
    </div>
  </section>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .page-hero {
    position: relative;
    min-height: 580px;
    display: flex;
    align-items: flex-end;
    padding: 0 10% 80px;
    overflow: hidden;
    margin-top: 64px;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background: center/cover no-repeat;
    filter: saturate(0.6) brightness(0.7);
  }
  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.72) 100%);
  }
  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding-top: 60px;
  }
  .page-hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 62px);
    font-weight: 300;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .page-hero-content h1 strong { font-weight: 600; display: block; }
  .page-hero-sub {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.78;
    max-width: 600px;
  }
  .hero-cta-btns {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .btn-hero-primary {
    background: var(--white);
    color: var(--black);
    padding: 14px 32px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .btn-hero-primary:hover { background: var(--accent); color: var(--white); }
  .btn-hero-outline {
    background: transparent;
    color: rgba(255, 255, 255, 0.82);
    padding: 13px 32px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.32);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-hero-outline:hover {
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  .problem-section { background: var(--gray-50); padding: 120px 10%; }
  .section-header { margin-bottom: 64px; }
  .section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.8vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--black);
    margin-bottom: 16px;
  }
  .section-header p {
    font-size: 15px;
    line-height: 1.78;
    color: var(--gray-500);
    max-width: 560px;
  }
  .challenge-table { width: 100%; border-collapse: collapse; }
  .challenge-table thead tr { background: var(--black); color: var(--white); }
  .challenge-table th {
    padding: 16px 20px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: left;
  }
  .challenge-table td {
    padding: 18px 20px;
    border-bottom: 1px solid var(--gray-200);
    color: var(--gray-800);
    line-height: 1.65;
  }
  .challenge-table tr:nth-child(odd) td { background: var(--white); }
  .challenge-table tr:nth-child(even) td { background: var(--gray-50); }
  .problem-highlight {
    margin-top: 32px;
    padding: 20px 24px;
    background: var(--white);
    border-left: 2px solid var(--accent);
    font-size: 14px;
    line-height: 1.7;
    color: var(--gray-800);
  }

  .problems-section { background: var(--white); padding: 120px 10%; }
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--gray-200);
  }
  .problem-card {
    background: var(--white);
    padding: 48px 40px;
    border-top: 2px solid transparent;
    transition: border-color 0.2s, opacity 0.6s ease, transform 0.6s ease;
    opacity: 0;
    transform: translateY(18px);
    display: flex;
    flex-direction: column;
  }
  .problem-card.on { opacity: 1; transform: translateY(0); }
  .problem-card:nth-child(2) { transition-delay: 0.1s; }
  .problem-card:nth-child(3) { transition-delay: 0.2s; }
  .problem-card:hover { border-top-color: var(--accent); }
  .problem-num {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .problem-card h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--black);
    margin-bottom: 16px;
    line-height: 1.3;
  }
  .problem-card p {
    font-size: 14px;
    line-height: 1.78;
    color: var(--gray-500);
    margin-bottom: 20px;
  }
  .wall-pillar-links {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--gray-200);
    font-size: 12px;
    line-height: 1.6;
  }
  .wall-pillar-links a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .wall-pillar-links a:hover { text-decoration: underline; }
  .wall-pillar-sep { color: var(--gray-500); }

  .solution-section {
    position: relative;
    padding: 140px 10%;
    overflow: hidden;
  }
  .solution-bg {
    position: absolute;
    inset: 0;
    background: center/cover no-repeat;
    filter: saturate(0.35) brightness(0.6);
  }
  .solution-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
  }
  .solution-inner { position: relative; z-index: 2; }
  .solution-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 300;
    color: var(--white);
    margin-bottom: 16px;
  }
  .solution-lead {
    font-size: 15px;
    line-height: 1.78;
    color: rgba(255, 255, 255, 0.62);
    margin-bottom: 64px;
    max-width: 640px;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: rgba(255, 255, 255, 0.06);
  }
  .pillar-card {
    position: relative;
    background: rgba(255, 255, 255, 0.03);
    padding: 40px 36px;
    border-top: 2px solid transparent;
    transition: border-color 0.2s, background 0.2s, opacity 0.6s ease, transform 0.6s ease;
    text-decoration: none;
    display: block;
    opacity: 0;
    transform: translateY(18px);
  }
  .pillar-card.on { opacity: 1; transform: translateY(0); }
  .pillar-card:nth-child(2) { transition-delay: 0.08s; }
  .pillar-card:nth-child(3) { transition-delay: 0.16s; }
  .pillar-card:nth-child(4) { transition-delay: 0.24s; }
  .pillar-card:hover {
    border-top-color: var(--accent);
    background: rgba(255, 255, 255, 0.06);
  }
  .pillar-num {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .pillar-card h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .pillar-card p {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 20px;
  }
  .pillar-arrow {
    position: absolute;
    right: 36px;
    bottom: 32px;
    color: var(--accent);
    font-size: 16px;
    transition: transform 0.2s;
  }
  .pillar-card:hover .pillar-arrow { transform: translateX(4px); }
  .solution-badge {
    margin-top: 48px;
    font-size: 11px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.04em;
  }

  .ba-section { background: var(--gray-50); padding: 120px 10%; }
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--gray-200);
    margin-top: 64px;
  }
  .ba-col { background: var(--white); padding: 48px 40px; }
  .ba-col-after { background: var(--black); }
  .ba-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid;
  }
  .ba-col .ba-label { color: var(--gray-500); border-color: var(--gray-200); }
  .ba-col-after .ba-label { color: var(--accent); border-color: rgba(255, 255, 255, 0.1); }
  .ba-item {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid;
  }
  .ba-col .ba-item { border-color: var(--gray-200); }
  .ba-col-after .ba-item { border-color: rgba(255, 255, 255, 0.06); }
  .ba-item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
  .ba-item-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .ba-col .ba-item-label { color: var(--gray-500); }
  .ba-col-after .ba-item-label { color: var(--accent); }
  .ba-item-text { font-size: 14px; line-height: 1.7; }
  .ba-col .ba-item-text { color: var(--gray-800); }
  .ba-col-after .ba-item-text { color: rgba(255, 255, 255, 0.65); }

  .check-section { background: var(--white); padding: 120px 10%; }
  .check-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--gray-200);
    margin-top: 64px;
  }
  .check-item {
    background: var(--white);
    padding: 28px 36px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    border-bottom: 1px solid var(--gray-200);
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .check-item.on { opacity: 1; transform: translateX(0); }
  .check-item:nth-child(2) { transition-delay: 0.06s; }
  .check-item:nth-child(3) { transition-delay: 0.12s; }
  .check-item:nth-child(4) { transition-delay: 0.18s; }
  .check-item:nth-child(5) { transition-delay: 0.24s; }
  .check-item:nth-child(6) { transition-delay: 0.3s; }
  .check-mark { color: var(--accent); font-size: 16px; flex-shrink: 0; margin-top: 1px; }
  .check-item p { font-size: 14px; line-height: 1.7; color: var(--gray-800); }

  .plans-section { background: var(--gray-50); padding: 120px 10%; }
  .plans-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--gray-200);
    margin-top: 16px;
  }
  .plan-card {
    position: relative;
    background: var(--white);
    padding: 36px 36px 44px;
    text-decoration: none;
    display: block;
    border-top: 2px solid transparent;
    transition: border-color 0.2s, background 0.2s, opacity 0.6s ease, transform 0.6s ease;
    opacity: 0;
    transform: translateY(18px);
  }
  .plan-card.on { opacity: 1; transform: translateY(0); }
  .plan-card:nth-child(2) { transition-delay: 0.08s; }
  .plan-card:nth-child(3) { transition-delay: 0.16s; }
  .plan-card:nth-child(4) { transition-delay: 0.24s; }
  .plan-card:hover {
    border-top-color: var(--accent);
    background: #fff;
  }
  .plan-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--black);
    margin-bottom: 10px;
  }
  .plan-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--gray-500);
  }
  .plan-arrow {
    position: absolute;
    right: 32px;
    bottom: 28px;
    color: var(--accent);
    font-size: 16px;
    transition: transform 0.2s;
  }
  .plan-card:hover .plan-arrow { transform: translateX(4px); }

  .demo-section { background: var(--black); padding: 100px 10%; text-align: center; }
  .demo-section h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 300;
