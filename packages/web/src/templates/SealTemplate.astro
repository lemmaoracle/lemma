  beforeLabel: "Before",
  afterLabel: "After",
  diagBeforeAria: "Without Seal: the secret travels and the server stores keys",
  diagAfterAria: "With Seal: the key stays on device, only a proof travels, and the server holds proofs",
  diagDeviceBefore: "Device",
  diagSendKey: "Sends key",
  diagSendProof: "Sends proof only",
  diagDeviceAfter: "Key stays on device",
  diagServerBefore1: "Server holds keys",
  diagServerBefore2: "Breach = leak",
  diagServerAfter1: "Server holds proofs only",
  diagServerAfter2: "Breach is worthless",

  compareBeforeHead: "Without Seal",
  compareAfterHead: "With Seal",
  cmpRow1Before: "API keys live in your AI agent's context, exposed to logs and prompt injection.",
  cmpRow1After: "Only proofs live in context. Nothing valuable to leak.",
  cmpRow2Before: "Your server stores user secrets. Every breach exposes them all.",
  cmpRow2After: "Your server holds nothing of the user. Breach reveals proofs only.",
  cmpRow3Before: "Weeks of auth work: key management, rotation, audit, compliance review.",
  cmpRow3After: "One SDK line. Ship sign-in in an afternoon.",
  cmpRow4Before: "Static, broad permissions. AI agents act with full credentials.",
  cmpRow4After: "Per-call ephemeral proofs. Scoped, time-bound, revocable.",

  metric1Num: "0",
  metric1Label: ["keys stored", "on your server"],
  metric2Num: "1",
  metric2Label: ["line of SDK", "to integrate"],
  metric3Num: "0.4s",
  metric3Label: ["average proof", "generation"],

  ctaPrimary: "Try Seal →",
  ctaMeta: "Free · No signup",
  ctaDocs: "Read the docs →",
  ctaPricing: "Pricing →",

  closingEyebrow: "What Seal makes possible",
  closingHLine1: "Build the agent era",
  closingHAccent: "at the speed of proof.",
  closingHTail: "",
  closingPrimary: "Try Seal →",
  closingLink: "Talk to the team →",
  closingMeta: "Free · No signup · Live on Monad Testnet",
};

const compareRows = [
  { before: C.cmpRow1Before, after: C.cmpRow1After },
  { before: C.cmpRow2Before, after: C.cmpRow2After },
  { before: C.cmpRow3Before, after: C.cmpRow3After },
  { before: C.cmpRow4Before, after: C.cmpRow4After },
];
---

<Layout
  locale={locale}
  title={C.metaTitle}
  description={C.metaDesc}
  metaType="page"
  pagePath="/seal/"
  ogImage={`https://lemma.frame00.com/og/products/seal/${locale}.png`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="seal">
    <div class="seal-container">

      <!-- HERO — 2-column top (text + code on the right); cards and trust line below, full width -->
      <section class="seal-hero">
        <div class="seal-hero-grid">
          <div class="seal-hero-text">
            <div class="seal-eyebrow">{C.heroEyebrow}</div>
            <h1 class="seal-h1">{C.heroH1Line1}<br /><span class="seal-accent">{C.heroH1Accent}</span>{C.heroH1Tail}</h1>
            <p class="seal-sub">
              {C.heroSubPart1}<span class="seal-sub-k">{C.heroSubKey}</span>{C.heroSubPart2}<br />
              {C.heroSubPart3}
            </p>
          </div>

          <div class="seal-hero-visual">
            <div class="seal-code" aria-label={C.codeAria}>
              <span class="kw">import</span> {"{ "}generateSealProof{" }"} <span class="kw">from</span> <span class="str">'@lemmaoracle/seal'</span><br /><br /><span class="kw">const</span> {"{ "}proof{" }"} = <span class="kw">await</span> <span class="fn">generateSealProof</span>({"{ apiKey, nonce }"})<br /><span class="com">{C.codeComment}</span>
            </div>
          </div>
        </div>

        <div class="seal-cards">
          <article class="seal-card">
            <div class="seal-card-eyebrow">{C.card1Eyebrow}</div>
            <h3 class="seal-card-h3">{C.card1H3[0]}<br />{C.card1H3[1]}</h3>
            <p class="seal-card-copy">{C.card1Copy}</p>
            <a href={sealLiveUrl} class="seal-card-btn muted" target="_blank" rel="noopener">{C.card1Btn}</a>
            <div class="seal-btn-microcopy">{C.card1Micro}</div>
          </article>

          <article class="seal-card">
            <div class="seal-badge">{C.card2Badge}</div>
            <div class="seal-card-eyebrow">{C.card2Eyebrow}</div>
            <h3 class="seal-card-h3">{C.card2H3[0]}<br />{C.card2H3[1]}</h3>
            <p class="seal-card-copy">{C.card2Copy}</p>
            <a href={guidesHref} class="seal-card-btn primary">{C.card2Btn}</a>
            <div class="seal-btn-microcopy" style="color: var(--hp-text-3);">{C.card2Micro}</div>
          </article>
        </div>

        <p class="seal-trust">
          <span class="seal-trust-strong">{C.trustStrong1}</span>{C.trustText1}<br />
          <span class="seal-trust-strong">{C.trustStrong2}</span>{C.trustText2}
        </p>
      </section>

      <!-- IMPACT -->
      <section class="seal-impact">
        <div class="seal-eyebrow">{C.impactEyebrow}</div>
        <h2 class="seal-impact-h2">{C.impactH2Line1}<br /><span class="seal-accent">{C.impactH2Accent}</span>{C.impactH2Tail}</h2>
        <p class="seal-impact-sub">{C.impactSub}</p>

        <div class="seal-impact-comparison">

          <!-- BEFORE -->
          <div class="seal-panel before">
            <div class="seal-panel-label">{C.beforeLabel}</div>
            <svg viewBox="0 0 380 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={C.diagBeforeAria}>
              <g transform="translate(20, 70)">
                <rect x="0" y="0" width="65" height="70" rx="6" stroke="#6E6957" stroke-width="1.5" fill="#FFFFFF" opacity="0.7" />
                <line x1="12" y1="12" x2="26" y2="12" stroke="#6E6957" stroke-width="1" />
                <line x1="12" y1="18" x2="36" y2="18" stroke="#6E6957" stroke-width="1" opacity="0.5" />
                <g transform="translate(20, 32)">
                  <circle cx="6" cy="8" r="5" stroke="#6E6957" stroke-width="1.5" fill="none" />
                  <line x1="11" y1="8" x2="22" y2="8" stroke="#6E6957" stroke-width="1.5" />
                  <line x1="18" y1="8" x2="18" y2="12" stroke="#6E6957" stroke-width="1.5" />
                </g>
                <text x="32.5" y="86" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="9" fill="#6E6957">{C.diagDeviceBefore}</text>
              </g>
              <g transform="translate(95, 105)">
                <line x1="0" y1="0" x2="110" y2="0" stroke="#6E6957" stroke-width="1.5" />
                <path d="M 110 0 L 104 -5 L 104 5 Z" fill="#6E6957" />
                <text x="55" y="-14" text-anchor="middle" font-family="Space Mono, monospace" font-size="8" fill="#6E6957" letter-spacing="1">{C.diagSendKey}</text>
                <g class="seal-travel-key">
                  <g transform="translate(0, -8)">
                    <circle cx="6" cy="8" r="4.5" stroke="#6E6957" stroke-width="1.5" fill="#FFFFFF" />
                    <line x1="10.5" y1="8" x2="20" y2="8" stroke="#6E6957" stroke-width="1.5" />
                    <line x1="17" y1="8" x2="17" y2="11" stroke="#6E6957" stroke-width="1.5" />
                  </g>
                </g>
              </g>
              <g transform="translate(225, 55)">
                <ellipse cx="55" cy="8" rx="52" ry="6" stroke="#6E6957" stroke-width="1.5" fill="#FFFFFF" opacity="0.7" />
                <path d="M 3 8 L 3 80" stroke="#6E6957" stroke-width="1.5" />
                <path d="M 107 8 L 107 80" stroke="#6E6957" stroke-width="1.5" />
                <ellipse cx="55" cy="80" rx="52" ry="6" stroke="#6E6957" stroke-width="1.5" fill="#FFFFFF" opacity="0.7" />
                <g class="seal-server-key-flicker" transform="translate(12, 22)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(34, 25)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(56, 22)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(78, 25)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(18, 42)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(42, 45)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(68, 42)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(30, 62)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <g class="seal-server-key-flicker" transform="translate(58, 62)"><circle cx="4" cy="4" r="2.5" stroke="#6E6957" stroke-width="1.2" fill="none" /><line x1="6" y1="4" x2="12" y2="4" stroke="#6E6957" stroke-width="1.2" /></g>
                <text x="55" y="104" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="9" fill="#6E6957">{C.diagServerBefore1}</text>
                <text x="55" y="118" text-anchor="middle" font-family="Space Mono, monospace" font-size="8" fill="#6E6957" letter-spacing="1">{C.diagServerBefore2}</text>
              </g>
            </svg>
          </div>

          <div class="seal-migrate-bridge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M 4 11 L 18 11 M 13 6 L 18 11 L 13 16" stroke="#8B4513" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </div>

          <!-- AFTER -->
          <div class="seal-panel after">
            <div class="seal-panel-label">{C.afterLabel}</div>
            <svg viewBox="0 0 380 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={C.diagAfterAria}>
              <g transform="translate(20, 70)">
                <rect x="0" y="0" width="65" height="70" rx="6" stroke="#8B4513" stroke-width="1.5" fill="#FFFFFF" />
                <line x1="12" y1="12" x2="26" y2="12" stroke="#8B4513" stroke-width="1" />
                <line x1="12" y1="18" x2="36" y2="18" stroke="#8B4513" stroke-width="1" opacity="0.5" />
                <g transform="translate(18, 32)">
                  <circle cx="6" cy="8" r="5" stroke="#8B4513" stroke-width="1.5" fill="none" />
                  <line x1="11" y1="8" x2="22" y2="8" stroke="#8B4513" stroke-width="1.5" />
                  <line x1="18" y1="8" x2="18" y2="12" stroke="#8B4513" stroke-width="1.5" />
                  <path d="M 22 3 Q 22 -1 26 -1 Q 30 -1 30 3" stroke="#8B4513" stroke-width="1.3" fill="none" />
                  <rect x="23" y="3" width="8" height="6" rx="1" fill="#8B4513" />
                </g>
                <text x="32.5" y="86" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="9" fill="#8B4513" font-weight="500">{C.diagDeviceAfter}</text>
              </g>
              <g transform="translate(95, 105)">
                <line x1="0" y1="0" x2="110" y2="0" stroke="#8B4513" stroke-width="1.5" />
                <path d="M 110 0 L 104 -5 L 104 5 Z" fill="#8B4513" />
                <text x="55" y="-14" text-anchor="middle" font-family="Space Mono, monospace" font-size="8" fill="#8B4513" letter-spacing="1">{C.diagSendProof}</text>
                <g class="seal-travel-proof">
                  <g transform="translate(0, -9)">
                    <circle cx="9" cy="9" r="9" fill="#8B4513" />
                    <path d="M 4.5 9 L 7.5 12 L 13 6.5" stroke="#FCFAF5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  </g>
                </g>
              </g>
              <g transform="translate(225, 55)">
                <ellipse cx="55" cy="8" rx="52" ry="6" stroke="#8B4513" stroke-width="1.5" fill="#FFFFFF" />
                <path d="M 3 8 L 3 80" stroke="#8B4513" stroke-width="1.5" />
                <path d="M 107 8 L 107 80" stroke="#8B4513" stroke-width="1.5" />
                <ellipse cx="55" cy="80" rx="52" ry="6" stroke="#8B4513" stroke-width="1.5" fill="#FFFFFF" />
                <g class="seal-proof-pulse" transform="translate(43, 32)">
                  <circle cx="12" cy="12" r="11" fill="#8B4513" />
                  <path d="M 6 12 L 10.5 16.5 L 18 8" stroke="#FCFAF5" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </g>
                <text x="55" y="104" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="9" fill="#8B4513" font-weight="500">{C.diagServerAfter1}</text>
                <text x="55" y="118" text-anchor="middle" font-family="Space Mono, monospace" font-size="8" fill="#8B4513" letter-spacing="1">{C.diagServerAfter2}</text>
              </g>
            </svg>
          </div>
        </div>

        <!-- COMPARE GRID -->
        <div class="seal-compare-grid">
          <div class="seal-compare-header before"><div class="seal-ch-label before">{C.compareBeforeHead}</div></div>
          <div class="seal-compare-header after"><div class="seal-ch-label after">{C.compareAfterHead}</div></div>

          {compareRows.map((row) => (
            <Fragment>
              <div class="seal-compare-row before"><div class="seal-row-text">{row.before}</div></div>
              <div class="seal-compare-row after"><div class="seal-row-text">{row.after}</div></div>
            </Fragment>
          ))}
        </div>

        <!-- METRICS -->
        <div class="seal-metrics-row">
          <div class="seal-metric"><div class="seal-metric-num">{C.metric1Num}</div><div class="seal-metric-label">{C.metric1Label[0]}<br />{C.metric1Label[1]}</div></div>
          <div class="seal-metric"><div class="seal-metric-num">{C.metric2Num}</div><div class="seal-metric-label">{C.metric2Label[0]}<br />{C.metric2Label[1]}</div></div>
          <div class="seal-metric"><div class="seal-metric-num">{C.metric3Num}</div><div class="seal-metric-label">{C.metric3Label[0]}<br />{C.metric3Label[1]}</div></div>
        </div>

        <!-- CTAs -->
        <div class="seal-impact-cta">
          <a href={sealLiveUrl} class="seal-cta-primary" target="_blank" rel="noopener">{C.ctaPrimary}</a>
          <span class="seal-cta-meta">{C.ctaMeta}</span>
          <a href={guidesHref} class="seal-cta-link">{C.ctaDocs}</a>
          <a href={pricingHref} class="seal-cta-link">{C.ctaPricing}</a>
        </div>
      </section>

    </div>

    <!-- CLOSING (dark) — inside main.seal so it inherits the --hp-* CSS vars -->
    <section class="seal-closing">
      <div class="seal-closing-inner">
        <p class="seal-closing-eyebrow">{C.closingEyebrow}</p>
        <h2 class="seal-closing-h">{C.closingHLine1}<br /><span class="seal-closing-accent">{C.closingHAccent}</span>{C.closingHTail}</h2>
        <div class="seal-closing-ctas">
          <a href={sealLiveUrl} class="seal-btn-brown-pill" target="_blank" rel="noopener">{C.closingPrimary}</a>
          <a href={contactHref} target="_blank" rel="noopener" class="seal-closing-link">{C.closingLink}</a>
        </div>
        <p class="seal-closing-meta">{C.closingMeta}</p>
      </div>
    </section>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .seal {
    --hp-cream: #fcfaf5;
    --hp-cream-d: #f2eedf;
    --hp-line: #e5e0d5;
    --hp-text-1: #1a1a1a;
    --hp-text-2: #2a2622;
    --hp-text-3: #5a544d;
    --hp-text-4: #9a938a;
    --hp-brown: #8b4513;
    --hp-brown-deep: #6b340e;
    --hp-brown-light: #f5ebdc;
    --hp-code-bg: #1a1612;
    --hp-code-text: #d4cfc4;
    --legacy-bg: #ECEBE5;
    --legacy-border: #B5AFA0;
    --legacy-text: #6E6957;
    --hp-display: var(--font-display);
    --hp-body: "Noto Sans JP", system-ui, sans-serif;
    --hp-mono: "Space Mono", ui-monospace, monospace;

    background: var(--hp-cream);
    color: var(--hp-text-2);
    font-family: var(--hp-body);
    line-height: 1.75;
    font-size: 14.5px;
  }
  .seal a { text-decoration: none; }
  .seal-accent { color: var(--hp-brown); }

  .seal-container { max-width: 1100px; margin: 0 auto; padding: 0 40px; }

  /* HERO — 2-column top (text + code), then cards + trust below at full container width */
  .seal-hero { padding: 72px 0 64px; }
  .seal-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: start;
    margin-bottom: 48px;
  }
  .seal-hero-text { min-width: 0; }
  .seal-hero-visual { min-width: 0; }
  .seal-eyebrow {
    font-family: var(--hp-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--hp-brown); margin: 0 0 28px;
    display: flex; align-items: center; gap: 12px;
  }
  .seal-eyebrow::before { content: ""; display: inline-block; width: 28px; height: 1px; background: var(--hp-brown); }
  .seal-h1 {
    font-family: var(--hp-display); font-size: 56px; font-weight: 700; line-height: 1.06;
    margin: 0 0 26px; color: #000; letter-spacing: -0.035em;
  }
  .seal-sub { font-size: 17px; color: var(--hp-text-2); margin: 0; line-height: 1.75; }
  .seal-sub-k { color: #000; font-weight: 500; }

  /* CODE BLOCK — fills the right column */
  .seal-code {
    background: var(--hp-code-bg); border-radius: 14px;
    padding: 22px 26px; font-family: var(--hp-mono); font-size: 13.5px; line-height: 1.85;
    color: var(--hp-code-text); overflow-x: auto;
    box-shadow: 0 30px 70px rgba(43, 30, 18, 0.18);
  }
  .seal-code .kw { color: #D4A574; }
  .seal-code .str { color: #9ec5e8; }
  .seal-code .fn { color: #F0DCB5; }
  .seal-code .com { color: #6a655d; }

  /* CARDS — full container width below the hero grid */
  .seal-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 0 0 44px; }
  .seal-card {
    position: relative; background: #fff; border-radius: 14px;
    padding: 26px 24px; border: 0.5px solid var(--hp-line);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .seal-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(139,69,19,0.06); border-color: var(--hp-brown); }
  .seal-card-eyebrow { font-family: var(--hp-mono); font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--hp-brown); margin: 0 0 10px; }
  .seal-card-h3 { font-family: var(--hp-display); font-size: 17px; font-weight: 600; color: #000; margin: 0 0 10px; letter-spacing: -0.015em; line-height: 1.35; }
  .seal-card-copy { font-size: 13px; color: var(--hp-text-3); margin: 0 0 18px; line-height: 1.75; }
  .seal-card-btn { display: inline-block; padding: 10px 22px; border-radius: 999px; font-size: 12px; font-weight: 500; font-family: "Noto Sans JP", system-ui, sans-serif; }
  .seal-card-btn.muted { background: var(--hp-cream-d); color: #000; }
  .seal-card-btn.muted:hover { background: var(--hp-brown-light); }
  .seal-card-btn.primary { background: var(--hp-brown); color: var(--hp-cream); }
  .seal-card-btn.primary:hover { background: var(--hp-brown-deep); }
  .seal-btn-microcopy { font-family: var(--hp-mono); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--hp-brown); margin: 8px 0 0; }
  .seal-badge {
    position: absolute; top: -10px; right: 22px;
    background: var(--hp-brown); color: var(--hp-cream);
    font-family: var(--hp-mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.12em;
    padding: 5px 12px; border-radius: 999px; text-transform: uppercase;
  }

  /* TRUST */
  .seal-trust {
    font-size: 13.5px; color: var(--hp-text-3); line-height: 1.9;
    padding-top: 28px; border-top: 0.5px solid var(--hp-line);
    max-width: 680px;
  }
  .seal-trust-strong { color: #000; font-weight: 500; }

  /* IMPACT */
  .seal-impact { padding: 96px 0 80px; max-width: 1020px; }
  .seal-impact-h2 {
    font-family: var(--hp-display); font-size: 52px; font-weight: 700; line-height: 1.08;
    margin: 0 0 20px; color: #000; letter-spacing: -0.032em;
  }
  .seal-impact-sub { font-size: 17px; color: var(--hp-text-2); margin: 0 0 56px; line-height: 1.75; max-width: 620px; }

  .seal-impact-comparison {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 0;
    align-items: stretch; margin: 0 0 64px;
  }
  .seal-panel { border-radius: 18px; padding: 26px 28px 30px; display: flex; flex-direction: column; }
  .seal-panel-label {
    font-family: var(--hp-display); font-size: 13px; font-weight: 500; letter-spacing: 0.04em;
    margin: 0 0 16px; display: flex; align-items: center; gap: 10px;
  }
  .seal-panel-label::before { content: ""; display: block; width: 22px; height: 1px; }
  .seal-panel.before .seal-panel-label { color: var(--legacy-text); }
  .seal-panel.before .seal-panel-label::before { background: var(--legacy-text); }
  .seal-panel.after .seal-panel-label { color: var(--hp-brown); }
  .seal-panel.after .seal-panel-label::before { background: var(--hp-brown); }
  .seal-panel.before { background: var(--legacy-bg); border: 0.5px dashed var(--legacy-border); filter: saturate(0.65); }
  .seal-panel.after { background: var(--hp-cream); border: 0.5px solid var(--hp-brown); box-shadow: 0 6px 28px rgba(139, 69, 19, 0.08); }
  .seal-panel svg { width: 100%; height: auto; display: block; }
  .seal-migrate-bridge { display: flex; align-items: center; justify-content: center; width: 56px; }
  .seal-migrate-bridge svg { display: block; }

  /* ANIMATIONS — narrative travel + flicker, motion-safe */
  @keyframes seal-travel-x {
    0%   { transform: translateX(-15px); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateX(105px); opacity: 0; }
  }
  @keyframes seal-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  @keyframes seal-server-glow { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  .seal-travel-key, .seal-travel-proof {
    animation: seal-travel-x 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: transform, opacity;
  }
  .seal-proof-pulse { transform-origin: center; transform-box: fill-box; animation: seal-pulse 2.4s ease-in-out infinite; }
  .seal-server-key-flicker { animation: seal-server-glow 3s ease-in-out infinite; }
  .seal-server-key-flicker:nth-child(odd) { animation-delay: 0s; }
  .seal-server-key-flicker:nth-child(even) { animation-delay: 0.8s; }
  .seal-server-key-flicker:nth-child(3n) { animation-delay: 1.5s; }
  .seal-server-key-flicker:nth-child(4n) { animation-delay: 2.0s; }
  @media (prefers-reduced-motion: reduce) {
    .seal-travel-key, .seal-travel-proof { animation: none; transform: translateX(45px); opacity: 1; }
    .seal-proof-pulse, .seal-server-key-flicker { animation: none; }
  }

  /* COMPARE GRID */
  .seal-compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin: 0 0 48px; }
  .seal-compare-header { padding: 0 0 14px; border-bottom: 1px solid; }
  .seal-compare-header.before { border-color: var(--legacy-border); }
  .seal-compare-header.after { border-color: var(--hp-text-1); }
  .seal-ch-label { font-family: var(--hp-mono); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; font-weight: 500; }
  .seal-ch-label.before { color: var(--legacy-text); }
  .seal-ch-label.after { color: var(--hp-brown); }
  .seal-compare-row { padding: 18px 14px; border-bottom: 0.5px solid var(--hp-line); border-radius: 4px; }
  .seal-compare-row.before { color: var(--legacy-text); background: rgba(236,235,229,0.5); }
  .seal-compare-row.after { background: rgba(252,250,245,0.7); color: var(--hp-text-1); font-weight: 500; }
  .seal-row-text { font-size: 14px; line-height: 1.7; }

  /* METRICS */
  .seal-metrics-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 32px; padding: 36px 0 0; border-top: 0.5px solid var(--hp-line); }
  .seal-metric-num {
    font-family: var(--hp-display); font-size: 64px; font-weight: 700; line-height: 1;
    letter-spacing: -0.045em; color: var(--hp-brown);
  }
  .seal-metric-label { font-size: 13px; color: var(--hp-text-3); margin-top: 8px; line-height: 1.55; }
  .seal-impact-cta { margin-top: 56px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .seal-cta-primary {
    background: #000; color: var(--hp-cream);
    padding: 13px 28px; border-radius: 999px;
    font-size: 13.5px; font-weight: 500; font-family: "Noto Sans JP", system-ui, sans-serif;
    transition: background 0.15s;
  }
  .seal-cta-primary:hover { background: var(--hp-brown); }
  .seal-cta-link { font-size: 13.5px; color: var(--hp-text-3); font-family: "Noto Sans JP", system-ui, sans-serif; transition: color 0.15s; }
  .seal-cta-link:hover { color: var(--hp-brown); }
  .seal-cta-meta { font-family: var(--hp-mono); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--hp-brown); margin-left: 4px; }

  /* CLOSING */
  .seal-closing { background: #0A0807; padding: 128px 40px; text-align: center; }
  .seal-closing-inner { max-width: 920px; margin: 0 auto; }
  .seal-closing-eyebrow {
    font-family: var(--hp-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase;
    color: rgba(252,250,245,0.55); margin: 0 0 36px;
  }
  .seal-closing-h {
    font-family: var(--hp-display); font-size: 56px; font-weight: 700; line-height: 1.12;
    letter-spacing: -0.028em; color: var(--hp-cream); margin: 0 0 48px;
  }
  .seal-closing-accent { color: var(--hp-brown-light); }
  .seal-closing-ctas { display: flex; gap: 28px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .seal-btn-brown-pill {
    background: var(--hp-brown); color: var(--hp-cream);
    padding: 16px 32px; border-radius: 999px;
    font-family: "Noto Sans JP", system-ui, sans-serif; font-size: 15px; font-weight: 500;
    transition: background 0.15s; box-shadow: 0 8px 28px rgba(139,69,19,0.4);
  }
  .seal-btn-brown-pill:hover { background: var(--hp-brown-deep); }
  .seal-closing-link {
    font-family: var(--hp-display); font-size: 15px; color: var(--hp-brown-light);
    transition: color 0.15s;
  }
  .seal-closing-link:hover { color: var(--hp-cream); }
  .seal-closing-meta {
    font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(252,250,245,0.4); margin: 28px 0 0;
  }

  /* RESPONSIVE */
  @media (max-width: 980px) {
    /* Stack the hero grid (text + code) at laptop-and-below so the code block sits under the text */
    .seal-hero-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 820px) {
    .seal-impact-comparison { grid-template-columns: 1fr; gap: 24px; }
    .seal-migrate-bridge { width: 100%; padding: 6px 0; }
    .seal-migrate-bridge svg { transform: rotate(90deg); }
    .seal-compare-grid { grid-template-columns: 1fr; gap: 0; }
    .seal-compare-header.after { margin-top: 28px; }
  }
  @media (max-width: 720px) {
    .seal-container { padding: 0 20px; }
    .seal-hero { padding: 48px 0 40px; }
    .seal-hero-grid { gap: 32px; margin-bottom: 36px; }
    .seal-h1 { font-size: 42px; }
    .seal-sub { font-size: 15px; }
    .seal-code { font-size: 12px; padding: 18px; }
    .seal-cards { grid-template-columns: 1fr; gap: 14px; }
    .seal-trust { padding-top: 24px; }
    .seal-impact { padding: 64px 0 56px; }
    .seal-impact-h2 { font-size: 36px; }
    .seal-metrics-row { grid-template-columns: 1fr; gap: 24px; }
    .seal-closing { padding: 88px 24px; }
    .seal-closing-h { font-size: 38px; }
  }
</style>
