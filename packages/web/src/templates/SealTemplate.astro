  diagAfterAria: "Seal あり：鍵は端末に残り、証明だけが移動、サーバーは証明だけ保管",
  diagDeviceBefore: "端末",
  diagSendKey: "鍵を送信",
  diagSendProof: "証明だけ送信",
  diagDeviceAfter: "鍵は端末に残る",
  diagServerBefore1: "サーバーが鍵を保有",
  diagServerBefore2: "漏洩 = 流出",
  diagServerAfter1: "サーバーは証明だけ保管",
