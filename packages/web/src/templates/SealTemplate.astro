---
/**
 * Seal product page — v11 mockup.
 *
 * Sections:
 *   1. Hero — eyebrow / split h1 / sub / code block / 2 cards (Try live + AI Ready) / trust line
 *   2. Impact — Before vs After SVG comparison + 4-row compare grid + 3 metrics + CTAs
 *   3. Closing — dark slim CTA (Try Seal + Talk to team)
 *
 * Locale-resolved via a single C object (homepage convention).
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface SealTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as SealTemplateProps;
const isJa = locale === "ja";

const sealLiveUrl = "https://dashboard.lemma.workers.dev/signin";
const guidesHref = `${base}/guides/`;
const pricingHref = `${base}/pricing/`;
const contactHref = DISCOVERY_CALL_URL[locale];

const C = isJa ? {
  metaTitle: "Seal — 鍵ではなく、証明を送る | Lemma",
  metaDesc: "ブラウザで証明を生成、秘密をサーバーに送らずにサインインする SDK。漏洩しても流出するのは証明だけ。AI / SaaS / エージェントへの組み込みに 1 行。",

  heroEyebrow: "開発者のための ZK サインイン",
  heroH1Line1: "鍵ではなく、",
  heroH1Accent: "証明を送る",
  heroH1Tail: "。",
  heroSubPart1: "秘密は ",
