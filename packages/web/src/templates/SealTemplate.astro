  cmpRow2Before: "サーバーが利用者の秘密を保管。漏洩のたびに全員分が流出する。",
  cmpRow2After: "サーバーには利用者の何も持たない。漏洩しても流出するのは証明のみ。",
  cmpRow3Before: "認証実装に数週間：鍵管理、ローテーション、監査、コンプラ確認。",
  cmpRow3After: "SDK 1 行。サインインを午後にリリースできる。",
  cmpRow4Before: "広く静的な権限。AI エージェントが全権限で動作する。",
  cmpRow4After: "コールごとの一時証明。範囲・時間・取消が指定可能。",

  metric1Num: "0",
  metric1Label: ["サーバーに保管する", "鍵の数"],
  metric2Num: "1",
  metric2Label: ["統合に必要な", "SDK の行数"],
  metric3Num: "0.4s",
  metric3Label: ["証明生成の", "平均時間"],

  ctaPrimary: "Seal を試す →",
  ctaMeta: "無料 · サインアップ不要",
  ctaDocs: "ドキュメントを読む →",
  ctaPricing: "料金プランを見る →",

  closingEyebrow: "Seal で実現できること",
  closingHLine1: "エージェント時代を、",
  closingHAccent: "証明の速さで",
  closingHTail: "築く。",
  closingPrimary: "Seal を試す →",
  closingLink: "チームに相談する →",
  closingMeta: "無料 · サインアップ不要 · Monad Testnet で稼働中",
} : {
  metaTitle: "Seal — Send a proof, not the key | Lemma",
  metaDesc: "Generate a proof in the browser, sign in without sending your secret to the server. Even on breach, only proofs leak. One-line integration for AI / SaaS / agent stacks.",

  heroEyebrow: "Sealed sign-in for developers",
  heroH1Line1: "Send a proof,",
  heroH1Accent: "not the key.",
  heroH1Tail: "",
  heroSubPart1: "Your secret ",
  heroSubKey: "never leaves your device",
  heroSubPart2: ".",
  heroSubPart3: "Don't hand keys to AI — sign-in for the agent era.",
  codeAria: "Seal SDK sample",
  codeComment: "// The key stays on the device. Only the proof reaches the server.",

  card1Eyebrow: "Try live",
  card1H3: ["3-step ZK", "sign-in flow"],
  card1Copy: "Generate a proof in your browser, sign in without sending your secret. Live on Monad Testnet.",
  card1Btn: "Try Live →",
  card1Micro: "Free · No signup",

  card2Badge: "AI READY",
  card2Eyebrow: "For agents",
  card2H3: ["Use with", "AI agents"],
  card2Copy: "Drop into MCP servers or any AI agent stack. Docs and recipes for keyless delegation.",
  card2Btn: "Read Docs →",
  card2Micro: "Public · Open Source",

  trustStrong1: "ETHGlobal Open Agents 2026",
  trustText1: " finalist.",
  trustStrong2: "Compatible standards",
  trustText2: " — MCP · A2A · x402 · C2PA · W3C VC",

  impactEyebrow: "What changes when you adopt Seal",
  impactH2Line1: "Hold less.",
  impactH2Accent: "Prove more.",
  impactH2Tail: "",
