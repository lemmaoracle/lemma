  card2H3: ["AI エージェント", "で使う"],
  card2Copy: "MCP サーバーや AI エージェントスタックに組み込む。鍵レス委任のドキュメント・レシピを提供。",
  card2Btn: "ドキュメントを読む →",
  card2Micro: "公開 · オープンソース",

  trustStrong1: "ETHGlobal Open Agents 2026",
