---
/**
 * /ja/solutions/ and /solutions/ — biz buyer Solutions hub.
 *
 * Hosts the v3 mockup composition: Hero + §1-§5 + Vision close. CSS
 * variables (--so-*) are scoped on .so-page; child solution components
 * consume them through the cascade (no :global needed because every
 * child element lives inside .so-page).
 *
 * Stage A: the existing /services/ route is untouched; the URL
 * migration and 301 redirects ship in Stage B.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import SolutionsHero from "../components/solutions/SolutionsHero.astro";
import SolutionsBriefAnchor from "../components/solutions/SolutionsBriefAnchor.astro";
import SolutionsAxes from "../components/solutions/SolutionsAxes.astro";
import SolutionsUseCasesHub from "../components/solutions/SolutionsUseCasesHub.astro";
import SolutionsAdoption from "../components/solutions/SolutionsAdoption.astro";
import SolutionsChecklist from "../components/solutions/SolutionsChecklist.astro";
import SolutionsVisionClose from "../components/solutions/SolutionsVisionClose.astro";
import { SOLUTIONS } from "../data/solutions";

interface Props {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as Props;
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/solutions/"
  title={SOLUTIONS.meta.title[locale]}
  description={SOLUTIONS.meta.description[locale]}
  ogImage={`https://lemma.frame00.com/og/products/industries/${locale}.png`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="so-page">
    <div class="so-container">
      <SolutionsHero locale={locale} />
    </div>

    <!-- §2 業務適用の 4 軸 (v30 — full-bleed band, TOP §2 mirror) -->
    <SolutionsAxes locale={locale} base={base} />

    <div class="so-container">
      <SolutionsUseCasesHub locale={locale} base={base} />
      <SolutionsAdoption locale={locale} />
      <SolutionsChecklist locale={locale} />
    </div>
  </main>

  <!-- §5 Critical Brief anchor (dark band) -->
  <SolutionsBriefAnchor locale={locale} base={base} />

  <SolutionsVisionClose locale={locale} />

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .so-page {
    /* Sora carries Latin; Noto Sans JP backs JA so they don't fall
       through to the Layout-level Cormorant / Noto Serif JP stack.
       Exposed as --so-* variables for child solution components. */
    --so-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --so-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --so-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --so-text-1: #1a1a1a;
    --so-text-2: #3a3a3a;
    --so-text-3: #5a5a5a;
    --so-text-4: #9a9a9a;
    /* Legacy (Without Lemma) tones */
    --so-legacy-bg: #ecebe5;
    --so-legacy-border: #b5afa0;
    --so-legacy-text: #6e6957;

    background: var(--lemma-cream);
    color: var(--so-text-2);
    font-family: var(--so-body);
    font-weight: 400;
    line-height: 1.7;
    margin-top: 64px;
  }
  :root[lang="en"] .so-page {
    --so-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  .so-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* Section chrome shared across §1-§5. Declared on the .so-page parent
     so child solution components inherit through the cascade. */
  :global(.so-section-eyebrow) {
    font-family: var(--so-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--so-text-3);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  :global(.so-section-eyebrow::before) {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  :global(.so-section-h2) {
    font-family: var(--so-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 22px;
  }
  :global(:root[lang="ja"] .so-section-h2) {
    line-height: 1.3;
  }
  :global(.so-section-h2 .accent) {
    color: var(--accent);
  }
  :global(.so-section-sub) {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--so-text-2);
    margin: 0 0 36px;
    max-width: 720px;
  }
  :global(.so-section-sub .k) {
    color: var(--black);
    font-weight: 500;
  }

  /* Section spacing — every solution section gets the same gap above. */
  .so-container > :global(section + section) {
    margin-top: 80px;
  }

  @media (max-width: 720px) {
    .so-container {
      padding: 0 24px;
    }
    :global(.so-section-h2) {
      font-size: 28px;
    }
  }
</style>
