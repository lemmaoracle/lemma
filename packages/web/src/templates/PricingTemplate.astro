---
/**
 * /ja/pricing/ + /pricing/ — v24 redesign + product hub.
 *
 * Composition (cream, 1100px container, Sora + Noto Sans JP + Space
 * Mono): Hero + §1 Enterprise + §2 Trust402 + §3 Option Packs +
 * §4 Compare matrix + §5 Adoption flow + §6 FAQ + Vision close.
 *
 * Per the v4 mockup brief, "Lemma Oracle" is the internal tech name and
 * does NOT appear in surfaced copy here — the brand surface is "Lemma".
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import PricingHero from "../components/pricing/PricingHero.astro";
import PricingSectionNav from "../components/pricing/PricingSectionNav.astro";
import PricingPrincipleBand from "../components/pricing/PricingPrincipleBand.astro";
import PricingProductLines from "../components/pricing/PricingProductLines.astro";
import PlanPriceModule from "../components/pricing/PlanPriceModule.astro";
import PricingPacks from "../components/pricing/PricingPacks.astro";
import PricingCompare from "../components/pricing/PricingCompare.astro";
import PricingAdoption from "../components/pricing/PricingAdoption.astro";
import PricingFAQ from "../components/pricing/PricingFAQ.astro";
import PricingVisionClose from "../components/pricing/PricingVisionClose.astro";
import { PRICING } from "../data/pricing";

interface Props {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as Props;
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/pricing/"
  title={PRICING.meta.title[locale]}
  description={PRICING.meta.description[locale]}
  ogImage={`https://lemma.frame00.com/og/pricing/${locale}.png`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="pr-page">
    <div class="pr-container">
      <PricingHero locale={locale} />
      {/* Sticky in-page section nav (scroll-spy) — the page is long */}
      <PricingSectionNav locale={locale} />
      {/* Common-principles band + product-line overview (jump to #ent/#api/#t402) */}
      <PricingPrincipleBand locale={locale} />
      <PricingProductLines locale={locale} />
      {/* #ent — enterprise chapter: 3 plans, then feature-compare +
          option-packs (collapsibles nested under the block), then the
          enterprise onboarding flow — kept contiguous so one persona's
          content reads as a single block. */}
      <PlanPriceModule locale={locale} />
      <PricingCompare locale={locale} />
      <PricingPacks locale={locale} />
      <PricingAdoption locale={locale} />
      <PricingFAQ locale={locale} />
    </div>
  </main>

  <PricingVisionClose locale={locale} />

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .pr-page {
    /* Sora carries Latin; Noto Sans JP backs JA so they don't fall
       through to the Layout-level Cormorant / Noto Serif JP stack.
       Exposed as --pr-* variables for child pricing components. */
    --pr-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --pr-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --pr-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --pr-text-1: #1a1a1a;
    --pr-text-2: #3a3a3a;
    --pr-text-3: #5a5a5a;
    --pr-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--pr-text-2);
    font-family: var(--pr-body);
    font-weight: 400;
    line-height: 1.7;
    margin-top: 64px;
  }
  :root[lang="en"] .pr-page {
    --pr-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  .pr-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .pr-explorer-note {
    margin: 24px 0 8px;
    font-family: var(--pr-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lemma-brown, #8b4513);
  }
  .pr-explorer-note strong {
    font-weight: 700;
  }

  /* Section chrome shared across §1-§6. Wrapped in :global() so child
     pricing components inherit through the cascade. */
  :global(.pr-section-eyebrow) {
    font-family: var(--pr-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--pr-text-3);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  :global(.pr-section-eyebrow::before) {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  :global(.pr-section-h2) {
    font-family: var(--pr-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 22px;
  }
  :global(:root[lang="ja"] .pr-section-h2) {
    line-height: 1.3;
  }
  :global(.pr-section-h2 .accent) {
    color: var(--accent);
  }
  :global(.pr-section-sub) {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--pr-text-2);
    margin: 0 0 36px;
    max-width: 720px;
  }
  :global(.pr-section-sub .k) {
    color: var(--black);
    font-weight: 500;
  }

  /* Collapsible (feature-compare / option-packs) nested under a block. */
  :global(.pr-fold) {
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    background: var(--white);
    overflow: hidden;
  }
  :global(.pr-fold-summary) {
    cursor: pointer;
    list-style: none;
    padding: 15px 22px;
    font-family: var(--pr-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--black);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  :global(.pr-fold-summary::-webkit-details-marker) { display: none; }
  :global(.pr-fold-summary::before) {
    content: "▸";
    color: var(--accent);
    font-size: 12px;
    transition: transform 0.15s;
  }
  :global(.pr-fold[open] .pr-fold-summary::before) { transform: rotate(90deg); }
  :global(.pr-fold-summary:hover) { color: var(--accent); }
  :global(.pr-fold-body) { padding: 2px 22px 22px; }

  /* Section spacing — every section after the hero gets the same gap. */
  .pr-container > :global(section + section) {
    margin-top: 88px;
  }
  /* Folds sit tight under the enterprise plans; a full gap resumes before #api. */
  .pr-container > :global(section) + :global(.pr-fold) { margin-top: 24px; }
  .pr-container > :global(.pr-fold) + :global(.pr-fold) { margin-top: 12px; }
  .pr-container > :global(.pr-fold) + :global(section) { margin-top: 88px; }
  /* Hero → Plans-and-pricing module sits tighter (the old trust strip is gone). */
  .pr-container > :global(.ph-hero + section) {
    margin-top: 36px;
  }

  @media (max-width: 720px) {
    .pr-container { padding: 0 24px; }
    :global(.pr-section-h2) { font-size: 28px; }
  }
</style>
