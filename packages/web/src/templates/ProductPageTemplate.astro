{/*
  Registry 節のデータ接続。検証センター（VerifyAnchorTemplate）と同じ
  `is:inline` + `define:vars` の型で、同じ `GET /v1/counters` を叩く。
  失敗時は OFFLINE と定義文を出すだけで、推定値では埋めない。
*/}
<script is:inline define:vars={{ REG }}>
  (function () {
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString("ja-JP");
    const esc = (s) =>
      String(s ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
      );

    async function load() {
      try {
        const r = await fetch(REG.api, { headers: { accept: "application/json" } });
        if (!r.ok) throw new Error(String(r.status));
        const j = await r.json();
        const total = Number(j.verified.count) || 0;
        $("pv18-verified").textContent = fmt(total);
        $("pv18-issued").textContent = fmt(j.issued.count);

        const top = (j.verified.bySource || []).slice(0, 3);
        if (top.length) {
          $("pv18-bars").innerHTML = top
            .map(function (x) {
              const p = total ? Math.round((x.count / total) * 100) : 0;
              return (
                '<span class="rb-bar"><span>' +
                esc(String(x.source).toUpperCase()) +
                '</span><i><b style="width:' +
                p +
                '%"></b></i><u>' +
                p +
                "%</u></span>"
              );
            })
            .join("");
        }
        $("pv18-err").hidden = true;
        $("pv18-live-label").textContent = REG.live;
        $("pv18-live").classList.remove("offline");
      } catch (e) {
        // 推定値では埋めない。数字は OFFLINE、内訳バーはプレースホルダのまま。
        $("pv18-verified").textContent = REG.offline;
        $("pv18-issued").textContent = REG.offline;
        $("pv18-err").hidden = false;
        $("pv18-live-label").textContent = REG.offline;
        $("pv18-live").classList.add("offline");
      }
    }
    load();
  })();
</script>

