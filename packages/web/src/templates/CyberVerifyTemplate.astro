---
/**
 * Illustrative conditions for transfer, data access and service actions.
 * The static examples neither perform live checks nor execute actions.
 * Keep strict client-side selection of transfer / decrypt / api; missing
 * and unknown values show the fallback, including when JavaScript is off.
 * Examples do not promise product availability or verification results.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";

export interface CyberVerifyTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as CyberVerifyTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);

const discoveryHref = DISCOVERY_CALL_URL[locale];
const backHref = L("/cyber/");

const C = isJa
  ? {
      title: "Cyber — 操作ごとの確認例｜Lemma",
      description:
        "送金・データ取得・サービス間の操作で、実行前にどんな条件を確かめるかを示した例です。",
      eyebrow: "Lemma / Cyber",
      h1Head: "操作の前に、",
      h1Accent: "確かめる内容。",
      lede: "送金・データ取得・サービス間の操作で、どんな条件を確かめるかを示した例です。",
      sampleBadge: "説明用の例",
      kindLabel: "対象の操作",
      exampleNote: "説明用に作った例です。実際の操作や確認は行いません。",
      cards: [
        {
          key: "transfer",
          type: "送金",
          title: "登録した相手への送金",
          desc: "会社に登録した経理担当者が、8万円を送金する場合。以下の条件に合う依頼だけを通す想定です。",
          checks: [
            { label: "担当者", value: "会社に登録した経理担当者" },
            { label: "振込先", value: "登録済みの口座" },
            { label: "金額", value: "8万円（上限10万円）" },
          ],
          outcome: "この例では、条件内の8万円は通し、上限を超える12万円は止めます。",
        },
        {
          key: "decrypt",
          type: "データ取得",
          title: "必要な範囲だけ取り出す",
          desc: "サポート担当者が、出力APIで申請した100件の顧客データを取り出す場合。担当者・対象・項目を確認する想定です。",
          checks: [
            { label: "担当者", value: "対象業務のサポート担当者" },
            { label: "対象", value: "申請した100件の顧客データ" },
            { label: "範囲", value: "業務に必要な項目だけ" },
          ],
          outcome:
            "申請した100件と必要な項目だけを通し、全顧客のデータや申請にない項目を求める依頼は止める想定です。",
        },
        {
          key: "api",
          type: "サービス間の操作",
          title: "承認した内容でサービスを呼び出す",
          desc: "外部サービスに作業を依頼する場合。承認した操作と対象に合っているかを確認する想定です。",
          checks: [
            { label: "呼び出す相手", value: "指定したサービス" },
            { label: "操作", value: "承認した処理" },
            { label: "対象", value: "指定したデータ" },
          ],
          outcome:
            "承認した操作と対象が一致する依頼を通し、操作や対象が変わった依頼は止める想定です。",
        },
      ],
      notFound: {
        title: "確認する例を選んでください。",
        desc: "送金・データ取得・サービス間の操作の例を、Cyber ページから選べます。",
      },
      disclaimer:
        "条件や表示は説明用です。実際の操作や確認結果、製品の提供状況を示すものではありません。",
      next: {
        eyebrow: "早期アクセス",
        h2Head: "守りたい操作から、",
        h2Accent: "一緒に整理する。",
        lede: "実際の業務で確かめたい条件と、既存システムへの組み込み方を相談できます。",
        cta: "導入を相談する →",
      },
      backLabel: "Cyber の説明に戻る →",
    }
  : {
      title: "Cyber — Example checks for each action | Lemma",
      description:
        "Illustrative conditions to check before a transfer, data request or action between services goes through.",
      eyebrow: "Lemma / Cyber",
      h1Head: "Before the action,",
      h1Accent: "check the details.",
      lede: "Examples of the conditions to check before a transfer, data request or action between services goes through.",
      sampleBadge: "Illustrative example",
      kindLabel: "Action",
      exampleNote:
        "An illustrative example. It does not execute an action or perform a live check.",
      cards: [
        {
          key: "transfer",
          type: "Transfer",
          title: "A transfer to a registered recipient",
          desc: "A registered finance member requests an ¥80,000 transfer. Only requests that meet these conditions would go through.",
          checks: [
            { label: "Person", value: "Finance member registered with the organization" },
            { label: "Recipient", value: "Registered account" },
            { label: "Amount", value: "¥80,000 (¥100,000 limit)" },
          ],
          outcome:
            "In this example, ¥80,000 within the conditions goes through. A ¥120,000 request over the limit is stopped.",
        },
        {
          key: "decrypt",
          type: "Data access",
          title: "Retrieve only the data needed",
          desc: "A support member uses an export API to retrieve 100 requested customer records. The person, target customers and fields would be checked.",
          checks: [
            { label: "Person", value: "Support member responsible for this work" },
            { label: "Target", value: "100 requested customer records" },
            { label: "Scope", value: "Only the fields needed for the work" },
          ],
          outcome:
            "Only the 100 requested records and required fields would go through. Requests for all customer data or unrequested fields would be stopped.",
        },
        {
          key: "api",
          type: "Connected services",
          title: "Call a service with the approved details",
          desc: "A request asks an external service to do some work. The approved action and target would be checked.",
          checks: [
            { label: "Service", value: "Specified service" },
            { label: "Action", value: "Approved operation" },
            { label: "Target", value: "Specified data" },
          ],
          outcome:
            "Requests matching the approved action and target would go through. Changes to the action or target would be stopped.",
        },
      ],
      notFound: {
        title: "Choose an example to explore.",
        desc: "Select a transfer, data access or connected service example from the Cyber page.",
      },
      disclaimer:
        "The conditions and displays are illustrative. They do not represent actual actions, verification results or product availability.",
      next: {
        eyebrow: "Early access",
        h2Head: "Start with an action.",
        h2Accent: "Work through the conditions.",
        lede: "Discuss the conditions you want to check in your workflow and where the check fits into your existing system.",
        cta: "Discuss your integration →",
      },
      backLabel: "Back to Cyber →",
    };
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/verify/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  {
    /* JS 有効時のみ、クエリ判定より先に fallback 面を隠してちらつきを防ぐ。
      JS 無効ならこの class は付かず、fallback 面がそのまま表示される。 */
  }
  <script is:inline>
    document.documentElement.classList.add("cyv-has-js");
  </script>

  <main class="cyv-page">
    <div class="cyv-container">
      <p class="cyv-eyebrow">{C.eyebrow}</p>
      <h1 class="cyv-h1">
        {C.h1Head}
        <span class="cyv-h1-accent">{C.h1Accent}</span>
      </h1>
      <p class="cyv-lede">{C.lede}</p>

      {/* カードが見つからない面。既定で表示し、JS 有効時は上で隠す。 */}
      <section class="cyv-fallback" data-cyv-fallback>
        <h2 class="cyv-fallback-title">{C.notFound.title}</h2>
        <p class="cyv-fallback-desc">{C.notFound.desc}</p>
        <a class="cyv-btn cyv-btn--ghost" href={backHref}>{C.backLabel}</a>
      </section>

      {/* 3種類のカード面。全て静的生成し、hidden で既定非表示。 */}
      {
        C.cards.map((card) => (
          <section class="cyv-card" data-cyv-card={card.key} hidden>
            <span class="cyv-badge">{C.sampleBadge}</span>
            <h2 class="cyv-card-title">{card.title}</h2>
            <p class="cyv-kind">
              <span class="cyv-kind-key">{C.kindLabel}</span>
              <span class="cyv-kind-value">{card.type}</span>
            </p>
            <p class="cyv-card-desc">{card.desc}</p>
            <dl class="cyv-checks">
              {card.checks.map((check) => (
                <div>
                  <dt>{check.label}</dt>
                  <dd>{check.value}</dd>
                </div>
              ))}
            </dl>
            <p class="cyv-outcome">{card.outcome}</p>
            <p class="cyv-example-note">{C.exampleNote}</p>
          </section>
        ))
      }

      <p class="cyv-disclaimer">{C.disclaimer}</p>

      <section class="cyv-close" aria-labelledby="cyv-close-h">
        <p class="cyv-eyebrow">{C.next.eyebrow}</p>
        <h2 id="cyv-close-h" class="cyv-h2">
          {C.next.h2Head}{!isJa && " "}<span class="cyv-h2-accent">{C.next.h2Accent}</span>
        </h2>
        <p class="cyv-sub">{C.next.lede}</p>
        <div class="cyv-actions">
          <a class="cyv-btn cyv-btn--primary" href={discoveryHref} target="_blank" rel="noopener"
            >{C.next.cta}</a
          >
          <a class="cyv-btn cyv-btn--ghost" href={backHref}>{C.backLabel}</a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script>
  /* クエリはクライアントでのみ読む。allowlist への厳密一致以外
     （欠落・unknown・大文字・紛らわしい値）はカードが見つからない面にする。
     入力値を HTML へ挿入しないので XSS は生じない。 */
  const allowedCards: ReadonlyArray<string> = ["transfer", "decrypt", "api"];
  const param = new URLSearchParams(window.location.search).get("card");
  const key = param !== null && allowedCards.includes(param) ? param : null;
  const faces = document.querySelectorAll<HTMLElement>("[data-cyv-card]");
  faces.forEach((face) => {
    face.hidden = face.getAttribute("data-cyv-card") !== key;
  });
  /* 一致あり: fallback を隠したまま（card を表示）。
     一致なし: cyv-has-js を外し、fallback 面を表示する。 */
  document.documentElement.classList.toggle("cyv-has-js", key !== null);
</script>

<style>
  .cyv-page {
    --cyv-text-1: #171512;
    --cyv-text-2: #3a352f;
    --cyv-text-3: #6b6259;
    --cyv-line: #e5ddcd;
    --cyv-line-strong: #d8cdb8;
    --cyv-card: #ffffff;
    --cyv-lime: #a8e010;

    background: var(--lemma-cream);
    color: var(--cyv-text-2);
    font-family: var(--font-body);
    font-weight: 400;
    line-height: 1.85;
    padding: 0 0 72px;
  }

  .cyv-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── 共通パーツ ─── */
  .cyv-eyebrow {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cyv-text-3);
    margin: 0 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .cyv-eyebrow::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--cyv-lime);
    flex: none;
  }

  .cyv-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--black);
    margin: 0 0 16px;
    max-width: 820px;
  }
  :root[lang="ja"] .cyv-h2 {
    line-height: 1.4;
    letter-spacing: 0;
  }
  .cyv-h2-accent {
    color: var(--accent);
  }

  .cyv-sub {
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--cyv-text-2);
    margin: 0 0 28px;
    max-width: 720px;
  }

  /* ─── Hero ─── */
  .cyv-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 5.4vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--black);
    margin: 60px 0 24px;
  }
  :root[lang="ja"] .cyv-h1 {
    line-height: 1.3;
    letter-spacing: 0;
  }
  .cyv-h1-accent {
    display: block;
    width: fit-content;
    color: var(--accent);
    border-bottom: 3px solid var(--cyv-lime);
    padding-bottom: 6px;
  }
  .cyv-lede {
    font-size: 16px;
    line-height: 1.95;
    color: var(--cyv-text-2);
    margin: 0 0 32px;
    max-width: 760px;
  }

  /* ─── ボタン ─── */
  .cyv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .cyv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    padding: 14px 24px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-decoration: none;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }
  .cyv-btn--primary {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(139, 69, 19, 0.22);
  }
  .cyv-btn--primary:hover {
    background: var(--accent-lt);
  }
  .cyv-btn--ghost {
    background: transparent;
    color: var(--accent);
    border-color: var(--cyv-line-strong);
  }
  .cyv-btn--ghost:hover {
    border-color: var(--accent);
    background: rgba(139, 69, 19, 0.05);
  }
  .cyv-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ─── カードが見つからない面 ─── */
  .cyv-fallback {
    margin-top: 8px;
    padding: 30px 28px;
    background: var(--cyv-card);
    border: 1px dashed var(--cyv-line-strong);
    border-radius: 14px;
    max-width: 720px;
  }
  /* JS 有効時は既定で隠す。クエリ一致がないときは JS が外して再表示する。 */
  :global(html.cyv-has-js) .cyv-fallback {
    display: none !important;
  }
  .cyv-fallback-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--black);
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }
  .cyv-fallback-desc {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--cyv-text-2);
    overflow-wrap: anywhere;
  }

  /* ─── カード面 ─── */
  .cyv-card {
    margin-top: 8px;
    padding: 30px 28px 26px;
    background: var(--cyv-card);
    border: 1px solid var(--cyv-line);
    border-radius: 14px;
    max-width: 720px;
  }
  /* スタイルが hidden 属性を打ち消さないようにする。 */
  .cyv-card[hidden],
  .cyv-fallback[hidden] {
    display: none !important;
  }
  .cyv-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--cyv-card);
    border: 1px solid var(--cyv-line-strong);
    border-radius: 999px;
    padding: 4px 11px;
    margin-bottom: 14px;
  }
  .cyv-card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--black);
    margin: 0 0 12px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .cyv-kind {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--cyv-text-1);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }
  .cyv-kind-key {
    font-family: var(--font-display);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyv-text-3);
  }
  .cyv-kind-value {
    font-weight: 700;
    color: var(--accent);
  }
  .cyv-card-desc {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--cyv-text-1);
    overflow-wrap: anywhere;
  }

  .cyv-checks {
    margin: 0 0 20px;
    border-block: 1px solid var(--cyv-line);
  }
  .cyv-checks > div {
    display: grid;
    grid-template-columns: minmax(90px, 1fr) minmax(0, 3fr);
    gap: 16px;
    padding-block: 14px;
    font-size: 14px;
    line-height: 1.8;
  }
  .cyv-checks > div + div {
    border-top: 1px solid var(--cyv-line);
  }
  .cyv-checks dt {
    color: var(--cyv-text-3);
  }
  .cyv-checks dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .cyv-outcome {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--cyv-text-1);
  }
  .cyv-example-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--cyv-text-3);
    overflow-wrap: anywhere;
  }

  /* ─── 免責 ─── */
  .cyv-disclaimer {
    margin: 24px 0 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--cyv-text-3);
    max-width: 720px;
    overflow-wrap: anywhere;
  }

  /* ─── 末尾 CTA ─── */
  .cyv-close {
    margin-top: 72px;
    background: var(--lemma-cream-deep);
    border: 1px solid var(--cyv-line);
    border-radius: 18px;
    padding: 48px 44px 40px;
  }

  /* ─── レスポンシブ（375px 幅で崩れない） ─── */
  @media (max-width: 720px) {
    .cyv-container {
      padding: 0 22px;
    }
    .cyv-h1 {
      margin-top: 44px;
    }
    .cyv-close {
      margin-top: 56px;
      padding: 32px 22px;
      border-radius: 14px;
    }
    .cyv-card,
    .cyv-fallback {
      padding: 22px 20px;
    }
  }

  @media (max-width: 430px) {
    .cyv-h1 {
      font-size: clamp(26px, 8vw, 34px);
    }
    .cyv-btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cyv-btn {
      transition: none;
    }
  }
</style>
