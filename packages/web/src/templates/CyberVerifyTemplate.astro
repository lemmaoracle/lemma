---
/**
 * Cyber Proof Card — sample verification faces。
 *
 * `/cyber/verify/`（EN）と `/ja/cyber/verify/`（JA）。
 *
 * この面は **サンプルのカード面**であり、ライブ検証でも実データでもない。
 * `output: static` なのでクエリによる分岐は Astro frontmatter では行わない。
 * 3種類のカード面（transfer / decrypt / api）とカードが見つからない面を
 * すべて静的生成し、クライアントで `?card=` を allowlist に厳密一致させて
 * 表示だけを切り替える。JS 無効時はカードが見つからない面をそのまま出す。
 *
 * 事実の扱い（この面の規律）:
 *   - 実口座番号・実データ・詳細な攻撃手順は載せない。ハッシュは短い
 *     プレースホルダのみ。
 *   - ライブ検証・本番データと誤認させる判定や数値は書かない。
 *   - 提供状況を保証しない免責を EN/JA で表示する。
 *   - 次の行動は Discovery Call 予約と /cyber/ へ戻るだけ。送金・復号・
 *     API 実行のボタンは置かない。
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";

export interface CyberVerifyTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as CyberVerifyTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);

const discoveryHref = DISCOVERY_CALL_URL[locale];
const backHref = L("/cyber/");

const C = isJa
  ? {
      title: "Cyber Proof Card — サンプルの検証面｜Lemma",
      description:
        "転送・復号・API の3種類について、Lemma の Cyber Proof Card のサンプル面を示します。ハッシュは短いプレースホルダで、ライブ検証でも実データでもありません。",
      eyebrow: "Cyber Proof Card",
      h1Head: "カード別サンプル、",
      h1Accent: "操作ごとに1枚。",
      lede: "転送・復号・API の3種類を、それぞれ1枚の例として示します。ここに載るハッシュは短いプレースホルダで、ライブ検証でも実データでもありません。",
      sampleBadge: "サンプル",
      kindLabel: "カード種別",
      inputLabel: "入力ハッシュ",
      exampleNote:
        "この面は例です。ライブの検証結果でも、実際のデータでもありません。",
      cards: [
        {
          key: "transfer",
          type: "転送",
          title: "転送カード（例）",
          desc: "口座間の価値移動を想定した例です。ハッシュは短いプレースホルダで、実際の送金データではありません。",
          hash: "9f2a…c41d",
          result: "一致",
        },
        {
          key: "decrypt",
          type: "復号",
          title: "復号カード（例）",
          desc: "保護されたペイロードの復号を想定した例です。ハッシュは短いプレースホルダで、実際のデータではありません。",
          hash: "7b31…d0e8",
          result: "一致",
        },
        {
          key: "api",
          type: "API",
          title: "API カード（例）",
          desc: "サービスへの API 呼び出しを想定した例です。ハッシュは短いプレースホルダで、実際のリクエストではありません。",
          hash: "3c9f…a2b6",
          result: "一致",
        },
      ],
      notFound: {
        title: "カードが見つかりません",
        desc: "カード指定がないか、サンプルカードと一致しませんでした。URL の ?card= には transfer / decrypt / api のいずれかを指定します。",
      },
      disclaimer:
        "本面のサンプルは例示であり、製品としての提供状況や検証結果を保証するものではありません。",
      next: {
        eyebrow: "次の一手",
        h2Head: "まずは会話から、",
        h2Accent: "対象と方法を設計する。",
        lede: "この面のカードは例です。実際の対象と組み込み方は Discovery Call で確認します。",
        cta: "Discovery Call を予約 →",
      },
      backLabel: "Cyber に戻る →",
    }
  : {
      title: "Cyber Proof Card — sample verification | Lemma",
      description:
        "Sample Cyber Proof Cards for transfer, decryption, and API operations. Short placeholder hashes only — not a live verification and not real data.",
      eyebrow: "Cyber Proof Card",
      h1Head: "Sample cards,",
      h1Accent: "one per operation.",
      lede: "Three operation types — transfer, decryption, and API — shown one example card each. The hashes are short placeholders, not a live check and not real data.",
      sampleBadge: "Sample",
      kindLabel: "Card type",
      inputLabel: "Input hash",
      exampleNote:
        "This face is an example. It is not a live verification result and not real data.",
      cards: [
        {
          key: "transfer",
          type: "Transfer",
          title: "Transfer card (example)",
          desc: "An example that stands for moving value between accounts. The hash is a short placeholder, not real transfer data.",
          hash: "9f2a…c41d",
          result: "match",
        },
        {
          key: "decrypt",
          type: "Decryption",
          title: "Decryption card (example)",
          desc: "An example that stands for decrypting a protected payload. The hash is a short placeholder, not real data.",
          hash: "7b31…d0e8",
          result: "match",
        },
        {
          key: "api",
          type: "API",
          title: "API card (example)",
          desc: "An example that stands for calling a service API. The hash is a short placeholder, not a real request.",
          hash: "3c9f…a2b6",
          result: "match",
        },
      ],
      notFound: {
        title: "Card not found",
        desc: "No card was specified, or it did not match a sample card. The ?card= query accepts transfer, decrypt, or api.",
      },
      disclaimer:
        "These samples are illustrative; they do not promise product availability or any verification result.",
      next: {
        eyebrow: "Next step",
        h2Head: "Start with a conversation.",
        h2Accent: "Scope the subject and method.",
        lede: "The cards on this face are examples. The real subject and integration are scoped in a Discovery Call.",
        cta: "Book a Discovery Call →",
      },
      backLabel: "Back to Cyber →",
    };
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/verify/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  {/* JS 有効時のみ、クエリ判定より先に fallback 面を隠してちらつきを防ぐ。
      JS 無効ならこの class は付かず、fallback 面がそのまま表示される。 */}
  <script is:inline>
    document.documentElement.classList.add("cyv-has-js");
  </script>

  <main class="cyv-page">
    <div class="cyv-container">
      <p class="cyv-eyebrow">{C.eyebrow}</p>
      <h1 class="cyv-h1">
        {C.h1Head}
        <span class="cyv-h1-accent">{C.h1Accent}</span>
      </h1>
      <p class="cyv-lede">{C.lede}</p>

      {/* カードが見つからない面。既定で表示し、JS 有効時は上で隠す。 */}
      <section class="cyv-fallback" data-cyv-fallback>
        <h2 class="cyv-fallback-title">{C.notFound.title}</h2>
        <p class="cyv-fallback-desc">{C.notFound.desc}</p>
        <a class="cyv-btn cyv-btn--ghost" href={backHref}>{C.backLabel}</a>
      </section>

      {/* 3種類のカード面。全て静的生成し、hidden で既定非表示。 */}
      {
        C.cards.map((card) => (
          <section class="cyv-card" data-cyv-card={card.key} hidden>
            <span class="cyv-badge">{C.sampleBadge}</span>
            <h2 class="cyv-card-title">{card.title}</h2>
            <p class="cyv-kind">
              <span class="cyv-kind-key">{C.kindLabel}</span>
              <span class="cyv-kind-value">{card.type}</span>
            </p>
            <p class="cyv-card-desc">{card.desc}</p>
            <p class="cyv-readout">
              <span class="cyv-readout-key">{C.inputLabel}</span>
              <code class="cyv-hash">{card.hash}</code>
              <span class="cyv-readout-dash" aria-hidden="true">
                —
              </span>
              <span class="cyv-readout-result">{card.result}</span>
            </p>
            <p class="cyv-example-note">{C.exampleNote}</p>
          </section>
        ))
      }

      <p class="cyv-disclaimer">{C.disclaimer}</p>

      <section class="cyv-close" aria-labelledby="cyv-close-h">
        <p class="cyv-eyebrow">{C.next.eyebrow}</p>
        <h2 id="cyv-close-h" class="cyv-h2">
          {C.next.h2Head}{!isJa && " "}<span class="cyv-h2-accent"
            >{C.next.h2Accent}</span
          >
        </h2>
        <p class="cyv-sub">{C.next.lede}</p>
        <div class="cyv-actions">
          <a
            class="cyv-btn cyv-btn--primary"
            href={discoveryHref}
            target="_blank"
            rel="noopener">{C.next.cta}</a
          >
          <a class="cyv-btn cyv-btn--ghost" href={backHref}>{C.backLabel}</a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script>
  /* クエリはクライアントでのみ読む。allowlist への厳密一致以外
     （欠落・unknown・大文字・紛らわしい値）はカードが見つからない面にする。
     入力値を HTML へ挿入しないので XSS は生じない。 */
  const allowedCards: ReadonlyArray<string> = ["transfer", "decrypt", "api"];
  const param = new URLSearchParams(window.location.search).get("card");
  const key =
    param !== null && allowedCards.includes(param) ? param : null;
  const faces = document.querySelectorAll<HTMLElement>("[data-cyv-card]");
  faces.forEach((face) => {
    face.hidden = face.getAttribute("data-cyv-card") !== key;
  });
  /* 一致あり: fallback を隠したまま（card を表示）。
     一致なし: cyv-has-js を外し、fallback 面を表示する。 */
  document.documentElement.classList.toggle("cyv-has-js", key !== null);
</script>

<style>
  .cyv-page {
    --cyv-text-1: #171512;
    --cyv-text-2: #3a352f;
    --cyv-text-3: #6b6259;
    --cyv-line: #e5ddcd;
    --cyv-line-strong: #d8cdb8;
    --cyv-card: #ffffff;
    --cyv-lime: #a8e010;

    background: var(--lemma-cream);
    color: var(--cyv-text-2);
    font-family: var(--font-body);
    font-weight: 400;
    line-height: 1.85;
    padding: 0 0 72px;
  }

  .cyv-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── 共通パーツ ─── */
  .cyv-eyebrow {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cyv-text-3);
    margin: 0 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .cyv-eyebrow::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--cyv-lime);
    flex: none;
  }

  .cyv-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--black);
    margin: 0 0 16px;
    max-width: 820px;
  }
  :root[lang="ja"] .cyv-h2 {
    line-height: 1.4;
    letter-spacing: 0;
  }
  .cyv-h2-accent {
    color: var(--accent);
  }

  .cyv-sub {
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--cyv-text-2);
    margin: 0 0 28px;
    max-width: 720px;
  }

  /* ─── Hero ─── */
  .cyv-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 5.4vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--black);
    margin: 60px 0 24px;
  }
  :root[lang="ja"] .cyv-h1 {
    line-height: 1.3;
    letter-spacing: 0;
  }
  .cyv-h1-accent {
    display: block;
    width: fit-content;
    color: var(--accent);
    border-bottom: 3px solid var(--cyv-lime);
    padding-bottom: 6px;
  }
  .cyv-lede {
    font-size: 16px;
    line-height: 1.95;
    color: var(--cyv-text-2);
    margin: 0 0 32px;
    max-width: 760px;
  }

  /* ─── ボタン ─── */
  .cyv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .cyv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    padding: 14px 24px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-decoration: none;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }
  .cyv-btn--primary {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(139, 69, 19, 0.22);
  }
  .cyv-btn--primary:hover {
    background: var(--accent-lt);
  }
  .cyv-btn--ghost {
    background: transparent;
    color: var(--accent);
    border-color: var(--cyv-line-strong);
  }
  .cyv-btn--ghost:hover {
    border-color: var(--accent);
    background: rgba(139, 69, 19, 0.05);
  }
  .cyv-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ─── カードが見つからない面 ─── */
  .cyv-fallback {
    margin-top: 8px;
    padding: 30px 28px;
    background: var(--cyv-card);
    border: 1px dashed var(--cyv-line-strong);
    border-radius: 14px;
    max-width: 720px;
  }
  /* JS 有効時は既定で隠す。クエリ一致がないときは JS が外して再表示する。 */
  :global(html.cyv-has-js) .cyv-fallback {
    display: none !important;
  }
  .cyv-fallback-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--black);
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }
  .cyv-fallback-desc {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--cyv-text-2);
    overflow-wrap: anywhere;
  }

  /* ─── カード面 ─── */
  .cyv-card {
    margin-top: 8px;
    padding: 30px 28px 26px;
    background: var(--cyv-card);
    border: 1px solid var(--cyv-line);
    border-radius: 14px;
    max-width: 720px;
  }
  /* スタイルが hidden 属性を打ち消さないようにする。 */
  .cyv-card[hidden],
  .cyv-fallback[hidden] {
    display: none !important;
  }
  .cyv-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--cyv-card);
    border: 1px solid var(--cyv-line-strong);
    border-radius: 999px;
    padding: 4px 11px;
    margin-bottom: 14px;
  }
  .cyv-card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--black);
    margin: 0 0 12px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .cyv-kind {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--cyv-text-1);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }
  .cyv-kind-key {
    font-family: var(--font-display);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyv-text-3);
  }
  .cyv-kind-value {
    font-weight: 700;
    color: var(--accent);
  }
  .cyv-card-desc {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--cyv-text-1);
    overflow-wrap: anywhere;
  }

  /* ─── 読み取り行（入力ハッシュ — 一致） ─── */
  .cyv-readout {
    margin: 0 0 16px;
    padding: 14px 16px;
    background: var(--lemma-cream-deep);
    border: 1px solid var(--cyv-line);
    border-left: 3px solid var(--cyv-lime);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--cyv-text-1);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    overflow-wrap: anywhere;
  }
  .cyv-readout-key {
    font-family: var(--font-display);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyv-text-3);
  }
  .cyv-hash {
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--cyv-text-1);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .cyv-readout-dash {
    color: var(--cyv-text-3);
  }
  .cyv-readout-result {
    font-weight: 700;
    color: var(--accent);
  }
  .cyv-example-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--cyv-text-3);
    overflow-wrap: anywhere;
  }

  /* ─── 免責 ─── */
  .cyv-disclaimer {
    margin: 24px 0 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--cyv-text-3);
    max-width: 720px;
    overflow-wrap: anywhere;
  }

  /* ─── 末尾 CTA ─── */
  .cyv-close {
    margin-top: 72px;
    background: var(--lemma-cream-deep);
    border: 1px solid var(--cyv-line);
    border-radius: 18px;
    padding: 48px 44px 40px;
  }

  /* ─── レスポンシブ（375px 幅で崩れない） ─── */
  @media (max-width: 720px) {
    .cyv-container {
      padding: 0 22px;
    }
    .cyv-h1 {
      margin-top: 44px;
    }
    .cyv-close {
      margin-top: 56px;
      padding: 32px 22px;
      border-radius: 14px;
    }
    .cyv-card,
    .cyv-fallback {
      padding: 22px 20px;
    }
  }

  @media (max-width: 430px) {
    .cyv-h1 {
      font-size: clamp(26px, 8vw, 34px);
    }
    .cyv-btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cyv-btn {
      transition: none;
    }
  }
</style>
