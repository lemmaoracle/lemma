---
/**
 * Use Cases index — v24 chrome.
 *
 * Cream page, 1100px container, Sora display + Noto body + Space Mono labels,
 * saddle brown accent. Card grid with white surface + 0.5px line + brown top
 * accent that animates on hover (same vocabulary as Glossary / Blog index).
 */
import type { Locale, Translations } from "../i18n/translations";
import type { UseCase } from "../data/useCases";
import type { Pillar } from "../data/pillars";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";

export interface UseCasesIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  useCases: ReadonlyArray<UseCase>;
  pillars: ReadonlyArray<Pillar>;
  useCaseT: Translations["useCases"];
  pillarT: Translations["pillars"];
}

const { locale, t, base, useCases, pillars, useCaseT, pillarT } =
  Astro.props as UseCasesIndexTemplateProps;
const useCasesPath = `${base}/use-cases`;

function getPillarForUseCase(uc: UseCase): Pillar | undefined {
  return pillars.find((p) => p.slug === uc.pillar);
}

const minLabel = locale === "ja" ? "分" : "min";

const SITE = "https://lemma.frame00.com";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: useCaseT.title,
  description: useCaseT.subtitle,
  url: `${SITE}${useCasesPath}/`,
  inLanguage: locale,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: useCases.map((uc, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: uc.title,
      url: `${SITE}${useCasesPath}/${uc.slug}/`,
    })),
  },
};
---

<Layout
  locale={locale}
  title={`${useCaseT.title} — Lemma`}
  description={useCaseT.subtitle}
  metaType="page"
  pagePath="/use-cases/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="uc-page">
    <div class="uc-container">
      <section class="uc-hero">
        <div class="uc-eyebrow">{useCaseT.title}</div>
        <h1 class="uc-h1">{useCaseT.title}</h1>
        <p class="uc-hero-sub">{useCaseT.subtitle}</p>
      </section>

      <section class="uc-grid">
        {useCases.map((uc) => {
          const pillar = getPillarForUseCase(uc);
          return (
            <a href={`${useCasesPath}/${uc.slug}`} class="uc-card">
              <div class="uc-card-head">
                {pillar && (
                  <span class="uc-card-pillar">P{pillar.order} · {pillar.title[locale]}</span>
                )}
              </div>
              <h2 class="uc-card-title">{uc.title}</h2>
              <p class="uc-card-abstract">{uc.abstract}</p>
              <div class="uc-card-cta">
                <span class="uc-card-cta-label">{pillarT.viewUseCase ?? useCaseT.title}</span>
                {uc.readingTime > 0 && (
                  <span class="uc-card-time">{uc.readingTime} {minLabel}</span>
                )}
              </div>
            </a>
          );
        })}
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .uc-page {
    --uc-display: "Sora", system-ui, sans-serif;
    --uc-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --uc-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --uc-text-1: #1a1a1a;
    --uc-text-2: #3a3a3a;
    --uc-text-3: #5a5a5a;
    --uc-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--uc-text-2);
    font-family: var(--uc-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }

  .uc-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .uc-hero {
    padding: 60px 0 56px;
  }
  .uc-eyebrow {
    font-family: var(--uc-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--uc-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .uc-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .uc-h1 {
    font-family: var(--uc-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.03em;
    max-width: 920px;
  }
  .uc-hero-sub {
    font-size: 16px;
    color: var(--uc-text-2);
    margin: 0;
    line-height: 1.75;
    max-width: 680px;
  }

  /* ─── CARD GRID ─── */
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 8px;
  }
  .uc-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 32px 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .uc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 48px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .uc-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .uc-card:hover::before {
    width: 100%;
  }

  .uc-card-head {
    min-height: 16px;
  }
  .uc-card-pillar {
    font-family: var(--uc-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .uc-card-title {
    font-family: var(--uc-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--black);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .uc-card-abstract {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--uc-text-3);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .uc-card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 0.5px solid var(--lemma-line);
  }
  .uc-card-cta-label {
    font-family: var(--uc-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: transform 0.2s;
  }
  .uc-card:hover .uc-card-cta-label {
    transform: translateX(3px);
  }
  .uc-card-time {
    font-family: var(--uc-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--uc-text-4);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .uc-h1 {
      font-size: 42px;
    }
    .uc-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .uc-container {
      padding: 0 24px;
    }
    .uc-hero {
      padding: 40px 0 36px;
    }
    .uc-h1 {
      font-size: 32px;
    }
    .uc-card {
      padding: 28px 24px 24px;
    }
  }
</style>
