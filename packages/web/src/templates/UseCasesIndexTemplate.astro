---
/**
 * Use Cases index — v24 chrome with industry chip filter (SPEC 2026-06-02).
 *
 * Cream page, 1020px container, Sora display + Noto body + Space Mono labels,
 * saddle brown accent. Industry chip finder above a simplified card grid.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { UseCase } from "../data/useCases";
import type { Pillar } from "../data/pillars";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";

export interface UseCasesIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  useCases: ReadonlyArray<UseCase>;
  pillars: ReadonlyArray<Pillar>;
  useCaseT: Translations["useCases"];
  pillarT: Translations["pillars"];
}

import { USE_CASE_TASK_GROUPS_JA } from "../config/useCaseTaskGroups";

const { locale, t, base, useCases, pillars, useCaseT } =
  Astro.props as UseCasesIndexTemplateProps;
const useCasesPath = `${base}/solutions/use-cases`;
const isJa = locale === "ja";

function getPillarForUseCase(uc: UseCase): Pillar | undefined {
  return pillars.find((p) => p.slug === uc.pillar);
}

// Task-axis grouping (JA only — EN keeps the flat grid until copy lands).
// Each group's `members` is the subset of `useCases` whose slug appears in
// the group config, in the config's order. Groups with no resolved members
// are dropped so we never render an empty section.
const useCasesBySlug = new Map(useCases.map((uc) => [uc.slug, uc]));
const taskGroups = isJa
  ? USE_CASE_TASK_GROUPS_JA
      .map((g) => ({
        ...g,
        members: g.slugs
          .map((s) => useCasesBySlug.get(s))
          .filter((uc): uc is UseCase => uc !== undefined),
      }))
      .filter((g) => g.members.length > 0)
  : null;

type IndustryKey = "mfg" | "fin" | "pub" | "sc" | "svc" | "ai" | "edu" | "dev";
// Visible filter chips. `edu` is a defined taxonomy key (card-level label only) but is
// not yet a filter chip — discipline: add a chip once ≥2 use cases carry the key.
// `svc` (サービス・小売) joins as a chip from the batch4 spec addendum (≥2 use cases).
const INDUSTRY_ORDER: ReadonlyArray<IndustryKey> = ["mfg", "fin", "pub", "sc", "svc", "ai", "dev"];

const SITE = "https://lemma.frame00.com";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: useCaseT.title,
  description: useCaseT.subtitle,
  url: `${SITE}${useCasesPath}/`,
  inLanguage: locale,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: useCases.map((uc, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: uc.title,
      url: `${SITE}${useCasesPath}/${uc.slug}/`,
    })),
  },
};
---

<Layout
  locale={locale}
  title={`${useCaseT.title} — Lemma`}
  description={useCaseT.subtitle}
  metaType="page"
  pagePath="/solutions/use-cases/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="uc-page">
    <div class="uc-container">
      <section class="uc-hero">
        <h1 class="uc-h1">{useCaseT.title}</h1>
        <p class="uc-hero-sub">{useCaseT.subtitle}</p>
        {isJa && (
          <p class="uc-hero-subnote">データは渡さない。証明は渡る。</p>
        )}
      </section>

      <section class="uc-finder" aria-labelledby="uc-finder-label">
        <div class="uc-finder-lbl" id="uc-finder-label">{useCaseT.finderLabel}</div>
        <div class="uc-chips" role="radiogroup" aria-label={useCaseT.finderLabel}>
          <button type="button" class="uc-chip on" data-f="all" role="radio" aria-checked="true">{useCaseT.industryAll}</button>
          {INDUSTRY_ORDER.map((key) => (
            <button type="button" class="uc-chip" data-f={key} role="radio" aria-checked="false">{useCaseT.industryLabels[key]}</button>
          ))}
        </div>
        <div class="uc-count" id="uc-count" data-tpl-all={useCaseT.countAll} data-tpl-match={useCaseT.countMatch}></div>
      </section>

      {taskGroups ? (
        taskGroups.map((group) => (
          <section class="uc-group" data-group={group.id}>
            <div class="uc-group-eye">{group.id}</div>
            <h2 class="uc-group-heading">{group.heading}</h2>
            <p class="uc-group-desc">{group.description}</p>
            <div class="uc-grid">
              {group.members.map((uc) => {
                const pillar = getPillarForUseCase(uc);
                const inds = uc.industries.length > 0 ? uc.industries : [];
                const summary = uc.cardSummary || uc.thesis;
                return (
                  <a href={`${useCasesPath}/${uc.slug}/`} class="uc-card" data-ind={inds.join(" ")}>
                    {pillar && (
                      <div class="uc-card-pillar">P{pillar.order} · {pillar.title[locale]}</div>
                    )}
                    <h3 class="uc-card-title">{uc.title}</h3>
                    <p class="uc-card-summary">{summary}</p>
                    {inds.length > 0 && (
                      <div class="uc-card-inds">
                        {inds.map((k) => {
                          const label = useCaseT.industryLabels[k as IndustryKey];
                          return label ? <span class="uc-ind">{label}</span> : null;
                        })}
                      </div>
                    )}
                    <div class="uc-card-foot">
                      <span class="uc-card-go">{useCaseT.cardCta}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))
      ) : (
        <section class="uc-grid" id="uc-grid">
          {useCases.map((uc) => {
            const pillar = getPillarForUseCase(uc);
            const inds = uc.industries.length > 0 ? uc.industries : [];
            const summary = uc.cardSummary || uc.thesis;
            return (
              <a href={`${useCasesPath}/${uc.slug}/`} class="uc-card" data-ind={inds.join(" ")}>
                {pillar && (
                  <div class="uc-card-pillar">P{pillar.order} · {pillar.title[locale]}</div>
                )}
                <h2 class="uc-card-title">{uc.title}</h2>
                <p class="uc-card-summary">{summary}</p>
                {inds.length > 0 && (
                  <div class="uc-card-inds">
                    {inds.map((k) => {
                      const label = useCaseT.industryLabels[k as IndustryKey];
                      return label ? <span class="uc-ind">{label}</span> : null;
                    })}
                  </div>
                )}
                <div class="uc-card-foot">
                  <span class="uc-card-go">{useCaseT.cardCta}</span>
                </div>
              </a>
            );
          })}
        </section>
      )}
      <p class="uc-empty" id="uc-empty">{useCaseT.emptyState}</p>

      <aside class="uc-brief-link">
        <a href={`${base}/critical/briefs/`}>{useCaseT.briefLinkLabel} →</a>
      </aside>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".uc-chip"));
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".uc-card"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".uc-group"));
  const countEl = document.getElementById("uc-count");
  const emptyEl = document.getElementById("uc-empty");

  if (!countEl || !emptyEl) {
    // nothing to wire
  } else {
    const tplAll = countEl.dataset.tplAll ?? "{n}";
    const tplMatch = countEl.dataset.tplMatch ?? "{n}";

    function apply(f: string) {
      let n = 0;
      cards.forEach((c) => {
        const ind = c.dataset.ind ?? "";
        const show = f === "all" || ind.split(" ").includes(f);
        c.style.display = show ? "" : "none";
        if (show) n++;
      });
      // Hide whole task-axis groups whose cards are all filtered out so the
      // h2 doesn't sit alone above an empty grid.
      groups.forEach((g) => {
        const anyVisible = Array.from(g.querySelectorAll<HTMLAnchorElement>(".uc-card"))
          .some((c) => c.style.display !== "none");
        g.style.display = anyVisible ? "" : "none";
      });
      const tpl = f === "all" ? tplAll : tplMatch;
      countEl.textContent = tpl.replace("{n}", String(n));
      emptyEl.style.display = n === 0 ? "block" : "none";
    }

    chips.forEach((ch) => {
      ch.addEventListener("click", () => {
        chips.forEach((x) => {
          x.classList.remove("on");
          x.setAttribute("aria-checked", "false");
        });
        ch.classList.add("on");
        ch.setAttribute("aria-checked", "true");
        apply(ch.dataset.f ?? "all");
      });
    });

    apply("all");
  }
</script>

<style>
  .uc-page {
    --uc-display: "Sora", system-ui, sans-serif;
    --uc-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --uc-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --uc-text-1: #1a1a1a;
    --uc-text-2: #3a3a3a;
    --uc-text-3: #5a5a5a;
    --uc-text-4: #9a9a9a;
    --uc-cream-d: #f2eedf;

    background: var(--lemma-cream);
    color: var(--uc-text-2);
    font-family: var(--uc-body);
    font-weight: 400;
    line-height: 1.7;
    padding: 0 0 96px;
    margin-top: 64px;
    font-size: 14.5px;
  }

  .uc-container {
    max-width: 1020px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .uc-hero {
    padding: 60px 0 40px;
  }
  .uc-h1 {
    font-family: var(--uc-display);
    font-size: 42px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 14px;
    color: var(--black);
    letter-spacing: -0.035em;
    max-width: 920px;
  }
  .uc-hero-sub {
    font-size: 15px;
    color: var(--uc-text-3);
    margin: 0;
    line-height: 1.75;
    max-width: 680px;
  }
  .uc-hero-subnote {
    font-family: var(--uc-display);
    font-size: 13px;
    color: var(--uc-text-4);
    margin: 4px 0 0;
    letter-spacing: 0.01em;
  }

  /* ─── TASK-AXIS GROUPS (JA) ─── */
  .uc-group {
    margin: 48px 0 0;
  }
  .uc-group:first-of-type {
    margin-top: 28px;
  }
  .uc-group-eye {
    font-family: var(--uc-mono);
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .uc-group-eye::before {
    content: "";
    width: 26px;
    height: 1.5px;
    background: var(--accent);
  }
  .uc-group-heading {
    font-family: var(--uc-display);
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--black, #000);
    margin: 0 0 4px;
    line-height: 1.25;
  }
  .uc-group-desc {
    font-size: 13.5px;
    color: var(--uc-text-3);
    margin: 0 0 18px;
    line-height: 1.65;
  }
  .uc-group .uc-grid {
    margin: 0;
  }

  /* ─── FINDER ─── */
  .uc-finder {
    margin: 12px 0 26px;
  }
  .uc-finder-lbl {
    font-family: var(--uc-mono);
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--uc-text-3);
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .uc-finder-lbl::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .uc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .uc-chip {
    font-family: var(--uc-display);
    font-size: 13px;
    font-weight: 500;
    color: var(--uc-text-2);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    line-height: 1;
  }
  .uc-chip::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lemma-line);
    transition: background 0.15s;
  }
  .uc-chip:hover {
    border-color: var(--accent);
    color: var(--black);
  }
  .uc-chip.on {
    background: var(--accent);
    color: var(--lemma-cream);
    border-color: var(--accent);
  }
  .uc-chip.on::before {
    background: var(--lemma-cream);
  }
  .uc-count {
    font-family: var(--uc-mono);
    font-size: 11px;
    color: var(--uc-text-4);
    margin: 14px 0 0;
    letter-spacing: 0.04em;
  }

  /* ─── CARD GRID ─── */
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 8px;
  }
  .uc-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .uc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .uc-card:hover {
    border-color: var(--accent);
    box-shadow: 0 12px 28px rgba(139, 69, 19, 0.07);
    transform: translateY(-3px);
  }
  .uc-card:hover::before {
    width: 100%;
  }

  .uc-card-pillar {
    font-family: var(--uc-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .uc-card-pillar::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .uc-card-title {
    font-family: var(--uc-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--black);
    letter-spacing: -0.015em;
    margin: 0 0 8px;
  }

  .uc-card-summary {
    font-family: var(--uc-body);
    font-size: 13px;
    color: var(--uc-text-3);
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .uc-card-inds {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }
  .uc-ind {
    font-size: 10.5px;
    color: var(--uc-text-3);
    background: var(--uc-cream-d);
    border-radius: 5px;
    padding: 3px 8px;
    line-height: 1.4;
  }

  .uc-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 13px;
    border-top: 0.5px solid var(--lemma-line);
  }
  .uc-card-go {
    font-family: var(--uc-mono);
    font-size: 11px;
    color: var(--black);
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .uc-card:hover .uc-card-go {
    color: var(--accent);
  }

  .uc-empty {
    display: none;
    color: var(--uc-text-4);
    font-size: 13px;
    padding: 30px 0;
    text-align: center;
  }

  .uc-brief-link {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 0.5px solid var(--lemma-line);
    text-align: center;
  }
  .uc-brief-link a {
    font-family: var(--uc-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--uc-text-4);
    transition: color 0.2s;
  }
  .uc-brief-link a:hover {
    color: var(--accent);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 880px) {
    .uc-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .uc-container {
      padding: 0 22px;
    }
    .uc-hero {
      padding: 40px 0 28px;
    }
    .uc-h1 {
      font-size: 30px;
    }
    .uc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
