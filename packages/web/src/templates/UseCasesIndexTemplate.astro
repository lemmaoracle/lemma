---
import type { Locale, Translations } from "../i18n/translations";
import type { UseCase } from "../data/useCases";
import type { Pillar } from "../data/pillars";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";

export interface UseCasesIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  useCases: ReadonlyArray<UseCase>;
  pillars: ReadonlyArray<Pillar>;
  useCaseT: Translations["useCases"];
  pillarT: Translations["pillars"];
}

const { locale, t, base, useCases, pillars, useCaseT, pillarT } =
  Astro.props as UseCasesIndexTemplateProps;
const useCasesPath = `${base}/use-cases`;

function getPillarForUseCase(uc: UseCase): Pillar | undefined {
  return pillars.find((p) => p.slug === uc.pillar);
}

const SITE = "https://lemma.frame00.com";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: useCaseT.title,
  description: useCaseT.subtitle,
  url: `${SITE}${useCasesPath}/`,
  inLanguage: locale,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: useCases.map((uc, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: uc.title,
      url: `${SITE}${useCasesPath}/${uc.slug}/`,
    })),
  },
};
---

<Layout
  locale={locale}
  title={`${useCaseT.title} — Lemma Oracle`}
  description={useCaseT.subtitle}
  metaType="page"
  pagePath="/use-cases/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <header class="uc-header">
    <div class="section-tag" style="color:var(--accent)">{useCaseT.title}</div>
    <h1>{useCaseT.subtitle}</h1>
  </header>

  <section class="uc-grid-section">
    <div class="uc-grid">
      {useCases.map((uc, i) => {
        const pillar = getPillarForUseCase(uc);
        return (
          <a
            href={`${useCasesPath}/${uc.slug}`}
            class="uc-card reveal"
            style={`transition-delay:${i * 0.06}s`}
          >
            <div class="uc-order">
              {pillar ? `P${pillar.order} · ${pillar.title[locale]}` : useCaseT.title}
            </div>
            <div class="uc-content">
              <h2 class="uc-title">{uc.title}</h2>
              <p class="uc-abstract">{uc.abstract}</p>
            </div>
            <div class="uc-cta">
              <span>{pillarT.viewUseCase ?? useCaseT.title}</span>
              <span class="uc-arrow">→</span>
              {uc.readingTime > 0 && (
                <span class="uc-time">· {uc.readingTime} {locale === "ja" ? "分" : "min"}</span>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .uc-header {
    margin-top: 64px;
    background: var(--black);
    padding: 100px 10% 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .uc-header h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 300;
    color: var(--white);
    line-height: 1.08;
    margin: 0 0 16px;
  }

  .section-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-tag::before {
    content: "";
    width: 18px;
    height: 1px;
    background: currentColor;
    display: block;
  }

  .uc-grid-section {
    background: var(--white);
    padding: 80px 10% 120px;
  }

  .uc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--gray-200);
  }

  .uc-card {
    background: var(--white);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    border-top: 2px solid transparent;
    transition: opacity 0.55s ease, transform 0.55s ease, border-color 0.2s, background 0.2s;
  }
  .uc-card:hover {
    border-top-color: var(--accent);
    background: var(--gray-50);
  }

  .uc-order {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .uc-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .uc-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 600;
    line-height: 1.25;
    color: var(--black);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .uc-abstract {
    font-size: 15px;
    line-height: 1.7;
    color: var(--gray-800);
    margin: 0;
  }

  .uc-cta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 8px;
  }
  .uc-arrow {
    transition: transform 0.2s;
  }
  .uc-card:hover .uc-arrow {
    transform: translateX(4px);
  }
  .uc-time {
    color: var(--gray-500);
    letter-spacing: 0.06em;
    text-transform: none;
    font-weight: 400;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
  }
  .reveal.on {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1024px) {
    .uc-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    .uc-header {
      padding: 80px 6% 60px;
    }
    .uc-grid-section {
      padding: 56px 6% 80px;
    }
    .uc-card {
      padding: 36px 28px;
    }
  }
</style>

<script is:inline>
  var io = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add("on");
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
  );
  document.querySelectorAll(".reveal").forEach(function (el) {
    io.observe(el);
  });
</script>
