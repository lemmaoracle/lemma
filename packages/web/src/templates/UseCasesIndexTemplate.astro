---
/**
 * Use Cases index — v24 chrome with industry chip filter (SPEC 2026-06-02).
 *
 * Cream page, 1020px container, Sora display + Noto body + Space Mono labels,
 * saddle brown accent. Industry chip finder above a simplified card grid.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { UseCase } from "../data/useCases";
import type { Pillar } from "../data/pillars";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import SolutionsBridge from "../components/SolutionsBridge.astro";
import UseCaseIcon from "../components/usecase/UseCaseIcon.astro";

export interface UseCasesIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  useCases: ReadonlyArray<UseCase>;
  pillars: ReadonlyArray<Pillar>;
  useCaseT: Translations["useCases"];
  pillarT: Translations["pillars"];
}

import { USE_CASE_TASK_GROUPS_JA, USE_CASE_TASK_GROUPS_EN } from "../config/useCaseTaskGroups";
import { USE_CASE_PLAN } from "../data/useCasePlanMap";

const { locale, t, base, useCases, useCaseT } =
  Astro.props as UseCasesIndexTemplateProps;
const useCasesPath = `${base}/solutions/use-cases`;
const isJa = locale === "ja";

// "対応プラン" badge — non-interactive (card is already a link). Names are
// brand-fixed (Civic / Critical / Compliance), so they read the same in both
// locales; only the lead label is localised.
const planTagLabel = isJa ? "対応プラン" : "Plan";
const PLAN_NAME: Readonly<Record<string, string>> = {
  civic: "Civic",
  critical: "Critical",
  compliance: "Compliance",
};

// Task-axis grouping (JA only — EN keeps the flat grid until copy lands).
// Each group's `members` is the subset of `useCases` whose slug appears in
// the group config, in the config's order. Groups with no resolved members
// are dropped so we never render an empty section.
const useCasesBySlug = new Map(useCases.map((uc) => [uc.slug, uc]));
const taskGroups = (isJa ? USE_CASE_TASK_GROUPS_JA : USE_CASE_TASK_GROUPS_EN)
  .map((g) => ({
    ...g,
    members: g.slugs
      .map((s) => useCasesBySlug.get(s))
      .filter((uc): uc is UseCase => uc !== undefined),
  }))
  .filter((g) => g.members.length > 0);

type IndustryKey = "mfg" | "fin" | "pub" | "sc" | "svc" | "ai" | "edu" | "dev";
// Visible filter chips. `edu` is a defined taxonomy key (card-level label only) but is
// not yet a filter chip — discipline: add a chip once ≥2 use cases carry the key.
// `svc` (サービス・小売) joins as a chip from the batch4 spec addendum (≥2 use cases).
const INDUSTRY_ORDER: ReadonlyArray<IndustryKey> = ["mfg", "fin", "pub", "sc", "svc", "ai", "dev"];

const SITE = "https://lemma.frame00.com";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: useCaseT.title,
  description: useCaseT.subtitle,
  url: `${SITE}${useCasesPath}/`,
  inLanguage: locale,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: useCases.map((uc, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: uc.title,
      url: `${SITE}${useCasesPath}/${uc.slug}/`,
    })),
  },
};
---

<Layout
  locale={locale}
  title={useCaseT.metaTitle}
  description={useCaseT.metaDescription}
  metaType="page"
  pagePath="/solutions/use-cases/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="uc-page">
    <div class="uc-container">
      <section class="uc-hero">
        <h1 class="uc-h1">{useCaseT.title}</h1>
        <p class="uc-hero-sub">{useCaseT.subtitle}</p>
        <p class="uc-hero-subnote">{isJa ? "データは渡さない。証明は渡る。" : "Data stays. Proof travels."}</p>
        <p class="uc-hero-intro">{useCaseT.chooseOne}</p>
      </section>

      {taskGroups && (
        <section class="uc-shortcut" aria-label={isJa ? "課題から探す" : "Find by challenge"}>
          <div class="uc-sec-lbl">{isJa ? "課題から探す" : "Find by challenge"}</div>
          <div class="uc-shortcut-grid">
            {taskGroups.map((g) => (
              <a class="uc-shortcut-item" href={`#${g.anchor}`}>
                <span class="uc-shortcut-num">{g.id}</span>
                <span class="uc-shortcut-name">{g.heading}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="uc-finder" aria-labelledby="uc-finder-label">
        <div class="uc-finder-lbl" id="uc-finder-label">{useCaseT.finderLabel}</div>
        <div class="uc-chips" role="radiogroup" aria-label={useCaseT.finderLabel}>
          <button type="button" class="uc-chip on" data-f="all" role="radio" aria-checked="true">{useCaseT.industryAll}</button>
          {INDUSTRY_ORDER.map((key) => (
            <button type="button" class="uc-chip" data-f={key} role="radio" aria-checked="false">{useCaseT.industryLabels[key]}</button>
          ))}
        </div>
        <div class="uc-count" id="uc-count" data-tpl-all={useCaseT.countAll} data-tpl-match={useCaseT.countMatch}></div>
      </section>

      {taskGroups ? (
        <div class="uc-groups">
        {taskGroups.map((group, gi) => (
          <section class:list={["uc-group", { open: gi === 0 }]} id={group.anchor} data-group={group.id}>
            <h2 class="uc-group-head">
              <button type="button" class="uc-group-toggle" aria-expanded={gi === 0 ? "true" : "false"}>
                <span class="uc-group-eye">{group.id}</span>
                <span class="uc-group-heading">{group.heading}</span>
                <span class="uc-group-chev" aria-hidden="true">▾</span>
              </button>
            </h2>
            <div class="uc-group-body">
              <p class="uc-group-desc">{group.description}</p>
              <div class="uc-grid">
                {group.members.map((uc) => {
                  const inds = uc.industries.length > 0 ? uc.industries : [];
                  const summary = uc.cardSummary || uc.thesis;
                  return (
                    <a href={`${useCasesPath}/${uc.slug}/`} class="uc-card" data-ind={inds.join(" ")}>
                      <UseCaseIcon slug={uc.slug} />
                      {USE_CASE_PLAN[uc.slug] && (
                        <div class="uc-card-plan">{planTagLabel} · {PLAN_NAME[USE_CASE_PLAN[uc.slug]]}</div>
                      )}
                      <h3 class="uc-card-title">{uc.title}</h3>
                      <p class="uc-card-summary">{summary}</p>
                    </a>
                  );
                })}
              </div>
            </div>
          </section>
        ))}
        </div>
      ) : (
        <section class="uc-grid" id="uc-grid">
          {useCases.map((uc) => {
            const inds = uc.industries.length > 0 ? uc.industries : [];
            const summary = uc.cardSummary || uc.thesis;
            return (
              <a href={`${useCasesPath}/${uc.slug}/`} class="uc-card" data-ind={inds.join(" ")}>
                <UseCaseIcon slug={uc.slug} />
                {USE_CASE_PLAN[uc.slug] && (
                  <div class="uc-card-plan">{planTagLabel} · {PLAN_NAME[USE_CASE_PLAN[uc.slug]]}</div>
                )}
                <h2 class="uc-card-title">{uc.title}</h2>
                <p class="uc-card-summary">{summary}</p>
                {inds.length > 0 && (
                  <div class="uc-card-inds">
                    {inds.map((k) => {
                      const label = useCaseT.industryLabels[k as IndustryKey];
                      return label ? <span class="uc-ind">{label}</span> : null;
                    })}
                  </div>
                )}
                <div class="uc-card-foot">
                  <span class="uc-card-go">{useCaseT.cardCta}</span>
                </div>
              </a>
            );
          })}
        </section>
      )}
      <p class="uc-empty" id="uc-empty">{useCaseT.emptyState}</p>

      <section class="uc-pop" aria-label={isJa ? "よく読まれるケース" : "Popular use cases"}>
        <div class="uc-sec-lbl">{isJa ? "よく読まれるケース" : "Popular use cases"}</div>
        <div class="uc-pop-grid">
          <a class="uc-pop-card" href={`${base}/solutions/use-cases/ai-document-isolation/`}>
            <span class="uc-pop-tag">{isJa ? "AI導入 / 製造" : "AI adoption / Mfg"}</span>
            <span class="uc-pop-plan">{planTagLabel} · {PLAN_NAME[USE_CASE_PLAN["ai-document-isolation"]]}</span>
            <h3 class="uc-pop-title">{isJa ? "社内文書をAIに使わせるが生データは触らせない" : "Let AI use internal documents without touching raw data"}</h3>
            <span class="uc-pop-go">{isJa ? "見る →" : "View →"}</span>
          </a>
          <a class="uc-pop-card" href={`${base}/solutions/use-cases/counterparty-screening/`}>
            <span class="uc-pop-tag">{isJa ? "金融 / 製造 / SC" : "Finance / Mfg / SC"}</span>
            <span class="uc-pop-plan">{planTagLabel} · {PLAN_NAME[USE_CASE_PLAN["counterparty-screening"]]}</span>
            <h3 class="uc-pop-title">{isJa ? "取引先の与信・反社チェック — 結果だけを渡す" : "Counterparty credit & sanctions checks — hand over only the result"}</h3>
            <span class="uc-pop-go">{isJa ? "見る →" : "View →"}</span>
          </a>
          <a class="uc-pop-card" href={`${base}/solutions/use-cases/ai-audit-log-proof/`}>
            <span class="uc-pop-tag">{isJa ? "金融 / 自治体" : "Finance / Public"}</span>
            <span class="uc-pop-plan">{planTagLabel} · {PLAN_NAME[USE_CASE_PLAN["ai-audit-log-proof"]]}</span>
            <h3 class="uc-pop-title">{isJa ? "AI監査ログ証明" : "AI audit-log proof"}</h3>
            <span class="uc-pop-go">{isJa ? "見る →" : "View →"}</span>
          </a>
        </div>
      </section>

      <SolutionsBridge
        variant="light"
        href={`${base}/solutions/`}
        text={isJa ? "業務領域ごとの全体像は、" : "For the bigger picture by workflow, "}
        linkLabel={isJa ? "Solutions の活用シーンへ →" : "see Solutions use scenarios →"}
      />

      <section class="uc-cta">
        <h2 class="uc-cta-h">{isJa ? "業務に乗るか、確かめる。" : "See if it fits your workflow."}</h2>
        <div class="uc-cta-row">
          <a class="uc-cta-primary" href={isJa ? "https://tally.so/r/EkBqDX" : "https://tally.so/r/Pd2Rl5"} target="_blank" rel="noopener">{isJa ? "Discovery Call を予約 →" : "Book a Discovery Call →"}</a>
          <a class="uc-cta-secondary" href={isJa ? "https://tally.so/r/xX0VYv" : "https://tally.so/r/7RJXdR"} target="_blank" rel="noopener">{isJa ? "ホワイトペーパー DL →" : "Download the whitepaper →"}</a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".uc-chip"));
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".uc-card"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".uc-group"));
  const groupsWrap = document.querySelector<HTMLElement>(".uc-groups");
  const countEl = document.getElementById("uc-count");
  const emptyEl = document.getElementById("uc-empty");

  // ── Accordion (task-axis groups) ──
  function setOpen(g: HTMLElement, open: boolean) {
    g.classList.toggle("open", open);
    const btn = g.querySelector<HTMLButtonElement>(".uc-group-toggle");
    if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
  }
  groups.forEach((g) => {
    const btn = g.querySelector<HTMLButtonElement>(".uc-group-toggle");
    if (btn) {
      btn.addEventListener("click", () => {
        if (g.classList.contains("dim")) return; // zero-match groups stay folded
        setOpen(g, !g.classList.contains("open"));
      });
    }
  });

  if (!countEl || !emptyEl) {
    // nothing to wire
  } else {
    const tplAll = countEl.dataset.tplAll ?? "{n}";
    const tplMatch = countEl.dataset.tplMatch ?? "{n}";

    function apply(f: string) {
      let n = 0;
      cards.forEach((c) => {
        const ind = c.dataset.ind ?? "";
        const show = f === "all" || ind.split(" ").includes(f);
        c.style.display = show ? "" : "none";
        if (show) n++;
      });
      // Filter ↔ accordion coordination:
      //  - "all": reset to initial (group 01 open, the rest folded), undimmed.
      //  - industry: groups with a match auto-expand; zero-match groups dim + fold.
      if (f === "all") {
        // Browse mode: accordion (group 01 open, the rest folded).
        groupsWrap?.classList.remove("filtering");
        groups.forEach((g, i) => { g.style.display = ""; setOpen(g, i === 0); });
      } else {
        // Filter mode: collapse the accordion chrome and reflow every matching
        // card into one flat grid (group headings hidden via .filtering CSS).
        groupsWrap?.classList.add("filtering");
        groups.forEach((g) => { g.style.display = ""; setOpen(g, true); });
      }
      const tpl = f === "all" ? tplAll : tplMatch;
      countEl.textContent = tpl.replace("{n}", String(n));
      emptyEl.style.display = n === 0 ? "block" : "none";
    }

    function select(f: string, updateHash: boolean) {
      const target = chips.find((c) => (c.dataset.f ?? "all") === f);
      if (!target) return false;
      chips.forEach((x) => {
        x.classList.remove("on");
        x.setAttribute("aria-checked", "false");
      });
      target.classList.add("on");
      target.setAttribute("aria-checked", "true");
      apply(f);
      if (updateHash) {
        history.replaceState(null, "", f === "all" ? location.pathname + location.search : `#${f}`);
      }
      return true;
    }

    chips.forEach((ch) => {
      ch.addEventListener("click", () => select(ch.dataset.f ?? "all", true));
    });

    // Hash routing: industry keys (#mfg, …) filter; task anchors (#ai-data, …)
    // expand the matching group and scroll to it.
    const groupByAnchor = new Map(groups.map((g) => [g.id, g] as const));
    const fromHash = () => {
      const key = location.hash.replace(/^#/, "");
      if (!key) { select("all", false); return; }
      const g = groupByAnchor.get(key);
      if (g) {
        select("all", false);
        setOpen(g, true);
        g.scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }
      if (!select(key, false)) select("all", false);
    };
    window.addEventListener("hashchange", fromHash);
    fromHash();
  }
</script>

<style>
  .uc-page {
    --uc-display: var(--font-display);
    --uc-body: "Noto Sans JP", system-ui, sans-serif;
    --uc-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --uc-text-1: #1a1a1a;
    --uc-text-2: #3a3a3a;
    --uc-text-3: #5a5a5a;
    --uc-text-4: #9a9a9a;
    --uc-cream-d: #f2eedf;

    background: var(--lemma-cream);
    color: var(--uc-text-2);
    font-family: var(--uc-body);
    font-weight: 400;
    line-height: 1.7;
    padding: 0 0 60px;
    padding-top: 64px; /* sticky ナビ時代の margin-top:64px を padding に変換 — body 背景色の帯を出さない（H1 上の空白修正） */
    font-size: 14.5px;
  }

  .uc-container {
    max-width: 1020px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .uc-hero {
    padding: 60px 0 40px;
  }
  .uc-h1 {
    font-family: var(--uc-display);
    font-size: 42px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 14px;
    color: var(--black);
    letter-spacing: -0.035em;
    max-width: 920px;
  }
  .uc-hero-sub {
    font-size: 15px;
    color: var(--uc-text-3);
    margin: 0;
    line-height: 1.75;
    max-width: 680px;
  }
  .uc-hero-subnote {
    font-family: var(--uc-display);
    font-size: 13px;
    color: var(--uc-text-4);
    margin: 4px 0 0;
    letter-spacing: 0.01em;
  }
  .uc-hero-intro {
    font-size: 14px;
    color: var(--uc-text-3);
    margin: 14px 0 0;
    line-height: 1.7;
    max-width: 680px;
  }

  /* ─── TASK-AXIS GROUPS (JA) ─── */
  .uc-group {
    margin: 0;
  }
  .uc-group:first-of-type {
    margin-top: 20px;
  }
  .uc-group-head {
    margin: 0;
  }
  .uc-group-toggle {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    background: none;
    border: 0;
    border-top: 0.5px solid var(--lemma-line);
    padding: 22px 0;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
  }
  .uc-group-eye {
    font-family: var(--uc-mono);
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
  }
  .uc-group-eye::before {
    content: "";
    width: 26px;
    height: 1.5px;
    background: var(--accent);
  }
  .uc-group-heading {
    font-family: var(--uc-display);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--black, #000);
    margin: 0;
    line-height: 1.3;
  }
  .uc-group-chev {
    margin-left: auto;
    color: var(--uc-text-4);
    font-size: 13px;
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .uc-group.open .uc-group-chev {
    transform: rotate(180deg);
  }
  .uc-group-body {
    padding: 2px 0 10px;
  }
  .uc-group:not(.open) > .uc-group-body {
    display: none;
  }
  .uc-group.dim {
    opacity: 0.45;
  }
  .uc-group.dim .uc-group-toggle {
    cursor: default;
  }
  .uc-group-desc {
    font-size: 13.5px;
    color: var(--uc-text-3);
    margin: 0 0 18px;
    line-height: 1.65;
  }
  .uc-group .uc-grid {
    margin: 0;
  }
  /* Filter mode: flatten groups into a single grid (headings hidden) */
  .uc-groups.filtering {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 8px;
  }
  .uc-groups.filtering .uc-group,
  .uc-groups.filtering .uc-group-body,
  .uc-groups.filtering .uc-grid {
    display: contents;
  }
  .uc-groups.filtering .uc-group-head,
  .uc-groups.filtering .uc-group-desc {
    display: none;
  }
  @media (max-width: 880px) {
    .uc-groups.filtering { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .uc-groups.filtering { grid-template-columns: 1fr; }
  }

  /* ─── FINDER ─── */
  .uc-finder {
    margin: 12px 0 26px;
  }
  .uc-finder-lbl {
    font-family: var(--uc-mono);
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--uc-text-3);
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .uc-finder-lbl::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .uc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .uc-chip {
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--uc-text-2);
    background: var(--white);
    border: 1px solid var(--lemma-line);
    border-radius: 999px;
    padding: 11px 20px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1;
  }
  .uc-chip::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lemma-line);
    transition: background 0.15s;
  }
  .uc-chip:hover {
    border-color: var(--accent);
    color: var(--black);
  }
  .uc-chip.on {
    background: var(--accent);
    color: var(--lemma-cream);
    border-color: var(--accent);
  }
  .uc-chip.on::before {
    background: var(--lemma-cream);
  }
  .uc-count {
    font-family: var(--uc-mono);
    font-size: 11px;
    color: var(--uc-text-4);
    margin: 14px 0 0;
    letter-spacing: 0.04em;
  }

  /* ─── CARD GRID ─── */
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 8px;
  }
  .uc-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .uc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .uc-card:hover {
    border-color: var(--accent);
    box-shadow: 0 12px 28px rgba(139, 69, 19, 0.07);
    transform: translateY(-3px);
  }
  .uc-card:hover::before {
    width: 100%;
  }

  .uc-card-pillar {
    font-family: var(--uc-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .uc-card-pillar::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
