---
/**
 * Proof Gate by Lemma — executive landing page on the existing /cyber/ route.
 * Lean IA: headline + outcome lede, 3 gate cards, short before-execution flow,
 * one evidence link, adoption CTA. No prices, no live-availability claims,
 * no per-gate evaluation numbers. Enforcement requires an execution gate.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import CyberHeroCard from "../components/CyberHeroCard.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-mono/latin-400.css";

export interface CyberTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}
const { locale, t, base } = Astro.props as CyberTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);
const C = isJa
  ? {
      title: "Proof Gate by Lemma — 流出しないシステム｜Lemma",
      description:
        "送金・口座変更・AIエージェントの操作を、実行の直前で確かめる。条件に合わない操作を通さない、流出しないシステムの導入相談。",
      brand: "Proof Gate by Lemma",
      headline: "流出しないシステム",
      intro:
        "送金・口座変更・AIエージェントの操作を、実行の直前で確かめます。振込先・金額・任せた範囲が条件に合わない操作は、通しません。",
      scope:
        "保護の対象は確認を組み込んだ操作です。組み込んでいない経路や、条件の範囲内の悪用は防げません。",
      availability: "導入相談受付中",
      call: "導入を相談する",
      learn: "3つのゲートを見る",
      gatesTitle: "3つのゲート",
      gatesIntro: "危ない操作ごとにゲートを置きます。1つから始め、必要な点に足せます。",
      gates: [
        {
          symbol: "¥",
          who: "経理・財務",
          title: "送金ゲート",
          outcome: "決めた送金先・金額の送金だけを通す",
          support: "送金先のすり替えによる資金流出を防ぐ。",
          conditions: ["送金先", "金額", "期限"],
        },
        {
          symbol: "⇄",
          who: "経理・取引先",
          title: "口座変更ゲート",
          outcome: "確認済みの口座変更だけを登録する",
          support: "なりすましの振込先変更を防ぐ。",
          conditions: ["取引先", "変更内容", "期限"],
        },
        {
          symbol: "{ }",
          who: "開発・情シス",
          title: "エージェント操作ゲート",
          outcome: "任せた範囲・期間の操作だけ通す",
          support: "範囲外の操作・情報流出を防ぐ。毎回の承認は要らない。",
          conditions: ["対象", "操作", "期間"],
        },
      ],
      gatesNote: "各ゲートの提供時期は相談時に案内します。",
      flowTitle: "実行の前に確かめる",
      flowIntro:
        "管理者が条件を先に決め、実行の直前に照合します。合えば通し、合わなければ止めます。",
      flow: [
        {
          title: "決める",
          detail: "管理者が送金先・変更ルール・任せる範囲と期間を決める。",
        },
        {
          title: "確かめる",
          detail: "実行の直前に、今回の依頼と条件を照合する。",
        },
        {
          title: "通す・止める",
          detail: "合えば実行し、合わなければ止める。結果は記録に残す。",
        },
      ],
      evidenceIntro: "実行前の確認が攻撃を止めるか、公開の実験環境で確かめています。",
      evidenceLink: "実験の条件・結果を見る",
      closeTitle: "導入を相談する",
      closeIntro: "業務の内容を伺い、どの操作にゲートを置くかを一緒に整理します。",
      closeNote: "確認を組み込んだ操作が保護の対象です。",
      technicalTitle: "技術・組み込み情報",
      technicalBody:
        "条件を満たすことの確認に、ゼロ知識証明（ZK）を使います。会社・担当者・今回の依頼を結び付けて確かめる設計です。",
      docs: "組み込みガイドを読む",
      live: "証明データの検証ツール",
      liveNote: "証明データを入力して確かめる、技術者向けのツールも公開しています。",
    }
  : {
      title: "Proof Gate by Lemma — Systems that don't leak | Lemma",
      description:
        "Check transfers, account changes and AI agent actions just before they run. Consult on introducing a system that does not let unauthorized operations through.",
      brand: "Proof Gate by Lemma",
      headline: "Systems that don't leak.",
      intro:
        "Proof Gate checks transfers, account changes and AI agent actions just before they run. Anything outside the approved destination, amount or scope does not go through.",
      scope:
        "Protection covers operations with the check integrated. Unintegrated paths, and misuse inside the approved scope, are out of scope.",
      availability: "Now accepting consultations",
      call: "Discuss your integration",
      learn: "See the three gates",
      gatesTitle: "Three gates",
      gatesIntro: "Place a gate at each risky operation. Start with one, add more where needed.",
      gates: [
        {
          symbol: "¥",
          who: "Finance teams",
          title: "Transfer gate",
          outcome: "Only transfers with approved recipients and amounts go through.",
          support: "Altered transfer orders stop before execution.",
          conditions: ["Recipient", "Amount", "Expiry"],
        },
        {
          symbol: "⇄",
          who: "Finance & vendors",
          title: "Account change gate",
          outcome: "Only verified account changes get registered.",
          support: "Impersonated change requests do not pass.",
          conditions: ["Vendor", "Changes", "Expiry"],
        },
        {
          symbol: "{ }",
          who: "Developers & IT",
          title: "Agent action gate",
          outcome: "Only actions in the delegated scope and period run.",
          support: "Out-of-scope actions stop. No approval per call.",
          conditions: ["Target", "Action", "Period"],
        },
      ],
      gatesNote: "Availability of each gate is confirmed during consultation.",
      flowTitle: "Checked before execution",
      flowIntro:
        "Admins set the conditions first, then each action is matched just before it runs. Matches pass; mismatches stop.",
      flow: [
        {
          title: "Set",
          detail: "Admins set destinations, change rules, and agent scope and period.",
        },
        {
          title: "Check",
          detail: "Each request is matched against the conditions just before execution.",
        },
        {
          title: "Pass or block",
          detail: "Matching requests run; others stop. Every result is recorded.",
        },
      ],
      evidenceIntro: "Public experiments test whether the pre-execution check stops attacks.",
      evidenceLink: "See test conditions and results",
      closeTitle: "Discuss your integration",
      closeIntro: "We will discuss your workflow and decide together where the gates belong.",
      closeNote: "Protection applies to operations with the check in place.",
      technicalTitle: "Technical and integration details",
      technicalBody:
        "The check uses zero-knowledge proofs (ZK). The design ties the organization, the person and this specific request together.",
      docs: "Read the integration guides",
      live: "Proof data verification tool",
      liveNote: "A tool for technical users to submit and verify proof data is also available.",
    };
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <div class="cy-container">
      <section class="cy-hero" aria-labelledby="cy-title">
        <CyberHeroCard />
        <div class="cy-hero-copy">
          <p class="cy-brand">{C.brand}</p>
          <h1 id="cy-title">{C.headline}</h1>
          <p class="cy-intro">{C.intro}</p>
          <p class="cy-scope">{C.scope}</p>
          <div class="cy-actions">
            <a
              class="cy-btn cy-primary"
              href={DISCOVERY_CALL_URL[locale]}
              target="_blank"
              rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
            >
            <a class="cy-btn cy-ghost" href="#pg-gates"
              >{C.learn} <span aria-hidden="true">↓</span></a
            >
          </div>
          <p class="cy-availability">{C.availability}</p>
        </div>
      </section>

      <section id="pg-gates" class="cy-section" aria-labelledby="pg-gates-title">
        <h2 id="pg-gates-title">{C.gatesTitle}</h2>
        <p class="cy-section-intro">{C.gatesIntro}</p>
        <div class="cy-cards">
          {
            C.gates.map((gate, index) => (
              <article class="cy-example-card">
                <span class="cy-use-top">
                  <span>LEMMA / PROOF GATE</span>
                  <span>0{index + 1}</span>
                </span>
                <span class="cy-use-symbol" aria-hidden="true">
                  {gate.symbol}
                </span>
                <p class="cy-use-who">{gate.who}</p>
                <h3>{gate.title}</h3>
                <p class="cy-use-outcome">{gate.outcome}</p>
                <p class="cy-use-description">{gate.support}</p>
                <ul>
                  {gate.conditions.map((condition) => (
                    <li>{condition}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <p class="cy-note">{C.gatesNote}</p>
      </section>

      <section id="pg-flow" class="cy-section" aria-labelledby="pg-flow-title">
        <h2 id="pg-flow-title">{C.flowTitle}</h2>
        <p class="cy-section-intro">{C.flowIntro}</p>
        <ol class="cy-flow" role="list">
          {
            C.flow.map((step, index) => (
              <li class="cy-flow-step">
                <span class="cy-flow-order" aria-hidden="true">
                  0{index + 1}
                </span>
                <h3>{step.title}</h3>
                <p>{step.detail}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="pg-evidence" class="cy-section cy-evidence" aria-labelledby="pg-evidence-title">
        <h2 id="pg-evidence-title" class="cy-sr-only-head">{C.evidenceLink}</h2>
        <p class="cy-section-intro">{C.evidenceIntro}</p>
        <a
          class="cy-source"
          href="https://github.com/lemmaoracle/example-cyber-attack#readme"
          target="_blank"
          rel="noopener">{C.evidenceLink} <span aria-hidden="true">↗</span></a
        >
      </section>

      <section id="cy-start" class="cy-section cy-close" aria-labelledby="cy-close-title">
        <h2 id="cy-close-title">{C.closeTitle}</h2>
        <p class="cy-section-intro">{C.closeIntro}</p>
        <p class="cy-note">{C.closeNote}</p>
        <div class="cy-actions">
          <a
            class="cy-btn cy-primary"
            href={DISCOVERY_CALL_URL[locale]}
            target="_blank"
            rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
          >
        </div>
        <details class="cy-details cy-technical">
          <summary>{C.technicalTitle}<span aria-hidden="true">+</span></summary>
          <div class="cy-details-body">
            <p>{C.technicalBody}</p>
            <a class="cy-source" href={L("/guides/")}>{C.docs} <span aria-hidden="true">↗</span></a>
            <p>{C.liveNote}</p>
            <a class="cy-source" href={L("/verify/")}>{C.live} <span aria-hidden="true">↗</span></a>
          </div>
        </details>
      </section>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cy-page {
    background: #12140e;
    color: #f4f7ef;
    font-family: "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    line-height: 1.85;
    padding-bottom: 100px;
  }
  .cy-page *,
  .cy-page *::before,
  .cy-page *::after {
    box-sizing: border-box;
  }
  .cy-container {
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: 32px;
    text-align: center;
  }
  .cy-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--navh, 74px));
    margin-inline: -32px;
    padding: 112px 32px 128px;
  }
  .cy-hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  /* Local scrim: copy stays primary where the silver card crosses behind the text. */
  .cy-hero-copy::before {
    content: "";
    position: absolute;
    inset: -12px -16px 35%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 62% 65% at 50% 38%,
      #12140ef2 0%,
      #12140eb3 55%,
      transparent 78%
    );
  }
  .cy-brand,
  .cy-hero h1,
  .cy-hero .cy-intro,
  .cy-scope,
  .cy-availability {
    text-shadow:
      0 1px 2px #12140e,
      0 1px 14px #12140ef2,
      0 0 32px #12140eb3;
  }
  .cy-hero .cy-ghost {
    background: #12140ecf;
  }
  .cy-brand {
    margin: 0 0 18px;
    color: #bac1af;
    font:
      12px/1.6 "Space Mono",
      monospace;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .cy-page h1 {
    font-family: "Space Grotesk", "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .cy-page h1,
  .cy-page h2,
  .cy-page h3 {
    line-break: strict;
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .cy-page h2 {
    font-family: "Space Grotesk", "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    font-size: clamp(23px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 30px;
  }
  .cy-sr-only-head {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .cy-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cy-page a {
    color: inherit;
    text-decoration: none;
  }
  .cy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: 999px;
    border: 1px solid #69705c;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
  }
  .cy-page .cy-primary {
    color: #12140e;
    background: #a8e010;
    border-color: #a8e010;
  }
  .cy-ghost {
    background: transparent;
  }
  .cy-page a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cy-page a:focus-visible,
  .cy-details summary:focus-visible {
    outline: 2px solid #c5e987;
    outline-offset: 5px;
  }
  .cy-page .cy-primary:hover {
    background: #b5eb29;
    text-decoration: none;
  }
  .cy-section {
    margin-top: 112px;
    scroll-margin-top: 100px;
  }
  .cy-note {
    max-width: 600px;
    margin: 24px auto 0;
    color: #929c85;
    font-size: 11px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .cy-intro,
  .cy-section-intro {
    max-width: 640px;
    margin: 0 auto 30px;
    color: #bac1af;
    font-size: 14px;
    line-height: 2;
    text-wrap: pretty;
  }
  .cy-availability {
    margin: 18px 0 0;
    color: #929c85;
    font-size: 11px;
  }
  .cy-intro {
    max-width: 600px;
    line-break: strict;
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .cy-scope {
    max-width: 600px;
    margin: 0 auto 30px;
    color: #929c85;
    font-size: 11px;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .cy-use-who {
    margin: 0 0 8px;
    color: #64748b;
    font-size: 10px;
    line-height: 1.7;
  }
  .cy-use-outcome {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .cy-use-description {
    margin: 0 0 18px;
    color: #475569;
    font-size: 11px;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .cy-details {
    max-width: 720px;
    margin: 32px auto 0;
    border-block: 1px solid #3e4435;
    text-align: left;
  }
  .cy-details summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    min-height: 60px;
    padding: 16px 4px;
    cursor: pointer;
    list-style: none;
    color: #bac1af;
    font-size: 13px;
  }
  .cy-details summary::-webkit-details-marker {
    display: none;
  }
  .cy-details summary > span {
    color: #929c85;
    font-size: 22px;
  }
  .cy-details[open] > summary > span {
    transform: rotate(45deg);
  }
  .cy-details-body {
    padding: 12px 4px 28px;
  }
  .cy-technical .cy-details-body {
    max-width: 640px;
    color: #929c85;
    font-size: 12px;
    line-height: 1.9;
  }
  .cy-technical .cy-details-body p {
    margin: 0;
  }
  .cy-technical .cy-details-body p + p,
  .cy-technical .cy-details-body a + p {
    margin-top: 24px;
  }

  .cy-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 38px 0 0;
    padding: 0;
    list-style: none;
  }
  .cy-flow-step {
    min-width: 0;
    padding: 28px 22px;
    border: 1px solid #3e4435;
    border-radius: 12px;
    background: #171a12;
    text-align: left;
  }
  .cy-flow-order {
    display: block;
    margin-bottom: 12px;
    color: #929c85;
    font:
      11px/1.6 "Space Mono",
      monospace;
    letter-spacing: 0.12em;
  }
  .cy-flow-step h3 {
    margin: 0 0 10px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.7;
  }
  .cy-flow-step p {
    margin: 0;
    color: #bac1af;
    font-size: 12px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .cy-evidence {
    border-top: 1px solid #3e4435;
    padding-top: 64px;
  }
  .cy-evidence .cy-section-intro {
    margin-bottom: 8px;
  }
  /* Shared brushed silver surface with fine diagonal grooves. */
  .cy-example-card {
    border: 1px solid #ffffffb3;
    color: #1e293b;
    background:
      repeating-linear-gradient(115deg, #0f172a0d 0 1px, transparent 1px 4px),
      linear-gradient(135deg, #fff, #e2e8f0 48%, #f8fafc 76%, #cbd5e1);
  }
  .cy-source {
    color: #bac1af;
    font-size: 11px;
  }
  .cy-source {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    margin-top: 16px;
  }

  .cy-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin-top: 38px;
  }
  .cy-example-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 28px 20px;
    border-radius: 12px;
  }
  .cy-page .cy-example-card {
    color: #1e293b;
  }
  .cy-use-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin-bottom: 24px;
    color: #64748b;
    font:
      8px/1.5 "Space Mono",
      monospace;
    letter-spacing: 0.08em;
  }
  .cy-use-symbol {
    color: #64748b;
    font:
      500 28px/1.2 "Space Grotesk",
      sans-serif;
    min-height: 35px;
  }
  .cy-example-card h3 {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
    margin: 12px 0 15px;
  }
  .cy-example-card ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
    color: #475569;
    font-size: 11px;
  }
  .cy-example-card li + li::before {
    content: "×";
    color: #94a3b8;
    padding-inline: 7px;
  }
  .cy-close {
    border-top: 1px solid #3e4435;
    padding-top: 64px;
  }
  .cy-close > .cy-actions {
    margin-top: 28px;
  }

  @media (max-width: 600px) {
    .cy-intro,
    .cy-section-intro {
      font-size: 13px;
    }
    .cy-details summary {
      font-size: 12px;
    }

    .cy-container {
      padding-inline: 20px;
    }
    .cy-hero {
      margin-inline: -20px;
      padding: 88px 20px 104px;
    }
    .cy-page h1 {
      font-size: 44px;
    }
    .cy-btn {
      font-size: 12px;
      padding: 12px 20px;
    }
    .cy-section {
      margin-top: 84px;
    }
    .cy-page h2 {
      font-size: 23px;
    }
    .cy-note,
    .cy-scope {
      font-size: 10px;
      text-align: left;
    }
    .cy-flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 15px;
    }
    .cy-flow-step {
      padding: 22px 18px;
    }
    .cy-cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 15px;
    }
    .cy-example-card {
      padding: 25px 20px;
    }
    .cy-example-card h3 {
      font-size: 19px;
      margin-top: 10px;
    }
    .cy-close,
    .cy-evidence {
      padding-top: 46px;
    }
  }
</style>
