              title: "Create and share CSV",
              detail: "Export the selected scope",
              kind: "step",
            },
            {
              actor: "Reviewer checks",
              title: "Review after export",
              detail: "Recheck scope in the activity log",
              kind: "effort",
            },
          ],
          after: [
            {
              actor: "Requester",
              title: "Request a specific scope",
              detail: "Requester, customers and fields",
              kind: "step",
            },
            {
              actor: "Cyber checks automatically",
              title: "Check before export",
              detail: "Permissions, customers and fields",
              kind: "check",
            },
            {
              actor: "Admin system",
              title: "Export matching scope",
              detail: "Create and share the CSV",
              kind: "step",
            },
          ],
          stop: "Different scope → no export",
          savings: [
            {
              task: "Select customers and fields again",
              change: "Carry the requested scope through",
            },
            { task: "Recheck scope after export", change: "Check automatically before export" },
          ],
          boundary:
            "This design adds the check before CSV creation. Post-export audits continue, and other data retrieval paths need the same protection.",
        },
        {
          key: "point-exchange",
          label: "Points redemption",
          mode: "Integrated into your system",
          title: "Check this redemption before issuing the voucher.",
          description: "Members exchange their earned points for vouchers or similar rewards.",
          before: [
            {
