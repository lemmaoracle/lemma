  /* Quiet platinum: broad reflections, a fine machined edge, no masked content. */
  .cy-plate-stage {
    position: relative;
    min-width: 0;
    isolation: isolate;
    padding-top: 12px;
  }
  .cy-plate-stage::before {
    content: "";
    position: absolute;
    inset: 18% 0 12%;
    z-index: -1;
    background: radial-gradient(ellipse, #cdd6b61c, transparent 66%);
    filter: blur(30px);
    pointer-events: none;
  }
  .cy-plate {
    position: relative;
    overflow: hidden;
    padding: 30px 32px 0;
    border: 1px solid #eef0e5a6;
    border-radius: 18px;
    color: #2d342c;
    text-align: left;
    background: linear-gradient(
      118deg,
      #f4f3ed 0%,
      #dcdfd7 23%,
      #f7f7f0 49%,
      #e5e7df 74%,
      #cdd2c8 100%
    );
    box-shadow:
      inset 0 1px 0 #fff,
      inset 1px 0 0 #ffffff85,
      inset -1px 0 0 #4b564322,
      0 2px 0 #89917e,
      0 5px 0 -2px #3e4934,
      0 28px 60px -18px #0009;
    transform: perspective(1400px) rotateY(-5deg) rotateX(2deg) rotateZ(-1deg);
  }
  .cy-plate::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent 0 3px, #34412804 3px 4px);
    pointer-events: none;
  }
  .cy-card-top,
  .cy-card-heading,
  .cy-card-body,
  .cy-card-binding,
  .cy-card-result {
