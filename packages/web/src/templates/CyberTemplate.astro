          work: "Vendor bank account changes handled by finance teams.",
          threat: "Impersonated bank account change requests",
          conditions:
            "The verified vendor, change details and expiry. The business must establish how to verify the vendor and contact, and the basis for that verification.",
          pass: "A registration request for the verified vendor, matching the verified change details and within the expiry.",
          block:
            "The vendor name is the same, but the request registers an account different from the verified change. The design stops it immediately before registration because the change details do not match.",
          limit:
            "A sender or company name alone does not establish identity. Incorrect source verification and direct updates through other paths are outside protection.",
          status: "In design. Availability will be discussed during consultation.",
        },
        {
          symbol: "{ }",
          title: "Agent action gate",
          stage: "Internal trial (not deployed in business operations)",
          stageKind: "trial",
          work: "Actions delegated to agents by developers and IT teams, such as access to specified documents for a specified period.",
          threat: "Out-of-scope agent actions and data leakage",
          conditions:
            "An administrator delegates targets, permitted actions and a validity period in advance. The design checks each action against that delegation without human approval for every action.",
          pass: "A request to read a delegated document within the validity period. The design allows a matching action without human approval for each request.",
          block:
            "Access to an out-of-scope document, an external send that was not delegated, or an expired action. The design stops it immediately before the integrated operation because the target, action or period does not match.",
          limit:
            "Misuse within the delegated scope and tools or execution paths without the check are outside protection. This check alone does not control subsequent use of information that was permitted to be read.",
          status:
            "Tested internally by appending a test memo in a local environment; not deployed in business operations. Examples of document access and sending data externally illustrate the design. Availability will be discussed during consultation.",
        },
      ],
      gatesNote: "Availability of each gate will be discussed during consultation.",
      evidenceLink: "See the current evidence and its limits",
      evidenceTitle: "Current evidence and design status",
      evidenceIntro:
        "Here are results reported in a public experiment and an internal trial of the agent action gate. Each covers the operations, environment and conditions described below.",
      evidenceLabels: {
        operation: "Operation",
        conditions: "Conditions",
        records: "Observed outcomes",
        scope: "Scope",
        status: "Current status",
      },
      attackLabels: ["Attack pattern", "Without the gate", "With the gate", "Scope of the result"],
      evidence: [
        {
          title: "Public experiment | An intentionally vulnerable demo application",
          operation:
            "The public experiment compares five attack scenarios involving access to sensitive information, altered records, and transfer and approval workflows.",
          conditions:
            "It compares operations with and without a check immediately before information is retrieved or changed.",
          scope:
            "Results cover only the demo operations with checks in place, under limited tools and attempts. They are not independently reproducible and do not establish prevention rates in business operations or resistance to unrestricted attacks.",
          status:
            "This is a reported proof of concept for stopping an action before it runs. It is not product validation of the three new transfer, account change and agent action gates.",
          note: "The README below is the source for this public experiment, separate from the internal trial. Detailed conditions are in “Technical and integration details” at the end of this page.",
          records: [
            "The README reports that attacks got through without the gate and stopped with the gate in all five scenarios with Opus 4.8 as the attacker. Two examples follow.",
          ],
          link: "See test conditions and results",
          patterns: [
            [
              "Access sensitive information beyond the permitted scope",
              "Full US Social Security numbers were retrieved.",
              "No numbers were returned without evidence of permission.",
              "Access to sensitive information with checks in place in the demo.",
            ],
            [
              "Bypass the transfer approval workflow",
              "An action bypassing approval reached execution.",
              "Evidence of approval was required and the action stopped.",
              "Transfer and approval operations in the demo. This is not product validation of the new transfer gate.",
            ],
          ],
          kind: "public",
        },
        {
          title: "Internal trial | Adding a test memo through the agent action gate",
          operation:
            "A test memo was added on an internal development computer, manually from the test screen, as a request for an action delegated to an agent.",
          conditions:
            "The permissions set in advance were linked to the current request and checked before the action ran.",
          scope:
            "Only adding this test memo was tried. Transfers, account changes and external actions were outside the trial. It does not establish data-loss prevention in business operations or protection for paths without checks or misuse within permitted conditions.",
          status:
            "The agent action gate is in internal testing and is not deployed in business operations. Human trials and a release decision are still pending. Transfer and account change gates are in design.",
          note: "This internal record is separate from the public experiment. Its details are in “Technical and integration details” at the end of this page; consultation topics are below.",
          records: [
            "A request meeting the conditions went through and added a memo.",
            "Attempts to reuse the same request, omit or incorrectly format the information needed for the check, or alter the request stopped without adding another memo.",
          ],
          link: "See what an integration consultation covers",
          patterns: [],
          kind: "internal",
        },
      ],
      closeTitle: "Start with the operation you want to protect.",
      consultItems: [
        {
          title: "Target operation",
          detail: "Identify the workflow and operation.",
        },
        {
          title: "Conditions",
          detail: "Discuss who sets the conditions and where execution takes place.",
        },
        {
          title: "Integration point",
          detail:
            "Review potential gate placement, paths outside protection, and integration feasibility.",
        },
      ],
      technicalTitle: "Technical and integration details",
      technicalBody:
        "In the internal agent trial, zero-knowledge proofs (ZK) bind the permitted scope, delegation and current request. Cryptography alone does not verify a real organization or person, or establish that the inputs are true. The business must verify identities and the basis for its conditions.",
      technicalEvidence: [
        {
          title: "Public experiment: conditions and verdicts",
          paragraphs: [
            "The five scenarios cover sensitive data retrieval and decryption, audit log changes, and transfer and approval workflows. Gates at known enforcement points in the intentionally vulnerable demo require proof on every mutation and sensitive-read path across all five scenarios. Audit log changes and recommits also use requireZkProof.",
            "The attacker uses http_request, with run_shell added only for the RCE (remote code execution) scenario. The limit is 15 turns.",
            "The README reports INSECURE=attack_succeeded and SECURE=blocked for all five scenarios with Opus 4.8 as the attacker. In the privilege-escalation example, full SSNs (US Social Security numbers) were retrieved without the gate; with the gate, no SSN data was returned without proof. The approval-flow bypass reached execution without the gate; with the gate, approval proof was required and the attack was blocked.",
            "Verdicts use regex matching against response content, rather than a rigorous evaluation method. Fable 5's refusals to explore attacks are model refusals and do not count as defense successes. Separate API-operation probes are also distinct from these results.",
            "The README states that results are not independently reproducible because model APIs change and generation settings were not fixed. This is a proof of concept, not a scientific benchmark. It does not evaluate defense in depth or resistance to attackers with unrestricted tools and time.",
          ],
        },
        {
          title: "Internal trial: conditions and records",
          paragraphs: [
            "Requests under a delegated agent identity were executed manually from the trial console on a single-machine development setup. Local Workerd and D1 were used to generate and verify a real Groth16 proof bound to the permitted scope, prior delegation and current request. The only operation was appending a test memo to D1 through sandbox_memo / sandbox:memos / append.",
            "Challenge issuance returned HTTP 201; execution after real proof generation returned HTTP 200 (verified). In D1, memo, nullifier (replay-prevention record) and consume (consumed-challenge) counts each increased by +1.",
            "Replay returned 409; missing-proof returned 403; invalid-shape returned 403; and changed-bytes returned 400. These attempts, made after the successful execution, caused no further increase in memos, replay-prevention records or consumed challenges.",
            "The invalid-shape case tested an incorrect proof format, not every kind of invalid proof. These records are not performance measurements or test-suite pass counts, and do not cover document access or sending data externally.",
            "Production cryptographic setup (trusted setup) and human trials have not been carried out, and no release decision has been made. The gate is not deployed in business operations; transfer and account change gates are in design. The public experiment's README is not a source for this internal trial.",
          ],
        },
      ],
      docs: "Read the integration guides",
      live: "Open the public registration and proof checker",
      liveNote:
        "Use a reference code (docHash) to look up a public registration and the latest proof linked to it. The retrieved proof data is verified through the public API. The conditions checked depend on the proof type. This page does not check the document text, establish the sender's identity or authorize a business action. Verifying proof data is separate from stopping an action on a business system's execution path. Records from the internal agent trial are not available through this page.",
    } as const);
const gateFields = ["work", "threat", "conditions", "pass", "block", "limit", "status"] as const;
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <div class="cy-container">
      <section class="cy-hero" aria-labelledby="cy-title">
        <CyberHeroCard />
        <div class="cy-hero-copy">
          <p class="cy-brand">{C.brand}</p>
          <h1 id="cy-title">{C.headline}</h1>
          <p class="cy-intro">{C.intro}</p>
          <p class="cy-scope">{C.scope}</p>
          <div class="cy-actions">
            <a
              class="cy-btn cy-primary"
              href={DISCOVERY_CALL_URL[locale]}
              target="_blank"
              rel="noopener"
            >
              {C.call}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="cy-btn cy-ghost" href="#pg-flow">
              {C.learn}
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="cy-availability"><span>{C.availability}</span> <span>{C.gatesNote}</span></p>
        </div>
      </section>

      <section id="pg-flow" class="cy-section" aria-labelledby="pg-flow-title">
        <h2 id="pg-flow-title">{C.flowTitle}</h2>
        <p class="cy-section-intro">{C.flowIntro}</p>
        <p class="cy-section-intro">{C.flowBinding}</p>
        <figure class="cy-flow-figure">
          <p class="cy-scenario-label">{C.flowScenario}</p>
          <div class="cy-flow">
            <div class="cy-flow-inputs">
              {
                C.flowInputs.map((input) => (
                  <div class="cy-flow-node">
                    <strong>{input.title}</strong>
                    <p>{input.detail}</p>
                  </div>
                ))
              }
            </div>
            <div class="cy-flow-node cy-flow-gate">
              <strong>Proof Gate</strong>
              <p>{C.flowCheck}</p>
              <p class="cy-flow-position">{C.flowPosition}</p>
            </div>
            <div class="cy-flow-results">
              {
                C.flowResults.map((result) => (
                  <div class="cy-flow-node">
                    <strong>{result.title}</strong>
                    <p>{result.condition}</p>
                    <p>{result.detail}</p>
                  </div>
                ))
              }
            </div>
            <div class="cy-flow-node cy-flow-record">
              <strong>{C.flowRecord}</strong>
              <p>{C.flowRecordDetail}</p>
            </div>
          </div>
          <figcaption class="cy-boundary">{C.scope}</figcaption>
        </figure>
        <p class="cy-section-intro">{C.flowPremise}</p>
        <div class="cy-scenarios">
          {
            C.flowExamples.map((example) => (
              <article class="cy-scenario">
                <p class="cy-scenario-label">{C.flowScenario}</p>
                <h3>{example.title}</h3>
                <dl class="cy-facts">
                  {example.details.map((detail, index) => (
                    <div>
                      <dt>{C.flowExampleLabels[index]}</dt>
                      <dd>{detail}</dd>
                    </div>
                  ))}
                </dl>
              </article>
            ))
          }
        </div>
        <p class="cy-boundary">{C.flowLimit}</p>
        <a class="cy-source" href="#pg-gates">{C.gatesLink} <span aria-hidden="true">↓</span></a>
      </section>

      <section id="pg-gates" class="cy-section" aria-labelledby="pg-gates-title">
        <h2 id="pg-gates-title">{C.gatesTitle}</h2>
        <p class="cy-section-intro">{C.gatesIntro}</p>
        <div class="cy-cards">
          {
            C.gates.map((gate) => (
              <article class="cy-example-card">
                <span class="cy-use-top">LEMMA / PROOF GATE</span>
                <span class="cy-use-symbol" aria-hidden="true">
                  {gate.symbol}
                </span>
                <h3>{gate.title}</h3>
                <p class:list={["cy-stage", { "cy-stage-trial": gate.stageKind === "trial" }]}>
                  {gate.stage}
                </p>
                <p class="cy-scenario-label">{C.scenario}</p>
                <dl class="cy-facts">
                  {gateFields.map((field) => (
                    <div>
                      <dt>{C.gateLabels[field]}</dt>
                      <dd>{gate[field]}</dd>
                    </div>
                  ))}
                </dl>
                {gate.stageKind === "trial" && (
                  <a class="cy-source" href="#pg-evidence">
                    {C.evidenceLink} <span aria-hidden="true">↓</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <p class="cy-note">{C.gatesNote}</p>
      </section>

      <section id="pg-evidence" class="cy-section cy-evidence" aria-labelledby="pg-evidence-title">
        <h2 id="pg-evidence-title">{C.evidenceTitle}</h2>
        <p class="cy-section-intro">{C.evidenceIntro}</p>
        <div class="cy-evidence-blocks">
          {
            C.evidence.map((evidence) => (
              <article class="cy-evidence-card">
                <h3>{evidence.title}</h3>
                <dl class="cy-facts cy-evidence-facts">
                  <div>
                    <dt>{C.evidenceLabels.operation}</dt>
                    <dd>{evidence.operation}</dd>
                  </div>
                  <div>
                    <dt>{C.evidenceLabels.conditions}</dt>
                    <dd>{evidence.conditions}</dd>
                  </div>
                  <div>
                    <dt>{C.evidenceLabels.records}</dt>
                    <dd>
                      {evidence.records.map((record) => (
                        <p>{record}</p>
                      ))}
                      {evidence.patterns.length > 0 && (
                        <ul class="cy-attack-patterns" role="list">
                          {evidence.patterns.map((pattern) => (
                            <li>
                              <h4>
                                <span>{C.attackLabels[0]}</span>
                                {pattern[0]}
                              </h4>
                              <dl class="cy-attack-results">
                                {pattern.slice(1).map((result, index) => (
                                  <div>
                                    <dt>{C.attackLabels[index + 1]}</dt>
                                    <dd>{result}</dd>
                                  </div>
                                ))}
                              </dl>
                            </li>
                          ))}
                        </ul>
                      )}
                    </dd>
                  </div>
                  <div>
                    <dt>{C.evidenceLabels.scope}</dt>
                    <dd>{evidence.scope}</dd>
                  </div>
                  <div>
                    <dt>{C.evidenceLabels.status}</dt>
                    <dd>{evidence.status}</dd>
                  </div>
                </dl>
                <p class="cy-evidence-note">{evidence.note}</p>
                <a
                  class="cy-source"
                  href={
                    evidence.kind === "public"
                      ? "https://github.com/lemmaoracle/example-cyber-attack#readme"
                      : "#cy-start"
                  }
                  target={evidence.kind === "public" ? "_blank" : undefined}
                  rel={evidence.kind === "public" ? "noopener" : undefined}
                >
                  {evidence.link}{" "}
                  <span aria-hidden="true">{evidence.kind === "public" ? "↗" : "↓"}</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section id="cy-start" class="cy-section cy-close" aria-labelledby="cy-close-title">
        <h2 id="cy-close-title">{C.closeTitle}</h2>
        <dl class="cy-consult-items">
          {
            C.consultItems.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="cy-note">{C.gatesNote}</p>
        <p class="cy-scope">{C.scope}</p>
        <div class="cy-actions">
          <a
            class="cy-btn cy-primary"
            href={DISCOVERY_CALL_URL[locale]}
            target="_blank"
            rel="noopener"
          >
            {C.call}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <h2 id="cy-technical-title" class="cy-details-heading">{C.technicalTitle}</h2>
      <details class="cy-details cy-technical" aria-labelledby="cy-technical-title">
        <summary>{C.technicalTitle}<span aria-hidden="true">+</span></summary>
        <div class="cy-details-body">
          <p>{C.technicalBody}</p>
          {
            C.technicalEvidence.map((detail) => (
              <div>
                <h3>{detail.title}</h3>
                {detail.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            ))
          }
          <a class="cy-source" href={L("/guides/")}>{C.docs} <span aria-hidden="true">↗</span></a>
          <p>{C.liveNote}</p>
          <a class="cy-source" href={L("/verify/")}>{C.live} <span aria-hidden="true">↗</span></a>
        </div>
      </details>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cy-page {
    background: #12140e;
    color: #f4f7ef;
    font-family: "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    line-height: 1.85;
    padding-bottom: 100px;
  }
  .cy-page *,
  .cy-page *::before,
  .cy-page *::after {
    box-sizing: border-box;
  }
  .cy-container {
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: 32px;
    text-align: center;
  }
  .cy-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--navh, 74px));
    margin-inline: -32px;
    padding: 112px 32px 128px;
  }
  .cy-hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  /* Local scrim: copy stays primary where the silver card crosses behind the text. */
  .cy-hero-copy::before {
    content: "";
    position: absolute;
    inset: -12px -16px 35%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 62% 65% at 50% 38%,
      #12140ef2 0%,
      #12140eb3 55%,
      transparent 78%
    );
  }
  .cy-brand,
  .cy-hero h1,
  .cy-hero .cy-intro,
  .cy-scope,
  .cy-availability {
    text-shadow:
      0 1px 2px #12140e,
      0 1px 14px #12140ef2,
      0 0 32px #12140eb3;
  }
  .cy-hero .cy-ghost {
    background: #12140ecf;
  }
  .cy-brand {
    margin: 0 0 18px;
    color: #bac1af;
    font:
      12px/1.6 "Space Mono",
      monospace;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .cy-page h1 {
    font-family: "Space Grotesk", "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .cy-page h1,
  .cy-page h2,
  .cy-page h3 {
    line-break: strict;
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .cy-page h2 {
    font-family: "Space Grotesk", "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    font-size: clamp(23px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 30px;
  }
  .cy-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cy-page a {
    color: inherit;
    text-decoration: none;
  }
  .cy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: 999px;
    border: 1px solid #69705c;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
  }
  .cy-page .cy-primary {
    color: #12140e;
    background: #a8e010;
    border-color: #a8e010;
  }
  .cy-ghost {
    background: transparent;
  }
  .cy-page a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cy-page a:focus-visible,
  .cy-details summary:focus-visible {
    outline: 2px solid #f8fafc;
    outline-offset: 5px;
  }
  .cy-page .cy-primary:hover {
    box-shadow: 0 0 0 3px #a8e01033;
    text-decoration: none;
  }
  .cy-section {
    margin-top: 112px;
    scroll-margin-top: 100px;
  }
  .cy-intro,
  .cy-section-intro,
  .cy-boundary {
    max-width: 640px;
    margin: 0 auto 30px;
    color: #bac1af;
    font-size: 14px;
    line-height: 2;
    text-wrap: pretty;
  }
  .cy-intro {
    max-width: 600px;
    line-break: strict;
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .cy-note,
  .cy-scope,
  .cy-availability {
    max-width: 640px;
    margin: 24px auto 0;
    color: #bac1af;
    font-size: 14px;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .cy-scope {
    margin: 0 auto 30px;
  }
  @media (min-width: 601px) {
    .cy-hero .cy-scope {
      line-break: strict;
      word-break: auto-phrase;
      text-wrap: balance;
    }
  }
  .cy-availability span {
    display: block;
  }
  .cy-page p,
  .cy-page dd,
  .cy-page a,
  .cy-page h3,
  .cy-page h4 {
    overflow-wrap: anywhere;
  }
  .cy-page h3 {
    margin: 0 0 16px;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.6;
  }
  .cy-page dl,
  .cy-page dd {
    margin: 0;
  }
  .cy-page dt {
    font-weight: 600;
  }
  .cy-facts {
    text-align: left;
    font-size: 14px;
    line-height: 1.9;
  }
  .cy-facts > div + div {
    margin-top: 22px;
  }
  .cy-facts dt {
    margin-bottom: 6px;
  }
  .cy-facts dd {
    color: #bac1af;
  }
  .cy-facts p {
    margin: 0;
  }
  .cy-facts p + p {
    margin-top: 16px;
  }
  .cy-flow-figure {
    margin: 38px 0 0;
  }
  .cy-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 36px;
    text-align: left;
  }
  .cy-flow-node {
    position: relative;
    min-width: 0;
    padding: 22px 18px;
    border: 1px solid #69705c;
    border-radius: 12px;
    background: #171a12;
    font-size: 14px;
    line-height: 1.9;
  }
  .cy-flow-node strong {
    display: block;
    font-weight: 500;
  }
  .cy-flow-node p {
    margin: 8px 0 0;
    color: #bac1af;
  }
  .cy-flow-inputs,
  .cy-flow-results {
    position: relative;
    display: grid;
    gap: 22px;
    min-width: 0;
  }
  .cy-flow-inputs::before,
  .cy-flow-results::before {
    content: "";
    position: absolute;
    top: 25%;
    bottom: 25%;
    width: 18px;
    border-block: 1px solid #929c85;
  }
  .cy-flow-inputs::before {
    right: -18px;
    border-right: 1px solid #929c85;
  }
  .cy-flow-results::before {
    left: -18px;
    border-left: 1px solid #929c85;
  }
  .cy-flow-inputs::after,
  .cy-flow-results::after,
  .cy-flow-record::before {
    position: absolute;
    color: #bac1af;
    font-size: 20px;
    line-height: 1;
    text-align: center;
  }
  .cy-flow-inputs::after,
  .cy-flow-results::after {
    content: "→" / "";
    top: calc(50% - 10px);
    width: 18px;
  }
  .cy-flow-inputs::after {
    right: -36px;
  }
