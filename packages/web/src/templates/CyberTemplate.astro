<script>
  (() => {
    const sec = document.querySelector<HTMLElement>(".cy-bird-sec");
    if (!sec) return;

    const modeBtns = Array.from(sec.querySelectorAll<HTMLButtonElement>("[data-set-bird-mode]"));
    const stepBtns = Array.from(sec.querySelectorAll<HTMLButtonElement>("[data-bird-step-btn]"));
    let currentStep = 0;

    const applyStep = (step: number) => {
      currentStep = step;
      sec.setAttribute("data-bird-step", String(step));
      stepBtns.forEach((btn, idx) => {
        btn.classList.toggle("is-current", idx === step);
      });
    };

    let timer = window.setInterval(() => {
      applyStep((currentStep + 1) % 4);
    }, 1400);

    const restartTimer = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        applyStep((currentStep + 1) % 4);
      }, 1400);
    };

    stepBtns.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        applyStep(idx);
        restartTimer();
      });
    });

    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-set-bird-mode") || "attack";
        sec.setAttribute("data-bird-mode", mode);
        modeBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-selected", active ? "true" : "false");
        });
        applyStep(0);
        restartTimer();
      });
    });
  })();
</script>

