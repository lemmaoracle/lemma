        { without: "不正送金が実行（攻撃成功）", with: "0件（送金を止め経理の確認へ）" },
        { without: "承認の迂回が成立（攻撃成功）", with: "0件（承認の迂回を止め確認へ）" },
      ]
    : [
        { without: "Sensitive data exfiltrated (Succeeded)", with: "0 succeeded (Blocked without proof)" },
        { without: "Audit records rewritten (Succeeded)", with: "0 succeeded (Record change stopped)" },
        { without: "Encrypted data decrypted (Succeeded)", with: "0 succeeded (Decryption stopped)" },
        { without: "Unauthorized payout executed (Succeeded)", with: "0 succeeded (Payout held for review)" },
        { without: "Approval bypassed (Succeeded)", with: "0 succeeded (Bypass blocked)" },
      ]
) as ReadonlyArray<{ without: string; with: string }>;
const whitepaperUrl = "https://tally.so/r/xX0VYv";
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <!-- =====================================================================
         CHAPTER 1A: HERO (Pale Stone Canvas #eef1eb + Execution Monitor)
         ===================================================================== -->
    <section class="cy-hero-sec" aria-labelledby="cy-title">
      <div class="cy-container cy-hero-grid">
        <div class="cy-hero-copy">
          <span class="cy-hero-badge">{C.badge}</span>
          <h1 id="cy-title" class="cy-hero-h1">{C.headline}</h1>
          <p class="cy-hero-lead">{C.intro}</p>
          <div class="cy-hero-btns">
            <a
              class="cy-btn cy-btn-lime"
              data-cy-ev="cy_hero_consult"
              href={DISCOVERY_CALL_URL[locale]}
              target="_blank"
              rel="noopener"
            >
              {C.call} <span aria-hidden="true">↗</span>
            </a>
            <a class="cy-btn cy-btn-outline-dark" data-cy-ev="cy_hero_fact" href="#fact">
              {C.factBtn}
            </a>
          </div>
        </div>

        <div class="cy-hero-visual-col">
          <div class="cy-gate-card" role="img" aria-label={C.gateLabel}>
            <div class="cy-gate-head">
              <div class="cy-gate-dots" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <span class="cy-gate-title">{C.gateTitle}</span>
              <span class="cy-gate-live">{C.gateSample}</span>
            </div>
            <ul class="cy-gate-list">
              {
                C.gateRows.map((row) => (
                  <li class={row.held ? "cy-gate-row is-held" : "cy-gate-row is-ok"}>
                    <span class="cy-gate-indicator" aria-hidden="true" />
                    <div class="cy-gate-main">
                      <strong>{row.op}</strong>
                      <small>{`${C.gateCheck}${isJa ? "：" : ": "}${row.check}`}</small>
                    </div>
                    <span class="cy-gate-pill">{row.status}</span>
                  </li>
                ))
              }
            </ul>
            <div class="cy-gate-foot">
              <span>{C.gateNote}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CHAPTER 1B: INTRO — ARCHITECTURAL BLUEPRINT & INTERCEPT PIPELINE
         Benchmarks: Vercel Security / Geist (1px Blueprint Grid + Crosshairs)
                     & Stripe Radar (Live Intercept Pipeline Diagram)
         Full-Bleed Deep Obsidian (#121611) + 28px Engineering Grid
         ===================================================================== -->
    <section class="cy-arch-sec" aria-labelledby="cy-intro-title">
      <div class="cy-arch-pgrid" aria-hidden="true"></div>
      <div class="cy-container">
        <div class="cy-arch-frame">
          <!-- Corner Crosshairs (+) -->
          <span class="cy-crosshair is-tl" aria-hidden="true">+</span>
          <span class="cy-crosshair is-tr" aria-hidden="true">+</span>
          <span class="cy-crosshair is-bl" aria-hidden="true">+</span>
          <span class="cy-crosshair is-br" aria-hidden="true">+</span>

          <!-- Upper Split: Editorial Manifesto (Left) + Intercept Pipeline Schematic (Right) -->
          <div class="cy-arch-upper">
            <div class="cy-arch-editorial">
              <div class="cy-arch-eyebrow">
                <span class="cy-arch-pulse" aria-hidden="true"></span>
                <span>{C.introEyebrow}</span>
              </div>
              <h2 id="cy-intro-title" class="cy-arch-h2">{C.introTitle}</h2>
              <p class="cy-arch-lead">{C.introLead}</p>

              <ul class="cy-arch-tags" aria-label={isJa ? "アーキテクチャの要点" : "Key architecture traits"}>
                {
                  C.introTags.map((tag) => (
                    <li>
                      <span class="cy-arch-tag-check" aria-hidden="true">✓</span>
                      <span>{tag}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <!-- Right: Stripe Radar-style Live Intercept Pipeline Schematic -->
            <div class="cy-arch-diagram" aria-hidden="true">
              <div class="cy-pipe-head">
                <span class="cy-pipe-title">{C.archDiagram.headerTitle}</span>
                <span class="cy-pipe-sub">{C.archDiagram.headerSub}</span>
              </div>

              <div class="cy-pipe-body">
                <!-- Zone 1: Internal Perimeter (Raw Secrets Stay Local) -->
                <div class="cy-pipe-zone is-perimeter">
                  <div class="cy-pipe-zone-top">
                    <span class="cy-pipe-ztag">{C.archDiagram.zone1Tag}</span>
                    <span class="cy-pipe-zbadge">{C.archDiagram.zone1Badge}</span>
                  </div>
                  <div class="cy-pipe-ztitle">{C.archDiagram.zone1Title}</div>
                  <div class="cy-pipe-chips">
                    {C.archDiagram.zone1Items.map((it) => <span class="cy-pipe-chip">{it}</span>)}
                  </div>
                </div>

                <!-- Connector 1: Emits ZKP Proof Packet Only -->
                <div class="cy-pipe-connector">
                  <span class="cy-pipe-line"></span>
                  <span class="cy-pipe-packet">{C.archDiagram.proofPacket}</span>
                  <span class="cy-pipe-arrow">▼</span>
                </div>

                <!-- Zone 2: ProofGate Execution Gate (ZKP x Blockchain) -->
                <div class="cy-pipe-zone is-gate">
                  <div class="cy-pipe-zone-top">
                    <span class="cy-pipe-ztag is-lime">{C.archDiagram.zone2Tag}</span>
                    <strong class="cy-pipe-gname">{C.archDiagram.zone2Title}</strong>
                  </div>
                  <div class="cy-pipe-dual">
                    <div class="cy-pipe-engine">
                      <div class="cy-pipe-engine-top">
                        <span class="cy-pipe-etag">ZKP</span>
                        <strong>{C.archDiagram.zone2Step1Title}</strong>
                      </div>
                      <p>{C.archDiagram.zone2Step1Desc}</p>
                    </div>
                    <div class="cy-pipe-engine">
                      <div class="cy-pipe-engine-top">
                        <span class="cy-pipe-etag">CHAIN</span>
                        <strong>{C.archDiagram.zone2Step2Title}</strong>
                      </div>
                      <p>{C.archDiagram.zone2Step2Desc}</p>
                    </div>
                  </div>
                </div>

                <!-- Connector 2: Bifurcated Decision -->
                <div class="cy-pipe-connector is-split">
                  <span class="cy-pipe-ztag">{C.archDiagram.zone3Tag}</span>
                </div>

                <!-- Zone 3: Bifurcated Gate Decision (Pass vs Hold) -->
                <div class="cy-pipe-outcomes">
                  <div class="cy-pipe-out is-pass">
                    <span class="cy-pipe-out-label">
                      <i class="dot-pass"></i> {C.archDiagram.outPassLabel}
                    </span>
                    <strong>{C.archDiagram.outPassTitle}</strong>
                  </div>
                  <div class="cy-pipe-out is-hold">
                    <span class="cy-pipe-out-label">
                      <i class="dot-hold"></i> {C.archDiagram.outHoldLabel}
                    </span>
                    <strong>{C.archDiagram.outHoldTitle}</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Lower 3-Column Spec Matrix (Vercel Geist 1px Structural Grid) -->
          <div class="cy-arch-specs">
            {
              C.introCards.map((card) => (
                <article class="cy-spec-cell">
                  <div class="cy-spec-head">
                    <span class="cy-spec-num">{card.num}</span>
                    <span class="cy-spec-code">{card.code}</span>
                  </div>
                  <h3 class="cy-spec-title">{card.title}</h3>
                  <p class="cy-spec-body">{card.body}</p>
                  <div class="cy-spec-foot" aria-hidden="true">
                    <code>{card.spec}</code>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CHAPTER 2: FEATURES (Deep Charcoal Stage #191d17 with 3 Crisp White Cards)
         White Outer Canvas -> Charcoal Rounded Stage -> 3 Crisp White Cards + UI Mocks
         ===================================================================== -->
    <section class="cy-features-outer" aria-labelledby="cy-features-title">
      <div class="cy-container">
        <div class="cy-features-stage">
          <div class="cy-features-header">
            <h2 id="cy-features-title">{C.featuresTitle}</h2>
            <p>{C.featuresIntro}</p>
          </div>

          <div class="cy-features-grid">
            <!-- Card 1: Stop AI -->
            <article class="cy-fcard">
              <div class="cy-fcard-top">
                <span class="cy-fcard-step">01 / AI AGENT GATE</span>
                <h3>{C.features[0]!.title}</h3>
                <p class="cy-fcard-sub">{C.features[0]!.subtitle}</p>
                <p class="cy-fcard-desc">{C.features[0]!.description}</p>
                <a
                  class="cy-fcard-link"
                  data-cy-ev="cy_feat_verify"
                  href={L(`/cyber/verify/?card=${C.features[0]!.key}`)}
                >
                  {C.features[0]!.linkText} <span aria-hidden="true">→</span>
                </a>
              </div>

              <!-- Light UI Mock inside White Card 1 -->
              <div class="cy-fcard-mock" aria-hidden="true">
                <div class="cy-ui-split">
                  <div class="cy-ui-mini">
                    <div class="cy-ui-mini-head">
                      <strong>read_only</strong>
                      <span class="cy-ui-ico-ok">✓</span>
                    </div>
                    <span>{isJa ? "委任された権限の範囲" : "Delegated scope"}</span>
                  </div>
                  <div class="cy-ui-mini">
                    <div class="cy-ui-mini-head">
                      <strong class="is-danger">403</strong>
                      <span class="cy-ui-ico-warn">!</span>
                    </div>
                    <span>{isJa ? "範囲外の出力を自動保留" : "Out-of-scope blocked"}</span>
                  </div>
                </div>
                <div class="cy-ui-box">
                  <div class="cy-ui-table-head">
                    <span>AI TOOL CALL</span>
                    <span>SCOPE</span>
                    <span>STATUS</span>
                  </div>
                  <div class="cy-ui-table-row">
                    <span class="cy-ui-agent">
                      <i class="dot-ok"></i> summary.create
                    </span>
                    <code>read</code>
                    <span class="badge-ok">{isJa ? "実行" : "Run"}</span>
                  </div>
                  <div class="cy-ui-table-row">
                    <span class="cy-ui-agent">
                      <i class="dot-err"></i> db.export_all
                    </span>
                    <code>admin</code>
                    <span class="badge-err">{isJa ? "確認へ" : "Held"}</span>
                  </div>
                </div>
              </div>
            </article>

            <!-- Card 2: Stop Transfers -->
            <article class="cy-fcard">
              <div class="cy-fcard-top">
                <span class="cy-fcard-step">02 / TRANSFER GATE</span>
                <h3>{C.features[1]!.title}</h3>
                <p class="cy-fcard-sub">{C.features[1]!.subtitle}</p>
                <p class="cy-fcard-desc">{C.features[1]!.description}</p>
                <a
                  class="cy-fcard-link"
                  data-cy-ev="cy_feat_verify"
                  href={L(`/cyber/verify/?card=${C.features[1]!.key}`)}
                >
                  {C.features[1]!.linkText} <span aria-hidden="true">→</span>
                </a>
              </div>

              <!-- Light UI Mock inside White Card 2 -->
              <div class="cy-fcard-mock" aria-hidden="true">
                <div class="cy-ui-box">
                  <div class="cy-ui-alert-line">
                    <span class="cy-ui-warn-triangle">▲</span>
                    <strong>{isJa ? "振込先口座の照合結果" : "Recipient account check"}</strong>
                  </div>
                  <div class="cy-ui-stat3">
                    <div>
                      <small>{isJa ? "登録口座一致" : "Matched"}</small>
                      <strong>148</strong>
                    </div>
                    <div>
                      <small>{isJa ? "新規取引先" : "New"}</small>
                      <strong>3</strong>
                    </div>
                    <div>
                      <small>{isJa ? "口座不一致" : "Mismatch"}</small>
                      <strong class="is-danger">1</strong>
                    </div>
                  </div>
                </div>
                <div class="cy-ui-box">
                  <div class="cy-ui-bar-head">
                    <strong>¥12,800,000</strong>
                    <span class="badge-err">{isJa ? "経理の確認へ" : "To Accounting"}</span>
                  </div>
                  <p class="cy-ui-bar-sub">
                    {isJa ? "請求口座 ****-9901（取引先マスター未登録）" : "Account ****-9901 (Unregistered in master)"}
                  </p>
                  <div class="cy-ui-meter">
                    <span class="m-green"></span>
                    <span class="m-amber"></span>
                    <span class="m-red"></span>
                  </div>
                </div>
              </div>
            </article>

            <!-- Card 3: Stop Account Changes -->
            <article class="cy-fcard">
              <div class="cy-fcard-top">
                <span class="cy-fcard-step">03 / ACCOUNT UPDATE GATE</span>
                <h3>{C.features[2]!.title}</h3>
                <p class="cy-fcard-sub">{C.features[2]!.subtitle}</p>
                <p class="cy-fcard-desc">{C.features[2]!.description}</p>
                <a
                  class="cy-fcard-link"
                  data-cy-ev="cy_feat_verify"
                  href={L(`/cyber/verify/?card=${C.features[2]!.key}`)}
                >
                  {C.features[2]!.linkText} <span aria-hidden="true">→</span>
                </a>
              </div>

              <!-- Light UI Mock inside White Card 3 -->
              <div class="cy-fcard-mock" aria-hidden="true">
                <div class="cy-ui-box cy-ui-sender-box">
                  <div class="cy-ui-sender-col">
                    <small>{isJa ? "受信した変更案内" : "Incoming notice"}</small>
                    <strong>partner.example</strong>
                    <span class="cy-ui-gauge-pill">{isJa ? "証明不足" : "Unverified"}</span>
                  </div>
                  <div class="cy-ui-checks-col">
                    <div class="cy-ui-chk">
                      <span class="chk-ng">✕</span>
                      <span>{isJa ? "担当者の所属証明" : "Affiliation proof"}</span>
                    </div>
                    <div class="cy-ui-chk">
                      <span class="chk-ng">✕</span>
                      <span>{isJa ? "テキスト未改変証明" : "Unmodified text"}</span>
                    </div>
                  </div>
                </div>
                <div class="cy-ui-box">
                  <div class="cy-ui-stat3">
                    <div>
                      <strong>0</strong>
                      <small>{isJa ? "自動書き換え" : "Auto-updated"}</small>
                    </div>
                    <div>
                      <strong class="is-danger">Held</strong>
                      <small>{isJa ? "変更受付を保留" : "Update paused"}</small>
                    </div>
                    <div>
                      <strong>Phone</strong>
                      <small>{isJa ? "登録番号へ確認" : "Verbal check"}</small>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CHAPTER 3: ISSUE (Full-Bleed Stone #eef1eb Section)
         ===================================================================== -->
    <CyberProblem locale={locale} />

    <!-- =====================================================================
         CHAPTER 4: FACT (Empirical Attack Experiment Results: 18/30 -> 0/30)
         White Outer Canvas -> Deep Obsidian Stage + Crisp Comparison Table
         ===================================================================== -->
    <section id="fact" class="cy-fact-sec" aria-labelledby="cy-evidence-title">
      <div class="cy-container">
        <div class="cy-fact-stage">
          <div class="cy-fact-header">
            <span class="cy-eyebrow-dark">{C.evidenceEyebrow}</span>
            <h2 id="cy-evidence-title">{C.evidenceTitle}</h2>
            <p>{C.evidenceIntro}</p>
          </div>

          <div class="cy-fact-kpi-grid">
            <div class="cy-kpi-card is-before">
              <span class="cy-kpi-label">{C.factBefore}</span>
              <div class="cy-kpi-number">
                {C.factBeforeNum} <small>{C.factBeforeDenom}</small>
              </div>
              <p class="cy-kpi-desc">{C.factBeforeValue}</p>
            </div>
            <div class="cy-kpi-card is-after">
              <span class="cy-kpi-label">{C.factAfter}</span>
              <div class="cy-kpi-number">
                {C.factAfterNum} <small>{C.factAfterDenom}</small>
              </div>
              <p class="cy-kpi-desc">{C.factAfterValue}</p>
            </div>
          </div>

          <p class="cy-fact-subnote">{C.factSub}</p>

          <div class="cy-table-card">
            <table class="cy-fact-table">
              <caption>{C.factTableCaption}</caption>
              <thead>
                <tr>
                  <th scope="col">{C.factColScenario}</th>
                  <th scope="col">{C.factColWithout}</th>
                  <th scope="col">{C.factColWith}</th>
                </tr>
              </thead>
              <tbody>
                {
                  C.scenarios.map((name, rowIndex) => (
                    <tr>
                      <th scope="row">{name}</th>
                      <td class="cell-without">
                        <span class="status-icon-ng" aria-hidden="true">✕</span> {factRows[rowIndex]?.without}
                      </td>
                      <td class="cell-with">
                        <span class="status-icon-ok" aria-hidden="true">✓</span> {factRows[rowIndex]?.with}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <details class="cy-probe-details">
            <summary>
              <span>{C.factProbeTitle}</span>
              <span class="cy-plus" aria-hidden="true">+</span>
            </summary>
            <div class="cy-probe-body">
              <p>{C.factProbeBody}</p>
              <p class="cy-probe-note">{C.factProbeNote}</p>
            </div>
          </details>

          <div class="cy-fact-foot">
            <p>{C.factScope}</p>
            <a
              class="cy-fact-extlink"
              data-cy-ev="cy_fact_source"
              href="https://github.com/lemmaoracle/example-cyber-attack#readme"
              target="_blank"
              rel="noopener"
            >
              {C.source} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CHAPTER 5: HOW TO START (Clean White Section with 3 Step Cards)
         ===================================================================== -->
    <section class="cy-start-sec" aria-labelledby="cy-start-title">
      <div class="cy-container">
        <div class="cy-light-header">
          <span class="cy-eyebrow-light">{C.startEyebrow}</span>
          <h2 id="cy-start-title">{C.startTitle}</h2>
          <p>{C.startBody}</p>
        </div>

        <div class="cy-steps-grid">
          {
            C.steps.map((step) => (
              <div class="cy-step-card">
                <span class="cy-step-num">{step.num}</span>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CHAPTER 6: FAQ (Pale Stone #f3f5f0 Full-Bleed Section)
         ===================================================================== -->
    <section class="cy-faq-sec" aria-labelledby="cy-faq-title">
      <div class="cy-container">
        <div class="cy-light-header">
          <span class="cy-eyebrow-light">{C.faqEyebrow}</span>
          <h2 id="cy-faq-title">{C.faqTitle}</h2>
        </div>

        <div class="cy-faq-list">
          {
            C.faq.map((item) => (
              <details class="cy-faq-card">
                <summary>
                  <span>{item.q}</span>
                  <span class="cy-faq-plus" aria-hidden="true">+</span>
                </summary>
                <div class="cy-faq-ans">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =====================================================================
         CHAPTER 7: CLOSE CTA (Deep Obsidian Rounded Stage in White Canvas)
         ===================================================================== -->
    <section id="cy-close" class="cy-close-sec" aria-labelledby="cy-close-title">
      <div class="cy-container">
        <div class="cy-close-stage">
          <span class="cy-eyebrow-dark">{C.closeEyebrow}</span>
          <h2 id="cy-close-title">{C.closeTitle}</h2>
          <p class="cy-close-lead">{C.closeIntro}</p>
          <div class="cy-close-btns">
            <a
              class="cy-btn cy-btn-lime"
              data-cy-ev="cy_close_consult"
              href={DISCOVERY_CALL_URL[locale]}
              target="_blank"
              rel="noopener"
            >
              {C.call} <span aria-hidden="true">↗</span>
            </a>
            <a
              class="cy-btn cy-btn-outline-light"
              data-cy-ev="cy_close_doc"
              href={whitepaperUrl}
              target="_blank"
              rel="noopener"
            >
              {C.doc} <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="cy-close-verify">
            <p>{C.liveNote}</p>
            <a data-cy-ev="cy_close_verify" href={L("/verify/")}>
              {C.live} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* ==========================================================================
     ProofGate LP v2 — High-Contrast Lemma Design System
     Dynamic Light Stone / Pure White / Deep Obsidian Stage Switching
     ========================================================================== */

  .cy-page {
    --font-heading: "Space Grotesk", "Noto Sans JP", -apple-system, BlinkMacSystemFont, sans-serif;
    --font-body: "Noto Sans JP", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "Space Mono", monospace;

    /* Lemma High-Contrast Palette */
    --obsidian-stage: #121611;
    --charcoal-stage: #191d17;
    --pale-stone: #eef1eb;
    --ink: #12140e;
    --ink-soft: #2f352b;
    --muted: #5c6356;
    --lime: #a8e010;
    --lime-hover: #b6ec24;
    --lime-ink: #3f6200;
    --lime-tint: #e4f2be;
    --err: #c2412d;

    background: #ffffff;
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .cy-page *,
  .cy-page *::before,
  .cy-page *::after {
    box-sizing: border-box;
  }

  .cy-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
  }

  /* Buttons (High-Contrast Lemma Pill / Rounded Style) */
  .cy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    padding: 15px 30px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    line-height: 1;
  }

  .cy-btn-lime {
    background: var(--lime);
    color: var(--ink);
    border: 1.5px solid var(--lime);
  }

  .cy-btn-lime:hover {
    background: var(--lime-hover);
    border-color: var(--lime-hover);
  }

  .cy-btn-outline-dark {
    background: transparent;
    color: var(--ink);
    border: 1.5px solid #8c9484;
  }

  .cy-btn-outline-dark:hover {
    border-color: var(--ink);
    background: rgba(18, 20, 14, 0.05);
  }

  .cy-btn-outline-light {
    background: transparent;
    color: #f4f7ef;
    border: 1.5px solid rgba(244, 247, 239, 0.35);
  }

  .cy-btn-outline-light:hover {
    border-color: #f4f7ef;
    background: rgba(244, 247, 239, 0.08);
  }

  /* ==========================================================================
     CHAPTER 1A: HERO (Pale Stone #eef1eb Canvas)
     ========================================================================== */
  .cy-hero-sec {
    background: var(--pale-stone);
    padding: 76px 0 84px;
    border-bottom: 1px solid #d5dbd0;
  }

  .cy-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 52px;
  }

  .cy-hero-copy {
    padding: 8px 0;
  }

  .cy-hero-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: #2b4200;
    background: var(--lime-tint);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 24px;
  }

  .cy-hero-h1 {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5.2vw, 62px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--ink);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .cy-hero-lead {
    font-size: 17px;
    line-height: 1.8;
    color: var(--ink-soft);
    margin: 0 0 32px;
    max-width: 48ch;
  }

  .cy-hero-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .cy-hero-visual-col {
    position: relative;
  }

  .cy-gate-card {
    background: #ffffff;
    border: 1px solid #cfd5c9;
    border-radius: 16px;
    box-shadow: 0 20px 48px rgba(18, 20, 14, 0.12);
    overflow: hidden;
  }

  .cy-gate-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 22px;
    background: var(--obsidian-stage);
    color: #f4f7ef;
  }

  .cy-gate-dots {
    display: flex;
    gap: 6px;
  }

  .cy-gate-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a4035;
  }

  .cy-gate-dots span:first-child {
    background: #ef4444;
  }
  .cy-gate-dots span:nth-child(2) {
    background: #f59e0b;
  }
  .cy-gate-dots span:nth-child(3) {
    background: var(--lime);
  }

  .cy-gate-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #e2e6dd;
  }

  .cy-gate-live {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--lime);
    background: rgba(168, 224, 16, 0.14);
    border: 1px solid rgba(168, 224, 16, 0.35);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .cy-gate-list {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    background: #ffffff;
  }

  .cy-gate-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 22px;
    border-bottom: 1px solid #eef1eb;
  }

  .cy-gate-row:last-child {
    border-bottom: none;
  }

  .cy-gate-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cy-gate-row.is-held .cy-gate-indicator {
    background: var(--err);
  }

  .cy-gate-row.is-ok .cy-gate-indicator {
    background: #4e7a00;
  }

  .cy-gate-main {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .cy-gate-main strong {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-gate-main small {
    font-size: 12.5px;
    color: var(--muted);
  }

  .cy-gate-pill {
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .cy-gate-row.is-held .cy-gate-pill {
    background: #fef2f2;
    color: var(--err);
    border: 1px solid #fecaca;
  }

  .cy-gate-row.is-ok .cy-gate-pill {
    background: var(--lime-tint);
    color: #2b4200;
    border: 1px solid #cbe38d;
  }

  .cy-gate-foot {
    padding: 12px 22px;
    background: #f6f8f4;
    border-top: 1px solid #e1e5dd;
    font-size: 12px;
    color: var(--muted);
  }

  /* ==========================================================================
     CHAPTER 1B: INTRO — ARCHITECTURAL BLUEPRINT & INTERCEPT PIPELINE
     Benchmarks: Vercel Security / Geist (1px Blueprint Grid + Crosshairs)
                 & Stripe Radar (Live Intercept Pipeline Diagram)
     ========================================================================== */
  .cy-arch-sec {
    position: relative;
    background: var(--obsidian-stage);
    color: #f4f7ef;
    padding: 88px 0 96px;
    border-top: 3px solid var(--lime);
    overflow: hidden;
  }

  /* Subtle 28px Engineering Grid (from Lemma top-v47 .pgrid) */
  .cy-arch-pgrid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  .cy-arch-frame {
    position: relative;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(20, 25, 19, 0.88);
  }

  /* Precision Corner Crosshairs (+) inspired by Vercel Geist */
  .cy-crosshair {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1;
    color: var(--lime);
    pointer-events: none;
    user-select: none;
    z-index: 3;
  }
  .cy-crosshair.is-tl {
    top: -8px;
    left: -5px;
  }
  .cy-crosshair.is-tr {
    top: -8px;
    right: -5px;
  }
  .cy-crosshair.is-bl {
    bottom: -8px;
    left: -5px;
  }
  .cy-crosshair.is-br {
    bottom: -8px;
    right: -5px;
  }

  .cy-arch-upper {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .cy-arch-editorial {
    padding: 56px 48px;
    border-right: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cy-arch-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--lime);
    margin-bottom: 20px;
  }

  .cy-arch-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
  }

  .cy-arch-h2 {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.18;
    color: #ffffff;
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .cy-arch-lead {
    font-size: 16px;
    line-height: 1.9;
    color: #cfd6c8;
    margin: 0 0 32px;
  }

  .cy-arch-tags {
    list-style: none;
    margin: 0;
    padding: 24px 0 0;
    border-top: 1px dashed rgba(255, 255, 255, 0.16);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .cy-arch-tags li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: #eef2ea;
  }

  .cy-arch-tag-check {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: rgba(168, 224, 16, 0.16);
    border: 1px solid rgba(168, 224, 16, 0.45);
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* Right Column: Stripe Radar-style Intercept Pipeline Diagram */
  .cy-arch-diagram {
    padding: 36px 40px;
    background: #0d100c;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cy-pipe-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--font-mono);
  }

  .cy-pipe-title {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ffffff;
  }

  .cy-pipe-sub {
    font-size: 11px;
    color: #96a08e;
    letter-spacing: 0.06em;
  }

  .cy-pipe-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cy-pipe-zone {
    padding: 16px 18px;
    border-radius: 8px;
  }

  .cy-pipe-zone.is-perimeter {
    background: #171c15;
    border: 1px dashed rgba(255, 255, 255, 0.25);
  }

  .cy-pipe-zone.is-gate {
    background: #161f12;
    border: 1.5px solid var(--lime);
  }

  .cy-pipe-zone-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .cy-pipe-ztag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #9ca694;
  }

  .cy-pipe-ztag.is-lime {
    color: var(--lime);
  }

  .cy-pipe-zbadge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #d8e2cf;
    background: rgba(255, 255, 255, 0.08);
    padding: 3px 9px;
    border-radius: 4px;
  }

  .cy-pipe-ztitle {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .cy-pipe-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cy-pipe-chip {
    font-size: 12px;
    color: #cfd6c8;
    background: #0d100c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 5px 10px;
    border-radius: 4px;
  }

  .cy-pipe-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 4px 0;
  }

  .cy-pipe-packet {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--lime);
    background: rgba(168, 224, 16, 0.12);
    border: 1px solid rgba(168, 224, 16, 0.35);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .cy-pipe-arrow {
    font-size: 11px;
    color: var(--lime);
  }

  .cy-pipe-gname {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
  }

  .cy-pipe-dual {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .cy-pipe-engine {
    background: #0e130c;
    border: 1px solid rgba(168, 224, 16, 0.28);
    border-radius: 6px;
    padding: 12px 14px;
  }

  .cy-pipe-engine-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .cy-pipe-etag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    background: var(--lime);
    color: var(--ink);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .cy-pipe-engine-top strong {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
  }

  .cy-pipe-engine p {
    font-size: 12px;
    line-height: 1.5;
    color: #b8c2b0;
    margin: 0;
  }

  .cy-pipe-outcomes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .cy-pipe-out {
    padding: 12px 14px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cy-pipe-out.is-pass {
    background: rgba(168, 224, 16, 0.08);
    border: 1px solid rgba(168, 224, 16, 0.35);
  }

  .cy-pipe-out.is-hold {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .cy-pipe-out-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  .cy-pipe-out.is-pass .cy-pipe-out-label {
    color: var(--lime);
  }

  .cy-pipe-out.is-hold .cy-pipe-out-label {
    color: #fca5a5;
  }

  .dot-pass,
  .dot-hold {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-pass {
    background: var(--lime);
  }

  .dot-hold {
    background: #ef4444;
  }

  .cy-pipe-out strong {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
  }

  /* Lower 3-Column Spec Matrix (Vercel Geist 1px Structural Grid) */
  .cy-arch-specs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cy-spec-cell {
    padding: 36px 36px 32px;
    border-right: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    flex-direction: column;
  }

  .cy-spec-cell:last-child {
    border-right: none;
  }

  .cy-spec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cy-spec-num {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--lime);
    line-height: 1;
  }

  .cy-spec-code {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #96a08e;
  }

  .cy-spec-title {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .cy-spec-body {
    font-size: 14.5px;
    line-height: 1.8;
    color: #c7cfc0;
    margin: 0 0 24px;
    flex-grow: 1;
  }

  .cy-spec-foot {
    padding: 10px 12px;
    background: #0d100c;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
  }

  .cy-spec-foot code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: #dce3d5;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ==========================================================================
     CHAPTER 2: FEATURES (Charcoal Rounded Stage + 3 White Cards + UI Mocks)
     ========================================================================== */
  .cy-features-outer {
    background: #ffffff;
    padding: 64px 0 112px;
  }

  .cy-features-stage {
    background: var(--charcoal-stage);
    border-radius: 28px;
    padding: 80px 48px 56px;
    color: #ffffff;
  }

  .cy-features-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .cy-features-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 18px;
    text-wrap: balance;
  }

  .cy-features-header p {
    font-size: 16px;
    line-height: 1.8;
    color: #c7cfc0;
    margin: 0;
  }

  .cy-features-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cy-fcard {
    background: #ffffff;
    color: var(--ink);
    border-radius: 20px;
    padding: 36px 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }

  .cy-fcard-step {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .cy-fcard-top h3 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 6px;
    line-height: 1.25;
  }

  .cy-fcard-sub {
    font-size: 15px;
    font-weight: 700;
    color: var(--lime-ink);
    margin: 0 0 14px;
  }

  .cy-fcard-desc {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 18px;
  }

  .cy-fcard-link {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .cy-fcard-link:hover {
    color: var(--lime-ink);
  }

  /* Light Mode UI Mocks inside White Feature Cards */
  .cy-fcard-mock {
    background: #f6f8f4;
    border: 1px solid #dce1d7;
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cy-ui-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .cy-ui-mini {
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 10px;
    padding: 12px;
    box-shadow: 0 2px 6px rgba(18, 20, 14, 0.04);
  }

  .cy-ui-mini-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .cy-ui-mini-head strong {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-ui-mini-head strong.is-danger {
    color: var(--err);
  }

  .cy-ui-ico-ok {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--lime-tint);
    color: #2b4200;
    font-size: 12px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .cy-ui-ico-warn {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #fee2e2;
    color: var(--err);
    font-size: 12px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .cy-ui-mini > span {
    display: block;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  .cy-ui-box {
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 10px;
    padding: 14px;
    box-shadow: 0 2px 6px rgba(18, 20, 14, 0.04);
  }

  .cy-ui-table-head {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    padding-bottom: 8px;
    border-bottom: 1px solid #eef1eb;
  }

  .cy-ui-table-row {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr auto;
    align-items: center;
    padding: 8px 0;
    font-size: 12.5px;
    border-bottom: 1px solid #f6f8f4;
  }

  .cy-ui-table-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
