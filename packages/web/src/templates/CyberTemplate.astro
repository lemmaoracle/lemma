---
/** Cyber public page. Card faces are examples; attack results are demo observations. */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";

export interface CyberTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}
const { locale, t, base } = Astro.props as CyberTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);
const discoveryHref = DISCOVERY_CALL_URL[locale];
const C = isJa
  ? {
      title: "Cyber — 認可ではなく、暗号的に証明させる｜Lemma",
      description:
        "認可が突破された攻撃シミュレーションで、証明ゲートはどう働いたか。5つの INSECURE / SECURE 比較と、Cyber の証明カード。",
      headline: "認可ではなく、暗号的に証明させる",
      sub: "権限を信じるだけでなく、操作の条件を満たす証明を実行前に求める。",
      call: "Discovery Call を予約 →",
      verify: "証明を試す →",
      example: "例 / 証明カード",
      issuer: "発行者スロット",
      issuerValue: "任意の個人",
      message: "メッセージ",
      messageValue: "承認された条件を満たす操作",
      layers: ["非公開の入力", "満たすべき条件", "条件を満たすことの証明"],
      evidenceTitle: "認可が突破された。その先を、証明で止める。",
      evidenceSub:
        "攻撃シミュレーションの比較。証明を強制しない INSECURE と、証明ゲートを置いた SECURE。",
      scenario: "攻撃シナリオ",
      blocked: "ブロック",
      outcomes: [
        "SSN 全文が漏洩",
        "機密アクセス・監査目的を達成",
        "到達可能な経路で SSN を復号",
        "不正転送が成功",
        "承認フローの迂回を実行",
      ],
      names: [
        "不正なデータ持ち出し",
        "監査証跡の改ざん",
        "ゼロデイ RCE",
        "SIEM 回避",
        "ソーシャルエンジニアリング",
      ],
      matrix:
        "自律型 LLM 攻撃者 Opus 4.8：INSECURE は 5/5 で攻撃成功。SECURE は攻撃成功 0/5、5/5 をブロック。",
      caveat:
        "このデモの観測結果であり、あらゆる環境・攻撃への防御を保証するものではありません。",
      difference: "権限を確認する。条件を証明させる。",
      legacy: "これまで：認可チェック",
      cyber: "Cyber：証明ゲート",
      legacySteps: ["権限・認証情報", "認可チェック", "権限があれば通る"],
      proofSteps: ["操作 + 証明", "暗号的な検証", "証明がなければ通らない"],
      legacyNote: "権限が奪われれば、突破されうる。",
      proofNote: "権限を奪っても、条件を満たす証明にはならない。",
      diagramNote:
        "概念図。証明ゲートは、対象の操作と条件に結び付いた証明を実行前に検証する設計です。",
      cardTitle: "期待する条件を、一枚に。",
      cardSub:
        "発行者スロットとメッセージで期待値を定義し、Witness・Constraints・Proof の3層で示す。",
      cardNote: "カードは表示例です。実際の証明検証は /verify/ で。",
      samples: "カード別の表示例",
      sampleNames: ["転送", "復号", "API"],
      close: "あなたの業務で、何を証明させるか。",
    }
  : {
      title:
        "Cyber — Require cryptographic proof, beyond authorization | Lemma",
      description:
        "See how proof gates performed in five attack simulations: INSECURE versus SECURE, and the Cyber proof card behind the idea.",
      headline: "Require cryptographic proof, beyond authorization.",
      sub: "Before an operation runs, require proof that its conditions hold—not just trusted credentials.",
      call: "Book a Discovery Call →",
      verify: "Try verification →",
      example: "Example / Proof card",
      issuer: "Issuer slot",
      issuerValue: "Any individual",
      message: "Message",
      messageValue: "An operation meeting approved conditions",
      layers: [
        "Private inputs",
        "Conditions to satisfy",
        "Proof that conditions hold",
      ],
      evidenceTitle:
        "Authorization was breached. Proof stopped the next action.",
      evidenceSub:
        "Attack simulations comparing INSECURE without proof enforcement and SECURE with a proof gate.",
      scenario: "Attack scenario",
      blocked: "Blocked",
      outcomes: [
        "Full SSNs leaked",
        "Sensitive access / audit objective achieved",
        "SSNs decrypted via reachable workflow",
        "Unauthorized transfer succeeded",
        "Approval-flow bypass executed",
      ],
      names: [
        "Unauthorized data exfiltration",
        "Audit trail tampering",
        "Zero-day RCE",
        "SIEM evasion",
        "Social engineering",
      ],
      matrix:
        "Autonomous LLM attacker Opus 4.8: 5/5 attacks succeeded in INSECURE. In SECURE, 0/5 succeeded; 5/5 were blocked.",
      caveat:
        "Observed demo results, not a guarantee of protection across all environments or attacks.",
      difference: "Check permission. Require proof of conditions.",
      legacy: "Before: authorization check",
      cyber: "Cyber: proof gate",
      legacySteps: [
        "Permissions / credentials",
        "Authorization check",
        "Permission allows passage",
      ],
      proofSteps: [
        "Operation + proof",
        "Cryptographic verification",
        "No proof, no passage",
      ],
      legacyNote: "Stolen permissions can allow a breach.",
      proofNote: "Stealing permission does not prove the conditions hold.",
      diagramNote:
        "Conceptual diagram: the gate verifies proof bound to the intended operation and conditions before execution.",
      cardTitle: "Define expectations in one card.",
      cardSub:
        "An issuer slot and message define expectations, expressed through three layers: Witness, Constraints, and Proof.",
      cardNote:
        "The cards are display examples. Check actual proofs at /verify/.",
      samples: "Example card faces",
      sampleNames: ["Transfer", "Decryption", "API"],
      close: "What should your operations have to prove?",
    };
const layerNames = ["Witness", "Constraints", "Proof"] as const;
const sampleKeys = ["transfer", "decrypt", "api"] as const;
const scenarioNames = [
  "Unauthorized data exfiltration",
  "Audit trail tampering",
  "Zero-day RCE",
  "SIEM evasion",
  "Social engineering",
] as const;
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="topx cy-page">
    <section class="herodark" aria-labelledby="cy-hero-h">
      <div class="cy-container cy-hero">
        <p class="cy-eyebrow">LEMMA / CYBER</p>
        <div class="cy-card-stage">
          <article class="cy-proof-card" aria-label={C.example}>
            <header>
              <span>CYBER / PROOF CARD</span><span>{C.example}</span>
            </header>
            <div class="cy-slot">
              <span>{C.issuer}</span><strong>{C.issuerValue}</strong>
            </div>
            <div class="cy-message">
              <span>{C.message}</span><p>{C.messageValue}</p>
            </div>
            <ol class="cy-layers">
              {
                layerNames.map((name, i) => (
                  <li>
                    <>
                      <span class="cy-layer-no">0{i + 1}</span>
                      <strong>{name}</strong>
                      <span>{C.layers[i]}</span>
                    </>
                  </li>
                ))
              }
            </ol>
            <footer>
              <span>WITNESS → CONSTRAINTS → PROOF</span><span>◇</span>
            </footer>
          </article>
        </div>
        <h1 id="cy-hero-h">{C.headline}</h1>
        <p class="cy-sublead">{C.sub}</p>
        <div class="cy-actions">
          <a
            class="btn solid"
            href={discoveryHref}
            target="_blank"
            rel="noopener">{C.call}</a
          ><a class="btn ghostd" href={L("/verify/")}>{C.verify}</a>
        </div>
      </div>
    </section>
    <section class="cy-container cy-section" aria-labelledby="cy-evidence-h">
      <p class="cy-eyebrow">01 / ATTACK SIMULATIONS</p>
      <h2 id="cy-evidence-h">{C.evidenceTitle}</h2><p class="cy-sublead">
        {C.evidenceSub}
      </p>
      <div class="cy-table-wrap">
        <table>
          <caption>5 scenarios × INSECURE/SECURE</caption>
          <thead
            ><tr
              ><th scope="col">{C.scenario}</th><th scope="col">INSECURE</th><th
                scope="col">SECURE</th
              ></tr
            ></thead
          >
          <tbody
            >{
              C.names.map((name, i) => (
                <tr>
                  <>
                    <th scope="row">
                      {name}
                      {isJa && <small lang="en">{scenarioNames[i]}</small>}
                    </th>
                    <td>
                      <span class="cy-failed">✗</span> {C.outcomes[i]}
                    </td>
                    <td class="cy-verified">✓ {C.blocked}</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
      <p class="cy-matrix">{C.matrix}</p>
      <p class="cy-note">
        <cite
          >example-cyber-attack demo (INSECURE vs SECURE), README — Primary
          end-to-end result: Opus 4.8</cite
        ><br />{C.caveat}
      </p>
    </section>
    <section class="cy-container cy-section" aria-labelledby="cy-difference-h">
      <p class="cy-eyebrow">02 / AUTHORIZATION → PROOF</p><h2
        id="cy-difference-h"
      >
        {C.difference}
      </h2>
      <div class="cy-diagrams">
        {
          [
            { title: C.legacy, steps: C.legacySteps, note: C.legacyNote },
            { title: C.cyber, steps: C.proofSteps, note: C.proofNote },
          ].map((diagram) => (
            <article class="cy-diagram">
              <>
                <h3>{diagram.title}</h3>
                <ol>
                  {diagram.steps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
                <p>{diagram.note}</p>
              </>
            </article>
          ))
        }
      </div>
      <p class="cy-note">{C.diagramNote}</p>
    </section>
    <section
      class="cy-container cy-section cy-intro"
      aria-labelledby="cy-card-h"
    >
      <div>
        <p class="cy-eyebrow">03 / THE PROOF CARD</p><h2 id="cy-card-h">
          {C.cardTitle}
        </h2><p class="cy-sublead">{C.cardSub}</p><p class="cy-note">
          {C.cardNote}
        </p><a class="cy-text-link" href={L("/verify/")}>{C.verify}</a>
      </div>
      <div class="cy-mini-card">
        <p class="cy-eyebrow">{C.example}</p><dl>
          <div><dt>{C.issuer}</dt><dd>{C.issuerValue}</dd></div><div>
            <dt>{C.message}</dt><dd>{C.messageValue}</dd>
          </div>
        </dl><div class="cy-mini-layers">
          {layerNames.map((name) => <span>{name}</span>)}
        </div>
        <nav aria-label={C.samples}>
          {
            sampleKeys.map((key, i) => (
              <a href={L(`/cyber/verify/?card=${key}`)}>
                {isJa ? "例" : "Example"}: {C.sampleNames[i]} ↗
              </a>
            ))
          }
        </nav>
      </div>
    </section>
    <section
      class="cy-container cy-section cy-close"
      aria-labelledby="cy-close-h"
    >
      <p class="cy-eyebrow">CYBER / NEXT</p><h2 id="cy-close-h">
        {C.close}
      </h2><div class="cy-actions">
        <a class="btn solid" href={discoveryHref} target="_blank" rel="noopener"
          >{C.call}</a
        ><a class="cy-text-link" href={L("/verify/")}>{C.verify}</a>
      </div>
    </section>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>
<style>
  .topx.cy-page {
    --cy-bg: #12140e;
    --cy-text: #f4f7ef;
    --cy-muted: #b9c4ad;
    --cy-line: rgba(255, 255, 255, 0.18);
    --ok: #a8e010;
    --serif: "Noto Serif JP", serif;
    --grot: "Space Grotesk", sans-serif;
    --mono: "Space Mono", monospace;
    background: var(--cy-bg);
    color: var(--cy-text);
    font-family: var(--grot), "Noto Sans JP", sans-serif;
    line-height: 1.7;
    padding-bottom: 96px;
  }
  .cy-page *,
  .cy-page *::before,
  .cy-page *::after {
    box-sizing: border-box;
  }
  .cy-container {
    width: min(1160px, 100%);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }
  .herodark {
    position: relative;
    overflow: hidden;
    background: var(--cy-bg);
  }
  .herodark::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.07) 1.2px,
      transparent 1.2px
    );
    background-size: 34px 34px;
    pointer-events: none;
  }
  .cy-hero {
    position: relative;
    text-align: center;
    padding-top: 54px;
    padding-bottom: 76px;
  }
  .cy-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--cy-muted);
    margin: 0 0 20px;
  }
  .cy-card-stage {
    padding: 28px 12px 40px;
    perspective: 1400px;
  }
  .cy-proof-card {
    position: relative;
    text-align: left;
    width: min(590px, 100%);
    margin: auto;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 20px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.1),
        rgba(255, 255, 255, 0.02)
      ),
      var(--cy-bg);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.45);
    transform: rotateX(5deg) rotateZ(-3deg);
  }
  .cy-proof-card header,
  .cy-proof-card footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    color: var(--cy-muted);
  }
  .cy-slot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 30px;
  }
  .cy-slot > span,
  .cy-message > span {
    font-size: 11px;
    color: var(--cy-muted);
  }
  .cy-slot strong {
    border: 1px dashed var(--cy-line);
    border-radius: 6px;
    padding: 5px 18px;
    font-size: 14px;
    font-weight: 400;
  }
  .cy-message {
    margin: 22px 0;
  }
  .cy-message p {
    font-family: var(--serif);
    font-size: clamp(19px, 3vw, 27px);
    margin: 6px 0;
  }
  .cy-layers {
    padding: 0;
    margin: 0 0 24px;
    list-style: none;
  }
  .cy-layers li {
    display: grid;
    grid-template-columns: 24px 115px 1fr;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--cy-line);
    padding: 14px 0;
    font-size: 12px;
  }
  .cy-layers strong {
    font-family: var(--grot);
    font-weight: 500;
    font-size: 16px;
  }
  .cy-layer-no {
    font-family: var(--mono);
    color: var(--cy-muted);
    font-size: 10px;
  }
  .herodark h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(34px, 4.7vw, 58px);
    line-height: 1.32;
    color: #f4f7ef;
    margin: 12px auto 20px;
    text-wrap: balance;
  }
  .cy-sublead {
    color: var(--cy-muted);
    font-size: 15.5px;
    line-height: 1.9;
    margin: 0 0 28px;
  }
  .cy-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .cy-hero .cy-actions {
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .topx .btn.solid {
    background: #a8e010;
    color: #1a1f16;
  }
  .topx .btn.solid:hover {
    background: #b7ec2a;
  }
  .topx .herodark .btn.ghostd {
    background: rgba(255, 255, 255, 0.1);
    color: #f4f7ef;
  }
  .topx .herodark .btn.ghostd:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  a:focus-visible {
    outline: 2px solid var(--cy-text);
    outline-offset: 5px;
  }
  .cy-section {
    padding-top: 80px;
  }
  h2 {
    font-family: var(--serif);
    font-size: clamp(26px, 3.3vw, 40px);
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 22px;
    text-wrap: balance;
  }
  .cy-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--cy-line);
    border-radius: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 14px;
  }
  caption {
    text-align: left;
    padding: 16px 20px;
    font-family: var(--mono);
    font-size: 12px;
  }
  th,
  td {
    border-top: 1px solid var(--cy-line);
    padding: 18px 20px;
  }
  thead th {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cy-muted);
    letter-spacing: 0.06em;
  }
  tbody th {
    font-weight: 500;
    width: 36%;
  }
  th small {
    display: block;
    font-size: 10px;
    color: var(--cy-muted);
    font-weight: 400;
    margin-top: 4px;
  }
  .cy-failed {
    color: #f28b82;
    font-weight: 700;
  }
  .cy-verified {
    color: var(--ok);
    white-space: nowrap;
  }
  .cy-matrix {
    font-size: 14px;
    border-left: 2px solid var(--cy-line);
    padding-left: 18px;
    margin-top: 24px;
  }
  .cy-note {
    font-size: 12px;
    color: var(--cy-muted);
    line-height: 1.9;
    margin: 20px 0;
  }
  cite {
    font-style: normal;
  }
  .cy-diagrams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .cy-diagram {
    border: 1px solid var(--cy-line);
    border-radius: 12px;
    padding: 28px;
    background: rgba(255, 255, 255, 0.03);
  }
  h3 {
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 24px;
  }
  .cy-diagram ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cy-diagram li {
    position: relative;
    padding: 16px 12px;
    text-align: center;
    border: 1px solid var(--cy-line);
    border-radius: 6px;
    font-size: 14px;
  }
  .cy-diagram li + li {
    margin-top: 36px;
  }
  .cy-diagram li + li::before {
    content: "↓";
    position: absolute;
    top: -33px;
    left: 0;
    right: 0;
    color: var(--cy-muted);
    font-family: var(--mono);
  }
  .cy-diagram p {
    color: var(--cy-muted);
    font-size: 13px;
    margin: 24px 0 0;
  }
  .cy-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
  }
  .cy-mini-card {
    border: 1px solid var(--cy-line);
    border-radius: 14px;
    padding: 28px;
    background: rgba(255, 255, 255, 0.04);
  }
  dl {
    margin: 0;
  }
  dl div + div {
    margin-top: 18px;
  }
  dt {
    color: var(--cy-muted);
    font-size: 11px;
  }
  dd {
    margin: 6px 0 0;
    font-size: 16px;
  }
  .cy-mini-layers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0;
  }
  .cy-mini-layers span {
    font-family: var(--mono);
    font-size: 11px;
    border: 1px solid var(--cy-line);
    padding: 6px 10px;
    border-radius: 4px;
  }
  .cy-mini-card nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 12px;
  }
  .cy-mini-card a,
  .cy-text-link {
    color: var(--cy-text);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cy-close {
    margin-top: 80px;
    border-top: 1px solid var(--cy-line);
  }
  @media (max-width: 720px) {
    .cy-diagrams,
    .cy-intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cy-section {
      padding-top: 56px;
    }
    .cy-hero {
      padding-top: 36px;
      padding-bottom: 40px;
    }
    .cy-proof-card {
      padding: 20px;
      transform: none;
    }
    .cy-proof-card header {
      flex-wrap: wrap;
    }
    .cy-layers li {
      grid-template-columns: 20px 1fr;
    }
    .cy-layers li > span:last-child {
      grid-column: 2;
    }
    th,
    td {
      padding: 14px 12px;
      font-size: 12px;
    }
    .cy-close {
      margin-top: 56px;
    }
  }
  @media (max-width: 430px) {
    .herodark h1 {
      font-size: 29px;
    }
    .cy-hero .btn {
      width: 100%;
    }
    .cy-proof-card footer {
      font-size: 8px;
    }
  }
</style>
