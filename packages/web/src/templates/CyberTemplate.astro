// 45-degree Bird's-Eye Isometric Projection Helpers
// u: along execution pipeline axis (top-left to bottom-right, 0..880)
// v: across gate width (back-right to front-left, -105..+235)
// z: vertical elevation (0..135)
const ISO_X0 = 228;
const ISO_Y0 = 192;
const iso = (u: number, v: number, z = 0) => ({
  x: Math.round((ISO_X0 + u * 0.81 - v * 0.56) * 10) / 10,
  y: Math.round((ISO_Y0 + u * 0.265 + v * 0.43 - z) * 10) / 10,
});
const isoPt = (u: number, v: number, z = 0) => {
  const p = iso(u, v, z);
  return `${p.x},${p.y}`;
};
const isoPoly = (pts: ReadonlyArray<readonly [number, number, number?]>) =>
  pts.map(([u, v, z = 0]) => isoPt(u, v, z)).join(" ");
const isoPath = (pts: ReadonlyArray<readonly [number, number, number?]>) =>
  pts
    .map(([u, v, z = 0], idx) => `${idx === 0 ? "M" : "L"} ${isoPt(u, v, z)}`)
    .join(" ");

const floorGridU = [0, 75, 150, 225, 300, 375, 450, 525, 600, 675, 750, 825, 880] as const;
const floorGridV = [-100, -50, 0, 50, 100] as const;
