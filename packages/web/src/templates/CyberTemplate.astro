---
/**
 * Keep the original centered, visual-first composition. Diagrams and tables
 * carry the explanation; prose is supplementary. The card is illustrative,
 * not a live result. Enforcement requires an execution gate.
 * Attacker-matrix values: example-cyber-attack/README.md.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-mono/latin-400.css";

export interface CyberTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}
const { locale, t, base } = Astro.props as CyberTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);
const C = isJa
  ? {
      title: "Cyber — 許可を信じない。証明を求める。｜Lemma",
      description:
        "機関・本人・今回の操作を暗号的に結び付け、条件成立の証明を実行直前に検証する。Cyber の設計と公開検証を図と表で紹介します。",
      headline: ["許可を信じない。", "証明を求める。"],
      call: "相談する",
      learn: "仕組みを見る",
      live: "証明を検証する",
      sample: "構成イメージ",
      cardTitle: "送金の実行証明",
      chain: [
        {
          label: "機関",
          value: "acme.example",
          note: "ドメイン認証済み",
          icon: "M5 22V7l9-4 9 4v15M3 23h22M10 9v3m8-3v3m-8 4v3m8-3v3",
        },
        {
          label: "本人",
          value: "経理担当者",
          note: "機関IDに束縛",
          icon: "M14 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM5 25v-2a9 9 0 0 1 18 0v2",
        },
        {
          label: "今回の操作",
          value: "¥80,000",
          note: "登録済みの振込先",
          icon: "M4 8h14M14 4l4 4-4 4M24 20H10m4-4-4 4 4 4",
        },
      ],
      binding: "暗号的に束縛",
      limits: ["上限 ¥100,000 以内", "登録先と一致"],
      proof: "必要条件の成立を証明",
      cardNote: "架空の機関・本人・操作による構成例。ライブ検証ではありません。",
      cardLink: "カードの例を見る",
      compareTitle: "「許可」の回答から、成立の証明へ。",
      compareLabels: ["古典的な認可", "Cyber の証明"],
      compareSummary: "「許可済み」でも、条件が不成立なら実行させない。",
      compareNote: "機関・本人・操作を結ぶ証明を、実行の手前で検証する。",
      modes: ["証明ゲートなし", "証明ゲートあり"],
      scenario: "シナリオ",
      scenarios: [
        "不正なデータ持ち出し",
        "監査証跡の改ざん",
        "ゼロデイ RCE",
        "SIEM 回避",
        "ソーシャルエンジニアリング",
      ],
      attack: "攻撃成功",
      unfinished: "ターン予算内に未完了",
      blocked: "阻止",
      evidence: "公開された攻撃シミュレーション",
      source: "構成・条件・結果を見る",
      gateTitle: "実行の手前で、証明を検証。",
      request: "要求 ＋ 証明",
      gate: "検証",
      system: "システム",
      checks: ["本人・資格", "操作との一致", "条件成立"],
      pass: "成立",
      fail: "不一致・期限切れ",
      stop: "停止",
      gateNote: "対象操作の全経路をゲートに通し、失効・期限・再利用を実行時にも検査します。",
      docs: "組み込み方を見る",
      usesTitle: "守りたい操作から。",
      uses: [
        {
          key: "transfer",
          symbol: "¥",
          title: "送金・口座変更",
          conditions: ["振込先", "金額", "承認"],
        },
        {
          key: "decrypt",
          symbol: "↗",
          title: "復号・データ取得",
          conditions: ["本人", "対象", "範囲"],
        },
        {
          key: "api",
          symbol: "{ }",
          title: "API・ワークフロー",
          conditions: ["権限", "引数", "操作"],
        },
      ],
      example: "例を見る",
      closeTitle: "あなたの操作にも、成立の証明を。",
    }
  : {
      title: "Cyber — Don't trust permission. Require proof. | Lemma",
      description:
        "Bind the institution, person and actual action cryptographically. Explore Cyber's proof-before-execution design and published validation through diagrams and tables.",
      headline: ["Don't trust permission.", "Require proof."],
      call: "Talk to us",
      learn: "How it works",
      live: "Verify a proof",
      sample: "Illustrative design",
      cardTitle: "Transfer execution proof",
      chain: [
        {
          label: "Institution",
          value: "acme.example",
          note: "Domain verified",
          icon: "M5 22V7l9-4 9 4v15M3 23h22M10 9v3m8-3v3m-8 4v3m8-3v3",
        },
        {
          label: "Person",
          value: "Finance member",
          note: "Bound to institution ID",
          icon: "M14 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM5 25v-2a9 9 0 0 1 18 0v2",
        },
        {
          label: "This action",
          value: "¥80,000",
          note: "Registered recipient",
          icon: "M4 8h14M14 4l4 4-4 4M24 20H10m4-4-4 4 4 4",
        },
      ],
      binding: "Cryptographically bound",
      limits: ["Within ¥100,000 limit", "Recipient matches"],
      proof: "Proof of required conditions",
      cardNote: "Illustrative institution, person and action. Not a live verification.",
      cardLink: "Explore the sample card",
      compareTitle: "From an answer to evidence.",
      compareLabels: ["Classic authorization", "Cyber proof"],
      compareSummary: "Permission granted. Conditions unmet. Execution stopped.",
      compareNote: "Verify a proof binding the institution, person and action before execution.",
      modes: ["Without a proof gate", "With a proof gate"],
      scenario: "Scenario",
      scenarios: [
        "Unauthorized data exfiltration",
        "Audit trail tampering",
        "Zero-day RCE",
        "SIEM evasion",
        "Social engineering",
      ],
      attack: "Attack succeeded",
      unfinished: "Not completed within turn budget",
      blocked: "Blocked",
      evidence: "Published attack simulation",
      source: "See configuration, conditions and results",
      gateTitle: "Verify before execution.",
      request: "Request + proof",
      gate: "Verify",
      system: "System",
      checks: ["Credentials", "Request match", "Conditions"],
      pass: "Satisfied",
      fail: "Mismatch or expired",
      stop: "Stop",
      gateNote:
        "Route every protected action through the gate. Check revocation, expiry and replay at execution.",
      docs: "Explore the integration guides",
      usesTitle: "Start with the action to protect.",
      uses: [
        {
          key: "transfer",
          symbol: "¥",
          title: "Transfers & account changes",
          conditions: ["Recipient", "Amount", "Approval"],
        },
        {
          key: "decrypt",
          symbol: "↗",
          title: "Decryption & data access",
          conditions: ["Person", "Target", "Scope"],
        },
        {
          key: "api",
          symbol: "{ }",
          title: "APIs & workflows",
          conditions: ["Permission", "Arguments", "Action"],
        },
      ],
      example: "View example",
      closeTitle: "Bring proof to your next action.",
    };
const attackerModels = [
  { name: "Opus 4.8", results: [1, 1, 1, 1, 1] },
  { name: "GPT-5.5", results: [1, 1, 0, 1, 1] },
  { name: "DeepSeek v4 Pro", results: [1, 1, 0, 1, 1] },
  { name: "Qwen3.7 Max", results: [1, 0, 1, 0, 1] },
  { name: "Kimi-K2.6", results: [0, 0, 0, 1, 1] },
  { name: "Kimi K2.7 Code", results: [1, 0, 0, 1, 1] },
  { name: "GLM-5.2", results: [1, 1, 1, 1, 1] },
] as const;
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <div class="cy-container">
      <section class="cy-hero" aria-labelledby="cy-title">
        <h1 id="cy-title">Cyber</h1>
        <p class="cy-claim">{C.headline.map((line) => <span>{line}</span>)}</p>
        <div class="cy-actions">
          <a
            class="cy-btn cy-primary"
            href={DISCOVERY_CALL_URL[locale]}
            target="_blank"
            rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
          ><a class="cy-btn cy-ghost" href="#cy-difference"
            >{C.learn} <span aria-hidden="true">↓</span></a
          >
        </div>
        <figure class="cy-plate-stage">
          <article
            class="cy-plate"
            aria-labelledby="cy-card-title"
            aria-describedby="cy-card-caption"
          >
            <div class="cy-card-top">
              <span class="cy-wordmark">LEMMA / CYBER</span><span class="cy-sample">{C.sample}</span
              >
            </div>
            <h2 id="cy-card-title">{C.cardTitle}</h2>
            <ol class="cy-bind-chain">
              {
                C.chain.map((item, index) => (
                  <li>
                    <div class="cy-chain-content">
                      <span class="cy-card-label">
                        0{index + 1} / {item.label}
                      </span>
                      <svg
                        class="cy-chain-icon"
                        width="28"
                        height="28"
                        viewBox="0 0 28 28"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d={item.icon} />
                      </svg>
                      <strong>{item.value}</strong>
                      <span class="cy-card-detail">{item.note}</span>
                    </div>
                    {index < C.chain.length - 1 && (
                      <span class="cy-chain-arrow" aria-hidden="true">
                        →
                      </span>
                    )}
                  </li>
                ))
              }
            </ol>
            <div class="cy-binding"><span>{C.binding}</span></div>
            <ul class="cy-card-conditions">
              {
                C.limits.map((limit) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {limit}
                  </li>
                ))
              }
            </ul>
            <div class="cy-card-result">
              <span class="cy-result-mark" aria-hidden="true">✓</span><span>{C.proof}</span><span
                class="cy-proof-type">ZK PROOF</span
              >
            </div>
          </article>
          <figcaption id="cy-card-caption">
            {C.cardNote}<a href={L("/cyber/verify/?card=transfer")}
              >{C.cardLink} <span aria-hidden="true">↗</span></a
            >
          </figcaption>
        </figure>
      </section>

      <section id="cy-difference" class="cy-section" aria-labelledby="cy-difference-title">
        <h2 id="cy-difference-title">{C.compareTitle}</h2>
        <figure class="cy-key-diagram" aria-describedby="cy-difference-caption">
          <div class="cy-key-flow">
            <div class="cy-difference-item">
              <div class="cy-symbol-stage" aria-hidden="true">
                <svg class="cy-key-shape" width="96" height="116" viewBox="0 0 96 116" fill="none">
                  <circle cx="40" cy="28" r="22" stroke-width="10"></circle>
                  <path d="M40 50v58m0-28h22m-22 22h22" stroke-width="12"></path>
                </svg>
              </div>
              <span>{C.compareLabels[0]}</span>
            </div>
            <span class="cy-difference-arrow" aria-hidden="true">→</span>
            <div class="cy-difference-item">
              <div class="cy-symbol-stage" aria-hidden="true">
                <div class="cy-proof-shape">
                  <span class="cy-mini-wordmark">LEMMA</span>
                  <svg width="80" height="26" viewBox="0 0 80 26" fill="none">
                    <path d="M17 13h17m12 0h17"></path>
                    <circle cx="11" cy="13" r="6"></circle>
                    <circle cx="40" cy="13" r="6"></circle>
                    <circle cx="69" cy="13" r="6"></circle>
                  </svg>
                  <span class="cy-mini-proof">ZK PROOF <span>✓</span></span>
                </div>
              </div>
              <span>{C.compareLabels[1]}</span>
            </div>
          </div>
          <figcaption id="cy-difference-caption">
            <strong>{C.compareSummary}</strong>
            <span>{C.compareNote}</span>
          </figcaption>
        </figure>
      </section>

      {
        [false, true].map((secure, modeIndex) => (
          <section
            class:list={["cy-section", "cy-result-panel", { "cy-secure": secure }]}
            aria-labelledby={secure ? "cy-secure-title" : "cy-insecure-title"}
          >
            <h2 id={secure ? "cy-secure-title" : "cy-insecure-title"}>{C.modes[modeIndex]}</h2>
            <p class="cy-mode">
              {secure ? "SECURE" : "INSECURE"} / {C.evidence}
            </p>
            <div
              class="cy-matrix-scroll"
              role="region"
              aria-label={`${C.modes[modeIndex]} / ${C.scenario}`}
              tabindex="0"
            >
              <table class="cy-dot-grid">
                <>
                  <thead>
                    <tr>
                      <th scope="col">{C.scenario}</th>
                      {attackerModels.map((model) => (
                        <th scope="col">
                          <span class="cy-model-name">{model.name}</span>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {C.scenarios.map((name, scenarioIndex) => (
                      <tr>
                        <th scope="row">{name}</th>
                        {attackerModels.map((model) => (
                          <td>
                            <span
                              class:list={[
                                "cy-dot",
                                { "cy-lit": secure || model.results[scenarioIndex] === 1 },
                              ]}
                              aria-hidden="true"
                            />
                            <span class="cy-sr-only">
                              {secure
                                ? C.blocked
                                : model.results[scenarioIndex] === 1
                                  ? C.attack
                                  : C.unfinished}
                            </span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </>
              </table>
            </div>
            <p class="cy-legend">
              {secure ? (
                <span>
                  <i class="cy-legend-dot cy-legend-blocked" aria-hidden="true" />
                  {C.blocked}
                </span>
              ) : (
                <>
                  <span>
                    <i class="cy-legend-dot cy-legend-attack" aria-hidden="true" />
                    {C.attack}
                  </span>
                  <span>
                    <i class="cy-legend-dot" aria-hidden="true" />
                    {C.unfinished}
                  </span>
                </>
              )}
            </p>
            {secure && (
              <a
                class="cy-source"
                href="https://github.com/lemmaoracle/example-cyber-attack#readme"
                target="_blank"
                rel="noopener"
              >
                {C.source} <span aria-hidden="true">↗</span>
              </a>
            )}
          </section>
        ))
      }

      <section class="cy-section" aria-labelledby="cy-gate-title">
        <h2 id="cy-gate-title">{C.gateTitle}</h2>
        <figure
          class="cy-gate-diagram"
          aria-labelledby="cy-gate-title"
          aria-describedby="cy-gate-caption"
        >
          <div class="cy-gate-flow">
            <div class="cy-node">{C.request}</div><span class="cy-arrow" aria-hidden="true">→</span
            ><div class="cy-gate"><strong>Cyber</strong><span>{C.gate}</span></div><div
              class="cy-pass"
            >
              <span>{C.pass}</span><span class="cy-arrow" aria-hidden="true">→</span>
            </div><div class="cy-node">{C.system}</div>
          </div>
          <ul class="cy-gate-checks">
            {
              C.checks.map((check) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {check}
                </li>
              ))
            }
          </ul>
          <div class="cy-stop">
            <span>{C.fail}</span><span aria-hidden="true">↓</span><strong
              ><span aria-hidden="true">×</span> {C.stop}</strong
            >
          </div>
          <figcaption id="cy-gate-caption" class="cy-note">{C.gateNote}</figcaption>
        </figure>
        <a class="cy-source" href={L("/guides/")}>{C.docs} <span aria-hidden="true">↗</span></a>
      </section>

      <section class="cy-section" aria-labelledby="cy-uses-title">
        <h2 id="cy-uses-title">{C.usesTitle}</h2>
        <div class="cy-cards">
          {
            C.uses.map((use, index) => (
              <a class="cy-example-card" href={L(`/cyber/verify/?card=${use.key}`)}>
                <>
                  <span class="cy-use-top">
                    <>
                      <span>LEMMA / CYBER</span>
                      <span>0{index + 1}</span>
                    </>
                  </span>
                  <span class="cy-use-symbol" aria-hidden="true">
                    {use.symbol}
                  </span>
                  <h3>{use.title}</h3>
                  <ul>
                    {use.conditions.map((condition) => (
                      <li>{condition}</li>
                    ))}
                  </ul>
                  <span class="cy-use-link">
                    {C.example} <span aria-hidden="true">→</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </section>
      <section class="cy-section cy-close" aria-labelledby="cy-close-title">
        <h2 id="cy-close-title">{C.closeTitle}</h2><div class="cy-actions">
          <a
            class="cy-btn cy-primary"
            href={DISCOVERY_CALL_URL[locale]}
            target="_blank"
            rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
          ><a class="cy-btn cy-ghost" href={L("/verify/")}
            >{C.live} <span aria-hidden="true">→</span></a
          >
        </div>
      </section>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cy-page {
    background: #12140e;
    color: #f4f7ef;
    font-family: "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    line-height: 1.85;
    padding-bottom: 100px;
  }
  .cy-page *,
  .cy-page *::before,
  .cy-page *::after {
    box-sizing: border-box;
  }
  .cy-container {
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: 32px;
    text-align: center;
  }
  .cy-hero {
    padding-top: 72px;
  }
  .cy-page h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(80px, 15vw, 150px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.065em;
    margin: 0 0 24px;
  }
  .cy-page h2,
  .cy-page h3,
  .cy-claim {
    line-break: strict;
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .cy-page h2 {
    font-family: "Space Grotesk", "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    font-size: clamp(23px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 30px;
  }
  .cy-claim {
    margin: 0 auto 30px;
    font-size: clamp(18px, 2.5vw, 24px);
    line-height: 1.8;
  }
  .cy-claim > span {
    display: inline-block;
  }
  .cy-claim > span + span {
    margin-left: 0.35em;
  }
  .cy-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cy-page a {
    color: inherit;
    text-decoration: none;
  }
  .cy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: 999px;
    border: 1px solid #69705c;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
  }
  .cy-page .cy-primary {
    color: #12140e;
    background: #a8e010;
    border-color: #a8e010;
  }
  .cy-ghost {
    background: transparent;
  }
  .cy-page a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cy-page a:focus-visible,
  .cy-matrix-scroll:focus-visible {
    outline: 2px solid #c5e987;
    outline-offset: 5px;
  }
  .cy-page .cy-primary:hover {
    background: #b5eb29;
    text-decoration: none;
  }
  .cy-section {
    margin-top: 112px;
    scroll-margin-top: 100px;
  }
  .cy-note {
    max-width: 600px;
    margin: 24px auto 0;
    color: #929c85;
    font-size: 11px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  /* Shared brushed silver finish, with fine diagonal grooves and a raised edge. */
  .cy-plate,
  .cy-proof-shape,
  .cy-example-card {
    border: 1px solid #ffffffb3;
    color: #1e293b;
    background:
      repeating-linear-gradient(115deg, #0f172a0d 0 1px, transparent 1px 4px),
      linear-gradient(135deg, #fff, #e2e8f0 48%, #f8fafc 76%, #cbd5e1);
    box-shadow:
      inset 0 1px 0 #fff,
      0 2px 0 #64748b,
      0 4px 0 #e2e8f0,
      0 20px 40px -18px #000b;
  }
  .cy-plate-stage {
    max-width: 560px;
    margin: 44px auto 0;
  }
  .cy-plate {
    position: relative;
    padding: 25px 28px 0;
    border-radius: 16px;
  }
  .cy-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .cy-wordmark {
    font:
      10px/1.5 "Space Mono",
      monospace;
    letter-spacing: 0.1em;
  }
  .cy-sample {
    font-size: 10px;
    color: #626e58;
  }
  .cy-plate h2 {
    font-size: 22px;
    margin-block: 24px 26px;
    font-weight: 500;
  }
  .cy-bind-chain {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .cy-bind-chain li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .cy-chain-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .cy-card-label {
    font-size: 10px;
    color: #637256;
  }
  .cy-chain-icon {
    stroke: #617451;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-block: 13px 12px;
  }
  .cy-bind-chain strong {
    font-size: 13px;
