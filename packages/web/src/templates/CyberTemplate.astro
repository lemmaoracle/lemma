    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    padding: 15px 30px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    line-height: 1;
  }

  .cy-btn-lime {
    background: var(--lime);
    color: var(--ink);
    border: 1.5px solid var(--lime);
  }

  .cy-btn-lime:hover {
    background: var(--lime-hover);
    border-color: var(--lime-hover);
  }

  .cy-btn-outline-dark {
    background: transparent;
    color: var(--ink);
    border: 1.5px solid #8c9484;
  }

  .cy-btn-outline-dark:hover {
    border-color: var(--ink);
    background: rgba(18, 20, 14, 0.05);
  }

  .cy-btn-outline-light {
    background: transparent;
    color: #f4f7ef;
    border: 1.5px solid rgba(244, 247, 239, 0.35);
  }

  .cy-btn-outline-light:hover {
    border-color: #f4f7ef;
    background: rgba(244, 247, 239, 0.08);
  }

  /* ==========================================================================
     CHAPTER 1A: HERO (1-Column Centered Copy + Compact Bottom-Cropped Dashboard)
     Dashboard tone uses workers/packages/dashboard tokens (Slate / White / Blue)
     ========================================================================== */
  .cy-hero-sec {
    background: var(--pale-stone);
    padding: 64px 0 0;
    overflow: hidden;
  }

  .cy-hero-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .cy-hero-copy {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cy-hero-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: #2b4200;
    background: var(--lime-tint);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .cy-hero-h1 {
    font-family: var(--font-heading);
    font-size: clamp(42px, 5.4vw, 66px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--ink);
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .cy-hero-lead {
    font-size: 17.5px;
    line-height: 1.8;
    color: var(--ink-soft);
    margin: 0 0 28px;
    max-width: 52ch;
    text-wrap: balance;
  }

  .cy-hero-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .cy-hero-visual-col {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* ─── Atmospheric Dashboard Product Surface (matches workers/packages/dashboard/src/styles/global.css) ─── */
  .db-shell {
    --db-canvas: #f8fafc;
    --db-surface: #ffffff;
    --db-surface-2: #f1f5f9;
    --db-ink: #0f172a;
    --db-ink-strong: #020617;
    --db-ink-muted: #64748b;
    --db-ink-faint: #94a3b8;
    --db-line: rgba(15, 23, 42, 0.08);
    --db-line-strong: rgba(15, 23, 42, 0.14);
    --db-divider: rgba(15, 23, 42, 0.05);
    --db-accent: #2563eb;
    --db-accent-bg: rgba(37, 99, 235, 0.08);
    --db-accent-border: rgba(37, 99, 235, 0.25);
    --db-success: #15803d;
    --db-success-bg: rgba(34, 197, 94, 0.12);
    --db-danger: #b91c1c;
    --db-danger-bg: rgba(220, 38, 38, 0.1);
    --db-sans: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Text", "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif;
    --db-mono: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, Monaco, Consolas, monospace;

    position: relative;
    display: grid;
    grid-template-columns: 184px minmax(0, 1fr);
    height: 312px;
    background: var(--db-canvas);
    color: var(--db-ink);
    font-family: var(--db-sans);
    font-size: 13px;
    line-height: 1.45;
    border-radius: 14px 14px 0 0;
    border: 1px solid var(--db-line-strong);
    border-bottom: none;
    box-shadow:
      0 -4px 40px rgba(15, 23, 42, 0.08),
      0 16px 48px rgba(15, 23, 42, 0.1);
    overflow: hidden;
    text-align: left;
  }

  /* Bottom crop fade-out so the lower edge feels naturally cut off */
  .db-shell::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 54px;
    background: linear-gradient(180deg, rgba(248, 250, 252, 0) 0%, rgba(248, 250, 252, 0.88) 100%);
    pointer-events: none;
  }

  /* Abstract UI Skeleton Bars (reduces text clutter while preserving realistic product density) */
  .db-skel {
    display: inline-block;
    height: 7px;
    border-radius: 999px;
    background: #e2e8f0;
    flex-shrink: 0;
  }
  .db-skel.w-44 { width: 44px; }
  .db-skel.w-52 { width: 52px; }
  .db-skel.w-56 { width: 56px; }
  .db-skel.w-64 { width: 64px; }
  .db-skel.w-88 { width: 88px; }

  /* Left Sidebar */
  .db-sidebar {
    background: var(--db-surface);
    border-right: 1px solid var(--db-line);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .db-switcher {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 8px;
    border-radius: 6px;
    border: 1px solid var(--db-line);
    background: var(--db-surface);
    color: var(--db-ink-strong);
    font-size: 12.5px;
    font-weight: 500;
  }

  .db-switcher :global(.db-logo) {
    height: 16px;
    width: auto;
    display: block;
    flex-shrink: 0;
    color: var(--db-ink-strong);
  }

  .db-switcher-label {
    font-weight: 600;
    color: var(--db-ink-strong);
    white-space: nowrap;
  }

  .db-switcher-chevron {
    width: 12px;
    height: 12px;
    margin-left: auto;
    color: var(--db-ink-faint);
    flex-shrink: 0;
  }

  .db-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .db-nav li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    color: var(--db-ink-muted);
  }

  .db-nav li.is-active {
    background: var(--db-accent-bg);
    color: var(--db-accent);
    font-weight: 600;
  }

  .db-nav-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .db-nav-badge {
    margin-left: auto;
    font-style: normal;
    font-family: var(--db-mono);
    font-size: 10.5px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--db-surface-2);
    color: var(--db-ink-muted);
  }

  .db-nav-badge.is-danger {
    background: var(--db-danger-bg);
    color: var(--db-danger);
  }

  .db-status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--db-success);
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.35);
    flex-shrink: 0;
  }

  /* Main Dashboard Workspace */
  .db-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--db-canvas);
  }

  .db-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px;
    background: var(--db-surface);
    border-bottom: 1px solid var(--db-line);
  }

  .db-topbar-titles {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .db-topbar-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--db-ink-strong);
    letter-spacing: -0.01em;
  }

  .db-live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 500;
    color: var(--db-ink-muted);
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--db-surface-2);
  }

  .db-topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .db-theme-btn {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid var(--db-line);
    background: var(--db-surface);
    color: var(--db-ink-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .db-theme-btn svg {
    width: 12px;
    height: 12px;
  }

  .db-content {
    padding: 14px 18px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* 3 Compact KPI Cards Row */
  .db-kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .db-kpi-card {
    background: var(--db-surface);
    border: 1px solid var(--db-line);
    border-radius: 8px;
    padding: 9px 13px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .db-kpi-label {
    font-size: 10.5px;
    font-weight: 500;
    color: var(--db-ink-muted);
  }

  .db-kpi-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .db-kpi-num {
    font-size: 19px;
    font-weight: 600;
    color: var(--db-ink-strong);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .db-kpi-num.is-danger {
    color: var(--db-danger);
  }

  /* Pills & Kind Tags */
  .db-pill {
    display: inline-flex;
    align-items: center;
    font-size: 10.5px;
    font-weight: 600;
    padding: 1.5px 7px;
    border-radius: 999px;
    white-space: nowrap;
    line-height: 1.4;
  }

  .db-pill.is-success {
    background: var(--db-success-bg);
    color: var(--db-success);
  }

  .db-pill.is-danger {
    background: var(--db-danger-bg);
    color: var(--db-danger);
  }

  .db-pill.is-neutral {
    background: var(--db-accent-bg);
    color: var(--db-accent);
  }

  .db-kind-tag {
    display: inline-block;
    font-family: var(--db-mono);
    font-size: 10px;
    font-weight: 500;
    padding: 1.5px 6px;
    border-radius: 4px;
    background: var(--db-surface-2);
    color: var(--db-ink-muted);
    white-space: nowrap;
  }

  /* 2-Column Workspace: Left Table / Right Diff Card */
  .db-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: 12px;
    align-items: start;
  }

  .db-table-wrap {
    background: var(--db-surface);
    border: 1px solid var(--db-line);
    border-radius: 8px 8px 0 0;
    overflow: hidden;
  }

  .db-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }

  .db-table th {
    padding: 7px 11px;
    text-align: left;
    font-size: 9.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--db-ink-faint);
    background: var(--db-surface);
    border-bottom: 1px solid var(--db-line);
    white-space: nowrap;
  }

  .db-table td {
    padding: 8px 11px;
    border-bottom: 1px solid var(--db-divider);
    color: var(--db-ink);
    vertical-align: middle;
  }

  .db-table tbody tr.is-selected {
    background: var(--db-accent-bg);
  }

  .db-op-cell {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .db-td-mono {
    font-family: var(--db-mono);
    font-size: 10.5px;
    color: var(--db-ink-muted);
    white-space: nowrap;
  }

  .db-td-strong {
    font-weight: 500;
    color: var(--db-ink-strong);
    white-space: nowrap;
  }

  /* Right Detail Inspector Panel (Minimal Visual Diff) */
  .db-detail-panel {
    background: var(--db-surface);
    border: 1px solid var(--db-line-strong);
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .db-detail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 13px;
    border-bottom: 1px solid var(--db-line);
  }

  .db-detail-title-group {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .db-detail-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--db-ink-strong);
  }

  .db-detail-body {
    padding: 10px 13px 14px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .db-diff-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 9px;
    border-radius: 6px;
    font-family: var(--db-mono);
    font-size: 11px;
  }

  .db-diff-row.is-ok {
    background: var(--db-surface-2);
    border: 1px solid var(--db-line);
    color: var(--db-ink-muted);
  }

  .db-diff-row.is-ng {
    background: var(--db-danger-bg);
    border: 1px solid rgba(185, 28, 28, 0.22);
    color: var(--db-danger);
    font-weight: 600;
  }

  .db-diff-key {
    font-size: 10.5px;
    opacity: 0.85;
  }

  .db-diff-val {
    font-family: var(--db-mono);
    font-size: 11px;
  }

  .db-detail-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-top: 3px;
  }

  .db-btn-primary {
    font-size: 11px;
    font-weight: 500;
    padding: 4px 9px;
    border-radius: 5px;
    background: var(--db-accent);
    color: #ffffff;
    white-space: nowrap;
  }

  /* ==========================================================================
     CHAPTER 1B: INTRO — EXECUTIVE EDITORIAL SPLIT & BENTO GRID
     Full-Bleed Deep Obsidian (#121611) + 50/50 Split + Bento
     ========================================================================== */
  .cy-exec-intro {
    background: var(--obsidian-stage);
    color: #f4f7ef;
    padding: 96px 0 104px;
  }

  .cy-exec-header {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: end;
    gap: 56px;
    padding-bottom: 48px;
    margin-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .cy-exec-eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: var(--lime);
    background: rgba(168, 224, 16, 0.12);
    border: 1px solid rgba(168, 224, 16, 0.35);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  .cy-exec-h2 {
    font-family: var(--font-heading);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
    text-wrap: balance;
  }

  .cy-exec-lead {
    font-size: 16.5px;
    line-height: 1.9;
    color: #d0d7c9;
    margin: 0;
  }

  /* Executive Before / After Comparison Banner */
  .cy-exec-compare {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 32px;
  }

  .cy-cmp-row {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr) 230px;
    align-items: center;
    gap: 20px;
    padding: 20px 26px;
    border-radius: 16px;
  }

  .cy-cmp-row.is-legacy {
    background: #181c16;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cy-cmp-row.is-gate {
    background: #1b2416;
    border: 1.5px solid rgba(168, 224, 16, 0.55);
  }

  .cy-cmp-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cy-cmp-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cy-cmp-dot.is-legacy {
    background: #ef4444;
  }

  .cy-cmp-dot.is-gate {
    background: var(--lime);
  }

  .cy-cmp-label strong {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
  }

  .cy-cmp-flow {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cy-cmp-step {
    font-size: 13px;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #d8dfd2;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cy-cmp-step.is-weak {
    color: #a3ad9b;
    border-style: dashed;
  }

  .cy-cmp-step.is-bad {
    background: rgba(239, 68, 68, 0.14);
    border-color: rgba(239, 68, 68, 0.4);
    color: #fecaca;
  }

  .cy-cmp-step.is-shield {
    background: var(--lime);
    color: var(--ink);
    border-color: var(--lime);
    font-weight: 700;
  }

  .cy-cmp-step.is-safe {
    background: rgba(168, 224, 16, 0.14);
    border-color: rgba(168, 224, 16, 0.4);
    color: #eef7d8;
    font-weight: 700;
  }

  .cy-cmp-arr {
    font-size: 14px;
    color: #7d8676;
    font-weight: 700;
  }

  .cy-cmp-arr.is-lime {
    color: var(--lime);
  }

  .cy-cmp-verdict {
    font-size: 13px;
    font-weight: 700;
    text-align: right;
  }

  .cy-cmp-verdict.is-legacy {
    color: #fca5a5;
  }

  .cy-cmp-verdict.is-gate {
    color: var(--lime);
  }

  /* 3 Structured Executive Bento Cards */
  .cy-exec-bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .cy-bento-card {
    background: #1a2018;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
  }

  .cy-bento-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cy-bento-num {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    color: var(--lime);
    line-height: 1;
  }

  .cy-bento-tag {
    font-size: 12.5px;
    font-weight: 700;
    color: #dce3d5;
    background: rgba(255, 255, 255, 0.08);
    padding: 5px 12px;
    border-radius: 999px;
  }

  .cy-bento-title {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 14px;
    line-height: 1.4;
  }

  .cy-bento-body {
    font-size: 15px;
    line-height: 1.8;
    color: #c7cfc0;
    margin: 0;
  }

  /* ==========================================================================
     CHAPTER 2: FEATURES (Charcoal Rounded Stage + 3 White Cards + UI Mocks)
     ========================================================================== */
  .cy-features-outer {
    background: #ffffff;
    padding: 64px 0 112px;
  }

  .cy-features-stage {
    background: var(--charcoal-stage);
    border-radius: 28px;
    padding: 80px 48px 56px;
    color: #ffffff;
  }

  .cy-features-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .cy-features-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 18px;
    text-wrap: balance;
  }

  .cy-features-header p {
    font-size: 16px;
    line-height: 1.8;
    color: #c7cfc0;
    margin: 0;
  }

  .cy-features-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cy-fcard {
    background: #ffffff;
    color: var(--ink);
    border-radius: 20px;
    padding: 36px 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }

  .cy-fcard-step {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .cy-fcard-top h3 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 6px;
    line-height: 1.25;
  }

  .cy-fcard-sub {
    font-size: 15px;
    font-weight: 700;
    color: var(--lime-ink);
    margin: 0 0 14px;
  }

  .cy-fcard-desc {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 18px;
  }

  .cy-fcard-link {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .cy-fcard-link:hover {
    color: var(--lime-ink);
  }

  /* Light Mode UI Mocks inside White Feature Cards */
  .cy-fcard-mock {
    background: #f6f8f4;
    border: 1px solid #dce1d7;
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cy-ui-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .cy-ui-mini {
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 10px;
    padding: 12px;
    box-shadow: 0 2px 6px rgba(18, 20, 14, 0.04);
  }

  .cy-ui-mini-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .cy-ui-mini-head strong {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-ui-mini-head strong.is-danger {
    color: var(--err);
  }

  .cy-ui-ico-ok {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--lime-tint);
    color: #2b4200;
    font-size: 12px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .cy-ui-ico-warn {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #fee2e2;
    color: var(--err);
    font-size: 12px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .cy-ui-mini > span {
    display: block;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  .cy-ui-box {
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 10px;
    padding: 14px;
    box-shadow: 0 2px 6px rgba(18, 20, 14, 0.04);
  }

  .cy-ui-table-head {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    padding-bottom: 8px;
    border-bottom: 1px solid #eef1eb;
  }

  .cy-ui-table-row {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr auto;
    align-items: center;
    padding: 8px 0;
    font-size: 12.5px;
    border-bottom: 1px solid #f6f8f4;
  }

  .cy-ui-table-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cy-ui-agent {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--ink);
  }

  .dot-ok,
  .dot-err {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-ok {
    background: #4e7a00;
  }
  .dot-err {
    background: var(--err);
  }

  .cy-ui-table-row code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
  }

  .badge-ok,
  .badge-err {
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
  }
  .badge-ok {
    background: var(--lime-tint);
    color: #2b4200;
  }
  .badge-err {
    background: #fee2e2;
    color: var(--err);
  }

  .cy-ui-alert-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--ink);
  }

  .cy-ui-warn-triangle {
    color: #d97706;
    font-size: 12px;
  }

  .cy-ui-stat3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    text-align: left;
  }

  .cy-ui-stat3 small {
    display: block;
    font-size: 11.5px;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .cy-ui-stat3 strong {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-ui-stat3 strong.is-danger {
    color: var(--err);
  }

  .cy-ui-bar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .cy-ui-bar-head strong {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-ui-bar-sub {
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .cy-ui-meter {
    display: grid;
    grid-template-columns: 5fr 3fr 2fr;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
  }
  .m-green {
    background: var(--lime);
  }
  .m-amber {
    background: #fbbf24;
  }
  .m-red {
    background: var(--err);
  }

  .cy-ui-sender-box {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 12px;
    align-items: center;
  }

  .cy-ui-sender-col small {
    display: block;
    font-size: 11.5px;
    color: var(--muted);
  }

  .cy-ui-sender-col strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    margin: 3px 0 8px;
  }

  .cy-ui-gauge-pill {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    background: #fef3c7;
    color: #b45309;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .cy-ui-checks-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cy-ui-chk {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--ink-soft);
  }

  .chk-ng {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fee2e2;
    color: var(--err);
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  /* ==========================================================================
     CHAPTER 4: FACT (Empirical Attack Results — Deep Obsidian Stage)
     ========================================================================== */
  .cy-fact-sec {
    background: #ffffff;
    padding: 112px 0 64px;
    scroll-margin-top: 80px;
  }

  .cy-fact-stage {
    background: var(--obsidian-stage);
    color: #ffffff;
    border-radius: 28px;
    padding: 72px 56px;
  }

  .cy-fact-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 48px;
  }

  .cy-eyebrow-dark {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lime);
    background: rgba(168, 224, 16, 0.14);
    border: 1px solid rgba(168, 224, 16, 0.35);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .cy-fact-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: #ffffff;
    margin: 0 0 18px;
    text-wrap: balance;
  }

  .cy-fact-header p {
    font-size: 16px;
    line-height: 1.8;
    color: #c7cfc0;
    margin: 0;
  }

  .cy-fact-kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 820px;
    margin: 0 auto 24px;
  }

  .cy-kpi-card {
    padding: 36px 32px;
    border-radius: 20px;
    text-align: center;
  }

  .cy-kpi-card.is-before {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(248, 113, 113, 0.35);
  }

  .cy-kpi-card.is-after {
    background: #ffffff;
    color: var(--ink);
  }

  .cy-kpi-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .cy-kpi-card.is-before .cy-kpi-label {
    color: #fca5a5;
  }

  .cy-kpi-card.is-after .cy-kpi-label {
    color: var(--lime-ink);
  }

  .cy-kpi-number {
    font-family: var(--font-heading);
    font-size: clamp(48px, 5vw, 60px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }

  .cy-kpi-card.is-before .cy-kpi-number {
    color: #f87171;
  }

  .cy-kpi-card.is-after .cy-kpi-number {
    color: var(--ink);
  }

  .cy-kpi-number small {
    font-size: 26px;
    opacity: 0.65;
  }

  .cy-kpi-desc {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
  }

  .cy-fact-subnote {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 40px;
    font-size: 14px;
    line-height: 1.75;
    color: #c7cfc0;
  }

  /* White Table Card inside Fact Stage */
  .cy-table-card {
    background: #ffffff;
    color: var(--ink);
    border-radius: 20px;
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .cy-fact-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 15px;
  }

  .cy-fact-table caption {
    padding: 20px 28px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    background: #f6f8f4;
    border-bottom: 1px solid #dce1d7;
    text-align: left;
  }

  .cy-fact-table th,
  .cy-fact-table td {
    padding: 18px 28px;
    border-bottom: 1px solid #eef1eb;
  }

  .cy-fact-table tr:last-child th,
  .cy-fact-table tr:last-child td {
    border-bottom: none;
  }

  .cy-fact-table thead th {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    background: #ffffff;
    border-bottom: 2px solid #dce1d7;
  }

  .cy-fact-table tbody th {
    font-weight: 700;
    color: var(--ink);
  }

  .cell-without {
    color: var(--err);
    font-weight: 600;
  }

  .cell-with {
    color: #2b4200;
    font-weight: 700;
  }

  .status-icon-ng,
  .status-icon-ok {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 12px;
    margin-right: 6px;
  }

  .status-icon-ng {
    background: #fee2e2;
    color: var(--err);
  }

  .status-icon-ok {
    background: var(--lime-tint);
    color: #2b4200;
  }

  .cy-probe-details {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    padding: 18px 24px;
    margin-bottom: 28px;
  }

  .cy-probe-details summary {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cy-probe-details summary::-webkit-details-marker {
    display: none;
  }

  .cy-probe-body {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 14.5px;
    color: #e2e6dd;
    line-height: 1.75;
  }

  .cy-probe-note {
    font-size: 13px;
    color: #a3ad9b;
    margin-top: 8px;
  }

  .cy-fact-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 13px;
    color: #a3ad9b;
  }

  .cy-fact-foot p {
    margin: 0;
  }

  .cy-fact-extlink {
    color: var(--lime);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cy-fact-extlink:hover {
    color: #ffffff;
  }

  /* ==========================================================================
     CHAPTER 5: HOW TO START (Clean White Canvas + 3 Step Cards)
     ========================================================================== */
  .cy-start-sec {
    background: #ffffff;
    padding: 64px 0 112px;
  }

  .cy-light-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .cy-eyebrow-light {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: #dce3d5;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .cy-light-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 18px;
    text-wrap: balance;
  }

  .cy-light-header p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-soft);
    margin: 0;
  }

  .cy-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cy-step-card {
    background: #f6f8f4;
    border: 1px solid #dce1d7;
    border-radius: 20px;
    padding: 36px 32px;
  }

  .cy-step-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: #2b4200;
    background: var(--lime-tint);
    padding: 6px 12px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .cy-step-card h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .cy-step-card p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0;
  }

  /* ==========================================================================
     CHAPTER 5B: PRICING (Clean White / Stone Comparison Table + Addons)
     ========================================================================== */
  .cy-pricing-sec {
    background: #ffffff;
    padding: 0 0 112px;
  }

  .cy-pricing-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 20px;
    border: 1px solid #dce1d7;
    background: #ffffff;
    box-shadow: 0 12px 36px rgba(18, 20, 14, 0.04);
  }

  .cy-pricing-table {
    width: 100%;
    min-width: 840px;
    border-collapse: separate;
    border-spacing: 0;
    text-align: left;
  }

  /* Table Headers */
  .cy-pricing-table th {
    font-weight: normal;
  }

  .cy-th-item {
    width: 22%;
    min-width: 160px;
    background: #f8faf6;
    border-bottom: 2px solid #dce1d7;
    padding: 24px 22px;
    vertical-align: bottom;
  }

  .cy-th-item-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cy-th-col {
    width: 26%;
    min-width: 220px;
    background: #f8faf6;
    border-bottom: 2px solid #dce1d7;
    border-left: 1px solid #e5eae0;
    padding: 24px 22px;
    vertical-align: top;
  }

  .cy-th-col.is-featured {
    background: var(--obsidian-stage);
    border-bottom: 2px solid var(--obsidian-stage);
    border-left: 2px solid var(--obsidian-stage);
    border-right: 2px solid var(--obsidian-stage);
  }

  .cy-th-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #2b4200;
    background: var(--lime-tint);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .cy-th-col.is-featured .cy-th-tag {
    background: var(--lime);
    color: var(--ink);
  }

  .cy-th-name {
    display: block;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }

  .cy-th-col.is-featured .cy-th-name {
    color: #ffffff;
  }

  /* Table Body */
  .cy-pricing-table tbody tr {
    transition: background 0.15s ease;
  }

  .cy-pricing-table tbody tr:hover {
    background: rgba(246, 248, 244, 0.65);
  }

  .cy-td-label {
    background: #fafbfa;
    border-bottom: 1px solid #e8ede4;
    padding: 18px 22px;
    vertical-align: top;
    text-align: left;
  }

  .cy-td-label strong {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }

  .cy-td-note {
    display: block;
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 4px;
    font-weight: 400;
  }

  .cy-td-val {
    border-bottom: 1px solid #e8ede4;
    border-left: 1px solid #e8ede4;
    padding: 18px 22px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    vertical-align: top;
  }

  /* Highlight first row values (Monthly fee) */
  .cy-pricing-table tbody tr:first-child .cy-td-val {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-pricing-table tbody tr:first-child .cy-td-val.is-featured {
    font-size: 18px;
    color: #1f3700;
  }

  .cy-td-val.is-featured {
    background: #f7faf3;
    border-left: 2px solid var(--obsidian-stage);
    border-right: 2px solid var(--obsidian-stage);
    font-weight: 500;
    color: var(--ink);
  }

  .cy-pricing-table tbody tr:last-child .cy-td-label,
  .cy-pricing-table tbody tr:last-child .cy-td-val {
    border-bottom: none;
  }

  .cy-pricing-table tbody tr:last-child .cy-td-val.is-featured {
    border-bottom: 2px solid var(--obsidian-stage);
  }

  .cy-pricing-addons {
    margin-top: 32px;
    background: #f6f8f4;
    border: 1px solid #dce1d7;
    border-radius: 20px;
    padding: 28px 30px;
  }

  .cy-addons-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .cy-addons-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .cy-addon-card {
    background: #ffffff;
    border: 1px solid #e2e7dd;
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cy-addon-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cy-addon-head strong {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--ink);
  }

  .cy-addon-price {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    color: #2b4200;
    background: var(--lime-tint);
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .cy-addon-card p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0;
  }

  .cy-pricing-note {
    text-align: center;
    font-size: 13px;
    color: var(--muted);
    margin: 22px 0 0;
  }

  /* ==========================================================================
     CHAPTER 6: FAQ (Pale Stone #eef1eb Full-Bleed Section)
     ========================================================================== */
  .cy-faq-sec {
    background: var(--pale-stone);
    padding: 100px 0;
  }

  .cy-faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cy-faq-card {
    background: #ffffff;
    border: 1px solid #dce1d7;
    border-radius: 16px;
    padding: 22px 28px;
  }

  .cy-faq-card summary {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cy-faq-card summary::-webkit-details-marker {
    display: none;
  }

  .cy-faq-plus {
    font-family: var(--font-mono);
