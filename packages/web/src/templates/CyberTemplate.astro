---
/**
 * Cyber public page. Silver card styling is ported from the first-party dashboard:
 * packages/dashboard/src/styles/cyber.css (.cyber-draft, .cyber-foil, slots/layers).
 * Example outcomes: example-cyber-attack/README.md, Primary end-to-end result.
 * Samples are illustrative; enforcement requires a gate before execution.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";

export interface CyberTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}
const { locale, t, base } = Astro.props as CyberTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);
const C = isJa ? {
  title: "Cyber — 不正な実行を、手前で止める。｜Lemma",
  description: "権限があっても、条件を満たさない操作は実行前に止める。",
  headline: "不正な実行を、手前で止める。",
  lede: "盗難鍵や騙された承認者では、不正も許可済みに。Cyber は条件外の実行を止める。",
  call: "相談 →", live: "検証する →",
  example: "例 / 検証済み", cardTitle: "送金条件",
  cardNote: "架空の値",
  layers: [
    { title: "定義", value: "送信先 / 金額", empty: true },
    { title: "条件", value: "例：送信先 = demo:recipient / 金額 ≤ 100", empty: false },
    { title: "証明", value: "例：条件一致を検証済み", empty: false },
  ],
  diagramTitle: "権限の先に、条件の検証を。",
  before: "これまで", after: "Cyber",
  permission: "権限を確認", condition: "条件を検証", pass: "通る", block: "通らない",
  diagramNote: "例：盗難鍵でも条件外は止まる。",
  principleTitle: "許可だけに、頼らない。",
  principle: "ACL・JWT・署名・承認は権限、SIEM は異常を確認。Cyber は実行直前に検証。",
  workTitle: "業務の実行前に。",
  uses: [
    { title: "送金・口座変更", line: "振込先や金額が条件を外れたら、実行前に止まる。" },
    { title: "復号・データ持ち出し", line: "復号条件を満たさなければ、鍵があっても通らない。" },
    { title: "API・ワークフロー実行", line: "実行直前の条件検証を通らなければ、処理に入らない。" },
  ],
  evidenceTitle: "公開検証の結果。",
  metricLabels: ["突破", "阻止", "シナリオ", "層"],
  source: "検証例 / Opus 4.8 · README ↗",
  closeTitle: "止めたい操作から。",
} : {
  title: "Cyber — Stop unauthorized actions before execution | Lemma",
  description: "Cyber stops operations that fail defined conditions, even when they carry valid permissions.",
  headline: "Stop unauthorized actions before execution.",
  lede: "A stolen key or deceived approver can make an unauthorized instruction look approved. Cyber stops operations that fail defined conditions before execution.",
  call: "Talk to us →", live: "Verify live →",
  example: "Example / verified", cardTitle: "Transfer conditions",
  cardNote: "Illustrative values",
  layers: [
    { title: "Definition", value: "Recipient / amount", empty: true },
    { title: "Conditions", value: "Example: recipient = demo:recipient / amount ≤ 100", empty: false },
    { title: "Proof", value: "Example: condition match verified", empty: false },
  ],
  diagramTitle: "Check conditions beyond permissions.",
  before: "Existing defenses", after: "Cyber",
  permission: "Check permissions", condition: "Verify conditions", pass: "Action passes", block: "Action blocked",
  diagramNote: "Example: a stolen key still fails the conditions.",
  principleTitle: "Permission alone is insufficient.",
  principle: "ACLs, JWTs, signatures and approvals check authority; SIEM looks for anomalies. Cyber verifies defined conditions immediately before execution.",
  workTitle: "Built for your operations.",
  uses: [
    { title: "Transfers & account changes", line: "Stop before execution when recipients or amounts fall outside defined conditions." },
    { title: "Decryption & data export", line: "Reject requests that fail decryption conditions, even with the key." },
    { title: "APIs & workflows", line: "Keep processing from starting when the final condition check fails." },
  ],
  evidenceTitle: "Published validation results.",
  metricLabels: ["Breaches", "Blocked", "Scenarios", "Layers"],
  source: "Validation example / Opus 4.8 · README ↗",
  closeTitle: "Start with the action to protect.",
};
const cardKeys = ["transfer", "decrypt", "api"] as const;
---
<Layout locale={locale} title={C.title} description={C.description} metaType="page" pagePath="/cyber/">
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <div class="cy-container">
      <section class="cy-hero" aria-labelledby="cy-title">
        <div class="cy-hero-copy">
          <p class="cy-eyebrow">Lemma / Cyber</p>
          <h1 id="cy-title">{C.headline}</h1>
          <p class="cy-lede">{C.lede}</p>
          <div class="cy-actions">
            <a class="cy-btn cy-primary" href={DISCOVERY_CALL_URL[locale]} target="_blank" rel="noopener">{C.call}</a>
            <a class="cy-btn cy-ghost" href={L("/verify/")}>{C.live}</a>
          </div>
        </div>
        <article class="cy-plate" aria-labelledby="cy-card-title">
          <div class="cy-card-top"><span class="cy-wordmark">LEMMA / CYBER</span><span class="cy-foil"><i aria-hidden="true"></i>{C.example}</span></div>
          <h2 id="cy-card-title">{C.cardTitle}</h2>
          <p class="cy-card-note">{C.cardNote}</p>
          <dl class="cy-layers">
            {C.layers.map((layer, index) => <div>
              <dt><span class="cy-index">0{index + 1}</span>{layer.title}</dt>
              <dd><div class:list={["cy-slot", { "cy-slot-filled": !layer.empty }]}>{layer.value}</div></dd>
            </div>)}
          </dl>
        </article>
      </section>

      <section class="cy-section" aria-labelledby="cy-diagram-title">
        <h2 id="cy-diagram-title">{C.diagramTitle}</h2>
        <figure class="cy-diagram">
          <div class="cy-flow">
            <h3>{C.before}</h3>
            <div class="cy-node">{C.permission}</div><span aria-hidden="true">→</span>
            <div class="cy-node">{C.pass}</div>
          </div>
          <div class="cy-flow">
            <h3>{C.after}</h3>
            <div class="cy-node">{C.permission}</div><span aria-hidden="true">→</span>
            <div class="cy-node">{C.condition}</div><span aria-hidden="true">→</span>
            <div class="cy-node cy-blocked">{C.block}</div>
          </div>
          <figcaption>{C.diagramNote}</figcaption>
        </figure>
      </section>

      <section class="cy-section cy-principle" aria-labelledby="cy-principle-title">
        <h2 id="cy-principle-title">{C.principleTitle}</h2>
        <p class="cy-sub">{C.principle}</p>
      </section>

      <section class="cy-section" aria-labelledby="cy-work-title">
        <h2 id="cy-work-title">{C.workTitle}</h2>
        <div class="cy-uses">
          {C.uses.map((use, index) => <article>
            <h3>{use.title}</h3>
            <p>{use.line}</p>
            <a href={L(`/cyber/verify/?card=${cardKeys[index]}`)}>{isJa ? "例" : "View example"} →</a>
          </article>)}
        </div>
      </section>

      <section class="cy-section" aria-labelledby="cy-evidence-title">
        <h2 id="cy-evidence-title">{C.evidenceTitle}</h2>
        <dl class="cy-metrics">
          {["5/5", "0/5", "5", "2"].map((value, index) => <div>
            <dt>{C.metricLabels[index]}<small>{[isJa ? "INSECURE / 攻撃成功" : "INSECURE / attacks succeeded", isJa ? "SECURE / 攻撃成功" : "SECURE / attacks succeeded", "example-cyber-attack", isJa ? "権限確認 + 条件検証" : "Permissions + conditions"][index]}</small></dt>
            <dd class:list={{ "cy-blocked": index === 1 }}>{value}</dd>
          </div>)}
        </dl>
        <a class="cy-source" href="https://github.com/lemmaoracle/example-cyber-attack#primary-end-to-end-result-opus-48" target="_blank" rel="noopener">{C.source}</a>
      </section>

      <section class="cy-section cy-close" aria-labelledby="cy-close-title">
        <h2 id="cy-close-title">{C.closeTitle}</h2>
        <div class="cy-actions"><a class="cy-btn cy-primary" href={DISCOVERY_CALL_URL[locale]} target="_blank" rel="noopener">{C.call}</a><a class="cy-btn cy-ghost" href={L("/verify/")}>{C.live}</a></div>
      </section>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cy-page { background: #12140e; color: #f4f7ef; font-family: "Noto Sans JP", sans-serif; line-height: 1.85; padding-bottom: 100px; }
  .cy-page *, .cy-page *::before, .cy-page *::after { box-sizing: border-box; }
  .cy-container { max-width: 1200px; margin-inline: auto; padding-inline: 40px; }
  .cy-eyebrow { font-family: "Space Mono", "Noto Sans JP", monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #bac1af; margin: 0 0 22px; }
  .cy-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); align-items: center; gap: 64px; padding: 90px 0 30px; }
  .cy-hero > * { min-width: 0; }
  h1 { font-family: "Space Grotesk", "Noto Serif JP", serif; font-size: clamp(28px, 3vw, 42px); font-weight: 500; line-height: 1.35; letter-spacing: -.035em; margin: 0 0 24px; overflow-wrap: anywhere; line-break: strict; word-break: auto-phrase; text-wrap: balance; }
  .cy-lede, .cy-sub { color: #c5cbbc; font-size: 15px; max-width: 800px; margin: 0 0 28px; }
  .cy-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cy-btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 20px; border-radius: 8px; border: 1px solid #69705c; font-size: 13px; font-weight: 600; line-height: 1.5; text-decoration: none; }
  .cy-primary { color: #12140e; background: #a8e010; border-color: #a8e010; }
  .cy-ghost { color: #f4f7ef; background: transparent; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid #f4f7ef; outline-offset: 5px; }
  /* First-party dashboard .cyber-draft / .cyber-foil, resolved with light tokens. */
  .cy-plate {
    width: 100%; max-width: 460px; justify-self: center; padding: 30px; border-radius: 20px;
    border: 1px solid rgba(15, 23, 42, .14); color: #020617;
    background: repeating-linear-gradient(115deg, rgba(15, 23, 42, .05) 0 1px, transparent 1px 4px), linear-gradient(135deg, #ffffff, #f1f5f9);
    box-shadow: inset 0 1px 0 #ffffff, 0 3px 0 rgba(15, 23, 42, .14), 0 5px 0 #f1f5f9, 0 18px 36px -12px rgba(15, 23, 42, .4);
    overflow-wrap: anywhere;
  }
  .cy-card-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .cy-wordmark { font-family: "Space Mono", monospace; font-size: 10px; letter-spacing: .1em; }
  .cy-foil { display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(15, 23, 42, .14); border-radius: 6px; padding: 7px 12px; background: linear-gradient(125deg, #f1f5f9, #ffffff, rgba(15, 23, 42, .14), #f1f5f9); box-shadow: inset 0 1px 0 #ffffff, 0 2px 3px rgba(15, 23, 42, .08); font-size: 10px; font-weight: 600; }
  .cy-foil i { width: 6px; height: 6px; border-radius: 50%; background: #a8e010; flex-shrink: 0; }
  .cy-plate h2 { font-size: 24px; font-weight: 500; letter-spacing: -.035em; margin: 28px 0 8px; }
  .cy-card-note, .cy-card-foot { color: #475569; font-size: 11px; margin: 0; }
  .cy-layers { margin: 24px 0; }
  .cy-layers > div { border-top: 1px solid rgba(15, 23, 42, .14); padding: 12px 0; }
  .cy-layers dt { font-size: 12px; font-weight: 600; }
  .cy-index { font-family: "Space Mono", monospace; font-size: 10px; color: #64748b; margin-right: 12px; }
  .cy-layers dd { margin: 8px 0 0; font-size: 12px; line-height: 1.7; }
  .cy-layers dd p { margin: 0 0 8px; color: #475569; }
  .cy-slot { min-width: 0; min-height: 48px; display: flex; align-items: center; padding: 12px; border: 1px dashed rgba(15, 23, 42, .3); border-radius: 9px; background: #f8fafc; color: #64748b; }
  .cy-slot-filled { border-style: solid; color: #020617; }
  .cy-section { margin-top: 100px; }
  .cy-section h2 { max-width: 850px; font-family: "Space Grotesk", "Noto Serif JP", serif; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.5; font-weight: 500; margin: 0 0 24px; line-break: strict; word-break: auto-phrase; text-wrap: balance; }
  .cy-diagram { margin: 36px 0 0; }
  .cy-flow { display: flex; align-items: center; gap: 16px; padding: 24px 0; border-top: 1px solid #3e4435; }
  .cy-flow h3 { flex: 0 0 140px; margin: 0; }
  .cy-node { padding: 18px 24px; border: 1px solid #69705c; border-radius: 10px; text-align: center; font-size: 14px; }
  .cy-blocked { color: #a8e010; }
  .cy-node.cy-blocked { border-color: #a8e010; }
  figcaption, .cy-source { color: #bac1af; font-size: 12px; }
  figcaption { margin-top: 18px; }
  h3 { font-family: "Space Grotesk", "Noto Serif JP", serif; font-size: 18px; font-weight: 500; }
  .cy-principle { max-width: 700px; }
  .cy-uses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .cy-uses article { min-width: 0; padding-top: 24px; border-top: 1px solid #3e4435; }
  .cy-uses h3 { margin: 0 0 20px; }
  .cy-uses p { color: #c5cbbc; font-size: 14px; margin: 0 0 24px; }
  .cy-uses a { color: #f4f7ef; font-size: 12px; }
  .cy-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 40px 0; }
  .cy-metrics > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; border-top: 1px solid #3e4435; padding-top: 20px; min-width: 0; }
  .cy-metrics dt { font-family: "Space Mono", "Noto Sans JP", monospace; font-size: 14px; }
  .cy-metrics small { display: block; color: #bac1af; font-size: 10px; margin-top: 8px; overflow-wrap: anywhere; }
  .cy-metrics dd { font-family: "Space Grotesk", sans-serif; font-size: clamp(48px, 7vw, 88px); line-height: 1.2; margin: 0 0 18px; }
  .cy-close { border-top: 1px solid #3e4435; padding-top: 60px; }
  @media (max-width: 900px) {
    .cy-hero { grid-template-columns: minmax(0, 1fr); gap: 44px; padding-top: 56px; }
    .cy-hero-copy { max-width: 650px; }
    .cy-uses { grid-template-columns: minmax(0, 1fr); }
    .cy-flow { gap: 10px; }
    .cy-flow h3 { flex-basis: 90px; }
    .cy-node { padding: 14px; }
  }
  @media (max-width: 600px) {
    .cy-container { padding-inline: 20px; }
    .cy-plate { padding: 22px; }
    .cy-btn { width: 100%; }
    .cy-section { margin-top: 80px; }
    .cy-flow { flex-direction: column; align-items: stretch; }
    .cy-flow h3 { flex-basis: auto; margin-bottom: 12px; }
    .cy-flow > span { align-self: center; transform: rotate(90deg); }
    .cy-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
