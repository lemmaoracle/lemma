---
/**
 * Keep the original centered, visual-first composition. Diagrams and tables
 * carry the explanation in plain language; technical detail is optional. The card is illustrative,
 * not a live result. Enforcement requires an execution gate.
 * Attacker-matrix values: example-cyber-attack/README.md.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import CyberProblem from "../components/CyberProblem.astro";
import CyberHeroCard from "../components/CyberHeroCard.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { localePath } from "../lib/urls";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-mono/latin-400.css";

export interface CyberTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}
const { locale, t, base } = Astro.props as CyberTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => localePath(base, path);
const C = isJa
  ? {
      title: "流出しないシステム — ProofGate｜Lemma",
      description:
        "振込も、口座変更も、AIの操作も。実行の前に確かめ、通らないものは担当者の確認へ回します。攻撃実験の記録と始め方を紹介します。",
      headline: ["流出しないシステム"],
      intro:
        "振込も、口座変更も、AIの操作も。実行の前に確かめ、通らないものは担当者の確認へ回します。",
      availability: "早期アクセス受付中",
      call: "個別に相談する",
      doc: "資料を受け取る",
      factLink: "攻撃実験の結果を見る →",
      introTitle: "最後の関門を、置く。",
      introBody: "鍵が盗まれても、指示が偽でも、実行の直前で確かめ直す。通らないものは止めます。",
      introQuote: "自分の情報を相手に渡さずに本人であることを証明",
      introQuoteSource: "株主・岩田さんの紹介文より",
      usesTitle: "止めるのは、実行の前です",
      usesIntro: "確認に追われている場面から。運用を変えずに重ねます。",
      uses: [
        {
          key: "transfer",
          symbol: "¥",
          title: "送金を止める",
          description:
            "届いた口座情報と登録済みの取引先情報を照合。振込先の書き換えが疑われる指示は経理の確認へ。",
          conditions: ["届いた口座情報", "登録済みの取引先情報"],
        },
        {
          key: "transfer",
          symbol: "≒",
          title: "口座変更を止める",
          description:
            "口座案内は担当者の所属とテキスト未改変だけ受け取り、依頼全文・口座番号は出さない。",
          conditions: ["担当者の所属", "テキスト未改変"],
        },
        {
          key: "api",
          symbol: "{ }",
          title: "AIの操作を止める",
          description:
            "操作ごとに渡した権限の範囲内かを照合。範囲と有効期間の事前委任で、毎回の承認は要らない。",
          conditions: ["権限の範囲", "有効期間"],
        },
      ],
      example: "確認内容の例を見る",
      evidenceTitle: "実験では、こうなりました",
      evidenceIntro:
        "Opus 4.8 による5種類の攻撃を、用意した実験環境で試しました。照合なしの場合と、照合ありの場合の記録です。",
      factLead: "Opus 4.8の5種類の攻撃は",
      factBefore: "照合なし",
      factBeforeValue: "攻撃が成立",
      factAfter: "照合あり",
      factAfterValue: "担当者の確認へ",
      factSub:
        "6モデル × 5シナリオで突破18件 → 照合ありで0件。Fable 5は攻撃自体を拒否したため集計外です。拒否は防御の成功ではありません。",
      factScope:
        "既知の弱点を用意し、使える道具と手順数を限った実験です。照合を組み込んだ操作が対象で、現実の攻撃すべてへの対応を示す結果ではありません。",
      factTableCaption: "Opus 4.8 の結果（5シナリオ × 照合なし/あり）",
      factColScenario: "シナリオ",
      factColWithout: "照合なし",
      factColWith: "照合あり",
      factProbeTitle: "安全寄りのAIでの記録も見る",
      factProbeBody:
        "安全寄りのAIでも、通常の業務画面では支払い $67,800 が実行された記録があり、照合ありでは403で担当者の確認へ回りました。",
      factProbeNote: "攻撃デモではなく、業務APIの見せ方です。",
      scenario: "シナリオ",
      scenarios: [
        "不正なデータ持ち出し",
        "監査記録の書き換え",
        "システム侵入後のデータ取得",
        "監視を避けた不正送金",
        "なりすましによる承認の回避",
      ],
      blocked: "不正な操作を阻止",
      source: "実験の条件・結果を見る",
      startTitle: "確認に追われている場面から、ひとつだけ",
      startBody:
        "振込・口座・AIの操作のうち、確認に追われている場面ひとつから始めます。運用を変えずに重ねます。",
      faqTitle: "よくある確認",
      faq: [
        {
          q: "機密や個人情報を預けるのですか",
          a: "預かりません。会社のシステムに置いたまま、条件を満たす事実の照合だけ行います。",
        },
        {
          q: "照合に通らないとどうなりますか",
          a: "実行に進めず、担当者の確認へ回ります。止めたあとの判断は、人が行います。",
        },
        {
          q: "AIが決めた範囲を超えて動く場合は",
          a: "渡した権限の範囲外の操作は実行されず、担当者の確認へ回ります。",
        },
        {
          q: "振込先の書き換えにはどう当たりますか",
          a: "届いた口座情報と登録済みの取引先の情報を照合し、裏付けのないものは経理の確認へ回ります。",
        },
        {
          q: "導入はどこから始めますか",
          a: "振込・口座・AIの操作のうち、確認に追われている場面ひとつから始めます。",
        },
        {
          q: "いまの業務手順は変わりますか",
          a: "運用を変えずに重ねます。確認の場所だけ、照合の結果が届きます。",
        },
      ],
      closeTitle: "次の一歩",
      closeIntro: "確認に追われている場面ひとつから始めます。運用を変えずに重ねます。",
      integrationNote:
        "業務の内容を伺い、確認する条件と、既存システムのどこに組み込むかを一緒に整理します。",
      live: "証明データの検証ツール",
      liveNote: "証明データを入力して確かめる、技術者向けのツールも公開しています。",
    }
  : {
      title: "A system that does not leak — ProofGate | Lemma",
      description:
        "Transfers, account changes, and AI actions. Check before execution, and route what does not pass to a person for review. Test records and first steps.",
      headline: ["A system that does not leak"],
      intro:
        "Transfers, account changes, and AI actions. Check before execution, and route what does not pass to a person for review.",
      availability: "Early access",
      call: "Talk to us",
      doc: "Get the materials",
      factLink: "See the test results →",
      introTitle: "Place the final gate.",
      introBody:
        "Even with a stolen key or a forged instruction, re-check immediately before execution. What does not pass is stopped.",
      introQuote: "Prove who you are without handing over your information",
      introQuoteSource: "From a shareholder's introduction of Frame00",
      usesTitle: "Stopped before execution",
      usesIntro: "Start where reviews pile up. Layer onto your workflow unchanged.",
      uses: [
        {
          key: "transfer",
          symbol: "¥",
          title: "Stop transfers",
          description:
            "Compare the received account details with the registered partner. Instructions that suggest a rewritten recipient go to accounting for review.",
          conditions: ["Received account details", "Registered partner record"],
        },
        {
          key: "transfer",
          symbol: "≒",
          title: "Stop account changes",
          description:
            "Take from an account notice only the sender's affiliation and unmodified text, never the full request or account number.",
          conditions: ["Sender affiliation", "Unmodified text"],
        },
        {
          key: "api",
          symbol: "{ }",
          title: "Stop AI actions",
          description:
            "Check each action against its pre-assigned permission scope. Pre-assigned scope and validity needs no approval each time.",
          conditions: ["Permission scope", "Validity period"],
        },
      ],
      example: "Explore the example checks",
      evidenceTitle: "What the tests showed",
      evidenceIntro:
        "Five attack scenarios by Opus 4.8, run in a prepared test environment. Records with and without the check.",
      factLead: "Five Opus 4.8 attacks:",
      factBefore: "Without the check",
      factBeforeValue: "Attacks succeeded",
      factAfter: "With the check",
      factAfterValue: "Routed to a person",
      factSub:
        "6 models × 5 scenarios: 18 breakthroughs → 0 with the check. Fable 5 is excluded: it refused the attack itself, which is not a defense success.",
      factScope:
        "The test systems contain known weaknesses, with limited tools and steps. Results apply to operations with the check in place; they do not establish protection against every real-world attack.",
      factTableCaption: "Opus 4.8 results (5 scenarios × without/with the check)",
      factColScenario: "Scenario",
      factColWithout: "Without the check",
      factColWith: "With the check",
      factProbeTitle: "Records from a cautious AI too",
      factProbeBody:
        "Even a safety-tuned AI executed a $67,800 payment in the ordinary business screen; with the check it returned 403 and went to a person for review.",
      factProbeNote: "A view of business APIs, not an attack demo.",
      scenario: "Scenario",
      scenarios: [
        "Unauthorized data exfiltration",
        "Audit record tampering",
        "Data access after system compromise",
        "Transfers that evade monitoring",
        "Approval bypass through impersonation",
      ],
      blocked: "Unauthorized action blocked",
      source: "See test conditions and results",
      startTitle: "Start with one overloaded scene",
      startBody:
        "Start with one of transfers, accounts, or AI actions where reviews pile up. Layer onto your workflow unchanged.",
      faqTitle: "Common questions",
      faq: [
        {
          q: "Do you hold our confidential or personal data",
          a: "No. Data stays in your systems; only the check of qualifying facts runs.",
        },
        {
          q: "What happens when the check fails",
          a: "The action does not proceed; it goes to a person for review. People decide after a stop.",
        },
        {
          q: "When AI exceeds its assigned scope",
          a: "Actions outside the assigned permission scope do not run; they go to a person for review.",
        },
        {
          q: "How does it meet rewritten transfer recipients",
          a: "It compares the received account details with the registered partner record; unbacked requests go to accounting for review.",
        },
        {
          q: "Where do we start",
          a: "Start with one of transfers, accounts, or AI actions where reviews pile up.",
        },
        {
          q: "Do our current procedures change",
          a: "They stay. Only the check result arrives at the review point.",
        },
      ],
      closeTitle: "The next step",
      closeIntro: "Start with one overloaded scene. Layer onto your workflow unchanged.",
      integrationNote:
        "We will discuss your workflow, the conditions to check, and where the check fits into your existing system.",
      live: "Proof data verification tool",
      liveNote: "A tool for technical users to submit and verify proof data is also available.",
    };
// Opus 4.8 primary end-to-end result (example-cyber-attack README, main):
// all 5 INSECURE scenarios attack_succeeded, all 5 SECURE blocked.
const factRows = (
  isJa
    ? [
        { without: "機微情報を外部へ持ち出し", with: "証明なしでは情報を出さない" },
        { without: "記録の改ざんが成立", with: "記録の変更を止める" },
        { without: "暗号化情報の復号に成功", with: "復号・取得を止める" },
        { without: "送金が実行", with: "送金を止める" },
        { without: "承認の迂回が成立", with: "承認の迂回を止める" },
      ]
    : [
        { without: "Sensitive data taken out", with: "No data without proof" },
        { without: "Records rewritten", with: "Record changes stopped" },
        { without: "Encrypted data decrypted", with: "Decryption stopped" },
        { without: "Transfer executed", with: "Transfer stopped" },
        { without: "Approval bypassed", with: "Bypass stopped" },
      ]
) as ReadonlyArray<{ without: string; with: string }>;
const whitepaperUrl = "https://tally.so/r/xX0VYv";
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <div class="cy-container">
      <section class="cy-hero" aria-labelledby="cy-title">
        <CyberHeroCard />
        <div class="cy-hero-copy">
          <h1 id="cy-title">ProofGate</h1>
          <p class="cy-claim">{C.headline.map((line) => <span>{line}</span>)}</p>
          <p class="cy-intro">{C.intro}</p>
          <div class="cy-actions">
            <a
              class="cy-btn cy-primary"
              data-cy-ev="cy_hero_consult"
              href={DISCOVERY_CALL_URL[locale]}
              target="_blank"
              rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
            >
          </div>
          <p class="cy-herosub">
            <a class="cy-factlink" data-cy-ev="cy_hero_fact" href="#fact">{C.factLink}</a>
          </p>
          <p class="cy-availability">{C.availability}</p>
        </div>
      </section>

      <section class="cy-section cy-intro-sec" aria-labelledby="cy-intro-title">
        <h2 id="cy-intro-title">{C.introTitle}</h2>
        <p class="cy-section-intro">{C.introBody}</p>
        <figure class="cy-quote">
          <blockquote>「{C.introQuote}」</blockquote>
          <figcaption>{C.introQuoteSource}</figcaption>
        </figure>
      </section>
      <section class="cy-section" aria-labelledby="cy-uses-title">
        <h2 id="cy-uses-title">{C.usesTitle}</h2>
        <p class="cy-section-intro">{C.usesIntro}</p>
        <div class="cy-cards">
          {
            C.uses.map((use, index) => (
              <a
                class="cy-example-card"
                data-cy-ev="cy_feat_verify"
                href={L(`/cyber/verify/?card=${use.key}`)}
              >
                <>
                  <span class="cy-use-top">
                    <>
                      <span>LEMMA / PROOFGATE</span>
                      <span>0{index + 1}</span>
                    </>
                  </span>
                  <span class="cy-use-symbol" aria-hidden="true">
                    {use.symbol}
                  </span>
                  <h3>{use.title}</h3>
                  <p class="cy-use-description">{use.description}</p>
                  <ul>
                    {use.conditions.map((condition) => (
                      <li>{condition}</li>
                    ))}
                  </ul>
                  <span class="cy-use-link">
                    {C.example} <span aria-hidden="true">→</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </section>

      <CyberProblem locale={locale} />

      <section id="fact" class="cy-section" aria-labelledby="cy-evidence-title">
        <h2 id="cy-evidence-title">{C.evidenceTitle}</h2>
        <p class="cy-section-intro">{C.evidenceIntro}</p>
        <p class="cy-factlead">{C.factLead}</p>
        <div class="cy-evidence-summary">
          <div>
            <span>{C.factBefore}</span>
            <strong>5 <small>/ 5</small></strong><p>{C.factBeforeValue}</p>
          </div>
          <div>
            <span>{C.factAfter}</span>
            <strong>5 <small>/ 5</small></strong><p>{C.factAfterValue}</p>
          </div>
        </div>
        <div class="cy-fact-sub">
          <p>{C.factSub}</p>
        </div>
        <div class="cy-fact-tablewrap">
          <table class="cy-fact-table">
            <caption>{C.factTableCaption}</caption>
            <thead>
              <tr>
                <th scope="col">{C.factColScenario}</th>
                <th scope="col">{C.factColWithout}</th>
                <th scope="col">{C.factColWith}</th>
              </tr>
            </thead>
            <tbody>
              {
                C.scenarios.map((name, rowIndex) => (
                  <tr>
                    <th scope="row">{name}</th>
                    <td class="cy-without">{factRows[rowIndex]?.without}</td>
                    <td class="cy-with">{factRows[rowIndex]?.with}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <details class="cy-details">
          <summary>{C.factProbeTitle}<span aria-hidden="true">+</span></summary>
          <div class="cy-details-body">
            <p>{C.factProbeBody}</p>
            <p class="cy-note">{C.factProbeNote}</p>
          </div>
        </details>
        <p class="cy-note">{C.factScope}</p>
        <a
          class="cy-source"
          data-cy-ev="cy_fact_source"
          href="https://github.com/lemmaoracle/example-cyber-attack#readme"
          target="_blank"
          rel="noopener">{C.source} <span aria-hidden="true">↗</span></a
        >
      </section>

      <section class="cy-section cy-start" aria-labelledby="cy-start-title">
        <h2 id="cy-start-title">{C.startTitle}</h2>
        <p class="cy-section-intro">{C.startBody}</p>
      </section>

      <section class="cy-section cy-faq" aria-labelledby="cy-faq-title">
        <h2 id="cy-faq-title">{C.faqTitle}</h2>
        <div class="cy-faq-list">
          {
            C.faq.map((item) => (
              <details class="cy-details">
                <summary>
                  {item.q}
                  <span aria-hidden="true">+</span>
                </summary>
                <div class="cy-details-body">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section id="cy-close" class="cy-section cy-close" aria-labelledby="cy-close-title">
        <h2 id="cy-close-title">{C.closeTitle}</h2>
        <p class="cy-section-intro">{C.closeIntro}</p>
        <p class="cy-note">{C.integrationNote}</p>
        <div class="cy-actions">
          <a
            class="cy-btn cy-primary"
            data-cy-ev="cy_close_consult"
            href={DISCOVERY_CALL_URL[locale]}
            target="_blank"
            rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
          >
          <a
            class="cy-btn cy-ghost"
            data-cy-ev="cy_close_doc"
            href={whitepaperUrl}
            target="_blank"
            rel="noopener">{C.doc} <span aria-hidden="true">↗</span></a
          >
        </div>
        <p class="cy-note">{C.liveNote}</p>
        <a class="cy-source" data-cy-ev="cy_close_verify" href={L("/verify/")}
          >{C.live} <span aria-hidden="true">↗</span></a
        >
      </section>
    </div>
  </main>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>("a[data-cy-ev]").forEach((a) => {
    a.addEventListener("click", () => {
      const ev = a.getAttribute("data-cy-ev");
      if (typeof window.gtag === "function" && ev) {
        window.gtag("event", "cy_click", { cy_ev: ev, transport_type: "beacon" });
      }
    });
  });
</script>

<style>
  .cy-page {
    background: #12140e;
    color: #f4f7ef;
    font-family: "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    line-height: 1.85;
    padding-bottom: 100px;
  }
  .cy-page *,
  .cy-page *::before,
  .cy-page *::after {
    box-sizing: border-box;
  }
  .cy-container {
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: 32px;
    text-align: center;
  }
  .cy-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--navh, 74px));
    margin-inline: -32px;
    padding: 80px 32px 96px;
  }
  .cy-hero-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .cy-hero-copy::before {
    content: "";
    position: absolute;
    inset: -20px -56px;
    z-index: -1;
    background: radial-gradient(
      ellipse 62% 62% at 50% 42%,
      #12140ed9 8%,
      #12140ea6 42%,
      transparent 78%
    );
    pointer-events: none;
  }
  .cy-hero h1,
  .cy-hero .cy-claim,
  .cy-hero .cy-intro,
  .cy-hero .cy-herosub,
  .cy-hero .cy-availability {
    text-shadow:
      0 1px 10px #12140ee6,
      0 3px 32px #12140ecc;
  }
  .cy-hero .cy-claim {
    margin-bottom: 24px;
  }
  .cy-hero .cy-intro {
    margin-bottom: 24px;
  }
  .cy-hero .cy-ghost {
    background: #12140ecf;
  }
  .cy-page h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(80px, 15vw, 150px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.065em;
    margin: 0 0 24px;
  }
  .cy-page h2,
  .cy-page h3,
  .cy-claim {
    line-break: strict;
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .cy-page h2 {
    font-family: "Space Grotesk", "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
    font-size: clamp(23px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 30px;
  }
  .cy-claim {
    margin: 0 auto 30px;
    font-size: clamp(18px, 2.5vw, 24px);
    line-height: 1.8;
  }
  .cy-claim > span {
    display: inline-block;
  }
  .cy-claim > span + span {
    margin-left: 0.35em;
  }
  .cy-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cy-page a {
    color: inherit;
    text-decoration: none;
  }
  .cy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: 999px;
    border: 1px solid #69705c;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
  }
  .cy-page .cy-primary {
    color: #12140e;
    background: #a8e010;
    border-color: #a8e010;
  }
  .cy-ghost {
    background: transparent;
  }
