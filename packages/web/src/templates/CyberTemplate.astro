<script>
  const workflowSection = document.querySelector<HTMLElement>("[data-cy-workflows]");
  const workflowTabs = Array.from(
    workflowSection?.querySelectorAll<HTMLButtonElement>("[data-cy-workflow-tab]") ?? [],
  );
  const workflowPanels = Array.from(
    workflowSection?.querySelectorAll<HTMLElement>("[data-cy-workflow-panel]") ?? [],
  );

  const selectWorkflow = (selected: HTMLButtonElement) => {
    workflowTabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.setAttribute("tabindex", active ? "0" : "-1");
    });
    workflowPanels.forEach((panel) => {
      panel.toggleAttribute(
        "hidden",
        panel.dataset.cyWorkflowPanel !== selected.dataset.cyWorkflowTab,
      );
    });
  };
  const focusWorkflow = (event: KeyboardEvent, tab: HTMLButtonElement) => {
    event.preventDefault();
    selectWorkflow(tab);
    tab.focus();
  };
  workflowTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectWorkflow(tab));
    tab.addEventListener("keydown", (event) => {
      const positions: Readonly<Record<string, number | undefined>> = {
        ArrowRight: (index + 1) % workflowTabs.length,
        ArrowLeft: (index - 1 + workflowTabs.length) % workflowTabs.length,
        Home: 0,
        End: workflowTabs.length - 1,
      };
      const nextIndex = positions[event.key];
      const nextTab = nextIndex === undefined ? undefined : workflowTabs[nextIndex];
      nextTab ? focusWorkflow(event, nextTab) : undefined;
    });
  });
  workflowTabs[0] ? selectWorkflow(workflowTabs[0]) : undefined;
  workflowSection?.querySelector<HTMLElement>("[role='tablist']")?.removeAttribute("hidden");
</script>

