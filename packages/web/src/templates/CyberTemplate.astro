    align-items: center;
    gap: 12px;
  }
  .cy-wordmark {
    font:
      500 22px/1 "Space Grotesk",
      sans-serif;
    letter-spacing: -0.055em;
  }
  .cy-wordmark > span {
    font:
      9px/1.5 "Space Mono",
      monospace;
