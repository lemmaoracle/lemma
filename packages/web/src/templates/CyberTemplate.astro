          ],
          after: [
            {
              actor: "Member",
              title: "Request this redemption",
              detail: "Person, points and recipient",
              kind: "step",
            },
            {
              actor: "Cyber checks automatically",
              title: "Check before issue",
              detail: "Person, limits, recipient and expiry",
              kind: "check",
            },
            {
              actor: "Redemption system",
              title: "Issue the voucher",
              detail: "Only for a matching request",
              kind: "step",
            },
          ],
          stop: "Mismatch, expiry or reuse → stop",
          savings: [
            {
              task: "Investigate fraud after issue",
              change: "Stop it earlier to reduce follow-up",
            },
          ],
          boundary:
            "This design adds the check before voucher issuance. Post-issue audits continue. Member registration, limits and revoked approvals must also be agreed.",
        },
      ],
      closeTitle: "Start with one action to protect.",
      closeIntro:
        "Cyber is accepting early-access inquiries. We will discuss your workflow, the conditions to check and where the check fits into your existing system.",
      integrationNote:
        "Protection applies to operations with the check in place. Every path to those operations needs the check, including controls for revoked approvals, expiry and reused requests.",
      technicalTitle: "Technical and integration details",
      technicalBody:
        "Internally, Cyber uses a cryptographic technique called a zero-knowledge proof (ZK) to check that required conditions are met. The design ties the organization, person and this specific request together.",
      docs: "Read the integration guides",
      live: "Proof data verification tool",
      liveNote: "A tool for technical users to submit and verify proof data is also available.",
    };
const attackerModels = [
  { name: "Opus 4.8", results: [1, 1, 1, 1, 1] },
  { name: "GPT-5.5", results: [1, 1, 0, 1, 1] },
  { name: "DeepSeek v4 Pro", results: [1, 1, 0, 1, 1] },
  { name: "Qwen3.7 Max", results: [1, 0, 1, 0, 1] },
  { name: "Kimi-K2.6", results: [0, 0, 0, 1, 1] },
  { name: "Kimi K2.7 Code", results: [1, 0, 0, 1, 1] },
  { name: "GLM-5.2", results: [1, 1, 1, 1, 1] },
] as const;
const scenarioCount = attackerModels.length * C.scenarios.length;
const attackCount = attackerModels.reduce(
  (total, model) => total + model.results.reduce<number>((sum, result) => sum + result, 0),
  0,
);
---

<Layout
  locale={locale}
  title={C.title}
  description={C.description}
  metaType="page"
  pagePath="/cyber/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="cy-page">
    <div class="cy-container">
      <section class="cy-hero" aria-labelledby="cy-title">
        <h1 id="cy-title">Cyber</h1>
        <p class="cy-claim">{C.headline.map((line) => <span>{line}</span>)}</p>
        <p class="cy-intro">{C.intro}</p>
        <div class="cy-actions">
          <a class="cy-btn cy-primary" href="#cy-example"
            >{C.learn} <span aria-hidden="true">↓</span></a
          >
          <a
            class="cy-btn cy-ghost"
            href={DISCOVERY_CALL_URL[locale]}
            target="_blank"
            rel="noopener">{C.call} <span aria-hidden="true">↗</span></a
          >
        </div>
        <p class="cy-availability">{C.availability}</p>
      </section>

      <section id="cy-example" class="cy-section" aria-labelledby="cy-example-title">
        <h2 id="cy-example-title">{C.exampleTitle}</h2>
        <p class="cy-section-intro">{C.exampleIntro}</p>
        <figure class="cy-plate-stage">
          <article
            class="cy-plate"
            aria-labelledby="cy-card-title"
            aria-describedby="cy-card-caption"
          >
            <div class="cy-card-top">
              <span class="cy-wordmark">LEMMA / CYBER</span><span class="cy-sample">{C.sample}</span
              >
            </div>
            <h3 id="cy-card-title">{C.cardTitle}</h3>
            <ol class="cy-bind-chain">
              {
                C.chain.map((item, index) => (
                  <li>
                    <div class="cy-chain-content">
                      <span class="cy-card-label">
                        0{index + 1} / {item.label}
                      </span>
                      <svg
                        class="cy-chain-icon"
                        width="28"
                        height="28"
                        viewBox="0 0 28 28"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d={item.icon} />
                      </svg>
                      <strong>{item.value}</strong>
                      <span class="cy-card-detail">{item.note}</span>
                    </div>
                    {index < C.chain.length - 1 && (
                      <span class="cy-chain-arrow" aria-hidden="true">
                        →
                      </span>
                    )}
                  </li>
                ))
              }
            </ol>
            <div class="cy-binding"><span>{C.binding}</span></div>
            <ul class="cy-card-conditions">
              {
                C.limits.map((limit) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {limit}
                  </li>
                ))
              }
            </ul>
            <div class="cy-card-result">
              <span class="cy-result-mark" aria-hidden="true">✓</span><span>{C.cardResult}</span>
            </div>
          </article>
          <figcaption id="cy-card-caption">
            {C.cardNote}<a href={L("/cyber/verify/?card=transfer")}
              >{C.cardLink} <span aria-hidden="true">↗</span></a
            >
          </figcaption>
        </figure>

        <div class="cy-outcomes">
          {
            C.outcomes.map((outcome) => (
              <div class:list={["cy-outcome", { "cy-outcome-stopped": !outcome.allowed }]}>
                <>
                  <strong>{outcome.amount}</strong>
                  <span>{outcome.detail}</span>
                </>
                <b>
                  <span aria-hidden="true">{outcome.allowed ? "✓" : "×"}</span> {outcome.result}
                </b>
              </div>
            ))
          }
        </div>
      </section>

      <section id="cy-how" class="cy-section" aria-labelledby="cy-gate-title">
        <h2 id="cy-gate-title">{C.gateTitle}</h2>
        <ol class="cy-steps">
          {
            C.steps.map((step, index) => (
              <li>
                <>
                  <span class="cy-step-number">0{index + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </>
              </li>
            ))
          }
        </ol>
        <figure
          class="cy-gate-diagram"
          aria-labelledby="cy-gate-title"
          aria-describedby="cy-gate-caption"
        >
          <div class="cy-gate-flow">
            <div class="cy-node">{C.request}</div><span class="cy-arrow" aria-hidden="true">→</span
            ><div class="cy-gate"><strong>Cyber</strong><span>{C.gate}</span></div><div
              class="cy-pass"
            >
              <span>{C.pass}</span><span class="cy-arrow" aria-hidden="true">→</span>
            </div><div class="cy-node">{C.system}</div>
          </div>
          <ul class="cy-gate-checks">
            {
              C.checks.map((check) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {check}
                </li>
              ))
            }
          </ul>
          <div class="cy-stop">
            <span>{C.fail}</span><span aria-hidden="true">↓</span><strong
              ><span aria-hidden="true">×</span> {C.stop}</strong
            >
          </div>
          <figcaption id="cy-gate-caption" class="cy-note">{C.gateNote}</figcaption>
        </figure>
      </section>

      <section id="cy-difference" class="cy-section" aria-labelledby="cy-difference-title">
        <h2 id="cy-difference-title">{C.compareTitle}</h2>
        <figure class="cy-key-diagram" aria-describedby="cy-difference-caption">
          <div class="cy-key-flow">
            <div class="cy-difference-item">
              <div class="cy-symbol-stage" aria-hidden="true">
                <svg
                  class="cy-key-shape"
                  width="98"
                  height="126"
                  viewBox="0 0 112 144"
                  fill="none"
                  focusable="false"
                >
                  <defs>
                    <linearGradient
                      id="cy-key-outline"
                      x1="24"
                      y1="5"
                      x2="84"
                      y2="132"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop stop-color="#788795"></stop>
                      <stop offset=".16" stop-color="#f1f5f9"></stop>
                      <stop offset=".34" stop-color="#8b9aa9"></stop>
                      <stop offset=".45" stop-color="#556575"></stop>
                      <stop offset=".49" stop-color="#f8fafc"></stop>
                      <stop offset=".57" stop-color="#cbd5e1"></stop>
                      <stop offset=".73" stop-color="#657685"></stop>
                      <stop offset=".88" stop-color="#e2e8f0"></stop>
                      <stop offset="1" stop-color="#8b9aa9"></stop>
                    </linearGradient>
                    <linearGradient
                      id="cy-key-face"
                      x1="28"
                      y1="5"
                      x2="84"
                      y2="132"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop stop-color="#e2e8f0" stop-opacity=".19"></stop>
                      <stop offset=".32" stop-color="#94a3b8" stop-opacity=".05"></stop>
                      <stop offset=".48" stop-color="#f8fafc" stop-opacity=".16"></stop>
                      <stop offset=".62" stop-color="#94a3b8" stop-opacity=".04"></stop>
                      <stop offset="1" stop-color="#cbd5e1" stop-opacity=".12"></stop>
                    </linearGradient>
                    <linearGradient id="cy-key-highlight" x1="0" y1="0" x2="1" y2="1">
                      <stop stop-color="#fff" stop-opacity=".85"></stop>
                      <stop offset=".38" stop-color="#fff" stop-opacity=".08"></stop>
                      <stop offset=".5" stop-color="#fff" stop-opacity=".7"></stop>
                      <stop offset=".65" stop-color="#fff" stop-opacity="0"></stop>
                      <stop offset="1" stop-color="#fff" stop-opacity=".2"></stop>
                    </linearGradient>
                    <pattern
                      id="cy-key-brush"
                      width="2"
                      height="2"
                      patternUnits="userSpaceOnUse"
                      patternTransform="rotate(25)"
                    >
                      <path d="M0 0v2" stroke="#e2e8f0" stroke-opacity=".035" stroke-width=".5"
                      ></path>
                    </pattern>
                    <path
                      id="cy-key-profile"
                      d="M44 58a28 28 0 1 1 24 0v58l-12 16-12-16v-6l8-8-8-8 8-8-8-8Z"></path>
                    <linearGradient
                      id="cy-key-fade"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="144"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop stop-color="#fff" stop-opacity=".78"></stop>
                      <stop offset=".4" stop-color="#fff" stop-opacity=".62"></stop>
                      <stop offset=".75" stop-color="#fff" stop-opacity=".27"></stop>
                      <stop offset="1" stop-color="#fff" stop-opacity=".08"></stop>
                    </linearGradient>
                    <mask
                      id="cy-key-mask"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="112"
                      height="144"
                    >
                      <rect width="112" height="144" fill="url(#cy-key-fade)"></rect>
                    </mask>
                  </defs>
                  <g mask="url(#cy-key-mask)">
                    <g
                      transform="translate(0 144) scale(1 -1)"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <use
                        href="#cy-key-profile"
                        transform="translate(.7 1)"
                        stroke="#070b0d"
                        stroke-width="3"></use>
                      <use
                        href="#cy-key-profile"
                        fill="url(#cy-key-face)"
                        stroke="url(#cy-key-outline)"
                        stroke-width="2.4"></use>
                      <use href="#cy-key-profile" fill="url(#cy-key-brush)"></use>
                      <use
                        href="#cy-key-profile"
                        transform="translate(-.35 -.35)"
                        stroke="url(#cy-key-highlight)"
                        stroke-width=".6"></use>
                      <circle
                        cx="56"
                        cy="22"
                        r="4.5"
                        fill="#12140e"
                        stroke="url(#cy-key-outline)"
                        stroke-width="1.4"></circle>
                      <path
                        d="M62 62v53m-5-51v49"
                        stroke="#070b0d"
                        stroke-width="1.4"
                        stroke-opacity=".8"></path>
                      <path
                        d="M61.4 62v53m-5-51v49"
                        stroke="url(#cy-key-outline)"
                        stroke-width=".6"
                        stroke-opacity=".8"></path>
                    </g>
                  </g>
                </svg>
              </div>
              <span>{C.compareLabels[0]}</span>
            </div>
            <span class="cy-difference-arrow" aria-hidden="true">→</span>
            <div class="cy-difference-item">
              <div class="cy-symbol-stage" aria-hidden="true">
                <div class="cy-proof-shape">
                  <span class="cy-mini-wordmark">LEMMA</span>
                  <svg width="80" height="26" viewBox="0 0 80 26" fill="none">
                    <path d="M17 13h17m12 0h17"></path>
                    <circle cx="11" cy="13" r="6"></circle>
                    <circle cx="40" cy="13" r="6"></circle>
                    <circle cx="69" cy="13" r="6"></circle>
                  </svg>
                  <span class="cy-mini-proof">{C.miniLabel} <span>✓</span></span>
                </div>
              </div>
              <span>{C.compareLabels[1]}</span>
            </div>
          </div>
          <figcaption id="cy-difference-caption">
            <strong>{C.compareSummary}</strong>
            <span>{C.compareNote}</span>
          </figcaption>
        </figure>
      </section>

      <section class="cy-section" aria-labelledby="cy-uses-title">
        <h2 id="cy-uses-title">{C.usesTitle}</h2>
        <p class="cy-section-intro">{C.usesIntro}</p>
        <div class="cy-cards">
          {
            C.uses.map((use, index) => (
              <a class="cy-example-card" href={L(`/cyber/verify/?card=${use.key}`)}>
                <>
                  <span class="cy-use-top">
                    <>
                      <span>LEMMA / CYBER</span>
                      <span>0{index + 1}</span>
                    </>
                  </span>
                  <span class="cy-use-symbol" aria-hidden="true">
                    {use.symbol}
                  </span>
                  <h3>{use.title}</h3>
                  <p class="cy-use-description">{use.description}</p>
                  <ul>
                    {use.conditions.map((condition) => (
                      <li>{condition}</li>
                    ))}
                  </ul>
                  <span class="cy-use-link">
                    {C.example} <span aria-hidden="true">→</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cy-section" aria-labelledby="cy-evidence-title">
        <h2 id="cy-evidence-title">{C.evidenceTitle}</h2>
        <p class="cy-section-intro">{C.evidenceIntro}</p>
        <div class="cy-evidence-summary">
          <div>
            <span>{C.modes[0]}</span><strong>{attackCount} <small>/ {scenarioCount}</small></strong
            ><p>{C.insecureResult}</p>
          </div>
          <div>
            <span>{C.modes[1]}</span><strong
              >{scenarioCount} <small>/ {scenarioCount}</small></strong
            ><p>{C.secureResult}</p>
          </div>
        </div>
        <p class="cy-note">{C.evidenceScope}</p>
        <a
          class="cy-source"
          href="https://github.com/lemmaoracle/example-cyber-attack#readme"
          target="_blank"
          rel="noopener">{C.source} <span aria-hidden="true">↗</span></a
        >
        <div class="cy-results" role="group" aria-labelledby="cy-results-title">
          <h3 id="cy-results-title">{C.resultDetails}</h3>
          {
            [false, true].map((secure, modeIndex) => (
              <section
                class:list={["cy-result-panel", { "cy-secure": secure }]}
                aria-labelledby={secure ? "cy-secure-title" : "cy-insecure-title"}
              >
                <h3 id={secure ? "cy-secure-title" : "cy-insecure-title"}>{C.modes[modeIndex]}</h3>
                <div
                  class="cy-matrix-scroll"
                  role="region"
                  aria-label={`${C.modes[modeIndex]} / ${C.scenario}`}
                  tabindex="0"
                >
                  <table class="cy-dot-grid">
                    <>
                      <thead>
                        <tr>
                          <th scope="col">{C.scenario}</th>
                          {attackerModels.map((model) => (
                            <th scope="col">
                              <span class="cy-model-name">{model.name}</span>
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {C.scenarios.map((name, scenarioIndex) => (
                          <tr>
                            <th scope="row">{name}</th>
                            {attackerModels.map((model) => (
                              <td>
                                <span
                                  class:list={[
                                    "cy-dot",
                                    { "cy-lit": secure || model.results[scenarioIndex] === 1 },
                                  ]}
                                  aria-hidden="true"
                                />
                                <span class="cy-sr-only">
                                  {secure
                                    ? C.blocked
                                    : model.results[scenarioIndex] === 1
                                      ? C.attack
                                      : C.unfinished}
                                </span>
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </>
                  </table>
                </div>
                <p class="cy-legend">
                  {secure ? (
                    <span>
                      <i class="cy-legend-dot cy-legend-blocked" aria-hidden="true" />
                      {C.blocked}
                    </span>
                  ) : (
                    <>
                      <span>
                        <i class="cy-legend-dot cy-legend-attack" aria-hidden="true" />
                        {C.attack}
                      </span>
                      <span>
                        <i class="cy-legend-dot" aria-hidden="true" />
                        {C.unfinished}
                      </span>
                    </>
                  )}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section
        id="cy-workflows"
        class="cy-section"
        aria-labelledby="cy-workflows-title"
        data-cy-workflows
      >
        <h2 id="cy-workflows-title">{C.workflowsTitle}</h2>
        <p class="cy-section-intro">{C.workflowsIntro}</p>
        <p class="cy-note cy-workflows-note">{C.workflowsNote}</p>
        <div class="cy-workflow-tabs" role="tablist" aria-label={C.workflowsTitle} hidden>
          {
            C.workflows.map((workflow, index) => (
              <button
                id={`cy-workflow-tab-${workflow.key}`}
                type="button"
                role="tab"
                aria-controls={`cy-workflow-panel-${workflow.key}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? "0" : "-1"}
                data-cy-workflow-tab={workflow.key}
              >
                {workflow.label}
              </button>
            ))
          }
        </div>
        {
          C.workflows.map((workflow) => (
            <div
              id={`cy-workflow-panel-${workflow.key}`}
              class="cy-workflow-panel"
              role="tabpanel"
              aria-labelledby={`cy-workflow-tab-${workflow.key}`}
              tabindex="0"
              data-cy-workflow-panel={workflow.key}
            >
              <span class="cy-workflow-mode">{workflow.mode}</span>
              <h3>{workflow.title}</h3>
              <p class="cy-workflow-description">{workflow.description}</p>
              <div class="cy-workflow-diagram">
                {[
                  { key: "before", label: C.beforeLabel, steps: workflow.before },
                  { key: "after", label: C.afterLabel, steps: workflow.after },
                ].map((phase) => (
                  <div class:list={["cy-flow-lane", `cy-flow-${phase.key}`]}>
                    <h4 id={`cy-flow-${workflow.key}-${phase.key}`}>{phase.label}</h4>
                    <ol
                      class:list={[
                        "cy-flow-track",
                        phase.key === "after" && workflow.stop && "cy-flow-branching",
                      ]}
                      role="list"
                      aria-labelledby={`cy-flow-${workflow.key}-${phase.key}`}
                    >
                      {phase.steps.map((step, index) => (
                        <li class:list={["cy-flow-step", `cy-flow-${step.kind}`]}>
                          <div class="cy-flow-node">
                            {step.kind === "check" && (
                              <span class="cy-flow-check-label">
                                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                  <path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                                {C.checkLabel}
                              </span>
                            )}
                            <span class="cy-flow-actor">
                              <span class="cy-flow-order" aria-hidden="true">
                                {String(index + 1).padStart(2, "0")}
                              </span>
                              {step.actor}
                            </span>
                            <strong>{step.title}</strong>
                            <span class="cy-flow-detail">{step.detail}</span>
                            {step.kind === "check" && workflow.stop && (
                              <>
                                <span class="cy-flow-route">{C.matchLabel}</span>
                                <span class="cy-flow-stop">
                                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                    <rect
                                      x="2.5"
                                      y="2.5"
                                      width="7"
                                      height="7"
                                      rx="1"
                                      stroke="currentColor"
                                    />
                                  </svg>
                                  <span>{workflow.stop}</span>
                                </span>
                              </>
                            )}
                          </div>
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
              <div class="cy-workflow-savings">
                <h4>{C.improvementLabel}</h4>
                <ul role="list">
                  {workflow.savings.map((saving) => (
                    <li>
                      <span>{saving.task}</span>
                      <span class="cy-savings-arrow" aria-hidden="true">
                        →
                      </span>
                      <strong>{saving.change}</strong>
                    </li>
                  ))}
                </ul>
              </div>
              <p class="cy-workflow-boundary">{workflow.boundary}</p>
            </div>
          ))
        }
      </section>

      <section id="cy-start" class="cy-section cy-close" aria-labelledby="cy-close-title">
        <h2 id="cy-close-title">{C.closeTitle}</h2>
        <p class="cy-section-intro">{C.closeIntro}</p>
        <p class="cy-note">{C.integrationNote}</p>
