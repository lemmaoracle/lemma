      grid-template-columns: repeat(2, 1fr);
    }
    .bx-archive-link {
      grid-template-columns: 140px 1fr 90px;
      gap: 16px;
    }
  }
  @media (max-width: 720px) {
    .bx-container {
      padding: 0 24px;
