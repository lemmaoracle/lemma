---
/**
 * Lemma blog — 一覧ページ。モック `lemma_blog_index_mock_v4.html` の面
 * （`Lemma_コンテンツテンプレート_実装指示_v1_2026-07-30.md` §3）。
 *
 * 構成: ヒーロー → フィルタピル → 注目の記事（7:5・カード装飾なし）→
 * 最近の記事6件（3列・16:9サムネ）→ すべての記事（72pxミニカバーの行）→
 * 変更履歴（3カラム行・カバーなし）→ カテゴリ4枚。
 *
 * カバーは「選ばれたもの」に付け、網羅リストはテキスト寄りに——大（注目）→
 * 中（最近）→ 小（すべて）→ 行（変更履歴）と重みを落とす（§3.2）。
 * フィルタで単一カテゴリを選ぶと全件が同じ色相になり情報量が消えるため、
 * フィルタ結果もカードでなく**行**で出す。
 *
 * v24 のスクロール reveal は落とした（`prefers-reduced-motion` でホバー以外の
 * アニメーションを無効にする受け入れ基準に対し、消してしまうのが最も確実。
 * テキスト寄りの一覧では出現アニメーションの意味も薄い）。
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { BLOG_CATEGORIES, categorySlug } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import BlogCover from "../components/BlogCover.astro";

export interface BlogIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  /** All entries (essays + changelog) used to feed the filter pills + filtered grid. */
  entries: ReadonlyArray<BlogPost>;
  featured?: BlogPost;
  recent: ReadonlyArray<BlogPost>;
  changelog?: ReadonlyArray<BlogPost>;
}

const { locale, t, base, blogPath, entries, featured, recent, changelog = [] } =
  Astro.props as BlogIndexTemplateProps;

const isJa = locale === "ja";

// Category counts — both for filter pills and the categories nav strip.
// Includes the primary category plus any secondary_categories so a post
// with `secondary_categories: ["Announcements"]` is counted toward
// Announcements as well.
const categoryCounts: Record<string, number> = {};
for (const p of entries) {
  categoryCounts[p.category] = (categoryCounts[p.category] ?? 0) + 1;
  if (p.secondaryCategories) {
    for (const sc of p.secondaryCategories) {
      categoryCounts[sc] = (categoryCounts[sc] ?? 0) + 1;
    }
  }
}
const categories = BLOG_CATEGORIES.filter(
  (c) => (categoryCounts[c] ?? 0) > 0,
);

const readCta = isJa ? "読む →" : "Read →";

/** カテゴリカードの説明1行（§3.1-7）。 */
const CATEGORY_DESC: Record<string, Record<Locale, string>> = {
  Announcements: {
    ja: "新機能・フィード・公開のお知らせ",
    en: "New features, feeds, and release notes",
  },
  Industry: {
    ja: "AIと信頼をめぐる業界の論点",
    en: "Industry debates on AI and trust",
  },
  Solutions: {
    ja: "業務への組み込み方と検証結果",
    en: "Integration patterns and verification results",
  },
  Technical: {
    ja: "設計・仕様・実装の詳細",
    en: "Design, specs, and implementation detail",
  },
};

const C = isJa
  ? {
      lead: "証明基盤の設計と実装、AI時代の信頼をめぐる論点。新機能のアナウンスから技術仕様まで。",
      featured: "注目の記事",
      featuredEn: "Featured",
      recent: "最近の記事",
      recentEn: "Recent",
      all: "すべての記事",
      changelog: "変更履歴",
      changelogEn: "Changelog",
      categories: "カテゴリ",
      categoriesEn: "Categories",
    }
  : {
      lead: "Design and implementation of proof infrastructure, and the questions of trust in the AI era — from announcements to technical specs.",
      featured: "Featured",
      featuredEn: "Featured",
      recent: "Recent",
      recentEn: "Recent",
      all: "All articles",
      changelog: "Changelog",
      changelogEn: "Changelog",
      categories: "Categories",
      categoriesEn: "Categories",
    };
---

<Layout
  locale={locale}
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  metaType="page"
  pagePath="/blog/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="bi-page">
    <div class="bi-container">
      <section class="bi-hero">
        <div class="bi-kicker">Blog</div>
        <h1 class="bi-h1">{t.blog.title}</h1>
        <p class="bi-lead">{C.lead}</p>
        {categories.length > 0 && (
          <nav class="bi-filter" aria-label={t.blog.index.categoriesLabel}>
            <button class="bi-pill on" data-filter="all" type="button">
              {t.blog.index.allTag} <i>{entries.length}</i>
            </button>
            {categories.map((c) => (
              <button class="bi-pill" data-filter={c} type="button">
                {c} <i>{categoryCounts[c]}</i>
              </button>
            ))}
          </nav>
        )}
      </section>

      <div class="bi-view-all">
        {featured && (
          <section>
            <div class="bi-label">
              <b>{C.featured}</b><span>{C.featuredEn}</span>
            </div>
            {/* カード装飾は付けない — サムネイル＋テキストのみ（§3.1-3）。 */}
            <a class="bi-feat" href={`${blogPath}/${featured.slug}`}>
              <div class="bi-thumb">
                <BlogCover category={featured.category} slug={featured.slug} />
              </div>
              <div>
                <div class="bi-meta">
                  <span class="bi-cat">{featured.category}</span>
                  <span class="bi-sep">·</span>
                  <time>{featured.date}</time>
                </div>
                <h2 class="bi-feat-title">{featured.title}</h2>
                {featured.abstract && <p class="bi-feat-ex">{featured.abstract}</p>}
                <span class="bi-cta">{readCta}</span>
              </div>
            </a>
          </section>
        )}

        {recent.length > 0 && (
          <section>
            <div class="bi-label">
              <b>{C.recent}</b><span>{C.recentEn}</span>
            </div>
            <div class="bi-grid">
              {recent.map((post) => (
                <a class="bi-card" href={`${blogPath}/${post.slug}`}>
                  <div class="bi-thumb">
                    <BlogCover category={post.category} slug={post.slug} />
                  </div>
                  <div class="bi-meta">
                    <span class="bi-cat">{post.category}</span>
                    <span class="bi-sep">·</span>
                    <time>{post.date}</time>
                  </div>
                  <h3 class="bi-card-title">{post.title}</h3>
                  {post.abstract && <p class="bi-card-ex">{post.abstract}</p>}
                  <span class="bi-cta">{readCta}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {entries.length > 0 && (
          <section>
            <div class="bi-label">
              <b>{C.all}</b><span>All — {entries.length}</span>
            </div>
            <div class="bi-alist">
              {entries.map((post) => (
                <a class="bi-arow" href={`${blogPath}/${post.slug}`}>
                  <span class="bi-athumb">
                    <BlogCover category={post.category} slug={post.slug} />
                  </span>
                  <span class="bi-acat">{post.category}</span>
                  <span class="bi-atitle">{post.title}</span>
                  <span class="bi-adate">{post.date}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {changelog.length > 0 && (
          <section class="bi-narrow">
            <div class="bi-label">
              <b>{C.changelog}</b><span>{C.changelogEn}</span>
            </div>
            <div>
              {changelog.map((post) => (
                <a class="bi-crow" href={`${blogPath}/${post.slug}`}>
                  <span class="bi-acat">{post.category}</span>
                  <span class="bi-ctitle">{post.title}</span>
                  <span class="bi-adate">{post.date}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {categories.length > 0 && (
          <section>
            <div class="bi-label">
              <b>{C.categories}</b><span>{C.categoriesEn}</span>
            </div>
            <div class="bi-cats">
              {categories.map((c) => (
                <a class="bi-cat-card" href={`${blogPath}/category/${categorySlug(c)}`}>
                  <b>{c}</b>
                  <span>{CATEGORY_DESC[c]?.[locale] ?? ""}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      {/* フィルタ結果はカードでなく行（§3.2 — 単一カテゴリでは色相の情報量が
          消えるため、テキスト寄りにする）。 */}
      <section class="bi-filtered" hidden>
        <div class="bi-label">
          <b data-filtered-label></b><span data-filtered-count></span>
        </div>
        <div class="bi-alist">
          {entries.map((post) => (
            <a
              class="bi-arow bi-filtered-row"
              href={`${blogPath}/${post.slug}`}
              data-category={[post.category, ...(post.secondaryCategories ?? [])].join("|")}
            >
              <span class="bi-athumb">
                <BlogCover category={post.category} slug={post.slug} />
              </span>
              <span class="bi-acat">{post.category}</span>
              <span class="bi-atitle">{post.title}</span>
              <span class="bi-adate">{post.date}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* トークンの値は記事テンプレート（BlogArticleTemplate）と同じもの。 */
  .bi-page {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.09), 0 2px 6px rgba(14, 18, 16, 0.05);
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", monospace;

    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    padding: 0;
    margin-top: 64px;
  }
  .bi-container {
    max-width: calc(1180px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
  }
  .bi-page a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO + FILTER ─── */
  .bi-hero {
    padding: 46px 0 0;
  }
  .bi-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bi-h1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(28px, 3.2vw, 38px);
    letter-spacing: 0.04em;
    color: var(--tx);
    margin: 14px 0 12px;
  }
  .bi-lead {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.95;
    color: var(--tx-soft);
    max-width: 62ch;
  }
  .bi-filter {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin: 30px 0 0;
  }
  .bi-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--tx-soft);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 8px 15px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .bi-pill:hover {
    border-color: rgba(124, 175, 0, 0.5);
    color: var(--tx);
  }
  /* 選択中は蛍光地に墨文字（§3.1-2）。 */
  .bi-pill.on {
    background: var(--ok);
    border-color: var(--ok);
    color: var(--ink);
    font-weight: 600;
  }
  .bi-pill i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }
  .bi-pill.on i {
    color: var(--ink);
    opacity: 0.65;
  }

  /* ─── SECTION LABEL ───
     ラベル行の罫線が上境界を兼ねる。直下に別の全幅罫線は置かない（§6-2）。 */
  .bi-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 60px 0 22px;
  }
  .bi-label b {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.06em;
    color: var(--tx);
  }
  .bi-label span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bi-label::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }

  /* ─── サムネイル（共通・16:9） ───
     4:3 は縦が伸びて抽象カバーの存在感が過剰になる（§3.2）。 */
  .bi-thumb :global(svg) {
    width: 100%;
    aspect-ratio: 1200 / 630;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(24, 36, 26, 0.11);
    transition: transform 0.18s, box-shadow 0.18s;
  }

  /* ─── FEATURED（7:5・装飾なし） ─── */
  .bi-feat {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 38px;
    align-items: center;
  }
  .bi-feat .bi-thumb :global(svg) {
    border-radius: 14px;
  }
  .bi-feat:hover .bi-thumb :global(svg) {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(24, 36, 26, 0.17);
  }
  .bi-feat-title {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(19px, 2.1vw, 25px);
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 12px 0 12px;
  }
  .bi-feat-ex {
    margin: 0 0 18px;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--tx-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── META（共通） ─── */
  .bi-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .bi-cat {
    color: var(--ok-ink);
  }
  .bi-sep {
    opacity: 0.5;
  }
  .bi-cta {
    font-size: 12.5px;
    color: var(--ok-ink);
  }

  /* ─── RECENT（3列・ホバーはサムネイルだけが浮く） ─── */
  .bi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .bi-card {
    display: flex;
    flex-direction: column;
  }
  .bi-card .bi-meta {
    margin: 16px 0 8px;
  }
  .bi-card:hover .bi-thumb :global(svg) {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(24, 36, 26, 0.16);
  }
  .bi-card-title {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 0 0 10px;
  }
  .bi-card-ex {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.85;
    color: var(--tx-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bi-card .bi-cta {
    margin-top: auto;
  }

  /* ─── ALL（72pxミニカバーの行リスト） ─── */
  .bi-arow {
    display: grid;
    grid-template-columns: 72px 118px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s;
  }
  .bi-arow:hover .bi-atitle {
    color: var(--ok-ink);
  }
  .bi-athumb :global(svg) {
    width: 72px;
    aspect-ratio: 1200 / 630;
    height: auto;
    display: block;
    border-radius: 6px;
    box-shadow: 0 4px 12px rgba(24, 36, 26, 0.1);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .bi-arow:hover .bi-athumb :global(svg) {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(24, 36, 26, 0.16);
  }
  .bi-acat {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--ok-ink);
  }
  .bi-atitle {
    font-size: 14px;
    line-height: 1.7;
    color: var(--tx);
    transition: color 0.15s;
  }
  .bi-adate {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ─── CHANGELOG（3カラム行・カバーなし） ─── */
  .bi-narrow {
    max-width: 980px;
  }
  .bi-crow {
    display: grid;
    grid-template-columns: 112px 1fr auto;
    gap: 18px;
    align-items: baseline;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }
  .bi-crow:hover .bi-ctitle {
    color: var(--ok-ink);
  }
  .bi-ctitle {
    font-size: 14px;
    line-height: 1.7;
    color: var(--tx);
    transition: color 0.15s;
  }

  /* ─── CATEGORIES ─── */
  .bi-cats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .bi-cat-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 18px 16px;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .bi-cat-card:hover {
    border-color: rgba(124, 175, 0, 0.5);
    transform: translateY(-2px);
    box-shadow: var(--sh-m);
  }
  .bi-cat-card b {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--tx);
  }
  .bi-cat-card span {
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* ─── FILTERED VIEW ─── */
  .bi-view-all[hidden],
  .bi-filtered[hidden],
  .bi-filtered-row[hidden] {
    display: none;
  }
  /* フッターの margin-top:80px が下端の余白を持つ。最後のセクションの
     行リストで途切れないよう最低限だけ足す。 */
  .bi-view-all > section:last-child,
  .bi-filtered {
    padding-bottom: 8px;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1020px) {
    .bi-grid {
      grid-template-columns: 1fr 1fr;
    }
    .bi-feat {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .bi-cats {
      grid-template-columns: 1fr 1fr;
    }
    .bi-crow {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }
  @media (max-width: 820px) {
    .bi-arow {
      grid-template-columns: 56px 1fr;
      gap: 14px;
      row-gap: 4px;
    }
    .bi-athumb {
      grid-row: 1 / span 2;
    }
    .bi-athumb :global(svg) {
      width: 56px;
    }
    .bi-acat,
    .bi-atitle,
    .bi-adate {
      grid-column: 2;
    }
  }
  @media (max-width: 640px) {
    .bi-container {
      padding: 0 24px;
    }
    .bi-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bi-thumb :global(svg),
    .bi-athumb :global(svg),
    .bi-cat-card {
      transition: none;
    }
  }
</style>

<script is:inline>
  // ─── Category filter（一覧の面はそのまま、フィルタ時だけ行リストへ） ───
  (function () {
    var pills = document.querySelectorAll(".bi-pill");
    if (!pills.length) return;
    var viewAll = document.querySelector(".bi-view-all");
    var filtered = document.querySelector(".bi-filtered");
    var label = document.querySelector("[data-filtered-label]");
    var count = document.querySelector("[data-filtered-count]");
    var rows = filtered ? filtered.querySelectorAll(".bi-filtered-row") : [];

    function apply(filter) {
      var isAll = !filter || filter.toLowerCase() === "all";
      pills.forEach(function (p) {
        var pf = (p.getAttribute("data-filter") || "").toLowerCase();
        p.classList.toggle("on", isAll ? pf === "all" : pf === filter.toLowerCase());
      });
      if (viewAll) viewAll.hidden = !isAll;
      if (filtered) filtered.hidden = isAll;
      if (!isAll) {
        var labelText = filter;
        var n = 0;
        rows.forEach(function (r) {
          // data-category is "Primary|Secondary1|…" — match primary or any
          // secondary category.
          var cats = (r.getAttribute("data-category") || "").split("|");
          var match = cats.some(function (cat) {
            return cat.toLowerCase() === filter.toLowerCase();
          });
          r.hidden = !match;
          if (match) {
            n++;
            labelText = cats[0] || filter;
          }
        });
        if (label) label.textContent = labelText;
        if (count) count.textContent = String(n);
      }
    }

    pills.forEach(function (p) {
      p.addEventListener("click", function () {
        var f = p.getAttribute("data-filter") || "all";
        apply(f);
        if (history.replaceState) {
          history.replaceState(
            null,
            "",
            f.toLowerCase() === "all"
              ? location.pathname + location.search
              : "#" + f.toLowerCase(),
          );
        }
      });
    });

    var initial = (location.hash || "").replace(/^#/, "").toLowerCase();
    if (initial) {
      pills.forEach(function (p) {
        if ((p.getAttribute("data-filter") || "").toLowerCase() === initial) {
          apply(p.getAttribute("data-filter"));
        }
      });
    }
  })();
</script>
