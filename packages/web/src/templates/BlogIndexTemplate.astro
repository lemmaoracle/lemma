---
/**
 * Lemma blog — 一覧ページ。モック `lemma_blog_index_mock_v4.html` の面
 * （`Lemma_コンテンツテンプレート_実装指示_v1_2026-07-30.md` §3）。
 *
 * 構成: ヒーロー → フィルタピル → 注目の記事（7:5・カード装飾なし）→
 * すべての記事（3列カードグリッド・ページ送り）→ 変更履歴（3カラム行・
 * カバーなし）→ カテゴリ4枚。
 *
 * 旧構成の「最近の記事6件＋72pxミニカバー行の全記事リスト」は 2026-08-04 に
 * 統合した——ミニサムネはカバーの情報量が出ず（特に写真カバー）、閲覧の
 * 主導線はカードの見え方でページ送りしたい、というフィードバックによる。
 * フィルタ結果も同じカードグリッドで出す（写真カバー混在で色相の単調さは
 * 解消済みのため、行に落とす理由がなくなった）。
 *
 * v24 のスクロール reveal は落とした（`prefers-reduced-motion` でホバー以外の
 * アニメーションを無効にする受け入れ基準に対し、消してしまうのが最も確実。
 * テキスト寄りの一覧では出現アニメーションの意味も薄い）。
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { BLOG_CATEGORIES } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import BlogCoverAuto from "../components/BlogCoverAuto.astro";

export interface BlogIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  /** All entries (essays + changelog) used to feed the filter pills + filtered grid. */
  entries: ReadonlyArray<BlogPost>;
  featured?: BlogPost;
  recent: ReadonlyArray<BlogPost>;
  changelog?: ReadonlyArray<BlogPost>;
}

const { locale, t, base, blogPath, entries, featured, recent, changelog = [] } =
  Astro.props as BlogIndexTemplateProps;

const isJa = locale === "ja";

// Category counts — both for filter pills and the categories nav strip.
// Includes the primary category plus any secondary_categories so a post
// with `secondary_categories: ["Announcements"]` is counted toward
// Announcements as well.
const categoryCounts: Record<string, number> = {};
for (const p of entries) {
  categoryCounts[p.category] = (categoryCounts[p.category] ?? 0) + 1;
  if (p.secondaryCategories) {
    for (const sc of p.secondaryCategories) {
      categoryCounts[sc] = (categoryCounts[sc] ?? 0) + 1;
    }
  }
}
const categories = BLOG_CATEGORIES.filter(
  (c) => (categoryCounts[c] ?? 0) > 0,
);

const readCta = isJa ? "読む →" : "Read →";

/**
 * カテゴリの説明1行（フィルタのカードに出る）。
 *
 * **4カテゴリは「読者が誰か」ではなく「記事が何を渡すか」で分ける。**
 * 読者の軸は frontmatter の `audience`（business / technical）が別に持って
 * いるので、ここで重ねない——両方を読者軸にすると境界が崩れる（実際、
 * 旧「業務への組み込み方と検証結果」は適用の話と実装の話の両方を吸い、
 * Solutions に技術記事が混ざる原因になっていた）。
 *
 *   Industry     論点・エッセイ    …… 事業に取り入れる価値（新しいジャンルの提示を含む）
 *   Solutions    業務への適用シーン …… どの業務の、どの場面で効くか
 *   Technical    設計・実装の詳細   …… 開発者・アーキテクト向け
 *   Announcements 公開のお知らせ
 *
 * 文言は**名詞形・1行に収まる長さ**で揃える（カードの幅で折り返すと
 * 視線が止まる）。JA は10〜11字、EN は約30字が上限。
 */
const CATEGORY_DESC: Record<string, Record<Locale, string>> = {
  Announcements: {
    ja: "新機能・公開のお知らせ",
    en: "Features and releases",
  },
  Industry: {
    ja: "事業に取り入れる価値",
    en: "The value of adoption",
  },
  Solutions: {
    ja: "業務での適用シーン",
    en: "Where it applies",
  },
  Technical: {
    ja: "設計・仕様・実装の詳細",
    en: "Design and specs",
  },
};

// 購読導線は RSS だけ（メール購読は 2026-08 に全廃）。`<head>` の
// rel="alternate" はリーダーの自動検出用で人には見えないので、面にも出す。
// Brief 一覧（BriefIndexTemplate の `.cb-acts`）と同じ扱い。
const rssHref = `${base}/rss.xml`;

const C = isJa
  ? {
      lead: "証明基盤の設計と実装、AI時代の信頼をめぐる論点。新機能のアナウンスから技術仕様まで。",
      rss: "RSS フィード",
      allDesc: "全カテゴリの記事を新着順に",
      featured: "注目の記事",
      featuredEn: "Featured",
      recent: "最近の記事",
      recentEn: "Recent",
      all: "すべての記事",
      changelog: "変更履歴",
      changelogEn: "Changelog",
    }
  : {
      lead: "Design and implementation of proof infrastructure, and the questions of trust in the AI era — from announcements to technical specs.",
      rss: "RSS feed",
      allDesc: "Every category, newest first",
      featured: "Featured",
      featuredEn: "Featured",
      recent: "Recent",
      recentEn: "Recent",
      all: "All articles",
      changelog: "Changelog",
      changelogEn: "Changelog",
    };
---

<Layout
  locale={locale}
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  metaType="page"
  pagePath="/blog/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="bi-page">
    <div class="bi-container">
      <section class="bi-hero">
        {/* 旧 kicker「Blog」は削除 — h1（ブログ/Blog）と同語反復で情報が無い。
            他ページの kicker は情報を足しているので残している。 */}
        <h1 class="bi-h1">{t.blog.title}</h1>
        <p class="bi-lead">{C.lead}</p>
        <div class="bi-acts">
          <a href={rssHref}>{C.rss}</a>
        </div>
        {/* カテゴリの提示はここ1箇所（説明1行付きのカード型フィルタ）。
            旧構成では末尾にも説明付きカードがあり二重だったため、丁寧な
            方の表記を冒頭に統合した。 */}
        {categories.length > 0 && (
          <nav class="bi-filter" aria-label={t.blog.index.categoriesLabel}>
            <button class="bi-pill on" data-filter="all" type="button">
              <b>{t.blog.index.allTag} <i>{entries.length}</i></b>
              <span>{C.allDesc}</span>
            </button>
            {categories.map((c) => (
              <button class="bi-pill" data-filter={c} type="button">
                <b>{c} <i>{categoryCounts[c]}</i></b>
                <span>{CATEGORY_DESC[c]?.[locale] ?? ""}</span>
              </button>
            ))}
          </nav>
        )}
      </section>

      <div class="bi-view-all">
        {featured && (
          <section>
            <div class="bi-label">
              <b>{C.featured}</b><span>{C.featuredEn}</span>
            </div>
            {/* カード装飾は付けない — サムネイル＋テキストのみ（§3.1-3）。 */}
            <a class="bi-feat" href={`${blogPath}/${featured.slug}`}>
              <div class="bi-thumb">
                <BlogCoverAuto category={featured.category} slug={featured.slug} coverPhoto={featured.coverPhoto} cover={featured.cover} tags={featured.tags} coverLines={featured.coverLines} locale={locale} />
              </div>
              <div>
                <div class="bi-meta">
                  <span class="bi-cat">{featured.category}</span>
                  <span class="bi-sep">·</span>
                  <time>{featured.date}</time>
                </div>
                <h2 class="bi-feat-title">{featured.title}</h2>
                {featured.abstract && <p class="bi-feat-ex">{featured.abstract}</p>}
                <span class="bi-cta">{readCta}</span>
              </div>
            </a>
          </section>
        )}

        {entries.length > 1 && (
          <section data-all-section>
            <div class="bi-label">
              <b>{C.all}</b><span>All — {entries.length}</span>
            </div>
            {/* 注目に出した1本は重複させず、残りをカードで。注目枠は導入事例で
                固定なので**先頭とは限らない** — 添字ではなく slug で外す。
                ページ送りは SSR 全件 + 表示切り替え（Brief 一覧と同じ方式）。 */}
            <div class="bi-grid">
              {entries.filter((post) => post.slug !== featured?.slug).map((post) => (
                <a class="bi-card" href={`${blogPath}/${post.slug}`}>
                  <div class="bi-thumb">
                    <BlogCoverAuto category={post.category} slug={post.slug} coverPhoto={post.coverPhoto} cover={post.cover} tags={post.tags} coverLines={post.coverLines} locale={locale} />
                  </div>
                  <div class="bi-meta">
                    <span class="bi-cat">{post.category}</span>
                    <span class="bi-sep">·</span>
                    <time>{post.date}</time>
                  </div>
                  <h3 class="bi-card-title">{post.title}</h3>
                  {post.abstract && <p class="bi-card-ex">{post.abstract}</p>}
                  <span class="bi-cta">{readCta}</span>
                </a>
              ))}
            </div>
            <nav class="bi-pager" data-pager hidden aria-label="Pagination"></nav>
          </section>
        )}

        {changelog.length > 0 && (
          <section class="bi-narrow">
            <div class="bi-label">
              <b>{C.changelog}</b><span>{C.changelogEn}</span>
            </div>
            <div>
              {changelog.map((post) => (
                <a class="bi-crow" href={`${blogPath}/${post.slug}`}>
                  <span class="bi-acat">{post.category}</span>
                  <span class="bi-ctitle">{post.title}</span>
                  <span class="bi-adate">{post.date}</span>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>

      {/* フィルタ結果も同じカードグリッド（注目の1本目も対象に含めるため
          全 entries を持つ。既定表示では非表示なので重複しない）。 */}
      <section class="bi-filtered" hidden>
        <div class="bi-label">
          <b data-filtered-label></b><span data-filtered-count></span>
        </div>
        <div class="bi-grid">
          {entries.map((post) => (
            <a
              class="bi-card bi-filtered-card"
              href={`${blogPath}/${post.slug}`}
              data-category={[post.category, ...(post.secondaryCategories ?? [])].join("|")}
            >
              <div class="bi-thumb">
                <BlogCoverAuto category={post.category} slug={post.slug} coverPhoto={post.coverPhoto} cover={post.cover} tags={post.tags} coverLines={post.coverLines} locale={locale} />
              </div>
              <div class="bi-meta">
                <span class="bi-cat">{post.category}</span>
                <span class="bi-sep">·</span>
                <time>{post.date}</time>
              </div>
              <h3 class="bi-card-title">{post.title}</h3>
              {post.abstract && <p class="bi-card-ex">{post.abstract}</p>}
              <span class="bi-cta">{readCta}</span>
            </a>
          ))}
        </div>
        <nav class="bi-pager" data-pager-filtered hidden aria-label="Pagination"></nav>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* トークンの値は記事テンプレート（BlogArticleTemplate）と同じもの。 */
  .bi-page {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.09), 0 2px 6px rgba(14, 18, 16, 0.05);
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", monospace;

    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    padding: 0;
    padding-top: 64px; /* sticky ナビ時代の margin-top:64px を padding に変換 — body 背景色の帯を出さない（H1 上の空白修正） */
  }
  .bi-container {
    max-width: calc(1180px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
  }
  .bi-page a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO + FILTER ─── */
  .bi-hero {
    padding: 46px 0 0;
  }
  .bi-h1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(28px, 3.2vw, 38px);
    letter-spacing: 0.04em;
    color: var(--tx);
    margin: 0 0 12px;
  }
  .bi-lead {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.95;
    color: var(--tx-soft);
    max-width: 62ch;
  }
  /* 購読導線（RSS）。Brief 一覧の `.cb-acts` と同じ見た目・同じ位置。 */
  .bi-acts {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin: 14px 0 0;
    font-size: 12.5px;
  }
  .bi-acts a {
    color: var(--ok-ink);
    border-bottom: 1px solid rgba(111, 156, 0, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }
  .bi-acts a:hover {
    border-color: var(--ok-ink);
  }
  /* カテゴリフィルタ — 説明1行付きのカード型（旧・末尾カテゴリカードの
     表記をフィルタに統合）。 */
  .bi-filter {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin: 30px 0 0;
  }
  .bi-pill {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    text-align: left;
    font-family: var(--font-body);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px 12px;
    cursor: pointer;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s, background 0.18s;
  }
  .bi-pill:hover {
    border-color: rgba(124, 175, 0, 0.5);
    transform: translateY(-2px);
    box-shadow: var(--sh-m);
  }
  .bi-pill b {
    font-weight: 600;
    font-size: 13.5px;
    color: var(--tx);
  }
  .bi-pill span {
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .bi-pill i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 400;
    color: var(--muted);
    margin-left: 2px;
  }
  /* 選択中は蛍光地に墨文字（§3.1-2）。 */
  .bi-pill.on {
    background: var(--ok);
    border-color: var(--ok);
  }
  .bi-pill.on b,
  .bi-pill.on i {
    color: var(--ink);
  }
  .bi-pill.on span {
    color: var(--ink);
    opacity: 0.72;
  }

  /* ─── SECTION LABEL ───
     ラベル行の罫線が上境界を兼ねる。直下に別の全幅罫線は置かない（§6-2）。 */
  .bi-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 60px 0 22px;
  }
  .bi-label b {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.06em;
    color: var(--tx);
  }
  .bi-label span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bi-label::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }

  /* ─── サムネイル（共通・16:9） ───
     4:3 は縦が伸びて抽象カバーの存在感が過剰になる（§3.2）。 */
  .bi-thumb :global(svg),
  .bi-thumb :global(.cover-photo) {
    width: 100%;
    aspect-ratio: 1200 / 630;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(24, 36, 26, 0.11);
    transition: transform 0.18s, box-shadow 0.18s, filter 0.18s;
  }
  /* ホバー時の微アニメーション: 絵全体がわずかに明るくなり、写真では
     走査線が一段強く光る。動きは既存の持ち上げ（translateY）に任せ、
     ここでは光量だけを足す — 「検証済みの記号が反応する」以上はやらない。 */
  .bi-feat:hover .bi-thumb :global(svg),
  .bi-feat:hover .bi-thumb :global(.cover-photo),
  .bi-card:hover .bi-thumb :global(svg),
  .bi-card:hover .bi-thumb :global(.cover-photo) {
    filter: brightness(1.045);
  }
  .bi-feat:hover .bi-thumb :global(.cover-photo)::before,
  .bi-card:hover .bi-thumb :global(.cover-photo)::before {
    opacity: 1;
    box-shadow: 0 0 9px rgba(168, 224, 16, 0.5);
  }

  /* ─── FEATURED（7:5・装飾なし） ─── */
  .bi-feat {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 38px;
    align-items: center;
  }
  .bi-feat .bi-thumb :global(svg),
  .bi-feat .bi-thumb :global(.cover-photo) {
    border-radius: 14px;
  }
  .bi-feat:hover .bi-thumb :global(svg),
  .bi-feat:hover .bi-thumb :global(.cover-photo) {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(24, 36, 26, 0.17);
  }
  .bi-feat-title {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(19px, 2.1vw, 25px);
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 12px 0 12px;
  }
  .bi-feat-ex {
    margin: 0 0 18px;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--tx-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── META（共通） ─── */
  .bi-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .bi-cat {
    color: var(--ok-ink);
  }
  .bi-sep {
    opacity: 0.5;
  }
  .bi-cta {
    font-size: 12.5px;
    color: var(--ok-ink);
  }

  /* ─── RECENT（3列・ホバーはサムネイルだけが浮く） ─── */
  .bi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .bi-card {
    display: flex;
    flex-direction: column;
  }
  .bi-card .bi-meta {
    margin: 16px 0 8px;
  }
  .bi-card:hover .bi-thumb :global(svg),
  .bi-card:hover .bi-thumb :global(.cover-photo) {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(24, 36, 26, 0.16);
  }
  .bi-card-title {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 0 0 10px;
  }
  .bi-card-ex {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.85;
    color: var(--tx-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bi-card .bi-cta {
    margin-top: auto;
  }

  /* .bi-acat / .bi-adate は変更履歴の行（.bi-crow）が使う。 */
  .bi-acat {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--ok-ink);
  }
  .bi-adate {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ─── CHANGELOG（3カラム行・カバーなし） ─── */
  .bi-narrow {
    max-width: 980px;
  }
  .bi-crow {
    display: grid;
    grid-template-columns: 112px 1fr auto;
    gap: 18px;
    align-items: baseline;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }
  .bi-crow:hover .bi-ctitle {
    color: var(--ok-ink);
  }
  .bi-ctitle {
    font-size: 14px;
    line-height: 1.7;
    color: var(--tx);
    transition: color 0.15s;
  }

  /* ─── CATEGORIES ─── */
  /* 末尾のカテゴリカード節は冒頭のフィルタに統合済み（2026-08-04）。
     ページ下端の余白は .bi-page の padding が持ち、フッターの margin で
     body 背景色の帯が出ないようにする。 */
  .bi-page {
    padding-bottom: 48px;
  }

  /* ─── ページ送り（Brief 一覧と同じ言語: 現在ページ=蛍光地に墨文字） ─── */
  .bi-pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin: 26px 0 0;
  }
  .bi-pager[hidden] {
    display: none;
  }
  .bi-pager :global(.bi-pager-btn) {
    min-width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0 8px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .bi-pager :global(.bi-pager-btn:hover:not([disabled])) {
    border-color: rgba(124, 175, 0, 0.5);
    color: var(--tx);
  }
  .bi-pager :global(.bi-pager-btn.is-active) {
    background: var(--ok);
    border-color: var(--ok);
    color: var(--ink);
    font-weight: 700;
    cursor: default;
  }
  .bi-pager :global(.bi-pager-btn[disabled]) {
    opacity: 0.4;
    cursor: default;
  }

  /* ─── FILTERED VIEW / ページ送りの表示切り替え ─── */
  .bi-view-all[hidden],
  .bi-filtered[hidden],
  .bi-card[hidden] {
    display: none !important;
  }
  /* フッターの margin-top:80px が下端の余白を持つ。最後のセクションの
     行リストで途切れないよう最低限だけ足す。 */
  .bi-view-all > section:last-child,
  .bi-filtered {
    padding-bottom: 8px;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1020px) {
    .bi-grid {
      grid-template-columns: 1fr 1fr;
    }
    .bi-feat {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .bi-filter {
      grid-template-columns: 1fr 1fr;
    }
    .bi-crow {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }
  @media (max-width: 640px) {
    .bi-container {
      padding: 0 24px;
    }
    .bi-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bi-thumb :global(svg),
    .bi-thumb :global(.cover-photo),
    .bi-pill {
      transition: none;
    }
  }
</style>

<script is:inline>
  // ─── Category filter（既定はカードグリッド＋ページ送り、フィルタ時は
  //     同じカードの絞り込みグリッドへ切り替え） ───
  (function () {
    var pills = document.querySelectorAll(".bi-pill");
    if (!pills.length) return;
    var viewAll = document.querySelector(".bi-view-all");
    var filtered = document.querySelector(".bi-filtered");
    var label = document.querySelector("[data-filtered-label]");
    var count = document.querySelector("[data-filtered-count]");
    var rows = filtered ? filtered.querySelectorAll(".bi-filtered-card") : [];
    var allSection = document.querySelector("[data-all-section]");
    var allRows = allSection
      ? allSection.querySelectorAll(".bi-card")
      : [];
    var pagerAll = document.querySelector("[data-pager]");
    var pagerFiltered = document.querySelector("[data-pager-filtered]");

    // ページ送り: SSR は全件のまま、表示だけを PAGE_SIZE 行ずつに切る
    // （Brief 一覧と同じ方式）。「すべての記事」とフィルタ結果の両方に効き、
    // 1ページに収まるときはページャー自体を出さない。
    var PAGE_SIZE = 9; // 3列×3行 — 「まだ下に長い」フィードバックで 12 から縮小
    var pageAll = 1;
    var pageFiltered = 1;

    /* ページ番号を URL に持たせる（?page=N）。持たせないとページ送りしても
       URL が変わらず、リロードやリンク共有で1ページ目に戻ってしまう。
       カテゴリの絞り込みは従来どおり hash（#industry）が持つので、両者は
       衝突しない。1ページ目のときは ?page= を消して URL を素のままにする。 */
    function readPageFromUrl() {
      var m = /[?&]page=(\d+)/.exec(location.search);
      return m ? Math.max(1, parseInt(m[1], 10) || 1) : 1;
    }
    function writePageToUrl(n) {
      if (!history.replaceState) return;
      var params = new URLSearchParams(location.search);
      if (n <= 1) params.delete("page");
      else params.set("page", String(n));
      var q = params.toString();
      history.replaceState(null, "", location.pathname + (q ? "?" + q : "") + location.hash);
    }

    function renderPager(pager, current, totalPages) {
      if (!pager) return;
      if (totalPages <= 1) {
        pager.innerHTML = "";
        pager.hidden = true;
        return;
      }
      var html =
        '<button type="button" class="bi-pager-btn bi-pager-arrow" data-page="prev" aria-label="Previous"' +
        (current === 1 ? " disabled" : "") +
        ">‹</button>";
      for (var p = 1; p <= totalPages; p++) {
        html +=
          '<button type="button" class="bi-pager-btn' +
          (p === current ? " is-active" : "") +
          '" data-page="' +
          p +
          '"' +
          (p === current ? ' aria-current="page"' : "") +
          ">" +
          p +
          "</button>";
      }
      html +=
        '<button type="button" class="bi-pager-btn bi-pager-arrow" data-page="next" aria-label="Next"' +
        (current === totalPages ? " disabled" : "") +
        ">›</button>";
      pager.innerHTML = html;
      pager.hidden = false;
    }

    function paginate(list, matches, current, pager) {
      var visible = [];
      list.forEach(function (r) {
        if (matches(r)) visible.push(r);
      });
      var totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
      if (current > totalPages) current = totalPages;
      var start = (current - 1) * PAGE_SIZE;
      list.forEach(function (r) {
        r.hidden = true;
      });
      visible.slice(start, start + PAGE_SIZE).forEach(function (r) {
        r.hidden = false;
      });
      renderPager(pager, current, totalPages);
      return { current: current, count: visible.length, totalPages: totalPages };
    }

    function applyAllPage() {
      var st = paginate(
        allRows,
        function () {
          return true;
        },
        pageAll,
        pagerAll,
      );
      pageAll = st.current;
    }

    var activeFilter = "";
    function matchesFilter(r) {
      var cats = (r.getAttribute("data-category") || "").split("|");
      return cats.some(function (cat) {
        return cat.toLowerCase() === activeFilter.toLowerCase();
      });
    }

    function apply(filter) {
      var isAll = !filter || filter.toLowerCase() === "all";
      pills.forEach(function (p) {
        var pf = (p.getAttribute("data-filter") || "").toLowerCase();
        p.classList.toggle("on", isAll ? pf === "all" : pf === filter.toLowerCase());
      });
      if (viewAll) viewAll.hidden = !isAll;
      if (filtered) filtered.hidden = isAll;
      // 絞り込みを変えると母集合が変わるので1ページ目へ戻す（URL も揃える）
      writePageToUrl(1);
      pageAll = 1;
      if (!isAll) {
        activeFilter = filter;
        pageFiltered = 1;
        var labelText = filter;
        rows.forEach(function (r) {
          var cats = (r.getAttribute("data-category") || "").split("|");
          if (
            cats.some(function (cat) {
              return cat.toLowerCase() === filter.toLowerCase();
            })
          ) {
            labelText = cats[0] || filter;
          }
        });
        var st = paginate(rows, matchesFilter, pageFiltered, pagerFiltered);
        pageFiltered = st.current;
        if (label) label.textContent = labelText;
        if (count) count.textContent = String(st.count);
      }
    }

    function scrollToHead(section) {
      if (!section) return;
      var head = section.querySelector(".bi-label") || section;
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      head.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    }

    function wirePager(pager, getState, setPage, rerender, section) {
      if (!pager) return;
      pager.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-page]");
        if (!btn || btn.hasAttribute("disabled")) return;
        var st = getState();
        var v = btn.getAttribute("data-page");
        var next = st.current;
        if (v === "prev") next = Math.max(1, st.current - 1);
        else if (v === "next") next = Math.min(st.totalPages, st.current + 1);
        else next = Number(v) || 1;
        setPage(next);
        rerender();
        writePageToUrl(next);
        scrollToHead(section);
      });
    }

    wirePager(
      pagerAll,
      function () {
        return {
          current: pageAll,
          totalPages: Math.max(1, Math.ceil(allRows.length / PAGE_SIZE)),
        };
      },
      function (p) {
        pageAll = p;
      },
      applyAllPage,
      allSection,
    );
    wirePager(
      pagerFiltered,
      function () {
        var n = 0;
        rows.forEach(function (r) {
          if (matchesFilter(r)) n++;
        });
        return {
          current: pageFiltered,
          totalPages: Math.max(1, Math.ceil(n / PAGE_SIZE)),
        };
      },
      function (p) {
        pageFiltered = p;
      },
      function () {
        var st = paginate(rows, matchesFilter, pageFiltered, pagerFiltered);
        pageFiltered = st.current;
      },
      filtered,
    );

    pills.forEach(function (p) {
      p.addEventListener("click", function () {
        var f = p.getAttribute("data-filter") || "all";
        apply(f);
        if (history.replaceState) {
          history.replaceState(
            null,
            "",
            f.toLowerCase() === "all"
              ? location.pathname + location.search
              : "#" + f.toLowerCase(),
          );
        }
      });
    });

    var initial = (location.hash || "").replace(/^#/, "").toLowerCase();
    if (initial) {
      pills.forEach(function (p) {
        if ((p.getAttribute("data-filter") || "").toLowerCase() === initial) {
          apply(p.getAttribute("data-filter"));
        }
      });
    }
    // URL の ?page=N を復元してから描画する（リロード・リンク共有で戻らない）
    var startPage = readPageFromUrl();
    if (filtered && !filtered.hidden) {
      pageFiltered = startPage;
      var st0 = paginate(rows, matchesFilter, pageFiltered, pagerFiltered);
      pageFiltered = st0.current;
      if (count) count.textContent = String(st0.count);
    } else {
      pageAll = startPage;
    }
    applyAllPage();
    // 総ページ数を超える値が来ていたら、丸めた結果を URL に書き戻す
    writePageToUrl(filtered && !filtered.hidden ? pageFiltered : pageAll);
  })();
</script>
