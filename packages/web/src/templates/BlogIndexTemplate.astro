---
/**
 * Lemma blog — index page, v24-aligned.
 *
 * Migrated from the prior v22 chrome (dark hero + multi-section
 * white/gray/black backgrounds) to v24: cream page throughout,
 * container 1100px (Brief Index parity), Sora display + Noto Sans JP
 * body + Space Mono labels, saddle brown accent on eyebrows / links /
 * pills / hover bars.
 *
 * Section order is preserved (header → filter pills → featured →
 * recent → archive → changelog → guides → foundations → filtered).
 * The category-filter JS and the reveal IntersectionObserver are
 * preserved verbatim at the bottom of the file. Post fetching and
 * props shape (data/blog.ts) are untouched.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { BLOG_CATEGORIES } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";

export interface BlogIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  entries: ReadonlyArray<BlogPost>;
  featured?: BlogPost;
  recent: ReadonlyArray<BlogPost>;
  archive: ReadonlyArray<BlogPost>;
  changelog?: ReadonlyArray<BlogPost>;
  guides: ReadonlyArray<BlogPost>;
  foundations: ReadonlyArray<BlogPost>;
}

const {
  locale,
  t,
  base,
  blogPath,
  entries,
  featured,
  recent,
  archive,
  changelog = [],
  guides,
  foundations,
} = Astro.props as BlogIndexTemplateProps;

// Canonical taxonomy order; only categories with posts become pills.
const categoryCounts: Record<string, number> = {};
for (const p of entries) {
  categoryCounts[p.category] = (categoryCounts[p.category] ?? 0) + 1;
}
const categories = BLOG_CATEGORIES.filter(
  (c) => (categoryCounts[c] ?? 0) > 0,
);
---

<Layout
  locale={locale}
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  metaType="page"
  pagePath="/blog/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="bx-page">
    <div class="bx-container">
      <section class="bx-hero">
        <div class="bx-eyebrow">{t.blog.title}</div>
        <h1 class="bx-h1">{t.blog.subtitle}</h1>
        <p class="bx-hero-sub">{t.blog.index.headerDesc}</p>
      </section>

      {categories.length > 0 && (
        <nav class="bx-filter" aria-label={t.blog.index.categoriesLabel}>
          <button class="bx-pill is-active" data-filter="all" type="button">
            {t.blog.index.allTag}
            <span class="bx-pill-count">{entries.length}</span>
          </button>
          {categories.map((c) => (
            <button class="bx-pill" data-filter={c} type="button">
              {c}
              <span class="bx-pill-count">{categoryCounts[c]}</span>
            </button>
          ))}
        </nav>
      )}

      <div class="bx-view-all">
        {featured && (
          <section class="bx-featured-section">
            <div class="bx-section-label">{t.blog.index.featuredTag}</div>
            <a
              href={`${blogPath}/${featured.slug}`}
              class="bx-featured-card reveal"
            >
              <div
                class="bx-featured-thumb"
                style={`background-image:url('${featured.cover ?? ""}')`}
              ></div>
              <div class="bx-featured-body">
                <div class="bx-essay-meta">
                  <span class="bx-essay-cat">{featured.category}</span>
                  <span class="bx-essay-sep">·</span>
                  <span class="bx-essay-date">{featured.date}</span>
                </div>
                <h2 class="bx-featured-title">{featured.title}</h2>
                <p class="bx-featured-abstract">{featured.abstract}</p>
                <span class="bx-featured-cta">{t.blog.index.featuredCta}</span>
              </div>
            </a>
          </section>
        )}

        {recent.length > 0 && (
          <section class="bx-recent-section">
            <div class="bx-section-label">{t.blog.index.recentTag}</div>
            <div class="bx-card-grid">
              {recent.map((post, i) => (
                <a
                  href={`${blogPath}/${post.slug}`}
                  class="bx-card reveal"
                  style={`transition-delay:${i * 0.05}s`}
                >
                  <div class="bx-essay-meta">
                    <span class="bx-essay-cat">{post.category}</span>
                    <span class="bx-essay-sep">·</span>
                    <span class="bx-essay-date">{post.date}</span>
                  </div>
                  <h3 class="bx-card-title">{post.title}</h3>
                  <p class="bx-card-abstract">{post.abstract}</p>
                  <span class="bx-card-cta">{t.blog.index.readEssay}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {archive.length > 0 && (
          <section class="bx-archive-section">
            <div class="bx-section-label">{t.blog.index.archiveTag}</div>
            <ul class="bx-archive-list">
              {archive.map((post) => (
                <li class="bx-archive-row reveal">
                  <a
                    href={`${blogPath}/${post.slug}`}
                    class="bx-archive-link"
                  >
                    <span class="bx-archive-cat">{post.category}</span>
                    <span class="bx-archive-title">{post.title}</span>
                    <span class="bx-archive-date">{post.date}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {changelog.length > 0 && (
          <section class="bx-archive-section">
            <div class="bx-section-label">
              {t.blog.sections["Changelog"] ?? "Changelog"}
            </div>
            <ul class="bx-archive-list">
              {changelog.map((post) => (
                <li class="bx-archive-row reveal">
                  <a
                    href={`${blogPath}/${post.slug}`}
                    class="bx-archive-link"
                  >
                    <span class="bx-archive-cat">{post.category}</span>
                    <span class="bx-archive-title">{post.title}</span>
                    <span class="bx-archive-date">{post.date}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {guides.length > 0 && (
          <section class="bx-guides-section">
            <div class="bx-section-label">{t.blog.index.guidesTag}</div>
            <div class="bx-guides-head">
              <div class="bx-guides-title">{t.blog.index.guidesTitle}</div>
              <p class="bx-guides-desc">{t.blog.index.guidesDesc}</p>
            </div>
            <div class="bx-card-grid">
              {guides.map((post, i) => (
                <a
                  href={`${blogPath}/${post.slug}`}
                  class="bx-card reveal"
                  style={`transition-delay:${i * 0.05}s`}
                >
                  <div class="bx-essay-meta">
                    <span class="bx-essay-cat">{post.category}</span>
                    <span class="bx-essay-sep">·</span>
                    <span class="bx-essay-date">{post.date}</span>
                  </div>
                  <h3 class="bx-card-title">{post.title}</h3>
                  <p class="bx-card-abstract">{post.abstract}</p>
                  <span class="bx-card-cta">{t.blog.index.readGuide}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {foundations.length > 0 && (
          <section class="bx-foundations-section">
            <div class="bx-section-label">{t.blog.index.foundationsTag}</div>
            <div class="bx-foundations-grid">
              {foundations.map((post) => (
                <a
                  href={`${blogPath}/${post.slug}`}
                  class="bx-foundations-card reveal"
                >
                  <div class="bx-foundations-text">
                    <h3 class="bx-foundations-title">{post.title}</h3>
                    <p class="bx-foundations-abstract">{post.abstract}</p>
                  </div>
                  <span class="bx-foundations-cta">
                    {t.blog.index.readSpecs} →
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <section class="bx-filtered-section" hidden>
        <div
          class="bx-section-label bx-filtered-label"
          data-filtered-label
        ></div>
        <div class="bx-card-grid bx-filtered-grid">
          {entries.map((post) => (
            <a
              href={`${blogPath}/${post.slug}`}
              class="bx-card bx-filtered-card"
              data-category={post.category}
            >
              <div class="bx-essay-meta">
                <span class="bx-essay-cat">{post.category}</span>
                <span class="bx-essay-sep">·</span>
                <span class="bx-essay-date">{post.date}</span>
              </div>
              <h3 class="bx-card-title">{post.title}</h3>
              <p class="bx-card-abstract">{post.abstract}</p>
              <span class="bx-card-cta">{t.blog.index.readEssay}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .bx-page {
    --bx-display: "Sora", system-ui, sans-serif;
    --bx-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --bx-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --bx-text-1: #1a1a1a;
    --bx-text-2: #3a3a3a;
    --bx-text-3: #5a5a5a;
    --bx-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--bx-text-2);
    font-family: var(--bx-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .bx-page {
    --bx-body: "Sora", system-ui, sans-serif;
  }

  .bx-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .bx-hero {
    padding: 60px 0 56px;
  }
  .bx-eyebrow {
    font-family: var(--bx-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bx-text-3);
    margin: 0 0 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bx-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .bx-h1 {
    font-family: var(--bx-display);
    font-size: 72px;
    font-weight: 700;
    line-height: 0.96;
    margin: 0 0 24px;
    color: var(--black);
    letter-spacing: -0.04em;
    max-width: 920px;
  }
  :root[lang="ja"] .bx-h1 {
    font-size: 56px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .bx-hero-sub {
    font-size: 16px;
    color: var(--bx-text-2);
    margin: 0;
    line-height: 1.75;
    max-width: 680px;
  }

  /* ─── FILTER BAR ─── */
  .bx-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 56px;
    padding: 22px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .bx-pill {
    font-family: var(--bx-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--bx-text-3);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .bx-pill:hover {
    color: var(--accent);
    border-color: rgba(139, 69, 19, 0.4);
  }
  .bx-pill.is-active {
    color: var(--lemma-cream);
    background: var(--accent);
    border-color: var(--accent);
  }
  .bx-pill-count {
    font-family: var(--bx-mono);
    font-size: 10px;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* ─── SECTION LABEL (mono brown eyebrow) ─── */
  .bx-section-label {
    font-family: var(--bx-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bx-section-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  /* ─── FEATURED ─── */
  .bx-featured-section {
    margin: 0 0 80px;
  }
  .bx-featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
  }
  .bx-featured-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    z-index: 1;
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bx-featured-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 16px 40px rgba(139, 69, 19, 0.08);
    transform: translateY(-2px);
  }
  .bx-featured-card:hover::before {
    width: 100%;
  }
  .bx-featured-thumb {
    background-size: cover;
    background-position: center;
    background-color: var(--lemma-cream-deep);
    min-height: 320px;
  }
  .bx-featured-body {
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  .bx-featured-title {
    font-family: var(--bx-display);
    font-size: clamp(24px, 2.8vw, 30px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--black);
    letter-spacing: -0.02em;
    margin: 0;
  }
  :root[lang="ja"] .bx-featured-title {
    line-height: 1.35;
  }
  .bx-featured-abstract {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--bx-text-2);
    margin: 0;
  }
  .bx-featured-cta {
    font-family: var(--bx-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: 4px;
    transition: transform 0.2s;
  }
  .bx-featured-card:hover .bx-featured-cta {
    transform: translateX(4px);
  }

  /* ─── ESSAY META (shared across cards) ─── */
  .bx-essay-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--bx-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--bx-text-3);
  }
  .bx-essay-cat {
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bx-essay-sep {
    color: var(--lemma-line);
  }
  .bx-essay-date {
    font-variant-numeric: tabular-nums;
  }

  /* ─── RECENT / GUIDES / FILTERED — shared card grid ─── */
  .bx-recent-section,
  .bx-guides-section,
  .bx-filtered-section {
    margin: 0 0 72px;
  }
  .bx-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .bx-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 24px 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .bx-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bx-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .bx-card:hover::before {
    width: 100%;
  }
  .bx-card-title {
    font-family: var(--bx-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--black);
    letter-spacing: -0.015em;
    margin: 0;
  }
  :root[lang="ja"] .bx-card-title {
    line-height: 1.5;
  }
  .bx-card-abstract {
    font-size: 13px;
    line-height: 1.65;
    color: var(--bx-text-3);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bx-card-cta {
    font-family: var(--bx-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 14px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .bx-card:hover .bx-card-cta {
    transform: translateX(3px);
  }

  /* ─── ARCHIVE (list) ─── */
  .bx-archive-section {
    margin: 0 0 72px;
  }
  .bx-archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .bx-archive-row {
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .bx-archive-row:last-child {
    border-bottom: 0;
  }
  .bx-archive-link {
    display: grid;
    grid-template-columns: 180px 1fr 110px;
    gap: 20px;
    align-items: baseline;
    padding: 18px 24px;
    transition: background 0.2s;
  }
  .bx-archive-link:hover {
    background: var(--lemma-cream-deep);
  }
  .bx-archive-cat {
    font-family: var(--bx-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .bx-archive-title {
    font-family: var(--bx-display);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--black);
    letter-spacing: -0.005em;
  }
  .bx-archive-date {
    font-family: var(--bx-mono);
    font-size: 11px;
    color: var(--bx-text-3);
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* ─── GUIDES head ─── */
  .bx-guides-head {
    margin: 0 0 32px;
    max-width: 720px;
  }
  .bx-guides-title {
    font-family: var(--bx-display);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 10px;
  }
  :root[lang="ja"] .bx-guides-title {
    line-height: 1.35;
  }
  .bx-guides-desc {
    font-size: 14.5px;
    color: var(--bx-text-3);
    line-height: 1.7;
    margin: 0;
  }

  /* ─── FOUNDATIONS — cream-deep card (was black) ─── */
  .bx-foundations-section {
    margin: 0 0 0;
  }
  .bx-foundations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .bx-foundations-card {
    background: var(--lemma-cream-deep);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .bx-foundations-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bx-foundations-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
  }
  .bx-foundations-card:hover::before {
    width: 100%;
  }
  .bx-foundations-text {
    flex: 1;
    min-width: 280px;
  }
  .bx-foundations-title {
    font-family: var(--bx-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .bx-foundations-abstract {
    font-size: 13.5px;
    color: var(--bx-text-2);
    line-height: 1.7;
    max-width: 560px;
    margin: 0;
  }
  .bx-foundations-cta {
    font-family: var(--bx-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: transform 0.2s;
    white-space: nowrap;
  }
  .bx-foundations-card:hover .bx-foundations-cta {
    transform: translateX(4px);
  }

  /* ─── FILTERED VIEW ─── */
  .bx-view-all[hidden],
  .bx-filtered-section[hidden] {
    display: none;
  }
  .bx-filtered-card[hidden] {
    display: none;
  }
  .bx-filtered-label::before {
    background: var(--accent);
  }

  /* ─── REVEAL ─── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
  }
  .reveal.on {
    opacity: 1;
    transform: translateY(0);
  }
  .bx-featured-card.reveal,
  .bx-card.reveal,
  .bx-foundations-card.reveal {
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }
  .bx-archive-row.reveal {
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .bx-h1 {
      font-size: 56px;
    }
    :root[lang="ja"] .bx-h1 {
      font-size: 44px;
