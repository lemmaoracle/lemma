---
/**
 * Lemma blog — index page, compact v24 structure.
 *
 * After the v24 chrome migration (PR #282) the page still followed the
 * prior taxonomy with 9 stacked sections (Featured / Recent / Archive /
 * Changelog / Guides / Foundations / Filtered ...). This pass rebuilds
 * the index as a curated landing surface:
 *
 *   Hero → Filter pills → Featured (compact) → Recent → Changelog → Categories
 *
 * Guides and Foundations are removed from the index — they're being
 * routed to dedicated surfaces (Guides → cookbook / dedicated page TBD;
 * Foundations → separate spec page TBD). Their posts remain accessible
 * via their /blog/<slug>/ direct URLs.
 *
 * The dense "Archive" list (post-by-post) is replaced by a Categories
 * navigation strip — each chip links to /blog/category/<slug>/ with a
 * count badge, making the per-category archive pages first-class
 * destinations.
 *
 * Filter pills (in-page JS filter) are kept for the quick "Industry
 * only" UX; they serve a different action than the Categories nav
 * strip (in-page hide/show vs. navigate to deeper archive).
 *
 * "Essay" terminology is replaced site-wide with "Articles" / "記事"
 * per Mayumi review. CTA copy reduced to "Read →" / "読む →".
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { BLOG_CATEGORIES, categorySlug } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";

export interface BlogIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  /** All entries (essays + changelog) used to feed the filter pills + filtered grid. */
  entries: ReadonlyArray<BlogPost>;
  featured?: BlogPost;
  recent: ReadonlyArray<BlogPost>;
  changelog?: ReadonlyArray<BlogPost>;
}

const { locale, t, base, blogPath, entries, featured, recent, changelog = [] } =
  Astro.props as BlogIndexTemplateProps;

const isJa = locale === "ja";

// Category counts — both for filter pills and the categories nav strip.
// Includes the primary category plus any secondary_categories so a post
// with `secondary_categories: ["Announcements"]` is counted toward
// Announcements as well.
const categoryCounts: Record<string, number> = {};
for (const p of entries) {
  categoryCounts[p.category] = (categoryCounts[p.category] ?? 0) + 1;
  if (p.secondaryCategories) {
    for (const sc of p.secondaryCategories) {
      categoryCounts[sc] = (categoryCounts[sc] ?? 0) + 1;
    }
  }
}
const categories = BLOG_CATEGORIES.filter(
  (c) => (categoryCounts[c] ?? 0) > 0,
);

const readCta = isJa ? "読む →" : "Read →";
const categoriesLabel = isJa ? "カテゴリ" : "Categories";
---

<Layout
  locale={locale}
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  metaType="page"
  pagePath="/blog/"
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="bx-page">
    <div class="bx-container">
      <section class="bx-hero">
        <h1 class="bx-h1">{t.blog.title}</h1>
      </section>

      {categories.length > 0 && (
        <nav class="bx-filter" aria-label={t.blog.index.categoriesLabel}>
          <button class="bx-pill is-active" data-filter="all" type="button">
            {t.blog.index.allTag}
            <span class="bx-pill-count">{entries.length}</span>
          </button>
          {categories.map((c) => (
            <button class="bx-pill" data-filter={c} type="button">
              {c}
              <span class="bx-pill-count">{categoryCounts[c]}</span>
            </button>
          ))}
        </nav>
      )}

      <div class="bx-view-all">
        {featured && (
          <section class="bx-featured-section">
            <div class="bx-section-label">{t.blog.index.featuredTag}</div>
            <a
              href={`${blogPath}/${featured.slug}`}
              class="bx-featured-card reveal"
            >
              <div
                class="bx-featured-thumb"
                style={`background-image:url('${featured.cover ?? ""}')`}
              ></div>
              <div class="bx-featured-body">
                <div class="bx-essay-meta">
                  <span class="bx-essay-cat">{featured.category}</span>
                  <span class="bx-essay-sep">·</span>
                  <span class="bx-essay-date">{featured.date}</span>
                </div>
                <h2 class="bx-featured-title">{featured.title}</h2>
                <span class="bx-featured-cta">{t.blog.index.featuredCta}</span>
              </div>
            </a>
          </section>
        )}

        {recent.length > 0 && (
          <section class="bx-recent-section">
            <div class="bx-section-label">{t.blog.index.recentTag}</div>
            <div class="bx-card-grid">
              {recent.map((post, i) => (
                <a
                  href={`${blogPath}/${post.slug}`}
                  class="bx-card reveal"
                  style={`transition-delay:${i * 0.04}s`}
                >
                  <div class="bx-essay-meta">
                    <span class="bx-essay-cat">{post.category}</span>
                    <span class="bx-essay-sep">·</span>
                    <span class="bx-essay-date">{post.date}</span>
                  </div>
                  <h3 class="bx-card-title">{post.title}</h3>
                  <span class="bx-card-cta">{readCta}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {changelog.length > 0 && (
          <section class="bx-changelog-section">
            <div class="bx-section-label">
              {t.blog.sections["Changelog"] ?? "Changelog"}
            </div>
            <ul class="bx-archive-list">
              {changelog.map((post) => (
                <li class="bx-archive-row reveal">
                  <a
                    href={`${blogPath}/${post.slug}`}
                    class="bx-archive-link"
                  >
                    <span class="bx-archive-cat">{post.category}</span>
                    <span class="bx-archive-title">{post.title}</span>
                    <span class="bx-archive-date">{post.date}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {categories.length > 0 && (
          <section class="bx-categories-section">
            <div class="bx-section-label">{categoriesLabel}</div>
            <div class="bx-categories-grid">
              {categories.map((c) => (
                <a
                  href={`${blogPath}/category/${categorySlug(c)}`}
                  class="bx-category-chip"
                >
                  <span class="bx-category-label">{c}</span>
                  <span class="bx-category-count">{categoryCounts[c]}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <section class="bx-filtered-section" hidden>
        <div
          class="bx-section-label bx-filtered-label"
          data-filtered-label
        ></div>
        <div class="bx-card-grid bx-filtered-grid">
          {entries.map((post) => (
            <a
              href={`${blogPath}/${post.slug}`}
              class="bx-card bx-filtered-card"
              data-category={[post.category, ...(post.secondaryCategories ?? [])].join("|")}
            >
              <div class="bx-essay-meta">
                <span class="bx-essay-cat">{post.category}</span>
                <span class="bx-essay-sep">·</span>
                <span class="bx-essay-date">{post.date}</span>
              </div>
              <h3 class="bx-card-title">{post.title}</h3>
              <span class="bx-card-cta">{readCta}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .bx-page {
    --bx-display: "Sora", system-ui, sans-serif;
    --bx-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --bx-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --bx-text-1: #1a1a1a;
    --bx-text-2: #3a3a3a;
    --bx-text-3: #5a5a5a;
    --bx-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--bx-text-2);
    font-family: var(--bx-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .bx-page {
    --bx-body: "Sora", system-ui, sans-serif;
  }

  .bx-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .bx-hero {
    padding: 60px 0 48px;
  }
  .bx-eyebrow {
    font-family: var(--bx-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bx-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bx-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .bx-h1 {
    font-family: var(--bx-display);
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.04em;
    max-width: 920px;
  }
  :root[lang="ja"] .bx-h1 {
    font-size: 52px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  /* ─── FILTER BAR ─── */
  .bx-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 48px;
    padding: 22px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .bx-pill {
    font-family: var(--bx-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--bx-text-3);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.18s, border-color 0.18s, background 0.18s;
  }
  .bx-pill:hover {
    color: var(--accent);
    border-color: rgba(139, 69, 19, 0.4);
  }
  .bx-pill.is-active {
    color: var(--lemma-cream);
    background: var(--accent);
    border-color: var(--accent);
  }
  .bx-pill-count {
    font-family: var(--bx-mono);
    font-size: 10px;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* ─── SECTION LABEL ─── */
  .bx-section-label {
    font-family: var(--bx-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bx-section-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  /* ─── FEATURED (compact) ─── */
  .bx-featured-section {
    margin: 0 0 56px;
  }
  .bx-featured-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
  }
  .bx-featured-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    z-index: 1;
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bx-featured-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 16px 40px rgba(139, 69, 19, 0.08);
    transform: translateY(-2px);
  }
  .bx-featured-card:hover::before {
    width: 100%;
  }
  .bx-featured-thumb {
    background-size: cover;
    background-position: center;
    background-color: var(--lemma-cream-deep);
    min-height: 200px;
  }
  .bx-featured-body {
    padding: 30px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .bx-featured-title {
    font-family: var(--bx-display);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 700;
    line-height: 1.22;
    color: var(--black);
    letter-spacing: -0.02em;
    margin: 0;
  }
  :root[lang="ja"] .bx-featured-title {
    line-height: 1.4;
  }
  .bx-featured-cta {
    font-family: var(--bx-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: 4px;
    transition: transform 0.2s;
  }
  .bx-featured-card:hover .bx-featured-cta {
    transform: translateX(4px);
  }

  /* ─── ESSAY META (shared) ─── */
  .bx-essay-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--bx-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--bx-text-3);
  }
  .bx-essay-cat {
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bx-essay-sep {
    color: var(--lemma-line);
  }
  .bx-essay-date {
    font-variant-numeric: tabular-nums;
  }

  /* ─── RECENT / FILTERED — shared card grid ─── */
  .bx-recent-section,
  .bx-filtered-section {
    margin: 0 0 56px;
  }
  .bx-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .bx-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 22px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .bx-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bx-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .bx-card:hover::before {
    width: 100%;
  }
  .bx-card-title {
    font-family: var(--bx-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--black);
    letter-spacing: -0.015em;
    margin: 0;
  }
  :root[lang="ja"] .bx-card-title {
    line-height: 1.5;
  }
  .bx-card-cta {
    font-family: var(--bx-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 12px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .bx-card:hover .bx-card-cta {
    transform: translateX(3px);
  }

  /* ─── CHANGELOG (compact list) ─── */
  .bx-changelog-section {
    margin: 0 0 56px;
  }
  .bx-archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .bx-archive-row {
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .bx-archive-row:last-child {
    border-bottom: 0;
  }
  .bx-archive-link {
    display: grid;
    grid-template-columns: 160px 1fr 100px;
    gap: 20px;
    align-items: baseline;
    padding: 16px 22px;
    transition: background 0.18s;
  }
  .bx-archive-link:hover {
    background: var(--lemma-cream-deep);
  }
  .bx-archive-cat {
    font-family: var(--bx-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .bx-archive-title {
    font-family: var(--bx-display);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--black);
    letter-spacing: -0.005em;
  }
  .bx-archive-date {
    font-family: var(--bx-mono);
    font-size: 10.5px;
    color: var(--bx-text-3);
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* ─── CATEGORIES nav strip ─── */
  .bx-categories-section {
    margin: 0;
  }
  .bx-categories-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .bx-category-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    transition: border-color 0.2s, background 0.2s;
  }
  .bx-category-chip:hover {
    border-color: var(--accent);
    background: var(--lemma-brown-light);
  }
  .bx-category-label {
    font-family: var(--bx-display);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--bx-text-2);
    letter-spacing: -0.005em;
  }
  .bx-category-chip:hover .bx-category-label {
    color: var(--accent);
  }
  .bx-category-count {
    font-family: var(--bx-mono);
    font-size: 10.5px;
    color: var(--accent);
    font-weight: 500;
    padding: 2px 8px;
    background: var(--lemma-brown-light);
    border-radius: 999px;
  }

  /* ─── FILTERED VIEW ─── */
  .bx-view-all[hidden],
  .bx-filtered-section[hidden] {
    display: none;
  }
  .bx-filtered-card[hidden] {
    display: none;
  }
  .bx-filtered-label::before {
    background: var(--accent);
  }

  /* ─── REVEAL (faster than v22 0.6s — feels less laggy on long pages) ─── */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
  }
  .reveal.on {
    opacity: 1;
    transform: translateY(0);
  }
  .bx-featured-card.reveal,
  .bx-card.reveal {
    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }
  .bx-archive-row.reveal {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .bx-h1 {
      font-size: 52px;
    }
    :root[lang="ja"] .bx-h1 {
      font-size: 42px;
    }
    .bx-featured-card {
      grid-template-columns: 1fr;
    }
    .bx-featured-thumb {
      min-height: 180px;
    }
    .bx-featured-body {
      padding: 24px 28px 28px;
    }
    .bx-card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bx-archive-link {
      grid-template-columns: 140px 1fr 80px;
      gap: 14px;
    }
  }
  @media (max-width: 720px) {
    .bx-container {
      padding: 0 24px;
    }
    .bx-h1 {
      font-size: 40px;
    }
    :root[lang="ja"] .bx-h1 {
      font-size: 32px;
    }
    .bx-hero {
      padding: 40px 0 32px;
    }
    .bx-card-grid {
      grid-template-columns: 1fr;
    }
    .bx-archive-link {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 18px;
    }
    .bx-archive-date {
      text-align: left;
    }
  }
</style>

<script is:inline>
  var io = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add("on");
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
  );
  document.querySelectorAll(".reveal").forEach(function (el) {
    io.observe(el);
  });

  // ─── Category filter ───
  (function () {
    var pills = document.querySelectorAll(".bx-pill");
    if (!pills.length) return;
    var viewAll = document.querySelector(".bx-view-all");
    var filtered = document.querySelector(".bx-filtered-section");
    var label = document.querySelector("[data-filtered-label]");
    var cards = filtered ? filtered.querySelectorAll(".bx-filtered-card") : [];

    function apply(filter) {
      var isAll = !filter || filter.toLowerCase() === "all";
      pills.forEach(function (p) {
        var pf = (p.getAttribute("data-filter") || "").toLowerCase();
        p.classList.toggle(
          "is-active",
          isAll ? pf === "all" : pf === filter.toLowerCase(),
        );
      });
      if (viewAll) viewAll.hidden = !isAll;
      if (filtered) filtered.hidden = isAll;
      if (!isAll && label) {
        var labelText = filter;
        cards.forEach(function (c) {
          // data-category is "Primary|Secondary1|Secondary2" — match if the
          // filter equals the primary category or any secondary category.
          var raw = c.getAttribute("data-category") || "";
          var cats = raw.split("|");
          var match = cats.some(function (cat) {
            return cat.toLowerCase() === filter.toLowerCase();
          });
          c.hidden = !match;
          if (match) labelText = cats[0] || filter;
        });
        label.textContent = labelText;
      }
    }

    pills.forEach(function (p) {
      p.addEventListener("click", function () {
        var f = p.getAttribute("data-filter") || "all";
        apply(f);
        if (history.replaceState) {
          history.replaceState(
            null,
            "",
            f.toLowerCase() === "all"
              ? location.pathname + location.search
              : "#" + f.toLowerCase(),
          );
        }
      });
    });

    var initial = (location.hash || "").replace(/^#/, "").toLowerCase();
    if (initial) {
      pills.forEach(function (p) {
        if (
          (p.getAttribute("data-filter") || "").toLowerCase() === initial
        ) {
          apply(p.getAttribute("data-filter"));
        }
      });
    }
  })();
</script>
