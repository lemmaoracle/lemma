---
/**
 * Shared archive page template for both Pillar and Category views.
 *
 * Per the spec confirmation:
 *   - Pillar archives are generated for all 4 Pillars even when the
 *     Brief count is 0 (Pillar 02 / 04 today); empty state shows the
 *     "準備中 / Coming soon" placeholder rather than 404
 *   - Category archives are generated only for categories that have at
 *     least one Brief — Pillar archives carry the "all 4 layers exist"
 *     framework signal, Category archives are reactive
 *
 * Each Brief surfaces in a Category archive via either `primary_category`
 * (solid badge) or `secondary_categories` (outline badge). The route
 * passes the source label per Brief in `cards`.
 */

import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import BriefCard from "../components/BriefCard.astro";
import { getTranslations } from "../i18n/translations";

export interface ArchiveCard {
  readonly brief: CollectionEntry<"critical-briefs">;
  readonly source: "primary" | "secondary" | "general";
}

export interface BriefArchiveTemplateProps {
  locale: Locale;
  kind: "pillar" | "category";
  /** Slug used in URL — e.g. "01-verifiable-origin" or "bridge-config-trust". */
  slug: string;
  eyebrow: string;
  heading: string;
  description: string;
  cards: ReadonlyArray<ArchiveCard>;
}

const { locale, kind, slug, eyebrow, heading, description, cards } =
  Astro.props as BriefArchiveTemplateProps;

const t = getTranslations(locale);
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";

const pagePath = `/critical/briefs/${kind}/${slug}/`;
const pageTitle = isJa
  ? `${heading} — Lemma Critical Brief`
  : `${heading} — Lemma Critical Brief`;

const emptyState = isJa
  ? {
      heading: "Brief は準備中です",
      body: "本カテゴリに該当する Brief は現在編成中です。Brief シリーズの方針は Methodology ページを参照してください。",
      methodologyLabel: "Methodology を読む",
    }
  : {
      heading: "Briefs coming soon",
      body: "Briefs in this category are currently being compiled. See the Methodology page for the editorial framework.",
      methodologyLabel: "Read the Methodology",
    };

const methodologyHref = `${base}/critical/briefs/methodology/`;

const homeLabel = isJa ? "ホーム" : "Home";
const briefsLabel = isJa ? "Critical Brief" : "Critical Brief";
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  title={pageTitle}
  description={description}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <header class="archive-header">
    <div class="archive-header-inner">
      <div class="archive-breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="archive-breadcrumb-sep">/</span>
        <span>{briefsLabel}</span>
      </div>
      <div class="archive-eyebrow">{eyebrow}</div>
      <h1 class="archive-title">{heading}</h1>
      <p class="archive-description">{description}</p>
      {cards.length > 0 && (
        <p class="archive-count">
          {isJa
            ? `${cards.length} 件の Brief`
            : `${cards.length} Brief${cards.length === 1 ? "" : "s"}`}
        </p>
      )}
    </div>
  </header>

  <main class="archive-main">
    {cards.length === 0 ? (
      <section class="archive-empty">
        <h2 class="archive-empty-heading">{emptyState.heading}</h2>
        <p class="archive-empty-body">{emptyState.body}</p>
        <a class="archive-empty-cta" href={methodologyHref}>
          {emptyState.methodologyLabel} →
        </a>
      </section>
    ) : (
      <section class="archive-grid" aria-label={heading}>
        {cards.map((c) => (
          <BriefCard
            locale={locale}
            brief={c.brief}
            source={c.source}
            showPillarBadge={kind !== "pillar"}
          />
        ))}
      </section>
    )}
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* ─── HEADER ─── */
  .archive-header {
    margin-top: 64px;
    background: var(--black);
    color: var(--white);
    padding: 96px 10% 72px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .archive-header-inner {
    max-width: 920px;
    margin: 0 auto;
  }
  .archive-breadcrumb {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    letter-spacing: 0.06em;
    margin-bottom: 28px;
  }
  .archive-breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }
  .archive-breadcrumb a:hover {
    color: var(--accent);
  }
  .archive-breadcrumb-sep {
    margin: 0 8px;
    color: rgba(255, 255, 255, 0.25);
  }
  .archive-eyebrow {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .archive-eyebrow::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--accent);
    display: block;
  }
  .archive-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.4vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--white);
    margin: 0 0 20px;
  }
  :root[lang="ja"] .archive-title {
    line-height: 1.35;
  }
  .archive-description {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 28px;
    max-width: 640px;
  }
  .archive-count {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /* ─── MAIN ─── */
  .archive-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 72px 24px 120px;
  }

  /* ─── EMPTY STATE ─── */
  .archive-empty {
    max-width: 640px;
    margin: 24px auto 0;
    padding: 56px 32px;
    text-align: center;
    border: 1px solid var(--gray-200);
    background: var(--lemma-cream, #fcfaf5);
  }
  .archive-empty-heading {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 500;
    color: var(--black);
    margin: 0 0 18px;
  }
  :root[lang="ja"] .archive-empty-heading {
    line-height: 1.5;
  }
  .archive-empty-body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.8;
    color: var(--gray-700, #5f5f5f);
    margin: 0 0 24px;
  }
  .archive-empty-cta {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  /* ─── GRID ─── */
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (max-width: 720px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .archive-header {
      padding: 80px 6% 56px;
    }
    .archive-main {
      padding: 48px 6% 80px;
    }
    .archive-empty {
      padding: 40px 22px;
    }
  }
</style>
