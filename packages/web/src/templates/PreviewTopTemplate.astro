</style>

<script is:inline define:vars={{ API_BASE, VERIFY_PATH }}>
  (function () {
    var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var $ = function (id) {
      return document.getElementById(id);
    };
    var fmt = function (n) {
      return n.toLocaleString("en-US");
    };
    var MARK =
      '<span class="vmark" style="color:var(--ok)"><svg><use href="#pv-vmark"/></svg></span>';
    var shortHash = function (h) {
      return h ? h.slice(0, 10) + "…" + h.slice(-4) : "";
    };
    var getJson = function (path) {
      return fetch(API_BASE + path, { headers: { accept: "application/json" } }).then(function (r) {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    };

    /* ---- REGISTRY パネル。失敗時は推定で埋めない ---- */
    function countUp(el, to) {
      if (reduced) {
        el.textContent = fmt(to);
        return;
      }
      var t0 = performance.now(),
        dur = 1500,
        from = Math.max(0, to - Math.min(to, 600));
      (function f(t) {
        var p = Math.min(1, (t - t0) / dur),
          e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(Math.round(from + (to - from) * e));
        if (p < 1) requestAnimationFrame(f);
      })(t0);
    }
    function fmtTime(s) {
      if (!s) return "—";
      var d = new Date(s.indexOf("T") >= 0 ? s : s.replace(" ", "T") + "Z");
      return isNaN(d.getTime())
        ? "—"
        : d.toLocaleString("ja-JP", {
            month: "numeric",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          });
    }
    var lastV = null;
    function loadCounters(first) {
      return getJson("/counters")
        .then(function (j) {
          var verified = j.verified.bySource.reduce(function (a, b) {
            return a + b.count;
          }, 0);
          var issued = j.issued.byBucket.reduce(function (a, b) {
            return a + b.count;
          }, 0);
          if (first) countUp($("pv-vnum"), verified);
          else if (lastV !== verified) $("pv-vnum").textContent = fmt(verified);
          lastV = verified;
          $("pv-inum").textContent = fmt(issued);
          $("pv-pupd").textContent = fmtTime(j.verified.updatedAt);
          $("pv-perr").hidden = true;
          $("pv-phead").classList.remove("offline");
          $("pv-plive").textContent = "LIVE";
        })
        .catch(function () {
          /* 2回目以降の失敗は直前の実数を残す（推定ではないため）。初回のみ OFFLINE 表示。 */
          if (!first) return;
          $("pv-vnum").textContent = "—";
          $("pv-inum").textContent = "—";
          $("pv-pupd").textContent = "—";
          $("pv-perr").hidden = false;
          $("pv-phead").classList.add("offline");
          $("pv-plive").textContent = "OFFLINE";
        });
    }
    loadCounters(true);
    setInterval(function () {
      loadCounters(false);
    }, 45000);

    /* ---- イベント行（為替・祝日の docHash 短縮） ---- */
    var evs = [];
    function renderStream() {
      if (!evs.length) return;
      $("pv-pstream").innerHTML = evs
        .map(function (t) {
          return '<div class="ev">' + MARK + "<span>" + t + "</span></div>";
        })
        .join("");
      $("pv-pstream").hidden = false;
    }

    function liveErr(el) {
      el.classList.add("err");
      el.innerHTML =
        '<span class="dot"></span>フィードに到達できません — レスポンスを直接確認してください';
    }

    /* ---- フィード3行 ＋「証明サンプルを検証する」の遷移先 ---- */
    var fxP = getJson("/suites/feeds/forex/composite/latest");
    fxP
      .then(function (j) {
        if (j.docHash) {
          $("pv-herolink").href = VERIFY_PATH + "?doc=" + encodeURIComponent(j.docHash);
        }
        var a = j.attributes || {},
          v = j.verification || {};
        evs.push(
          "feeds/forex/composite&nbsp; " +
            (a.date || "") +
            " — " +
            (v.verified != null ? v.verified : "?") +
            "/" +
            (v.total != null ? v.total : "?") +
            " sources verified — " +
            shortHash(j.docHash),
        );
        renderStream();
        var jpy = a["rates.JPY"];
        $("pv-fxlive").innerHTML =
          '<span class="dot"></span>' +
          (jpy ? "USD/JPY <b>" + jpy.toFixed(3) + "</b>&nbsp;&nbsp;" : "") +
          (v.total
            ? '<span class="ok">' + v.verified + "/" + v.total + " verified</span>&nbsp;&nbsp;"
            : "") +
          (a.date || "");
      })
      .catch(function () {
        liveErr($("pv-fxlive"));
      });

    getJson("/suites/feeds/jp-holidays/latest")
      .then(function (j) {
        var v = j.verification || {};
        evs.push("feeds/jp-holidays&nbsp; proof issued — " + shortHash(j.docHash));
        renderStream();
        $("pv-hollive").innerHTML =
          '<span class="dot"></span>' +
          (v.total
            ? '<span class="ok">' + v.verified + "/" + v.total + " verified</span>&nbsp;&nbsp;"
            : "") +
          "proof <b>" +
          shortHash(j.docHash) +
          "</b>";
      })
      .catch(function () {
        liveErr($("pv-hollive"));
      });

    getJson("/suites/feeds/jp-postal-codes/latest")
      .then(function (j) {
        var a = j.attributes || {},
          v = j.verification || {};
        var n = a["meta.count"];
        $("pv-ziplive").innerHTML =
          '<span class="dot"></span>' +
          (n ? "<b>" + Number(n).toLocaleString("en-US") + "</b> records&nbsp;&nbsp;" : "") +
          (v.total
            ? '<span class="ok">' + v.verified + "/" + v.total + " verified</span>&nbsp;&nbsp;"
            : "") +
          "proof <b>" +
          shortHash(j.docHash) +
          "</b>";
      })
      .catch(function () {
        liveErr($("pv-ziplive"));
      });

    /* ---- フィールドスイープ（イメージ図） ---- */
    var fstage = $("pv-fieldstage"),
      sweep = $("pv-sweep");
    var FCOLS = 9,
      FROWS = 6,
      items = [];
    for (var r = 0; r < FROWS; r++) {
      for (var c = 0; c < FCOLS; c++) {
        var el = document.createElement("div");
        var real = Math.random() < 0.2;
        el.className = "fitem " + (real ? "real" : "fake");
        if (real)
          el.innerHTML =
            '<span class="fmark"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.4 6.3 L4.9 8.8 L9.6 3.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
        var x = 4 + c * (90 / (FCOLS - 1));
        el.style.left = x + "%";
        el.style.top = 6 + r * (78 / (FROWS - 1)) + "%";
        fstage.appendChild(el);
        items.push({ el: el, real: real, x: x });
      }
    }
    var sx = 0,
      scanned = 0,
      reals = 0;
    function step() {
      sx += 0.42;
      if (sx > 104) {
        sx = 0;
        scanned = 0;
        reals = 0;
        items.forEach(function (i) {
          i.el.classList.remove("checked");
        });
        $("pv-scancount").textContent = "0";
        $("pv-realcount").textContent = "0";
      }
      sweep.style.left = sx + "%";
      items.forEach(function (i) {
        if (!i.el.classList.contains("checked") && i.x < sx) {
          i.el.classList.add("checked");
          scanned++;
          if (i.real) {
            reals++;
            $("pv-realcount").textContent = String(reals);
          }
          $("pv-scancount").textContent = String(scanned);
        }
      });
    }
    if (!reduced) {
      setInterval(step, 40);
    } else {
      items.forEach(function (i) {
        i.el.classList.add("checked");
        if (i.real) reals++;
        scanned++;
      });
      $("pv-realcount").textContent = String(reals);
      $("pv-scancount").textContent = String(scanned);
      sweep.style.display = "none";
    }

    /* ---- GET 行の COPY ---- */
    document.querySelectorAll("[data-copy]").forEach(function (b) {
      b.addEventListener("click", function () {
        navigator.clipboard.writeText($(b.dataset.copy).textContent.trim()).then(function () {
          var o = b.textContent;
          b.textContent = "COPIED";
          setTimeout(function () {
            b.textContent = o;
          }, 1200);
        });
      });
    });
  })();
</script>
