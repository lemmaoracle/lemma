---
import type { Locale } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import LemmaOracle from "../components/LemmaOracle.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const base = locale === "ja" ? "/ja" : "";
const ja = locale === "ja";
const title = ja ? "証明を検証する" : "Verify a proof";
const description = ja ? "docHash から公開記録と証明を取得し、検証します。" : "Look up a public record and verify its proof using a docHash.";
---
<Layout locale={locale} title={title} description={description} metaType="page" pagePath="/verify/">
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;600&family=Noto+Sans+JP:wght@400;500;700&family=Inter:wght@200;300;400;500&family=Space+Mono&display=swap"
  />
  <div class="v9">
    <header class="v9-hd"><a href={`${base}/`} class="v9-logo" aria-label="Lemma"><LemmaOracle /></a></header>
  <main class="v9-main" data-live-verifier data-ja={String(ja)}><div class="v9-wrap">
    <p class="v9-kicker">LEMMA · LIVE VERIFICATION</p>
    <h1 class="v9-h2">{title}</h1>
    <p>{description} {ja ? "Cyber 以外の回路・スキーマの証明も照会できます。ファイル本文は入力しません。" : "Proofs from any circuit or schema can be looked up, including those outside Cyber. No file contents are entered."}</p>
    <form id="lookup">
      <label for="doc-hash">DOC HASH</label>
      <div class="input-row"><input id="doc-hash" name="doc" type="text" required pattern="0x[0-9a-fA-F]{64}" placeholder="0x…" autocomplete="off" spellcheck="false" aria-describedby="hash-help" /><button type="submit">{ja ? "検証する" : "Verify"}</button></div>
      <p id="hash-help">{ja ? "0x に続く64桁の16進文字列。発行元から受け取った docHash を貼り付けてください。" : "Paste the docHash provided by the issuer: 0x followed by 64 hexadecimal characters."}</p>
    </form>
    <noscript>{ja ? "検証には JavaScript が必要です。" : "JavaScript is required for live verification."}</noscript>
    <div id="live-result" aria-live="polite" aria-atomic="true"><p>?</p></div>
    <details>
      <summary>この証明の意味 / What this proves</summary>
      <p>✔ 記録が、発行された時点から改ざんされていないこと。<br />The record is unchanged since it was issued.</p>
      <p>✗ 書かれた内容の良し悪しや、判断の正しさそのもの。<br />Not the quality of the contents or the correctness of the judgment.</p>
      <p>{ja ? "上記は記録の完全性についての意味です。回路ごとの証明範囲は異なります。この画面ではローカル文書との一致、送信者の本人性、操作の承認は確認しません。" : "This describes record integrity. Each circuit has its own proof scope. This page does not compare a local document, establish the sender’s identity, or confirm authorization for an action."}</p>
    </details>
    <details>
      <summary>検証した対象・DOC HASH / Scope and hash</summary>
      <p>{ja ? "入力した docHash の登録状態と、それに紐づく最新の証明を照会します。証明と公開入力の検証は Lemma の公開 API が実行します。対応していない回路や取得できない証明は未確認として表示します。" : "We query the registration status and latest proof linked to the entered docHash. Lemma’s public API verifies the proof against its public inputs. Unsupported circuits and unavailable proofs remain unconfirmed."}</p>
      <p>{ja ? "docHash は登録を参照するコードです。文書の内容や、回路ごとの公開入力の意味を、このコードだけから推測しません。ローカルファイルとの照合には、その回路に対応したコミットメント計算が別途必要です。" : "A docHash identifies a registration. It does not by itself reveal document contents or the meaning of a circuit’s public inputs. Comparing a local file requires the commitment calculation appropriate to that circuit."}</p>
    </details>
    <details>
      <summary>ローカルで検証するには / Verify locally</summary>
      <p>{ja ? "手元で実行する API スニペットです。暗号検証はリモート API が行います。完全なオフライン検証には、その回路の検証鍵と対応する検証器が必要です。" : "Run this API snippet on your machine. Cryptographic verification runs on the remote API. Fully offline verification requires the circuit’s verification key and compatible verifier."}</p>
      <pre><code id="verify-code"></code></pre>
    </details>
    <p><a href={`${base}/cyber/`}>{ja ? "Cyber Proof Cards もここで検証できます" : "Cyber Proof Cards also verify here"}</a></p>
  </div></main>
    <footer class="v9-ft"><span>© FRAME00, Inc.</span><a href={`${base}/terms/`}>{ja ? "利用規約" : "Terms"}</a><a href={`${base}/privacy/`}>{ja ? "プライバシー" : "Privacy"}</a></footer>
  </div>
</Layout>
<script>
  // Preserve the original single-record view and all query parameters on legacy deep links.
  const legacyUrl = new URL(window.location.href);
  legacyUrl.searchParams.has("doc") && window.location.replace(`${legacyUrl.pathname.replace(/\/$/, "")}/counters/${legacyUrl.search}${legacyUrl.hash}`);
  const root = document.querySelector<HTMLElement>("[data-live-verifier]")!;
  const ja = root.dataset.ja === "true";
  const text = (jp: string, en: string) => ja ? jp : en;
  const api = "https://workers.lemma.workers.dev/v1";
  const form = document.querySelector<HTMLFormElement>("#lookup")!;
  const input = document.querySelector<HTMLInputElement>("#doc-hash")!;
  const button = form.querySelector("button")!;
  const result = document.querySelector<HTMLElement>("#live-result")!;
  const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const short = (value: string) => value.length > 24 ? `${value.slice(0, 12)}…${value.slice(-8)}` : value;
  const string = (value: unknown) => typeof value === "string" ? value : "";
  const record = (value: unknown): Readonly<Record<string, unknown>> => value !== null && typeof value === "object" && !Array.isArray(value) ? value as Readonly<Record<string, unknown>> : {};
  const mappedIssuer = (doc: Readonly<Record<string, unknown>>) => {
    const schema = string(doc.schemaId);
    const issuer = string(doc.issuerId);
    const feeds: Readonly<Record<string, string>> = {
      "forex/composite": text("為替データフィード", "FX data feed"),
      "forex/er-api": text("為替データフィード", "FX data feed"),
      "forex/frankfurter": text("為替データフィード", "FX data feed"),
      "jp-holidays": text("祝日データフィード", "JP holidays feed"),
      "jp-postal-codes": text("郵便番号データフィード", "JP postal codes feed"),
    };
    const feedId = issuer.endsWith("-pipeline") ? issuer.slice(0, -9) : "";
    return ["clubs.nippo.v1", "clubs.seal-issuance.v1"].includes(schema) ? "CLUBS" : Object.prototype.hasOwnProperty.call(feeds, feedId) ? feeds[feedId] : "";
  };
  const jst = (value: unknown) => {
    const date = new Date(string(value));
    return Number.isNaN(date.getTime()) ? "" : `${date.toLocaleString(ja ? "ja-JP" : "en-GB", { timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false })} JST`;
  };
  const request = async (url: string, init: RequestInit = {}) => fetch(url, { ...init, signal: AbortSignal.timeout(20000), headers: { accept: "application/json", ...init.headers } }).then(async response => ({ status: response.status, ok: response.ok, data: response.ok ? record(await response.json()) : {} })).catch(() => ({ status: 0, ok: false, data: {} as Readonly<Record<string, unknown>> }));
  const row = (label: string, value: string) => value ? `<div><dt>${esc(label)}</dt><dd>${esc(value)}</dd></div>` : "";
  const check = (label: string, state: string) => `<li><strong>${esc(label)}</strong><span>${esc(state)}</span></li>`;
  const snippet = (hash: string) => `const api = "${api}";
const docHash = ${JSON.stringify(hash || "PASTE_DOC_HASH")};
const response = await fetch(api + "/proofs?docHash=" + encodeURIComponent(docHash));
if (!response.ok) throw new Error("Proof lookup unavailable");
const { circuitId, proof, inputs } = await response.json();
const verification = await fetch(api + "/proofs/verify", {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ circuitId, proof, publicSignals: inputs })
});
if (!verification.ok) throw new Error("Verification unavailable");
console.log(await verification.json());`;
  document.querySelector("#verify-code")!.textContent = snippet("");
  const run = async () => {
    const hash = input.value.trim();
    input.value = hash;
    return /^0x[0-9a-fA-F]{64}$/.test(hash) ? execute(hash) : form.reportValidity();
  };
  const execute = async (hash: string) => {
    button.disabled = true;
    input.disabled = true;
    result.setAttribute("aria-busy", "true");
    result.innerHTML = `<p>? ${text("照合中…", "Checking…")}</p>`;
    const url = new URL(window.location.href);
    url.searchParams.set("doc", hash);
    window.history.replaceState(null, "", url);
    document.querySelector("#verify-code")!.textContent = snippet(hash);
    const docUrl = `${api}/documents/${encodeURIComponent(hash)}`;
    const proofUrl = `${api}/proofs?docHash=${encodeURIComponent(hash)}`;
    const docResponse = await request(docUrl);
    const proofResponse = await request(proofUrl);
    const doc = docResponse.data;
    const proof = proofResponse.data;
    const linked = proofResponse.ok && string(proof.docHash).toLowerCase() === hash.toLowerCase();
    const usable = linked && !!string(proof.circuitId) && proof.proof != null && Array.isArray(proof.inputs);
    const verification = usable ? await request(`${api}/proofs/verify`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ circuitId: proof.circuitId, proof: proof.proof, publicSignals: proof.inputs }) }) : null;
    const docValid = docResponse.ok && string(doc.docHash).toLowerCase() === hash.toLowerCase() && ["registered", "anchored", "pending", "not_found"].includes(string(doc.status));
    const offline = (!docValid && docResponse.status !== 404) || (!proofResponse.ok && proofResponse.status !== 404) || (proofResponse.ok && !usable) || (verification !== null && (!verification.ok || typeof verification.data.valid !== "boolean"));
    const invalid = verification?.ok && verification.data.valid === false;
    const missing = docResponse.status === 404 || (docValid && doc.status === "not_found");
    const registered = docValid && ["registered", "anchored"].includes(string(doc.status));
    const band = offline ? ["neutral", text("照合できませんでした / OFFLINE", "Unable to check / OFFLINE")] : invalid ? ["bad", text("証明の検証失敗", "Proof verification failed")] : missing ? ["bad", text("記録が見つかりません", "Record not found")] : registered && verification?.ok && verification.data.valid === true ? ["good", text("証明の検証成功", "Proof verified")] : registered ? ["neutral", text("登録済み・証明は未確認", "Registered · proof unconfirmed")] : ["neutral", text("オンチェーン記録待ち", "On-chain record pending")];
    const proofState = verification?.ok && verification.data.valid === true ? text("✓ 検証成功", "✓ Verified") : invalid ? text("✗ 検証失敗", "✗ Failed") : text("? 未確認", "? Unconfirmed");
    result.innerHTML = `<section class="result-panel"><div class="band ${band[0]}"><h2>${esc(band[1])}</h2><p>${text("登録状態と証明の検証結果は、以下で個別に表示します。ローカル文書との一致は未確認です。", "Registration and proof verification are reported separately below. A local document has not been compared.")}</p></div>
      <dl>${row(text("発行者（登録上のラベル）", "Issuer (registry label)"), docValid ? mappedIssuer(doc) : "")}${row(text("記録日時", "Recorded at"), docValid ? jst(doc.registeredAt) : "")}${row(text("対象の日付", "Record date"), docValid ? string(doc.date) : "")}${row("DOC HASH", short(hash))}${row("circuitId", linked ? string(proof.circuitId) : "")}${row("verifyId", verification?.ok ? short(string(verification.data.verifyId)) : "")}</dl>
      <button id="copy-hash" type="button">${text("docHash をコピー", "Copy docHash")}</button>
      <h3>${text("確認したこと", "Checks performed")}</h3><ul class="checks">${check(text("文書の登録", "Document registration"), docValid ? string(doc.status) : missing ? "not_found" : "? OFFLINE")}${check(text("紐づく証明", "Linked proof"), linked ? text("✓ 取得済み", "✓ Retrieved") : proofResponse.status === 404 ? text("? 未登録", "? No proof registered") : "? OFFLINE")}${check(text("証明と公開入力", "Proof and public inputs"), proofState)}</ul>
      <aside><h3>${text("次の行動", "Next action")}</h3><p>${offline ? text("通信状態を確認して再試行し、生レスポンスを確認してください。", "Check your connection, retry, and inspect the raw responses.") : missing || invalid ? text("発行元に docHash と証明の確認を依頼してください。", "Ask the issuer to confirm the docHash and proof.") : text("利用する回路の証明範囲を確認してください。未確認の項目は発行元に確認し、文書本文・本人性・操作の承認は別途照合してください。", "Review the circuit’s proof scope. Ask the issuer about unconfirmed checks, and separately check document contents, identity, and authorization.")}</p></aside>
      <p><a href="${docUrl}" target="_blank" rel="noopener">${text("登録の生レスポンス", "Raw document response")}</a> · <a href="${proofUrl}" target="_blank" rel="noopener">${text("証明の生レスポンス", "Raw proof response")}</a></p></section>`;
    result.querySelector("#copy-hash")!.addEventListener("click", event => Promise.resolve().then(() => navigator.clipboard.writeText(hash)).then(() => { (event.target as HTMLElement).textContent = text("コピーしました", "Copied"); }).catch(() => { (event.target as HTMLElement).textContent = text("コピーできませんでした", "Copy unavailable"); }));
    result.setAttribute("aria-busy", "false");
    button.disabled = false;
    input.disabled = false;
  };
  form.addEventListener("submit", event => { event.preventDefault(); void run(); });
  const initial = new URLSearchParams(window.location.search).get("doc");
  initial !== null && (input.value = initial);
  // Incoming ?doc= links are handled by the legacy redirect above.
</script>
<style is:global>
  .v9 {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ok-light: #4e7a00;
    --err: #c25438;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --dline: #e7eae5;
    --font-serif-jp: "Noto Serif JP", Georgia, serif;
    --font-body: "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-num: "Inter", "Noto Sans JP", sans-serif;
    --font-mono: "Space Mono", monospace;
    background: var(--lite);
    color: var(--tx);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .v9 *,
  .v9 *::before,
  .v9 *::after {
    box-sizing: border-box;
  }

  /* header：ロゴのみ */
  .v9-hd {
    padding: 18px 6vw;
    border-bottom: 1px solid rgba(15, 20, 18, 0.08);
  }
  .v9-logo {
    display: inline-flex;
    align-items: center;
    color: var(--tx);
  }
  .v9-logo svg {
    height: 30px;
    width: auto;
    display: block;
  }

  .v9-main {
    flex: 1;
    padding: 52px 6vw 24px;
  }
  .v9-wrap {
    max-width: 620px;
    margin: 0 auto;
  }
  .v9-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .v9-h2 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--tx);
    margin: 0 0 10px;
  }
  .v9-lede {
    font-size: 13.5px;
    line-height: 2;
    color: var(--tx-soft);
    margin: 0 0 30px;
  }

  .v9-ft {
    padding: 32px 6vw 44px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .v9-ft a {
    color: var(--ok-light);
    text-decoration: none;
  }
  .v9-ft a:hover {
    text-decoration: underline;
  }


  .v9 [data-live-verifier] { line-height: 1.8; overflow-wrap: anywhere; }
  .v9 h2, .v9 h3 { font-family: var(--font-serif-jp); line-height: 1.5; }
  .v9 form, .v9 details { margin: 24px 0; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
  .v9 label { display: block; font-family: var(--font-mono); font-size: 12px; }
  .v9 .input-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .v9 input { flex: 1; min-width: 0; width: 100%; padding: 12px; border: 1px solid var(--line); border-radius: 5px; font-family: var(--font-mono); }
  .v9 button { padding: 10px 18px; border: 1px solid var(--line); border-radius: 5px; background: var(--lite-2); color: var(--tx); cursor: pointer; }
  .v9 button:disabled { opacity: .6; cursor: wait; }
  .v9 #hash-help { font-size: 12px; color: var(--muted); }
  .v9 .result-panel { margin: 24px 0; padding: 24px; border-radius: 14px; background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%); color: #ebefe6; }
  .v9 .band { border-top: 2px solid #9ba296; padding-top: 18px; }
  .v9 .band.good { border-color: var(--ok); }
  .v9 .band.good h2 { color: var(--ok); }
  .v9 .band.bad { border-color: var(--err); }
  .v9 .band.bad h2 { color: #e0906f; }
  .v9 .band h2 { margin-top: 0; }
  .v9 dl > div { display: grid; grid-template-columns: minmax(120px, 1fr) 2fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid #4a544b; }
  .v9 dt { color: #9ba296; font-size: 12px; }
  .v9 dd { margin: 0; font-family: var(--font-mono); font-size: 12px; }
  .v9 .checks { list-style: none; padding: 0; }
  .v9 .checks li { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 12px 0; border-bottom: 1px solid #4a544b; }
  .v9 aside { border-top: 1px solid #4a544b; font-size: 13px; }
  .v9 a { color: var(--tx-soft); }
  .v9 .result-panel a { color: #d8ddd1; }
  .v9 summary { cursor: pointer; font-weight: 500; }
  .v9 pre { background: var(--lite-2); padding: 16px; overflow-x: auto; font-family: var(--font-mono); font-size: 11px; }
  .v9 :focus-visible { outline: 2px solid var(--muted); outline-offset: 4px; }
  @media (max-width: 540px) { .v9 dl > div { grid-template-columns: 1fr; gap: 0; } }
</style>
