---
/**
 * Use Case detail — v24 chrome.
 *
 * Long-form template matching the Brief v24 vocabulary (cream page, Sora
 * display + Noto body + Space Mono labels, saddle brown accent) while
 * retaining the two-column layout (sticky sidebar TOC + main content) that
 * the use case surface needs.
 *
 * Page composition:
 *   1. Breadcrumb (mono uppercase)
 *   2. Hero: eyebrow + h1 + thesis + abstract + meta strip
 *   3. Layout: sticky sidebar (sections nav) + main content
 *   4. Each section: rendered HTML body (markdown -> HTML)
 *   5. DemoCtaBanner (when configured for the slug)
 *   6. Inline v24 partner CTA card replacing the v22 black band
 */
import type { Locale, Translations } from "../i18n/translations";
import type { UseCase } from "../data/useCases";
import type { Pillar, CTA } from "../data/pillars";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import DemoCtaBanner from "../components/DemoCtaBanner.astro";
import { DISCOVERY_CALL, DISCOVERY_CALL_URL } from "../config/cta";
import { getDemoSampleForUseCase, getUseCasePairSample } from "../config/demoSamples";

const resolveCTA = (cta: CTA, lc: Locale): { readonly label: string; readonly href: string } =>
  cta.type === "talk-to-us"
    ? { label: DISCOVERY_CALL[lc].buttonLabel, href: DISCOVERY_CALL_URL[lc] }
    : { label: cta.label, href: cta.href };

export interface UseCaseDetailTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  useCase: UseCase;
  pillar: Pillar;
  pillarT: Translations["pillars"];
  useCaseT: Translations["useCases"];
  /** Resolved related use cases (from useCase.relatedUseCases slug list).
   * When non-empty, the "related" section's markdown body is replaced
   * with a card grid built from this data. */
  relatedUseCases?: ReadonlyArray<UseCase>;
}

const { locale, t, base, useCase, pillar, pillarT, useCaseT, relatedUseCases = [] } =
  Astro.props as UseCaseDetailTemplateProps;
const useCasesPath = `${base}/use-cases`;
const pillarsPath = `${base}/pillars`;
const demoSampleId = getDemoSampleForUseCase(useCase.slug);
const demoPairSampleId = getUseCasePairSample(useCase.slug);

const homeLabel = locale === "ja" ? "ホーム" : "Home";
const minLabel = locale === "ja" ? "分" : "min read";

const SITE = "https://lemma.frame00.com";
const useCaseUrl = `${SITE}${useCasesPath}/${useCase.slug}/`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: useCase.title,
  description: useCase.abstract,
  url: useCaseUrl,
  inLanguage: locale,
  author: { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Lemma Oracle" },
  publisher: { "@id": `${SITE}/#organization` },
  mainEntityOfPage: { "@type": "WebPage", "@id": useCaseUrl },
  about: pillar ? { "@type": "Thing", name: pillar.title[locale] } : undefined,
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma Oracle", item: `${SITE}${base || ""}/` },
    { "@type": "ListItem", position: 2, name: useCaseT.title, item: `${SITE}${useCasesPath}/` },
    { "@type": "ListItem", position: 3, name: useCase.title, item: useCaseUrl },
  ],
};
---

<Layout
  locale={locale}
  title={`${useCase.title} — ${useCaseT.title} | Lemma`}
  description={useCase.abstract}
  metaType="page"
  pagePath={`/use-cases/${useCase.slug}/`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="ucd-page">
    <div class="ucd-container">
      <nav class="ucd-breadcrumb" aria-label="breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="ucd-breadcrumb-sep">/</span>
        <a href={useCasesPath}>{useCaseT.title}</a>
        <span class="ucd-breadcrumb-sep">/</span>
        <span>{useCase.title}</span>
      </nav>

      <header class="ucd-hero">
        <a href={`${pillarsPath}/${pillar.slug}`} class="ucd-eyebrow">
          P{pillar.order} · {pillar.title[locale]}
        </a>
        <h1 class="ucd-h1">{useCase.title}</h1>
        {useCase.thesis && (
          <p class="ucd-thesis">{useCase.thesis}</p>
        )}
        <p class="ucd-abstract">{useCase.abstract}</p>
        <div class="ucd-meta">
          {useCase.targetVerticals.length > 0 && (
            <span class="ucd-verticals">{useCase.targetVerticals.join(" · ")}</span>
          )}
          <span class="ucd-reading-time">
            {useCase.readingTime} {minLabel}
          </span>
        </div>
      </header>

      <!-- Section index card — visual TOC under the hero. Complements the
           sticky sidebar (which is desktop-only) and gives the page a
           designed anchor surface before the long-form sections begin. -->
      <section class="ucd-toc-card" aria-label={useCaseT.sections}>
        <div class="ucd-toc-label">{useCaseT.sections}</div>
        <ol class="ucd-toc-grid">
          {useCase.sections.map((section, i) => (
            <li class="ucd-toc-item">
              <a href={`#${section.key}`} class="ucd-toc-link">
                <span class="ucd-toc-num">§ {String(i + 1).padStart(2, "0")}</span>
                <span class="ucd-toc-title">{section.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <div class="ucd-layout">
        <nav class="ucd-sidebar" aria-label="Use case sections">
          <div class="ucd-sidebar-label">{useCaseT.sections}</div>
          <ul class="ucd-sidebar-nav">
            {useCase.sections.map((section) => (
              <li>
                <a href={`#${section.key}`} class="ucd-sidebar-link">{section.title}</a>
              </li>
            ))}
          </ul>
        </nav>

        <article class="ucd-main">
          {useCase.sections.map((section) => {
            // For the "related" section: when we have resolved related use
            // cases, render a card grid using the frontmatter slug data and
            // suppress the markdown body. Falls back to the body if the slug
            // list is empty so the page never goes blank.
            const isRelatedCards =
              section.key === "related" && relatedUseCases.length > 0;
            return (
              <section id={section.key} class={`ucd-section${isRelatedCards ? " ucd-section--related" : ""}`}>
                <h2 class="ucd-section-title">{section.title}</h2>
                {isRelatedCards ? (
                  <ul class="ucd-related-grid">
                    {relatedUseCases.map((r) => (
                      <li class="ucd-related-item">
                        <a href={`${useCasesPath}/${r.slug}`} class="ucd-related-card">
                          {r.thesis && (
                            <div class="ucd-related-thesis">{r.thesis}</div>
                          )}
                          <h3 class="ucd-related-title">{r.title}</h3>
                          <p class="ucd-related-abstract">{r.abstract}</p>
                          <span class="ucd-related-cta">
                            {pillarT.viewUseCase ?? useCaseT.title} →
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <div class="ucd-section-body" set:html={section.body} />
                )}
              </section>
            );
          })}

          {demoSampleId && (
            <DemoCtaBanner
              locale={locale}
              t={t.demoCta}
              sampleId={demoSampleId}
              source="use-cases"
              pairSampleId={demoPairSampleId ?? undefined}
            />
          )}

          <section class="ucd-partner" aria-label={pillar.ctaCopy?.eyebrow[locale] ?? pillarT.ctaEyebrow}>
            <div class="ucd-partner-eyebrow">{pillar.ctaCopy?.eyebrow[locale] ?? pillarT.ctaEyebrow}</div>
            <h2 class="ucd-partner-h2">{pillar.ctaCopy?.title[locale] ?? pillarT.ctaTitle}</h2>
            <p class="ucd-partner-body">{pillar.ctaCopy?.desc[locale] ?? pillarT.ctaDesc}</p>
            {(() => {
              const primary = resolveCTA(pillar.primaryCTA, locale);
              const secondary = pillar.secondaryCTA ? resolveCTA(pillar.secondaryCTA, locale) : undefined;
              return (
                <div class="ucd-partner-cta">
                  <a
                    href={primary.href}
                    class="ucd-partner-primary"
                    target={primary.href.startsWith("http") ? "_blank" : undefined}
                    rel={primary.href.startsWith("http") ? "noopener" : undefined}
                  >
                    {primary.label}
                  </a>
                  {secondary && (
                    <a
                      href={secondary.href}
                      class="ucd-partner-secondary"
                      target={secondary.href.startsWith("http") ? "_blank" : undefined}
                      rel={secondary.href.startsWith("http") ? "noopener" : undefined}
                    >
                      {secondary.label}
                    </a>
                  )}
                </div>
              );
            })()}
          </section>
        </article>
      </div>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />

  <script is:inline>
    (function () {
      var links = document.querySelectorAll(".ucd-sidebar-link");
      var sections = Array.from(document.querySelectorAll(".ucd-section"));
      if (!links.length || !sections.length) return;
      var bySection = new Map();
      links.forEach(function (link) {
        var id = (link.getAttribute("href") || "").slice(1);
        if (id) bySection.set(id, link);
      });
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var link = bySection.get(entry.target.id);
            if (!link) return;
            links.forEach(function (l) { l.classList.remove("is-active"); });
            link.classList.add("is-active");
          });
        },
        { rootMargin: "-30% 0px -60% 0px", threshold: 0 }
      );
      sections.forEach(function (s) { io.observe(s); });
    })();
  </script>
</Layout>

<style>
  .ucd-page {
    /* Sora carries Latin; Noto Sans JP backs JA characters so they don't
       cascade into the Layout-level Cormorant / Noto Serif JP stack. */
    --ucd-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --ucd-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --ucd-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ucd-text-1: #1a1a1a;
    --ucd-text-2: #3a3a3a;
    --ucd-text-3: #5a5a5a;
    --ucd-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--ucd-text-2);
    font-family: var(--ucd-body);
    font-weight: 400;
    line-height: 1.75;
    padding: 0 0 24px;
    margin-top: 64px;
  }
  :root[lang="en"] .ucd-page {
    --ucd-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  .ucd-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── BREADCRUMB ─── */
  .ucd-breadcrumb {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ucd-text-4);
    padding: 36px 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .ucd-breadcrumb a {
    color: var(--ucd-text-3);
    transition: color 0.15s;
  }
  .ucd-breadcrumb a:hover {
    color: var(--accent);
  }
  .ucd-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .ucd-hero {
    padding: 36px 0 48px;
    max-width: 820px;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .ucd-eyebrow {
    font-family: var(--ucd-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 20px;
    transition: color 0.15s;
  }
  .ucd-eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--accent);
  }
  .ucd-eyebrow:hover {
    color: #6e3610;
  }
  .ucd-h1 {
    font-family: var(--ucd-display);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 18px;
  }
  :root[lang="ja"] .ucd-h1 {
    line-height: 1.25;
  }
  /* Thesis: bold mono-styled accent block, set off by a brown left rule.
     Italics removed — faked italics on JA glyphs read as serif-y noise. */
  .ucd-thesis {
    font-family: var(--ucd-display);
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 600;
    color: var(--accent);
    line-height: 1.5;
    margin: 0 0 22px;
    max-width: 720px;
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--accent);
  }
  .ucd-abstract {
    font-size: 15.5px;
    color: var(--ucd-text-2);
    line-height: 1.8;
    margin: 0 0 24px;
    max-width: 720px;
  }
  .ucd-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ucd-text-4);
  }
  .ucd-verticals {
    color: var(--ucd-text-3);
  }
  .ucd-reading-time::before {
    content: "·";
    margin-right: 12px;
    color: var(--lemma-line);
  }
  .ucd-meta > :first-child::before {
    content: none;
  }

  /* ─── TOC CARD (visual section index under hero) ─── */
  .ucd-toc-card {
    background: var(--lemma-cream-deep);
    border-radius: 14px;
    padding: 32px 32px 26px;
    margin: 40px 0 16px;
    position: relative;
    overflow: hidden;
  }
  .ucd-toc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .ucd-toc-label {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }
  .ucd-toc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 32px;
    row-gap: 0;
  }
  .ucd-toc-item {
    padding: 0;
    margin: 0;
  }
  .ucd-toc-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.18);
    transition: color 0.15s, border-color 0.15s;
  }
  .ucd-toc-link:hover {
    border-bottom-color: var(--accent);
  }
  .ucd-toc-num {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent);
    flex-shrink: 0;
    min-width: 36px;
  }
  .ucd-toc-title {
    font-family: var(--ucd-body);
    font-size: 13.5px;
    color: var(--ucd-text-2);
    line-height: 1.5;
    transition: color 0.15s;
  }
  .ucd-toc-link:hover .ucd-toc-title {
    color: var(--accent);
  }

  /* ─── LAYOUT ─── */
  .ucd-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 60px;
    padding: 56px 0 0;
  }

  /* ─── SIDEBAR ─── */
  .ucd-sidebar {
    position: sticky;
    top: 96px;
    height: fit-content;
    align-self: start;
  }
  .ucd-sidebar-label {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ucd-text-4);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ucd-sidebar-label::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--accent);
    display: block;
  }
  .ucd-sidebar-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ucd-sidebar-link {
    display: block;
    padding: 8px 12px;
    font-family: var(--ucd-body);
    font-size: 13px;
    color: var(--ucd-text-3);
    border-left: 1.5px solid transparent;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .ucd-sidebar-link:hover {
    color: var(--black);
    border-left-color: var(--accent);
    background: var(--lemma-cream-deep);
  }
  .ucd-sidebar-link.is-active {
    color: var(--accent);
    font-weight: 500;
    border-left-color: var(--accent);
    background: var(--lemma-cream-deep);
  }

  /* ─── MAIN ─── */
  .ucd-main {
    min-width: 0;
    counter-reset: ucdsec;
  }
  /* Each section increments a CSS counter that surfaces as a "§ N" mono
     brown eyebrow above its title. The eyebrow itself becomes the visual
     section break, so the bottom rule is dropped — long use case pages
     now read as a numbered cadence instead of stacked dividers. */
  .ucd-section {
    counter-increment: ucdsec;
    padding: 0 0 64px;
    margin: 0 0 64px;
  }
  .ucd-section:last-of-type {
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .ucd-section-title {
    font-family: var(--ucd-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 24px;
  }
  .ucd-section-title::before {
    content: "§ " counter(ucdsec);
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--ucd-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }
  :root[lang="ja"] .ucd-section-title {
    line-height: 1.35;
  }

  /* ─── BODY (markdown HTML) ─── */
  .ucd-section-body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--ucd-text-2);
  }
  .ucd-section-body :global(p) {
    margin: 0 0 18px;
  }
  .ucd-section-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .ucd-section-body :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  /* Em is repurposed as a "key term" accent — saddle brown, weight 500,
     not italic. Faked italics on JA glyphs read poorly. */
  .ucd-section-body :global(em) {
    font-style: normal;
    color: var(--accent);
    font-weight: 500;
  }
  /* Lead paragraph — first paragraph in each section gets a slightly
     larger size and a brown left rule, anchoring the section visually
     without changing the markdown. */
  .ucd-section-body :global(> p:first-child) {
    font-size: 16px;
    line-height: 1.9;
    color: var(--ucd-text-1);
    padding: 2px 0 2px 16px;
    border-left: 2px solid var(--accent);
    margin: 0 0 28px;
  }
  /* Blockquote — cream-deep card with brown left rule. Markdown
     blockquotes become surfaced callouts instead of plain indented text. */
  .ucd-section-body :global(blockquote) {
    margin: 24px 0;
    padding: 20px 24px;
    background: var(--lemma-cream-deep);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ucd-text-1);
  }
  .ucd-section-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .ucd-section-body :global(a) {
    color: var(--accent);
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
    overflow-wrap: anywhere;
  }
  .ucd-section-body :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }
  .ucd-section-body :global(h2) {
    font-family: var(--ucd-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--black);
    margin: 40px 0 14px;
    line-height: 1.35;
  }
  .ucd-section-body :global(h3) {
    font-family: var(--ucd-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
    margin: 32px 0 12px;
    line-height: 1.35;
  }
  .ucd-section-body :global(ul) {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .ucd-section-body :global(ul li) {
    position: relative;
    padding-left: 22px;
    margin: 0 0 10px;
    line-height: 1.7;
  }
  .ucd-section-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }
  .ucd-section-body :global(ol) {
    margin: 0 0 18px;
    padding: 0 0 0 4px;
    counter-reset: ucdlist;
    list-style: none;
  }
  .ucd-section-body :global(ol li) {
    counter-increment: ucdlist;
    position: relative;
    padding-left: 32px;
    margin: 0 0 14px;
    line-height: 1.7;
  }
  .ucd-section-body :global(ol li::before) {
    content: counter(ucdlist);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--ucd-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
  }
  .ucd-section-body :global(hr) {
    border: none;
    border-top: 0.5px solid var(--lemma-line);
