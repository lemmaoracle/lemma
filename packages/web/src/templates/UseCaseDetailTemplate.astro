---
/**
 * Use Case detail — v24 chrome.
 *
 * Long-form template matching the Brief v24 vocabulary (cream page, Sora
 * display + Noto body + Space Mono labels, saddle brown accent) while
 * retaining the two-column layout (sticky sidebar TOC + main content) that
 * the use case surface needs.
 *
 * Page composition:
 *   1. Breadcrumb (mono uppercase)
 *   2. Hero: eyebrow + h1 + thesis + abstract + meta strip
 *   3. Layout: sticky sidebar (sections nav) + main content
 *   4. Each section: rendered HTML body (markdown -> HTML)
 *   5. DemoCtaBanner (when configured for the slug)
 *   6. Inline v24 partner CTA card replacing the v22 black band
 */
import type { Locale, Translations } from "../i18n/translations";
import type { UseCase } from "../data/useCases";
import type { Pillar, CTA } from "../data/pillars";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import DemoCtaBanner from "../components/DemoCtaBanner.astro";
import UseCaseExitCta from "../components/UseCaseExitCta.astro";
import SolutionsBridge from "../components/SolutionsBridge.astro";
import UseCaseV3Body from "../components/usecase/UseCaseV3Body.astro";
import { getUseCaseHideProve } from "../config/useCaseHideProve";
import { getUseCaseV3 } from "../config/useCaseV3";
import { getUseCaseBeforeAfter } from "../config/useCaseBeforeAfter";
import { getUseCaseCompareRow } from "../config/useCaseCompareRow";
import { DISCOVERY_CALL, DISCOVERY_CALL_URL } from "../config/cta";
import { getDemoSampleForUseCase, getUseCasePairSample } from "../config/demoSamples";
import { USE_CASE_PLAN } from "../data/useCasePlanMap";
import { SEGMENT_URLS } from "../config/navigation";

const resolveCTA = (cta: CTA, lc: Locale): { readonly label: string; readonly href: string } =>
  cta.type === "talk-to-us"
    ? { label: DISCOVERY_CALL[lc].buttonLabel, href: DISCOVERY_CALL_URL[lc] }
    : { label: cta.label, href: cta.href };

export interface UseCaseDetailTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  useCase: UseCase;
  pillar: Pillar;
  pillarT: Translations["pillars"];
  useCaseT: Translations["useCases"];
  /** Resolved related use cases (from useCase.relatedUseCases slug list).
   * When non-empty, the "related" section's markdown body is replaced
   * with a card grid built from this data. */
  relatedUseCases?: ReadonlyArray<UseCase>;
}

const { locale, t, base, useCase, pillar, pillarT, useCaseT, relatedUseCases = [] } =
  Astro.props as UseCaseDetailTemplateProps;

// Bridge → Solutions「活用シーン」, keyed by this use case's primary pillar axis.
const UC_SOL_ANCHOR: Record<string, { anchor: string; axis: { ja: string; en: string } }> = {
  "verifiable-origin": { anchor: "input-provenance", axis: { ja: "来歴証明", en: "Verifiable Origin" } },
  "agent-authority-proof": { anchor: "agent-authority", axis: { ja: "エージェント権限", en: "Agent Authority" } },
  "regulatory-attribute-proof": { anchor: "regulatory", axis: { ja: "規制属性", en: "Regulatory Attribute" } },
  "verifiable-ai": { anchor: "verifiable-ai", axis: { ja: "検証可能 AI", en: "Verifiable AI" } },
};
const ucSolMeta = pillar ? UC_SOL_ANCHOR[pillar.slug] : undefined;
const ucBridgeHref = ucSolMeta ? `${base}/solutions/#${ucSolMeta.anchor}` : `${base}/solutions/`;
const ucBridgeCta = ucSolMeta
  ? (locale === "ja" ? `Solutions で ${ucSolMeta.axis.ja}の活用シーンを見る →` : `See use scenarios for ${ucSolMeta.axis.en} in Solutions →`)
  : (locale === "ja" ? "Solutions で活用シーンを見る →" : "See use scenarios in Solutions →");

/** Trim an abstract down to its first sentence so related-use-case cards
 * stay one-line tight. Splits on Japanese or Latin sentence terminators.
 * Falls back to the full abstract if no terminator is found. */
function firstSentence(text: string): string {
  const m = text.match(/^([^。.!?！？]+[。.!?！？])/);
  return (m?.[1] ?? text).trim();
}
const useCasesPath = `${base}/solutions/use-cases`;
const pillarsPath = `${base}/pillars`;
const pricingPath = `${base}/pricing`;
const isJa = locale === "ja";

// 対応プラン — links to the matching plan page (clickable here; detail page is
// not nested inside a card anchor). DRAFT mapping in data/useCasePlanMap.ts.
const planKey = USE_CASE_PLAN[useCase.slug];
const planName: Readonly<Record<string, string>> = {
  civic: "Lemma Civic",
  critical: "Lemma Critical",
  compliance: "Lemma Compliance",
};
const hideProve = getUseCaseHideProve(useCase.slug, locale);
// v3 detail template — both locales. Slugs with a config/useCaseV3.ts entry
// get the authored §1 personas + §2 Before/After (now bilingual); everything
// else derives §1/§2 from the audience/approach markdown.
const v3 = getUseCaseV3(useCase.slug);
// Derived UCs (no v3 config) still get a §2 key:value Before/After table from
// this data-only map; ignored when v3 is present.
const beforeAfter = v3 ? undefined : getUseCaseBeforeAfter(useCase.slug);
// §3 table gains a "detection / monitoring only" row for cyber-relevant UCs.
const compareRow = getUseCaseCompareRow(useCase.slug, locale);
const useV3 = true;
const demoSampleId = getDemoSampleForUseCase(useCase.slug);
const demoPairSampleId = getUseCasePairSample(useCase.slug);

const homeLabel = locale === "ja" ? "ホーム" : "Home";
const minLabel = locale === "ja" ? "分" : "min read";

const SITE = "https://lemma.frame00.com";
const useCaseUrl = `${SITE}${useCasesPath}/${useCase.slug}/`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: useCase.title,
  description: useCase.abstract,
  url: useCaseUrl,
  inLanguage: locale,
  author: { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Lemma" },
  publisher: { "@id": `${SITE}/#organization` },
  mainEntityOfPage: { "@type": "WebPage", "@id": useCaseUrl },
  about: pillar ? { "@type": "Thing", name: pillar.title[locale] } : undefined,
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma", item: `${SITE}${base || ""}/` },
    { "@type": "ListItem", position: 2, name: useCaseT.title, item: `${SITE}${useCasesPath}/` },
    { "@type": "ListItem", position: 3, name: useCase.title, item: useCaseUrl },
  ],
};
---

<Layout
  locale={locale}
  title={`${useCase.title} — ${useCaseT.title} | Lemma`}
  description={useCase.abstract}
  metaType="page"
  pagePath={`/solutions/use-cases/${useCase.slug}/`}
  ogImage={`https://lemma.frame00.com/og/use-cases/${useCase.slug}/${locale}.png`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  {useV3 ? (
    <UseCaseV3Body
      locale={locale}
      base={base}
      useCase={useCase}
      pillar={pillar}
      useCaseTitle={useCaseT.title}
      relatedUseCases={relatedUseCases}
      hideProve={hideProve}
      v3={v3}
      beforeAfter={beforeAfter}
      compareRow={compareRow}
      ucBridgeHref={ucBridgeHref}
      ucBridgeCta={ucBridgeCta}
    />
  ) : (
  <main class="ucd-page">
    <div class="ucd-container">
      <nav class="ucd-breadcrumb" aria-label="breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="ucd-breadcrumb-sep">/</span>
        <a href={useCasesPath}>{useCaseT.title}</a>
        <span class="ucd-breadcrumb-sep">/</span>
        <span>{useCase.title}</span>
      </nav>

      <header class="ucd-hero">
        <h1 class="ucd-h1">{useCase.title}</h1>
        {useCase.thesis && (
          <p class="ucd-thesis">{useCase.thesis}</p>
        )}
        {hideProve && (
          <div class="ucd-hp" aria-label="HIDE と PROVE の対比">
            <div class="ucd-hp__cell ucd-hp__cell--hide">
              <span class="ucd-hp__lab">Hide ── 隠す</span>
              <span class="ucd-hp__val">{hideProve.hide}</span>
            </div>
            <div class="ucd-hp__arrow" aria-hidden="true">→</div>
            <div class="ucd-hp__cell ucd-hp__cell--prove">
              <span class="ucd-hp__lab">Prove ── 証明する</span>
              <span class="ucd-hp__val">{hideProve.prove}</span>
            </div>
          </div>
        )}
        <p class="ucd-abstract">{useCase.abstract}</p>
        <div class="ucd-meta">
          {useCase.targetVerticals.length > 0 && (
            <span class="ucd-verticals">{useCase.targetVerticals.join(" · ")}</span>
          )}
          <span class="ucd-reading-time">
            {useCase.readingTime} {minLabel}
          </span>
        </div>
        {planKey && (
          <a class="ucd-plan" href={SEGMENT_URLS[planKey][locale]}>
            <span class="ucd-plan-pill">🔔 {isJa ? "対応プラン" : "Plan"} · {planName[planKey]} →</span>
          </a>
        )}
      </header>

      <!-- Section index card — visual TOC under the hero. Complements the
           sticky sidebar (which is desktop-only) and gives the page a
           designed anchor surface before the long-form sections begin. -->
      <section class="ucd-toc-card" aria-label={useCaseT.sections}>
        <div class="ucd-toc-label">{useCaseT.sections}</div>
        <ol class="ucd-toc-grid">
          {useCase.sections.map((section, i) => (
            <li class="ucd-toc-item">
              <a href={`#${section.key}`} class="ucd-toc-link">
                <span class="ucd-toc-num">§ {String(i + 1).padStart(2, "0")}</span>
                <span class="ucd-toc-title">{section.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <div class="ucd-layout">
        <article class="ucd-main">
          {useCase.sections.map((section, i) => {
            // For the "related" section: when we have resolved related use
            // cases, render a card grid using the frontmatter slug data and
            // suppress the markdown body. Falls back to the body if the slug
            // list is empty so the page never goes blank.
            const isRelatedCards =
              section.key === "related" && relatedUseCases.length > 0;
            const eyebrowNo = String(i + 1).padStart(2, "0");
            return (
              <section id={section.key} class={`ucd-section${isRelatedCards ? " ucd-section--related" : ""}`}>
                {isJa && (
                  <div class="ucd-section-eye">{eyebrowNo}</div>
                )}
                <h2 class="ucd-section-title">{section.title}</h2>
                {isRelatedCards ? (
                  <ul class="ucd-related-grid">
                    {relatedUseCases.map((r) => (
                      <li class="ucd-related-item">
                        <a href={`${useCasesPath}/${r.slug}`} class="ucd-related-card">
                          {r.thesis && (
                            <div class="ucd-related-thesis">{r.thesis}</div>
                          )}
                          <h3 class="ucd-related-title">{r.title}</h3>
                          <p class="ucd-related-abstract">{firstSentence(r.abstract)}</p>
                          <span class="ucd-related-cta">
                            {pillarT.viewUseCase ?? useCaseT.title} →
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <div class="ucd-section-body" set:html={section.body} />
                )}
              </section>
            );
          })}

          {demoSampleId && (
            <DemoCtaBanner
              locale={locale}
              t={t.demoCta}
              sampleId={demoSampleId}
              source="use-cases"
              pairSampleId={demoPairSampleId ?? undefined}
            />
          )}

          <SolutionsBridge
            href={ucBridgeHref}
            eyebrow={locale === "ja" ? "より広い活用シーン" : "The bigger picture"}
            h2={locale === "ja" ? "このユースケースを含む、活用シーンの全体像。" : "The bigger picture this use case belongs to."}
            sub={locale === "ja"
              ? "業界・業務領域ごとの活用シーンと、5つの証明で整理しています。"
              : "We organize use scenarios across industries and workflows by the five proofs."}
            ctaLabel={ucBridgeCta}
          />

          {locale === "ja" ? (
            <UseCaseExitCta
              slug={useCase.slug}
              pillarSlug={useCase.pillar}
              locale={locale}
              base={base}
            />
          ) : (
            <section class="ucd-partner" aria-label={pillar.ctaCopy?.eyebrow[locale] ?? pillarT.ctaEyebrow}>
              <div class="ucd-partner-eyebrow">{pillar.ctaCopy?.eyebrow[locale] ?? pillarT.ctaEyebrow}</div>
              <h2 class="ucd-partner-h2">{pillar.ctaCopy?.title[locale] ?? pillarT.ctaTitle}</h2>
              <p class="ucd-partner-body">{pillar.ctaCopy?.desc[locale] ?? pillarT.ctaDesc}</p>
              {(() => {
                const primary = resolveCTA(pillar.primaryCTA, locale);
                const secondary = pillar.secondaryCTA ? resolveCTA(pillar.secondaryCTA, locale) : undefined;
                return (
                  <div class="ucd-partner-cta">
                    <a
                      href={primary.href}
                      class="ucd-partner-primary"
                      target={primary.href.startsWith("http") ? "_blank" : undefined}
                      rel={primary.href.startsWith("http") ? "noopener" : undefined}
                    >
                      {primary.label}
                    </a>
                    {secondary && (
                      <a
                        href={secondary.href}
                        class="ucd-partner-secondary"
                        target={secondary.href.startsWith("http") ? "_blank" : undefined}
                        rel={secondary.href.startsWith("http") ? "noopener" : undefined}
                      >
                        {secondary.label}
                      </a>
                    )}
                  </div>
                );
              })()}
            </section>
          )}
        </article>
        {pillar && (
          <nav class="ucd-foot-links" aria-label={isJa ? "関連リンク" : "Related links"}>
            <a class="ucd-pillar-foot" href={`${pillarsPath}/${pillar.slug}`}>
              {isJa ? "仕組みについて知る" : "Learn how it works"} — {pillar.title[locale]} →
            </a>
            <a class="ucd-pillar-foot" href={`${pricingPath}#api`}>
              {isJa ? "料金・API 仕様" : "Pricing & API"} →
            </a>
          </nav>
        )}
      </div>
    </div>
  </main>
  )}

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .ucd-page {
    /* Sora carries Latin; Noto Sans JP backs JA characters so they don't
       cascade into the Layout-level Cormorant / Noto Serif JP stack. */
    --ucd-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --ucd-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --ucd-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --ucd-text-1: #1a1a1a;
    --ucd-text-2: #3a3a3a;
    --ucd-text-3: #5a5a5a;
    --ucd-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--ucd-text-2);
    font-family: var(--ucd-body);
    font-weight: 400;
    line-height: 1.75;
    padding: 0 0 24px;
    margin-top: 64px;
  }
  :root[lang="en"] .ucd-page {
    --ucd-body: "Sora", "Noto Sans JP", system-ui, sans-serif;
  }

  .ucd-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── BREADCRUMB ─── */
  .ucd-breadcrumb {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ucd-text-4);
    padding: 36px 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .ucd-breadcrumb a {
    color: var(--ucd-text-3);
    transition: color 0.15s;
  }
  .ucd-breadcrumb a:hover {
    color: var(--accent);
  }
  .ucd-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .ucd-hero {
    padding: 36px 0 48px;
    max-width: 820px;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  /* Footer links — light "learn how it works" route to the proof page + a
     pricing/API route into the Lemma API hub, at the end of the article
     (the pillar tag was removed from the hero). */
  .ucd-foot-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin: 40px 0 0;
  }
  .ucd-pillar-foot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ucd-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ucd-text-3);
    transition: color 0.15s;
  }
  .ucd-pillar-foot:hover {
    color: var(--accent);
  }
  .ucd-h1 {
    font-family: var(--ucd-display);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 18px;
  }
  :root[lang="ja"] .ucd-h1 {
    line-height: 1.25;
  }
  /* Thesis: bold mono-styled accent block, set off by a brown left rule.
     Italics removed — faked italics on JA glyphs read as serif-y noise. */
  .ucd-thesis {
    font-family: var(--ucd-display);
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 600;
    color: var(--accent);
    line-height: 1.5;
    margin: 0 0 22px;
    max-width: 720px;
    padding: 4px 0 4px 16px;
    border-left: 2px solid var(--accent);
  }
  .ucd-abstract {
    font-size: 15.5px;
    color: var(--ucd-text-2);
    line-height: 1.8;
    margin: 0 0 24px;
    max-width: 720px;
  }

  /* HIDE → PROVE hero device — matches usecase detail mockup (2026-06-02).
     Two stacked cells (cream-deep "Hide" + white "Prove") connected by a
     small saddle-brown arrow. Mobile collapses to a single column with the
     arrow rotating into a vertical caret. */
  .ucd-hp {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    margin: 0 0 24px;
    max-width: 720px;
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
  }
  .ucd-hp__cell {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .ucd-hp__cell--hide {
    background: var(--lemma-cream-deep, #F2EEDF);
  }
  .ucd-hp__lab {
    font-family: var(--ucd-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .ucd-hp__cell--hide .ucd-hp__lab {
    color: var(--ucd-text-3);
  }
  .ucd-hp__cell--prove .ucd-hp__lab {
    color: var(--accent);
  }
  .ucd-hp__val {
    font-size: 13.5px;
    line-height: 1.55;
  }
  .ucd-hp__cell--hide .ucd-hp__val {
    color: var(--ucd-text-3);
  }
  .ucd-hp__cell--prove .ucd-hp__val {
    color: var(--black, #000);
    font-weight: 600;
  }
  .ucd-hp__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    color: var(--accent);
    font-family: var(--ucd-mono);
    font-size: 16px;
  }
  @media (max-width: 620px) {
    .ucd-hp {
      grid-template-columns: 1fr;
    }
    .ucd-hp__arrow {
      width: auto;
      padding: 6px 0;
      transform: rotate(90deg);
    }
  }
  .ucd-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ucd-text-4);
  }
  .ucd-verticals {
    color: var(--ucd-text-3);
  }
  .ucd-reading-time::before {
    content: "·";
    margin-right: 12px;
    color: var(--lemma-line);
  }
  .ucd-meta > :first-child::before {
    content: none;
  }

  /* ─── 対応プラン (links to the matching plan page) ─── */
  .ucd-plan {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 22px 0 0;
    text-decoration: none;
  }
  .ucd-plan-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ucd-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 5px 14px;
    white-space: nowrap;
  }

  /* ─── TOC CARD (visual section index under hero) ─── */
  .ucd-toc-card {
    background: var(--lemma-cream-deep);
    border-radius: 14px;
    padding: 32px 32px 26px;
    margin: 40px 0 16px;
    position: relative;
    overflow: hidden;
  }
  .ucd-toc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .ucd-toc-label {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }
  .ucd-toc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 32px;
    row-gap: 0;
  }
  .ucd-toc-item {
    padding: 0;
    margin: 0;
  }
  .ucd-toc-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.18);
    transition: color 0.15s, border-color 0.15s;
  }
  .ucd-toc-link:hover {
    border-bottom-color: var(--accent);
  }
  .ucd-toc-num {
    font-family: var(--ucd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent);
    flex-shrink: 0;
    min-width: 36px;
  }
