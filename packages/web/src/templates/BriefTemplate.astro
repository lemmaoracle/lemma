---
/**
 * Lemma Critical Brief page template — used by both
 * /critical/briefs/[slug].astro (EN) and /ja/critical/briefs/[slug].astro (JA).
 *
 * モック `lemma_brief_article_mock_v5.html` の面
 * （`Lemma_コンテンツテンプレート_実装指示_v1_2026-07-30.md` §5）。
 *
 * 本文（minmax(0,1fr)）＋右レール 268px の2カラム。右レールは3段（2026-08-21
 * 改訂・PR #848）:
 *   1. 白カード — 読了プログレス＋Contents（scrollspy）
 *   2. 白＋ライム縁 — 脅威タイプ別バナー（primary_category で文言を
 *      出し分け。config/briefThreatBanner.ts）。CTA の飛び先は
 *      config/cta.ts の BRIEF_RAIL_CTA_URL 1か所で差し替える
 *   3. スレート — Lemma のコンセプト。マスターコピーはトップ h1・フッター・
 *      OG と同一文言。ボタンは置かずテキストリンク1本
 *
 * 旧2段目「この Brief の核心」（gap_* 3文）はここで退役した。TL;DR 末尾と §5
 * の言い換えで新規情報が無く、本文の横で読まれていなかったため。
 *
 * 末尾CTAは**証明の訴求**に一本化（「確かめられないものを、業務に入れない。」
 * ＋エンタープライズ相談／検証センター）。なりすまし等の
 * 脅威別訴求は右レールのバナーだけが持つ（§5.5）。旧 BriefAttackCta の
 * バナー／オープンループ／テールと BriefGapModule の本文挿入も退役済み。
 *
 * 章立ては §5.4 の6章（1. TL;DR〜6. Sources）へ移行中（2026-07-30 可否確定・
 * パイロットから順次）。目次は記事の h2 から動的に生成するので、9章の旧本文
 * も6章の新本文も同じテンプレートを通る。markdown 本文が single source of
 * truth である点は変わらない（番号の剥がしは rehype-brief-section-number）。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { isDraftBrief, isVisibleBrief } from "../lib/briefDrafts";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import CiteBriefBox from "../components/CiteBriefBox.astro";
import BriefRevisionNote from "../components/BriefRevisionNote.astro";
import BriefNextRead from "../components/BriefNextRead.astro";
import BriefWeeklyCta from "../components/BriefWeeklyCta.astro";
import { briefFacetTiles, hasFacetTiles } from "../lib/briefNextRead";
import { getTranslations, type Locale } from "../i18n/translations";
import { getEnBriefMap } from "../data/getEnBriefMap";
import { threatBannerCopy } from "../config/briefThreatBanner";
import { briefsCategoryHref } from "../data/briefIndex";
import { BRIEF_RAIL_CTA_URL, DISCOVERY_CALL_URL } from "../config/cta";
import { serviceBannerFor } from "../config/briefServiceBanner";
import { localePath } from "../lib/urls";
import { briefCoverArt } from "../lib/briefCoverArt";
import { briefCountryLabel } from "../config/briefFacets";
import {
  categoryLabel,
  type CategorySlug,
  type PillarSlug,
} from "../data/criticalBriefs";

export interface BriefTemplateProps {
  locale: Locale;
  brief:
    | CollectionEntry<"critical-briefs">
    | CollectionEntry<"critical-briefs-en">;
}

const { locale, brief } = Astro.props as BriefTemplateProps;
const t = getTranslations(locale);
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";

type AnyBrief =
  | CollectionEntry<"critical-briefs">
  | CollectionEntry<"critical-briefs-en">;

const briefNoPad = String(brief.data.brief_no).padStart(3, "0");
const serviceBanner = serviceBannerFor(brief.id, briefNoPad, locale);
const localizedTitle = isJa ? brief.data.title : brief.data.title_en;

const titleParts = localizedTitle.split(" — ");
const mainTitle = titleParts[0];
const subtitle = titleParts.length > 1 ? titleParts.slice(1).join(" — ") : "";

const briefPath = `/critical/briefs/${brief.id}/`;
const briefUrl = `https://lemma.frame00.com${base}${briefPath}`;
const ogImage = `https://lemma.frame00.com/og/critical-briefs/${locale}/${brief.id}.png`;

const { Content, headings } = await render(brief);

// 照合フレームのトライアル (2026-08) — ヒーロー直下の一行「Lemma の照合分析」。
// frontmatter に analysis_lead_* を書いた Brief にだけ出る（既存 Brief は不変）。
const analysisLead = isJa
  ? brief.data.analysis_lead_ja
  : brief.data.analysis_lead_en;

const showRevisionHistory = brief.data.version !== "1.0";

// 旧い形の記事の、見出しの下の要点の箱（2026-10-25・日本語だけ）。書き直さずに読める
// ように、今ある controls（抜けていた対策）と本文の長さ（読む時間）から作る。
// 「何が起きたか」は見出しとほぼ同じになるので出さない。
const legacyControls =
  isJa && brief.data.layout !== "report"
    ? ((brief.data.controls ?? []) as ReadonlyArray<{ item: string }>).map((c) => c.item)
    : [];
const readMinutes =
  isJa && brief.data.layout !== "report"
    ? Math.max(
        1,
        Math.round(
          // 出典の章は数えない。
          (brief.body ?? "")
            .split(/^## (?:\d+\.\s*)?Sources/m)[0]
            .replace(/<[^>]+>/g, "")
            .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
            .replace(/[#>*`|_-]/g, "").length / 600,
        ),
      )
    : 0;

/**
 * report レイアウト（2026-10・opt-in）。frontmatter に `layout: "report"` を
 * 書いた Brief だけが、表紙（スレート＋生成グラフィック＋主要数値）・
 * 章番号つき見出し・目次だけの右レール・図表部品の CSS で描画される。
 * 未指定の Brief は以下の `isReport` 分岐の偽側＝これまでの面をそのまま通る。
 * 本文側の組み替え（改訂注記を外す・用語メモ・核心の帯・参照の1行）は
 * rehype-brief-section-number が frontmatter を見て行う。
 */
const isReport = brief.data.layout === "report";
const coverArt = isReport ? briefCoverArt(brief.data.brief_no) : null;
const keyFigures = (isReport ? (brief.data.key_figures ?? []) : []).map(
  (f) => {
    const [from, to] = f.value.split(/\s*→\s*/);
    return { ...f, from, to };
  },
);

const PILLAR_LABELS: Record<PillarSlug, { ja: string; en: string }> = {
  "01-verifiable-origin": {
    ja: "Pillar 01 · 来歴証明",
    en: "Pillar 01 · Verifiable Origin",
  },
  "02-verifiable-ai": {
    ja: "Pillar 02 · 検証可能 AI",
    en: "Pillar 02 · Verifiable AI",
  },
  "03-agent-authority": {
    ja: "Pillar 03 · エージェント権限証明",
    en: "Pillar 03 · Agent Authority Proof",
  },
  "04-regulatory-attribute": {
    ja: "Pillar 04 · 規制属性証明",
    en: "Pillar 04 · Regulatory Attribute Proof",
  },
};
// 配下4ページは /pillars のタブへ統合 (製品ページ移行 v2.7 §5.4)
const PILLAR_PAGE_ANCHOR: Record<PillarSlug, string> = {
  "01-verifiable-origin": "#provenance",
  "02-verifiable-ai": "#inference",
  "03-agent-authority": "#authority",
  "04-regulatory-attribute": "#attribute",
};

const pillar = brief.data.pillar as PillarSlug;
const pillarLabel = PILLAR_LABELS[pillar][isJa ? "ja" : "en"];
const pillarHref = `${base}/pillars/${PILLAR_PAGE_ANCHOR[pillar]}`;
// report の表紙の見出し行は「Pillar 04 · 」を落とした短い名前だけ。
const pillarShort = pillarLabel.split(" · ").slice(1).join(" · ") || pillarLabel;

// Locale-resolved full collection (EN preferred, JA fallback) for prev/next
// and auto-derived related.
const allJaBriefs = await getCollection("critical-briefs", isVisibleBrief);
const enById = isJa ? null : await getEnBriefMap();
const allLocale: ReadonlyArray<AnyBrief> = allJaBriefs.map(
  (ja) => enById?.get(ja.id) ?? ja,
);

// Prev / Next by published date (ascending): prev = older, next = newer.
// Numbers freed by withdrawn Briefs are reused, so a new Brief can carry a low
// number — ordering by brief_no would wedge it between months-old neighbours.
const byDate = [...allLocale].sort((a, b) => {
  const diff = a.data.published.getTime() - b.data.published.getTime();
  return diff !== 0 ? diff : a.data.brief_no - b.data.brief_no;
});
const selfIdx = byDate.findIndex((b) => b.id === brief.id);
const prevBrief = selfIdx > 0 ? byDate[selfIdx - 1] : null;
const nextBrief =
  selfIdx >= 0 && selfIdx < byDate.length - 1 ? byDate[selfIdx + 1] : null;

// Related: same primary category → same pillar → latest, excluding self.
const byNewest = [...allLocale].sort((a, b) => {
  const diff = b.data.published.getTime() - a.data.published.getTime();
  return diff !== 0 ? diff : b.data.brief_no - a.data.brief_no;
});
const primarySlug = brief.data.primary_category as CategorySlug;
const relatedSet = new Map<string, AnyBrief>();
const addCandidates = (pool: ReadonlyArray<AnyBrief>) => {
  for (const b of pool) {
    if (b.id === brief.id || relatedSet.has(b.id)) continue;
    if (relatedSet.size >= 3) break;
    relatedSet.set(b.id, b);
  }
};
addCandidates(byNewest.filter((b) => b.data.primary_category === primarySlug));
addCandidates(byNewest.filter((b) => b.data.pillar === pillar));
addCandidates(byNewest);
const relatedBriefs = Array.from(relatedSet.values()).slice(0, 3);
// 「似た事例を一覧で読む」の入口。組めたら、末尾の関連 Brief は出さない。
const facetTiles = briefFacetTiles(locale, brief, allLocale);
const hasNextRead = hasFacetTiles(facetTiles);

const primaryCatLabel = categoryLabel(primarySlug, locale);
const secondaryCats = (brief.data.secondary_categories as CategorySlug[]).map(
  (c) => ({ slug: c, label: categoryLabel(c, locale) }),
);
// 絞り込みの受け口は一覧トップではなくアーカイブ側（briefIndex.ts）。
const categoryHref = (slug: string) => briefsCategoryHref(base, slug);

function relatedCardData(b: AnyBrief) {
  const titleLoc = isJa ? b.data.title : b.data.title_en;
  return {
    href: `${base}/critical/briefs/${b.id}/`,
    no: String(b.data.brief_no).padStart(3, "0"),
    title: titleLoc.split(" — ")[0],
    catLabel: categoryLabel(b.data.primary_category as CategorySlug, locale),
  };
}

function pnCardData(b: AnyBrief) {
  const titleLoc = isJa ? b.data.title : b.data.title_en;
  return {
    href: `${base}/critical/briefs/${b.id}/`,
    no: String(b.data.brief_no).padStart(3, "0"),
    date: b.data.published.toISOString().slice(0, 10).replace(/-/g, "."),
    title: titleLoc.split(" — ")[0],
  };
}
const prevData = prevBrief ? pnCardData(prevBrief) : null;
const nextData = nextBrief ? pnCardData(nextBrief) : null;

// TOC: 記事の h2 から動的に生成し、TL;DR を含めて §1 から通しで振る
// （モック v5 の面。6章化後の md は「1. TL;DR」〜「6. Sources」なので md の
// 番号と一致する。9章の旧本文では md 内部の番号と 1 ずれるが、番号は本文に
// 表示していないので目次内で自己完結する）。配布定型文（旧 §9）と brief*
// 補助アンカーは出さない。
const tocSections = headings
  .filter((h) => h.depth === 2)
  .filter((h) => !/^brief/i.test(h.slug) || h.slug === "tldr")
  .filter((h) => !/配布について|distribution/i.test(h.text))
  .map((h, i) => ({ num: i + 1, text: h.text, slug: h.slug }));

// 表紙の下の「自社で確かめる」カード（report・frontmatter self_check）。
const selfCheck = isReport ? (brief.data.self_check as string | undefined) : undefined;
const counterSlug = tocSections.find((s) => s.num === (brief.data.sections === "proof" ? 4 : 5))?.slug;

// 配布定型文（旧 §9）が本文に残っていない Brief には、テンプレート側で
// 短い注記を描画する（6章化で md から定型文を落とすため。移行中の旧本文
// と二重にならないように本文側を検出してゲート）。
const bodyHasDistribution = /配布について|About (this )?(Brief'?s? )?distribution/i.test(
  brief.body ?? "",
);

const incidentDateStr = brief.data.incident_date.toISOString().slice(0, 10);
const publishedStr = brief.data.published.toISOString().slice(0, 10);

const PACK_LABELS: Record<string, string> = {
  "A-incident-response": "Pack A · Incident Response",
  "B-regulatory": "Pack B · Regulatory",
  "C-agent-governance": "Pack C · Agent Governance",
};
const firstPack = (brief.data.related_pack as string[])[0];
const packLabel = firstPack ? (PACK_LABELS[firstPack] ?? firstPack) : null;

const ogLead = (isJa ? brief.data.og_lead_ja : brief.data.og_lead_en) ?? mainTitle;
const seriesSep = isJa ? "｜" : " | ";
const pageTitle = `${ogLead}${seriesSep}Lemma Critical Brief No.${briefNoPad}`;

// Keep the <title> lean: the descriptive `mainTitle` already fills the
// SERP-visible width, so a long generic tail ("Structural Analysis of a
// Critical AI-Era Incident …") only gets truncated and invites Google to
// rewrite the title. Use the same compact series suffix as og:title.
// 日本語は frontmatter の search_title があればそれを使う（会社名＋事象を先に・
// 2026-10-25）。長い見出しは検索結果で途中までしか見えず、何の事件かが切れていた。
const searchTitle = isJa ? (brief.data as { search_title?: string }).search_title : undefined;
const seoTitle = searchTitle
  ? `${searchTitle}｜Lemma Critical Brief`
  : isJa
    ? `${mainTitle}｜Lemma Critical Brief No.${briefNoPad}`
    : `${mainTitle} | Lemma Critical Brief No.${briefNoPad}`;

// 章数はうたわない（9章→6章の移行中で、どちらの本文も通る）。
// report Brief は「この事案の核心」の一文で始める（2026-10-17）。共通の
// 「構造分析…何が証明されている必要があったか」は検証技術の話に寄り、
// 共有先で何の事件かが伝わらなかった。
const reportQuote = isReport ? brief.data.insight?.quote : undefined;
const searchDescription = isJa
  ? (brief.data as { search_description?: string }).search_description
  : undefined;
// SNS のカードは従来の文のまま（検索向けの文は検索結果にだけ出す）。
const shareDescription = reportQuote
  ? isJa
    ? `${reportQuote}何が起きたか、なぜ普通の操作に見えたか、どう対策するか — Lemma Critical Brief。`
    : `${reportQuote} What happened, why it looked like a normal action, and how to counter it — Lemma Critical Brief.`
  : isJa
  // 旧: 「事前に何を証明していれば防げたか」。実在の進行中事案について
  // 立証できない反実仮想を、検索結果と SNS カードの文面に載せていた。EN は
  // 元から "what should have been provable beforehand" で踏み込んでいない
  // ので、JA を EN に揃える。
  ? `${publishedStr}公開の${mainTitle}を構造分析。何が起きたか、なぜ検出側の強化では届かないか、事前に何が証明されている必要があったか。AI のための、信頼インフラ — Lemma Critical Brief。`
  : `Structural analysis of ${mainTitle}: what happened, why better detection doesn't close the gap, and what should have been provable beforehand. The Trust Layer for AI — Lemma Critical Brief.`;
const metaDescription = searchDescription ?? shareDescription;

/**
 * 記事の構造化データ（2026-09-07）。
 *
 * Brief は本文・日付・出典が揃っているのに `@type: Article` を出しておらず、
 * 生成AI・検索の双方から「誰がいつ書いた何なのか」が読めなかった。Layout の
 * `@graph` に連結して1ページ1 JSON-LD に保つ。
 *
 * 値は**画面に出ている事実だけ**。`dateModified` の出どころは3通りある:
 *   - 改訂済み（`version !== "1.0"`）で本文に改訂注記があれば、そこの日付。
 *     注記は `> **改訂（v2.0 / 2026-07-03）**` / `> **Revision (v1.1 / …)**`
 *     の形で本文の先頭付近に置かれ、画面にも出ている（077・109）。
 *   - 未改訂なら `published`。「公開以降さわっていない」は主張してよい事実。
 *   - 改訂済みなのに注記が無い場合（124）は**キーごと落とす**。`published` を
 *     入れると改訂された日を公開日だと偽ることになり、`/llms.txt` で
 *     「日付を落とすな」と書いている側が誤った日付を出すことになる。
 * frontmatter に `revised` を足せばこの解析は不要になる。足すのが本筋。
 */
const revisionDate = brief.body?.match(
  /^>\s*\*\*(?:改訂|Revision)\s*[（(]v[\d.]+\s*\/\s*(\d{4}-\d{2}-\d{2})[）)]/m,
)?.[1];
const dateModified = showRevisionHistory ? revisionDate : publishedStr;

/**
 * `headline` は Google の Article 構造化データで **110字** を超えると
 * リッチリザルトの対象外になりうる。Brief のタイトルは長く、`seoTitle` の
 * まま出すと 139本中 57本が超える（最長205字）。全文は `name` が持つので、
 * ここは超えた分だけ畳む。
 */
const HEADLINE_MAX = 110;
const headline =
  seoTitle.length <= HEADLINE_MAX
    ? seoTitle
    : `${seoTitle.slice(0, HEADLINE_MAX - 1)}…`;
const briefSchema = {
  "@type": "Article",
  "@id": `${briefUrl}#article`,
  headline,
  name: localizedTitle,
  description: metaDescription,
  url: briefUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": briefUrl },
  datePublished: publishedStr,
  ...(dateModified ? { dateModified } : {}),
  inLanguage: isJa ? "ja" : "en",
  image: ogImage,
  author: brief.data.authors.map((name) => ({
    "@type": "Organization",
    name,
  })),
  publisher: { "@id": "https://lemma.frame00.com/#organization" },
  isPartOf: {
    "@type": "PublicationIssue",
    issueNumber: brief.data.brief_no,
    isPartOf: {
      "@type": "Periodical",
      "@id": "https://lemma.frame00.com/critical/briefs/#series",
      name: "Lemma Critical Brief",
      url: "https://lemma.frame00.com/critical/briefs/",
      publisher: { "@id": "https://lemma.frame00.com/#organization" },
    },
  },
  articleSection: primaryCatLabel,
  keywords: [
    brief.data.primary_category,
    ...brief.data.secondary_categories,
  ].join(", "),
  // 事案の発生日。公開日と区別が付くよう `about` に持たせる。`Event` にすると
  // location / endDate を要求するリッチリザルトの契約を 278ページ全部が背負い、
  // Search Console が全件エラーとして挙げてくる。日付を伝えたいだけなので
  // 契約を持たない `Thing` + `disambiguatingDescription` にする。
  about: {
    "@type": "Thing",
    name: localizedTitle,
    disambiguatingDescription: `${isJa ? "事案発生日" : "Incident date"}: ${incidentDateStr}`,
  },
};

// 脅威タイプ別バナー（レール2段目）。CTA は「デモをリクエスト」から
// 「知見を受け取る」に変更（2026-08-21）——Brief の目的は転換より認知で、
// デモ直行は 90日クリック0、末尾CTAとも役割が重複していた。飛び先は
// `BRIEF_RAIL_CTA_URL` 1か所で差し替えられる。
const banner = threatBannerCopy(primarySlug, locale);
const bannerHref = BRIEF_RAIL_CTA_URL[locale];

const countryStr = briefCountryLabel(brief.data.countries, isJa ? "ja" : "en");

const labels = isJa
  ? {
      country: "国・地域",
      incidentDate: "事案日",
      published: "公開日",
      publishedShort: "公開",
      revised: "改訂",
      authors: "発行",
      pack: "関連 Pack",
      tocLabel: "Contents",
      progress: "読了",
      analysisLabel: "Lemma の照合分析",
      relatedHeading: "関連する Brief",
      relatedHeadingEn: "Related",
      revisionHeading: "改訂履歴",
      home: "ホーム",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
      prevDir: "← PREVIOUS",
      nextDir: "NEXT →",
      copyToast: "URL をコピーしました",
      ctaKicker: "Lemma",
      ctaHead1: "確かめられないものを、",
      ctaHead2: "業務に入れない。",
      ctaBody:
        "Lemma は、本物に見えるログインや支払い、記録、配信を、実行する前に照合する「実行前照合」の基盤です。暗号技術の証明で、受け取った側が発行者に問い合わせずに確かめられます。検知はそのままに、その手前に置きます。",
      bannerLabel: "AI×信頼の最前線",
      bannerBtn: "知見を受け取る",
      brandLine1: "本物に見えても、",
      brandLine2: "通す前に照合する。",
      brandSub: "発行は一度。検証は、無料で何度でも。",
      brandMore: "Lemma とは →",
      ctaMain: "エンタープライズ相談",
      ctaVerify: "検証センターを見る",
    }
  : {
      country: "Country",
      incidentDate: "Incident date",
      published: "Published",
      publishedShort: "Published",
      revised: "Revised",
      authors: "Authors",
      pack: "Related Pack",
      tocLabel: "Contents",
      progress: "Read",
      analysisLabel: "Lemma's cross-check analysis",
      relatedHeading: "Related Briefs",
      relatedHeadingEn: "Related",
      revisionHeading: "Revision History",
      home: "Home",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
      prevDir: "← PREVIOUS",
      nextDir: "NEXT →",
      copyToast: "Link copied",
      ctaKicker: "Lemma",
      ctaHead1: "If it can't be verified,",
      ctaHead2: "it doesn't enter your operation.",
      ctaBody:
        "Lemma is a pre-execution check: logins, payments, records and publishing that look genuine are checked before they run, with cryptographic proofs the receiving side verifies without asking the issuer. Detection stays; the check sits in front of it.",
      bannerLabel: "The frontier of AI × trust",
      bannerBtn: "Get the insights",
      brandLine1: "Looks genuine?",
      brandLine2: "Check before it runs.",
      brandSub: "Issue once. Verify free, any number of times.",
      brandMore: "About Lemma →",
      ctaMain: "Talk to enterprise",
      ctaVerify: "See the verification center",
    };
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={briefPath}
  title={seoTitle}
  ogTitle={pageTitle}
  description={metaDescription}
  ogDescription={searchDescription ? shareDescription : undefined}
  ogImage={ogImage}
  jsonLd={[briefSchema]}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  {/* report Brief の読了バー。スマホ・タブレット（右レールが消える幅）だけ出す。 */}
  {isReport && <div class="rx-progress" aria-hidden="true"><i data-rx-bar></i></div>}
  <main class:list={["brief-page", isReport && "is-report"]}>
    <div class="bd-shell">
      <div class="bd-main">
        <div class="brief-breadcrumb">
          <a href={localePath(base)}>{labels.home}</a>
          <span class="brief-breadcrumb-sep">/</span>
          <a href={`${base}/critical/briefs/`}>{labels.breadcrumbBriefs}</a>
          <span class="brief-breadcrumb-sep">/</span>
          <span>{labels.briefNoPrefix} {briefNoPad}</span>
          {/* 下書きはプレビューにだけ出る（本番では絞り込みで外れる）。lib/briefDrafts.ts */}
          {isDraftBrief(brief) && <span class="brief-draft">{isJa ? "下書き" : "Draft"}</span>}
        </div>

        {isReport && coverArt ? (
          <>
            {/* report の表紙。frontmatter（brief_no / pillar / title / key_figures）
                だけで描く。グラフィックは brief_no を種にビルド時生成。 */}
            <header class:list={["rx-cover", !isJa && "is-en"]}>
              <svg
                class="rx-cover-art"
                aria-hidden="true"
                viewBox={coverArt.viewBox}
                preserveAspectRatio={coverArt.preserveAspectRatio}
                set:html={coverArt.inner}
              />
              <div class="rx-cover-in">
                <div class="rx-overline">
                  <span class="no">No. {briefNoPad}</span>
                  <span>Critical Brief</span>
                  <a href={pillarHref}>· {pillarShort}</a>
                </div>
                <h1>{mainTitle}</h1>
                {subtitle && <p class="rx-deck">{subtitle}</p>}
                {keyFigures.length > 0 && (
                  <div class="rx-figs">
                    {keyFigures.map((f) => (
                      <div class:list={["rx-fig", f.tone === "alert" && "alert"]}>
                        {/* 数値・矢印・単位の間に空白を入れない（JSX の改行が空白になる）。 */}
                        <div class="n">{f.from}{f.to !== undefined && <><span class="arw">→</span>{f.to}</>}{f.unit && <small>{f.unit}</small>}</div>
                        <div class="l">{f.label}</div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </header>
            <div class="rx-meta">
              {countryStr && <div><span class="k">{labels.country}</span>{countryStr}</div>}
              <div><span class="k">{labels.incidentDate}</span>{incidentDateStr}</div>
              <div><span class="k">{labels.publishedShort}</span>{publishedStr}</div>
              {showRevisionHistory && (
                <div>
                  <span class="k">{labels.revised}</span>
                  v{brief.data.version}{revisionDate ? ` · ${revisionDate}` : ""}
                </div>
              )}
              <div><span class="k">{labels.authors}</span>{brief.data.authors.join(", ")}</div>
            </div>
            {selfCheck && (
              <aside class="rx-check" aria-label={isJa ? "自社で確かめる" : "Ask yourself"}>
                <div class="rx-check-h">
                  <svg class="rx-check-ic" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.5 4 5.6v6.1c0 4.9 3.4 8.6 8 9.8 4.6-1.2 8-4.9 8-9.8V5.6z" />
                    <path class="tick" d="m8.4 12.2 2.5 2.5 4.9-5.1" />
                  </svg>
                  <span>{isJa ? "自社で確かめる" : "Ask yourself"}</span>
                </div>
                <p class="rx-check-q">{selfCheck}</p>
                {counterSlug && (
                  <a class="rx-check-a" href={`#${counterSlug}`}>{brief.data.sections === "proof" ? (isJa ? "Lemma でできることを見る" : "What Lemma does") : isJa ? "対策を見る" : "How to counter this"}<span aria-hidden="true">→</span></a>
                )}
              </aside>
            )}
            {/* スマホ・タブレットでは右レール（目次）が消えるので、表紙の下に
                畳んだ目次を置く。広い画面では出さない。 */}
            <details class="rx-mtoc">
              <summary>{isJa ? "目次" : "Contents"}</summary>
              <ol>
                {tocSections.map((s) => (
                  <li>
                    <a href={`#${s.slug}`}>
                      <i>{String(s.num).padStart(2, "0")}</i>{s.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </>
        ) : (
        <header class="bd-head">
          <div class="bd-meta">
            <span class="bd-no">No. {briefNoPad}</span>
            {/* 日本語では「Pillar 04 · 規制属性証明」などの分類の語を、記事の頭に出さない
                （最初に専門の語が目に入る・2026-10-25）。英語は今のまま。 */}
            {!isJa && <a class="bd-pillar" href={pillarHref}>{pillarLabel}</a>}
          </div>
          <h1 class="bd-h1">{mainTitle}</h1>
          {subtitle && <p class="bd-sub">{subtitle}</p>}
          {!isJa && (
            <div class="bd-tags">
              <a href={categoryHref(primarySlug)}>{primaryCatLabel}</a>
              {secondaryCats.map((c) => (
                <a href={categoryHref(c.slug)}>{c.label}</a>
              ))}
            </div>
          )}
          {/* メタ4項目は flex の1行並び。上下の罫線のみで縦罫は使わない（§5.2）。 */}
          <div class="bd-facts">
            {countryStr && (
              <div>
                <div class="k">{labels.country}</div>
                <div class="v">{countryStr}</div>
              </div>
            )}
            <div>
              <div class="k">{labels.incidentDate}</div>
              <div class="v">{incidentDateStr}</div>
            </div>
            <div>
              <div class="k">{labels.published}</div>
              <div class="v">{publishedStr}</div>
            </div>
            <div>
              <div class="k">{labels.authors}</div>
              <div class="v">{brief.data.authors.join(", ")}</div>
            </div>
            {packLabel && (
              <div>
                <div class="k">{labels.pack}</div>
                <div class="v">{packLabel}</div>
              </div>
            )}
          </div>
          {readMinutes > 0 && (
            <dl class="bd-sum">
              {legacyControls.length > 0 && (
                <div>
                  <dt>抜けていた対策</dt>
                  <dd>
                    {legacyControls.length === 1 ? (
                      legacyControls[0]
                    ) : (
                      <ul>{legacyControls.map((c) => <li>{c}</li>)}</ul>
                    )}
                  </dd>
                </div>
              )}
              <div>
                <dt>読む時間</dt>
                <dd>約 {readMinutes} 分（要点だけなら、すぐ下の TL;DR）</dd>
              </div>
            </dl>
          )}
          {analysisLead && (
            <aside class="bd-analysis">
              <div class="bd-analysis-k">{labels.analysisLabel}</div>
              <p class="bd-analysis-v">{analysisLead}</p>
            </aside>
          )}
        </header>
        )}

        <article class:list={["brief-body", isReport && "is-report"]}>
          <Content />
        </article>

        {/* 似た事例を一覧で読む。本文の途中（5 章の直前）の 1 行と、Sources の直前の
            ブロック。どちらもページを開いたときに本文の中の目印へ移す。 */}
        <BriefNextRead locale={locale} briefId={brief.id} tiles={facetTiles} variant="inline" />
        <BriefNextRead locale={locale} briefId={brief.id} tiles={facetTiles} variant="block" />
        {/* メールの入口：チェックリストのあとの帯と、TL;DR のあとの 1 行（目印へ移す）。 */}
        {/* 旧い形の記事にも同じ入口（2026-10-25・目印は rehype が置く）。 */}
        {/* proof の記事は、表のあとの導入相談・デモの帯を主の 1 本にし、チェックリストのあとの帯は出さない（2026-11-01）。 */}
        {brief.data.sections !== "proof" && <BriefWeeklyCta locale={locale} briefId={brief.id} variant="checklist" operations={brief.data.operations} />}
        <BriefWeeklyCta locale={locale} briefId={brief.id} variant="top" victimDesk={brief.data.victim_desk} operations={brief.data.operations} />
        {brief.data.sections === "proof" && <BriefWeeklyCta locale={locale} briefId={brief.id} variant="demo" />}

        {/* 配布についての注記（旧 §9 の定型文）。6章化した md には定型文が
            無いので、ここで一律に描画する（文言の個体差が要る Brief —
            係争中注記など — は md 側に残す前提で、本文にあれば出さない）。
            © はフッターが持つので繰り返さない。 */}
        {!bodyHasDistribution && (
          <p class="bd-distribution">
            {isJa
              ? "本資料は公開情報の構造化分析であり、特定組織への監査・診断・推奨ではありません。"
              : "This material is a structured analysis of public information; it is not an audit, diagnosis, or recommendation for any specific organization."}
          </p>
        )}

        {/* 対応サービスのバナー（広告枠・許可リストの Brief だけ）。本文の外、
            引用パネルの前。絵は抽象の地だけ。config/briefServiceBanner.ts */}
        {serviceBanner && (
          <aside class="bd-svc" aria-label={serviceBanner.eyebrow} data-svc-banner={serviceBanner.key}>
            <span class="bd-svc-pr">{serviceBanner.prLabel}</span>
            <span class="bd-svc-k">{serviceBanner.eyebrow}</span>
            <span class="bd-svc-h">{serviceBanner.head}</span>
            <span class="bd-svc-b">{serviceBanner.body}</span>
            <a
              class="bd-svc-btn"
              href={serviceBanner.href}
              target="_blank"
              rel="noopener"
              data-brief-cta-ev="brief_service_banner_click"
              data-cta={`service_banner_${serviceBanner.key}_early`}
            >{serviceBanner.button}</a>
            {serviceBanner.review && serviceBanner.reviewHref && (
              <div class="bd-svc-review">
                <p class="bd-svc-rt">{serviceBanner.review.title}</p>
                <ol class="bd-svc-steps">
                  {serviceBanner.review.steps.map((st, i) => (
                    <li class="bd-svc-step">
                      <span class="n">0{i + 1}</span>
                      <span class="t">{st.t}</span>
                      <span class="d">{st.d}</span>
                    </li>
                  ))}
                </ol>
                <a
                  class="bd-svc-link"
                  href={serviceBanner.reviewHref}
                  target="_blank"
                  rel="noopener"
                  data-brief-cta-ev="brief_service_banner_click"
                  data-cta={`service_banner_${serviceBanner.key}_review`}
                >{serviceBanner.review.link}</a>
              </div>
            )}
          </aside>
        )}

        {/* 引用パネル — Plain text / BibTeX / APA のタブ＋モノスペース本文。 */}
        <CiteBriefBox
          locale={locale}
          briefNo={briefNoPad}
          titleForCitation={localizedTitle}
          year={brief.data.published.getFullYear()}
          briefUrl={briefUrl}
          briefSlug={brief.id}
        />

        {!hasNextRead && relatedBriefs.length > 0 && (
          <section class="bd-related">
            <div class="bd-label">
              <b>{labels.relatedHeading}</b><span>{labels.relatedHeadingEn}</span>
            </div>
            <div class="bd-rcards">
              {relatedBriefs.map((b) => {
                const c = relatedCardData(b);
                return (
                  <a class="bd-rcard" href={c.href}>
                    <span class="n">No. {c.no}</span>
                    <span class="t">{c.title}</span>
                    <span class="g">{c.catLabel}</span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        {(prevData || nextData) && (
          <nav class="bd-prevnext" aria-label="Prev / Next Brief">
            {prevData ? (
              <a href={prevData.href} class="bd-pn prev">
                <span class="dir">{labels.prevDir}</span>
                <span class="t">No. {prevData.no} — {prevData.title}</span>
                <span class="d">{prevData.date}</span>
              </a>
            ) : (
              <span class="bd-pn bd-pn--empty"></span>
            )}
            {nextData ? (
              <a href={nextData.href} class="bd-pn next">
                <span class="dir">{labels.nextDir}</span>
                <span class="t">No. {nextData.no} — {nextData.title}</span>
                <span class="d">{nextData.date}</span>
              </a>
            ) : (
              <span class="bd-pn bd-pn--empty"></span>
            )}
          </nav>
        )}

        {showRevisionHistory && (
          <BriefRevisionNote
            locale={locale}
            heading={labels.revisionHeading}
            version={brief.data.version}
          />
        )}

        {/* 末尾CTA（スレート）— 証明の訴求。脅威別訴求は右レールのバナーが
            担当し、ここには置かない（§5.5）。 */}
        <section class="bd-cta">
          <div class="k">{labels.ctaKicker}</div>
          <h2>{labels.ctaHead1}<br />{labels.ctaHead2}</h2>
          <p>{labels.ctaBody}</p>
          <div class="row">
            <a
              class="btn primary"
              href={`${DISCOVERY_CALL_URL[locale]}?ref=brief_tail&utm_source=brief_tail&utm_medium=cta&utm_campaign=brief_to_call&from=${encodeURIComponent(brief.id)}`}
              target="_blank"
              rel="noopener"
              data-brief-cta-ev="brief_detail_call_click"
              data-cta="cta_tail"
            >{labels.ctaMain}</a>
            <a class="btn ghost" href={`${base}/verify/`}>{labels.ctaVerify}</a>
          </div>
        </section>
      </div>

      <aside class="bd-rail" aria-label={labels.tocLabel}>
        {/* 1段目: 白カード — 読了プログレス＋Contents。 */}
        <div class="bd-railbox">
          {!isReport && (
          <div class="bd-prog">
            <span>{labels.progress}</span>
            <span class="bar"><i data-rail-bar></i></span>
            <span><span data-rail-pct>0</span>%</span>
          </div>
          )}
          <div class="bd-railh">{labels.tocLabel}</div>
          <ul class="bd-toc">
            {tocSections.map((s) => (
              <li>
                <a href={`#${s.slug}`} data-toc-link>
                  <i>{isReport ? String(s.num).padStart(2, "0") : `§${s.num}`}</i><span>{s.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* 目次の下：似た事例を読む（sticky のレールで読む間ずっと見える）。 */}
        <BriefNextRead locale={locale} briefId={brief.id} tiles={facetTiles} variant="rail" />

        {/* 2段目: 脅威タイプ別バナー（白＋ライム縁）。読んでいる事案に紐づく
            「自社はどうか」の問いかけ。CTA は相談で、デモ直行にはしない。 */}
        {/* report レイアウトのレールは目次だけ（バナー・ブランド面を出さない）。 */}
        {!isReport && (
        <div class="bd-railad" data-catkey={primarySlug}>
          <div class="ra-k">{labels.bannerLabel}</div>
          <div class="ra-t">{banner.head}</div>
          <p>{banner.desc}</p>
          <a
            class="ra-btn"
            href={bannerHref}
            target="_blank"
            rel="noopener"
            data-brief-cta-ev="brief_rail_weekly"
            data-cta="rail_weekly"
          >{labels.bannerBtn}</a>
        </div>
        )}

        {/* 3段目: Lemma のコンセプト。Brief 個別の要約でも転換 CTA でもなく、
            「Lemma というものがある」を持ち帰ってもらうためのブランド面
            （2026-08-21）。マスターコピーはトップ h1・フッター・OG と同一の
            文言を使う。ボタンは置かない——転換は末尾 CTA が受ける。 */}
        {!isReport && (
        <div class="bd-railbrand">
          <div class="rb-k">Lemma</div>
          <div class="rb-t">{labels.brandLine1}<br />{labels.brandLine2}</div>
          <p>{labels.brandSub}</p>
          <a class="rb-more" href={localePath(base)}>{labels.brandMore}</a>
        </div>
        )}
      </aside>
    </div>

    <div class="bd-toast" data-toast hidden>{labels.copyToast}</div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<!-- 読了プログレス（本文領域基準）。 -->
<script is:inline>
  (function () {
    function compute() {
      var art = document.querySelector(".brief-body");
      if (!art) return;
      var bars = document.querySelectorAll("[data-rail-bar],[data-rx-bar]");
      if (!bars.length) return;
      var y = window.scrollY || document.documentElement.scrollTop;
      var top = art.getBoundingClientRect().top + y;
      var denom = art.offsetHeight - window.innerHeight;
      var p = denom > 0 ? (y - top) / denom : (y >= top ? 1 : 0);
      p = Math.max(0, Math.min(1, p));
      var n = Math.round(p * 100);
      var pctEl = document.querySelector("[data-rail-pct]");
      if (pctEl) pctEl.textContent = n;
      bars.forEach(function (b) { b.style.width = n + "%"; });
    }
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () { ticking = false; compute(); });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    document.addEventListener("astro:after-swap", compute);
    compute();
  })();
</script>

<!-- 対応サービスのバナー: 50% 見えたら1回だけ表示イベントを送る。 -->
<script is:inline>
  (function () {
    function watch() {
      var el = document.querySelector("[data-svc-banner]");
      if (!el || !("IntersectionObserver" in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.disconnect();
          if (typeof window.gtag !== "function") return;
          window.gtag("event", "brief_service_banner_view", {
            surface: "brief_detail",
            cta_label: "service_banner_" + el.getAttribute("data-svc-banner"),
          });
        });
      }, { threshold: 0.5 });
      io.observe(el);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", watch);
    } else {
      watch();
    }
  })();
</script>

<!-- CTA クリックを GA4 へ（surface=brief_detail）。 -->
<script is:inline>
  (function () {
    function wire() {
      document.querySelectorAll("[data-brief-cta-ev]").forEach(function (el) {
        el.addEventListener("click", function () {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", el.getAttribute("data-brief-cta-ev"), {
            surface: "brief_detail",
            cta_label: el.getAttribute("data-cta"),
            destination: el.getAttribute("href"),
          });
        });
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wire);
    } else {
      wire();
    }
  })();
</script>

<script>
  // Sticky-TOC scrollspy + section anchor links (copy URL). Module script.
  function setupBriefChrome() {
    const body = document.querySelector(".brief-body");
    if (!body) return;

    // Scrollspy: highlight the TOC link for the section in view.
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    );
    const linkByHash = new Map(
      links.map((l) => [l.getAttribute("href") || "", l]),
    );
    const watched = Array.from(
      body.querySelectorAll<HTMLElement>("h2[id]"),
    ).filter((h) => linkByHash.has(`#${h.id}`));

    if (watched.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = (entry.target as HTMLElement).id;
            links.forEach((l) =>
              l.classList.toggle(
                "is-active",
                l.getAttribute("href") === `#${id}`,
              ),
            );
          });
        },
        { rootMargin: "-25% 0px -65% 0px" },
      );
      watched.forEach((h) => observer.observe(h));
    }

    // Section anchors: append a ⌗ link to each numbered/anchored h2.
    const toast = document.querySelector<HTMLElement>("[data-toast]");
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    const showToast = () => {
      if (!toast) return;
      toast.hidden = false;
      toast.classList.add("is-visible");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("is-visible");
        toastTimer = setTimeout(() => {
          toast.hidden = true;
        }, 250);
      }, 1600);
    };

    body.querySelectorAll<HTMLElement>("h2[id]").forEach((h) => {
      if (h.querySelector(".brief-anchor")) return;
      const a = document.createElement("a");
      a.className = "brief-anchor";
      a.href = `#${h.id}`;
      a.setAttribute("aria-label", "Copy link to this section");
      a.textContent = "⌗";
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const url = `${location.origin}${location.pathname}#${h.id}`;
        history.replaceState(null, "", `#${h.id}`);
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(showToast, () => {});
        }
      });
      h.appendChild(a);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupBriefChrome, {
      once: true,
    });
  } else {
    setupBriefChrome();
  }
</script>

<style>
  /* トークンの値は記事テンプレート（BlogArticleTemplate）と同じもの。 */
  .brief-page {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ok-light: #4e7a00;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --sh-s: 0 4px 14px rgba(14, 18, 16, 0.06);
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.09), 0 2px 6px rgba(14, 18, 16, 0.05);
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", monospace;

    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    padding: 0;
    padding-top: 64px; /* sticky ナビ時代の margin-top:64px を padding に変換 — body 背景色の帯を出さない（H1 上の空白修正） */
    /* 末尾CTA（.bd-cta）とフッターは**同じスレートのグラデーション**なので、
       間隔ゼロだと境目が消えて CTA カードがフッターに溶ける。フッター側の
       padding-top:132px はその内側＝暗色なので隙間として効かない。ここで
       ページ地色（--lite）の余白を挟んでカードの下辺を立たせる。
       ※ margin ではなく padding — margin だと body のクリーム地が帯で出る
       （FooterRenewal の #779 メモと同じ理由）。 */
    padding-bottom: 64px;
  }

  /* ─── 2カラム: 本文＋右レール 268px（§5.1） ─── */
  .bd-shell {
    max-width: calc(1180px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 268px;
    gap: 56px;
    align-items: start;
  }
  .bd-main {
    min-width: 0;
  }

  /* ─── BREADCRUMB ─── */
  .brief-breadcrumb {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    align-items: center;
    padding: 34px 0 0;
    font-size: 12px;
    color: var(--muted);
  }
  /* 下書きのラベル（プレビューだけ） */
  .brief-draft {
    padding: 1px 8px;
    border: 1px dashed #4a90b8;
    border-radius: 999px;
    color: #2f6f93;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .brief-breadcrumb a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .brief-breadcrumb a:hover {
    color: var(--tx);
    border-color: var(--line);
  }
  .brief-breadcrumb-sep {
    opacity: 0.5;
  }

  /* ─── HERO（§5.2） ─── */
  .bd-head {
    padding: 34px 0 0;
  }
  .bd-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .bd-no {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ok-ink);
    border: 1px solid rgba(124, 175, 0, 0.45);
    background: rgba(168, 224, 16, 0.09);
    border-radius: 5px;
    padding: 4px 10px;
  }
  .bd-pillar {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .bd-pillar:hover {
    color: var(--ok-ink);
  }
  .bd-h1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(24px, 3.1vw, 34px);
    line-height: 1.55;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 0 0 14px;
  }
  .bd-sub {
    font-size: 15px;
    line-height: 1.9;
    color: var(--tx-soft);
    margin: 0 0 24px;
    padding-left: 20px;
    border-left: 2px solid var(--ok);
  }
  .bd-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .bd-tags a {
    font-size: 11.5px;
    color: var(--tx-soft);
    background: var(--lite-2);
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 5px 12px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .bd-tags a:hover {
    color: var(--ok-ink);
    border-color: rgba(124, 175, 0, 0.45);
  }
  /* 旧い形の記事の要点の箱（日本語）。 */
  .bd-sum {
    margin: 18px 0 6px;
    padding: 4px 18px;
    background: #fff;
    border: 1px solid rgba(22, 25, 15, 0.14);
    border-radius: 4px;
  }
  .bd-sum > div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 12px;
    padding: 11px 0;
    border-top: 1px dotted rgba(22, 25, 15, 0.2);
    font-size: 14.5px;
    line-height: 1.7;
  }
  .bd-sum > div:first-child {
    border-top: 0;
  }
  .bd-sum dt {
    padding-top: 3px;
    font-size: 12px;
    font-weight: 700;
    color: #4e7a00;
  }
  .bd-sum dd {
    margin: 0;
    color: var(--tx);
  }
  .bd-sum ul {
    margin: 0;
    padding-left: 1.1em;
  }
  @media (max-width: 760px) {
    .bd-sum > div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  .bd-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 40px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .bd-facts > div {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .bd-facts .k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .bd-facts .v {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--tx);
  }

  /* 照合フレームのトライアル (2026-08) — ヒーロー直下の「Lemma の照合分析」。
     右レールの核心パネルと役割が重ならないよう、白カード＋ライム縦罫の
     地の面で本文の導入として置く（analysis_lead_* のある Brief だけ）。 */
  .bd-analysis {
    margin-top: 18px;
    padding: 14px 18px;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 3px solid var(--ok);
    box-shadow: var(--sh-s);
  }
  .bd-analysis-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--ok-light);
    margin-bottom: 6px;
  }
  .bd-analysis-v {
    font-family: var(--font-serif-jp);
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--tx);
    font-feature-settings: "palt" 1;
  }

  /* ─── BODY (rendered markdown) — 記事テンプレートと同じ組み ─── */
  .brief-body {
    padding: 14px 0 0;
    font-size: 16px;
    line-height: 2.05;
    color: var(--tx-soft);
    font-feature-settings: "palt" 1;
    overflow-wrap: break-word;
  }
  .brief-body :global(> *) {
    max-width: 100%;
  }
  .brief-body :global(h2[id]),
  .brief-body :global(h3[id]) {
    scroll-margin-top: 96px;
  }
  .brief-body :global(p) {
    margin: 0 0 22px;
  }
  .brief-body :global(strong) {
    font-weight: 600;
    color: var(--tx);
  }
  .brief-body :global(em) {
    font-style: italic;
  }
  .brief-body :global(a) {
    color: var(--ok-light);
    text-decoration: none;
    border-bottom: 1px solid rgba(78, 122, 0, 0.35);
    transition: border-color 0.15s;
    overflow-wrap: anywhere;
  }
  .brief-body :global(a:hover) {
    border-bottom-color: var(--ok-light);
  }

  .brief-body :global(h2) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(20px, 2.1vw, 24px);
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--tx);
    margin: 68px 0 20px;
    position: relative;
  }
  .brief-body :global(h2::before) {
    content: "";
    display: block;
    width: 28px;
    height: 2px;
    border-radius: 2px;
    background: var(--ok);
    margin-bottom: 18px;
  }
  /* モックの見出しは § 無しの素の h2（§ は目次だけが持つ）。
     rehype の data-section-num は目次との対応にだけ使い、表示しない。 */
  .brief-body :global(> h2:first-child) {
    margin-top: 44px;
  }
  .brief-body :global(h3) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--tx);
    margin: 46px 0 14px;
    padding-left: 16px;
    position: relative;
  }
  .brief-body :global(h3::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--ok-ink);
  }
  .brief-body :global(h2 + h3) {
    margin-top: 30px;
  }

  /* Section anchor (⌗) injected by script — visible on h2 hover. */
  .brief-body :global(h2 .brief-anchor) {
    margin-left: 10px;
    font-size: 0.62em;
    color: var(--muted);
    text-decoration: none;
    border: none;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s;
  }
  .brief-body :global(h2:hover .brief-anchor) {
    opacity: 1;
  }
  .brief-body :global(h2 .brief-anchor:hover) {
    color: var(--ok-ink);
  }

  /* ─── LISTS ─── */
  .brief-body :global(ul),
  .brief-body :global(ol) {
    margin: 0 0 24px;
    padding-left: 0;
    list-style: none;
  }
  .brief-body :global(ol) {
    counter-reset: brieflist;
  }
  .brief-body :global(li) {
    position: relative;
    padding-left: 26px;
    margin-bottom: 15px;
    line-height: 1.95;
  }
  .brief-body :global(li:last-child) {
    margin-bottom: 0;
  }
  .brief-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 3px;
    top: 15px;
    width: 10px;
    height: 2px;
    background: var(--ok-ink);
    border-radius: 2px;
  }
  /* 担わないものの列挙。✓ リストと対で置くので、同じ形のまま色だけ落とす。
     ✕ は失敗の記号に読まれるので使わない。 */
  .brief-body :global(ul.bd-limit li::before) {
    background: var(--muted);
    opacity: 0.55;
  }
  .brief-body :global(ul.bd-limit li) {
    color: var(--muted);
  }
  /* できることの列挙は ✓ で走査させる。md 側で <ul class="bd-check"> と
     書いた箇所にだけ効くので、既定の箇条書き（事実の列挙）は不変。
     効能ではなく機能の列挙にだけ使うこと。 */
  .brief-body :global(ul.bd-check li::before) {
    left: 4px;
    top: 12px;
    width: 6px;
    height: 11px;
    background: none;
    border: solid var(--ok-ink);
    border-width: 0 2px 2px 0;
    border-radius: 0;
    transform: rotate(42deg);
  }
  .brief-body :global(ol li) {
    counter-increment: brieflist;
  }
  .brief-body :global(ol li::before) {
    content: counter(brieflist);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ok-ink);
  }
  .brief-body :global(li > ul),
  .brief-body :global(li > ol) {
    margin: 14px 0 2px;
  }
  .brief-body :global(li:has(> ul)),
  .brief-body :global(li:has(> ol)) {
    margin-bottom: 22px;
  }
  .brief-body :global(li li) {
    margin-bottom: 12px;
    padding-left: 22px;
  }
  .brief-body :global(li li::before) {
    left: 2px;
    top: 14px;
    width: 7px;
    background: var(--muted);
  }

  /* ─── タイムライン（§3 時系列）— 縦線＋ライム縁ドット（§5.4）。
     見出し id で当てるので、当たらない章立てでは通常のリストのまま。 ─── */
  .brief-body :global(h2[id*="タイムライン"] + ul),
  .brief-body :global(h2[id*="timeline"] + ul),
  .brief-body :global(h2[id*="時系列"] + ul) {
    position: relative;
    margin: 0 0 26px;
  }
  .brief-body :global(h2[id*="タイムライン"] + ul::before),
  .brief-body :global(h2[id*="timeline"] + ul::before),
  .brief-body :global(h2[id*="時系列"] + ul::before) {
    content: "";
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
  }
  .brief-body :global(h2[id*="タイムライン"] + ul > li),
  .brief-body :global(h2[id*="timeline"] + ul > li),
  .brief-body :global(h2[id*="時系列"] + ul > li) {
    padding-left: 28px;
    margin-bottom: 16px;
  }
  .brief-body :global(h2[id*="タイムライン"] + ul > li::before),
  .brief-body :global(h2[id*="timeline"] + ul > li::before),
  .brief-body :global(h2[id*="時系列"] + ul > li::before) {
    left: 0;
    top: 9px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--lite);
    border: 2px solid var(--ok-ink);
  }

  /* ─── QUOTES ─── */
  .brief-body :global(blockquote) {
    margin: 0 0 24px;
    padding: 2px 0 2px 22px;
    border-left: 2px solid var(--ok);
    font-family: var(--font-serif-jp);
    font-size: 16px;
    line-height: 1.95;
    color: var(--tx);
    font-style: normal;
  }
  .brief-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* ─── CODE ─── */
  .brief-body :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ok-ink);
    background: #eef2ea;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 2px 6px;
  }
  .brief-body :global(pre) {
    position: relative;
    overflow-x: auto;
    margin: 4px 0 28px;
    padding: 22px 24px;
    border-radius: 12px;
    background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%);
    box-shadow: 0 16px 38px rgba(22, 30, 24, 0.2);
  }
  .brief-body :global(pre code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.9;
    color: #d8ddd1;
    background: none;
    border: none;
    padding: 0;
  }

  /* ─── TABLES ─── */
  .brief-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 4px 0 28px;
    font-size: 14px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .brief-body :global(th),
  .brief-body :global(td) {
    padding: 13px 14px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .brief-body :global(th) {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--tx-soft);
    background: var(--lite-2);
    white-space: nowrap;
  }
  .brief-body :global(td) {
    color: var(--tx-soft);
    line-height: 1.8;
  }
  .brief-body :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  /* ─── 参照カード ───
     「参照:」/「References:」で始まる段落から rehype がリンクだけを取り出し
     div[data-brief-refs] に組み替える。1リンク=1カードの小さな列として、
     記事末尾（Sources の後）にさりげなく置く。種別ラベル（BLOG / PILLAR /
     PRODUCT）は href から自動判定した data-ref-kind。 */
  .brief-body :global(div[data-brief-refs]) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px;
    margin: 44px 0 0;
  }
  /* カード列の後に注記段落が続く Brief がある（132〜150）。カードに貼り付かないよう空ける。 */
  .brief-body :global(div[data-brief-refs] + *) {
    margin-top: 28px;
  }
  .brief-body :global(div[data-brief-refs] a) {
    position: relative;
    display: block;
    padding: 32px 16px 14px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--tx);
    text-decoration: none;
    overflow-wrap: break-word;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .brief-body :global(div[data-brief-refs] a:hover) {
    border-color: rgba(124, 175, 0, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--sh-m);
  }
  .brief-body :global(div[data-brief-refs] a)::before {
    position: absolute;
    top: 13px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--muted);
    transition: color 0.18s;
  }
  .brief-body :global(div[data-brief-refs] a[data-ref-kind="blog"])::before {
    content: "BLOG";
  }
  .brief-body :global(div[data-brief-refs] a[data-ref-kind="pillar"])::before {
    content: "PILLAR";
  }
  .brief-body :global(div[data-brief-refs] a[data-ref-kind="product"])::before {
    content: "PRODUCT";
  }
  .brief-body :global(div[data-brief-refs] a:hover)::before {
    color: var(--ok-ink);
  }

  /* ─── RULES ─── */
  .brief-body :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 52px 0 0;
    opacity: 0.7;
  }
  .brief-body :global(hr:has(+ h2)),
  .brief-body :global(hr:has(+ h3)) {
    display: none;
  }
  .brief-body :global(hr + h2) {
    margin-top: 56px;
  }

  /* ─── 配布についての注記（旧 §9 の定型文・テンプレート描画） ─── */
  .bd-distribution {
    margin: 40px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
  }

  /* ─── SECTION LABEL（関連 Brief） ─── */
  .bd-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 48px 0 0;
  }
  .bd-label b {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.06em;
    color: var(--tx);
  }
  .bd-label span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bd-label::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }

  /* ─── RELATED 3枚（No.＋3行クランプ） ─── */
  .bd-rcards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 20px 0 0;
  }
  .bd-rcard {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px;
    text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .bd-rcard:hover {
    border-color: rgba(124, 175, 0, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--sh-m);
  }
  .bd-rcard .n {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ok-ink);
  }
  .bd-rcard .t {
    font-size: 13.2px;
    line-height: 1.7;
    color: var(--tx);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bd-rcard .g {
    margin-top: auto;
    font-size: 11px;
    color: var(--muted);
  }

  /* ─── PREV / NEXT（No. 付き） ─── */
  .bd-prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 26px 0 0;
  }
  .bd-pn {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 20px 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .bd-pn:hover {
    border-color: rgba(124, 175, 0, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--sh-m);
  }
  .bd-pn.next {
    text-align: right;
    align-items: flex-end;
  }
  .bd-pn--empty {
    background: transparent;
    border: none;
    box-shadow: none;
    pointer-events: none;
  }
  .bd-pn .dir {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--ok-ink);
  }
  .bd-pn .t {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 14.5px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: var(--tx);
  }
  .bd-pn .d {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }

  /* ─── 末尾CTA（スレート・証明の訴求） ─── */
  /* 対応サービスのバナー（広告枠）。地はスレート＋ドット格子＋右上の
     ライムの光と、右下へ流れる細い線（抽象）。事案の絵は描かない。
     本文の部品と見分けるため、横長の1枚・ボタン・隅の PR で組む。 */
  .bd-svc {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "k btn" "h btn" "b btn" "rv rv";
    align-items: center;
    gap: 6px 32px;
    overflow: hidden;
    margin: 40px 0 0;
    padding: 30px 34px 30px;
    border-radius: 14px;
    text-decoration: none;
    color: #ebefe6;
    background:
      radial-gradient(80% 140% at 100% 0%, rgba(168, 224, 16, 0.24), rgba(168, 224, 16, 0) 58%),
      linear-gradient(168deg, #3c443d 0%, #2f372f 58%, #272e28 100%);
  }
  .bd-svc::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(235, 239, 230, 0.08) 1px, transparent 1.2px);
    background-size: 22px 22px;
  }
  .bd-svc::after {
    content: "";
    position: absolute;
    right: -40px;
    bottom: -60px;
    width: 340px;
    height: 220px;
    pointer-events: none;
    background: repeating-linear-gradient(
      -28deg,
      rgba(168, 224, 16, 0) 0 14px,
      rgba(168, 224, 16, 0.16) 14px 15px
    );
    mask-image: radial-gradient(closest-side, #000, transparent);
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
  }
  .bd-svc > :not(.bd-svc-pr) {
    position: relative;
    z-index: 1;
  }
  .bd-svc > .bd-svc-pr {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    color: #9ba296;
    border: 1px solid #59645a;
    border-radius: 3px;
    padding: 1px 5px;
  }
  .bd-svc-k {
    grid-area: k;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: var(--ok);
  }
  .bd-svc-h {
    grid-area: h;
    white-space: pre-line;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(19px, 2.3vw, 24px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: #f3f6ec;
  }
  .bd-svc-b {
    grid-area: b;
    font-size: 13px;
    line-height: 1.85;
    color: #bcc3b6;
    max-width: 46ch;
  }
  .bd-svc-review {
    grid-area: rv;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(235, 239, 230, 0.14);
  }
  .bd-svc-rt {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    color: #dfe5d6;
  }
  .bd-svc-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bd-svc-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ok);
    text-decoration: none;
    border-bottom: 1px solid rgba(168, 224, 16, 0.4);
  }
  .bd-svc-link:hover {
    border-bottom-color: var(--ok);
  }
  .bd-svc-step {
    display: block;
    margin: 0;
    padding: 12px 14px 13px;
    border: 1px solid rgba(235, 239, 230, 0.14);
    border-radius: 8px;
    background: rgba(15, 20, 18, 0.28);
  }
  .bd-svc-step .n {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ok);
  }
  .bd-svc-step .t {
    display: block;
    margin: 3px 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: #f3f6ec;
  }
  .bd-svc-step .d {
    display: block;
    font-size: 12px;
    line-height: 1.7;
    color: #bcc3b6;
  }
  .bd-svc-btn {
    grid-area: btn;
    align-self: center;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 12px 20px;
    border-radius: 6px;
    background: var(--ok);
    color: #0f1412;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(168, 224, 16, 0.3);
    transition: filter 0.18s;
  }
  .bd-svc-btn:hover {
    filter: brightness(1.06);
  }
  @media (max-width: 720px) {
    .bd-svc {
      grid-template-columns: 1fr;
      grid-template-areas: "k" "h" "b" "btn" "rv";
      padding: 26px 20px 24px;
    }
    .bd-svc-steps {
      grid-template-columns: 1fr;
    }
    .bd-svc-btn {
      justify-self: start;
      margin-top: 10px;
      white-space: normal;
    }
  }
  .bd-cta {
    position: relative;
    overflow: hidden;
    margin: 44px 0 0;
    background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%);
    border-radius: 16px;
    padding: 38px 36px 34px;
  }
  .bd-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      125% 78% at 92% -18%,
      rgba(168, 224, 16, 0.18),
      rgba(168, 224, 16, 0) 62%
    );
  }
  .bd-cta > * {
    position: relative;
    z-index: 2;
  }
  .bd-cta .k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: #9ba296;
  }
  .bd-cta h2 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: #ebefe6;
    margin: 12px 0 10px;
  }
  .bd-cta p {
    margin: 0 0 24px;
    font-size: 13.5px;
    line-height: 1.9;
    color: #bcc3b6;
    max-width: 58ch;
  }
  .bd-cta .row {
    display: flex;
    gap: 12px 18px;
    flex-wrap: wrap;
    align-items: center;
  }
  .bd-cta .btn {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 6px;
    padding: 12px 22px;
    text-decoration: none;
    transition: filter 0.18s, border-color 0.18s, color 0.18s;
  }
  .bd-cta .btn.primary {
    background: var(--ok);
    color: #0f1412;
    box-shadow: 0 4px 14px rgba(168, 224, 16, 0.35);
  }
  .bd-cta .btn.primary:hover {
    filter: brightness(1.06);
  }
  .bd-cta .btn.ghost {
    color: #d8ddd1;
    border: 1px solid #59645a;
  }
  .bd-cta .btn.ghost:hover {
    border-color: #d8ddd1;
    color: #fff;
  }
  /* ─── 右レール（§5.1/§5.3） ───
     レールがビューポートより背が高いと、sticky の一枚板では下段（核心・
     バナー）が本文の読了までずっと画面外に取り残される。ビューポートに
     収めて超過分は**レール内スクロール**にする（目次レールの定石）。
     横 padding＋負マージンは、overflow でカードの影が切れないための逃げ。 */
  .bd-rail {
    position: sticky;
    top: 96px;
    margin-top: 46px;
    max-height: calc(100vh - 96px - 24px);
    overflow-y: auto;
    /* 下 padding は影のクリップ避け。3段（目次741px）が 907px 級の画面で
       内部スクロールせずに収まるところまで詰めてある。 */
    padding: 2px 8px 14px;
    margin-left: -8px;
    margin-right: -8px;
    scrollbar-width: thin;
    scrollbar-color: #cfd4cc transparent;
  }
  .bd-rail::-webkit-scrollbar {
    width: 6px;
  }
  .bd-rail::-webkit-scrollbar-thumb {
    background: #cfd4cc;
    border-radius: 99px;
  }
  .bd-rail::-webkit-scrollbar-track {
    background: transparent;
  }
  .bd-railbox {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    box-shadow: var(--sh-s);
  }
  .bd-prog {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .bd-prog .bar {
    flex: 1;
    height: 3px;
    border-radius: 99px;
    background: #e4e7e1;
    overflow: hidden;
  }
  .bd-prog .bar i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ok);
  }
  .bd-railh {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 6px;
  }
  .bd-toc {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bd-toc a {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 8px;
    padding: 7px 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--tx-soft);
    text-decoration: none;
    transition: color 0.15s;
  }
  .bd-toc a i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
  }
  .bd-toc a:hover {
    color: var(--ok-ink);
  }
  /* 現在地は墨字太字・番号が濃ライム（§5.3）。 */
  .bd-toc a.is-active {
    color: var(--tx);
    font-weight: 600;
  }
  .bd-toc a.is-active i {
    color: var(--ok-ink);
  }

  /* 2段目: スレート小箱。 */
  /* ─── レール2段目: 脅威タイプ別バナー（白＋ライム縁） ─── */
  .bd-railad {
    margin-top: 14px;
    padding: 16px 17px 15px;
    background: var(--card);
    border: 1px solid rgba(124, 175, 0, 0.45);
    border-radius: 12px;
    box-shadow: var(--sh-s);
    position: relative;
    overflow: hidden;
  }
  .bd-railad::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 3px;
    background: var(--ok);
  }
  .ra-k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--ok-ink);
    margin: 4px 0 9px;
  }
  .ra-t {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.65;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin-bottom: 9px;
  }
  .bd-railad p {
    margin: 0 0 13px;
    font-size: 11.5px;
    line-height: 1.75;
    color: var(--muted);
  }
  .ra-btn {
    display: block;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--ok);
    border-radius: 7px;
    padding: 9px 12px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(168, 224, 16, 0.3);
    transition: filter 0.15s;
  }
  .ra-btn:hover {
    filter: brightness(1.06);
  }

  /* ─── レール3段目: Lemma のコンセプト ───
     スレート地＝ブランド面。ボタンは置かず、静かなテキストリンク1本だけ。
     旧「この Brief の核心」（本文の TL;DR と §5 の言い換えだった）を畳んで
     ここに替えた。レール総高は 938px → 約 740px。 */
  .bd-railbrand {
    margin-top: 14px;
    padding: 20px 18px 18px;
    background: var(--ink);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  .bd-railbrand::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 3px;
    background: var(--ok);
  }
  .rb-k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ok);
    margin: 0 0 12px;
  }
  .rb-t {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: #f3f4f1;
    margin: 0 0 12px;
  }
  .bd-railbrand p {
    margin: 0 0 16px;
    font-size: 11.5px;
    line-height: 1.8;
    color: #9ba296;
  }
  .rb-more {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ok);
    text-decoration: none;
    border-bottom: 1px solid rgba(168, 224, 16, 0.35);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }
  .rb-more:hover {
    border-color: var(--ok);
  }

  /* ─── COPY TOAST ─── */
  .bd-toast {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--ink);
    color: var(--lite);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    padding: 11px 22px;
    border-radius: 50px;
    z-index: 200;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }
  .bd-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ─── RESPONSIVE（1020px 以下で1カラム・レールは本文の下へ） ─── */
  @media (max-width: 1020px) {
    .bd-shell {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .bd-rail {
      position: static;
      margin-top: 0;
      max-height: none;
      overflow: visible;
      padding: 0;
      margin-left: 0;
      margin-right: 0;
    }
    .bd-rcards {
      grid-template-columns: 1fr;
    }
    .bd-prevnext {
      grid-template-columns: 1fr;
    }
    .bd-pn.next {
      text-align: left;
      align-items: flex-start;
    }
    .bd-pn--empty {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .brief-page {
      padding-bottom: 40px;
    }
    .bd-shell {
      padding: 0 24px;
    }
    .bd-cta {
      padding: 30px 24px 28px;
    }
  }
  @media (max-width: 620px) {
    .brief-body :global(table) {
      display: block;
      overflow-x: auto;
      font-size: 12.5px;
    }
    .brief-body :global(th),
    .brief-body :global(td) {
      padding: 10px 11px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bd-rcard,
    .bd-pn,
    .bd-prog .bar i {
      transition: none;
    }
  }
  /* ═══════════════════════════════════════════════════════════════════
     report レイアウト（frontmatter `layout: "report"`・2026-10 opt-in）
     承認済みモック 032_v8 の面。すべて `.is-report` の下に閉じているので、
     レイアウト未指定の Brief には一切効かない。本文部品は md 側で class を
     付けた HTML ブロック（要旨・事実の表・図表・時系列・パネル・出典）。
     ═══════════════════════════════════════════════════════════════════ */
  .brief-page.is-report {
    --line-2: #cfd3c8;
    --slate: #2f372f;
    --red: #c25438;
    --red-ink: #9a3f28;
    --amber: #8a6a00;
  }
  .brief-page.is-report .bd-shell {
    grid-template-columns: minmax(0, 800px) 200px;
    gap: 64px;
    justify-content: center;
  }

  /* ─── 表紙 ─── */
  .rx-cover,
  .rx-meta {
    font-feature-settings: "palt" 1;
  }
  .rx-cover {
    position: relative;
    margin-top: 18px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(168deg, #3c443d, #2f372f 58%, #272e28);
    color: #e9eee3;
    isolation: isolate;
  }
  .rx-cover-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .rx-cover-in {
    padding: 32px 40px 0;
  }
  .rx-overline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.16em;
    color: #a9b2a2;
    text-transform: uppercase;
  }
  .rx-overline .no {
    color: var(--tx);
    background: var(--ok);
    border-radius: 4px;
    padding: 3px 9px;
    letter-spacing: 0.1em;
  }
  .rx-overline a {
    color: inherit;
    text-decoration: none;
    border: 0;
  }
  .rx-overline a:hover {
    color: var(--ok);
  }
  .rx-cover h1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(22px, 2.3vw, 27px);
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: #f4f7ee;
    margin: 18px 0 12px;
    max-width: 66%;
  }
  .rx-deck {
    margin: 0 0 28px;
    max-width: 34em;
    font-size: 15px;
    line-height: 1.85;
    color: #cdd4c6;
    padding-left: 16px;
    border-left: 2px solid var(--ok);
  }
  .rx-figs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    margin: 0 -40px;
    background: rgba(20, 25, 21, 0.35);
  }
  .rx-fig {
    padding: 18px 24px 20px 40px;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }
  .rx-fig:last-child {
    border-right: 0;
  }
  .rx-fig .n {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
    color: #fff;
    white-space: nowrap;
  }
  .rx-fig .n small {
    font-size: 14px;
    margin-left: 2px;
    color: #dfe6d6;
  }
  /* 英語は単位を語として離す（「≈ ¥9 million」「Several hotels」）。 */
  /* 英語の見出しは日本語より語数が多く、66% 幅では 7 行に折れる。 */
  .rx-cover.is-en h1 {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.5;
    max-width: 76%;
  }
  .rx-cover.is-en .rx-fig .n small {
    margin-left: 0.3em;
  }
  .rx-fig .n .arw {
    color: var(--ok);
    font-size: 18px;
    margin: 0 5px;
  }
  .rx-fig .l {
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 1.65;
    color: #b9c1b2;
  }
  .rx-fig.alert .n {
    color: #ffb39e;
  }
  .rx-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    padding: 12px 2px;
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--tx);
  }
  /* 自社で確かめる（表紙の下・TL;DR の上） */
  .rx-check {
    margin: 16px 0 0;
    padding: 12px 18px 13px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid rgba(111, 156, 0, 0.35);
  }
  .rx-check-h {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--ok-light);
    letter-spacing: 0.04em;
  }
  .rx-check-ic {
    flex: none;
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 50%;
    background: var(--ok);
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .rx-check-ic .tick {
    stroke-width: 2.4;
  }
  .rx-check-a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ok);
    color: var(--ink);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .rx-check-a:hover {
    background: #b8ec2a;
  }
  .rx-check-q {
    margin: 6px 0 0;
    font-family: var(--font-serif-jp);
    font-weight: 700;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--tx);
  }
  .rx-meta div {
    display: flex;
    gap: 9px;
    align-items: baseline;
  }
  .rx-meta .k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ─── 右レール: 目次だけ（モックの細い縦罫） ─── */
  .brief-page.is-report .bd-rail {
    margin-top: 72px;
  }
  .brief-page.is-report .bd-railbox {
    background: none;
    border: 0;
    border-left: 1px solid var(--line-2);
    border-radius: 0;
    box-shadow: none;
    padding: 4px 0 4px 18px;
  }
  .brief-page.is-report .bd-railh {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 8px;
  }
  .brief-page.is-report .bd-toc a {
    grid-template-columns: 26px 1fr;
    gap: 0;
    padding: 5px 0;
    font-size: 13px;
    line-height: 1.55;
  }
  .brief-page.is-report .bd-toc a i {
    padding-top: 2px;
  }
  .brief-page.is-report .bd-toc a.is-active {
    font-weight: 700;
  }

  /* ─── 本文の組み ─── */
  .brief-body.is-report {
    padding-top: 0;
    line-height: 1.95;
    counter-reset: rxsec;
  }
  .brief-body.is-report :global(p) {
    margin: 0 0 18px;
  }
  .brief-body.is-report :global(h2[id]),
  .brief-body.is-report :global(h3[id]) {
    scroll-margin-top: 88px;
  }
  /* 章見出し: 「01 見出し」＋墨の上罫。番号は CSS カウンタ（md の番号は
     rehype が剥がして data-section-num に移している）。 */
  .brief-body.is-report :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 16px;
    border-top: 1.5px solid var(--tx);
    padding-top: 14px;
    margin: 60px 0 20px;
    font-size: clamp(20px, 2vw, 23px);
    line-height: 1.5;
    counter-increment: rxsec;
  }
  .brief-body.is-report :global(> h2:first-child) {
    margin-top: 40px;
  }
  .brief-body.is-report :global(h2::before) {
    content: counter(rxsec, decimal-leading-zero);
    display: inline;
    width: auto;
    height: auto;
    margin: 0;
    border-radius: 0;
    background: none;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 26px;
    line-height: 1;
    color: var(--ok-ink);
  }
  .brief-body.is-report :global(h3) {
    font-size: 16.5px;
    margin: 36px 0 10px;
    padding-left: 0;
  }
  .brief-body.is-report :global(h3::before) {
    content: none;
  }
  .brief-body.is-report :global(h2 + h3) {
    margin-top: 24px;
  }
  .brief-body.is-report :global(> ul:not([class]) > li) {
    padding-left: 22px;
    margin-bottom: 10px;
  }
  .brief-body.is-report :global(> ul:not([class]) > li::before) {
    left: 2px;
    top: 14px;
  }

  /* 要旨（§1） */
  .brief-body.is-report :global(.rx-exsum) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .brief-body.is-report :global(.rx-exsum ol) {
    margin: 0;
    padding: 2px 24px;
  }
  .brief-body.is-report :global(.rx-exsum li) {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: 18px;
    padding: 15px 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .brief-body.is-report :global(.rx-exsum li::before) {
    content: none;
  }
  .brief-body.is-report :global(.rx-exsum li:last-child) {
    border-bottom: 0;
  }
  .brief-body.is-report :global(.rx-exsum .lab) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    color: var(--muted);
    padding-top: 4px;
  }
  .brief-body.is-report :global(.rx-exsum .lab b) {
    display: block;
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--tx);
    font-weight: 700;
  }
  .brief-body.is-report :global(.rx-exsum p) {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.9;
  }
  .brief-body.is-report :global(.rx-exsum li.key) {
    background: linear-gradient(90deg, rgba(168, 224, 16, 0.1), rgba(168, 224, 16, 0));
    margin: 0 -24px;
    padding: 15px 24px;
    border-left: 3px solid var(--ok);
  }
  .brief-body.is-report :global(.rx-exsum li.key p) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    color: var(--tx);
    font-size: 16px;
  }

  /* 定義表（事実・注意したい業界と業務・持ち主） */
  .brief-body.is-report :global(.rx-facts) {
    border-top: 1px solid var(--tx);
    margin: 0 0 18px;
  }
  .brief-body.is-report :global(.rx-facts dl) {
    margin: 0;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
  }
  .brief-body.is-report :global(.rx-facts dt),
  .brief-body.is-report :global(.rx-facts dd) {
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
  }
  .brief-body.is-report :global(.rx-facts dt) {
    font-size: 13px;
    font-weight: 700;
    color: var(--tx);
    padding-right: 16px;
    line-height: 1.8;
  }
  .brief-body.is-report :global(.rx-facts dd) {
    font-size: 15px;
    line-height: 1.85;
  }
  .brief-body.is-report :global(.rx-scope dt .kk) {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--muted);
    font-weight: 400;
    margin-bottom: 2px;
  }

  /* 用語メモ（frontmatter glossary → rehype が差す） */
  /* 下の余白：用語メモのあとに本文の段落が続くと、くっついて見えた（158）。 */
  .brief-body.is-report :global(.rx-note) {
    margin: 18px 0 24px;
    padding: 10px 14px;
    border-left: 2px solid var(--line-2);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--muted);
  }
  .brief-body.is-report :global(.rx-note b) {
    color: var(--tx-soft);
    font-weight: 700;
  }
  .brief-body.is-report :global(.rx-note .k) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    margin-right: 10px;
  }

  /* 図表パネル・必要になるもの・点検チェックリスト（同じパネル） */
  .brief-body.is-report :global(.rx-ex),
  .brief-body.is-report :global(.rx-box),
  .brief-body.is-report :global(.bx-checklist) {
    background: #eef1e8;
    border: 1px solid #dde3d2;
    border-radius: 10px;
    padding: 16px 20px 20px;
  }
  .brief-body.is-report :global(.rx-ex) {
    margin: 32px 0 26px;
  }
  .brief-body.is-report :global(.rx-box),
  .brief-body.is-report :global(.bx-checklist) {
    margin: 28px 0 22px;
  }
  .brief-body.is-report :global(.rx-ex-h) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 4px;
  }
  .brief-body.is-report :global(.rx-ex-no) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--ok-light);
    white-space: nowrap;
  }
  .brief-body.is-report :global(.rx-ex-t) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.55;
    color: var(--tx);
  }
  .brief-body.is-report :global(.rx-ex-cap) {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--muted);
  }
  .brief-body.is-report :global(.rx-box-cap) {
    margin: 6px 0 12px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--muted);
  }

  /* 図表: 連鎖（rx-chain）。段の数だけ列を等分する（4列固定だと5段目が2行目に落ちた） */
  .brief-body.is-report :global(.rx-chain) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }
  .brief-body.is-report :global(.rx-step) {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 14px 16px 16px;
    margin-right: 18px;
    border-radius: 8px;
  }
  .brief-body.is-report :global(.rx-step:last-child) {
    margin-right: 0;
  }
  .brief-body.is-report :global(.rx-step:not(:last-child)::after) {
    content: "";
    position: absolute;
    right: -15px;
    top: 50%;
    width: 10px;
    height: 10px;
    border-top: 2px solid #9aa292;
    border-right: 2px solid #9aa292;
    transform: translateY(-50%) rotate(45deg);
  }
  .brief-body.is-report :global(.rx-step .who) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.6;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .brief-body.is-report :global(.rx-step .no) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 20px;
    line-height: 1;
    color: var(--tx);
    margin: 6px 0;
  }
  .brief-body.is-report :global(.rx-step b) {
    display: block;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--tx);
    margin-bottom: 4px;
  }
  .brief-body.is-report :global(.rx-step p) {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.7;
  }
  .brief-body.is-report :global(.rx-step.crit) {
    border: 1.5px solid var(--red);
    background: #fffaf8;
  }
  .brief-body.is-report :global(.rx-step.crit .no) {
    color: var(--red);
  }
  .brief-body.is-report :global(.rx-step.good) {
    border-color: #c9da9a;
  }
  .brief-body.is-report :global(.rx-step.good .no) {
    color: var(--ok-ink);
  }

  /* 図表: 検出と証明の落差（rx-gap） */
  .brief-body.is-report :global(.rx-gap) {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr 1fr 1fr;
    column-gap: 10px;
    row-gap: 8px;
  }
  .brief-body.is-report :global(.rx-zone) {
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12.5px;
    line-height: 1.55;
  }
  .brief-body.is-report :global(.rx-zone b) {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .brief-body.is-report :global(.rx-zone.proof) {
    grid-column: 1 / 3;
    border: 1.5px dashed var(--red);
    color: var(--red-ink);
    background: rgba(194, 84, 56, 0.05);
  }
  .brief-body.is-report :global(.rx-zone.gapz) {
    grid-column: 3;
    grid-row: 1 / 3;
    background: var(--slate);
    color: #e4e9de;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .brief-body.is-report :global(.rx-zone.gapz b) {
    color: var(--ok);
    font-size: 10px;
  }
  .brief-body.is-report :global(.rx-zone.gapz span) {
    font-size: 12.5px;
    line-height: 1.6;
    margin-top: 4px;
  }
  .brief-body.is-report :global(.rx-zone.det) {
    grid-column: 4 / 6;
    border: 1.5px solid #b8cf7a;
    color: var(--ok-light);
    background: rgba(168, 224, 16, 0.09);
  }
  .brief-body.is-report :global(.rx-g) {
    grid-row: 2;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px 12px;
  }
  .brief-body.is-report :global(.rx-g .t) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .brief-body.is-report :global(.rx-g b) {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--tx);
    margin-top: 2px;
  }
  .brief-body.is-report :global(.rx-g.g1) {
    grid-column: 1;
  }
  .brief-body.is-report :global(.rx-g.g2) {
    grid-column: 2;
    border-color: var(--red);
  }
  .brief-body.is-report :global(.rx-g.g3) {
    grid-column: 4;
  }
  .brief-body.is-report :global(.rx-g.g4) {
    grid-column: 5;
  }

  /* 時系列（§3）— 既定の縦線タイムラインを打ち消して表組みにする */
  .brief-body.is-report :global(.rx-tl) {
    margin: 0 0 20px;
    padding: 0;
    border-top: 1px solid var(--tx);
  }
  .brief-body.is-report :global(.rx-tl::before) {
    content: none;
  }
  .brief-body.is-report :global(.rx-tl > li) {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 11px 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.8;
  }
  .brief-body.is-report :global(.rx-tl > li::before) {
    content: none;
  }
  .brief-body.is-report :global(.rx-tl time) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--tx);
    padding-top: 2px;
    white-space: nowrap;
  }
  .brief-body.is-report :global(.rx-tl time.nd) {
    color: var(--muted);
  }

  /* 注・資料の但し書き */
  .brief-body.is-report :global(.rx-aside) {
    margin: 0 0 22px;
    padding: 2px 0 2px 14px;
    border-left: 2px solid var(--line-2);
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }

  /* この事案の核心（frontmatter insight.quote → rehype が §4 に差す） */
  .brief-body.is-report :global(.rx-key) {
    margin: 26px 0 30px;
    padding: 30px 34px 32px;
    border-radius: 12px;
    color: #ebefe6;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(168, 224, 16, 0.18), rgba(168, 224, 16, 0) 60%),
      linear-gradient(168deg, #3c443d 0%, #2f372f 58%, #272e28 100%);
  }
  .brief-body.is-report :global(.rx-key::before) {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(235, 239, 230, 0.06) 1px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .brief-body.is-report :global(.rx-key > *) {
    position: relative;
  }
  .brief-body.is-report :global(.rx-key figcaption) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.22em;
    color: var(--ok);
    margin-bottom: 12px;
  }
  .brief-body.is-report :global(.rx-key blockquote) {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(21px, 2.6vw, 27px);
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: #f3f6ec;
  }
  .brief-body.is-report :global(.rx-key blockquote::after) {
    content: "";
    display: block;
    width: 72px;
    height: 2px;
    background: var(--ok);
    margin-top: 18px;
    border-radius: 2px;
  }

  /* §5 リード */
  .brief-body.is-report :global(.rx-lead strong) {
    font-size: 17px;
  }

  /* 対策の表（md の表。状態語は span.bx-st のチップ） */
  .brief-body.is-report :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 4px 0 22px;
    font-size: 13.5px;
    line-height: 1.75;
    background: none;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }
  .brief-body.is-report :global(th) {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--muted);
    font-weight: 400;
    background: none;
    padding: 8px 12px 8px 0;
    border-top: 1px solid var(--tx);
    border-bottom: 1px solid var(--line-2);
  }
  .brief-body.is-report :global(td) {
    padding: 11px 12px 11px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    line-height: 1.75;
  }
  .brief-body.is-report :global(tbody tr:last-child td) {
    border-bottom: 1px solid var(--line);
  }
  .brief-body.is-report :global(td:first-child) {
    font-weight: 700;
    color: var(--tx);
    width: 30%;
  }
  .brief-body.is-report :global(table:has(.bx-st) td:nth-child(2)) {
    width: 110px;
  }
  .brief-body.is-report :global(.bx-st) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.6;
    padding: 2px 9px;
    border-radius: 999px;
    white-space: nowrap;
    font-weight: 400;
  }
  .brief-body.is-report :global(.bx-st::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .brief-body.is-report :global(.bx-st.no) {
    color: #a8452d;
    background: rgba(194, 84, 56, 0.09);
  }
  .brief-body.is-report :global(.bx-st.part) {
    color: var(--amber);
    background: rgba(214, 170, 30, 0.13);
  }
  .brief-body.is-report :global(.bx-st.ok) {
    color: var(--ok-ink);
    background: rgba(168, 224, 16, 0.13);
  }
  .brief-body.is-report :global(.bx-st.na) {
    color: var(--muted);
    background: #eef0ea;
  }

  /* 必要になるもの（番号つき） */
  .brief-body.is-report :global(ol.num) {
    margin: 12px 0 4px;
    padding: 0;
  }
  .brief-body.is-report :global(ol.num > li) {
    padding-left: 34px;
    margin-bottom: 14px;
  }
  .brief-body.is-report :global(ol.num > li:last-child) {
    margin-bottom: 0;
  }
  .brief-body.is-report :global(ol.num > li::before) {
    left: 0;
    top: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--slate);
    color: var(--ok);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 22px;
    text-align: center;
  }
  .brief-body.is-report :global(ol.num b) {
    color: var(--tx);
  }

  /* 点検チェックリスト */
  .brief-body.is-report :global(.bx-checklist ul) {
    margin: 0;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #dde3d2;
    border-radius: 8px;
  }
  .brief-body.is-report :global(.bx-checklist li) {
    padding-left: 30px;
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.85;
  }
  .brief-body.is-report :global(.bx-checklist li:last-child) {
    margin-bottom: 0;
  }
  .brief-body.is-report :global(.bx-checklist li::before) {
    left: 2px;
    top: 5px;
    width: 15px;
    height: 15px;
    background: #fff;
    border: 1.5px solid #8f9a83;
    border-radius: 4px;
  }

  /* 出典 */
  .brief-body.is-report :global(.rx-srcs) {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--tx);
    counter-reset: rxsrc;
  }
  .brief-body.is-report :global(.rx-srcs > li) {
    display: grid;
    grid-template-columns: 30px 88px minmax(0, 1fr);
    gap: 12px;
    padding: 11px 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
    counter-increment: rxsrc;
    font-size: 13.5px;
