---
/**
 * Lemma Critical Brief page template — used by both
 * /critical/briefs/[slug].astro (EN) and /ja/critical/briefs/[slug].astro (JA).
 *
 * Phase 1 detail redesign (mockup: Lemma_brief_detail_phase1):
 *   - Clickable hero tags (Pillar → Pillar page, categories → index ?category=)
 *   - 4-col key-facts card (BriefMetaStrip, inside BriefHero)
 *   - 2-col layout: reading column + sticky TOC sidebar w/ scrollspy
 *   - Section H2 anchor links (hover ⌗, click-to-copy URL)
 *   - Inline CTA injected after §4
 *   - Pillar-aware end CTA (BriefNextSteps, JA) — retained
 *   - Prev / Next Brief navigation (by brief_no)
 *   - Related Briefs: 6 cards, auto-derived (same category → pillar → latest),
 *     index card design
 *   - Newsletter mini banner
 *   - Citation tabs + copy (CiteBriefBox) — retained
 *
 * The markdown body stays the single source of truth; §N badges are injected
 * by the `rehype-brief-section-number` plugin and styled via `.brief-body`.
 * The sticky TOC, anchors, and inline-CTA placement are progressive
 * enhancement (inline <script> at the bottom).
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import CiteBriefBox from "../components/CiteBriefBox.astro";
import BriefHero from "../components/BriefHero.astro";
import BriefRevisionNote from "../components/BriefRevisionNote.astro";
import BriefAttackCta from "../components/BriefAttackCta.astro";
import BriefGapModule from "../components/BriefGapModule.astro";
import { getTranslations, type Locale } from "../i18n/translations";
import { getEnBriefMap } from "../data/getEnBriefMap";
import { extractTldr } from "../data/extractTldr";
import {
  categoryLabel,
  type CategorySlug,
  type PillarSlug,
} from "../data/criticalBriefs";

export interface BriefTemplateProps {
  locale: Locale;
  brief:
    | CollectionEntry<"critical-briefs">
    | CollectionEntry<"critical-briefs-en">;
}

const { locale, brief } = Astro.props as BriefTemplateProps;
const t = getTranslations(locale);
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";

type AnyBrief =
  | CollectionEntry<"critical-briefs">
  | CollectionEntry<"critical-briefs-en">;

const briefNoPad = String(brief.data.brief_no).padStart(3, "0");
const localizedTitle = isJa ? brief.data.title : brief.data.title_en;

const titleParts = localizedTitle.split(" — ");
const mainTitle = titleParts[0];
const subtitle = titleParts.length > 1 ? titleParts.slice(1).join(" — ") : "";

const briefPath = `/critical/briefs/${brief.id}/`;
const briefUrl = `https://lemma.frame00.com${base}${briefPath}`;
const ogImage = `https://lemma.frame00.com/og/critical-briefs/${locale}/${brief.id}.png`;

const { Content, headings } = await render(brief);

// First-screen gap module (Brief restructure 2026-06): renders only when all
// three sentences are authored; briefs without them are unchanged.
const gap =
  brief.data.gap_detected && brief.data.gap_missing && brief.data.gap_fix
    ? {
        detected: brief.data.gap_detected,
        missing: brief.data.gap_missing,
        fix: brief.data.gap_fix,
      }
    : null;

const showRevisionHistory = brief.data.version !== "1.0";

const PILLAR_LABELS: Record<PillarSlug, { ja: string; en: string }> = {
  "01-verifiable-origin": {
    ja: "Pillar 01 · 来歴証明",
    en: "Pillar 01 · Verifiable Origin",
  },
  "02-verifiable-ai": {
    ja: "Pillar 02 · 検証可能 AI",
    en: "Pillar 02 · Verifiable AI",
  },
  "03-agent-authority": {
    ja: "Pillar 03 · エージェント権限証明",
    en: "Pillar 03 · Agent Authority Proof",
  },
  "04-regulatory-attribute": {
    ja: "Pillar 04 · 規制属性証明",
    en: "Pillar 04 · Regulatory Attribute Proof",
  },
};
const PILLAR_PAGE_SLUG: Record<PillarSlug, string> = {
  "01-verifiable-origin": "verifiable-origin",
  "02-verifiable-ai": "verifiable-ai",
  "03-agent-authority": "agent-authority-proof",
  "04-regulatory-attribute": "regulatory-attribute-proof",
};
const PILLAR_SHORT: Record<PillarSlug, string> = {
  "01-verifiable-origin": "P1",
  "02-verifiable-ai": "P2",
  "03-agent-authority": "P3",
  "04-regulatory-attribute": "P4",
};

const pillar = brief.data.pillar as PillarSlug;
const pillarLabel = PILLAR_LABELS[pillar][isJa ? "ja" : "en"];
const pillarHref = `${base}/pillars/${PILLAR_PAGE_SLUG[pillar]}/`;

// Locale-resolved full collection (EN preferred, JA fallback) for prev/next
// and auto-derived related.
const allJaBriefs = await getCollection("critical-briefs");
const enById = isJa ? null : await getEnBriefMap();
const allLocale: ReadonlyArray<AnyBrief> = allJaBriefs.map(
  (ja) => enById?.get(ja.id) ?? ja,
);

// Prev / Next by brief_no (ascending): prev = lower number, next = higher.
const byNo = [...allLocale].sort((a, b) => a.data.brief_no - b.data.brief_no);
const selfIdx = byNo.findIndex((b) => b.id === brief.id);
const prevBrief = selfIdx > 0 ? byNo[selfIdx - 1] : null;
const nextBrief =
  selfIdx >= 0 && selfIdx < byNo.length - 1 ? byNo[selfIdx + 1] : null;

// Related: same primary category → same pillar → latest, excluding self.
const byNewest = [...allLocale].sort((a, b) => {
  const diff = b.data.published.getTime() - a.data.published.getTime();
  return diff !== 0 ? diff : b.data.brief_no - a.data.brief_no;
});
const primarySlug = brief.data.primary_category as CategorySlug;
const relatedSet = new Map<string, AnyBrief>();
const addCandidates = (pool: ReadonlyArray<AnyBrief>) => {
  for (const b of pool) {
    if (b.id === brief.id || relatedSet.has(b.id)) continue;
    if (relatedSet.size >= 6) break;
    relatedSet.set(b.id, b);
  }
};
addCandidates(byNewest.filter((b) => b.data.primary_category === primarySlug));
addCandidates(byNewest.filter((b) => b.data.pillar === pillar));
addCandidates(byNewest);
const relatedBriefs = Array.from(relatedSet.values()).slice(0, 3);

// Count of Briefs in the primary category (for the "see all N" link).
const primaryCategoryCount = allLocale.filter(
  (b) =>
    b.data.primary_category === primarySlug ||
    (b.data.secondary_categories as string[]).includes(primarySlug),
).length;
const primaryCatLabel = categoryLabel(primarySlug, locale);

function relatedCardData(b: AnyBrief) {
  const titleLoc = isJa ? b.data.title : b.data.title_en;
  const parts = titleLoc.split(" — ");
  const main = parts[0];
  const sub = parts.length > 1 ? parts.slice(1).join(" — ") : extractTldr(b.body, 120);
  return {
    href: `${base}/critical/briefs/${b.id}/`,
    no: String(b.data.brief_no).padStart(3, "0"),
    date: b.data.published.toISOString().slice(0, 10),
    title: main,
    sub,
    primaryLabel: categoryLabel(b.data.primary_category as CategorySlug, locale),
    secondaryLabels: (b.data.secondary_categories as CategorySlug[]).map((c) =>
      categoryLabel(c, locale),
    ),
  };
}

function pnCardData(b: AnyBrief) {
  const titleLoc = isJa ? b.data.title : b.data.title_en;
  return {
    href: `${base}/critical/briefs/${b.id}/`,
    no: String(b.data.brief_no).padStart(3, "0"),
    pillarShort: PILLAR_SHORT[b.data.pillar as PillarSlug],
    title: titleLoc.split(" — ")[0],
  };
}
const prevData = prevBrief ? pnCardData(prevBrief) : null;
const nextData = nextBrief ? pnCardData(nextBrief) : null;

// TOC: TL;DR + numbered §1..§8 (drop §9 distribution + brief* helper anchors).
const tldrHeading = headings.find((h) => h.depth === 2 && h.slug === "tldr");
const tocSections = headings
  .filter((h) => h.depth === 2)
  .filter((h) => h.slug !== "tldr")
  .filter((h) => !/^brief/i.test(h.slug))
  .filter((h) => h.slug !== "about-distribution")
  .map((h, i) => ({ num: i + 1, text: h.text, slug: h.slug }));

const incidentDateStr = brief.data.incident_date.toISOString().slice(0, 10);
const publishedStr = brief.data.published.toISOString().slice(0, 10);

const ogLead = (isJa ? brief.data.og_lead_ja : brief.data.og_lead_en) ?? mainTitle;
const seriesSep = isJa ? "｜" : " | ";
const pageTitle = `${ogLead}${seriesSep}Lemma Critical Brief No.${briefNoPad}`;

// Keep the <title> lean: the descriptive `mainTitle` already fills the
// SERP-visible width, so a long generic tail ("Structural Analysis of a
// Critical AI-Era Incident …") only gets truncated and invites Google to
// rewrite the title. Use the same compact series suffix as og:title.
const seoTitle = isJa
  ? `${mainTitle}｜Lemma Critical Brief No.${briefNoPad}`
  : `${mainTitle} | Lemma Critical Brief No.${briefNoPad}`;

const metaDescription = isJa
  ? `${publishedStr}公開の${mainTitle}を9セクションで構造分析。何が起きたか、なぜ検出側の強化では届かないか、事前に何を証明していれば防げたか。AI のための、信頼インフラ — Lemma Critical Brief。`
  : `Structural analysis of ${mainTitle}: what happened, why better detection doesn't close the gap, and what should have been provable beforehand. The Trust Layer for AI — Lemma Critical Brief.`;

const labels = isJa
  ? {
      briefId: `Lemma Critical Brief · No. ${briefNoPad}`,
      incidentDate: "事案日",
      published: "公開日",
      authors: "発行",
      pack: "関連 Pack",
      tocLabel: "Contents",
      tldr: "TL;DR",
      relatedHeading: "関連 Brief",
      relatedMore: `${primaryCatLabel}の全 ${primaryCategoryCount} 件を見る`,
      revisionHeading: "改訂履歴",
      home: "ホーム",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
      prevDir: "← 前の Brief",
      nextDir: "次の Brief →",
      copyToast: "URL をコピーしました",
      anchorAria: "このセクションへのリンクをコピー",
    }
  : {
      briefId: `Lemma Critical Brief · No. ${briefNoPad}`,
      incidentDate: "Incident date",
      published: "Published",
      authors: "Authors",
      pack: "Related Pack",
      tocLabel: "Contents",
      tldr: "TL;DR",
      relatedHeading: "Related Briefs",
      relatedMore: `See all ${primaryCategoryCount} in ${primaryCatLabel}`,
      revisionHeading: "Revision History",
      home: "Home",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
      prevDir: "← Previous Brief",
      nextDir: "Next Brief →",
      copyToast: "Link copied",
      anchorAria: "Copy link to this section",
    };

// ── 回遊・転換レール／モバイルバー（JA のみ・spec: brief_engagement_rail）──
const railCats = Array.from(
  new Set<CategorySlug>([
    brief.data.primary_category as CategorySlug,
    ...(brief.data.secondary_categories as CategorySlug[]),
  ]),
).slice(0, 4);
const railChips = railCats.map((slug) => ({
  label: categoryLabel(slug, locale),
  href: `${base}/critical/briefs/?category=${slug}`,
}));
const lpBase = `${base}/compare/ai-models-attack-resistance/`;
const briefsIndexHref = `${base}/critical/briefs/`;
const utmTerm = isJa ? "ja" : "en";
const demoFormId = isJa ? "EkBqDX" : "Pd2Rl5"; // Discovery Call form (JA / EN)
const railLpHref = `${lpBase}?utm_source=brief_rail&utm_medium=cta&utm_campaign=brief_to_lp&utm_term=${utmTerm}`;
const railDemoHref = `https://tally.so/r/${demoFormId}?utm_source=brief_rail&utm_medium=cta&utm_campaign=brief_to_demo`;
const barLpHref = `${lpBase}?utm_source=brief_bar&utm_medium=cta&utm_campaign=brief_to_lp&utm_term=${utmTerm}`;
const barDemoHref = `https://tally.so/r/${demoFormId}?utm_source=brief_bar&utm_medium=cta&utm_campaign=brief_to_demo`;
const railCopy = isJa
  ? {
      progress: "読了",
      explore: "カテゴリで探す",
      index: "Brief 一覧を見る",
      lp: "AI攻撃実験を見る",
      demo: "30分デモを予約",
      barIndex: "一覧",
      barLp: "攻撃実験",
      barDemo: "デモ予約",
    }
  : {
      progress: "Read",
      explore: "Explore by category",
      index: "See all Briefs",
      lp: "See the AI attack test",
      demo: "Book a 30-min demo",
      barIndex: "All",
      barLp: "Attack test",
      barDemo: "Demo",
    };
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={briefPath}
  title={seoTitle}
  ogTitle={pageTitle}
  description={metaDescription}
  ogImage={ogImage}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="brief-page">
    <div class="bd-shell">
      <div class="brief-breadcrumb">
        <a href={base || "/"}>{labels.home}</a>
        <span class="brief-breadcrumb-sep">/</span>
        <a href={`${base}/critical/briefs/`}>{labels.breadcrumbBriefs}</a>
        <span class="brief-breadcrumb-sep">/</span>
        <span>{labels.briefNoPrefix} {briefNoPad}</span>
      </div>

      <BriefHero
        locale={locale}
        brief={brief}
        labels={labels}
        mainTitle={mainTitle}
        subtitle={subtitle}
        pillarLabel={pillarLabel}
        pillarHref={pillarHref}
        base={base}
        incidentDateStr={incidentDateStr}
        publishedStr={publishedStr}
      />

      <div class="bd-layout">
        <div class="bd-content">
          {/* 第1スクリーン改修 §1: theme banner above the TL;DR (top of body). */}
          <BriefAttackCta locale={locale} base={base} slug={brief.id} placement="banner" />

          <article class="brief-body">
            <Content />
          </article>

          {/* 第1スクリーン改修 §3/§4: gap module + open-loop CTA — rendered here,
              JS-moved to just after the TL;DR by the inline script below. The
              gap module renders only when its frontmatter fields are authored. */}
          {gap && (
            <div data-firstscreen>
              <BriefGapModule
                locale={locale}
                detected={gap.detected}
                missing={gap.missing}
                fix={gap.fix}
              />
              <BriefAttackCta locale={locale} base={base} slug={brief.id} placement="loop" />
            </div>
          )}

          {/* §2 tail CTA — article-end, single path to the LP. */}
          <BriefAttackCta locale={locale} base={base} slug={brief.id} placement="tail" />
        </div>

        <aside class="bd-toc" aria-label={labels.tocLabel}>
          <div class="bd-toc__inner">
            <div class="bd-rail__progress">
              <div class="bd-rail__progress-top">
                <span class="bd-rail__progress-label">{railCopy.progress}</span>
                <span class="bd-rail__pct"><span data-rail-pct>0</span>%</span>
              </div>
              <div class="bd-rail__track"><div class="bd-rail__bar" data-rail-bar></div></div>
            </div>
            <div class="bd-toc__label">{labels.tocLabel}</div>
            <ul class="bd-toc__list">
              {tldrHeading && (
                <li>
                  <a href="#tldr" data-toc-link>
                    <span class="bd-toc__num">—</span>{labels.tldr}
                  </a>
                </li>
              )}
              {tocSections.map((s) => (
                <li>
                  <a href={`#${s.slug}`} data-toc-link>
                    <span class="bd-toc__num">§{s.num}</span>{s.text}
                  </a>
                </li>
              ))}
            </ul>
            <div class="bd-rail__block">
              <div class="bd-rail__h">{railCopy.explore}</div>
              <div class="bd-rail__chips">
                {railChips.map((c) => (
                  <a class="bd-rail__chip" href={c.href}>{c.label}</a>
                ))}
              </div>
              <a class="bd-rail__index" href={briefsIndexHref}>{railCopy.index} →</a>
            </div>
            <div class="bd-rail__block bd-rail__convert">
              <a
                class="bd-rail__cta bd-rail__cta--solid"
                href={railLpHref}
                data-brief-cta-ev="brief_rail_lp"
                data-cta="rail_lp"
              >{railCopy.lp}</a>
              <a
                class="bd-rail__cta bd-rail__cta--outline"
                href={railDemoHref}
                data-brief-cta-ev="brief_rail_demo"
                data-cta="rail_demo"
              >{railCopy.demo}</a>
            </div>
          </div>
        </aside>
      </div>

      {(prevData || nextData) && (
        <nav class="bd-prevnext" aria-label="Prev / Next Brief">
          {prevData ? (
            <a href={prevData.href} class="bd-pn prev">
              <span class="bd-pn__dir">{labels.prevDir}</span>
              <span class="bd-pn__meta">No. {prevData.no} · Pillar {prevData.pillarShort.slice(1)}</span>
              <span class="bd-pn__title">{prevData.title}</span>
            </a>
          ) : (
            <span class="bd-pn bd-pn--empty"></span>
          )}
          {nextData ? (
            <a href={nextData.href} class="bd-pn next">
              <span class="bd-pn__dir">{labels.nextDir}</span>
              <span class="bd-pn__meta">No. {nextData.no} · Pillar {nextData.pillarShort.slice(1)}</span>
              <span class="bd-pn__title">{nextData.title}</span>
            </a>
          ) : (
            <span class="bd-pn bd-pn--empty"></span>
          )}
        </nav>
      )}

      {relatedBriefs.length > 0 && (
        <section class="bd-related">
          <div class="bd-related__head">
            <div class="bd-related__tag">{labels.relatedHeading}</div>
            <a
              class="bd-related__more"
              href={`${base}/critical/briefs/?category=${primarySlug}`}
            >{labels.relatedMore}</a>
          </div>
          <div class="bd-related__grid">
            {relatedBriefs.map((b) => {
              const c = relatedCardData(b);
              return (
                <a href={c.href} class="bd-rcard">
                  <div class="bd-rcard__meta">
                    <span class="bd-rcard__no">No. {c.no}</span>
                    <span class="bd-rcard__sep">·</span>
                    <span>{c.date}</span>
                  </div>
                  <h3 class="bd-rcard__title">{c.title}</h3>
                  {c.sub && <p class="bd-rcard__sub">{c.sub}</p>}
                  <div class="bd-rcard__foot">
                    <div class="bd-rcard__tags">
                      <span class="bd-rcard__tag">{c.primaryLabel}</span>
                      {c.secondaryLabels.slice(0, 2).map((lab) => (
                        <span class="bd-rcard__tag">{lab}</span>
                      ))}
                    </div>
                    <span class="bd-rcard__read">Brief →</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* 導線 v2 §7: newsletter consolidated to the footer. Cite kept expanded. */}
      <CiteBriefBox
        locale={locale}
        briefNo={briefNoPad}
        titleForCitation={localizedTitle}
        year={brief.data.published.getFullYear()}
        briefUrl={briefUrl}
        briefSlug={brief.id}
      />

      {showRevisionHistory && (
        <BriefRevisionNote
          locale={locale}
          heading={labels.revisionHeading}
          version={brief.data.version}
        />
      )}
    </div>

    <div class="bd-toast" data-toast hidden>{labels.copyToast}</div>

    <nav class="bd-mbar" aria-label="Brief navigation">
        <div class="bd-mbar__progress" data-bar-bar></div>
        <a class="bd-mbar__btn bd-mbar__btn--ghost" href={briefsIndexHref}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <span>{railCopy.barIndex}</span>
        </a>
        <a
          class="bd-mbar__btn bd-mbar__btn--outline"
          href={barLpHref}
          data-brief-cta-ev="brief_bar_lp"
          data-cta="bar_lp"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
          <span>{railCopy.barLp}</span>
        </a>
        <a
          class="bd-mbar__btn bd-mbar__btn--solid"
          href={barDemoHref}
          data-brief-cta-ev="brief_bar_demo"
          data-cta="bar_demo"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span>{railCopy.barDemo}</span>
        </a>
    </nav>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script is:inline>
  (function () {
    var body = document.querySelector('.brief-body');
    if (!body) return;

    // Move the first-screen block (gap module + open-loop CTA) to just after
    // the TL;DR para. The theme banner now renders statically above the TL;DR.
    var firstH2 = body.querySelector(':scope > h2');
    var tldrP = null;
    if (firstH2) {
      tldrP = firstH2.nextElementSibling;
      while (tldrP && tldrP.nodeName !== 'P') tldrP = tldrP.nextElementSibling;
    }
    var fs = document.querySelector('[data-firstscreen]');
    if (fs && tldrP) tldrP.parentNode.insertBefore(fs, tldrP.nextSibling);
  })();
</script>

<!-- 回遊・転換レール／バー: 読了プログレス（本文領域基準）. -->
<script is:inline>
  (function () {
    function compute() {
      var art = document.querySelector(".brief-body");
      if (!art) return;
      var bars = document.querySelectorAll("[data-rail-bar],[data-bar-bar]");
      if (!bars.length) return;
      var y = window.scrollY || document.documentElement.scrollTop;
      var top = art.getBoundingClientRect().top + y;
      var denom = art.offsetHeight - window.innerHeight;
      var p = denom > 0 ? (y - top) / denom : (y >= top ? 1 : 0);
      p = Math.max(0, Math.min(1, p));
      var n = Math.round(p * 100);
      var pctEl = document.querySelector("[data-rail-pct]");
      if (pctEl) pctEl.textContent = n;
      for (var i = 0; i < bars.length; i++) bars[i].style.width = n + "%";
    }
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () { ticking = false; compute(); });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    document.addEventListener("astro:after-swap", compute);
    compute();
  })();
</script>

<!-- 導線 v1: forward Brief→LP/Call CTA clicks to GA4 (surface=brief_detail). -->
<script is:inline>
  (function () {
    function wire() {
      document.querySelectorAll("[data-brief-cta-ev]").forEach(function (el) {
        el.addEventListener("click", function () {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", el.getAttribute("data-brief-cta-ev"), {
            surface: "brief_detail",
            cta_label: el.getAttribute("data-cta"),
            destination: el.getAttribute("href"),
          });
        });
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wire);
    } else {
      wire();
    }
  })();
</script>

<script>
  // Sticky-TOC scrollspy + section anchor links (copy URL). Module script.
  function setupBriefChrome() {
    const body = document.querySelector(".brief-body");
    if (!body) return;

    // Scrollspy: highlight the TOC link for the section in view.
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    );
    const linkByHash = new Map(
      links.map((l) => [l.getAttribute("href") || "", l]),
    );
    const watched = Array.from(
      body.querySelectorAll<HTMLElement>("h2[id]"),
    ).filter((h) => linkByHash.has(`#${h.id}`));

    if (watched.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = (entry.target as HTMLElement).id;
            links.forEach((l) =>
              l.classList.toggle(
                "is-active",
                l.getAttribute("href") === `#${id}`,
              ),
            );
          });
        },
        { rootMargin: "-25% 0px -65% 0px" },
      );
      watched.forEach((h) => observer.observe(h));
    }

    // Section anchors: append a ⌗ link to each numbered/anchored h2.
    const toast = document.querySelector<HTMLElement>("[data-toast]");
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    const showToast = () => {
      if (!toast) return;
      toast.hidden = false;
      toast.classList.add("is-visible");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("is-visible");
        toastTimer = setTimeout(() => {
          toast.hidden = true;
        }, 250);
      }, 1600);
    };

    body.querySelectorAll<HTMLElement>("h2[id]").forEach((h) => {
      if (h.querySelector(".brief-anchor")) return;
      const a = document.createElement("a");
      a.className = "brief-anchor";
      a.href = `#${h.id}`;
      a.setAttribute("aria-label", "Copy link to this section");
      a.textContent = "⌗";
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const url = `${location.origin}${location.pathname}#${h.id}`;
        history.replaceState(null, "", `#${h.id}`);
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(showToast, () => {});
        }
      });
      h.appendChild(a);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupBriefChrome, {
      once: true,
    });
  } else {
    setupBriefChrome();
  }
</script>

