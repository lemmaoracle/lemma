---
/**
 * Lemma Critical Brief page template — used by both
 * /critical/briefs/[slug].astro (EN) and /ja/critical/briefs/[slug].astro (JA).
 *
 * v24 visual system (PR #274 mockup detail v1 baseline):
 *   - Cream page background, container-narrow 760px reading column
 *   - Sora display + Noto Sans JP body + Space Mono labels
 *   - Saddle brown accent (--accent) for tags, links, list markers, eyebrow
 *
 * Page composition, in order:
 *   1. Brand bar (240×4px brown stripe under nav)
 *   2. Breadcrumb (mono uppercase)
 *   3. Brief Hero (id eyebrow + h1 + subtitle + tag pills + 4-cell meta strip)
 *   4. Body: rendered markdown (TL;DR + §1–§8)
 *   5. Related Briefs cards (from frontmatter `related_briefs`)
 *   6. Cite this Brief box (3 tabs + copy)
 *   7. Revision History (only when frontmatter `version` !== "1.0")
 *   8. Distribution note (template-owned boilerplate, cream-deep card)
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import CiteBriefBox from "../components/CiteBriefBox.astro";
import { getTranslations, type Locale } from "../i18n/translations";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { getEnBriefMap } from "../data/getEnBriefMap";

export interface BriefTemplateProps {
  locale: Locale;
  brief:
    | CollectionEntry<"critical-briefs">
    | CollectionEntry<"critical-briefs-en">;
}

const { locale, brief } = Astro.props as BriefTemplateProps;
const t = getTranslations(locale);
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";

const briefNoPad = String(brief.data.brief_no).padStart(3, "0");
const localizedTitle = isJa ? brief.data.title : brief.data.title_en;

// Title may end with " — <subtitle>". Split for visual hierarchy in the hero.
const titleParts = localizedTitle.split(" — ");
const mainTitle = titleParts[0];
const subtitle = titleParts.length > 1 ? titleParts.slice(1).join(" — ") : "";

const briefPath = `/critical/briefs/${brief.id}/`;
const briefUrl = `https://lemma.frame00.com${base}${briefPath}`;

const { Content } = await render(brief);

const showRevisionHistory = brief.data.version !== "1.0";

const PILLAR_LABELS: Record<
  BriefTemplateProps["brief"]["data"]["pillar"],
  { ja: string; en: string }
> = {
  "01-verifiable-origin": {
    ja: "Pillar 01 · 来歴証明",
    en: "Pillar 01 · Verifiable Origin",
  },
  "02-verifiable-ai": {
    ja: "Pillar 02 · 検証可能 AI",
    en: "Pillar 02 · Verifiable AI",
  },
  "03-agent-authority": {
    ja: "Pillar 03 · エージェント権限証明",
    en: "Pillar 03 · Agent Authority Proof",
  },
  "04-regulatory-attribute": {
    ja: "Pillar 04 · 規制属性証明",
    en: "Pillar 04 · Regulatory Attribute Proof",
  },
};

const pillarLabel = PILLAR_LABELS[brief.data.pillar][isJa ? "ja" : "en"];

// Mockup meta strip splits Pack into "Pack A" main + "Incident Response" sub.
const PACK_LABELS: Record<string, { main: string; sub: { ja: string; en: string } }> = {
  "A-incident-response": {
    main: "Pack A",
    sub: { ja: "Incident Response", en: "Incident Response" },
  },
  "B-regulatory": {
    main: "Pack B",
    sub: { ja: "Regulatory", en: "Regulatory" },
  },
  "C-agent-governance": {
    main: "Pack C",
    sub: { ja: "Agent Governance", en: "Agent Governance" },
  },
};

// Related Briefs — resolve `related_briefs` slugs against whichever collection
// matches the rendering locale (EN entry if available, JA fallback).
const allJaBriefs = await getCollection("critical-briefs");
const enById = isJa ? null : await getEnBriefMap();
const relatedBriefs = brief.data.related_briefs
  .map((slug) => {
    const ja = allJaBriefs.find((b) => b.id === slug);
    if (!ja) return null;
    const enEntry = enById?.get(slug);
    return enEntry ?? ja;
  })
  .filter((b): b is NonNullable<typeof b> => b !== null);

const incidentDateStr = brief.data.incident_date.toISOString().slice(0, 10);
const publishedStr = brief.data.published.toISOString().slice(0, 10);

const pageTitle = `${mainTitle} — Lemma Critical Brief No.${briefNoPad}`;

const description = subtitle ? `${mainTitle} — ${subtitle}` : mainTitle;

const labels = isJa
  ? {
      briefSeries: "Lemma Critical Brief",
      briefId: `Lemma Critical Brief · No. ${briefNoPad}`,
      incidentDate: "事案日",
      published: "公開日",
      authors: "発行",
      pack: "関連 Pack",
      relatedHeading: "関連 Brief",
      revisionHeading: "改訂履歴",
      distributionHeading: "Brief 配布について",
      distributionBody:
        "Lemma Critical Brief は Lemma が発行する threat intelligence brief です。本資料は公開情報の構造化分析であり、特定の組織への監査・診断・推奨ではありません。意思決定の参考として用いる場合は、貴組織の Lemma Critical 担当に直接ご相談ください。",
      discoveryCallLabel: "Discovery Call",
      whitepaperLabel: "ホワイトペーパー",
      home: "ホーム",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
    }
  : {
      briefSeries: "Lemma Critical Brief",
      briefId: `Lemma Critical Brief · No. ${briefNoPad}`,
      incidentDate: "Incident date",
      published: "Published",
      authors: "Authors",
      pack: "Related Pack",
      relatedHeading: "Related Briefs",
      revisionHeading: "Revision History",
      distributionHeading: "About distribution",
      distributionBody:
        "Lemma Critical Brief is a threat intelligence brief published by Lemma. It is structured analysis of public information — not an audit, assessment, or recommendation directed at any specific organization. For decision-support use, please consult your Lemma Critical contact directly.",
      discoveryCallLabel: "Discovery Call",
      whitepaperLabel: "Whitepaper",
      home: "Home",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
    };

// Canonical Tally form for the whitepaper (single-form per Mayumi confirmation
// in PR #256 — same form ID across locales).
const whitepaperUrl = "https://tally.so/r/xX0VYv";
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={briefPath}
  title={pageTitle}
  description={description}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="brief-page">
    <div class="container-narrow">
      <div class="brief-breadcrumb">
        <a href={base || "/"}>{labels.home}</a>
        <span class="brief-breadcrumb-sep">/</span>
        <a href={`${base}/critical/briefs/`}>{labels.breadcrumbBriefs}</a>
        <span class="brief-breadcrumb-sep">/</span>
        <span>{labels.briefNoPrefix} {briefNoPad}</span>
      </div>
    </div>

    <div class="container-narrow">
      <section class="brief-hero">
        <div class="brief-id">{labels.briefId}</div>
        <h1 class="brief-h1">{mainTitle}</h1>
        {subtitle && <p class="brief-subtitle">{subtitle}</p>}

        <div class="brief-tags">
          <span class="brief-tag pillar">{pillarLabel}</span>
          <span class="brief-tag category">{brief.data.primary_category}</span>
          {brief.data.secondary_categories.map((c) => (
            <span class="brief-tag cat-secondary">{c}</span>
          ))}
        </div>

        <div class="brief-meta-strip">
          <div class="meta-cell">
            <div class="meta-label">{labels.incidentDate}</div>
            <div class="meta-value">{incidentDateStr}</div>
          </div>
          <div class="meta-cell">
            <div class="meta-label">{labels.published}</div>
            <div class="meta-value">{publishedStr}</div>
          </div>
          <div class="meta-cell">
            <div class="meta-label">{labels.authors}</div>
            <div class="meta-value">{brief.data.authors.join(", ")}</div>
          </div>
          {brief.data.related_pack.length > 0 && (
            <div class="meta-cell">
              <div class="meta-label">{labels.pack}</div>
              <div class="meta-value">
                {(() => {
                  const first = brief.data.related_pack[0];
                  const lab = PACK_LABELS[first];
                  return lab ? (
                    <>
                      {lab.main}
                      <span class="meta-sub">{lab.sub[isJa ? "ja" : "en"]}</span>
                    </>
                  ) : (
                    first
                  );
                })()}
              </div>
            </div>
          )}
        </div>
      </section>

      <article class="brief-body">
        <Content />
      </article>

      {relatedBriefs.length > 0 && (
        <div class="related-block">
          <div class="related-label">{labels.relatedHeading}</div>
          <div class="related-grid">
            {relatedBriefs.map((r) => {
              const rNo = String(r.data.brief_no).padStart(3, "0");
              const rTitle = isJa ? r.data.title : r.data.title_en;
              return (
                <a
                  href={`${base}/critical/briefs/${r.id}/`}
                  class="related-card"
                >
                  <div class="related-no">No. {rNo}</div>
                  <div class="related-title">{rTitle}</div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <CiteBriefBox
        locale={locale}
        briefNo={briefNoPad}
        titleForCitation={localizedTitle}
        year={brief.data.published.getFullYear()}
        briefUrl={briefUrl}
        briefSlug={brief.id}
      />

      {showRevisionHistory && (
        <section class="brief-revision" aria-labelledby="revision-heading">
          <div class="revision-label">{labels.revisionHeading}</div>
          <p class="revision-note">
            {isJa
              ? `現在の版: ${brief.data.version}`
              : `Current version: ${brief.data.version}`}
          </p>
        </section>
      )}

      <section class="dist-note" aria-labelledby="distribution-heading">
        <h2 id="distribution-heading" class="dist-h3">
          {labels.distributionHeading}
        </h2>
        <p class="dist-text">{labels.distributionBody}</p>
        <div class="dist-links">
          <a href={DISCOVERY_CALL_URL[locale]} target="_blank" rel="noopener">
            {labels.discoveryCallLabel} ↗
          </a>
          <a href={whitepaperUrl} target="_blank" rel="noopener">
            {labels.whitepaperLabel} ↗
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* v24 typography palette — scoped to Brief detail pages so the rest of
     the site keeps its existing Cormorant / DM Sans / Noto Serif JP setup
     while the Brief surface migrates to Sora / Noto Sans JP / Space Mono.
     Variables here override the :root display/body fonts within this
     component's tree only. */
  .brief-page {
    --brief-display: "Sora", system-ui, -apple-system, sans-serif;
    --brief-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --brief-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --brief-text-1: #1a1a1a;
    --brief-text-2: #3a3a3a;
    --brief-text-3: #5a5a5a;
    --brief-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--brief-text-2);
    font-family: var(--brief-body);
    font-weight: 400;
    line-height: 1.75;
    padding: 0 0 96px;
    margin-top: 64px; /* clear the fixed Navigation height */
  }

  /* /en/ locale — Sora is OK as a body font per mockup spec */
  :root[lang="en"] .brief-page {
    --brief-body: "Sora", system-ui, sans-serif;
  }

  .container-narrow {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── BREADCRUMB ─── */
  .brief-breadcrumb {
    font-family: var(--brief-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brief-text-4);
    padding: 36px 0 0;
  }
  .brief-breadcrumb a {
    color: var(--brief-text-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .brief-breadcrumb a:hover {
    color: var(--accent);
  }
  .brief-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── BRIEF HERO ─── */
  .brief-hero {
    padding: 32px 0 56px;
  }
  .brief-id {
    font-family: var(--brief-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brief-id::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .brief-h1 {
    font-family: var(--brief-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1.06;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.03em;
    max-width: 880px;
  }
  :root[lang="ja"] .brief-h1 {
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .brief-subtitle {
    font-family: var(--brief-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--brief-text-2);
    margin: 0 0 32px;
    letter-spacing: -0.015em;
    max-width: 760px;
  }
  .brief-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 36px;
  }
  .brief-tag {
    font-family: var(--brief-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .brief-tag.pillar {
    background: var(--accent);
    color: var(--lemma-cream);
    font-weight: 500;
  }
  .brief-tag.category {
    background: var(--lemma-brown-light);
    color: var(--accent);
  }
  .brief-tag.cat-secondary {
    background: var(--lemma-cream-deep);
    color: var(--brief-text-3);
  }

  /* ─── META STRIP ─── */
  .brief-meta-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .meta-cell {
    padding: 22px 24px;
    border-right: 0.5px solid var(--lemma-line);
  }
  .meta-cell:last-child {
    border-right: 0;
  }
  .meta-label {
    font-family: var(--brief-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brief-text-4);
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .meta-label::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }
  .meta-value {
    font-family: var(--brief-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--black);
    line-height: 1.4;
    letter-spacing: -0.005em;
    font-variant-numeric: tabular-nums;
  }
  .meta-sub {
    font-family: var(--brief-mono);
    font-size: 11px;
    color: var(--brief-text-3);
    display: block;
    margin-top: 4px;
    letter-spacing: 0.02em;
  }

  /* ─── BODY (rendered markdown) ─── */
  .brief-body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--brief-text-2);
    margin: 56px 0 0;
  }
  .brief-body :global(p) {
    margin: 0 0 18px;
  }
  .brief-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .brief-body :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  .brief-body :global(em) {
    font-style: italic;
  }
  .brief-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
    overflow-wrap: anywhere;
  }
  .brief-body :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }

  /* H2 — section headings from the markdown.
     The `rehype-brief-section-number` plugin tags each numbered h2 with
     `data-section-num="N"` and strips the "N. " prefix from the text,
     enabling the mockup's two-line "§ N" eyebrow + Sora title rendering.
     The first h2 (TL;DR) has no data-section-num and falls into the
     TL;DR card treatment block below instead. */
  .brief-body :global(h2) {
    font-family: var(--brief-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 56px 0 24px;
  }
  :root[lang="ja"] .brief-body :global(h2) {
    line-height: 1.35;
  }
  /* Numbered section eyebrow: "§ N" mono brown rendered above the h2 via
     the data-section-num attribute the rehype plugin sets. */
  .brief-body :global(h2[data-section-num])::before {
    content: "§ " attr(data-section-num);
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--brief-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .brief-body :global(h2[data-section-num])::before::before {
    /* (unused) — placeholder for an optional horizontal accent line.
       The flex layout above keeps the eyebrow tight to the h2. */
  }
  .brief-body :global(h2:first-child) {
    margin-top: 0;
  }
  .brief-body :global(h3) {
    font-family: var(--brief-display);
    font-size: 19px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.35;
    margin: 32px 0 14px;
  }

  /* ─── TL;DR special treatment via :first-of-type targeting.
     The markdown body's first h2 is "TL;DR"; we wrap it visually as the
     mockup's tldr-block (cream-deep card, brown accent bar, mono label
     style on the heading). The next siblings until the next h2 inherit
     the card via adjacent-sibling tricks. Full structural extraction
     (proper enclosing div) lands in Step 3. */
  .brief-body :global(h2:first-child) {
    font-family: var(--brief-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
    background: var(--lemma-cream-deep);
    padding: 36px 40px 0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    position: relative;
  }
  .brief-body :global(h2:first-child)::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  /* TL;DR paragraph (first h2 + p) — extend the card */
  .brief-body :global(h2:first-child + p) {
    background: var(--lemma-cream-deep);
    padding: 0 40px 32px;
    margin: 0 0 56px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--brief-text-1);
  }

  /* ─── LISTS — saddle brown diamond markers, mono brown numbered ─── */
  .brief-body :global(ul) {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .brief-body :global(ul li) {
    position: relative;
    padding-left: 22px;
    margin: 0 0 10px;
    line-height: 1.7;
  }
  .brief-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }
  .brief-body :global(ol) {
    margin: 0 0 18px;
    padding: 0 0 0 4px;
    counter-reset: brieflist;
    list-style: none;
  }
  .brief-body :global(ol li) {
    counter-increment: brieflist;
    position: relative;
    padding-left: 32px;
    margin: 0 0 14px;
    line-height: 1.7;
  }
  .brief-body :global(ol li::before) {
    content: counter(brieflist);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--brief-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
  }

  /* ─── HR (markdown section separators) — subtle line ─── */
  .brief-body :global(hr) {
    border: none;
    border-top: 0.5px solid var(--lemma-line);
    margin: 48px 0;
  }

  /* ─── TABLES (Brief 002 has one) ─── */
  .brief-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--brief-body);
    font-size: 13.5px;
    margin: 28px 0;
  }
  .brief-body :global(thead tr) {
    background: var(--lemma-cream-deep);
  }
  .brief-body :global(th) {
    padding: 12px 14px;
    font-family: var(--brief-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brief-text-3);
    text-align: left;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .brief-body :global(td) {
    padding: 12px 14px;
    border-bottom: 0.5px solid var(--lemma-line);
    color: var(--brief-text-2);
    line-height: 1.6;
    vertical-align: top;
  }

  .brief-body :global(code:not(pre code)) {
    font-family: var(--brief-mono);
    font-size: 0.86em;
    background: var(--lemma-cream-deep);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    color: var(--brief-text-1);
  }
  .brief-body :global(pre) {
    margin: 24px 0;
    padding: 18px 20px;
    background: #1a1a1a;
    color: #e8e2d4;
    border-radius: 12px;
    overflow-x: auto;
    font-family: var(--brief-mono);
    font-size: 12.5px;
    line-height: 1.75;
  }
  .brief-body :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  /* ─── RELATED BRIEFS ─── */
  .related-block {
    margin: 80px 0 0;
    padding: 56px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .related-label {
    font-family: var(--brief-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--brief-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
