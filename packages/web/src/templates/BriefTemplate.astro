---
/**
 * Lemma Critical Brief page template — used by both
 * /critical/briefs/[slug].astro (EN) and /ja/critical/briefs/[slug].astro (JA).
 *
 * v24 visual system (PR #274 mockup detail v1 baseline):
 *   - Cream page background, container-narrow 760px reading column
 *   - Sora display + Noto Sans JP body + Space Mono labels
 *   - Saddle brown accent (--accent) for tags, links, list markers, eyebrow
 *
 * Page composition, in order:
 *   1. Breadcrumb (mono uppercase)
 *   2. BriefHero (id eyebrow + h1 + subtitle + tag pills + meta strip)
 *   3. Body: rendered markdown (TL;DR + §1–§8; §N badges injected by the
 *      `rehype-brief-section-number` plugin and styled via the .brief-body
 *      block below)
 *   4. BriefRelated (cards from frontmatter `related_briefs`)
 *   5. CiteBriefBox (3 tabs + copy)
 *   6. BriefRevisionNote (only when frontmatter `version` !== "1.0")
 *   7. BriefDistNote (template-owned boilerplate, cream-deep card)
 *
 * Composition uses Brief* components in src/components for the chrome.
 * Markdown body styling — TL;DR card, §N badges, lists, tables, sources —
 * is encoded as CSS in this template against the rendered `<Content />`
 * tree; the markdown stays the single source of truth.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import CiteBriefBox from "../components/CiteBriefBox.astro";
import BriefHero from "../components/BriefHero.astro";
import BriefNextSteps from "../components/BriefNextSteps.astro";
import BriefRelated from "../components/BriefRelated.astro";
import BriefToc from "../components/BriefToc.astro";
import BriefDistNote from "../components/BriefDistNote.astro";
import BriefRevisionNote from "../components/BriefRevisionNote.astro";
import { getTranslations, type Locale } from "../i18n/translations";
import { getEnBriefMap } from "../data/getEnBriefMap";

export interface BriefTemplateProps {
  locale: Locale;
  brief:
    | CollectionEntry<"critical-briefs">
    | CollectionEntry<"critical-briefs-en">;
}

const { locale, brief } = Astro.props as BriefTemplateProps;
const t = getTranslations(locale);
const isJa = locale === "ja";
const base = isJa ? "/ja" : "";

const briefNoPad = String(brief.data.brief_no).padStart(3, "0");
const localizedTitle = isJa ? brief.data.title : brief.data.title_en;

// Title may end with " — <subtitle>". Split for visual hierarchy in the hero.
const titleParts = localizedTitle.split(" — ");
const mainTitle = titleParts[0];
const subtitle = titleParts.length > 1 ? titleParts.slice(1).join(" — ") : "";

const briefPath = `/critical/briefs/${brief.id}/`;
const briefUrl = `https://lemma.frame00.com${base}${briefPath}`;

const { Content, headings } = await render(brief);

const showRevisionHistory = brief.data.version !== "1.0";

const PILLAR_LABELS: Record<
  BriefTemplateProps["brief"]["data"]["pillar"],
  { ja: string; en: string }
> = {
  "01-verifiable-origin": {
    ja: "Pillar 01 · 来歴証明",
    en: "Pillar 01 · Verifiable Origin",
  },
  "02-verifiable-ai": {
    ja: "Pillar 02 · 検証可能 AI",
    en: "Pillar 02 · Verifiable AI",
  },
  "03-agent-authority": {
    ja: "Pillar 03 · エージェント権限証明",
    en: "Pillar 03 · Agent Authority Proof",
  },
  "04-regulatory-attribute": {
    ja: "Pillar 04 · 規制属性証明",
    en: "Pillar 04 · Regulatory Attribute Proof",
  },
};

const pillarLabel = PILLAR_LABELS[brief.data.pillar][isJa ? "ja" : "en"];

// Related Briefs — resolve frontmatter slugs against the locale collection,
// EN entry preferred, JA fallback for untranslated.
const allJaBriefs = await getCollection("critical-briefs");
const enById = isJa ? null : await getEnBriefMap();
const relatedBriefs = brief.data.related_briefs
  .map((slug) => {
    const ja = allJaBriefs.find((b) => b.id === slug);
    if (!ja) return null;
    const enEntry = enById?.get(slug);
    return enEntry ?? ja;
  })
  .filter((b): b is NonNullable<typeof b> => b !== null);

const incidentDateStr = brief.data.incident_date.toISOString().slice(0, 10);
const publishedStr = brief.data.published.toISOString().slice(0, 10);

const pageTitle = `${mainTitle} — Lemma Critical Brief No.${briefNoPad}`;
const description = subtitle ? `${mainTitle} — ${subtitle}` : mainTitle;

const labels = isJa
  ? {
      briefId: `Lemma Critical Brief · No. ${briefNoPad}`,
      incidentDate: "事案日",
      published: "公開日",
      authors: "発行",
      pack: "関連 Pack",
      relatedHeading: "関連 Brief",
      revisionHeading: "改訂履歴",
      distributionHeading: "Brief 配布について",
      distributionBody:
        "Lemma Critical Brief は Lemma が発行する threat intelligence brief です。本資料は公開情報の構造化分析であり、特定の組織への監査・診断・推奨ではありません。意思決定の参考として用いる場合は、貴組織の Lemma Critical 担当に直接ご相談ください。",
      discoveryCallLabel: "Discovery Call",
      whitepaperLabel: "ホワイトペーパー",
      home: "ホーム",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
    }
  : {
      briefId: `Lemma Critical Brief · No. ${briefNoPad}`,
      incidentDate: "Incident date",
      published: "Published",
      authors: "Authors",
      pack: "Related Pack",
      relatedHeading: "Related Briefs",
      revisionHeading: "Revision History",
      distributionHeading: "About distribution",
      distributionBody:
        "Lemma Critical Brief is a threat intelligence brief published by Lemma. It is structured analysis of public information — not an audit, assessment, or recommendation directed at any specific organization. For decision-support use, please consult your Lemma Critical contact directly.",
      discoveryCallLabel: "Discovery Call",
      whitepaperLabel: "Whitepaper",
      home: "Home",
      breadcrumbBriefs: "Critical Brief",
      briefNoPrefix: "No.",
    };
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={briefPath}
  title={pageTitle}
  description={description}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="brief-page">
    <div class="container-narrow">
      <div class="brief-breadcrumb">
        <a href={base || "/"}>{labels.home}</a>
        <span class="brief-breadcrumb-sep">/</span>
        <a href={`${base}/critical/briefs/`}>{labels.breadcrumbBriefs}</a>
        <span class="brief-breadcrumb-sep">/</span>
        <span>{labels.briefNoPrefix} {briefNoPad}</span>
      </div>
    </div>

    <div class="container-narrow">
      <BriefHero
        locale={locale}
        brief={brief}
        labels={labels}
        mainTitle={mainTitle}
        subtitle={subtitle}
        pillarLabel={pillarLabel}
        incidentDateStr={incidentDateStr}
        publishedStr={publishedStr}
      />

      <BriefToc locale={locale} headings={headings} />

      <article class="brief-body">
        <Content />
      </article>

      {isJa && (
        <BriefNextSteps
          pillar={brief.data.pillar}
          briefId={brief.id}
          base={base}
        />
      )}

      <BriefRelated
        locale={locale}
        base={base}
        heading={labels.relatedHeading}
        briefs={relatedBriefs}
      />

      <CiteBriefBox
        locale={locale}
        briefNo={briefNoPad}
        titleForCitation={localizedTitle}
        year={brief.data.published.getFullYear()}
        briefUrl={briefUrl}
        briefSlug={brief.id}
      />

      {showRevisionHistory && (
        <BriefRevisionNote
          locale={locale}
          heading={labels.revisionHeading}
          version={brief.data.version}
        />
      )}

      <BriefDistNote
        locale={locale}
        labels={{
          heading: labels.distributionHeading,
          body: labels.distributionBody,
          discoveryCallLabel: labels.discoveryCallLabel,
          whitepaperLabel: labels.whitepaperLabel,
        }}
      />
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* v24 typography palette — scoped to Brief detail pages. The rest of the
     site keeps its existing fonts (Cormorant / DM Sans / Noto Serif JP)
     while the Brief surface uses Sora / Noto Sans JP / Space Mono. */
  .brief-page {
    --brief-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --brief-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --brief-display: "Sora", system-ui, sans-serif;
    --brief-text-1: #1a1a1a;
    --brief-text-2: #3a3a3a;
    --brief-text-3: #5a5a5a;
    --brief-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--brief-text-2);
    font-family: var(--brief-body);
    font-weight: 400;
    line-height: 1.75;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .brief-page {
    --brief-body: "Sora", system-ui, sans-serif;
  }

  .container-narrow {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── BREADCRUMB ─── */
  .brief-breadcrumb {
    font-family: var(--brief-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brief-text-4);
    padding: 36px 0 0;
  }
  .brief-breadcrumb a {
    color: var(--brief-text-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .brief-breadcrumb a:hover {
    color: var(--accent);
  }
  .brief-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── BODY (rendered markdown) ─── */
  .brief-body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--brief-text-2);
    margin: 56px 0 0;
  }
  .brief-body :global(p) {
    margin: 0 0 18px;
  }
  .brief-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .brief-body :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  .brief-body :global(em) {
    font-style: italic;
  }
  .brief-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
    overflow-wrap: anywhere;
  }
  .brief-body :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }

  /* H2 — section headings. The rehype-brief-section-number plugin tags each
     numbered h2 with data-section-num="N" and strips the "N. " prefix; the
     CSS below renders the "§ N" mono brown eyebrow via attr(). The first
     h2 (TL;DR) has no data-section-num and falls into the TL;DR card
     treatment below. */
  .brief-body :global(h2) {
    font-family: var(--brief-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 56px 0 24px;
  }
  :root[lang="ja"] .brief-body :global(h2) {
    line-height: 1.35;
  }
  .brief-body :global(h2[data-section-num])::before {
    content: "§ " attr(data-section-num);
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--brief-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .brief-body :global(h2:first-child) {
    margin-top: 0;
  }
  .brief-body :global(h3) {
    font-family: var(--brief-display);
    font-size: 19px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.35;
    margin: 32px 0 14px;
  }

  /* ─── TL;DR card via first-child targeting ─── */
  .brief-body :global(h2:first-child) {
    font-family: var(--brief-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
    background: var(--lemma-cream-deep);
    padding: 36px 40px 16px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    position: relative;
  }
  .brief-body :global(h2:first-child)::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .brief-body :global(h2:first-child + p) {
    background: var(--lemma-cream-deep);
    padding: 0 40px 32px;
    margin: 0 0 56px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--brief-text-1);
  }

  /* ─── LISTS — saddle brown diamond markers, mono brown numbered ─── */
  .brief-body :global(ul) {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .brief-body :global(ul li) {
    position: relative;
    padding-left: 22px;
    margin: 0 0 10px;
    line-height: 1.7;
  }
  .brief-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 4px;
    top: 12px;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }
  .brief-body :global(ol) {
    margin: 0 0 18px;
    padding: 0 0 0 4px;
    counter-reset: brieflist;
    list-style: none;
  }
  .brief-body :global(ol li) {
    counter-increment: brieflist;
    position: relative;
    padding-left: 32px;
    margin: 0 0 14px;
    line-height: 1.7;
  }
  .brief-body :global(ol li::before) {
    content: counter(brieflist);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--brief-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
  }

  /* ─── HR (markdown section separators) ─── */
  .brief-body :global(hr) {
    border: none;
    border-top: 0.5px solid var(--lemma-line);
    margin: 48px 0;
  }

  /* ─── TABLES (Brief 002 has one) ─── */
  .brief-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--brief-body);
    font-size: 13.5px;
    margin: 28px 0;
  }
  .brief-body :global(thead tr) {
    background: var(--lemma-cream-deep);
  }
  .brief-body :global(th) {
    padding: 12px 14px;
    font-family: var(--brief-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brief-text-3);
    text-align: left;
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .brief-body :global(td) {
    padding: 12px 14px;
    border-bottom: 0.5px solid var(--lemma-line);
    color: var(--brief-text-2);
    line-height: 1.6;
    vertical-align: top;
  }

  .brief-body :global(code:not(pre code)) {
    font-family: var(--brief-mono);
    font-size: 0.86em;
    background: var(--lemma-cream-deep);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    color: var(--brief-text-1);
  }
  .brief-body :global(pre) {
    margin: 24px 0;
    padding: 18px 20px;
    background: #1a1a1a;
    color: #e8e2d4;
    border-radius: 12px;
    overflow-x: auto;
    font-family: var(--brief-mono);
    font-size: 12.5px;
    line-height: 1.75;
  }
  .brief-body :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 760px) {
    .brief-page {
      /* The 64px desktop gap-after-nav reads as wasted scroll on a phone;
         shrink to a single breath-line so the breadcrumb sits near the
         top fold. */
      margin-top: 8px;
    }
    .brief-breadcrumb {
      padding: 16px 0 0;
    }
    .container-narrow {
      padding: 0 24px;
    }
    .brief-body :global(h2) {
      font-size: 24px;
    }
    .brief-body :global(h2:first-child) {
      padding: 28px 24px 16px;
    }
    .brief-body :global(h2:first-child + p) {
      padding: 0 24px 24px;
    }
  }
</style>
