---
/**
 * Industry detail — v1 (業界ページ).
 *
 * Renders the site chrome (Layout + Navigation + Footer) around a per-industry
 * body fragment (config/industriesV1.ts), injected inside `<main class="indv1">`.
 * Shared, namespaced styles come from `styles/industry-v1.css`.
 * Fragments are ported from the approved mockups (lemma_業界ページ_モック, 2026-08-02).
 */
import type { Locale, Translations } from "../i18n/translations";
import type { IndustryEntry } from "../config/industriesV1";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { getCollection } from "astro:content";
import { getAllPosts } from "../data/blog";
import { resolveCoverImage } from "../lib/coverPhoto";
import { coverArtwork, COVER_WIDTH, COVER_HEIGHT } from "../lib/blogCover";
import { CATEGORY_LABELS } from "../data/criticalBriefs";
import { briefCardSvg } from "../lib/briefCover";
import "../styles/industry-v1.css";

export interface IndustryDetailV1Props {
  locale: Locale;
  t: Translations;
  base: string;
  entry: IndustryEntry;
}

const { locale, t, base, entry } = Astro.props as IndustryDetailV1Props;

const metaTitle = `${entry.name}のユースケース — ${entry.h1} | Lemma`;

/* ── Latest news 枠の実データ化（Latest news 出し分け設計 v1 §4.2）──
 * config/industry-v1/*.ja.html の「06 — Latest news」節はモック由来の
 * 静的プレースホルダ（リンク #・手打ち日付・仮カバー）のため、注入前に
 * ここで実データへ置換する。
 *   枠1: 導入事例 — `tags: case-study` を持つ記事の最新1本（全業界に同じ
 *        1本を出す）。事例が1本も無ければ従来どおり「近日公開」を維持する
 *   枠2: **この業界に割り当てた脅威タイプ**に一致する Critical Brief の
 *        最新1本（自動 — 毎週の鮮度はここが担う）。割り当ての正本は
 *        同ページ「03 — Threat cases」の脅威ラベル（class="g"）で、
 *        ここから機械導出する。03 節のラベルを変えれば枠2の対象も追随
 *        し、対応表の二重管理は生まれない。一致ゼロなら全体最新へ
 *        フォールバック（枠を空けない）
 *   枠3: **この業界の** audience:business ブログ最新1本（frontmatter の
 *        `industries` で判定・写真カバー対応・自動）。業界一致が無ければ
 *        business 全体の最新へフォールバック
 */
const esc = (s: string): string =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
/* 行数の制御は CSS の line-clamp（2行）に任せ、ここは極端に長い値を切るだけの
 * 安全網にする。短く切りすぎると CSS 側で畳む前に文字が尽きて、カードごとに
 * 行数がばらつく原因になる。 */
const clip = (s: string, n: number): string => (s.length > n ? `${s.slice(0, n)}…` : s);

/* 枠3: この業界の記事（frontmatter `industries` に自 slug を含む）の最新1本。
 * 無い業界は business 全体の最新へフォールバックし、枠を空けない（設計 v1 §5）。 */
const bizPosts = (await getAllPosts(locale))
  .filter((p) => p.audience === "business")
  .sort((a, b) => (a.date > b.date ? -1 : 1));

/* 枠1: 導入事例（`tags: case-study`）の最新1本。無ければ「近日公開」のまま
 * （下の newsHtml 参照）。
 *
 * 業界では絞らない。MizuDAkO は上下水道の話に見えて、実際は「住民の活動記録に
 * 個人情報を出さずに証明を付ける」という事例で、どの業界の読者にも通じる
 * （作者判断 2026-08-05）。業界別の事例が増えて出し分けが要るようになったら、
 * `industries` で絞る条件をここへ戻す。 */
const caseStudy = bizPosts.find((p) => p.tags?.includes("case-study") ?? false);

/* 枠3 は枠1 と同じ記事を出さない（同一ページに2枚並ぶと枠が死ぬ）。導入事例も
 * audience:business なので、除外しないと業界一致の最新として再登場する。 */
const readingPool = bizPosts.filter((p) => p.slug !== caseStudy?.slug);
const bizPost =
  readingPool.find((p) => p.industries?.includes(entry.slug)) ?? readingPool[0];

/* 03 節の脅威ラベル（JA 表示名）→ カテゴリキーへ逆引きし、この業界の
 * 割り当て集合を作る。ラベルは data/criticalBriefs.ts の CATEGORY_LABELS
 * が正本なので、表記が揺れると build 時に警告を出して検知する。 */
const labelToKey = new Map(
  Object.entries(CATEGORY_LABELS).map(([key, l]) => [l.ja, key]),
);
const assignedLabels = [...entry.body.matchAll(/class="g">([^<]+)</g)].map((m) =>
  m[1].trim(),
);
const industryThreatKeys = new Set(
  assignedLabels
    .map((l) => {
      const key = labelToKey.get(l);
      if (!key) console.warn(`[industry:${entry.slug}] 未知の脅威ラベル「${l}」— CATEGORY_LABELS と不一致`);
      return key;
    })
    .filter((k): k is string => Boolean(k)),
);

const briefsDesc = (await getCollection("critical-briefs")).sort(
  (a, b) => (b.data.brief_no ?? 0) - (a.data.brief_no ?? 0),
);
/* 一致は **primary を優先**する。secondary は「その事案にも関係する」程度の
 * 弱い印で、これを primary と同列に扱うと業界と無関係な事案が枠に出る——
 * 実際、BonkDAO のガバナンス事案（primary=ブリッジ信頼設定）が secondary の
 * 「認証・認可」だけで小売の枠に出ていた。
 *   1) primary が業界の脅威タイプに一致する最新1本
 *   2) 無ければ secondary 一致の最新1本
 *   3) それも無ければ全体最新（枠を空けない） */
const matchesPrimary = (b: (typeof briefsDesc)[number]): boolean =>
  industryThreatKeys.has(b.data.primary_category);
const matchesSecondary = (b: (typeof briefsDesc)[number]): boolean =>
  (b.data.secondary_categories ?? []).some((c: string) => industryThreatKeys.has(c));
const latestBrief =
  (industryThreatKeys.size > 0
    ? (briefsDesc.find(matchesPrimary) ?? briefsDesc.find(matchesSecondary))
    : undefined) ?? briefsDesc[0];

let body = entry.body;
if (bizPost && latestBrief) {
  const photo = resolveCoverImage(bizPost);
  const blogCover = photo
    ? `<span class="nc-photo"><img src="${photo}" alt="" loading="lazy"/></span>`
    : `<svg viewBox="0 0 ${COVER_WIDTH} ${COVER_HEIGHT}" preserveAspectRatio="xMidYMid slice" aria-hidden="true">${coverArtwork(bizPost.category, bizPost.slug)}</svg>`;
  const briefSlug = latestBrief.id.replace(/\.md$/, "");
  const briefNo = String(latestBrief.data.brief_no).padStart(3, "0");
  const d = latestBrief.data.published as unknown as Date;
  const briefDate =
    d instanceof Date
      ? `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, "0")}.${String(d.getUTCDate()).padStart(2, "0")}`
      : String(latestBrief.data.published ?? "");
  /* 枠2のカバー（C-3 カード用プリセット）。主役は番号——360px 幅で確実に
     読めるのはこれだけ。チップ側は「事案分析」にして語の重複を避ける（D）。 */
  const briefThreat =
    CATEGORY_LABELS[latestBrief.data.primary_category as keyof typeof CATEGORY_LABELS]?.[locale] ?? "";
  const briefCover = briefCardSvg({
    no: briefNo,
    threat: briefThreat,
    locale: locale === "ja" ? "ja" : "en",
    key: `${entry.slug}-${briefSlug}`,
  });
  /* 枠1。事例があればカード、無ければ従来の「近日公開」。カバーの扱いは
     枠3 と同じ（写真が実在すれば写真、無ければカテゴリ由来の抽象パターン）。 */
  const csPhoto = caseStudy ? resolveCoverImage(caseStudy) : undefined;
  const caseStudyHtml = caseStudy
    ? `<a class="newscard" href="${base}/blog/${caseStudy.slug}">
        <div class="cover">${
          csPhoto
            ? `<span class="nc-photo"><img src="${csPhoto}" alt="" loading="lazy"/></span>`
            : `<svg viewBox="0 0 ${COVER_WIDTH} ${COVER_HEIGHT}" preserveAspectRatio="xMidYMid slice" aria-hidden="true">${coverArtwork(caseStudy.category, caseStudy.slug)}</svg>`
        }</div>
        <span class="meta"><em class="ja">導入事例</em><span>${caseStudy.date}</span></span>
        <span class="t">${esc(clip(caseStudy.title, 90))}</span>
      </a>`
    : `<span class="newscard">
        <div class="cover"><div class="cl"><em>導入事例</em>近日公開</div></div>
        <span class="meta"><em>導入事例</em><span>近日公開</span></span>
        <span class="t">導入事例の公開を準備しています</span>
      </span>`;
  const newsHtml = `<!-- Latest news -->
  <section class="isec band alt">
    <div class="isec-h"><span>06 — Latest news</span><b>導入と、この領域の動き</b></div>
    <div class="newsgrid">
      ${caseStudyHtml}
      <a class="newscard" href="${base}/critical/briefs/${briefSlug}/">
        <div class="cover">${briefCover}</div>
        <span class="meta"><em class="ja">事案分析</em><span>${briefDate}</span></span>
        <span class="t">${esc(clip(latestBrief.data.title, 90))}</span>
      </a>
      <a class="newscard" href="${base}/blog/${bizPost.slug}">
        <div class="cover">${blogCover}</div>
        <span class="meta"><em>ブログ</em><span>${bizPost.date}</span></span>
        <span class="t">${esc(clip(bizPost.title, 90))}</span>
      </a>
    </div>
    <p class="hiwfoot"><a href="${base}/blog">ブログをすべて見る →</a></p>
  </section>`;
  body = body.replace(/<!-- Latest news -->[\s\S]*?<\/section>/, newsHtml);
}
---

<Layout
  locale={locale}
  title={metaTitle}
  description={entry.description}
  metaType="page"
  pagePath={`/solutions/use-cases/${entry.slug}/`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="indv1" set:html={body} />
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>
