<script is:inline>
  // ─── Accordion toggle ───
  document.querySelectorAll("[data-faq-item]").forEach(function (item) {
    var btn = item.querySelector(".fq-q");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var isOpen = item.getAttribute("data-faq-open") === "true";
      // Close siblings in the same section
      var section = item.closest("[data-section]");
      if (section) {
        section.querySelectorAll("[data-faq-item]").forEach(function (sib) {
          if (sib !== item) {
            sib.setAttribute("data-faq-open", "false");
            var sibBtn = sib.querySelector(".fq-q");
            if (sibBtn) sibBtn.setAttribute("aria-expanded", "false");
          }
        });
      }
      item.setAttribute("data-faq-open", String(!isOpen));
      btn.setAttribute("aria-expanded", String(!isOpen));
    });
  });

  // ─── Sticky jump-nav scroll spy ───
  (function () {
    var pills = document.querySelectorAll(".fq-jump-pill");
    var sections = document.querySelectorAll("[data-section]");
    if (!pills.length || !sections.length) return;

    var spy = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var id = e.target.getAttribute("id");
          pills.forEach(function (p) {
            p.classList.toggle(
              "is-active",
              p.getAttribute("data-jump-target") === id,
            );
          });
        });
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    sections.forEach(function (s) {
      spy.observe(s);
    });
  })();

  // ─── Client-side search ───
  (function () {
    var input = document.querySelector("[data-faq-search]");
    if (!input) return;
    var items = document.querySelectorAll("[data-faq-item]");
    var sections = document.querySelectorAll("[data-section]");
    var empty = document.querySelector("[data-faq-empty]");

    input.addEventListener("input", function () {
      var q = input.value.trim().toLowerCase();
      var anyVisible = false;
      items.forEach(function (it) {
        var qText = it.getAttribute("data-faq-q") || "";
        var match = !q || qText.indexOf(q) !== -1;
        if (match) {
          it.removeAttribute("hidden");
          anyVisible = true;
        } else {
          it.setAttribute("hidden", "");
        }
      });
      sections.forEach(function (sec) {
        var visibleItems = sec.querySelectorAll(
          "[data-faq-item]:not([hidden])",
        );
        sec.style.display = visibleItems.length ? "" : "none";
      });
      if (empty) {
        if (q && !anyVisible) empty.removeAttribute("hidden");
        else empty.setAttribute("hidden", "");
      }
    });
  })();
</script>
