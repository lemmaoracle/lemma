---
/**
 * Lemma FAQ — v24 chrome + content refresh per the Mayumi proposal.
 *
 * New surface elements beyond the v24 token migration:
 *
 *   - Intent router: 6 cards above the FAQ proper that route by reader
 *     intent. The last card (Critical Brief) carries an "upper tier"
 *     badge + brown rule accent and is rendered last so it does not
 *     compete with foundational links above it
 *
 *   - Per-Q pillar chip dots (P1 teal / P2 purple / P3 amber / P4 blue)
 *     as a silent visual hint next to the question text
 *
 *   - Sticky jump nav (mono pill row, horizontal scroll on mobile),
 *     with scroll-spy that highlights the current section
 *
 *   - Client-side search box that filters the Q text of each item
 *     (case-insensitive substring), and toggles empty-state messaging
 *
 *   - Critical Brief surface block at the bottom — isolated from the
 *     accordion Q&A, with the "upper tier" badge and routing to the
 *     /critical/briefs/ list + methodology
 *
 * Accordion behavior: first item in each section is open by default;
 * others closed. Items use `<button aria-expanded>` for a11y. JSON-LD
 * FAQPage structured data is preserved and now built from the new
 * sections shape.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface FaqTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as FaqTemplateProps;
const fq = t.faq;
const cta = t.ctaSection;
const whitepaperUrl =
  locale === "ja" ? "https://tally.so/r/xX0VYv" : "https://tally.so/r/7RJXdR";
const discoveryCallUrl = DISCOVERY_CALL_URL[locale];
const relatedLabel = locale === "ja" ? "関連" : "Related";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: fq.sections.flatMap((section) =>
    section.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a.replace(/<[^>]*>/g, ""),
      },
    })),
  ),
};
---

<Layout
  locale={locale}
  title={fq.metaTitle}
  description={fq.metaDescription}
  metaType="page"
  pagePath="/faq/"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqJsonLd)}
  />
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="fq-page">
    <div class="fq-container">
      <section class="fq-hero">
        <div class="fq-eyebrow">{fq.hero.tag}</div>
        <h1 class="fq-h1" set:html={fq.hero.h1.replace(/(.+?) — (.+)/, "$1—<br />$2")}></h1>
        <p class="fq-hero-sub">{fq.hero.p}</p>
      </section>

      <!-- Intent router -->
      <section class="fq-router" aria-label={fq.intentRouter.label}>
        <div class="fq-router-label">{fq.intentRouter.label}</div>
        <div class="fq-router-grid">
          {fq.intentRouter.items.map((item) => (
            <a
              href={item.href}
              class={`fq-router-card${item.isUpperTier ? " fq-router-card-upper" : ""}`}
            >
              {item.isUpperTier && (
                <span class="fq-router-badge">
                  {fq.intentRouter.upperTierBadge}
                </span>
              )}
              <div class="fq-router-title">{item.title}</div>
              <div class="fq-router-desc">{item.desc}</div>
              <span class="fq-router-arrow">→</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Sticky jump nav -->
      <nav class="fq-jump" aria-label={fq.sidebar.title}>
        <div class="fq-jump-inner">
          {fq.sections.map((section, i) => (
            <a
              href={`#${section.id}`}
              class={`fq-jump-pill${i === 0 ? " is-active" : ""}`}
              data-jump-target={section.id}
            >
              {fq.sidebar.links[i] ?? section.title}
            </a>
          ))}
        </div>
      </nav>

      <!-- Search -->
      <div class="fq-controls">
        <div class="fq-search">
          <label class="fq-search-label" for="fq-search-input">
            {fq.searchPlaceholder}
          </label>
          <input
            id="fq-search-input"
            class="fq-search-input"
            type="search"
            placeholder={fq.searchPlaceholder}
            autocomplete="off"
            data-faq-search
          />
        </div>
      </div>

      <!-- FAQ content -->
      <div class="fq-content">
        {fq.sections.map((section) => (
          <section class="fq-section" id={section.id} data-section>
            <div class="fq-section-label">{section.title}</div>
            {section.items.map((item, ii) => (
              <div
                class="fq-item"
                data-faq-item
                data-faq-q={item.q.toLowerCase()}
                data-faq-open={ii === 0 ? "true" : "false"}
              >
                <button
                  class="fq-q"
                  type="button"
                  aria-expanded={ii === 0 ? "true" : "false"}
                >
                  <span class="fq-q-row">
                    {item.pillar && (
                      <span class={`fq-q-chip fq-chip-${item.pillar}`} aria-hidden="true"></span>
                    )}
                    <span class="fq-q-text">{item.q}</span>
                  </span>
                  <span class="fq-icon" aria-hidden="true">+</span>
                </button>
                <div class="fq-a">
                  <p set:html={item.a}></p>
                  {item.links && item.links.length > 0 && (
                    <div class="fq-a-links">
                      <span class="fq-a-links-label">{relatedLabel}</span>
                      {item.links.map((link) => (
                        <a
                          href={link.href}
                          class="fq-a-link"
                          target={link.href.startsWith("http") ? "_blank" : undefined}
                          rel={link.href.startsWith("http") ? "noopener" : undefined}
                        >
                          {link.label} →
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </section>
        ))}

        <div class="fq-no-results" data-faq-empty hidden>
          {fq.noResultsText}
        </div>
      </div>

      <!-- Comparison table -->
      <section class="fq-comparison">
        <h2 class="fq-comparison-h2">{fq.comparison.h2}</h2>
        <div class="fq-table-wrap">
          <table class="fq-table">
            <thead>
              <tr>
                {fq.comparison.headers.map((h) => <th>{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {fq.comparison.rows.map((row, i) => (
                <tr class={fq.comparison.highlightRows?.includes(i) ? "fq-highlight" : ""}>
                  {row.map((cell) => <td><strong>{cell}</strong></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Critical Brief surface block (isolated, upper-tier) -->
      <section class="fq-brief-block" aria-label={fq.criticalBriefBlock.label}>
        <div class="fq-brief-badge">{fq.criticalBriefBlock.badge}</div>
        <div class="fq-brief-label">{fq.criticalBriefBlock.label}</div>
        <h2 class="fq-brief-h2">{fq.criticalBriefBlock.h2}</h2>
        <p class="fq-brief-body">{fq.criticalBriefBlock.body}</p>
        <div class="fq-brief-cta">
          {fq.criticalBriefBlock.cta.map((c) => (
            <a class="fq-brief-link" href={c.href}>{c.label}</a>
          ))}
        </div>
      </section>

      <!-- Partner CTA — inline v24 card (replaces the v22 CtaSection) -->
      <section class="fq-partner" aria-label={cta.finalTag}>
        <div class="fq-partner-eyebrow">{cta.finalTag}</div>
        <h2 class="fq-partner-h2">
          <span set:html={cta.finalH2}></span>
          <em>{cta.finalH2Em}</em>
        </h2>
        <p class="fq-partner-body" set:html={cta.finalP}></p>
        <div class="fq-partner-cta">
          <a
            class="fq-partner-primary"
            href={discoveryCallUrl}
            target={discoveryCallUrl.startsWith("http") ? "_blank" : undefined}
            rel={discoveryCallUrl.startsWith("http") ? "noopener" : undefined}
          >
            {cta.finalCtaText}
          </a>
          <a
            class="fq-partner-secondary"
            href={whitepaperUrl}
            target="_blank"
            rel="noopener"
          >
            {cta.finalWpText}
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .fq-page {
    /* 新DS移行: アクセントをブラウン→オリーブ系へ (製品ページ移行 v2.1 追補) */
    --accent: #4e7a00;
    --accent-lt: #6f9c00;

    --fq-display: var(--font-display);
    --fq-body: "Noto Sans JP", system-ui, sans-serif;
    --fq-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --fq-text-1: #1a1a1a;
    --fq-text-2: #3a3a3a;
    --fq-text-3: #5a5a5a;
    --fq-text-4: #9a9a9a;

    /* Pillar colors per Mayumi spec */
    --fq-p1: #14b8a6; /* teal */
    --fq-p1-soft: #ccfbf1;
    --fq-p2: #8b5cf6; /* purple */
    --fq-p2-soft: #ede9fe;
    --fq-p3: #f59e0b; /* amber */
    --fq-p3-soft: #fef3c7;
    --fq-p4: #3b82f6; /* blue */
    --fq-p4-soft: #dbeafe;

    background: var(--lemma-cream);
    color: var(--fq-text-2);
    font-family: var(--fq-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 24px;
    margin-top: 64px;
  }
  :root[lang="en"] .fq-page {
    --fq-body: "Noto Sans JP", system-ui, sans-serif;
  }

  .fq-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── HERO ─── */
  .fq-hero {
    padding: 60px 0 40px;
  }
  .fq-eyebrow {
    font-family: var(--fq-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--fq-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .fq-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .fq-h1 {
    font-family: var(--fq-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 1.06;
    color: var(--black);
    letter-spacing: -0.04em;
    margin: 0 0 22px;
    max-width: 920px;
  }
  :root[lang="ja"] .fq-h1 {
    font-size: 44px;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .fq-hero-sub {
    font-size: 15.5px;
    color: var(--fq-text-2);
    line-height: 1.75;
    margin: 0;
    max-width: 720px;
  }

  /* ─── INTENT ROUTER ─── */
  .fq-router {
    margin: 0 0 56px;
    padding: 28px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .fq-router-label {
    font-family: var(--fq-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .fq-router-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .fq-router-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .fq-router-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 20px 22px 18px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .fq-router-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 32px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fq-router-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
  }
  .fq-router-card:hover::before {
    width: 100%;
  }
  .fq-router-card-upper {
    border-width: 1px;
    border-color: rgba(139, 69, 19, 0.32);
    background: var(--lemma-cream-deep);
  }
  .fq-router-card-upper::before {
    height: 3px;
    width: 48px;
    background: var(--accent);
  }
  .fq-router-badge {
    align-self: flex-start;
    font-family: var(--fq-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lemma-cream);
    background: var(--accent);
    padding: 3px 9px;
    border-radius: 999px;
    margin: 0 0 4px;
  }
  .fq-router-title {
    font-family: var(--fq-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.35;
  }
  :root[lang="ja"] .fq-router-title {
    line-height: 1.5;
  }
  .fq-router-desc {
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--fq-text-3);
  }
  .fq-router-arrow {
    font-family: var(--fq-mono);
    font-size: 14px;
    color: var(--accent);
    margin-top: auto;
    padding-top: 10px;
    transition: transform 0.2s;
  }
  .fq-router-card:hover .fq-router-arrow {
    transform: translateX(4px);
  }

  /* ─── STICKY JUMP NAV ─── */
  .fq-jump {
    position: sticky;
    /* Flush under the 64px sticky global nav — a larger value leaves a gap
       where page content scrolls through between the header and this bar. */
    top: 64px;
    margin: 0 0 28px;
    z-index: 5;
    background: var(--lemma-cream);
    padding: 8px 0;
    border-top: 0.5px solid var(--lemma-line);
    border-bottom: 0.5px solid var(--lemma-line);
  }
  .fq-jump-inner {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px 0;
  }
  .fq-jump-inner::-webkit-scrollbar {
    display: none;
  }
  .fq-jump-pill {
    flex-shrink: 0;
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--fq-text-3);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    padding: 7px 14px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .fq-jump-pill:hover {
    color: var(--accent);
    border-color: rgba(139, 69, 19, 0.4);
  }
  .fq-jump-pill.is-active {
    color: var(--lemma-cream);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* ─── CONTROLS (search) ─── */
  .fq-controls {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 28px;
  }
  .fq-chip {
    font-family: var(--fq-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    padding: 4px 10px;
    border-radius: 999px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .fq-chip-p1 {
    background: var(--fq-p1-soft);
    color: var(--fq-p1);
  }
  .fq-chip-p2 {
    background: var(--fq-p2-soft);
    color: var(--fq-p2);
  }
  .fq-chip-p3 {
    background: var(--fq-p3-soft);
    color: var(--fq-p3);
  }
  .fq-chip-p4 {
    background: var(--fq-p4-soft);
    color: var(--fq-p4);
  }
  .fq-search {
    position: relative;
    min-width: 220px;
    flex: 0 1 280px;
  }
  .fq-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .fq-search-input {
    width: 100%;
    font-family: var(--fq-display);
    font-size: 13.5px;
    color: var(--fq-text-2);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    padding: 10px 16px;
    line-height: 1.4;
    transition: border-color 0.15s;
  }
  .fq-search-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .fq-search-input::placeholder {
    color: var(--fq-text-4);
  }

  /* ─── FAQ CONTENT ─── */
  .fq-content {
    margin: 0 0 56px;
  }
  .fq-section {
    margin: 0 0 48px;
    scroll-margin-top: 140px;
  }
  .fq-section:last-of-type {
    margin-bottom: 0;
  }
  .fq-section-label {
    font-family: var(--fq-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .fq-section-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }

  /* ─── ACCORDION ITEM ─── */
  .fq-item {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    margin: 0 0 10px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .fq-item[hidden] {
    display: none;
  }
  .fq-item:hover {
    border-color: rgba(139, 69, 19, 0.4);
  }
  .fq-item[data-faq-open="true"] {
    border-color: var(--accent);
    box-shadow: 0 8px 22px rgba(139, 69, 19, 0.06);
  }
  .fq-q {
    width: 100%;
    background: transparent;
    border: none;
    padding: 18px 22px;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--fq-display);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.45;
  }
  :root[lang="ja"] .fq-q {
    line-height: 1.6;
  }
  .fq-q-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }
  .fq-q-chip {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    padding: 0;
  }
  .fq-q-chip.fq-chip-p1 {
    background: var(--fq-p1);
  }
  .fq-q-chip.fq-chip-p2 {
    background: var(--fq-p2);
  }
  .fq-q-chip.fq-chip-p3 {
    background: var(--fq-p3);
  }
  .fq-q-chip.fq-chip-p4 {
    background: var(--fq-p4);
  }
  .fq-q-text {
    flex: 1;
  }
  .fq-icon {
    flex-shrink: 0;
    font-family: var(--fq-mono);
    font-size: 18px;
    color: var(--accent);
    font-weight: 500;
    line-height: 1;
    transition: transform 0.25s ease;
  }
  .fq-item[data-faq-open="true"] .fq-icon {
    transform: rotate(45deg);
  }
  .fq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .fq-item[data-faq-open="true"] .fq-a {
    max-height: 1200px;
  }
  .fq-a p {
    font-family: var(--fq-body);
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--fq-text-2);
    margin: 0;
    padding: 0 22px 12px;
  }
  /* Inline links inside an answer (e.g. our own product names) read as links. */
  .fq-a p a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .fq-a p a:hover { color: #3f6300; }
  /* Related links rendered below the answer when item.links is set. */
  .fq-a-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 8px 22px 20px;
    border-top: 0.5px dashed var(--lemma-line);
    margin: 4px 16px 0;
  }
  .fq-a-links-label {
    font-family: var(--fq-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fq-text-4);
  }
  .fq-a-link {
    font-family: var(--fq-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.35);
    transition: border-color 0.15s, color 0.15s;
  }
  .fq-a-link:hover {
    border-bottom-color: var(--accent);
