---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

export interface LegalSection {
  readonly heading: string;
  /** HTML string for the section body. Page authors render <p>, <ul>, <a> directly. */
  readonly body: string;
}

export interface LegalTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  /** Visible page tag (e.g. "Privacy Policy" / "プライバシーポリシー") */
  tag: string;
  /** H1 — same words as the tag, but rendered as a display heading */
  title: string;
  /** "Last updated: ..." line, pre-formatted by the page */
  lastUpdated: string;
  /** Brief intro paragraph above the numbered sections (HTML allowed) */
  intro: string;
  sections: ReadonlyArray<LegalSection>;
  /** SEO description for <head> */
  description: string;
}

const { locale, t, base, tag, title, lastUpdated, intro, sections, description } =
  Astro.props as LegalTemplateProps;

const brandSuffix = locale === "ja" ? "Lemma — 検証可能AI" : "Lemma — Verifiable AI";
---

<Layout locale={locale} title={`${title} — ${brandSuffix}`} description={description}>
  <Navigation locale={locale} t={t.nav} base={base} />

  <header class="legal-header">
    <div class="legal-tag">{tag}</div>
    <h1 class="legal-title">{title}</h1>
    <p class="legal-updated">{lastUpdated}</p>
  </header>

  <main class="legal-main">
    <p class="legal-intro" set:html={intro}></p>

    <ol class="legal-sections">
      {sections.map((section) => (
        <li class="legal-section">
          <h2 class="legal-h2">{section.heading}</h2>
          <div class="legal-body" set:html={section.body}></div>
        </li>
      ))}
    </ol>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* 新デザインシステム (2026-08 リニューアル): 地は #f3f4f1、見出しは Noto Serif JP 600、
     アクセントはライム系 (#a8e010 / 小さい文字は #4e7a00)。黒帯ヒーローと
     ブラウンのリンク・◆ビュレットは旧DSのため廃止。 */
  :global(html body) {
    background: #f3f4f1;
  }
  /* EN 旧ナビ（NavigationLegacy）が出す旧DSサドルブラウンの装飾レールは
     この面の配色に合わないため出さない（トップ v47 と同じ扱い） */
  :global(html body .lemma-brand-bar) {
    display: none;
  }

  .legal-header {
    max-width: 760px;
    margin: 64px auto 0;
    padding: clamp(56px, 7vw, 88px) 24px 8px;
  }
  .legal-tag {
    font-family: "Space Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #4e7a00;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .legal-tag::before {
    content: "";
    width: 26px;
    height: 2px;
    background: #a8e010;
    display: block;
  }
  .legal-title {
    font-family: "Noto Serif JP", serif;
    font-weight: 600;
    font-size: clamp(30px, 4.2vw, 44px);
    color: #12140e;
    line-height: 1.4;
    letter-spacing: 0.005em;
    margin-bottom: 14px;
  }
  .legal-updated {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #5c6156;
    font-variant-numeric: tabular-nums;
  }

  .legal-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 120px;
    font-feature-settings: "palt" 1;
  }

  .legal-intro {
    font-size: 16px;
    line-height: 1.95;
    color: #2f332b;
    margin-bottom: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid #e1e3dd;
  }

  .legal-sections {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: section;
  }
  .legal-section {
    counter-increment: section;
    margin-bottom: 48px;
  }
  .legal-h2 {
    font-family: "Noto Serif JP", serif;
    font-weight: 600;
    font-size: clamp(19px, 2.2vw, 23px);
    color: #12140e;
    line-height: 1.5;
    margin-bottom: 16px;
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  /* 番号は Inter 200 の階段 — Seal / トップと同じ部品のリズム */
  .legal-h2::before {
    content: counter(section, decimal-leading-zero);
    font-family: "Inter", sans-serif;
    font-weight: 200;
    font-size: clamp(20px, 2.2vw, 24px);
    letter-spacing: 0.06em;
    color: #5c6156;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .legal-body {
    font-size: 15.5px;
    line-height: 1.95;
    color: #2f332b;
  }
  .legal-body :global(p) {
    margin-bottom: 18px;
  }
  .legal-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .legal-body :global(ul) {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }
  .legal-body :global(ul li) {
    padding: 6px 0 6px 22px;
    position: relative;
  }
  .legal-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 1.1em;
    width: 12px;
    height: 2px;
    background: #a8e010;
  }
  .legal-body :global(a) {
    color: #4e7a00;
    font-weight: 600;
    border-bottom: 1px solid rgba(111, 156, 0, 0.35);
    text-decoration: none;
    transition: border-color 0.2s;
    overflow-wrap: anywhere;
  }
  .legal-body :global(a:hover) {
    border-bottom-color: #4e7a00;
  }
  .legal-body :global(strong) {
    font-weight: 700;
    color: #12140e;
  }
  .legal-body :global(code) {
    font-family: "Space Mono", monospace;
    font-size: 0.85em;
    background: #eceee9;
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .legal-header {
      padding-left: 6%;
      padding-right: 6%;
    }
    .legal-main {
      padding: 32px 6% 96px;
    }
    .legal-h2 {
      gap: 12px;
    }
  }
</style>
