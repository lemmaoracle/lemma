---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

export interface LegalSection {
  readonly heading: string;
  /** HTML string for the section body. Page authors render <p>, <ul>, <a> directly. */
  readonly body: string;
}

export interface LegalTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  /** Visible page tag (e.g. "Privacy Policy" / "プライバシーポリシー") */
  tag: string;
  /** H1 — same words as the tag, but rendered as a display heading */
  title: string;
  /** "Last updated: ..." line, pre-formatted by the page */
  lastUpdated: string;
  /** Brief intro paragraph above the numbered sections (HTML allowed) */
  intro: string;
  sections: ReadonlyArray<LegalSection>;
  /** SEO description for <head> */
  description: string;
}

const { locale, t, base, tag, title, lastUpdated, intro, sections, description } =
  Astro.props as LegalTemplateProps;
---

<Layout locale={locale} title={`${title} — Lemma Oracle`} description={description}>
  <Navigation locale={locale} t={t.nav} base={base} />

  <header class="legal-header">
    <div class="legal-tag">{tag}</div>
    <h1 class="legal-title">{title}</h1>
    <p class="legal-updated">{lastUpdated}</p>
  </header>

  <main class="legal-main">
    <p class="legal-intro" set:html={intro}></p>

    <ol class="legal-sections">
      {sections.map((section) => (
        <li class="legal-section">
          <h2 class="legal-h2">{section.heading}</h2>
          <div class="legal-body" set:html={section.body}></div>
        </li>
      ))}
    </ol>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .legal-header {
    margin-top: 64px;
    background: var(--black);
    color: var(--white);
    padding: 96px 10% 72px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .legal-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .legal-tag::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--accent);
    display: block;
  }
  .legal-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 500;
    color: var(--white);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }
  .legal-updated {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    font-variant-numeric: tabular-nums;
  }

  .legal-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 24px 120px;
    font-feature-settings: "palt" 1;
  }

  .legal-intro {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.85;
    color: var(--gray-800, #1a1a1a);
    margin-bottom: 56px;
  }

  .legal-sections {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: section;
  }
  .legal-section {
    counter-increment: section;
    margin-bottom: 56px;
  }
  .legal-h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 26px);
    font-weight: 500;
    color: var(--black);
    line-height: 1.3;
    margin-bottom: 20px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .legal-h2::before {
    content: counter(section, decimal-leading-zero);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--accent);
    flex-shrink: 0;
  }

  .legal-body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.85;
    color: var(--gray-800, #1a1a1a);
  }
  .legal-body :global(p) {
    margin-bottom: 20px;
  }
  .legal-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .legal-body :global(ul) {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
  }
  .legal-body :global(ul li) {
    padding: 4px 0 4px 24px;
    position: relative;
  }
  .legal-body :global(ul li::before) {
    content: "◆";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 8px;
    top: 12px;
  }
  .legal-body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid rgba(139, 69, 19, 0.28);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    overflow-wrap: anywhere;
  }
  .legal-body :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }
  .legal-body :global(strong) {
    font-weight: 600;
    color: var(--black);
  }
  .legal-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
    background: var(--gray-50);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .legal-header {
      padding: 80px 6% 60px;
    }
    .legal-main {
      padding: 56px 6% 96px;
    }
    .legal-h2 {
      gap: 12px;
    }
    .legal-h2::before {
      font-size: 10px;
    }
  }
</style>
