---
/**
 * /trust402/sell/ (+ /ja/trust402/sell/) — the "get paid for your work"
 * side of the Trust402 developer sub-brand, for researchers/students.
 *
 * Ported from the PR #603 prototype, built the Astro way: copy comes
 * from the typed const src/data/trust402.ts (bilingual), the icon sprite
 * is a shared component, and the sub-brand tokens (fluorescent green +
 * Space Mono, rounded corners) are scoped to `.t402` so nothing leaks to
 * the global brand. Chrome (Navigation / Footer / Layout) is the standard
 * site chrome. Form + listings are non-functional previews.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Trust402Icons from "../components/trust402/Trust402Icons.astro";
import { T402, T402_GITHUB, T402_SELL_OG } from "../data/trust402";

interface Props {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as Props;
const c = T402.sell;
const payHref = `${base}/trust402/`;
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/trust402/sell/"
  title={T402.sellMeta.title[locale]}
  description={T402.sellMeta.description[locale]}
  ogImage={T402_SELL_OG[locale]}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="t402">
    <Trust402Icons />

    {/* 1. HERO */}
    <header class="hero">
      <div class="inner">
        <div class="hero-grid">
          <div>
            <span class="eyebrow on-dark">{c.hero.eyebrow[locale]}</span>
            <h1>{c.hero.h1a[locale]} <span class="g">{c.hero.h1em[locale]}</span></h1>
            <p class="hero-sub">{c.hero.sub[locale]}</p>
            <div class="hero-cta-row">
              <a class="btn btn-primary" href={`${base}/trust402/sell/dashboard/`}>{c.hero.ctaPrimary[locale]} →</a>
              <a class="btn btn-ghost on-dark" href={`${base}/trust402/sell/model/`}>{c.hero.ctaSecondary[locale]}</a>
            </div>
            <div class="lede-note">
              {c.hero.lede.map((chip) => (
                <span class="lede-chip">{chip[locale]}</span>
              ))}
            </div>
          </div>
          <div>
            <div class="card-caption">
              <svg class="ic ic-robot" style="width:32px;height:44px"><use href="#ic-robot" /></svg>
              <span>{c.hero.cardCaption[locale]}</span>
            </div>
            {/* v9 listing card — HTML/CSS port of the OGP card's left half
                (the right column's pitch copy stays out: the hero copy + CTAs
                already play that role) */}
            <div class="ocard">
              <div class="oc-handle">{c.hero.card.handle}</div>
              <div class="oc-org">{c.hero.card.orgName[locale]} <span class="oc-org-plan">{c.hero.card.orgPlan}</span></div>
              <span class="oc-idchip">{c.hero.card.idChip}</span>
              <div class="oc-rule"></div>
              <span class="oc-status">{c.hero.card.statusChip[locale]}</span>
              <div class="oc-item">
                <svg class="oc-fileico" viewBox="0 0 44 58" aria-hidden="true">
                  <path class="oc-fileico-doc" d="M0 6 Q0 0 6 0 H30 L44 14 V52 Q44 58 38 58 H6 Q0 58 0 52 Z" />
                  <path class="oc-fileico-fold" d="M30 0 V14 H44" />
                  <path class="oc-fileico-lines" d="M8 26H36M8 36H36M8 46H36M17 21V51" />
                </svg>
                <div class="oc-filemeta">
                  <div class="oc-filename">{c.hero.card.file}</div>
                  <div class="oc-filesub">{c.hero.card.fileMeta}</div>
                </div>
                <div class="oc-seal">
                  <span class="oc-seal-ring" aria-hidden="true">
                    <span class="oc-seal-circle">
                      <svg viewBox="0 0 16 16"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </span>
                  </span>
                  <span class="oc-seal-label">{c.hero.card.sealLabel[locale]}</span>
                </div>
              </div>
              <div class="oc-checks">
                {c.hero.card.checks.map((k) => (
                  <span class="oc-check"><span class="oc-check-label">{k.label[locale]}</span> <b>{k.value[locale]}</b> <span class="oc-mk">✓</span></span>
                ))}
              </div>
              <div class="oc-dots"></div>
              <div class="oc-pricerow">
                <div class="oc-price"><b>{c.hero.card.priceBig}</b> <span class="oc-usdc">USDC</span> <span class="oc-approx">{c.hero.card.priceRest[locale]}</span></div>
                <span class="oc-proof">{c.hero.card.proof}</span>
              </div>
            </div>
            <div class="oc-under">{c.hero.card.verifiedBy}</div>
          </div>
        </div>
      </div>
    </header>

    {/* 2. WHY IT SELLS FOR MORE — merged with "why proof matters": the
        copies-flood-the-web narrative leads in, the 3 cards answer it,
        and the tech link closes the section */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.whyMore.eyebrow[locale]}</span>
          <h2>{c.whyMore.h2[locale]}</h2>
          <p>{c.whyMore.sub[locale]}</p>
        </div>
        <div class="whymore reveal">
          {c.whyMore.items.map((w) => (
            <div class="wm">
              <span class="wm-ic-wrap"><svg class="ic wm-ic"><use href={`#${w.icon}`} /></svg></span>
              <h3>{w.title[locale]}</h3>
              <p>{w.text[locale]}</p>
            </div>
          ))}
        </div>
        <div class="center-link"><a class="link-arrow" href={`${base}/trust402/#provenance`}>→ {c.whyMore.techLink[locale]}</a></div>
      </div>
    </section>

    {/* 3. HOW SELLING WORKS */}
    <section id="how">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.how.eyebrow[locale]}</span>
          <h2>{c.how.h2[locale]}</h2>
          <p>{c.how.sub[locale]}</p>
        </div>
        <div class="bigsteps">
          {c.how.steps.map((s, i) => (
            <div class="bigstep reveal">
              <div class="badge">{i + 1}</div>
              <div class="who">{s.who[locale]}</div>
              <h3>{s.title[locale]}</h3>
              <p>{s.body[locale]}</p>
              {i === 2 && <svg class="ic ic-robot step-robot"><use href="#ic-robot" /></svg>}
            </div>
          ))}
        </div>
        <p class="eq-caption">{c.how.caption[locale]}</p>
      </div>
    </section>

    {/* 4. WHAT YOU CAN SELL */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.whatSell.eyebrow[locale]}</span>
          <h2>{c.whatSell.h2[locale]}</h2>
          <p>{c.whatSell.sub[locale]}</p>
        </div>
        <div class="cards c4">
          {c.whatSell.cards.map((card) => (
            <div class="card reveal">
              <svg class="ic card-ic"><use href={`#${card.icon}`} /></svg>
              <span class="fn">{card.title[locale]}</span>
              <p>{card.body[locale]}</p>
            </div>
          ))}
        </div>
        <p class="eq-caption">{c.whatSell.caption[locale]}</p>
        <div class="center-link"><a class="link-arrow" href={`${base}/trust402/sell/model/`}>→ {c.whatSell.modelLink[locale]}</a></div>
      </div>
    </section>

    {/* 5. WHAT YOU ACTUALLY DO — the Dashboard-demo CTA sits right under
        the ①② cards (was its own section) */}
    <section>
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.hands.eyebrow[locale]}</span>
          <h2>{c.hands.h2[locale]}</h2>
          <p>{c.hands.sub[locale]}</p>
        </div>
        <div class="cards c2 reveal">
          <div class="card">
            <span class="fn fn-green">{c.hands.sandboxTitle[locale]} <span class="free-badge">free</span></span>
            <p class="card-p">{c.hands.sandboxBody[locale]}</p>
            <span class="chip">{c.hands.sandboxChip[locale]}</span>
          </div>
          <div class="card">
            <span class="fn">{c.hands.prodTitle[locale]}</span>
            <p class="card-p">{c.hands.prodBody[locale]}</p>
            <span class="chip">{c.hands.prodChip[locale]}</span>
          </div>
        </div>
        <div class="center-link reveal">
          <a class="btn btn-primary" href={`${base}/trust402/sell/dashboard/`}>{c.hands.cta[locale]} →</a>
          <p class="cta-note">{c.hands.ctaNote[locale]}</p>
        </div>
      </div>
    </section>

    {/* 6. INSTITUTIONAL ID — participation framing + request funnel */}
    <section class="section-dark">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain on-dark">{c.institutional.eyebrow[locale]}</span>
          <h2>{c.institutional.h2a[locale]} <span class="g">{c.institutional.h2em[locale]}</span></h2>
          <p>{c.institutional.sub[locale]}</p>
        </div>
        <div class="cards c3">
          {c.institutional.cards.map((card) => (
            <div class="card reveal">
              <svg class="ic card-ic"><use href={`#${card.icon}`} /></svg>
              <h3>{card.title[locale]}</h3>
              <p>{card.body[locale]}</p>
            </div>
          ))}
        </div>
        <div class="request reveal">
          <p class="request-lead">{c.institutional.request.lead[locale]}</p>
          <a class="btn btn-primary" href={c.institutional.request.href[locale]}>{c.institutional.request.cta[locale]} →</a>
        </div>
      </div>
    </section>

    {/* 7. PRICING — the Pay↔Sell relationship is a thin band here (was a section) */}
    <section id="pricing">
      <div class="inner">
        <div class="payband reveal">
          <span>{c.payBand.text[locale]}</span>
          <a class="link-arrow" href={payHref}>→ {c.payBand.link[locale]}</a>
        </div>
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.pricing.eyebrow[locale]}</span>
          <h2>{c.pricing.h2[locale]}</h2>
          <p>{c.pricing.sub[locale]}</p>
        </div>
        <div class="tiers">
          {c.pricing.tiers.map((tier) => (
            <div class:list={["tier", "reveal", { featured: tier.featured }]}>
              <div class="tname">{tier.name}{tier.free && <span class="free-badge">free</span>}</div>
              <div class="tpos">{tier.pos[locale]}</div>
              <div class="tprice">{tier.price[locale]}{tier.priceSub && <small>{tier.priceSub[locale]}</small>}</div>
              <div class="tmeans">{tier.means[locale]}</div>
              <div class="tstate">{tier.state[locale]}</div>
            </div>
          ))}
        </div>
        <div class="price-notes">
          {c.pricing.notes.map((n) => (
            <p class="price-note">{n[locale]}</p>
          ))}
        </div>
      </div>
    </section>

    {/* 8. FAQ — leads with the ✓✕ "no strings attached" lists (they answer
        the lock-in / data-handover questions the FAQ used to duplicate) */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal"><span class="eyebrow-plain">{c.faq.eyebrow[locale]}</span><h2>{c.faq.h2[locale]}</h2></div>
        <div class="keeps reveal">
          <div class="keepcol yes">
            <h3>{c.control.yesTitle[locale]}</h3>
            <ul class="keeplist">
              {c.control.yes.map((item) => (
                <li><span class="mk">✓</span><span>{item[locale]}</span></li>
              ))}
            </ul>
          </div>
          <div class="keepcol no">
            <h3>{c.control.noTitle[locale]}</h3>
            <ul class="keeplist">
              {c.control.no.map((item) => (
                <li><span class="mk">✕</span><span>{item[locale]}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="reveal faq-list">
          {c.faq.items.map((item) => (
            <div class="faq-item">
              <h3>{item.q[locale]}</h3>
              <p>{item.a[locale]}</p>
              {item.link && <a class="link-arrow" href={item.link.href[locale]}>→ {item.link.label[locale]}</a>}
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 9. CLOSING */}
    <section class="closing">
      <div class="inner">
        <span class="eyebrow on-dark">{c.closing.eyebrow[locale]}</span>
        <h2>{c.closing.h2[locale]}</h2>
        <div class="core">{c.closing.core[locale]}</div>
        <div class="rule"></div>
        <div class="cta-row">
          <a class="btn btn-primary" href={`${base}/trust402/sell/dashboard/`}>{c.closing.ctaPrimary[locale]} →</a>
          <a class="btn btn-ghost on-dark" href={T402_GITHUB}><svg class="ic btn-ic"><use href="#ic-github" /></svg> {c.closing.github[locale]}</a>
        </div>
      </div>
    </section>

    {/* Fixed Pay / Sell / Dashboard switcher (Sell active) */}
    <nav class="t402-switch" aria-label="Trust402">
      <a class="t402-switch-btn" href={`${base}/trust402/`}>Pay</a>
      <a class="t402-switch-btn active" href={`${base}/trust402/sell/`} aria-current="page">Sell</a>
      <a class="t402-switch-btn" href={`${base}/trust402/sell/dashboard/`}>Dashboard <span class="t402-switch-badge">demo</span></a>
    </nav>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* ── Trust402 sub-brand tokens, scoped to this page (mirrors the live
     .hp-devzone values; no global brand tokens are touched) ─────────── */
  .t402 {
    --green: #b6f500;
    --green-link: #4b6b0f;
    --green-deep: #8fbf00;
    --ink: #1f1e1a;
    --ink-soft: #4a4942;
    --muted: #6f6e66;
    --surface: #ecebe3;
    --surface-2: #f5f4ee;
    --card: #fff;
    --border: #d8d6cc;
    --border-dk: rgba(236, 235, 227, 0.12);
    --term-fg: #ecebe3;
    --font-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --font-body: "DM Sans", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-serif: "Cormorant Garamond", Georgia, serif;

    font-family: var(--font-body);
    color: var(--ink);
    background: var(--card);
    font-size: 15px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  .t402 a { color: inherit; text-decoration: none; }
  .t402 h1, .t402 h2, .t402 h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }

  /* accent word */
  .t402 .g { color: var(--green-link); }
  .t402 .hero .g, .t402 .section-dark .g { color: var(--green); }

  /* eyebrows */
  .t402 .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; background: var(--green); color: var(--ink); padding: 3px 10px; border-radius: 4px; margin-bottom: 22px; }
  .t402 .eyebrow-plain { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; color: var(--green-link); margin-bottom: 20px; }
  .t402 .eyebrow-plain::before { content: ""; width: 16px; height: 2px; background: currentColor; display: block; }
  .t402 .eyebrow-plain.on-dark { color: var(--green); }

  /* buttons */
  .t402 .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 13.5px; font-weight: 700; letter-spacing: 0.01em; padding: 14px 30px; border-radius: 999px; cursor: pointer; border: 1.5px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s; }
  .t402 .btn-primary { background: var(--green); color: var(--ink); }
  .t402 .btn-primary:hover { background: var(--green-deep); transform: translateY(-1px); }
  .t402 .btn-ghost { background: transparent; color: var(--ink); border-color: var(--border); }
  .t402 .btn-ghost:hover { border-color: var(--ink); }
  .t402 .btn-ghost.on-dark { color: var(--term-fg); border-color: var(--border-dk); }
  .t402 .btn-ghost.on-dark:hover { border-color: var(--term-fg); }
  .t402 .link-arrow { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--green-link); display: inline-flex; align-items: center; gap: 6px; }
  .t402 .link-arrow:hover { gap: 10px; transition: gap 0.2s; }

  /* layout primitives */
  .t402 section { padding: 96px 8%; }
  .t402 .inner { max-width: 1240px; margin: 0 auto; }
  .t402 .section-dark { background: var(--ink); color: var(--term-fg); }
  .t402 .section-dark h1, .t402 .section-dark h2, .t402 .section-dark h3 { color: var(--term-fg); }
  .t402 .section-gray { background: var(--surface); }
  .t402 .sec-head { max-width: 720px; margin-bottom: 56px; }
  .t402 .sec-head h2 { font-size: clamp(30px, 4vw, 48px); margin-bottom: 18px; }
  .t402 .sec-head p { font-size: 16px; color: var(--ink-soft); line-height: 1.75; }
  .t402 .section-dark .sec-head p { color: rgba(236, 235, 227, 0.6); }

  /* hero */
  .t402 .hero { background: var(--ink); color: var(--term-fg); padding: clamp(120px, 13vh, 150px) 8% 90px; }
  .t402 .hero h1 { font-size: clamp(40px, 6vw, 74px); font-weight: 800; line-height: 1.04; max-width: 14ch; margin-bottom: 26px; }
  .t402 .hero-sub { font-size: clamp(16px, 1.4vw, 19px); color: rgba(236, 235, 227, 0.66); max-width: 56ch; line-height: 1.7; margin-bottom: 36px; }
  .t402 .hero-cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 44px; }
  .t402 .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
  .t402 .card-caption { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .t402 .card-caption span { font-family: var(--font-mono); font-size: 12px; color: rgba(236, 235, 227, 0.55); }
  .t402 .card-caption .ic { color: var(--term-fg); }
  @media (max-width: 900px) { .t402 .hero-grid { grid-template-columns: 1fr; gap: 36px; } }

  /* v9 listing card — values track the SVG design source (640px card,
     rendered here at ~0.66 scale). Keep in sync with trust402-ogp-card-v9. */
  .t402 .ocard { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 26px 24px 24px; color: var(--ink); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25); }
  .t402 .oc-handle { font-family: var(--font-display); font-size: 28px; font-weight: 800; letter-spacing: -0.01em; line-height: 1.1; }
  .t402 .oc-org { font-size: 12.5px; color: var(--ink-soft); margin-top: 6px; }
  .t402 .oc-org-plan { color: var(--muted); }
  .t402 .oc-idchip { display: inline-block; font-family: var(--font-mono); font-size: 9.5px; color: var(--muted); background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; padding: 3px 11px; margin-top: 9px; white-space: nowrap; }
  .t402 .oc-rule { height: 1px; background: var(--border); margin: 16px 0; }
  .t402 .oc-status { display: inline-block; font-family: var(--font-body); font-size: 11px; font-weight: 700; background: var(--green); color: var(--ink); border-radius: 999px; padding: 4px 13px; margin-bottom: 15px; }
  .t402 .oc-item { display: flex; align-items: center; gap: 14px; }
  .t402 .oc-fileico { flex: none; width: 30px; height: 39px; }
  .t402 .oc-fileico-doc { fill: var(--surface-2); stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .t402 .oc-fileico-fold { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .t402 .oc-fileico-lines { fill: none; stroke: var(--green-deep); stroke-width: 2; }
  .t402 .oc-filemeta { min-width: 0; }
  .t402 .oc-filename { font-family: var(--font-display); font-size: 18px; font-weight: 700; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .t402 .oc-filesub { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted); margin-top: 5px; }
  .t402 .oc-seal { margin-left: auto; flex: none; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .t402 .oc-seal-ring { display: inline-flex; padding: 3px; border: 1.5px solid var(--green-deep); border-radius: 999px; }
  .t402 .oc-seal-circle { display: inline-flex; align-items: center; justify-content: center; width: 33px; height: 33px; border-radius: 999px; background: var(--green); color: var(--ink); }
  .t402 .oc-seal-circle svg { width: 15px; height: 15px; }
  .t402 .oc-seal-label { font-size: 10px; font-weight: 700; color: var(--green-link); white-space: nowrap; }
  .t402 .oc-checks { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 18px; font-size: 12px; }
  .t402 .oc-check { white-space: nowrap; }
  .t402 .oc-check-label { color: var(--muted); }
  .t402 .oc-check b { color: var(--ink); font-weight: 600; }
  .t402 .oc-mk { color: var(--green-deep); font-weight: 700; }
  .t402 .oc-dots { border-top: 1px dashed var(--border); margin: 15px 0 13px; }
  .t402 .oc-pricerow { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .t402 .oc-price { font-family: var(--font-display); }
  .t402 .oc-price b { font-size: 29px; font-weight: 800; color: var(--ink); letter-spacing: -0.01em; }
  .t402 .oc-usdc { font-size: 15px; font-weight: 600; color: var(--muted); }
  .t402 .oc-approx { font-size: 11.5px; font-weight: 400; color: var(--muted); margin-left: 4px; }
  .t402 .oc-proof { font-family: var(--font-mono); font-size: 9.5px; color: var(--muted); white-space: nowrap; }
  .t402 .oc-under { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: rgba(236, 235, 227, 0.45); text-align: right; margin-top: 12px; }

  /* card grid */
