---
/**
 * /trust402/sell/ (+ /ja/trust402/sell/) — the "get paid for your work"
 * side of the Trust402 developer sub-brand, for researchers/students.
 *
 * Ported from the PR #603 prototype, built the Astro way: copy comes
 * from the typed const src/data/trust402.ts (bilingual), the icon sprite
 * is a shared component, and the sub-brand tokens (fluorescent green +
 * Space Mono, rounded corners) are scoped to `.t402` so nothing leaks to
 * the global brand. Chrome (Navigation / Footer / Layout) is the standard
 * site chrome. Form + listings are non-functional previews.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Trust402Icons from "../components/trust402/Trust402Icons.astro";
import { T402, T402_GITHUB } from "../data/trust402";

interface Props {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as Props;
const c = T402.sell;
const payHref = `${base}/trust402/`;
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/trust402/sell/"
  title={T402.sellMeta.title[locale]}
  description={T402.sellMeta.description[locale]}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="t402">
    <Trust402Icons />

    {/* 1. HERO */}
    <header class="hero">
      <div class="inner">
        <div class="hero-grid">
          <div>
            <span class="eyebrow on-dark">{c.hero.eyebrow[locale]}</span>
            <h1>{c.hero.h1a[locale]} <span class="g">{c.hero.h1em[locale]}</span></h1>
            <p class="hero-sub">{c.hero.sub[locale]}</p>
            <div class="hero-cta-row">
              <a class="btn btn-primary" href={`${base}/trust402/sell/dashboard/`}>{c.hero.ctaPrimary[locale]} →</a>
              <a class="btn btn-ghost on-dark" href={`${base}/trust402/sell/model/`}>{c.hero.ctaSecondary[locale]}</a>
            </div>
            <div class="lede-note">{c.hero.lede[locale]}</div>
          </div>
          <div>
            <div class="card-caption">
              <svg class="ic ic-robot" style="width:32px;height:44px"><use href="#ic-robot" /></svg>
              <span>{c.hero.cardCaption[locale]}</span>
            </div>
            <div class="ocard">
              <div class="ochead"><span class="ofile">{c.hero.card.file}</span><span class="obadge">{c.hero.card.badge[locale]}</span></div>
              <div class="orow"><span>{c.hero.card.madeBy[locale]}</span><b>{c.hero.card.madeByVal[locale]}</b></div>
              <div class="orow"><span>{c.hero.card.untouched[locale]}</span><span class="ocheck">{c.hero.card.verifiedVal[locale]}</span></div>
              <div class="orow"><span>{c.hero.card.priceRow[locale]}</span><b>{c.hero.card.price[locale]}</b></div>
              <div class="orow orow-top"><span>{c.hero.card.checking[locale]}</span><span class="ocheck">{c.hero.card.checkingVal[locale]}</span></div>
              <div class="onote">{c.hero.card.note[locale]}</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* 2. HOW SELLING WORKS */}
    <section id="how">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.how.eyebrow[locale]}</span>
          <h2>{c.how.h2[locale]}</h2>
          <p>{c.how.sub[locale]}</p>
        </div>
        <div class="bigsteps">
          {c.how.steps.map((s, i) => (
            <div class="bigstep reveal">
              <div class="badge">{i + 1}</div>
              <div class="who">{s.who[locale]}</div>
              <h3>{s.title[locale]}</h3>
              <p>{s.body[locale]}</p>
              {i === 2 && <svg class="ic ic-robot step-robot"><use href="#ic-robot" /></svg>}
            </div>
          ))}
        </div>
        <p class="eq-caption">{c.how.caption[locale]}</p>
      </div>
    </section>

    {/* 3. WHAT YOU CAN SELL */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.whatSell.eyebrow[locale]}</span>
          <h2>{c.whatSell.h2[locale]}</h2>
          <p>{c.whatSell.sub[locale]}</p>
        </div>
        <div class="cards c4">
          {c.whatSell.cards.map((card) => (
            <div class="card reveal">
              <svg class="ic card-ic"><use href={`#${card.icon}`} /></svg>
              <span class="fn">{card.title[locale]}</span>
              <p>{card.body[locale]}</p>
            </div>
          ))}
        </div>
        <p class="eq-caption">{c.whatSell.caption[locale]}</p>
        <div class="center-link"><a class="link-arrow" href={`${base}/trust402/sell/model/`}>→ {c.whatSell.modelLink[locale]}</a></div>
      </div>
    </section>

    {/* 4. WHAT STAYS YOURS / DON'T NEED */}
    <section>
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.control.eyebrow[locale]}</span>
          <h2>{c.control.h2[locale]}</h2>
          <p>{c.control.sub[locale]}</p>
        </div>
        <div class="keeps reveal">
          <div class="keepcol yes">
            <h3>{c.control.yesTitle[locale]}</h3>
            <ul class="keeplist">
              {c.control.yes.map((item) => (
                <li><span class="mk">✓</span><span>{item[locale]}</span></li>
              ))}
            </ul>
          </div>
          <div class="keepcol no">
            <h3>{c.control.noTitle[locale]}</h3>
            <ul class="keeplist">
              {c.control.no.map((item) => (
                <li><span class="mk">✕</span><span>{item[locale]}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* 5. WHY PROOF MATTERS */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.whyProof.eyebrow[locale]}</span>
          <h2>{c.whyProof.h2[locale]}</h2>
          <p>{c.whyProof.sub[locale]}</p>
        </div>
        <div class="slogan reveal">{c.whyProof.sloganA[locale]} <span class="g">{c.whyProof.sloganEm[locale]}</span></div>
        <p class="plain-note">{c.whyProof.note[locale]}<span class="note-em">{c.whyProof.noteEm[locale]}</span></p>
        <div class="center-link"><a class="link-arrow" href={`${base}/trust402/#provenance`}>→ {c.whyProof.techLink[locale]}</a></div>
      </div>
    </section>

    {/* 6. INSTITUTIONAL ID */}
    <section class="section-dark">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain on-dark">{c.institutional.eyebrow[locale]}</span>
          <h2>{c.institutional.h2a[locale]} <span class="g">{c.institutional.h2em[locale]}</span></h2>
          <p>{c.institutional.sub[locale]}</p>
        </div>
        <div class="cards c3">
          {c.institutional.cards.map((card) => (
            <div class="card reveal">
              <svg class="ic card-ic"><use href={`#${card.icon}`} /></svg>
              <h3>{card.title[locale]}</h3>
              <p>{card.body[locale]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 7.5 WHAT YOU ACTUALLY DO */}
    <section>
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.hands.eyebrow[locale]}</span>
          <h2>{c.hands.h2[locale]}</h2>
          <p>{c.hands.sub[locale]}</p>
        </div>
        <div class="cards c2 reveal">
          <div class="card">
            <span class="fn fn-green">{c.hands.sandboxTitle[locale]} <span class="free-badge">free</span></span>
            <p class="card-p">{c.hands.sandboxBody[locale]}</p>
            <span class="chip">{c.hands.sandboxChip[locale]}</span>
          </div>
          <div class="card">
            <span class="fn">{c.hands.prodTitle[locale]}</span>
            <p class="card-p">{c.hands.prodBody[locale]}</p>
            <span class="chip">{c.hands.prodChip[locale]}</span>
          </div>
        </div>
      </div>
    </section>

    {/* 7.6 SEE IT IN THE DASHBOARD (demo) — replaces the on-page form/listings previews */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.dash.eyebrow[locale]}</span>
          <h2>{c.dash.h2[locale]}</h2>
          <p>{c.dash.sub[locale]}</p>
        </div>
        <div class="center-link reveal">
          <a class="btn btn-primary" href={`${base}/trust402/sell/dashboard/`}>{c.dash.cta[locale]} →</a>
        </div>
      </div>
    </section>

    {/* 8. TWO SIDES */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal"><span class="eyebrow-plain">{c.twoSides.eyebrow[locale]}</span><h2>{c.twoSides.h2[locale]}</h2><p>{c.twoSides.sub[locale]}</p></div>
        <div class="sides reveal">
          <div class="side"><svg class="ic ic-robot side-ic"><use href="#ic-robot-proof" /></svg><div class="st">{c.twoSides.payTag[locale]}</div><h3>{c.twoSides.payH3[locale]}</h3><p>{c.twoSides.payBody[locale]}</p></div>
          <div class="swap">↔</div>
          <div class="side side-here"><svg class="ic ic-robot side-ic"><use href="#ic-signed" /></svg><div class="st">{c.twoSides.sellTag[locale]}</div><h3>{c.twoSides.sellH3[locale]}</h3><p>{c.twoSides.sellBody[locale]}</p></div>
        </div>
        <div class="center-link"><a class="link-arrow" href={payHref}>→ {c.twoSides.link[locale]}</a></div>
      </div>
    </section>

    {/* 9. PRICING */}
    <section id="pricing">
      <div class="inner">
        <div class="sec-head reveal">
          <span class="eyebrow-plain">{c.pricing.eyebrow[locale]}</span>
          <h2>{c.pricing.h2[locale]}</h2>
          <p>{c.pricing.sub[locale]}</p>
        </div>
        <div class="tiers">
          {c.pricing.tiers.map((tier) => (
            <div class:list={["tier", "reveal", { featured: tier.featured }]}>
              <div class="tname">{tier.name}{tier.free && <span class="free-badge">free</span>}</div>
              <div class="tpos">{tier.pos[locale]}</div>
              <div class="tprice">{tier.price[locale]}{tier.priceSub && <small>{tier.priceSub[locale]}</small>}</div>
              <div class="tmeans">{tier.means[locale]}</div>
              <div class="tstate">{tier.state[locale]}</div>
            </div>
          ))}
        </div>
        <p class="price-note">{c.pricing.note[locale]}</p>
      </div>
    </section>

    {/* 10. FAQ */}
    <section class="section-gray">
      <div class="inner">
        <div class="sec-head reveal"><span class="eyebrow-plain">{c.faq.eyebrow[locale]}</span><h2>{c.faq.h2[locale]}</h2></div>
        <div class="reveal">
          {c.faq.items.map((item) => (
            <div class="faq-item"><h3>{item.q[locale]}</h3><p>{item.a[locale]}</p></div>
          ))}
        </div>
      </div>
    </section>

    {/* 11. CLOSING */}
    <section class="closing">
      <div class="inner">
        <span class="eyebrow on-dark">{c.closing.eyebrow[locale]}</span>
        <h2>{c.closing.h2[locale]}</h2>
        <div class="core">{c.closing.core[locale]}</div>
        <div class="rule"></div>
        <div class="cta-row">
          <a class="btn btn-primary" href={`${base}/trust402/sell/dashboard/`}>{c.closing.ctaPrimary[locale]} →</a>
          <a class="btn btn-ghost on-dark" href="#">{c.closing.ctaWaitlist[locale]}</a>
          <a class="btn btn-ghost on-dark" href={T402_GITHUB}><svg class="ic btn-ic"><use href="#ic-github" /></svg> {c.closing.github[locale]}</a>
        </div>
      </div>
    </section>

    {/* Fixed Pay / Sell / Dashboard switcher (Sell active) */}
    <nav class="t402-switch" aria-label="Trust402">
      <a class="t402-switch-btn" href={`${base}/trust402/`}>Pay</a>
      <a class="t402-switch-btn active" href={`${base}/trust402/sell/`} aria-current="page">Sell</a>
      <a class="t402-switch-btn" href={`${base}/trust402/sell/dashboard/`}>Dashboard <span class="t402-switch-badge">demo</span></a>
    </nav>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* ── Trust402 sub-brand tokens, scoped to this page (mirrors the live
     .hp-devzone values; no global brand tokens are touched) ─────────── */
  .t402 {
    --green: #b6f500;
    --green-link: #4b6b0f;
    --green-deep: #8fbf00;
    --ink: #1f1e1a;
    --ink-soft: #4a4942;
    --muted: #6f6e66;
    --surface: #ecebe3;
    --surface-2: #f5f4ee;
    --card: #fff;
    --border: #d8d6cc;
    --border-dk: rgba(236, 235, 227, 0.12);
    --term-fg: #ecebe3;
    --font-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --font-body: "DM Sans", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-serif: "Cormorant Garamond", Georgia, serif;

    font-family: var(--font-body);
    color: var(--ink);
    background: var(--card);
    font-size: 15px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  .t402 a { color: inherit; text-decoration: none; }
  .t402 h1, .t402 h2, .t402 h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; }

  /* accent word */
  .t402 .g { color: var(--green-link); }
  .t402 .hero .g, .t402 .section-dark .g { color: var(--green); }

  /* eyebrows */
  .t402 .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; background: var(--green); color: var(--ink); padding: 3px 10px; border-radius: 4px; margin-bottom: 22px; }
  .t402 .eyebrow-plain { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; color: var(--green-link); margin-bottom: 20px; }
  .t402 .eyebrow-plain::before { content: ""; width: 16px; height: 2px; background: currentColor; display: block; }
  .t402 .eyebrow-plain.on-dark { color: var(--green); }

  /* buttons */
  .t402 .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 13.5px; font-weight: 700; letter-spacing: 0.01em; padding: 14px 30px; border-radius: 999px; cursor: pointer; border: 1.5px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s; }
  .t402 .btn-primary { background: var(--green); color: var(--ink); }
  .t402 .btn-primary:hover { background: var(--green-deep); transform: translateY(-1px); }
  .t402 .btn-ghost { background: transparent; color: var(--ink); border-color: var(--border); }
  .t402 .btn-ghost:hover { border-color: var(--ink); }
  .t402 .btn-ghost.on-dark { color: var(--term-fg); border-color: var(--border-dk); }
  .t402 .btn-ghost.on-dark:hover { border-color: var(--term-fg); }
  .t402 .link-arrow { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--green-link); display: inline-flex; align-items: center; gap: 6px; }
  .t402 .link-arrow:hover { gap: 10px; transition: gap 0.2s; }

  /* layout primitives */
  .t402 section { padding: 96px 8%; }
  .t402 .inner { max-width: 1240px; margin: 0 auto; }
  .t402 .section-dark { background: var(--ink); color: var(--term-fg); }
  .t402 .section-dark h1, .t402 .section-dark h2, .t402 .section-dark h3 { color: var(--term-fg); }
  .t402 .section-gray { background: var(--surface); }
  .t402 .sec-head { max-width: 720px; margin-bottom: 56px; }
  .t402 .sec-head h2 { font-size: clamp(30px, 4vw, 48px); margin-bottom: 18px; }
  .t402 .sec-head p { font-size: 16px; color: var(--ink-soft); line-height: 1.75; }
  .t402 .section-dark .sec-head p { color: rgba(236, 235, 227, 0.6); }

  /* hero */
  .t402 .hero { background: var(--ink); color: var(--term-fg); padding: clamp(120px, 13vh, 150px) 8% 90px; }
  .t402 .hero h1 { font-size: clamp(40px, 6vw, 74px); font-weight: 800; line-height: 1.04; max-width: 14ch; margin-bottom: 26px; }
  .t402 .hero-sub { font-size: clamp(16px, 1.4vw, 19px); color: rgba(236, 235, 227, 0.66); max-width: 56ch; line-height: 1.7; margin-bottom: 36px; }
  .t402 .hero-cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 44px; }
  .t402 .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
  .t402 .card-caption { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .t402 .card-caption span { font-family: var(--font-mono); font-size: 12px; color: rgba(236, 235, 227, 0.55); }
  .t402 .card-caption .ic { color: var(--term-fg); }
  @media (max-width: 900px) { .t402 .hero-grid { grid-template-columns: 1fr; gap: 36px; } }

  /* output card */
  .t402 .ocard { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; color: var(--ink); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25); }
  .t402 .ocard .ochead { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
  .t402 .ocard .ofile { font-family: var(--font-mono); font-size: 13px; font-weight: 700; }
  .t402 .ocard .obadge { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: var(--green); color: var(--ink); padding: 3px 9px; border-radius: 4px; }
  .t402 .ocard .orow { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 12.5px; padding: 6px 0; color: var(--ink-soft); }
  .t402 .ocard .orow b { color: var(--ink); }
  .t402 .ocard .orow-top { border-top: 1px solid var(--border); margin-top: 8px; padding-top: 12px; }
  .t402 .ocard .ocheck { color: var(--green-link); font-weight: 700; }
  .t402 .ocard .onote { font-family: var(--font-body); font-size: 11.5px; color: var(--muted); margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); line-height: 1.5; }

  /* card grid */
  .t402 .cards { display: grid; gap: 16px; }
  .t402 .cards.c4 { grid-template-columns: repeat(4, 1fr); }
  .t402 .cards.c3 { grid-template-columns: repeat(3, 1fr); }
  .t402 .cards.c2 { grid-template-columns: repeat(2, 1fr); }
  .t402 .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 30px 28px; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .t402 .card:hover { border-color: var(--green); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06); }
  .t402 .section-dark .card { background: rgba(236, 235, 227, 0.04); border-color: var(--border-dk); }
  .t402 .card .fn { font-family: var(--font-mono); font-size: 15px; font-weight: 700; color: var(--ink); }
  .t402 .card .fn-green { color: var(--green-link); }
  .t402 .card h3 { font-size: 19px; margin-bottom: 10px; }
  .t402 .section-dark .card h3 { color: var(--term-fg); }
  .t402 .card p { font-size: 14px; color: var(--ink-soft); }
  .t402 .card .card-p { margin-top: 12px; }
  .t402 .section-dark .card p { color: rgba(236, 235, 227, 0.6); }
  .t402 .card .chip { display: inline-block; margin-top: 14px; font-family: var(--font-mono); font-size: 11.5px; color: var(--green-link); background: var(--surface); padding: 4px 10px; border-radius: 6px; }
  @media (max-width: 1024px) { .t402 .cards.c4, .t402 .cards.c3 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px) { .t402 .cards.c4, .t402 .cards.c3, .t402 .cards.c2 { grid-template-columns: 1fr; } }

  .t402 .eq-caption { margin-top: 16px; font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); }

  /* slogan */
  .t402 .slogan { font-family: var(--font-display); font-weight: 300; font-size: clamp(24px, 3.2vw, 40px); letter-spacing: -0.02em; line-height: 1.25; margin: 8px 0; }
  .t402 .plain-note { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); margin-top: 20px; }
  .t402 .plain-note .note-em { color: var(--green-link); }

  /* two sides */
  .t402 .sides { display: grid; grid-template-columns: 1fr auto 1fr; gap: 24px; align-items: center; margin: 34px 0; }
  .t402 .side { background: var(--card); border: 1px solid var(--border); border-top: 3px solid var(--green); border-radius: 14px; padding: 28px 26px; }
  .t402 .side .ic { color: var(--ink); margin-bottom: 14px; }
  .t402 .side .st { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: lowercase; color: var(--green-link); margin-bottom: 8px; }
  .t402 .side h3 { font-size: 22px; color: var(--ink); margin-bottom: 8px; }
  .t402 .side p { font-size: 13.5px; color: var(--ink-soft); }
  .t402 .sides .swap { font-size: 26px; color: var(--green-link); text-align: center; }
  .t402 .center-link { text-align: center; margin-top: 24px; }
  @media (max-width: 760px) { .t402 .sides { grid-template-columns: 1fr; } }

  /* pricing */
  .t402 .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .t402 .tier { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 30px 26px; display: flex; flex-direction: column; }
