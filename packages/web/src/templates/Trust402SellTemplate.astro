<script is:inline define:vars={{ formL }}>
  (function () {
    // reveal-on-scroll
    var els = document.querySelectorAll(".t402 .reveal");
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add("on");
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
      );
      els.forEach(function (el) { io.observe(el); });
    } else {
      els.forEach(function (el) { el.classList.add("on"); });
    }

    // live publish-form preview
    var g = function (id) { return document.getElementById(id); };
    var file = g("t402-f-file"), title = g("t402-f-title"), ver = g("t402-f-version"), price = g("t402-f-price"), as = g("t402-f-as");
    if (!title) return;
    function sync() {
      g("t402-p-file").textContent = (file.textContent || "").trim() || formL.untitled;
      g("t402-p-title").textContent = title.value || "—";
      g("t402-p-version").textContent = ver.value;
      var p = (price.value || "").trim();
      g("t402-p-price").textContent = (p ? p : "0") + formL.unit;
      g("t402-p-as").textContent = as.value === "inst" ? formL.asInst : formL.asYou;
    }
    ["input", "change", "keyup"].forEach(function (ev) {
      title.addEventListener(ev, sync);
      price.addEventListener(ev, sync);
    });
    ver.addEventListener("change", sync);
    as.addEventListener("change", sync);
    sync();
  })();
</script>
