---
/**
 * トップページ v47 — `/ja/`（JA）と `/`（EN）。
 *
 * 正典: lemma_top_mock_v47.html ＋ Lemma_トップページ_実装指示_v1_2026-08-04.md（Phase6）。
 * seal-v4 と同じ fragment（config/top-v47.{ja,en}.html）＋ scoped CSS
 * （styles/top-v47.css, .topx）方式。ナビ・フッターは共通コンポーネント。
 *
 * 指示書の要点:
 *   - ムービーは外部ファイル /assets/film/concept-film.html?embed=1（srcdoc・base64 禁止）。
 *     読み込み即再生せず、ビューポート進入時に postMessage で再生。
 *     reduced-motion では play を送らない（ムービー側は 01 の完成状態で静止）。
 *   - レジストリは表示のたびに GET /v1/counters。失敗時は推定で埋めず
 *     「レジストリに到達できません。推定値では埋めません。」（/verify/ と同一表記）。
 *   - ヒーロー第2CTA は為替フィードの docHash をライブ取得して /verify/?doc= に埋める。
 *     取得失敗時は /verify/ のまま。
 *   - 未実測の数字（8ms・0.4s・312 等）は書かない。
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import bodyJa from "../config/top-v47.ja.html?raw";
import bodyEn from "../config/top-v47.en.html?raw";
import { getCollection } from "astro:content";
import { isVisibleBrief } from "../lib/briefDrafts";
import { byDateDesc, getAllPosts, postInCategory, type BlogPost } from "../data/blog";
import { getEnBriefMap } from "../data/getEnBriefMap";
import { resolveCoverImage } from "../lib/coverPhoto";
import { coverArtwork, COVER_WIDTH, COVER_HEIGHT } from "../lib/blogCover";
import { briefCardSvg } from "../lib/briefCover";
import { caseStudyCardSvg } from "../lib/caseStudyCover";
import { categoryLabel } from "../data/criticalBriefs";
import type { CategorySlug } from "../data/criticalBriefs";
import "../styles/top-v47.css";
import { blogArticlePath } from "../lib/urls";
import { SELF_CHECK_PAGES } from "../config/cta";

export interface TopV47TemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as TopV47TemplateProps;
const isJa = locale === "ja";

const esc = (v: string) =>
  v.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
/** n 字で詰める。空白がある言語（EN）は語の途中で切らない。 */
const clip = (v: string, n: number) => {
  if (v.length <= n) return v;
  const cut = v.slice(0, n);
  const sp = cut.lastIndexOf(" ");
  return `${(sp > n * 0.6 ? cut.slice(0, sp) : cut).trimEnd()}…`;
};
/** カードの一文。JA は最初の「。」まで、EN は最初の「. 」までで切る。 */
const firstSentence = (v: string): string => {
  const ja = v.indexOf("。");
  if (ja >= 0) return v.slice(0, ja + 1);
  const en = v.match(/^[\s\S]*?\.(?=\s|$)/);
  return en ? en[0] : v;
};

const postsDesc = [...(await getAllPosts(locale))].sort(byDateDesc);

/** 枠1 に出す導入事例の slug（下の「最近の動き」で使う）。 */
const CASE_STUDY_SLUG = "metawater-mizudako-resident-record-proof";
const caseStudy = postsDesc.find((p) => p.slug === CASE_STUDY_SLUG);

// ヒーロー CTA 直下の NEW ティッカー。最新の Announcements 記事を1本だけ出す
// (mock v5.9 の .ticker。モックはハードコードだったので実データに接続)。
// 導入事例は category:Announcements でありながら下の枠1 にも出るので、
// ここでは除く——同じ1本をティッカーと枠1 の2箇所に出すと枠が死ぬ。
const latestAnnouncement = postsDesc.find(
  (p) => postInCategory(p, "Announcements") && p.slug !== caseStudy?.slug,
);
const tickerHtml = latestAnnouncement
  ? `<div class="ticker"><span class="tk">NEW</span><a href="${blogArticlePath(base, latestAnnouncement.slug)}" data-top-ev="top_hero_news">${esc(latestAnnouncement.title)} →</a></div>`
  : "";

// ヒーローの NEW の下に、無料のセルフチェックへの 1 行（2026-10-25・日本語だけ）。
// 日本の読者がいちばん開くのがトップなのに、入口がフッターだけだった。
// 訴求ごとのページが増えたら、ここに 1 行ずつ足す（まとめのページは 3 つそろってから）。
const selfCheckTickerHtml = isJa
  ? `<div class="ticker ticker--sc"><span class="tk">無料</span><a href="${SELF_CHECK_PAGES.remittance.path}" data-top-ev="top_self_check"><span>なりすましの不正送金、自社で通らないか。</span><span>対策チェックツール →</span></a></div>`
  : "";

/* ── 最近の動き（Latest news 出し分け設計 v1 §4.1）────────────────────
 * fragment の LATEST 節はモック由来の静的プレースホルダ（社外リリースへの
 * 仮リンク・空のプレス枠・Brief No.105 直書き）だったので `<!--LATEST-->`
 * に畳み、ここで実データを流し込む。3枠の性格は固定し、新着順で競争させない。
 *   枠1 実績     — 導入事例の記事（手動）。無ければ最新の「お知らせ」へ
 *   枠2 論点     — Critical Brief の最新1本（自動。毎週の鮮度はこの枠が担う）
 *   枠3 読みもの — `audience: business` からの選抜1本（手動・月次で見直す）
 */

/* 枠1 は実績の枠なので、お知らせより導入事例を優先する（記事が取り下げられても
   枠が空かないよう、見つからなければ最新の「お知らせ」へ落ちる）。 */
const slot1 = caseStudy ?? latestAnnouncement;
const slot1Label = caseStudy ? "caseStudy" : "announce";

/** 枠3 に出す記事の slug（`audience: business` のもの）。月次で見直す。
 *  見つからなければ business の最新へ自動フォールバックし、枠を空けない。 */
const TOP_PICK_SLUG = "ai-financial-cybersecurity-akamai-2026";

const bizPostsDesc = postsDesc.filter((p) => p.audience === "business");
const pickedCandidate = bizPostsDesc.find((p) => p.slug === TOP_PICK_SLUG) ?? bizPostsDesc[0];
// 枠1 と同じ記事が枠3 にも来ないようにする（両枠が同じ1本を指すと枠が死ぬ）。
// 導入事例は audience:business なので、枠1 に出た場合ここに再登場しうる。
const pickedPost =
  pickedCandidate && pickedCandidate.slug === slot1?.slug
    ? bizPostsDesc.find((p) => p.slug !== slot1.slug)
    : pickedCandidate;

// 枠2: Brief は JA コレクションを軸に、EN では訳がある分だけ差し替える
// （/critical/briefs/ の一覧と同じ選び方・同じ並び）。
const enBriefById = isJa ? null : await getEnBriefMap();
const latestBrief = [...(await getCollection("critical-briefs", isVisibleBrief))]
  .map((ja) => enBriefById?.get(ja.id) ?? ja)
  .sort((a, b) => {
    const diff = b.data.published.getTime() - a.data.published.getTime();
    return diff !== 0 ? diff : b.data.brief_no - a.data.brief_no;
  })[0];

// 一文と「読む →」の間。JA は句点で切れるので詰め、EN は空白で分ける。
const latSep = isJa ? "" : " ";
const LAT = isJa
  ? {
      announce: "お知らせ",
      caseStudy: "導入事例",
      blog: "ブログ",
      // カバーが「CRITICAL BRIEF」を大きく出すので、チップは語を重ねない
      // （業界ページ枠2 と同じ扱い）。
      brief: "事案分析",
      readPost: "記事を読む →",
      readBrief: "Brief を読む →",
      briefLead: "いま争点になっていることを、事実から追う。",
    }
  : {
      announce: "Announcement",
      caseStudy: "Case study",
      blog: "Blog",
      brief: "Case analysis",
      readPost: "Read the article →",
      readBrief: "Read the brief →",
      briefLead: "Following what is contested now, from the facts.",
    };

/* カバーはブログ一覧と同じ扱い: 写真が public/ に実在すれば写真、無ければ
   カテゴリ由来の抽象パターン（lib/blogCover）。モックのドットグリッドは
   「質感は図解の枠だけ」（指示 第6部-3）に従い通常カードには載せない。 */
const postCoverHtml = (p: BlogPost): string => {
  /* 導入事例は Brief と同じ生成カバー（写真用の処理はライムを潰すため）。 */
  if (p.tags?.includes("case-study") ?? false) {
    return caseStudyCardSvg({
      lines: p.coverLines ?? [],
      locale: isJa ? "ja" : "en",
      key: `top-${p.slug}`,
    });
  }
  const photo = resolveCoverImage(p);
  return photo
    ? `<span class="lat-photo"><img src="${esc(photo)}" alt="" loading="lazy"/></span>`
    : `<svg viewBox="0 0 ${COVER_WIDTH} ${COVER_HEIGHT}" preserveAspectRatio="xMidYMid slice" aria-hidden="true">${coverArtwork(p.category, p.slug)}</svg>`;
};

const postCardHtml = (p: BlogPost, label: string): string =>
  `<a href="${blogArticlePath(base, p.slug)}"><div class="card"><figure class="latimg">${postCoverHtml(p)}</figure><div class="cbody">
        <div class="lb">${esc(label)}</div>
        <b>${esc(clip(p.title, isJa ? 44 : 72))}</b>
        <span>${esc(clip(firstSentence(p.abstract), isJa ? 54 : 116))}${latSep}${LAT.readPost}</span>
      </div></div></a>`;

const briefCardHtml = (b: NonNullable<typeof latestBrief>): string => {
  // 見出しは og_lead（≈30〜45字の一文リード）を使う。Brief の title は
  // 「主題：詳細 — 補足」で長く、3列カードでは他の2枚と釣り合わないため。
  const lead = isJa
    ? (b.data.og_lead_ja ?? b.data.title)
    : (b.data.og_lead_en ?? b.data.title_en);
  // カバーは業界ページ枠2 と同じ生成カバー（lib/briefCover の C-3 プリセット・
  // 主役は番号）。版面は 1200x630 で、この枠は 16:9 なので切られ方も近い。
  const cover = briefCardSvg({
    no: String(b.data.brief_no).padStart(3, "0"),
    threat: categoryLabel(b.data.primary_category as CategorySlug, locale),
    locale: isJa ? "ja" : "en",
    key: `top-${b.id}`,
  });
  return `<a href="${base}/critical/briefs/${b.id}/"><div class="card"><figure class="latimg">${cover}</figure><div class="cbody">
        <div class="lb">${LAT.brief}</div>
        <b>${esc(clip(lead, isJa ? 62 : 104))}</b>
        <span>${LAT.briefLead}${latSep}${LAT.readBrief}</span>
      </div></div></a>`;
};

const latestHtml = [
  slot1 ? postCardHtml(slot1, LAT[slot1Label]) : "",
  latestBrief ? briefCardHtml(latestBrief) : "",
  pickedPost ? postCardHtml(pickedPost, LAT.blog) : "",
]
  .filter(Boolean)
  .join("\n      ");

/* ── 導入事例（2026-10-25）──────────────────────────────────────────
 * ファーストビューの上の帯と、強みの枠の下の1行。CLUBS for PUBLIC の LP と同じ置き方。
 * 相手先の社名は先方の許可が要るので出さず、自社の事例記事へ送る（記事からプレスリリースへ）。
 * 記事が無い言語では、どちらも出さない。 */
const CASE = isJa
  ? {
      k: "導入事例",
      bar: "上下水道の住民参加の現場で、住民の活動記録を、個人情報を出さずに証明",
      // スマホでは帯を1行に収めるため短い文に差し替える（CSS で出し分け）。
      barShort: "住民の活動記録を、個人情報を出さずに証明",
      link: "公共インフラの現場で、住民の活動記録を、個人情報を出さずに証明しています",
    }
  : {
      k: "Case study",
      bar: "Proving residents' activity records in public infrastructure, without exposing personal data",
      barShort: "Residents' activity records, proven without personal data",
      link: "In public infrastructure, residents' activity records are proven without exposing personal data",
    };
const caseHref = caseStudy ? blogArticlePath(base, caseStudy.slug) : "";
const caseDate = caseStudy ? caseStudy.date.replace(/\./g, "-").slice(0, 10) : "";
const caseBarHtml = caseStudy
  ? `<div class="casebar"><div class="in"><span class="k">${CASE.k}</span><time datetime="${caseDate}">${caseDate.replace(/-/g, ".")}</time><a href="${caseHref}" data-top-ev="top_case_bar"><span class="full">${esc(CASE.bar)}</span><span class="short">${esc(CASE.barShort)}</span> →</a></div></div>`
  : "";
const caseLinkHtml = caseStudy
  ? `<a class="kcase" href="${caseHref}"><span>${CASE.k}</span>${esc(CASE.link)}&nbsp;→</a>`
  : "";

/* ── Critical Brief の紹介（2026-10-25）──────────────────────────────
 * 「なぜ、いま」の下。事例として小さく見せるだけにし、詳しくは Brief で読んでもらう。
 * 3本は「なぜ、いま」の3枚と、5つの証明のどれで照合するかが分かるものを選んだ（手動）。
 * 件数・国の数・開始月はコレクションから数える（一覧ページと同じ数え方）。 */
const allBriefs = await getCollection("critical-briefs", isVisibleBrief);
const briefCount = allBriefs.length;
const briefCountries = new Set(
  allBriefs.flatMap((b) => (b.data.countries as string[] | undefined) ?? []).filter((c) => c !== "global"),
).size;
const briefSince = allBriefs.reduce(
  (min, b) => (b.data.published < min ? b.data.published : min),
  allBriefs[0]?.data.published ?? new Date(),
);
const BRIEF_PICKS = [
  {
    id: "044-arcadia-speecan-raiden-disaster-mail-spoofing",
    ja: ["なりすまし · 日本", "防災メールと同じ送信元で、<br>偽メールが届いた", "02 認証"],
    en: ["Impersonation · Japan", "A fake email arrived from the same sender as disaster alerts", "02 Authentication"],
  },
  {
    id: "130-atlassian-rovo-instruction-provenance",
    ja: ["AI の悪用 · 世界", "文書に隠した一文を、<br>AI が指示として実行しうる", "03 権限"],
    en: ["AI misuse · Global", "A line hidden in a document could be run by AI as an instruction", "03 Authority"],
  },
  {
    id: "035-boeing-787-inspection-records",
    ja: ["記録 · 米国", "検査は「完了」と記録されたが、<br>実施されていなかった", "01 来歴"],
    en: ["Records · US", "Inspections were recorded as complete but never performed", "01 Provenance"],
  },
] as const;
const BR = isJa
  ? {
      h: "サイバー攻撃と、AI・記録の事故を、毎週分析しています。",
      p: "公開された発表や一次資料から、何が起きたか、何を確認していれば気づけたかをまとめています。",
      st: `${briefCount} 本 ・ ${briefCountries} の国・地域 ・ ${briefSince.getFullYear()} 年 ${briefSince.getMonth() + 1} 月から毎週`,
      go: "Critical Brief を読む →",
      pf: "照合に使う証明",
    }
  : {
      h: "Cyber attacks, and AI and record failures, analyzed every week.",
      p: "From public disclosures and primary sources, we set out what happened and what check would have caught it.",
      st: `${briefCount} cases · ${briefCountries} countries and regions · weekly since ${briefSince.toLocaleString("en-US", { month: "long", year: "numeric" })}`,
      go: "Read Critical Brief →",
      pf: "Proof to match with",
    };
const briefsHtml = `<div class="bintro">
      <div class="bh"><div><span class="eyb">LEMMA CRITICAL BRIEF</span><h3>${BR.h}</h3><p>${BR.p}<span class="bst">${BR.st}</span></p></div><a class="go" href="${base}/critical/briefs/">${BR.go}</a></div>
      <div class="bcs">${BRIEF_PICKS.filter((p) => allBriefs.some((b) => b.id === p.id))
        .map((p) => {
          const [tag, title, proof] = isJa ? p.ja : p.en;
          return `<a class="bc" href="${base}/critical/briefs/${p.id}/"><span class="bt">${tag}</span><b>${title}</b><span class="bp">${BR.pf}<i>${proof}</i></span></a>`;
        })
        .join("")}</div>
    </div>`;

const body = (isJa ? bodyJa : bodyEn)
  .replace("<!--CASEBAR-->", caseBarHtml)
  .replace("<!--TICKER-->", tickerHtml + selfCheckTickerHtml)
  .replace("<!--BRIEFS-->", briefsHtml)
  .replace("<!--CASELINK-->", caseLinkHtml)
  .replace("<!--LATEST-->", latestHtml);

const API_BASE = "https://workers.lemma.workers.dev/v1";
const VERIFY_PATH = `${base}/verify/`;

// レジストリ表記は /verify/ の VerifyAnchorTemplate と揃える（指示 §3.1）。
const REG = isJa
  ? {
      perr: "レジストリに到達できません。推定値では埋めません。",
      numLocale: "ja-JP",
      timeLocale: "ja-JP",
      live: "LIVE",
      offline: "OFFLINE",
    }
  : {
      perr: "The registry is unreachable. We do not fill in estimates.",
      numLocale: "en-US",
      timeLocale: "en-US",
      live: "LIVE",
      offline: "OFFLINE",
    };

/* 検索結果の見出しと説明（2026-10-25）。見出しはプレスリリースと強みの枠の言葉
   「データを渡さずに、本物を証明する」にそろえる。説明は何を・誰が検証できるかを先に置き、
   5つの証明と Critical Brief の名前を入れる（JA は 120 字以内）。 */
const metaTitle = isJa
  ? "Lemma｜データを渡さずに、本物を証明する基盤"
  : "Lemma | Prove what's real, without handing over the data";
const metaDescription = isJa
  ? "本物に見えるログインや支払い、記録、配信を、実行する前に照合する「実行前照合」の基盤です。暗号技術の証明で、受け取った側が自分で検証できます。来歴・認証・権限・推論・属性の5つの証明を、データを渡さずに。事案分析 Critical Brief も毎週公開。"
  : "Lemma is a pre-execution check: logins, payments, records, and publishing that look genuine are checked before they run, with cryptographic proofs the receiver verifies on its own — provenance, authentication, authority, inference, and attributes, without handing over the data. Plus Critical Brief, a weekly analysis of real incidents.";

/* カードに出る文。`metaDescription` は検索向けに語彙を積んであるので、SNS では
   硬く読める（しかもこの画像は専用 OG を持たない全ページの既定でもある）。
   ヒーローのサブリードとフッターの確定コピーから起こした文をカードにだけ出す。
   検索用の文は v47 の方針どおり据え置き。 */
const ogDescription = isJa
  ? "本物に見えても、通す前に照合する。ログイン、支払い、記録の受け渡し、配信を、実行する前に照合します。発行は一度。検証は、無料で何度でも。"
  : "Looks genuine? Check before it runs. Logins, payments, record handoffs, and publishing are checked before execution. Issue once. Verify free, any number of times.";
---

<Layout
  locale={locale}
  metaType="home"
  title={metaTitle}
  description={metaDescription}
  ogDescription={ogDescription}
  ogImage={`https://lemma.frame00.com/og/home/${locale}.png`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />
  <main class="topx" set:html={body} />
  {/* スマホだけの相談のバー（2026-10-25）。ヒーローを過ぎたら出し、下へ読む間は隠す。
      業界の段より下では出したまま、締めの CTA が見えている間は隠す。 */}
  <div class="topbar" id="topbar" aria-hidden="true">
    <a href={isJa ? "https://tally.so/r/EkBqDX?source=top_bar" : "https://tally.so/r/Pd2Rl5?source=top_bar"} data-top-ev="top_bar_enterprise" tabindex="-1">
      {isJa ? "エンタープライズ相談" : "Enterprise consultation"}
    </a>
  </div>
  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />

  <script is:inline define:vars={{ API_BASE, VERIFY_PATH, REG }}>
    (function () {
      /* ---- ファーストビューの入口（押された数を GA へ・DESIGN.md「トップのファーストビュー」） ---- */
      document.querySelectorAll("[data-top-ev]").forEach(function (a) {
        a.addEventListener("click", function () {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", a.getAttribute("data-top-ev"), { destination: a.getAttribute("href") });
        });
      });

      var reduced =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ---- スマホの相談のバー（表示は CSS で 700px 以下だけ） ---- */
      (function () {
        var bar = document.getElementById("topbar");
        var hero = document.querySelector(".topx .herodark");
        var cta = document.querySelector(".topx .cta");
        var late = document.querySelector(".topx .ucgrid");
        if (!bar || !hero || !("IntersectionObserver" in window)) return;
        var heroIn = true,
          ctaIn = false,
          lastY = window.scrollY,
          down = false;
        function update() {
          var pastLate = late && late.getBoundingClientRect().top < window.innerHeight;
          var on = !heroIn && !ctaIn && (!down || pastLate);
          bar.classList.toggle("on", on);
          bar.setAttribute("aria-hidden", String(!on));
          bar.firstElementChild.tabIndex = on ? 0 : -1;
        }
        new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.target === hero) heroIn = e.isIntersecting;
            else ctaIn = e.isIntersecting;
          });
          update();
        }).observe(hero);
        if (cta)
          new IntersectionObserver(function (es) {
            ctaIn = es[0].isIntersecting;
            update();
          }).observe(cta);
        window.addEventListener(
          "scroll",
          function () {
            var y = window.scrollY;
            down = y > lastY;
            lastY = y;
            update();
          },
          { passive: true },
        );
      })();

      /* ---- レジストリ実数（/verify/ と同じ GET /v1/counters・同じ数え方の宣言） ---- */
      (function () {
        var V = document.getElementById("vcount"),
          /* スマホのヒーローに出す1行（パネルはスマホでは隠す） */
          VL = document.getElementById("vcl"),
          I = document.getElementById("icount"),
          S = document.getElementById("vsub"),
          U = document.getElementById("vup");
        if (!V) return;
        var head = document.getElementById("phead");
        var chip = document.getElementById("plive");
        function off() {
          V.textContent = "———";
          V.style.fontSize = "";
          I.textContent = "—";
          I.style.fontSize = "";
          V.classList.add("off");
          S.textContent = REG.perr;
          U.textContent = "—";
          if (head) head.classList.add("offline");
          if (chip) chip.textContent = REG.offline;
        }
        function num(n) {
          return (n || 0).toLocaleString(REG.numLocale);
        }
        /* 桁数に合わせて字を詰める。
           .bignum の clamp() は画面幅しか知らないので、検証済み証明数が 100万
           （区切り込み9文字）に乗った時点でパネル幅を超え、overflow:hidden の
           .rpanel に末尾が切られていた。文字幅はフォントサイズに比例するので、
           はみ出し比 (clientWidth/scrollWidth) をそのまま掛けて縮める。以降
           1000万・1億と桁が増えても同じ理屈で収まる。 */
        function fit(el) {
          el.style.fontSize = "";
          var avail = el.clientWidth;
          if (!avail) return;
          var need = el.scrollWidth;
          if (need <= avail) return;
          var base = parseFloat(getComputedStyle(el).fontSize);
          el.style.fontSize = Math.floor((base * avail) / need) + "px";
        }
        /* 読み込み時に数字が上がる (検証センター /verify/ と同じ 1300ms・cubic-out)。
           reduced-motion では最終値を直接出す。 */
        function countUp(el, to) {
          /* 先に最終値を入れて幅を決める。tabular-nums なので途中値の幅は
             最終値を超えず、アニメーション中に字が揺れない。 */
          el.textContent = num(to);
          fit(el);
          if (reduced) return;
          var t0 = performance.now(),
            dur = 1300,
            from = Math.max(0, to - Math.min(to, 600));
          (function f(t) {
            var p = Math.min(1, (t - t0) / dur),
              e = 1 - Math.pow(1 - p, 3);
            el.textContent = num(Math.round(from + (to - from) * e));
            if (p < 1) requestAnimationFrame(f);
          })(t0);
        }
        function fmtTime(s) {
          if (!s) return "—";
          var d = new Date(s.indexOf("T") >= 0 ? s : s.replace(" ", "T") + "Z");
          if (isNaN(d.getTime())) return "—";
          return d.toLocaleString(REG.timeLocale, {
            month: "numeric",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          });
        }
        var first = true;
        function load() {
          fetch(API_BASE + "/counters", { headers: { accept: "application/json" } })
            .then(function (r) {
              if (!r.ok) throw 0;
              return r.json();
            })
            .then(function (d) {
              var v = d && d.verified,
                s = d && d.issued;
              if (!v || typeof v.count !== "number") throw 0;
              V.classList.remove("off");
              var hasIssued = s && typeof s.count === "number";
              if (VL) VL.textContent = num(v.count);
              if (first) {
                countUp(V, v.count);
                if (hasIssued) countUp(I, s.count);
                first = false;
              } else {
                V.textContent = num(v.count);
                fit(V);
                if (hasIssued) I.textContent = num(s.count);
              }
              /* 内訳はトップでは出さない（pfoot の「内訳を見る →」＝ /verify/ が正）。
                 #vsub はエラー行専用なので、成功したら空に戻す。 */
              S.textContent = "";
              U.textContent = fmtTime(v.updatedAt);
              if (head) head.classList.remove("offline");
              if (chip) chip.textContent = REG.live;
            })
            .catch(function () {
              /* 初回失敗は推定で埋めずエラー表示。2回目以降は直近の実数を残したまま
                 ヘッダーだけ OFFLINE に落とす (LAST UPDATED が鮮度を示す)。 */
              if (first) {
                off();
              } else {
                if (head) head.classList.add("offline");
                if (chip) chip.textContent = REG.offline;
              }
            });
        }
        load();
        setInterval(load, 45000);
        /* 幅が変われば clamp() の基準も変わるので、測り直す。 */
        var refitTimer;
        window.addEventListener("resize", function () {
          clearTimeout(refitTimer);
          refitTimer = setTimeout(function () {
            fit(V);
          }, 150);
        });
      })();

      /* ---- ヒーロー第2CTA に実在の docHash を埋める ----
         (イベントストリームは撤去。フィード名まではトップで出さない) */
      (function () {
        fetch(API_BASE + "/suites/feeds/forex/composite/latest", {
          headers: { accept: "application/json" },
        })
          .then(function (r) {
            if (!r.ok) throw 0;
            return r.json();
          })
          .then(function (j) {
            if (!j || !j.docHash || !/^0x[0-9a-fA-F]+$/.test(j.docHash)) return;
            var href = VERIFY_PATH + "?doc=" + encodeURIComponent(j.docHash);
            [].forEach.call(document.querySelectorAll(".js-doclink"), function (a) {
              a.href = href;
            });
          })
          .catch(function () {
            /* 失敗時は /verify/ のまま（フォールバック） */
          });
      })();

      /* ---- 「だから」の締め帯をスクロールで浮かせる ---- */
      (function () {
        var el = document.getElementById("sostmt");
        if (!el) return;
        if (reduced || !("IntersectionObserver" in window)) {
          el.classList.add("on");
          return;
        }
        var io = new IntersectionObserver(
          function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("on");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.35 },
        );
        io.observe(el);
      })();

      /* ---- フィールドスイープ（左→右のみ・reduced-motion では全件チェック済みで静止） ---- */
      (function () {
        var stage = document.getElementById("fieldstage"),
          sweep = document.getElementById("sweep");
        if (!stage || !sweep) return;
        var FCOLS = 9,
          FROWS = 6,
          items = [];
        for (var r = 0; r < FROWS; r++)
          for (var c = 0; c < FCOLS; c++) {
            var el = document.createElement("div");
            var real = Math.random() < 0.2;
            el.className = "fitem " + (real ? "real" : "fake");
            if (real)
              el.innerHTML =
                '<span class="fmark"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.4 6.3 L4.9 8.8 L9.6 3.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>';
            var x = 4 + c * (90 / (FCOLS - 1));
            el.style.left = x + "%";
            el.style.top = 6 + r * (78 / (FROWS - 1)) + "%";
            stage.appendChild(el);
            items.push({ el: el, real: real, x: x });
          }
        var sx = 0,
          scanned = 0,
          reals = 0;
        var RC = document.getElementById("realcount"),
          SC = document.getElementById("scancount");
        function step() {
          sx += 0.42;
          if (sx > 104) {
            sx = 0;
            scanned = 0;
            reals = 0;
            items.forEach(function (i) {
              i.el.classList.remove("checked");
            });
            if (SC) SC.textContent = 0;
            if (RC) RC.textContent = 0;
          }
          sweep.style.left = sx + "%";
          items.forEach(function (i) {
            if (!i.el.classList.contains("checked") && i.x < sx) {
              i.el.classList.add("checked");
              scanned++;
              if (i.real) {
                reals++;
                if (RC) RC.textContent = reals;
              }
              if (SC) SC.textContent = scanned;
            }
          });
        }
        if (!reduced) {
          setInterval(step, 40);
        } else {
          items.forEach(function (i) {
            i.el.classList.add("checked");
            if (i.real) reals++;
            scanned++;
          });
          if (RC) RC.textContent = reals;
          if (SC) SC.textContent = scanned;
          sweep.style.display = "none";
        }
      })();

      /* ---- ムービー: 進入時に再生・シーン要約と連動（連動しなくても全行読める） ---- */
      (function () {
        var ids = ["01", "02", "03", "04"];
        window.addEventListener("message", function (e) {
          var d = e.data;
          if (!d || d.type !== "lemma:film:scene") return;
          var n = String(d.scene).padStart(2, "0");
          if (ids.indexOf(n) < 0) return;
          ids.forEach(function (i) {
            var el = document.getElementById("scn-" + i);
            if (el) el.classList.toggle("on", i === n);
          });
        });

        var f = document.getElementById("film");
        if (!f) return;
        function post(cmd) {
          try {
            f.contentWindow.postMessage({ type: "lemma:film:" + cmd }, "*");
          } catch (err) {
            /* iframe 未準備なら load 側で再送する */
          }
        }

        /* ---- 01〜04 を押すと、そのシーンの頭から見せる ----
           ムービーは1周で 04 の完成状態のまま止まる作りなので、気になった場面へ
           戻る手段が無かった。要約カード自体を押せるようにする（数字だけより的が
           大きい）。div なので role/tabindex とキー操作を自分で付ける。
           reduced-motion では動かさず、その場面の静止画に切り替えるだけにする。 */
        ids.forEach(function (id, idx) {
          var card = document.getElementById("scn-" + id);
          if (!card) return;
          card.setAttribute("role", "button");
          card.setAttribute("tabindex", "0");
          card.setAttribute("aria-controls", "film");
          card.classList.add("tappable");
          var jump = function () {
            try {
              f.contentWindow.postMessage(
                { type: "lemma:film:goto", scene: idx + 1, play: !reduced },
                "*",
              );
            } catch (err) {
              /* iframe 未準備なら何も起きない。押し直せばよい */
            }
            /* 選択状態は押した瞬間に出す（ムービーからの通知も来るが体感を先に） */
            ids.forEach(function (x) {
              var n = document.getElementById("scn-" + x);
              if (n) n.classList.toggle("on", x === id);
            });
            /* ムービーが画面外だと、再生しても見えない。半分以上隠れていたら寄せる */
            var r = f.getBoundingClientRect();
            var vh = window.innerHeight || 0;
            var shown = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
            if (r.height > 0 && shown / r.height < 0.6) {
              f.scrollIntoView({
                behavior: reduced ? "auto" : "smooth",
                block: "center",
              });
            }
          };
          card.addEventListener("click", jump);
          card.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " " || e.key === "Spacebar") {
              e.preventDefault();
              jump();
            }
          });
        });

        /* reduced-motion では自動再生しない（ムービー側は 01 の完成状態で静止） */
        if (reduced) return;
        /* iframe の読み込みは非同期: 進入フラグと load の両方で play を送る */
        var want = false,
          ready = false;
        f.addEventListener("load", function () {
          ready = true;
          if (want) post("play");
        });
        if (!("IntersectionObserver" in window)) {
          want = true;
          post("play");
          return;
        }
        var io = new IntersectionObserver(
          function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting) {
                want = true;
                /* すでに読み込み済みのときはここで届く。未読込なら load 側で再送 */
                post("play");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.4 },
        );
        io.observe(f);
      })();
    })();
  </script>
</Layout>
