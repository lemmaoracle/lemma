---
/**
 * Plan page for the enterprise segments — Civic / Critical / Compliance.
 * One template for all three plans × both locales: thin page wrappers
 * (pages/{ja/,}plans/<key>/) pass locale/t/base/planKey in; copy comes from
 * data/plans.ts via getPlanContent(planKey, locale).
 *
 * Buyer-facing, product-fit framing, FDE-led (talk first), pricing on request
 * (no ¥ / no figures).
 *
 * Permission gate: PRE-permission at launch. The MizuDAkO engagement must not
 * appear anywhere —
 *   - no achievement badge in the hero
 *   - §6 shows an "illustrative scenario" (NOT a case study); no client- or
 *     site-identifying context
 * After permission (press-release linked) the badge + a real case study replace
 * those; see the "POST-permission:" comments. Identifying wording lives in the
 * spec, never in this source.
 *
 * Accent = saddle brown #8B4513 (matches the global --accent).
 * Locale typography: JA uses Noto Sans JP + slightly looser line-heights (the
 * base rules below); EN overrides font → Sora and tightens line-heights in the
 * single `:root[lang="en"] .cv-page` block — the only intentional locale diffs.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import CivicIcon, { type CivicIconName } from "../components/civic/CivicIcon.astro";
import PlanPriceModule from "../components/pricing/PlanPriceModule.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { getPlanContent, type PlanKey } from "../data/plans";

interface Props {
  locale: Locale;
  t: Translations;
  base: string;
  planKey: PlanKey;
}

const { locale, t, base, planKey } = Astro.props as Props;

// ?plan= lets the Tally form (EkBqDX) record which plan page the inquiry
// came from. planKey is one of civic / critical / compliance.
const contactUrl = `${DISCOVERY_CALL_URL[locale]}?plan=${planKey}`;
const useCasesUrl = `${base}/solutions/use-cases/`;
const C = getPlanContent(planKey, locale);

// §2 capability icons are per-plan (carried on each doItem). The flow icons
// are the same shape for every plan, so they stay here, zipped by index.
const flowIcons: readonly CivicIconName[] = ["inbox", "shield-check", "database"];

// ─── SEO: page-specific structured data (Layout already emits Organization +
// WebSite globally; here we add the plan as a Service + a breadcrumb). ───
const SITE = "https://lemma.frame00.com";
const planUrl = `${SITE}${base}/plans/${planKey}/`;
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: C.hero.name,
  serviceType: C.hero.seg,
  description: C.meta.desc,
  provider: { "@type": "Organization", "@id": `${SITE}/#organization`, name: "Lemma" },
  ...(locale === "ja" ? { areaServed: "JP" } : {}),
  url: planUrl,
  inLanguage: locale,
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Lemma", item: `${SITE}${base || ""}/` },
    { "@type": "ListItem", position: 2, name: C.hero.badgeTag, item: `${SITE}${base}/pricing/` },
    { "@type": "ListItem", position: 3, name: C.hero.name, item: planUrl },
  ],
};
---

<Layout
  locale={locale}
  title={C.meta.title}
  description={C.meta.desc}
  metaType="page"
  pagePath={`/plans/${planKey}/`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="cv-page">
    <div class="cv-container">

      <!-- §1 HERO -->
      <section class="cv-hero">
        <div class="cv-hero-tags">
          <span class="cv-hero-badge">
            <span class="cv-hero-badge-tag">{C.hero.badgeTag}</span>
            <span class="cv-hero-badge-name">{C.hero.name}</span>
          </span>
          <span class="cv-hero-seg">{C.hero.seg}</span>
        </div>
        <h1 class="cv-h1">
          {C.hero.h1a}<br />
          <span class="cv-accent">{C.hero.h1b}</span>
        </h1>
        <p class="cv-lead">{C.hero.lead}</p>
        <div class="cv-hero-cta">
          <a href={contactUrl} class="cv-btn-primary" target="_blank" rel="noopener">{C.hero.ctaLabel}</a>
          <span class="cv-hero-cta-note">{C.hero.ctaNote}</span>
        </div>
        {/*
          POST-permission: only when press-release-linked, place the achievement
          badge here. Pre-permission it is omitted to avoid identifying the
          engagement. Wording lives in the Wave 1 spec, not in this source.
        */}
      </section>

      <!-- §2 What this plan does -->
      <section class="cv-section" aria-labelledby="cv-do-h">
        <p class="cv-section-label">{C.doSec.label}</p>
        <h2 class="cv-section-h" id="cv-do-h">{C.doSec.h}</h2>
        <div class="cv-do-grid">
          {C.doSec.items.map((item) => (
            <article class="cv-do-card">
              <span class="cv-do-icon"><CivicIcon name={item.icon} size={28} /></span>
              <h3 class="cv-do-h3">{item.h}</h3>
              <p class="cv-do-p">{item.p}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- §3 Bridge -->
      <section class="cv-bridge">
        <span class="cv-bridge-icon"><CivicIcon name="shield-check" size={32} color="#F5EBDC" /></span>
        <blockquote class="cv-bridge-quote">{C.bridge.quote}</blockquote>
        <p class="cv-bridge-body">{C.bridge.body}</p>
      </section>

      <!-- §4 How it works -->
      <section class="cv-section" aria-labelledby="cv-flow-h">
        <p class="cv-section-label">{C.flow.label}</p>
        <h2 class="cv-section-h" id="cv-flow-h">{C.flow.h}</h2>
        <ol class="cv-flow-grid">
          {C.flow.items.map((item, i) => (
            <li class="cv-flow-card">
              <span class="cv-flow-head">
                <CivicIcon name={flowIcons[i]} size={22} />
                <span class="cv-flow-n">{item.n} {item.h}</span>
              </span>
              <h3 class="cv-flow-h3">{item.lead}</h3>
              <p class="cv-flow-p">{item.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- §5 Who it's for & plan structure -->
      <section class="cv-section cv-tiers" aria-labelledby="cv-tiers-h">
        <p class="cv-section-label">{C.tiers.label}</p>
        <h2 class="cv-section-h" id="cv-tiers-h">{C.tiers.h}</h2>
        <p class="cv-tiers-body">{C.tiers.body}</p>
        <div class="cv-tiers-grid">
          {C.tiers.items.map((tier) => (
            <div class="cv-tier-card">
              <span class="cv-tier-name">{tier.name}</span>
              <span class="cv-tier-range">{tier.range}</span>
            </div>
          ))}
        </div>
        <p class="cv-tiers-note">{C.tiers.note}</p>
      </section>

      {/* プランと価格モジュール（v13・確定）— 選び方・価格 */}
      <section class="cv-section cv-price-module" aria-label="プランと価格">
        <PlanPriceModule locale={locale} />
      </section>

      {/* §6 Use case (pre-permission = illustrative scenario).
          POST-permission (press-release linked): replace with a real case study —
          wording lives in the Wave 1 spec §6 (identifying context is withheld
          pre-permission, so it is not written here). JSX comment → not emitted to HTML. */}
      <section class="cv-case" aria-labelledby="cv-case-h">
        <span class="cv-case-label">{C.caseSec.label}</span>
        <h2 class="cv-case-h" id="cv-case-h">{C.caseSec.h}</h2>
        <p class="cv-case-body">{C.caseSec.body}</p>
      </section>

      <!-- §7 How we engage -->
      <section class="cv-section" aria-labelledby="cv-steps-h">
        <p class="cv-section-label">{C.steps.label}</p>
        <h2 class="cv-section-h" id="cv-steps-h">{C.steps.h}</h2>
        <ol class="cv-steps-grid">
          {C.steps.items.map((step) => (
            <li class="cv-step-card">
              <span class="cv-step-n">{step.n}</span>
              <h3 class="cv-step-h3">{step.h}</h3>
              <p class="cv-step-lead">{step.lead}</p>
              <p class="cv-step-p">{step.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- §8 Use cases in this plan -->
      <section class="cv-uc" aria-labelledby="cv-uc-h">
        <p class="cv-section-label">{C.uc.label}</p>
        <h2 class="cv-section-h" id="cv-uc-h">{C.uc.h}</h2>
        <ul class="cv-uc-list">
          {C.uc.items.map((item) => (
            <li class="cv-uc-item">{item}</li>
          ))}
        </ul>
        <a href={useCasesUrl} class="cv-uc-all">{C.uc.all}</a>
      </section>

      <!-- §9 Close -->
      <section class="cv-close">
        <div class="cv-close-band">
          <h2 class="cv-close-h2">{C.close.h}</h2>
          <p class="cv-close-sub">{C.close.sub}</p>
          <a href={contactUrl} class="cv-btn-primary" target="_blank" rel="noopener">{C.hero.ctaLabel}</a>
        </div>
      </section>

    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* Base = JA typography. EN overrides font + line-heights in the single
     `:root[lang="en"] .cv-page` block at the end — the only locale diffs. */
  .cv-page {
    --cv-display: var(--font-display);
    --cv-body: "Noto Sans JP", system-ui, sans-serif;
    --cv-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --cv-text-1: #1a1a1a;
    --cv-text-2: #3a3a3a;
    --cv-text-3: #5a5a5a;
    --cv-text-4: #9a9a9a;
    background: var(--lemma-cream);
    color: var(--cv-text-2);
    font-family: var(--cv-body);
    font-weight: 400;
    line-height: 1.7;
    margin-top: 64px;
    padding: 0 0 24px;
  }

  .cv-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .cv-accent { color: var(--accent); }

  /* ─── shared section heads ─── */
  .cv-section-label {
    font-family: var(--cv-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cv-section-label::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .cv-section-h {
    font-family: var(--cv-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }

  /* ─── §1 HERO ─── */
  .cv-hero {
    padding: 72px 0 56px;
  }
  .cv-hero-tags {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 26px;
  }
  .cv-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--lemma-brown-light);
    border: 1px solid rgba(139, 69, 19, 0.22);
    padding: 7px 8px 7px 14px;
    border-radius: 999px;
    box-shadow: 0 2px 10px rgba(139, 69, 19, 0.08);
  }
  .cv-hero-badge-tag {
    font-family: var(--cv-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.75;
    border-right: 1px solid rgba(139, 69, 19, 0.28);
    padding-right: 10px;
  }
  .cv-hero-badge-name {
    font-family: var(--cv-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--lemma-cream);
    background: var(--accent);
    padding: 3px 12px;
    border-radius: 999px;
  }
  .cv-hero-seg {
    font-family: var(--cv-display);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--cv-text-3);
  }
  .cv-h1 {
    font-family: var(--cv-display);
    font-size: clamp(32px, 5vw, 50px);
    font-weight: 700;
    line-height: 1.22;
    color: var(--black);
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    max-width: 920px;
  }
  .cv-lead {
    font-size: 16px;
    color: var(--cv-text-2);
    line-height: 1.9;
    margin: 0 0 32px;
    max-width: 720px;
  }
  .cv-hero-cta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .cv-hero-cta-note {
    font-size: 12.5px;
    color: var(--cv-text-3);
  }

  /* ─── primary button ─── */
  .cv-btn-primary {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--lemma-cream);
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 14px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.18s;
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.18);
  }
  .cv-btn-primary:hover { background: #6e3610; }

  /* ─── generic section spacing ─── */
  .cv-section {
    padding: 56px 0;
    border-top: 0.5px solid var(--lemma-line);
  }

  /* ─── §2 cards ─── */
  .cv-do-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .cv-do-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 28px 26px;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cv-do-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(139, 69, 19, 0.06);
  }
  .cv-do-icon {
    display: block;
    line-height: 0;
    margin: 0 0 14px;
  }
  .cv-do-h3 {
    font-family: var(--cv-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .cv-do-p {
    font-size: 14px;
    color: var(--cv-text-3);
    line-height: 1.8;
    margin: 0;
  }

  /* ─── §3 bridge ─── */
  .cv-bridge {
    margin: 0;
    padding: 64px 40px;
    background: #0f0f0f;
    color: var(--lemma-cream);
    border-radius: 20px;
    text-align: center;
  }
  .cv-bridge-icon {
    display: inline-flex;
    line-height: 0;
    margin: 0 0 10px;
  }
  .cv-bridge-quote {
    font-family: var(--cv-display);
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--lemma-cream);
    margin: 0 0 20px;
  }
  .cv-bridge-body {
    font-size: 15px;
    line-height: 1.95;
    color: rgba(252, 250, 245, 0.72);
    margin: 0 auto;
    max-width: 660px;
  }

  /* ─── §4 / §7 numbered steps ─── */
  .cv-flow-grid,
  .cv-steps-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .cv-flow-card,
  .cv-step-card {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    padding: 26px 24px;
  }
  .cv-flow-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
    line-height: 0;
  }
  .cv-flow-head .cv-flow-n {
    margin: 0;
  }
  .cv-flow-n,
  .cv-step-n {
    font-family: var(--cv-mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    display: block;
    line-height: 1.3;
    margin: 0 0 14px;
  }
  .cv-flow-h3,
  .cv-step-h3 {
    font-family: var(--cv-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 6px;
  }
  .cv-step-lead {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--cv-text-2);
    margin: 0 0 8px;
  }
  .cv-flow-p,
  .cv-step-p {
    font-size: 13px;
    color: var(--cv-text-3);
    line-height: 1.75;
    margin: 0;
  }

  /* ─── §5 tiers ─── */
  .cv-tiers-body {
    font-size: 15px;
    color: var(--cv-text-2);
    line-height: 1.9;
    margin: 0 0 28px;
    max-width: 760px;
  }
  .cv-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin: 0 0 22px;
  }
  .cv-tier-card {
    background: var(--lemma-cream-deep);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cv-tier-name {
    font-family: var(--cv-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cv-tier-range {
    font-family: var(--cv-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--black);
  }
  .cv-tiers-note {
    font-size: 12.5px;
    color: var(--cv-text-3);
    line-height: 1.8;
    margin: 0;
  }

  /* ─── §6 case ─── */
  .cv-case {
    margin: 56px 0;
    padding: 40px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 18px;
    position: relative;
    overflow: hidden;
  }
  .cv-case::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .cv-case-label {
    display: inline-flex;
    font-family: var(--cv-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lemma-cream);
    background: var(--accent);
    padding: 4px 11px;
    border-radius: 999px;
    margin: 0 0 16px;
  }
  .cv-case-h {
    font-family: var(--cv-display);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .cv-case-body {
    font-size: 14.5px;
    color: var(--cv-text-2);
    line-height: 1.9;
    margin: 0;
    max-width: 720px;
  }

  /* ─── §8 use cases ─── */
  .cv-uc-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 10px;
  }
  .cv-uc-item {
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 14px;
    color: var(--cv-text-2);
    line-height: 1.6;
  }
  .cv-uc-all {
    font-family: var(--cv-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(139, 69, 19, 0.4);
    transition: color 0.15s, border-color 0.15s;
  }
  .cv-uc-all:hover { color: #6e3610; border-color: var(--accent); }

  /* ─── §9 close ─── */
  .cv-close {
    padding: 72px 0 0;
    border-top: 0.5px solid var(--lemma-line);
    text-align: center;
  }
  .cv-close-band {
    margin: 0 0 40px;
    padding: 52px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }
  .cv-close-band::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 96px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 3px;
  }
  .cv-close-h2 {
    font-family: var(--cv-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.35;
    letter-spacing: -0.025em;
    margin: 0 0 14px;
  }
  .cv-close-sub {
    font-size: 14.5px;
    color: var(--cv-text-2);
    line-height: 1.8;
    margin: 0 auto 28px;
    max-width: 540px;
  }

  /* ─── EN typography overrides (intentional locale diffs — the only place
         the two locales diverge stylistically) ─── */
  :root[lang="en"] .cv-page { --cv-body: "Noto Sans JP", system-ui, sans-serif; }
  :root[lang="en"] .cv-page .cv-h1 { line-height: 1.12; }
  :root[lang="en"] .cv-page .cv-section-h,
  :root[lang="en"] .cv-page .cv-case-h { line-height: 1.3; }
  :root[lang="en"] .cv-page .cv-do-h3,
