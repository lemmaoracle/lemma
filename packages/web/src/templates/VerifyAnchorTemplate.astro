    --ok-ink: #6f9c00;
    --ok-light: #4e7a00;
    --err: #c25438;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --dline: #e7eae5;
    --font-serif-jp: "Noto Serif JP", "Cormorant Garamond", Georgia, serif;
    --font-body: "Noto Sans JP", "Hiragino Sans", sans-serif;
