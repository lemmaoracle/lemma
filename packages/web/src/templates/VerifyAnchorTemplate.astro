---
/**
 * 検証センター — 照合クレジット（「独立した証明基盤 Lemma に固定されています」）
 * の受け皿。`/verify/`（EN）と `/ja/verify/`（JA）。
 *
 * SSL 証明書モデル：「発行者は誰か・何を意味するか」を1枚のステータスカードで
 * 即答し、詳細（検証境界の全文・独立性の論・技術根拠）はサイトの各ページへ
 * 「詳しく →」で送る。第1層で受信者は完結し、第三者性を確認したい人だけ
 * 1クリック奥へ、という照合ページ改修提案 改修3 の設計方針。
 *
 * 内訳カウンターは証明書には載せない。証明書は1件の来歴、内訳は Lemma 全体の
 * 実績で別オブジェクト（SSL の証明書と Certificate Transparency ログの関係）
 * なので、カード外の独立した「検証の透明性」セクションに置く。
 *
 * 用語・文体・非加飾の規律：対外名は「AI証明基盤 / proof layer」。照合＝当事者・
 * 検証＝第三者・証明＝Lemma。JA ですます調。ロゴ/バッジ/ホロは使わない。
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import VerificationCounter from "../components/VerificationCounter.astro";

export interface VerifyAnchorTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, t, base } = Astro.props as VerifyAnchorTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => `${base}${path}`;

const C = isJa
  ? {
      metaTitle:
        "検証センター — 照合記録は独立した証明基盤 Lemma に固定されています｜Lemma",
      metaDescription:
        "CLUBS 等の照合記録は、記録の当事者から独立した AI証明基盤 Lemma に固定されています。発行者・検証境界を1枚で確認できます。",
      eyebrow: "検証センター",
      status: "この記録は Lemma に固定されています",
      statusSub: "独立した証明基盤（proof layer）が来歴を固定しています",
      rows: [
        { k: "発行者", v: "Lemma — 記録の当事者から独立した証明基盤" },
        { k: "✓ が意味すること", v: "記録が発行時点から改ざんされていないこと" },
        { k: "✓ が意味しないこと", v: "内容の品質や、判断の正しさそのもの" },
        { k: "3語の分業", v: "照合＝当事者／検証＝第三者／証明＝Lemma" },
      ],
      note: "✓ は実行ログ・入金データとの一致のみを意味します。中身の良し悪しを保証するものではありません。",
      moreLabel: "詳しく",
      more: [
        { label: "検証境界と独立性", href: L("/authenticity/") },
        { label: "四本柱（5つの証明）", href: L("/pillars/") },
      ],
      transparencyHeading: "検証の透明性",
      transparencyLead:
        "個別の証明書ではなく、Lemma 全体でこれまでに検証・発行した記録の内訳です。合計ではなく、どこ由来かを多い順に開示します。数字は表示のたびにレジストリから取得しています。",
    }
  : {
      metaTitle:
        "Verification Center — verification records are anchored on Lemma, an independent proof layer | Lemma",
      metaDescription:
        "Verification records from services like CLUBS are anchored on Lemma, a proof layer independent of the record's authors. See the issuer and the verification boundary at a glance.",
      eyebrow: "Verification Center",
      status: "This record is anchored on Lemma",
      statusSub: "An independent proof layer anchors its provenance",
      rows: [
        { k: "Issued by", v: "Lemma — a proof layer independent of the record's authors" },
        { k: "The check confirms", v: "the record has not been altered since it was issued" },
        { k: "It does not confirm", v: "the quality of the contents or the correctness of the judgment" },
        { k: "The three roles", v: "Matching = the party · Verification = any third party · Proof = Lemma" },
      ],
      note: "The check means only that the record matches the execution logs or settlement data. It does not guarantee the merit of the contents.",
      moreLabel: "In depth",
      more: [
        { label: "The verification boundary and independence", href: L("/authenticity/") },
        { label: "The Four Pillars (five proofs)", href: L("/pillars/") },
      ],
      transparencyHeading: "Verification transparency",
      transparencyLead:
        "Not a single certificate — the breakdown of everything Lemma has verified and issued, ranked by source rather than summed. Read from the registry on every view.",
    };
---

<Layout
  locale={locale}
  title={C.metaTitle}
  description={C.metaDescription}
  metaType="page"
  pagePath="/verify/"
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="vc-page">
    <div class="vc-container">
      <div class="vc-eyebrow">{C.eyebrow}</div>

      <div class="vc-cert" role="group" aria-label={C.status}>
        <div class="vc-cert-head">
          <span class="vc-check" aria-hidden="true">✓</span>
          <div>
            <div class="vc-status">{C.status}</div>
            <div class="vc-status-sub">{C.statusSub}</div>
          </div>
        </div>
        <dl class="vc-rows">
          {C.rows.map((r) => (
            <div class="vc-row">
              <dt>{r.k}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <p class="vc-note">{C.note}</p>

      {/* カードの主張を掘る導線。証明書とセットの「詳しく」で、透明性ログとは別。 */}
      <nav class="vc-more" aria-label={C.moreLabel}>
        <span class="vc-more-label">{C.moreLabel}</span>
        <ul>
          {C.more.map((m) => (
            <li><a href={m.href}>{m.label} →</a></li>
          ))}
        </ul>
      </nav>

      {/*
        透明性ログ。証明書（1件の来歴）とは別オブジェクトなので、カードの外の
        独立セクションに置き、「個別の証明書ではなく Lemma 全体の実績」と明示する。
        SSL でいう証明書と Certificate Transparency ログの関係。
      */}
      <section class="vc-transparency" aria-label={C.transparencyHeading}>
        <VerificationCounter
          locale={locale}
          heading={C.transparencyHeading}
          lead={C.transparencyLead}
        />
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .vc-page {
    background: #f7f8fb;
    color: #161a26;
    padding: 56px 20px 72px;
  }
  .vc-container {
    max-width: 620px;
    margin: 0 auto;
  }
  .vc-eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #6a4cf0;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .vc-cert {
    background: #fff;
    border: 1px solid #e2e5f0;
    border-radius: 16px;
    padding: 22px 24px;
    box-shadow: 0 1px 2px rgba(20, 26, 38, 0.04);
  }
  .vc-cert-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid #eef0f7;
  }
  .vc-check {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: #eae6fe;
    color: #6a4cf0;
    font-size: 18px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vc-status {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.35;
  }
  .vc-status-sub {
    font-size: 13px;
    color: #5b6377;
    margin-top: 2px;
  }
  .vc-rows {
    margin: 0;
    padding: 0;
  }
  .vc-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid #f1f2f8;
  }
  .vc-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .vc-row dt {
    font-size: 12.5px;
    font-weight: 700;
    color: #6b7285;
    line-height: 1.6;
  }
  .vc-row dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #23283a;
  }
  @media (max-width: 520px) {
    .vc-row {
      grid-template-columns: 1fr;
      gap: 3px;
    }
  }
  .vc-note {
    font-size: 12.5px;
    line-height: 1.75;
    color: #6b7285;
    margin: 14px 2px 0;
  }
  .vc-more {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid #e7e9f2;
  }
  .vc-more-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7285;
  }
  .vc-more ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .vc-more a {
    font-size: 14px;
    font-weight: 700;
    color: #6a4cf0;
    text-decoration: none;
  }
  .vc-more a:hover {
    text-decoration: underline;
  }
</style>
