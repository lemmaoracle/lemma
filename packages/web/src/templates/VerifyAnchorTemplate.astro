---
/**
 * 検証センター — `/verify/`（EN）と `/ja/verify/`（JA）。
 *
 * 2モード（実装指示 v1 2026-07-24）:
 *   - `/verify/?doc=<docHash>` … 単票（その記録1件の判定）
 *       + proof verify: 読込成功後に自動で GET /v1/proofs → POST /v1/proofs/verify
 *   - `/verify/`（パラメータなし）… 全体（検証・発行の実数の内訳）
 *
 * デザイン規律（モック v9）:
 *   - ヘッダーはロゴのみ・フッターは © / 利用規約 / プライバシーのみ。検証面の
 *     価値は第三者性そのものなので、この面で自社を売り込む導線は置かない。
 *   - 蛍光グリーン（#A8E010）は「検証済み・稼働中」の状態にのみ使う。
 *   - 濃い面（スレート）は実データが流れる面（REGISTRY パネル）にのみ使う。
 *   - 数字はビルド時に焼き込まない。表示のたびに `GET /v1/counters` から読み直し、
 *     失敗時は推定で埋めず `—` ＋ `OFFLINE` ＋ 生レスポンスへの直リンクを出す。
 *
 * 動的注入（board 行）にスコープCSSが効かないため、スタイルは `.v9` 名前空間の
 * global 1ブロックにまとめている。
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import LemmaOracle from "../components/LemmaOracle.astro";

export interface VerifyAnchorTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
}

const { locale, base } = Astro.props as VerifyAnchorTemplateProps;
const isJa = locale === "ja";
const L = (path: string) => `${base}${path}`;

const API_BASE = "https://workers.lemma.workers.dev/v1";
const RAW_COUNTERS = `${API_BASE}/counters`;

const C = isJa
  ? {
      metaTitle:
        "検証センター — Lemma が検証・発行した記録の実数の内訳｜Lemma",
      metaDescription:
        "Lemma が検証・発行してきた記録の実数の内訳です。合計ではなく由来ごとに、レジストリから表示のたびに取得して開示します。推定値では埋めません。",
      eyebrow: "Verification Center",
      h2: "検証センター",
      lede: "Lemma が検証・発行してきた記録の、実数の内訳です。1件の記録を確かめる場合は、その記録のリンク（?doc=…）から開いてください。",
      registryNm: "LEMMA REGISTRY",
      live: "LIVE",
      offline: "OFFLINE",
      verified: {
        eyebrow: "Proof Verifications",
        title: "検証済み証明数",
        note: "1回の検証を1と数えます。データ点数でも、リクエスト数でもありません。",
      },
      issued: {
        eyebrow: "Proofs Issued",
        title: "発行された証明",
        note: "1件の登録を1と数えます。",
      },
      lastUpdated: "LAST UPDATED",
      loading: "読み込み中…",
      perr: "レジストリに到達できません。推定値では埋めません。",
      perrLink: "レスポンスを直接確認する →",
      verifyLink: "この数字を検証する →",
      pfootNote:
        "参照APIの生の応答です。証明レコードへの導線と、証明束（Merkle）への固定は順次公開します。",
      bottomNote:
        "個別の証明書ではなく、Lemma 全体の検証・発行記録の内訳です。実数のみを表示し、推定では埋めません。",
      docsLink: "ドキュメント →",
      docsHref: L("/guides/"),
      terms: "利用規約",
      privacy: "プライバシー",
    }
  : {
      metaTitle:
        "Verification Center — the real breakdown of what Lemma has verified and issued | Lemma",
      metaDescription:
        "The real breakdown of records Lemma has verified and issued — by source, read from the registry on every view. Never filled with estimates.",
      eyebrow: "Verification Center",
      h2: "Verification Center",
      lede: "The real breakdown of records Lemma has verified and issued. To check a single record, open it from that record's link (?doc=…).",
      registryNm: "LEMMA REGISTRY",
      live: "LIVE",
      offline: "OFFLINE",
      verified: {
        eyebrow: "Proof Verifications",
        title: "Verified proofs",
        note: "One successful verification counts as one — not one data point, not one request.",
      },
      issued: {
        eyebrow: "Proofs Issued",
        title: "Issued proofs",
        note: "One registration counts as one.",
      },
      lastUpdated: "LAST UPDATED",
      loading: "Loading…",
      perr: "The registry is unreachable. We do not fill in estimates.",
      perrLink: "Check the response directly →",
      verifyLink: "Verify these numbers →",
      pfootNote:
        "The raw response of the reference API. Links to proof records and anchoring of proof bundles (Merkle) will follow.",
      bottomNote:
        "Not an individual certificate — the breakdown of everything Lemma has verified and issued. Real numbers only, never estimates.",
      docsLink: "Documentation →",
      docsHref: L("/guides/"),
      terms: "Terms",
      privacy: "Privacy",
    };

// ソース/バケットのラベル訳（未知キーはキーをそのまま表示・クライアントで対応）。
// フィードが増えたらここに追記する（spec §2.2）。
const SRC_LABELS = isJa
  ? {
      feeds: "為替データフィード",
      api_verify: "公開API・その他",
      "jp-holidays": "祝日データフィード",
      "jp-postal-codes": "郵便番号データフィード",
      other: "その他",
    }
  : {
      feeds: "FX data feed",
      api_verify: "Public API & others",
      "jp-holidays": "JP holidays feed",
      "jp-postal-codes": "JP postal codes feed",
      other: "Others",
    };
const BKT_LABELS = isJa
  ? {
      feeds: "為替データフィード",
      clubs: "CLUBS",
      "jp-holidays": "祝日データフィード",
      "jp-postal-codes": "郵便番号データフィード",
      other: "その他",
    }
  : {
      feeds: "FX data feed",
      clubs: "CLUBS",
      "jp-holidays": "JP holidays feed",
      "jp-postal-codes": "JP postal codes feed",
      other: "Others",
    };

const STR = {
  api: API_BASE,
  loading: C.loading,
  live: C.live,
  offline: C.offline,
  lastUpdated: C.lastUpdated,
  timeLocale: isJa ? "ja-JP" : "en-US",
  src: SRC_LABELS,
  bkt: BKT_LABELS,
};

// ── 単票モード（?doc=）─────────────────────────────────────────
// サーバー描画のプロース（ロケール主）。証明書本体（#view）は日英併記でクライアント描画。
const DOCPROSE = isJa
  ? {
      kicker: "検証センター / Verification",
      attr: "この検証を行っているのは、記録の当事者から独立した証明基盤 Lemma です。",
      attrDocs: "ドキュメント →",
      attrAgg: "検証センター全体 →",
      promo: "自社の記録にも証明を付けられます",
      promoNocode: "ノーコードで発行 →",
      promoApi: "API で発行 →",
    }
  : {
      kicker: "Verification Center",
      attr: "This verification is performed by Lemma — a proof layer independent of the record's parties.",
      attrDocs: "Documentation →",
      attrAgg: "Full verification center →",
      promo: "Add proof to your own records.",
      promoNocode: "Issue no-code →",
      promoApi: "Issue via API →",
    };
const DLINK = {
  docs: L("/guides/"),
  agg: L("/verify/"),
  nocode: L("/trust402/sell/"),
  api: "https://dashboard.lemma.workers.dev",
};

// 発行者は「CLUBS」固定（生の issuerId は表示に使わない・CTO 方針）。subjectId は一切扱わない。
// 証明クラス（来歴）は API が返さないため UI 固定ラベル。EXPLORER は Base 導入まで空＝無効表示。
const DOC = {
  issuer: "CLUBS",
  api: API_BASE,
  rawBase: `${API_BASE}/documents/`,
  explorer: "",
  states: {
    registered: { ja: "改ざんされていません", en: "Not tampered", subJa: null, subEn: null },
    anchored: {
      ja: "改ざんされていません",
      en: "Not tampered",
      subJa: "この証明はブロックチェーン上にも刻まれています。",
      subEn: "Also anchored on-chain.",
    },
    pending: {
      ja: "照合を待っています",
      en: "Pending verification",
      subJa: "まだ検証記録への登録が済んでいません。",
      subEn: "Not yet registered in the verification record.",
    },
  },
  notFound: {
    ja: "記録が見つかりません",
    en: "Record not found",
    subJa: "この記録は登録されていないか、リンクが正しくない可能性があります。",
    subEn: "This record has not been registered, or the link may be incorrect.",
  },
  f: {
    issuerJa: "発行者",
    issuerEn: "Issuer",
    recAtJa: "記録日時",
    recAtEn: "Recorded at",
    recDateJa: "対象の日付",
    recDateEn: "Record date",
  },
  checks: ["署名が一致", "改ざんなし", "発行者を確認"],
  // proof verify UI（単票・ページ読込時に自動実行）
  verifying: "検証中…",
  verifyingEn: "Verifying…",
  verifyOk: "✅ 検証成功",
  verifyOkEn: "Verified",
  verifyFail: "❌ 検証失敗",
  verifyFailEn: "Verification failed",
  verifyIdLabel: "verifyId",
  noProof: "このドキュメントにはまだ proof が登録されていません",
  noProofEn: "No proof has been registered for this document yet.",
  verifyNetErr: "検証リクエストに失敗しました",
  verifyNetErrEn: "The verification request failed.",
  verifyInvalid: "証明は無効です",
  verifyInvalidEn: "The proof is invalid.",
  verifyLocally: "ローカルで検証するには / Verify locally",
  // コードスニペット内の { } は HTML 実体参照（Astro/リンター回避）
  verifySnippet:
    "// 1. 最新の proof を取得\n" +
    "const &#123; circuitId, proof, inputs &#125; = await proofs.getByDocHash(docHash);\n" +
    "// GET /v1/proofs?docHash=...\n" +
    "\n" +
    "// 2. 検証を実行\n" +
    'const &#123; valid, verifyId &#125; = await fetch("/v1/proofs/verify", &#123;\n' +
    '  method: "POST",\n' +
    "  body: JSON.stringify(&#123; circuitId, proof, publicSignals: inputs &#125;)\n" +
    "&#125;).then(r => r.json());",
  fold1Title: "この証明の意味 / What this proves",
  provesYes: "✔ 証明が意味すること",
  provesYesJa: "記録が、発行された時点から改ざんされていないこと。",
  provesYesEn: "The record is unchanged since it was issued.",
  provesNo: "✗ 証明が意味しないこと",
  provesNoJa: "書かれた内容の良し悪しや、判断の正しさそのもの。",
  provesNoEn: "Not the quality of the contents or the correctness of the judgment.",
  roleMatch: "照合＝",
  roleMatchB: "当事者",
  roleVerify: "検証＝",
  roleVerifyB: "第三者",
  roleProof: "証明＝",
  roleProofB: "Lemma",
  fold2Title: "検証した対象 / What was verified",
  classVal: "来歴 · Verifiable Origin",
  recordType: "日次記録",
  sourceJa: "記録の当事者",
  sourceEn: "The party that issued the record",
  scopeJa: "記録本文とタイムスタンプのハッシュのみ。本文そのものは Lemma に送られていません。",
  scopeEn: "Only the hash — the body itself is never sent to Lemma.",
  fold3Title: "DOC HASH とは / About the hash",
  aboutJa: "記録ごとに固有のコードです。発行したときの記録と、いま照会している記録が一致していることを示します。あとから書き換えるとこのコードが変わり、一致しなくなります。",
  aboutEn: "A code unique to each record. Editing the record afterwards would change it.",
  raw: "生の照合レスポンスを見る / Raw response",
  hashLabel: "DOC HASH",
  copy: "コピー",
  copied: "コピーしました",
  chainVerify: "オンチェーンの記録を確認",
  chainPending: "オンチェーン記録あり（エクスプローラ確定待ち）",
};
---

<Layout
  locale={locale}
  title={C.metaTitle}
  description={C.metaDescription}
  metaType="page"
  pagePath="/verify/"
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Noto+Serif+JP:wght@500;600&family=Noto+Sans+JP:wght@400;500;700&family=Inter:wght@200;300;400;500&family=Space+Mono&display=swap"
  />

  <div class="v9">
    <header class="v9-hd">
      <a href={L("/")} class="v9-logo" aria-label="Lemma">
        <LemmaOracle />
      </a>
    </header>

    <main class="v9-main">
      <div class="v9-wrap">
        {/* 単票モード（?doc=）。クライアントが URL を見て表示を切り替える。 */}
        <div id="doc-mode" hidden>
          <div class="v9-kicker">{DOCPROSE.kicker}</div>
          <div id="view" aria-live="polite"></div>
          <p class="attrfoot">
            {DOCPROSE.attr}
            <a href={DLINK.docs} target="_blank" rel="noopener">{DOCPROSE.attrDocs}</a>
            <a href={DLINK.agg}>{DOCPROSE.attrAgg}</a>
          </p>
          <p class="promoline">
            {DOCPROSE.promo}
            <a href={DLINK.nocode} target="_blank" rel="noopener">{DOCPROSE.promoNocode}</a>
            <a href={DLINK.api} target="_blank" rel="noopener">{DOCPROSE.promoApi}</a>
          </p>
        </div>

        {/* 全体モード（?doc なし） */}
        <div id="agg-mode" hidden>
        <div class="v9-kicker">{C.eyebrow}</div>
        <h1 class="v9-h2">{C.h2}</h1>
        <p class="v9-lede">{C.lede}</p>

        <div class="panel tech" aria-label={C.h2}>
          <div class="pgrid"></div>
          <div class="phead" id="phead">
            <span class="nm">{C.registryNm}</span>
            <span class="livechip" id="plive">{C.live}</span>
            <span class="ep">GET /v1/counters</span>
          </div>
          <div class="vboards">
            <div class="vboard">
              <div class="vb-label">{C.verified.eyebrow}</div>
              <div class="vb-title">{C.verified.title}</div>
              <div class="bignum vtotal" id="vtotal" aria-live="polite">———</div>
              <p class="vb-note">{C.verified.note}</p>
              <div id="vboard-verified"><div class="vb-note">{C.loading}</div></div>
              <div class="vb-upd">{C.lastUpdated} <b id="vupd">—</b></div>
            </div>
            <div class="vboard">
              <div class="vb-label">{C.issued.eyebrow}</div>
              <div class="vb-title">{C.issued.title}</div>
              <div class="bignum vtotal" id="itotal" aria-live="polite">———</div>
              <p class="vb-note">{C.issued.note}</p>
              <div id="vboard-issued"><div class="vb-note">{C.loading}</div></div>
              <div class="vb-upd">{C.lastUpdated} <b id="iupd">—</b></div>
            </div>
          </div>
          <div class="perr" id="perr" hidden>
            {C.perr}
            <a href={RAW_COUNTERS} target="_blank" rel="noopener">{C.perrLink}</a>
          </div>
          <div class="pfoot">
            <a href={RAW_COUNTERS} target="_blank" rel="noopener">{C.verifyLink}</a>
            <span>{C.pfootNote}</span>
          </div>
        </div>

        <p class="v9-bottom">
          {C.bottomNote}
          <a href={C.docsHref} target="_blank" rel="noopener">{C.docsLink}</a>
        </p>
        </div>
      </div>
    </main>

    <footer class="v9-ft">
      <span>© FRAME00, Inc.</span>
      <a href={L("/terms/")}>{C.terms}</a>
      <a href={L("/privacy/")}>{C.privacy}</a>
    </footer>
  </div>
</Layout>

<script is:inline define:vars={{ STR, DOC }}>
  (function () {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString("en-US");
    const esc = (s) =>
      String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[c]);
    const svg = (d) =>
      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">${d}</svg>`;
    const I = {
      check: '<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>',
      clock:
        '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>',
      q: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.88 9.5a2.12 2.12 0 1 1 3.04 2.02c-.7.34-1.42.9-1.42 1.73v.5M12 17h.01"/><circle cx="12" cy="12" r="9"/>',
      ext: '<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5M15 3h6m0 0v6m0-6-9 9"/>',
    };

    // ── 単票モード（?doc=）─────────────────────────────────────
    // registeredAt は API から ISO8601 UTC で来る。JST に整形して表示する。
    function fmtJst(iso) {
      if (!iso) return "";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "";
      const s = d.toLocaleString("ja-JP", {
        timeZone: "Asia/Tokyo",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      });
      return s.replace(/\//g, "-") + " JST";
    }

    function renderDoc(doc) {
      const view = $("view");
      if (!doc || doc.status === "not_found") {
        view.innerHTML = `<div class="cert2 not_found"><div class="pgrid"></div>
          <div class="ch"><div class="seal">${svg(I.q)}</div>
            <div><h1 class="verdict">${DOC.notFound.ja}</h1><div class="verdict-en">${DOC.notFound.en}</div></div></div>
          <p class="sub2">${DOC.notFound.subJa}<span class="en">${DOC.notFound.subEn}</span></p></div>`;
        return;
      }
      const st = DOC.states[doc.status] || DOC.states.pending;
      const verified = doc.status === "registered" || doc.status === "anchored";
      const recAt = fmtJst(doc.registeredAt);
      // 発行者は CLUBS 固定。subjectId・生の issuerId は使わない。
      const facts = [
        [DOC.f.issuerJa, DOC.f.issuerEn, DOC.issuer],
        recAt ? [DOC.f.recAtJa, DOC.f.recAtEn, recAt] : null,
        doc.date ? [DOC.f.recDateJa, DOC.f.recDateEn, esc(doc.date)] : null,
      ]
        .filter(Boolean)
        .map(
          ([ja, en, v]) =>
            `<div class="fr"><span class="k">${ja}<span class="en">${en}</span></span><span class="v">${v}</span></div>`,
        )
        .join("");

      const checks = verified
        ? `<div class="checks2">${DOC.checks
            .map((c) => `<div class="chk2"><span class="ci">${svg(I.check)}</span>${c}</div>`)
            .join("")}</div>`
        : "";

      // proof verify（checks と chain の間）。登録済みのときのみ。初期は「検証中…」スケルトン。
      const proofVerify = verified
        ? `<div class="proofverify" id="proofVerify" data-dochash="${esc(doc.docHash)}">${proofVerifyVerifyingHtml()}</div>`
        : "";

      const chain =
        doc.status === "anchored" && doc.onchainTxHash
          ? `<div class="chain">${
              DOC.explorer
                ? `<a href="${DOC.explorer}${esc(doc.onchainTxHash)}" target="_blank" rel="noopener">${svg(I.ext)} ${DOC.chainVerify}</a>`
                : `<a class="disabled">${svg(I.ext)} ${DOC.chainPending}</a>`
            }</div>`
          : "";

      const foldMeaning = verified
        ? `<div class="fold"><details>
            <summary><span class="sm-ic">${svg(I.q)}</span>${DOC.fold1Title}<span class="caret">▶</span></summary>
            <div class="foldbody">
              <div class="mrow2"><span class="ml yes">${DOC.provesYes}</span>${DOC.provesYesJa}<span class="en">${DOC.provesYesEn}</span></div>
              <div class="mrow2" style="margin-top:12px"><span class="ml no">${DOC.provesNo}</span>${DOC.provesNoJa}<span class="en">${DOC.provesNoEn}</span></div>
              <div class="roles"><span>${DOC.roleMatch}<b>${DOC.roleMatchB}</b></span><span>${DOC.roleVerify}<b>${DOC.roleVerifyB}</b></span><span>${DOC.roleProof}<b>${DOC.roleProofB}</b></span></div>
            </div></details></div>`
        : "";

      const recordVal = DOC.recordType + (doc.date ? " · " + esc(doc.date) : "");
      const foldTarget = verified
        ? `<div class="fold"><details>
            <summary><span class="sm-ic">${svg(I.ext)}</span>${DOC.fold2Title}<span class="caret">▶</span></summary>
            <div class="foldbody">
              <div class="trow"><span class="k">CLASS</span><span class="v">${DOC.classVal}</span></div>
              <div class="trow"><span class="k">RECORD</span><span class="v">${recordVal}</span></div>
              <div class="trow"><span class="k">SOURCE</span><span class="v">${DOC.sourceJa}<span class="en">${DOC.sourceEn}</span></span></div>
              <div class="trow"><span class="k">SCOPE</span><span class="v">${DOC.scopeJa}<span class="en">${DOC.scopeEn}</span></span></div>
            </div></details></div>`
        : "";

      const foldCode = `<div class="fold"><details>
          <summary><span class="sm-ic">${svg(I.check)}</span>${DOC.fold3Title}<span class="caret">▶</span></summary>
          <div class="foldbody">
            <p class="meaningtxt" style="margin-top:0">${DOC.aboutJa}<span class="en">${DOC.aboutEn}</span></p>
            <a class="rawlink" href="${DOC.rawBase}${encodeURIComponent(doc.docHash)}" target="_blank" rel="noopener">${svg(I.ext)} ${DOC.raw}</a>
          </div></details></div>`;

      const subHtml = st.subJa ? `<p class="sub2">${st.subJa}<span class="en">${st.subEn}</span></p>` : "";

      view.innerHTML = `<div class="cert2 ${doc.status}"><div class="pgrid"></div>
        <div class="ch"><div class="seal">${svg(st.icon || (doc.status === "pending" ? I.clock : I.check))}</div>
          <div><h1 class="verdict">${st.ja}</h1><div class="verdict-en">${st.en}</div></div></div>
        <div class="idline"><span class="idk">${DOC.hashLabel}</span><span class="idv">${esc(doc.docHash)}</span><button class="copybtn" id="copyBtn">${DOC.copy}</button></div>
        ${subHtml}
        <div class="facts">${facts}</div>
        ${checks}${proofVerify}${chain}
        <div class="folds">${foldMeaning}${foldTarget}${foldCode}</div>
      </div>`;

      const btn = $("copyBtn");
      if (btn)
        btn.onclick = () => {
          navigator.clipboard?.writeText(doc.docHash);
          btn.textContent = DOC.copied;
          setTimeout(() => (btn.textContent = DOC.copy), 1400);
        };
    }

    function proofVerifyVerifyingHtml() {
      return `<div class="pv-status verifying" role="status">
          <span class="pv-spin" aria-hidden="true"></span>
          <span>${DOC.verifying}<span class="en">${DOC.verifyingEn}</span></span>
        </div>`;
    }

    function setProofVerifyState(state, data) {
      const el = $("proofVerify");
      if (!el) return;
      if (state === "verifying") {
        el.innerHTML = proofVerifyVerifyingHtml();
        return;
      }
      if (state === "verified") {
        const shortId = String(data.verifyId || "").slice(0, 12);
        el.innerHTML = `<div class="pv-status ok" role="status">
          <span class="pv-mark">${DOC.verifyOk}</span>
          <span class="en">${DOC.verifyOkEn}</span>
          <div class="pv-id"><span class="pv-idk">${DOC.verifyIdLabel}</span><code class="pv-idv">${esc(shortId)}</code></div>
        </div>
        <div class="pv-local"><details>
          <summary>${DOC.verifyLocally}<span class="caret">▶</span></summary>
          <pre class="pv-code"><code>${DOC.verifySnippet}</code></pre>
        </details></div>`;
        return;
      }
      // failed
      const msg = data && data.message ? data.message : DOC.verifyNetErr;
      const msgEn = data && data.messageEn ? data.messageEn : DOC.verifyNetErrEn;
      el.innerHTML = `<div class="pv-status fail" role="status">
        <span class="pv-mark">${DOC.verifyFail}</span>
        <span class="en">${DOC.verifyFailEn}</span>
        <p class="pv-err">${esc(msg)}<span class="en">${esc(msgEn)}</span></p>
      </div>`;
    }

    async function verifyProof(docHash) {
      setProofVerifyState("verifying");
      try {
        const gr = await fetch(
          DOC.api + "/proofs?docHash=" + encodeURIComponent(docHash),
          { headers: { accept: "application/json" } },
        );
        if (gr.status === 404) {
          setProofVerifyState("failed", {
            message: DOC.noProof,
            messageEn: DOC.noProofEn,
          });
          return;
        }
        if (!gr.ok) {
          setProofVerifyState("failed", {
            message: DOC.verifyNetErr + " (" + gr.status + ")",
            messageEn: DOC.verifyNetErrEn,
          });
          return;
        }
        const rec = await gr.json();
        const vr = await fetch(DOC.api + "/proofs/verify", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({
            circuitId: rec.circuitId,
            proof: rec.proof,
            publicSignals: rec.inputs,
          }),
        });
        if (!vr.ok) {
          let detail = DOC.verifyNetErr + " (" + vr.status + ")";
          try {
            const errBody = await vr.json();
            if (errBody && errBody.error) detail = String(errBody.error);
          } catch (_) {}
          setProofVerifyState("failed", {
            message: detail,
            messageEn: DOC.verifyNetErrEn,
          });
          return;
        }
        const result = await vr.json();
        if (result && result.valid) {
          setProofVerifyState("verified", { verifyId: result.verifyId });
        } else {
          setProofVerifyState("failed", {
            message:
              (result && result.error && String(result.error)) || DOC.verifyInvalid,
            messageEn: DOC.verifyInvalidEn,
          });
        }
      } catch (e) {
        setProofVerifyState("failed", {
          message: DOC.verifyNetErr,
          messageEn: DOC.verifyNetErrEn,
        });
      }
    }

    async function loadDoc(hash, date) {
      try {
        const r = await fetch(DOC.rawBase + encodeURIComponent(hash), {
          headers: { accept: "application/json" },
        });
        if (!r.ok) {
          renderDoc({ status: "not_found" });
          return;
        }
        const j = await r.json();
        // 描画に使うフィールドだけを取り出す。subjectId・生の issuerId は取り込まない。
        renderDoc({
          status: j.status,
          docHash: hash,
          registeredAt: j.registeredAt,
          onchainTxHash: j.onchainTxHash ?? null,
          date,
        });
        // 登録済みなら描画直後に proof verify を自動実行（初期表示は「検証中…」）。
        if (j.status === "registered" || j.status === "anchored") {
          verifyProof(hash);
        }
      } catch (e) {
        renderDoc({ status: "not_found" });
      }
    }

    // ── 全体モード（?doc なし）─────────────────────────────────
    function fmtTime(s) {
      if (!s) return "—";
      const d = new Date(s.includes("T") ? s : s.replace(" ", "T") + "Z");
      return Number.isNaN(d.getTime())
        ? "—"
        : d.toLocaleString(STR.timeLocale, {
            month: "numeric",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          });
    }

    function board(el, rows, labels) {
      const sorted = [...rows].sort((a, b) => b.count - a.count);
      const mx = sorted.reduce((a, r) => Math.max(a, r.count), 0);
      el.innerHTML = sorted
        .map((r) => {
          const key = r.source ?? r.bucket;
          const label = labels[key] ?? key;
          const w = mx > 0 ? (r.count / mx) * 100 : 0;
          return `<div class="vrow"><div class="rh2"><span>${label}</span><span class="cnt">${fmt(
            r.count,
          )}</span></div><div class="vbar"><i data-w="${w}"></i></div></div>`;
        })
        .join("");
      requestAnimationFrame(() =>
        el.querySelectorAll(".vbar i").forEach((b) => {
          b.style.width = b.dataset.w + "%";
        }),
      );
    }

    function countUp(el, to) {
      if (reduced) {
        el.textContent = fmt(to);
        return;
      }
      const t0 = performance.now(),
        dur = 1300,
        from = Math.max(0, to - Math.min(to, 600));
      (function f(t) {
        const p = Math.min(1, (t - t0) / dur),
          e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(Math.round(from + (to - from) * e));
        if (p < 1) requestAnimationFrame(f);
      })(t0);
    }

    let first = true;
    async function load() {
      try {
        const r = await fetch(STR.api + "/counters", {
          headers: { accept: "application/json" },
        });
        if (!r.ok) throw new Error(String(r.status));
        const j = await r.json();
        const vt = j.verified.bySource.reduce((a, b) => a + b.count, 0);
        const it = j.issued.byBucket.reduce((a, b) => a + b.count, 0);
        if (first) {
          countUp($("vtotal"), vt);
          countUp($("itotal"), it);
          first = false;
        } else {
          $("vtotal").textContent = fmt(vt);
          $("itotal").textContent = fmt(it);
        }
        board($("vboard-verified"), j.verified.bySource, STR.src);
        board($("vboard-issued"), j.issued.byBucket, STR.bkt);
        $("vupd").textContent = fmtTime(j.verified.updatedAt);
        $("iupd").textContent = fmtTime(j.issued.updatedAt);
        $("perr").hidden = true;
        $("phead").classList.remove("offline");
        $("plive").textContent = STR.live;
      } catch (e) {
        $("vboard-verified").innerHTML = "";
        $("vboard-issued").innerHTML = "";
        $("vtotal").textContent = "—";
        $("itotal").textContent = "—";
        $("vupd").textContent = "—";
        $("iupd").textContent = "—";
        $("perr").hidden = false;
        $("phead").classList.add("offline");
        $("plive").textContent = STR.offline;
      }
    }
    // ── モード分岐 ─────────────────────────────────────────────
    const params = new URLSearchParams(location.search);
    const rawDoc = params.get("doc");
    if (rawDoc !== null) {
      // ?doc がある＝単票モード。形式不正はサーバ照会せず not_found 表示。
      $("doc-mode").hidden = false;
      $("agg-mode").hidden = true;
      if (!/^0x[0-9a-fA-F]+$/.test(rawDoc)) {
        renderDoc({ status: "not_found" });
      } else {
        const dq = params.get("date");
        const date = dq && /^\d{4}-\d{2}-\d{2}$/.test(dq) ? dq : null;
        loadDoc(rawDoc, date);
      }
    } else {
      // 全体モード
      $("agg-mode").hidden = false;
      $("doc-mode").hidden = true;
      load();
      setInterval(load, 45000);
    }
  })();
</script>

