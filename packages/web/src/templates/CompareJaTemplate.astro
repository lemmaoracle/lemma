                opacity="0.45"></path><circle
                cx="234"
                cy="50"
                r="3"
                fill="#A8E010"
                opacity="0.6"></circle><path
                d="M217 88 L249 77"
                stroke="#A8E010"
                stroke-width="1.4"
                opacity="0.55"></path><circle
                cx="249"
                cy="77"
                r="3"
                fill="#A8E010"
                opacity="0.7"></circle><path
                d="M220 108 L254 108"
                stroke="#A8E010"
                stroke-width="1.4"
                opacity="0.35"></path><circle
                cx="254"
                cy="108"
                r="3"
                fill="#A8E010"
                opacity="0.5"></circle><path
                d="M217 128 L249 139"
                stroke="#A8E010"
                stroke-width="1.4"
                opacity="0.45"></path><circle
                cx="249"
                cy="139"
                r="3"
                fill="#A8E010"
                opacity="0.6"></circle><path
                d="M207 146 L234 166"
                stroke="#A8E010"
                stroke-width="1.4"
                opacity="0.55"></path><circle
                cx="234"
                cy="166"
                r="3"
                fill="#A8E010"
                opacity="0.7"></circle><path
                d="M193 159 L212 188"
                stroke="#A8E010"
                stroke-width="1.4"
                opacity="0.35"></path><circle
                cx="212"
                cy="188"
                r="3"
                fill="#A8E010"
                opacity="0.5"></circle>
              <text
                x="160"
                y="196"
                text-anchor="middle"
                fill="#9BA296"
                font-family="Noto Sans JP,sans-serif"
                font-size="9.5">検証は、何度でも</text
              >
            </svg>
          </figure>
        </div>
      </section>

      <!-- 05 よくある質問 -->
      <section class="isec">
        <div class="isec-h"><span>05 — Questions</span><b>よく聞かれること</b></div>
        <div class="qa">
          {
            faq.map((item, i) => (
              <details open={i === 0}>
                <summary>{item.q}</summary>
                <div class="a" set:html={item.a} />
              </details>
            ))
          }
        </div>
      </section>

      <div class="artcta">
        <div class="k">Get Started</div>
        <h2>まず、動いている証明を<br />1件だけ確かめてください。</h2>
        <p>
          キーもアカウントも要りません。稼働中の証明を、その場で検証できます。自社の記録にどう当てはまるかは、専任チームと一緒に洗い出します。
        </p>
        <div class="row">
          <a class="btn primary" href={discoveryUrl} target="_blank" rel="noopener"
            >導入を相談する</a
          >
          <a class="btn ghostd" href={L("/verify/")}>検証センターを見る</a>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .cmp-page {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ok-light: #4e7a00;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --sh-s: 0 4px 14px rgba(14, 18, 16, 0.06);
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.09), 0 2px 6px rgba(14, 18, 16, 0.05);
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-mono: "Space Mono", monospace;

    background: var(--lite);
    color: var(--tx);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    padding: 0 0 96px;
    padding-top: 64px; /* sticky ナビ時代の margin-top:64px を padding に変換 — body 背景色の帯を出さない（H1 上の空白修正） */
    /* 帯（100vw フルブリード）の横はみ出しをページ側で抑える */
    overflow-x: hidden;
  }
  .iwrap {
    max-width: calc(1180px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
  }

  .crumb {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    align-items: center;
    padding: 34px 0 0;
    font-size: 12px;
    color: var(--muted);
  }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--tx);
  }
  .crumb i {
    font-style: normal;
    color: #b7bcb2;
  }

  /* ---- ヒーロー ---- */
  .ihero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 44px;
    align-items: center;
    padding: 22px 0 0;
  }
  .ih1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.45;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 20px 0 16px;
    word-break: keep-all;
  }
  .nb {
    display: inline-block;
  }
  .ilead {
    font-size: 15px;
    line-height: 2;
    color: var(--tx-soft);
    margin: 0;
    max-width: 52ch;
  }
  .ilead strong {
    color: var(--tx);
    font-weight: 600;
  }

  .cmppeek {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 22px;
    box-shadow: var(--sh-s);
  }
  .cp-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .cp-list {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .cp-i {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 13.5px;
    color: var(--tx-soft);
  }
  .cp-i svg {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--muted);
  }
  .cp-vs {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .cp-vs::before {
    content: "vs";
    position: absolute;
    top: -9px;
    left: 0;
    background: var(--card);
    padding-right: 9px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .cp-lem {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 17px;
    color: var(--tx);
  }
  .cp-lem svg {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--ok-ink);
  }

  /* ---- セクション見出し ----
     `.isec-h span` と書くと見出し内の .nb/.lat に当たり、見出しが
     9.5px のモノスペース大文字ブロックになる。直下のみに限定する。 */
  .isec {
    margin: 16px 0 0;
  }
  .band + .isec {
    margin-top: 12px;
  }
  .isec + .band {
    margin-top: 14px;
  }
  .isec-h {
    display: block;
    margin-bottom: 12px;
  }
  .isec-h > span {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .isec-h b {
    display: block;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(23px, 2.7vw, 32px);
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--tx);
    max-width: none;
  }
  .isec-h b span {
    display: inline;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: none;
    color: inherit;
    margin: 0;
  }
  .isec-h b .nb {
    display: inline-block;
  }
  .isec-h b .lat {
    font-family: "Space Grotesk", sans-serif;
  }

  /* ---- 01 一言で ---- */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 6px;
  }
  .splitcol {
    border-radius: 13px;
    padding: 22px 24px;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .splitcol.on {
    border-color: rgba(124, 175, 0, 0.5);
  }
  .splitcol .k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 5px;
  }
  .splitcol.on .k {
    color: var(--ok-ink);
  }
  .splitcol .t {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--tx);
    margin-bottom: 0;
  }
  .splitcol ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .splitcol li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 9px;
    font-size: 13.2px;
    line-height: 1.75;
    color: var(--tx-soft);
  }
  .splitcol li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 11px;
    width: 9px;
    height: 2px;
    border-radius: 2px;
    background: #c3c9be;
  }
  .splitcol.on li::before {
    background: var(--ok-ink);
  }
  .cardhead {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 13px;
  }
  .cardhead .tt {
    min-width: 0;
  }
  .cardic {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--lite-2);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .cardic svg {
    width: 19px;
    height: 19px;
    display: block;
  }
  .splitcol.on .cardic {
    background: rgba(168, 224, 16, 0.12);
    border-color: rgba(124, 175, 0, 0.4);
    color: var(--ok-ink);
  }
  .cmpnote {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.85;
    color: var(--muted);
  }
  .cmpnote strong,
  .usecall strong,
  .other strong,
  .itext strong {
    color: var(--tx);
    font-weight: 600;
  }

  /* ---- 帯（フルブリード） ---- */
  .band {
    position: relative;
    padding: 24px 0 26px;
    margin-top: 14px;
  }
  .band::before {
    content: "";
    position: absolute;
    left: calc(-50vw + 50%);
    width: 100vw;
    top: 0;
    bottom: 0;
    z-index: 0;
  }
  .band > * {
    position: relative;
    z-index: 1;
  }
  .band.alt::before {
    background: var(--lite-2);
  }

  /* ---- 02 比較表（記号中心） ---- */
  .cmpwrap {
    overflow-x: auto;
    margin-top: 6px;
  }
  .cmp2 {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13.5px;
  }
  .cmp2 th,
  .cmp2 td {
    padding: 13px 16px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--line);
  }
  .cmp2 thead th {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--tx-soft);
    padding: 12px 16px;
    white-space: nowrap;
    border-bottom: 1px solid var(--line);
  }
  .cmp2 thead th.lem {
    background: var(--ok);
    color: var(--ink);
    font-weight: 700;
    border-radius: 9px 9px 0 0;
  }
  .cmp2 tbody th {
    font-weight: 500;
    color: var(--tx);
    width: 200px;
  }
  .cmp2 td {
    text-align: center;
    width: 150px;
  }
  .cmp2 td.lem {
    background: rgba(168, 224, 16, 0.07);
  }
  .cmp2 tbody tr:last-child td.lem {
    border-radius: 0 0 9px 9px;
  }
  .mk2 {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }
  .cmp2 td:not(.lem) .mk2 i {
    font-size: 19px;
  }
  .mk2 i {
    font-style: normal;
    font-size: 17px;
    line-height: 1;
  }
  .mk2 .o {
    color: var(--ok-ink);
  }
  .mk2 .t {
    color: #b99a4e;
  }
  .mk2 .x {
    color: #b0684f;
  }
  .mk2 span {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--muted);
  }
  .cmp2 td.lem .mk2 span {
    color: var(--tx-soft);
  }
  .legend {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin: 14px 0 0;
    font-size: 11.5px;
    color: var(--muted);
  }
  .legend b {
    font-weight: 400;
  }
  .usecall {
    margin: 16px 0 0;
    padding: 16px 20px;
    background: var(--card);
    border: 1px solid rgba(124, 175, 0, 0.4);
    border-left: 3px solid var(--ok);
    border-radius: 11px;
  }
  .uc-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--ok-ink);
    margin-bottom: 8px;
  }
  .usecall p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--tx-soft);
  }

  /* ---- 03 そのほかの手段 ---- */
  .others {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 0;
  }
  .other {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 13px;
    padding: 18px 20px;
  }
  .other .k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 5px;
  }
  .other .t {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 16.5px;
    color: var(--tx);
    margin-bottom: 0;
  }
  .other p {
    margin: 0;
    font-size: 13.2px;
    line-height: 1.85;
    color: var(--tx-soft);
  }
  .other p + p {
    margin-top: 10px;
  }

  /* ---- 04 無料の理由 ----
     freewrap は上揃え（図が本文より背が高いとき、center だと本文の
     上下に大きな空きが出る）。figure はブラウザ既定 margin を潰す。 */
  .freewrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 34px;
    align-items: start;
    margin-top: 0;
  }
  .freewrap > div {
    padding-top: 2px;
  }
  .itext {
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--tx-soft);
    max-width: 62ch;
    margin: 0 0 10px;
  }
  .freewrap .itext:last-child {
    margin-bottom: 0;
  }
  .motif {
    margin: 0;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    padding: 12px 14px;
    background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%);
    box-shadow: 0 22px 52px rgba(22, 30, 24, 0.26);
  }
  .motif::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      125% 78% at 92% -18%,
      rgba(168, 224, 16, 0.16),
      rgba(168, 224, 16, 0) 62%
    );
  }
  .motif svg {
    position: relative;
    z-index: 2;
    width: 100%;
    max-height: 220px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  /* ---- 05 FAQ ---- */
  .qa {
    border-top: 1px solid var(--line);
    margin-top: 2px;
  }
  .qa details {
    border-bottom: 1px solid var(--line);
  }
  .qa summary {
    list-style: none;
    cursor: pointer;
    padding: 15px 0;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.7;
    color: var(--tx);
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary::before {
    content: "+";
    flex: none;
    width: 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ok-ink);
  }
  .qa details[open] summary::before {
    content: "–";
  }
  .qa .a {
    padding: 0 0 16px 26px;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--tx-soft);
    max-width: 64ch;
  }
  .qa .a :global(strong) {
    color: var(--tx);
    font-weight: 600;
  }

  /* ---- CTA ---- */
  .artcta {
    margin: 26px 0 0;
    background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%);
    border-radius: 16px;
    padding: 38px 36px 34px;
    position: relative;
    overflow: hidden;
  }
  .artcta::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(
      125% 78% at 92% -18%,
      rgba(168, 224, 16, 0.18),
      rgba(168, 224, 16, 0) 62%
    );
  }
  .artcta > * {
    position: relative;
    z-index: 2;
  }
  .artcta .k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: #9ba296;
  }
  .artcta h2 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.6;
    color: #ebefe6;
    margin: 12px 0 10px;
  }
  .artcta p {
    margin: 0 0 24px;
    font-size: 13.5px;
    line-height: 1.9;
    color: #bcc3b6;
  }
  .artcta .row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    border-radius: 6px;
    padding: 14px 30px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: 0.18s;
    font-family: var(--font-body);
    letter-spacing: 0.05em;
  }
  .btn.primary {
    background: var(--ok);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 6px 18px rgba(168, 224, 16, 0.35);
  }
  .btn.primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }
  .btn.ghostd {
    color: #d8ddd1;
    border-color: #59645a;
    background: transparent;
  }
  .btn.ghostd:hover {
    border-color: #d8ddd1;
    color: #ebefe6;
  }

  /* ---- レスポンシブ ---- */
  @media (max-width: 1020px) {
    .ihero {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .split,
    .others,
    .freewrap {
      grid-template-columns: 1fr;
    }
    .cmp2 tbody th {
      width: auto;
    }
    .cmp2 td {
      width: auto;
    }
  }
  @media (max-width: 760px) {
    .iwrap {
      padding: 0 24px;
    }
    .cmp2 {
      min-width: 620px;
    }
    .artcta {
      padding: 30px 24px 28px;
    }
  }
</style>
