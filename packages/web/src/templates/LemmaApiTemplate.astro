  `<svg viewBox="0 0 280 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="22" y="22" width="76" height="46" rx="3" stroke="#d4a574" stroke-width="1.2" fill="none"/><line x1="32" y1="32" x2="88" y2="32" stroke="#d4a574" stroke-width="0.8" opacity="0.45"/><line x1="32" y1="40" x2="88" y2="40" stroke="#d4a574" stroke-width="0.8" opacity="0.45"/><line x1="32" y1="48" x2="88" y2="48" stroke="#d4a574" stroke-width="0.8" opacity="0.45"/><line x1="32" y1="56" x2="88" y2="56" stroke="#d4a574" stroke-width="0.8" opacity="0.45"/><text x="60" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#8a857d" letter-spacing="0.1em">SOURCE</text><path class="la-mech-dashflow" d="M 115 45 L 175 45" stroke="#d4a574" stroke-width="1.2" fill="none"/><path d="M 170 41 L 175 45 L 170 49" stroke="#d4a574" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><text x="145" y="36" text-anchor="middle" font-family="Space Mono" font-size="8" fill="#d4a574" letter-spacing="0.1em">ISSUE</text><circle class="la-mech-halo" cx="225" cy="45" r="24" stroke="#FCFAF5" stroke-width="1" fill="none"/><circle class="la-mech-halo la-mech-halo--delay" cx="225" cy="45" r="24" stroke="#FCFAF5" stroke-width="1" fill="none"/><circle cx="225" cy="45" r="24" stroke="#FCFAF5" stroke-width="1.6" fill="none"/><circle class="la-mech-token-pulse" cx="225" cy="45" r="10" stroke="#FCFAF5" stroke-width="1.2" fill="none" opacity="0.5"/><circle cx="225" cy="27" r="2.5" fill="#FCFAF5"/><circle cx="225" cy="63" r="2.5" fill="#FCFAF5"/><circle cx="207" cy="45" r="2.5" fill="#FCFAF5"/><circle cx="243" cy="45" r="2.5" fill="#FCFAF5"/><text x="225" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">PROOF</text></svg>`,
  `<svg viewBox="0 0 280 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="50" cy="45" r="22" stroke="#FCFAF5" stroke-width="1.6" fill="none"/><circle cx="50" cy="29" r="2.5" fill="#FCFAF5"/><circle cx="50" cy="61" r="2.5" fill="#FCFAF5"/><circle cx="34" cy="45" r="2.5" fill="#FCFAF5"/><circle cx="66" cy="45" r="2.5" fill="#FCFAF5"/><text x="50" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">PROOF</text><rect class="la-mech-zk-pulse" x="105" y="28" width="70" height="34" rx="4" stroke="#d4a574" stroke-width="1.2" stroke-dasharray="3,2" fill="none"/><text x="140" y="49" text-anchor="middle" font-family="Sora" font-size="11" fill="#d4a574" font-weight="600" letter-spacing="0.08em">ZK</text><text x="140" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#8a857d" letter-spacing="0.1em">SELECT</text><circle class="la-mech-halo" cx="225" cy="45" r="22" stroke="#FCFAF5" stroke-width="1" fill="none"/><circle class="la-mech-halo la-mech-halo--delay" cx="225" cy="45" r="22" stroke="#FCFAF5" stroke-width="1" fill="none"/><circle cx="225" cy="45" r="22" stroke="#FCFAF5" stroke-width="1.6" fill="none"/><circle cx="225" cy="29" r="2.5" fill="#FCFAF5"/><circle class="la-mech-dot-fade" cx="225" cy="61" r="2.5" fill="#FCFAF5" opacity="0.18"/><circle class="la-mech-dot-fade" cx="209" cy="45" r="2.5" fill="#FCFAF5" opacity="0.18"/><circle class="la-mech-dot-fade" cx="241" cy="45" r="2.5" fill="#FCFAF5" opacity="0.18"/><text x="225" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">DISCLOSED</text></svg>`,
  `<svg viewBox="0 0 280 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle class="la-mech-halo" cx="40" cy="45" r="20" stroke="#FCFAF5" stroke-width="1" fill="none"/><circle class="la-mech-halo la-mech-halo--delay" cx="40" cy="45" r="20" stroke="#FCFAF5" stroke-width="1" fill="none"/><circle cx="40" cy="45" r="20" stroke="#FCFAF5" stroke-width="1.6" fill="none"/><circle cx="40" cy="31" r="2" fill="#FCFAF5"/><circle cx="40" cy="59" r="2" fill="#FCFAF5" opacity="0.18"/><circle cx="26" cy="45" r="2" fill="#FCFAF5" opacity="0.18"/><circle cx="54" cy="45" r="2" fill="#FCFAF5" opacity="0.18"/><text x="40" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">PROOF</text><path class="la-mech-dashflow" d="M 70 45 L 105 45" stroke="#d4a574" stroke-width="1.2" fill="none"/><path d="M 100 41 L 105 45 L 100 49" stroke="#d4a574" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="110" y="28" width="60" height="34" rx="4" stroke="#d4a574" stroke-width="1.5" fill="none"/><circle cx="124" cy="45" r="6" stroke="#d4a574" stroke-width="1.4" fill="none"/><line x1="130" y1="45" x2="162" y2="45" stroke="#d4a574" stroke-width="1.4" stroke-linecap="round"/><line x1="155" y1="45" x2="155" y2="51" stroke="#d4a574" stroke-width="1.4" stroke-linecap="round"/><line x1="162" y1="45" x2="162" y2="53" stroke="#d4a574" stroke-width="1.4" stroke-linecap="round"/><text x="140" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#8a857d" letter-spacing="0.1em">PUBKEY</text><path class="la-mech-dashflow" d="M 178 45 L 210 45" stroke="#d4a574" stroke-width="1.2" fill="none"/><path d="M 205 41 L 210 45 L 205 49" stroke="#d4a574" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle class="la-mech-check-glow" cx="240" cy="45" r="20" stroke="#6ec27a" stroke-width="1.5" fill="none"/><path d="M 228 45 L 237 53 L 252 36" stroke="#6ec27a" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><text x="240" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#6ec27a" letter-spacing="0.1em">VERIFIED</text></svg>`,
];
const mechPhases = C.mechPhases.map((p, i) => ({ ...p, svg: MECH_SVG[i], prims: MECH_PRIMS[i] }));
const mechStack = C.mechStackLabels.map((label, i) => ({ label, meta: MECH_STACK_META[i] }));
// Interleave phases with arrow cells for the 5-column flow grid (no JSX fragments).
const mechCells: Array<{ arrow?: boolean; phase?: (typeof mechPhases)[number] }> = [];
mechPhases.forEach((p, i) => { if (i > 0) mechCells.push({ arrow: true }); mechCells.push({ phase: p }); });

// Core-cryptography cards — icon SVGs (locale-neutral), ported from the hub.
const CORE_SVG = [
  `<svg viewBox="0 0 80 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="22" cy="32" r="20" stroke="currentColor" stroke-width="1.8" fill="none"/><circle cx="22" cy="32" r="13" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" fill="none"/><circle cx="22" cy="32" r="3" fill="currentColor"/><line x1="46" y1="32" x2="58" y2="32" stroke="currentColor" stroke-width="1.5"/><polygon points="58,32 53,28 53,36" fill="currentColor"/><circle cx="68" cy="32" r="9" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M63 32 L67 36 L73 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>`,
  `<svg viewBox="0 0 80 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18 8 H50 L60 18 V58 H18 Z" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M50 8 V18 H60" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="25" y="22" width="22" height="3" fill="currentColor"/><circle cx="51" cy="23.5" r="2" fill="currentColor"/><line x1="25" y1="32" x2="47" y2="32" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/><rect x="25" y="40" width="22" height="3" fill="currentColor"/><circle cx="51" cy="41.5" r="2" fill="currentColor"/><line x1="25" y1="50" x2="47" y2="50" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/></svg>`,
  `<svg viewBox="0 0 80 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="6" y="14" width="18" height="22" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/><line x1="10" y1="20" x2="20" y2="20" stroke="currentColor" stroke-width="1.2"/><line x1="10" y1="25" x2="18" y2="25" stroke="currentColor" stroke-width="1.2"/><line x1="24" y1="25" x2="30" y2="25" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/><rect x="30" y="14" width="18" height="22" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/><line x1="34" y1="20" x2="44" y2="20" stroke="currentColor" stroke-width="1.2"/><line x1="34" y1="25" x2="42" y2="25" stroke="currentColor" stroke-width="1.2"/><line x1="48" y1="25" x2="54" y2="25" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/><rect x="54" y="14" width="18" height="22" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/><line x1="58" y1="20" x2="68" y2="20" stroke="currentColor" stroke-width="1.2"/><line x1="58" y1="25" x2="66" y2="25" stroke="currentColor" stroke-width="1.2"/><line x1="4" y1="50" x2="76" y2="50" stroke="currentColor" stroke-width="2"/><line x1="15" y1="36" x2="15" y2="50" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 1.5"/><line x1="39" y1="36" x2="39" y2="50" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 1.5"/><line x1="63" y1="36" x2="63" y2="50" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 1.5"/><circle cx="40" cy="56" r="2.5" fill="currentColor"/></svg>`,
];
const cores = C.cores.map((c, i) => ({ ...c, svg: CORE_SVG[i] }));
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  ogImage={ogImage}
  title={C.metaTitle}
  description={C.metaDesc}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="la">
    <div class="la-container">
      {/* HERO + CONSOLE */}
      <section class="la-hero">
        <div class="la-hero-copy">
          <div class="la-hero-badge">{C.heroEyebrow}</div>
          <p class="la-hero-lead">{C.heroLead}</p>
          <h1 class="la-h1">{C.heroH1}</h1>
          <p class="la-sub">{C.heroSub}</p>
          <div class="la-standards">
            <span class="la-standards-label">{C.standardsLabel}</span>
            {C.standards.map((s) => <span class="la-tag">{s}</span>)}
          </div>
          <div class="la-hero-cta">
            <a class="la-btn" href={sandboxUrl} target="_blank" rel="noopener">{C.ctaSandbox}</a>
            <a class="la-btn la-btn--ghost" href="#workflow">{C.heroSee}</a>
          </div>
        </div>
        <div class="la-console" aria-hidden="true">
          <div class="la-console-cmd">{C.consoleCmd}</div>
          {C.consoleRows.map((r) => (
            <div class="la-console-row">
              <span class="la-console-k">{r.k}</span>
              <span class="la-console-v">{r.v}</span>
              <span class="la-console-ok">✓</span>
            </div>
          ))}
          <div class="la-console-tail">{C.consoleTail}</div>
        </div>
      </section>
    </div>

    <nav class="la-secnav" aria-label={C.secNavLabel}>
      <div class="la-secnav-inner">
        <span class="la-secnav-label">{C.secNavLabel}</span>
        <div class="la-secnav-pills">
          {C.secNav.map((it) => (
            <a class="la-secnav-pill" href={`#${it.id}`} data-sec={it.id}>{it.l}</a>
          ))}
        </div>
      </div>
    </nav>

    {/* 5 PROOFS — numbered cards */}
    <section class="la-band" id="proofs">
      <div class="la-container">
        <div class="la-eyebrow">{C.proofsEyebrow}</div>
        <h2 class="la-h2">{C.proofsH2}</h2>

        <ol class="la-proofs">
          {proofs.map((p, i) => (
            <li class="la-proof">
              <span class="la-proof-n">{`0${i + 1}`}</span>
              <span class="la-proof-icon"><Fragment set:html={p.svg} /></span>
              <span class="la-proof-body">
                <span class="la-proof-eyebrow">{p.nameJa} · {p.nameEn}</span>
                <span class="la-proof-slogan">{p.slogan}</span>
                <span class="la-proof-reach">{p.reach}</span>
              </span>
              <span class="la-proof-meta">
                <span class="la-proof-prim">{p.primitives}</span>
                <a class="la-proof-link" href={p.href}>{C.proofsMore}</a>
              </span>
            </li>
          ))}
        </ol>
        <p class="la-proofs-foot">{C.proofsFoot}</p>
      </div>
    </section>

    {/* AI WORKFLOW — where each proof plugs into the AI pipeline */}
    <section class="la-wf" id="workflow">
      <div class="la-container">
        <div class="la-eyebrow">{C.wfEyebrow}</div>
        <h2 class="la-h2">{C.wfH2}</h2>
        <p class="la-section-sub">{C.wfLead}</p>
        <div class="la-wf-grid">
          {wfFlows.map((f) => (
            <div class="la-wf-col">
              <div class="la-wf-phase">
                <div class="la-wf-ph">{f.phase}</div>
                <div class="la-wf-phname">{f.phaseName}</div>
              </div>
              <div class="la-wf-plus" aria-hidden="true">+</div>
              <a href={f.href} class="la-wf-proof">
                <div class="la-wf-proofname">{f.proofName}</div>
                <div class="la-wf-auth">{f.auth}</div>
                <span class="la-wf-link">{C.wfMore}</span>
              </a>
            </div>
          ))}
        </div>
        <p class="la-wf-note">{C.wfNote}</p>
      </div>
    </section>

    {/* INTEGRATION — how you actually use the API (developer 3-step) */}
    <section class="la-int" id="integration">
      <div class="la-container">
        <div class="la-eyebrow">{C.intEyebrow}</div>
        <h2 class="la-h2">{C.intH2}</h2>
        <p class="la-section-sub">{C.intLead}</p>
        <ol class="la-int-steps">
          {C.intSteps.map((s) => (
            <li class="la-int-step">
              <span class="la-int-n">{s.n}</span>
              <span class="la-int-body">
                <span class="la-int-t">{s.t}</span>
                <span class="la-int-d">{s.d}</span>
              </span>
              <span class="la-int-tag">{s.tag}</span>
            </li>
          ))}
        </ol>
        <div class="la-int-standards">{C.intStandards}</div>
        <p class="la-note">{C.intNote}</p>
        <div class="la-int-cta">
          <a class="la-btn" href={sandboxUrl} target="_blank" rel="noopener">{C.intSandbox}</a>
          <a class="la-btn la-btn--ghost" href={specsHref}>{C.intSpecs}</a>
          <a class="la-int-github" href={githubUrl} target="_blank" rel="noopener">{C.intGithub}</a>
        </div>
      </div>
    </section>

    {/* HOW IT WORKS — mechanism diagram (発行→証明→検証), full-width dark */}
    <section class="la-mech" id="mechanism">
      <div class="la-mech-inner">
        <div class="la-eyebrow on-dark">{C.mechEyebrow}</div>
        <h2 class="la-mech-h2">{C.mechH2a}<br /><span class="la-mech-accent">{C.mechH2accent}</span>{C.mechH2tail}</h2>
        <p class="la-mech-sub">{C.mechSub}</p>
        <div class="la-mech-flow">
          {mechCells.map((cell) => cell.arrow ? (
            <div class="la-mech-arrow" aria-hidden="true">→</div>
          ) : (
            <div class="la-mech-phase">
              <div class="la-mech-viz"><Fragment set:html={cell.phase.svg} /></div>
              <div class="la-mech-step">{cell.phase.step}</div>
              <h3 class="la-mech-title">{cell.phase.title}</h3>
              <p class="la-mech-desc">{cell.phase.desc}</p>
              <div class="la-mech-prims">
                {cell.phase.prims.map((pr) => <div class="la-mech-prim">{pr}</div>)}
              </div>
            </div>
          ))}
        </div>
        <div class="la-mech-bottom">
          <div class="la-mech-stack">
            {mechStack.map((s) => (
              <div class="la-mech-stack-item">{s.label} <span class="la-mech-stack-meta">{s.meta}</span></div>
            ))}
          </div>
          <a href={specsHref} class="la-mech-cta">{C.mechCta} →</a>
        </div>
      </div>
    </section>

    {/* CORE CRYPTOGRAPHY — 3 cards, full-width dark */}
    <section class="la-tech" id="cores">
      <div class="la-tech-inner">
        <h2 class="la-tech-h2"><span class="la-tech-accent">{C.coreH2a}</span><br />{C.coreH2b}</h2>
        <p class="la-tech-lead">{C.coreLead}</p>
        <div class="la-tech-grid">
          {cores.map((c) => (
            <div class="la-tech-card">
              <span class="la-tech-icon"><Fragment set:html={c.svg} /></span>
              <div class="la-tech-name-en" set:html={c.nameEn}></div>
              <div class="la-tech-name-ja">{c.nameJa}</div>
              <p class="la-tech-desc" set:html={c.desc}></p>
              <div class="la-tech-strength">
                <div class="la-tech-strength-lbl">{C.coreStrengthLabel}</div>
                <div class="la-tech-strength-txt" set:html={c.strength}></div>
              </div>
              <a href={c.docHref} class="la-tech-doclink">{C.coreDocLink} →</a>
              <div class="la-tech-valuemap" set:html={c.valueMap}></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="la-container">
      {/* PRICING PATHWAY — no prices */}
      <section class="la-section" id="pricing">
        <div class="la-eyebrow">{C.priceEyebrow}</div>
        <h2 class="la-h2">{C.priceH2}</h2>
        <p class="la-section-sub">{C.priceBody}</p>
        <a class="la-btn la-btn--ghost" href={pricingHref}>{C.priceCta}</a>
      </section>

      {/* HOW IT FITS — footnote */}
      <section class="la-section la-foot">
        <p class="la-foot-note">{C.relNote}</p>
        <p class="la-foot-tagline">{C.tagline}</p>
      </section>
    </div>

    {/* CTA — two branches */}
    <section class="la-cta">
      <div class="la-container">
        <div class="la-eyebrow on-dark">{C.ctaEyebrow}</div>
        <h2 class="la-cta-h2">{C.ctaH2}</h2>
        <div class="la-cta-grid">
          <div class="la-cta-card">
            <div class="la-cta-label">{C.ctaDevLabel}</div>
            <div class="la-cta-actions">
              <a class="la-btn" href={sandboxUrl} target="_blank" rel="noopener">{C.ctaDevBtn}</a>
              <a class="la-btn la-btn--ghost on-dark" href={specsHref}>{C.ctaDevSpecs}</a>
              <a class="la-cta-link" href={githubUrl} target="_blank" rel="noopener">{C.ctaGithub}</a>
            </div>
          </div>
          <div class="la-cta-card">
            <div class="la-cta-label">{C.ctaEntLabel}</div>
            <p class="la-cta-lead">{C.ctaEntLead}</p>
            <div class="la-cta-actions">
              <a class="la-btn la-btn--accent" href={discoveryUrl} target="_blank" rel="noopener">{C.ctaEntBtn}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .la {
    --la-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --la-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --la-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --la-t1: #1a1a1a;
    --la-t2: #3a3a3a;
    --la-t3: #5a5a5a;
    --la-t4: #9a9a9a;
    background: var(--lemma-cream, #fcfaf5);
    color: var(--la-t2);
    font-family: var(--la-body);
    line-height: 1.7;
    margin-top: 64px;
  }
  :root[lang="en"] .la { --la-body: "Sora", "Noto Sans JP", system-ui, sans-serif; }
  .la-container { max-width: 1000px; margin: 0 auto; padding: 0 40px; }
  /* Links style their own color via their class; don't force-inherit the body
     grey (that clobbered .la-btn cream text → grey-on-brown, unreadable). */
  .la a { text-decoration: none; }

  .la-eyebrow {
    font-family: var(--la-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    color: var(--accent, #8b4513);
    display: flex; align-items: center; gap: 10px; margin: 0 0 20px;
  }
  .la-eyebrow::before { content: ""; width: 16px; height: 2px; background: var(--accent, #8b4513); flex: none; }
  /* Hero eyebrow as a boxed badge (Trust402-style), hub palette */
  .la-hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--la-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    color: var(--accent, #8b4513); background: var(--lemma-brown-light, #f3ece4);
    border: 0.5px solid #e4d6c3; padding: 4px 11px; border-radius: 5px; margin: 0 0 18px;
  }
  .la-eyebrow.on-dark { color: #d8b48c; }
