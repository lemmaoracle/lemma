---
/**
 * Lemma API overview — the product-hub page (code納品 20260707: §1–6).
 *
 * The canonical "Lemma API 全体像" page: hero + console → 5つの証明 (numbered
 * cards with an issue→prove→verify flow band) → 仕組み 3-step → 中核暗号 3
 * columns → 料金導線 → CTA 分岐. Terminology is "Lemma API / 5つの証明"
 * (the "柱 / Pillar / 4つの軸" framing is retired). No prices on this page
 * (→ /pricing#api); no endpoints or code (→ specs); the page never calls the
 * API. Copy is inline-bilingual. Rendered at /lemma-api today; PR-B repoints
 * /pillars here and redirects /lemma-api → /pillars.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { DISCOVERY_CALL_URL, DASHBOARD_URL } from "../config/cta";
import { PROOF_CLASSES, proofClassHref } from "../config/proofClasses";

interface Props {
  locale: Locale;
  t: Translations;
  base: string;
}
const { locale, t, base } = Astro.props as Props;
const isJa = locale === "ja";

const sandboxUrl = DASHBOARD_URL;
const specsHref = `${base}/guides`;
const pricingHref = `${base}/pricing#api`;
const discoveryUrl = `${DISCOVERY_CALL_URL[locale]}?source=lemma-api`;
const githubUrl = "https://github.com/lemmaoracle";

// Locale-neutral per-proof metadata (number, crypto primitives, icon). Slogan
// + 到達点 copy live in the locale `C.proofs` array (same order as
// PROOF_CLASSES / code納品 §2); href comes from the shared single source.
const PROOF_META = [
  {
    primitives: "Poseidon · BBS+",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="6" cy="18.5" r="2.4"/><circle cx="18" cy="5.5" r="2.4"/><path d="M8.1 17.2 C 13 14 12 9.5 15.6 7"/></svg>`,
  },
  {
    primitives: "ZK Sign-in · Groth16",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3 19 6 V11 C19 15.8 15.7 19.4 12 21 C8.3 19.4 5 15.8 5 11 V6 Z"/><rect x="9.4" y="11" width="5.2" height="4.6" rx="1"/><path d="M10.4 11 V9.6 a1.6 1.6 0 0 1 3.2 0 V11"/></svg>`,
  },
  {
    primitives: "Groth16 · EIP-3009",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="8" cy="8" r="4"/><path d="M10.8 10.8 L20 20"/><path d="M17.5 17.5 l1.8 -1.8"/><path d="M14.6 14.6 l1.8 -1.8"/></svg>`,
  },
  {
    primitives: "Groth16 · Circom",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="7" y="7" width="10" height="10" rx="1.6"/><path d="M10 3v3M14 3v3M10 18v3M14 18v3M3 10h3M3 14h3M18 10h3M18 14h3"/></svg>`,
  },
  {
    primitives: "BBS+ Selective",
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="11.5" rx="1.6"/><path d="M7 8h10M7 11h6"/><circle cx="12" cy="18" r="2.4"/><path d="M10.4 19.7 L9.4 23 L12 21.4 L14.6 23 L13.6 19.7"/></svg>`,
  },
] as const;

const C = isJa
  ? {
      metaTitle: "Lemma API — 来歴・認証・権限・推論・属性を1つの API で | Lemma",
      metaDesc:
        "生データを渡さずに証明を発行する ZK 証明の発行 API。来歴・認証・権限・推論・属性の5つの証明を、1つの API で。検証はいつでも無料。MCP / A2A / x402 / C2PA / W3C VC 対応。",
      heroEyebrow: "lemma api",
      heroLead: "モデルは変わる。証明は残る。",
      heroH1: "生データは渡さない。証明だけを、送る。",
      heroSub:
        "Lemma API は、来歴・認証・権限・推論・属性の 5つの証明 を発行します。生データを渡さずに証明し、検証はいつでも無料です。",
      consoleCmd: "$ lemma prove · class: origin",
      consoleRows: [
        { k: "commit", v: "Poseidon over BN254" },
        { k: "issue", v: "BBS+ over BLS12-381" },
        { k: "verify", v: "public · free" },
      ],
      consoleTail: "→ data never left source",
      standardsLabel: "対応標準",
      standards: ["MCP", "A2A", "x402", "C2PA", "W3C VC"],
      ctaSandbox: "Sandbox で試す（testnet・無料）",
      ctaSpecs: "仕様書を読む →",

      proofsEyebrow: "5つの証明",
      proofsH2: "1つの API で、5種の証明。",
      flow: [
        { t: "発行", s: "x402 都度" },
        { t: "証明", s: "ZK・選択的開示" },
        { t: "検証", s: "無料・誰でも" },
      ],
      proofs: [
        { slogan: "原本を渡さず、出所を証明する。", reach: "データの出所と非改ざんを、中身を出さず証明できる。" },
        { slogan: "鍵を送らず、本人だと証明する。", reach: "本人性を、鍵を一度も送らずに証明できる。" },
        { slogan: "鍵を渡さず、権限だけを委ねる。", reach: "範囲内なら全速、範囲外で止まる委任を組める。" },
        { slogan: "モデルを開示せず、推論を証明する。", reach: "AI の入力と動作の整合性を、独立に検証できる。" },
        { slogan: "属性を明かさず、要件を満たすと証明する。", reach: "規制属性を、原本を渡さず選択的に証明できる。" },
      ],
      proofsMore: "詳しく →",
      proofsFoot: "発行に課金・検証はいつでも無料。各証明の詳細は個別ページへ（認証は Seal）。",

      howEyebrow: "仕組み",
      howH2: "既存フローに、1レイヤー。",
      how: [
        { n: "01", t: "発行", d: "ソースで証明を作る。生データは外に出ません。", tag: "SDK · x402" },
        { n: "02", t: "証明", d: "必要な事実だけを選んで開示。ZK 選択的開示で入力を最小化します。", tag: "Groth16 · BBS+" },
        { n: "03", t: "検証", d: "誰でも、無料で確かめられます。公開検証、信頼は不要。", tag: "public verify" },
      ],
      howNote: "エンドポイントとコード例は、仕様書にまとめています。このページから API を呼び出すことはありません。",

      coreEyebrow: "中核暗号",
      coreH2: "独自の暗号技術、3つの中核。",
      cores: [
        {
          t: "ゼロ知識証明",
          d: "ビジネスルールを、原本に触れず真偽だけ証明します。",
          s: "回路（Circom）とジェネレーターごと永続記録し、第三者が後から再現できます。",
        },
        {
          t: "選択的開示",
          d: "発行者署名との紐づけを保ったまま、必要な属性だけを公開します。",
          s: "1発行物から、相手・用途ごとに開示範囲を可変にできます。",
        },
        {
          t: "オンチェーン来歴",
          d: "commit・スキーマ・発行者・検証結果をアンカーします。",
          s: "docHash と CID だけを公開し、本体は AES-GCM で暗号化したまま残せます。",
        },
      ],
      coreStrengthLabel: "強み",

      priceEyebrow: "料金",
      priceH2: "発行に課金、検証は無料。",
      priceBody:
        "発行に課金し、検証は常に無料です。月額なしの従量課金に加え、定額の quota / grade プランを近日提供します。オンチェーンの永続記録は選択制です。",
      priceCta: "料金は /pricing で →",

      relNote:
        "認証は、この API の認証 suite です（入口ページとして Seal を用意しています）。Trust402 は、この API を自己サーブで使うためのラッパー（Pay / Sell）です。",
      tagline: "Built for decisions that matter.",

      ctaEyebrow: "はじめる",
      ctaH2: "モデルは変わる。証明は残る。",
      ctaDevLabel: "開発者の方へ",
      ctaDevBtn: "Sandbox で試す（testnet・無料）",
      ctaDevSpecs: "仕様書",
      ctaGithub: "GitHub →",
      ctaEntLabel: "エンタープライズの方へ",
      ctaEntLead: "御社の業務に合わせて構成します。",
      ctaEntBtn: "デモを予約 →",
    }
  : {
      metaTitle: "Lemma API — provenance, authentication, authority, inference, attribute in one API | Lemma",
      metaDesc:
        "The ZK proof issuance API — issue proofs without handing over raw data. Provenance, authentication, authority, inference, and attribute — five proofs in one API. Verification is always free. MCP / A2A / x402 / C2PA / W3C VC compliant.",
      heroEyebrow: "lemma api",
      heroLead: "Models change. Proofs remain.",
      heroH1: "Raw data never leaves. Only the proof is sent.",
      heroSub:
        "The Lemma API issues five proofs — provenance, authentication, authority, inference, and attribute. Prove without handing over raw data, and verification is always free.",
      consoleCmd: "$ lemma prove · class: origin",
      consoleRows: [
        { k: "commit", v: "Poseidon over BN254" },
        { k: "issue", v: "BBS+ over BLS12-381" },
        { k: "verify", v: "public · free" },
      ],
      consoleTail: "→ data never left source",
      standardsLabel: "Standards",
      standards: ["MCP", "A2A", "x402", "C2PA", "W3C VC"],
      ctaSandbox: "Try the Sandbox (testnet · free)",
      ctaSpecs: "Read the specs →",

      proofsEyebrow: "Five proofs",
      proofsH2: "Five kinds of proof, one API.",
      flow: [
        { t: "Issue", s: "per-use x402" },
        { t: "Prove", s: "ZK · selective" },
        { t: "Verify", s: "free · anyone" },
      ],
      proofs: [
        { slogan: "Prove origin without handing over the original.", reach: "Prove where data came from and that it's untampered — without exposing the contents." },
        { slogan: "Prove identity without sending a key.", reach: "Prove who you are without ever sending a key." },
        { slogan: "Delegate authority without handing over a key.", reach: "Build delegation that runs at full speed in scope and stops outside it." },
        { slogan: "Prove inference without disclosing the model.", reach: "Independently verify the consistency of an AI's inputs and behavior." },
        { slogan: "Prove you meet a requirement without revealing the attribute.", reach: "Prove regulated attributes selectively — without handing over the original." },
      ],
      proofsMore: "Learn more →",
      proofsFoot: "Issuance is billed; verification is always free. Each proof's detail is on its own page (authentication → Seal).",

      howEyebrow: "How it works",
      howH2: "One layer on your existing flow.",
      how: [
        { n: "01", t: "Issue", d: "Create the proof at the source. Raw data never leaves.", tag: "SDK · x402" },
        { n: "02", t: "Prove", d: "Disclose only the facts you choose. ZK selective disclosure minimizes the input.", tag: "Groth16 · BBS+" },
        { n: "03", t: "Verify", d: "Anyone can check it, for free. Public verification, no trust required.", tag: "public verify" },
      ],
      howNote: "Endpoints and code samples are in the specs. This page never calls the API.",

      coreEyebrow: "Core cryptography",
      coreH2: "Our own cryptography, three cores.",
      cores: [
        {
          t: "Zero-knowledge proofs",
          d: "Prove business rules true or false without touching the original.",
          s: "Each circuit (Circom) and generator is persisted, so a third party can reproduce it later.",
        },
        {
          t: "Selective disclosure",
          d: "Reveal only the attributes you need while keeping the issuer signature bound.",
          s: "From one issuance, vary the disclosure range per recipient and purpose.",
        },
        {
          t: "On-chain provenance",
          d: "Anchor the commit, schema, issuer, and verification result.",
          s: "Publish only docHash and CID; the body stays encrypted with AES-GCM.",
        },
      ],
      coreStrengthLabel: "Strength",

      priceEyebrow: "Pricing",
      priceH2: "Issuance is billed; verification is free.",
      priceBody:
        "You pay to issue; verification is always free. Beyond usage-based billing with no monthly fee, flat-rate quota / grade plans are coming soon. On-chain permanence is optional.",
      priceCta: "See pricing on /pricing →",

      relNote:
        "Authentication is this API's authentication suite (Seal is its landing page). Trust402 is the wrapper for using this API self-serve (Pay / Sell).",
      tagline: "Built for decisions that matter.",

      ctaEyebrow: "Get started",
      ctaH2: "Models change. Proofs remain.",
      ctaDevLabel: "For developers",
      ctaDevBtn: "Try the Sandbox (testnet · free)",
      ctaDevSpecs: "Specs",
      ctaGithub: "GitHub →",
      ctaEntLabel: "For enterprises",
      ctaEntLead: "We configure it to your operations.",
      ctaEntBtn: "Book a demo →",
    };

// Zip the shared class list (name + canonical href) with the locale-neutral
// meta and the localized slogan/reach copy — same order across all three.
const proofs = PROOF_CLASSES.map((c, i) => ({
  nameJa: c.name.ja,
  nameEn: c.name.en,
  primitives: PROOF_META[i].primitives,
  svg: PROOF_META[i].svg,
  href: proofClassHref(c, base),
  slogan: C.proofs[i].slogan,
  reach: C.proofs[i].reach,
}));
---

<Layout
  locale={locale}
  metaType="page"
  pagePath="/lemma-api/"
  title={C.metaTitle}
  description={C.metaDesc}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="la">
    <div class="la-container">
      {/* HERO + CONSOLE */}
      <section class="la-hero">
        <div class="la-hero-copy">
          <div class="la-eyebrow">{C.heroEyebrow}</div>
          <p class="la-hero-lead">{C.heroLead}</p>
          <h1 class="la-h1">{C.heroH1}</h1>
          <p class="la-sub">{C.heroSub}</p>
          <div class="la-standards">
            <span class="la-standards-label">{C.standardsLabel}</span>
            {C.standards.map((s) => <span class="la-tag">{s}</span>)}
          </div>
          <div class="la-hero-cta">
            <a class="la-btn" href={sandboxUrl} target="_blank" rel="noopener">{C.ctaSandbox}</a>
            <a class="la-btn la-btn--ghost" href={specsHref}>{C.ctaSpecs}</a>
          </div>
        </div>
        <div class="la-console" aria-hidden="true">
          <div class="la-console-cmd">{C.consoleCmd}</div>
          {C.consoleRows.map((r) => (
            <div class="la-console-row">
              <span class="la-console-k">{r.k}</span>
              <span class="la-console-v">{r.v}</span>
              <span class="la-console-ok">✓</span>
            </div>
          ))}
          <div class="la-console-tail">{C.consoleTail}</div>
        </div>
      </section>
    </div>

    {/* 5 PROOFS — flow band + numbered cards */}
    <section class="la-band">
      <div class="la-container">
        <div class="la-eyebrow">{C.proofsEyebrow}</div>
        <h2 class="la-h2">{C.proofsH2}</h2>

        <div class="la-flowband">
          {C.flow.map((f, i) => (
            <span class={`la-flowband-step${i === C.flow.length - 1 ? " is-free" : ""}`}>
              <span class="la-flowband-t">{f.t}</span>
              <span class="la-flowband-s">{f.s}</span>
            </span>
          ))}
        </div>

        <ol class="la-proofs">
          {proofs.map((p, i) => (
            <li class="la-proof">
              <span class="la-proof-n">{`0${i + 1}`}</span>
              <span class="la-proof-icon"><Fragment set:html={p.svg} /></span>
              <span class="la-proof-body">
                <span class="la-proof-eyebrow">{p.nameJa} · {p.nameEn}</span>
                <span class="la-proof-slogan">{p.slogan}</span>
                <span class="la-proof-reach">{p.reach}</span>
              </span>
              <span class="la-proof-meta">
                <span class="la-proof-prim">{p.primitives}</span>
                <a class="la-proof-link" href={p.href}>{C.proofsMore}</a>
              </span>
            </li>
          ))}
        </ol>
        <p class="la-proofs-foot">{C.proofsFoot}</p>
      </div>
    </section>

    <div class="la-container">
      {/* HOW IT WORKS — 3 steps */}
      <section class="la-section">
        <div class="la-eyebrow">{C.howEyebrow}</div>
        <h2 class="la-h2">{C.howH2}</h2>
        <ol class="la-how">
          {C.how.map((s) => (
            <li class="la-how-step">
              <span class="la-how-n">{s.n}</span>
              <span class="la-how-body">
                <span class="la-how-t">{s.t}</span>
                <span class="la-how-d">{s.d}</span>
              </span>
              <span class="la-how-tag">{s.tag}</span>
            </li>
          ))}
        </ol>
        <p class="la-note">{C.howNote}</p>
      </section>

      {/* CORE CRYPTOGRAPHY — 3 columns */}
      <section class="la-section">
        <div class="la-eyebrow">{C.coreEyebrow}</div>
        <h2 class="la-h2">{C.coreH2}</h2>
        <div class="la-cores">
          {C.cores.map((c) => (
            <div class="la-core">
              <div class="la-core-t">{c.t}</div>
              <p class="la-core-d">{c.d}</p>
              <p class="la-core-s"><span class="la-core-s-label">{C.coreStrengthLabel}</span>{c.s}</p>
            </div>
          ))}
        </div>
      </section>

      {/* PRICING PATHWAY — no prices */}
      <section class="la-section">
        <div class="la-eyebrow">{C.priceEyebrow}</div>
        <h2 class="la-h2">{C.priceH2}</h2>
        <p class="la-section-sub">{C.priceBody}</p>
        <a class="la-btn la-btn--ghost" href={pricingHref}>{C.priceCta}</a>
      </section>

      {/* HOW IT FITS — footnote */}
      <section class="la-section la-foot">
        <p class="la-foot-note">{C.relNote}</p>
        <p class="la-foot-tagline">{C.tagline}</p>
      </section>
    </div>

    {/* CTA — two branches */}
    <section class="la-cta">
      <div class="la-container">
        <div class="la-eyebrow on-dark">{C.ctaEyebrow}</div>
        <h2 class="la-cta-h2">{C.ctaH2}</h2>
        <div class="la-cta-grid">
          <div class="la-cta-card">
            <div class="la-cta-label">{C.ctaDevLabel}</div>
            <div class="la-cta-actions">
              <a class="la-btn" href={sandboxUrl} target="_blank" rel="noopener">{C.ctaDevBtn}</a>
              <a class="la-btn la-btn--ghost on-dark" href={specsHref}>{C.ctaDevSpecs}</a>
              <a class="la-cta-link" href={githubUrl} target="_blank" rel="noopener">{C.ctaGithub}</a>
            </div>
          </div>
          <div class="la-cta-card">
            <div class="la-cta-label">{C.ctaEntLabel}</div>
            <p class="la-cta-lead">{C.ctaEntLead}</p>
            <div class="la-cta-actions">
              <a class="la-btn la-btn--accent" href={discoveryUrl} target="_blank" rel="noopener">{C.ctaEntBtn}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .la {
    --la-display: "Sora", "Noto Sans JP", system-ui, sans-serif;
    --la-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --la-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --la-t1: #1a1a1a;
    --la-t2: #3a3a3a;
    --la-t3: #5a5a5a;
    --la-t4: #9a9a9a;
    background: var(--lemma-cream, #fcfaf5);
    color: var(--la-t2);
    font-family: var(--la-body);
    line-height: 1.7;
    margin-top: 64px;
  }
  :root[lang="en"] .la { --la-body: "Sora", "Noto Sans JP", system-ui, sans-serif; }
  .la-container { max-width: 1000px; margin: 0 auto; padding: 0 40px; }
  .la a { text-decoration: none; color: inherit; }

  .la-eyebrow {
    font-family: var(--la-mono); font-size: 11px; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--accent, #8b4513);
    display: flex; align-items: center; gap: 12px; margin: 0 0 20px;
  }
  .la-eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--accent, #8b4513); flex: none; }
  .la-eyebrow.on-dark { color: #d8b48c; }
  .la-eyebrow.on-dark::before { background: #d8b48c; }

  /* HERO */
  .la-hero {
    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center;
    padding: 72px 0 56px;
  }
  .la-hero-lead { font-family: var(--la-mono); font-size: 13px; letter-spacing: 0.02em; color: var(--la-t3); margin: 0 0 14px; }
  .la-h1 {
    font-family: var(--la-display); font-size: clamp(30px, 4.4vw, 48px);
    font-weight: 700; line-height: 1.14; letter-spacing: -0.03em;
    color: var(--black, #1a1a1a); margin: 0 0 22px;
  }
  :root[lang="ja"] .la-h1 { line-height: 1.28; }
  .la-sub { font-size: 16px; line-height: 1.85; color: var(--la-t2); max-width: 540px; margin: 0 0 22px; }
  .la-standards { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 26px; }
  .la-standards-label { font-family: var(--la-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--la-t4); margin-right: 4px; }
  .la-tag {
    font-family: var(--la-mono); font-size: 11px; font-weight: 700; color: var(--la-t3);
    background: var(--white, #fff); border: 0.5px solid var(--lemma-line, #e6e1d6);
    border-radius: 999px; padding: 3px 10px;
  }
