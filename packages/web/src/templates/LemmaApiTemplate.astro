<script>
  // Sticky section-nav scroll-spy. Event-driven (IntersectionObserver + scroll
  // backstop), no perpetual rAF loop — matches PricingSectionNav so it keeps
  // working when the tab is backgrounded.
  (function () {
    const nav = document.querySelector(".la-secnav");
    if (!nav) return;
    const pills = Array.from(nav.querySelectorAll(".la-secnav-pill"));
    const secs = pills
      .map((p) => document.getElementById(p.getAttribute("data-sec")))
      .filter(Boolean);
    if (!secs.length) return;
    const OFFSET = 130;
    let lastId = null;
    function recompute() {
      let best = secs[0];
      for (const s of secs) {
        if (s.getBoundingClientRect().top - OFFSET <= 0) best = s;
      }
      if (best && best.id !== lastId) {
        lastId = best.id;
        pills.forEach((p) =>
          p.classList.toggle("active", p.getAttribute("data-sec") === best.id)
        );
      }
    }
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(recompute, {
        rootMargin: "-130px 0px -70% 0px",
        threshold: 0,
      });
      secs.forEach((s) => io.observe(s));
    }
    window.addEventListener("scroll", recompute, { passive: true, capture: true });
    window.addEventListener("resize", recompute, { passive: true });
    recompute();
  })();
</script>
