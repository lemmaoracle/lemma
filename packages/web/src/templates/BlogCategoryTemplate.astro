---
/**
 * Lemma blog — category archive page, v24-aligned.
 *
 * Cream page chrome + container 1100px + Sora display + Noto Sans JP
 * body + Space Mono labels + saddle brown accent. Card grid uses the
 * same Brief Index-style brief-card spec as the blog index (mono No /
 * date / Sora title / sub / brown-light primary tag / mono cta / brown
 * top-bar hover).
 *
 * The dark hero (margin-top 64px + black bg + cream text) is replaced
 * with a cream container hero matching the Brief Pillar / Category
 * archives. Sibling category pills are rendered as v24 chips.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { categorySlug } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import BlogCover from "../components/BlogCover.astro";

export interface BlogCategoryTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  category: string;
  /** Categories that have an archive page, for the sibling nav. */
  categories: ReadonlyArray<string>;
  posts: ReadonlyArray<BlogPost>;
}

const { locale, t, base, blogPath, category, categories, posts } =
  Astro.props as BlogCategoryTemplateProps;

const isJa = locale === "ja";
const homeLabel = isJa ? "ホーム" : "Home";
const countLabel = isJa
  ? `${posts.length} 件の記事`
  : `${posts.length} ${posts.length === 1 ? "article" : "articles"}`;
---

<Layout
  locale={locale}
  title={`${category} — ${t.blog.title}`}
  description={`${category}: ${t.blog.metaDescription}`}
  metaType="page"
  pagePath={`/blog/category/${categorySlug(category)}/`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="bc-page">
    <div class="bc-container">
      <div class="bc-breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="bc-breadcrumb-sep">/</span>
        <a href={blogPath}>{t.blog.title}</a>
        <span class="bc-breadcrumb-sep">/</span>
        <span>{category}</span>
      </div>

      <section class="bc-hero">
        <div class="bc-eyebrow">{t.blog.title} · {category}</div>
        <h1 class="bc-h1">{category}</h1>
        {posts.length > 0 && <div class="bc-count">{countLabel}</div>}
      </section>

      {categories.length > 1 && (
        <nav class="bc-siblings" aria-label="Other categories">
          {categories.map((c) => (
            <a
              href={`${blogPath}/category/${categorySlug(c)}`}
              class={c === category ? "bc-chip is-active" : "bc-chip"}
            >
              {c}
            </a>
          ))}
        </nav>
      )}

      {posts.length === 0 ? (
        <section class="bc-empty">
          <div class="bc-empty-label">
            {isJa ? "記事は準備中" : "Essays coming soon"}
          </div>
          <p class="bc-empty-body">
            {isJa
              ? "このカテゴリの記事は現在編成中です。"
              : "Articles in this category are currently being compiled."}
          </p>
          <a class="bc-empty-cta" href={blogPath}>
            {t.blog.backToBlog} →
          </a>
        </section>
      ) : (
        <section class="bc-grid" aria-label={category}>
          {posts.map((post) => (
            <a href={`${blogPath}/${post.slug}`} class="bc-card">
              <div class="bc-card-thumb">
                <BlogCover category={post.category} slug={post.slug} />
              </div>
              <div class="bc-card-body">
                <div class="bc-card-meta">
                  <span class="bc-card-cat">{post.category}</span>
                  <span class="bc-card-sep">·</span>
                  <span class="bc-card-date">{post.date}</span>
                </div>
                <h2 class="bc-card-title">{post.title}</h2>
                <span class="bc-card-cta">
                  {isJa ? "読む →" : "Read →"}
                </span>
              </div>
            </a>
          ))}
        </section>
      )}

      <a href={blogPath} class="bc-back-link">← {t.blog.backToBlog}</a>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .bc-page {
    --bc-display: "Sora", system-ui, sans-serif;
    --bc-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --bc-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --bc-text-1: #1a1a1a;
    --bc-text-2: #3a3a3a;
    --bc-text-3: #5a5a5a;
    --bc-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--bc-text-2);
    font-family: var(--bc-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .bc-page {
    --bc-body: "Sora", system-ui, sans-serif;
  }

  .bc-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── BREADCRUMB ─── */
  .bc-breadcrumb {
    font-family: var(--bc-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bc-text-4);
    padding: 36px 0 0;
  }
  .bc-breadcrumb a {
    color: var(--bc-text-3);
    transition: color 0.15s;
  }
  .bc-breadcrumb a:hover {
    color: var(--accent);
  }
  .bc-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .bc-hero {
    padding: 32px 0 32px;
    max-width: 880px;
  }
  .bc-eyebrow {
    font-family: var(--bc-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bc-text-3);
    margin: 0 0 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bc-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .bc-h1 {
    font-family: var(--bc-display);
    font-size: clamp(40px, 5.4vw, 56px);
    font-weight: 700;
    line-height: 1.06;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.03em;
  }
  :root[lang="ja"] .bc-h1 {
    font-size: clamp(34px, 4.6vw, 46px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .bc-count {
    font-family: var(--bc-mono);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    color: var(--accent);
    padding-top: 16px;
    border-top: 0.5px solid var(--lemma-line);
    display: inline-block;
    padding-right: 24px;
    font-variant-numeric: tabular-nums;
  }

  /* ─── SIBLING CHIPS ─── */
  .bc-siblings {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 48px;
  }
  .bc-chip {
    font-family: var(--bc-display);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--bc-text-3);
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    padding: 9px 16px;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .bc-chip:hover {
    color: var(--accent);
    border-color: rgba(139, 69, 19, 0.4);
    background: var(--lemma-brown-light);
  }
  .bc-chip.is-active {
    color: var(--lemma-cream);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* ─── EMPTY STATE ─── */
  .bc-empty {
    margin: 24px 0 0;
    padding: 56px 40px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 16px;
    text-align: center;
    max-width: 640px;
  }
  .bc-empty-label {
    font-family: var(--bc-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }
  .bc-empty-body {
    font-family: var(--bc-body);
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--bc-text-2);
    margin: 0 0 22px;
  }
  .bc-empty-cta {
    font-family: var(--bc-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  /* ─── CARD GRID ─── */
  .bc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .bc-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
  }
  .bc-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    z-index: 1;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bc-card:hover {
    border-color: rgba(139, 69, 19, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .bc-card:hover::before {
    width: 100%;
  }
  .bc-card-thumb {
    aspect-ratio: 16 / 9;
    background-color: var(--lemma-cream-deep);
    overflow: hidden;
  }
  .bc-card-thumb :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .bc-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 22px;
    flex: 1;
  }
  .bc-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--bc-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--bc-text-3);
  }
  .bc-card-cat {
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bc-card-sep {
    color: var(--lemma-line);
  }
  .bc-card-date {
    font-variant-numeric: tabular-nums;
  }
  .bc-card-title {
    font-family: var(--bc-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--black);
    letter-spacing: -0.015em;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :root[lang="ja"] .bc-card-title {
    line-height: 1.5;
  }
  .bc-card-cta {
    font-family: var(--bc-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 14px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .bc-card:hover .bc-card-cta {
    transform: translateX(3px);
  }

  .bc-back-link {
    display: inline-block;
    margin-top: 56px;
    font-family: var(--bc-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--bc-text-3);
    transition: color 0.15s, transform 0.2s;
  }
  .bc-back-link:hover {
    color: var(--accent);
    transform: translateX(-3px);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .bc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .bc-container {
      padding: 0 24px;
    }
    .bc-hero {
      padding: 24px 0 24px;
    }
    .bc-grid {
      grid-template-columns: 1fr;
    }
    .bc-empty {
      padding: 40px 26px;
    }
  }
</style>
