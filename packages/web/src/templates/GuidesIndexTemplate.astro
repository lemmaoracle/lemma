---
/**
 * Guides index — v24 chrome.
 *
 * Cream page, 1100px container, Sora display + Noto Sans JP body + Space
 * Mono labels, saddle brown accent. Mirrors the pillars-hub v24 vocabulary:
 * white card grid for guides + cream-deep panel with horizontal cards for
 * foundations. May move to /cookbook/ later — the template is locale-only,
 * not slug-coupled, so renaming the route doesn't touch the chrome.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";

export interface GuidesIndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  guides: ReadonlyArray<BlogPost>;
  foundations: ReadonlyArray<BlogPost>;
}

const { locale, t, base, guides, foundations } = Astro.props as GuidesIndexTemplateProps;
const blogPath = base ? `${base}/blog` : "/blog";
const guidesPath = base ? `${base}/guides` : "/guides";
const title =
  locale === "ja" ? `${t.blog.index.guidesTitle} — Lemma` : `${t.blog.index.guidesTitle} — Lemma`;
const description = t.blog.index.guidesDesc;

const SITE = "https://lemma.frame00.com";
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t.blog.index.guidesTitle,
  description,
  url: `${SITE}${guidesPath}/`,
  inLanguage: locale,
  isPartOf: { "@id": `${SITE}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: guides.map((post, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: post.title,
      url: `${SITE}${blogPath}/${post.slug}/`,
    })),
  },
};
---

<Layout locale={locale} title={title} description={description} metaType="page" pagePath="/guides/">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionJsonLd)} />

  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="gd-page">
    <div class="gd-container">
      <section class="gd-hero">
        <div class="gd-eyebrow">{t.blog.index.guidesTag}</div>
        <h1 class="gd-h1">{t.blog.index.guidesTitle}</h1>
        <p class="gd-hero-sub">{t.blog.index.guidesDesc}</p>
      </section>

      {
        /*
        ヒーローとガイド一覧のあいだに差し込む任意の帯。JA は
        CoreCryptoSections（仕組み＋3つの中核）を入れる。渡さなければ何も
        描画しないので、EN の /guides/ は従来どおり。
      */
      }
      <slot name="feature" />

      {
        guides.length > 0 && (
          <section class="gd-grid-section" aria-label={t.blog.index.guidesTag}>
            <ul class="gd-grid">
              {guides.map((post) => (
                <li>
                  <a href={`${blogPath}/${post.slug}`} class="gd-card">
                    <div class="gd-card-meta">
                      <span class="gd-card-cat">{post.category}</span>
                      <span class="gd-card-date">{post.date}</span>
                    </div>
                    <h2 class="gd-card-title">{post.title}</h2>
                    <p class="gd-card-abstract">{post.abstract}</p>
                    <span class="gd-card-cta">{t.blog.index.readGuide}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        foundations.length > 0 && (
          <section class="gd-block" aria-label={t.blog.index.foundationsTag}>
            <div class="gd-block-eyebrow">{t.blog.index.foundationsTag}</div>
            <ul class="gd-foundations">
              {foundations.map((post) => (
                <li>
                  <a href={`${blogPath}/${post.slug}`} class="gd-foundations-card">
                    <div class="gd-foundations-text">
                      <h3 class="gd-foundations-title">{post.title}</h3>
                      <p class="gd-foundations-abstract">{post.abstract}</p>
                    </div>
                    <span class="gd-foundations-cta">{t.blog.index.readSpecs}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .gd-page {
    --gd-display: var(--font-display);
    --gd-body: "Noto Sans JP", system-ui, sans-serif;
    --gd-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --gd-text-1: #12140e;
    --gd-text-2: #2f332b;
    --gd-text-3: #5c6156;
    --gd-text-4: #9aa197;
    /* 新DS移行: アクセントをブラウン→オリーブ、地を lite 系へ (色のみ変更) */
    --accent: #4e7a00;
    --accent-lt: #6f9c00;
    --lemma-cream: #f3f4f1;
    --lemma-cream-deep: #eceee9;
    --lemma-line: #e1e3dd;

    background: var(--lemma-cream);
    color: var(--gd-text-2);
    font-family: var(--gd-body);
    font-weight: 400;
    line-height: 1.65;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .gd-page {
    --gd-body: "Noto Sans JP", system-ui, sans-serif;
  }

  .gd-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* ─── HERO ─── */
  .gd-hero {
    padding: 60px 0 56px;
  }
  .gd-eyebrow {
    font-family: var(--gd-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gd-text-3);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gd-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .gd-h1 {
    font-family: var(--gd-display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.03em;
    max-width: 920px;
  }
  :root[lang="ja"] .gd-h1 {
    line-height: 1.25;
  }
  .gd-hero-sub {
    font-size: 16px;
    color: var(--gd-text-2);
    margin: 0;
    line-height: 1.8;
    max-width: 720px;
  }

  /* ─── GUIDES GRID (3-up) ─── */
  .gd-grid-section {
    margin: 0 0 56px;
  }
  .gd-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .gd-grid > li {
    margin: 0;
  }
  .gd-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 26px 26px 22px;
    height: 100%;
    transition:
      border-color 0.25s,
      box-shadow 0.25s,
      transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .gd-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 40px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gd-card:hover {
    border-color: rgba(78, 122, 0, 0.4);
    box-shadow: 0 10px 28px rgba(139, 69, 19, 0.06);
    transform: translateY(-2px);
  }
  .gd-card:hover::before {
    width: 100%;
  }
  .gd-card-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--gd-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .gd-card-cat {
    color: var(--accent);
  }
  .gd-card-date {
    color: var(--gd-text-4);
  }
  .gd-card-title {
    font-family: var(--gd-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.005em;
    line-height: 1.4;
    margin: 4px 0 0;
  }
  .gd-card-abstract {
    font-size: 13px;
    line-height: 1.7;
    color: var(--gd-text-3);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gd-card-cta {
    font-family: var(--gd-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-top: auto;
    padding-top: 14px;
    border-top: 0.5px solid var(--lemma-line);
    transition: transform 0.2s;
  }
  .gd-card:hover .gd-card-cta {
    transform: translateX(3px);
  }

  /* ─── FOUNDATIONS BLOCK ─── */
  .gd-block {
    margin: 56px 0 0;
    padding: 40px 36px;
    background: var(--lemma-cream-deep);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }
  .gd-block::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 64px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .gd-block-eyebrow {
    font-family: var(--gd-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }
  .gd-foundations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .gd-foundations > li {
    margin: 0;
  }
  .gd-foundations-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 14px;
    padding: 28px 32px;
    position: relative;
    overflow: hidden;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  .gd-foundations-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 64px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gd-foundations-card:hover {
    border-color: rgba(78, 122, 0, 0.4);
    box-shadow: 0 10px 24px rgba(139, 69, 19, 0.05);
  }
  .gd-foundations-card:hover::before {
    width: 100%;
  }
  .gd-foundations-text {
    flex: 1;
    min-width: 260px;
  }
  .gd-foundations-title {
    font-family: var(--gd-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.3;
    margin: 0 0 6px;
  }
  .gd-foundations-abstract {
    font-size: 13.5px;
    color: var(--gd-text-3);
    line-height: 1.7;
    margin: 0;
    max-width: 540px;
  }
  .gd-foundations-cta {
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 12px 26px;
    background: #a8e010;
    color: #12140e;
    border-radius: 999px;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .gd-foundations-card:hover .gd-foundations-cta {
    background: #96c90e;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .gd-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .gd-container {
      padding: 0 24px;
    }
    .gd-hero {
      padding: 40px 0 36px;
    }
    .gd-grid {
      grid-template-columns: 1fr;
    }
    .gd-block {
      padding: 32px 22px;
    }
    .gd-foundations-card {
      padding: 24px 22px;
    }
  }
</style>
