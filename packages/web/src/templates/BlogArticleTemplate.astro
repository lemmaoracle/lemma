---
/**
 * Lemma blog — article detail page, v24-aligned.
 *
 * Migrated from the prior v22 dark-full-bleed-hero chrome to the v24
 * reading layout: cream page, container-narrow 760px reading column,
 * Sora display + Noto Sans JP body + Space Mono labels, saddle brown
 * accent on eyebrows / links / list markers / quote rules.
 *
 * Cover image is kept (blog content is image-heavy) but rendered as a
 * sized 16:9 frame above the meta strip, not as a full-bleed overlay
 * hero. Title and meta sit in the cream container that follows.
 *
 * Body styling, TOC, related-links, tags, CTA, prev/next, and related
 * posts are all reworked to v24. The body's rendered markdown HTML is
 * not touched — only the surrounding chrome and the .article-body CSS
 * are changed.
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { getTagDestination, isBlogCategory, categorySlug } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import NewsletterEmbed from "../components/NewsletterEmbed.astro";
import SchemaOrg from "@/components/SchemaOrg";
import defaultCover from "../assets/default-blog-cover.png";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface BlogArticleTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  post: BlogPost;
  navigation: {
    prev?: { slug: string; title: string; date: string; category: string };
    next?: { slug: string; title: string; date: string; category: string };
  };
  related: Array<{
    cover?: string;
    category: string;
    date: string;
    title: string;
    slug: string;
  }>;
  partnerCtaTitle: string;
  partnerCtaDesc: string;
  partnerCtaButton: string;
  relatedLabel: string;
  relatedLinksLabel: string;
  readingTimeLabel: string;
}

const {
  locale,
  t,
  base,
  blogPath,
  post,
  navigation,
  related,
  partnerCtaTitle,
  partnerCtaDesc,
  partnerCtaButton,
  relatedLabel,
  relatedLinksLabel,
  readingTimeLabel,
} = Astro.props as BlogArticleTemplateProps;

/**
 * サイトリニューアル先行のデザイン移行を、**この slug の記事だけ**で試す。
 * モック `lemma_article_mock_v6.html` の面（トークンは /ja/preview/top/ と同じ）。
 *
 * 記事テンプレート全体の移行はリニューアル本体で行う。そのときは
 * この配列と `.blog-page:not(.v2)` の旧スタイルを消せば、新しい面が全記事に
 * 出る——**移行は「ここを外すだけ」**で済むようにしてある。
 */
const DESIGN_V2_SLUGS: ReadonlyArray<string> = ["lemma-oracle-specs"];
const isV2 = DESIGN_V2_SLUGS.includes(post.slug);

const homeLabel = locale === "ja" ? "ホーム" : "Home";
const isJa = locale === "ja";
const builtForHeading = isJa
  ? "意思決定のために"
  : "Built for decisions";
const builtForHeadingItalic = isJa ? "つくられている。" : "that matter.";
---

<Layout
  locale={locale}
  title={`${post.title} — Lemma`}
  description={post.abstract}
  metaType="article"
  post={post}
  blogPath={blogPath}
  ogImage={`https://lemma.frame00.com/og/blog/${locale}/${post.slug}.png`}
>
  {post && <SchemaOrg post={post} blogPath={blogPath} />}
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class:list={["blog-page", isV2 && "v2"]}>
    <div class="blog-container">
      <div class="blog-breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="blog-breadcrumb-sep">/</span>
        <a href={blogPath}>Blog</a>
        <span class="blog-breadcrumb-sep">/</span>
        {isBlogCategory(post.category) ? (
          <a href={`${blogPath}/category/${categorySlug(post.category)}`}>
            {post.category}
          </a>
        ) : (
          <span>{post.category}</span>
        )}
      </div>

      <section class="blog-hero">
        {/* v2 はカテゴリがチップになり、日付・読了はモノスペースの間隔で
            分かれるので、区切りの「·」を置かない。 */}
        <div class="blog-eyebrow">
          <span class="eyebrow-cat">{post.category}</span>
          {!isV2 && <span class="eyebrow-sep">·</span>}
          <span class="eyebrow-date">{post.date}</span>
          {!isV2 && <span class="eyebrow-sep">·</span>}
          <span class="eyebrow-time">{readingTimeLabel}</span>
        </div>
        <h1 class="blog-h1">{post.title}</h1>
        {post.abstract && <p class="blog-abstract">{post.abstract}</p>}
      </section>

      <figure class="blog-cover">
        <img
          src={post.cover ?? defaultCover.src}
          alt=""
          loading="lazy"
        />
      </figure>

      <div class="blog-body" set:html={post.body} />

      {post.relatedLinks && post.relatedLinks.length > 0 && (
        <section class="blog-resources">
          <div class="resources-label">{relatedLinksLabel}</div>
          <ul class="resources-list">
            {post.relatedLinks.map((link) => (
              <li class="resources-item">
                <a
                  href={link.href}
                  class="resources-link"
                  rel="noopener"
                  target="_blank"
                >
                  <span class="resources-link-label">{link.label}</span>
                  <span class="resources-link-href">{link.href}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {post.tags && post.tags.length > 0 && (
        <nav class="blog-tags" aria-label="Related topics">
          {post.tags.map((tag) => {
            const href = getTagDestination(tag, base);
            return href ? (
              <a class="blog-tag blog-tag-link" href={href}>#{tag}</a>
            ) : (
              <span class="blog-tag">#{tag}</span>
            );
          })}
        </nav>
      )}

      <section class="blog-cta">
        <div class="cta-eyebrow">{partnerCtaTitle}</div>
        <h2 class="cta-h2">
          {builtForHeading}<br />
          <em>{builtForHeadingItalic}</em>
        </h2>
        <p class="cta-text">{partnerCtaDesc}</p>
        <div class="cta-btns">
          <button
            type="button"
            class="btn-cta-main"
            data-tally-open={isJa ? "xX0VYv" : "7RJXdR"}
            data-tally-emoji-text=""
          >
            {t.ctaSection.finalWpText}
          </button>
          <a
            href={DISCOVERY_CALL_URL[locale]}
            class="btn-cta-outline"
            target="_blank"
            rel="noopener"
          >
            {partnerCtaButton}
          </a>
        </div>
      </section>

      <NewsletterEmbed locale={locale} placement="blog-footer" />

      {(navigation.prev || navigation.next) && (
        <section class="blog-prevnext">
          {navigation.prev && (
            <a
              href={`${blogPath}/${navigation.prev.slug}`}
              class="prevnext-card prev"
            >
              <div class="prevnext-dir">← Previous</div>
              <div class="prevnext-title">{navigation.prev.title}</div>
              <div class="prevnext-date">
                {navigation.prev.date} · {navigation.prev.category}
              </div>
            </a>
          )}
          {navigation.next && (
            <a
              href={`${blogPath}/${navigation.next.slug}`}
              class="prevnext-card next"
            >
              <div class="prevnext-dir">Next →</div>
              <div class="prevnext-title">{navigation.next.title}</div>
              <div class="prevnext-date">
                {navigation.next.date} · {navigation.next.category}
              </div>
            </a>
          )}
        </section>
      )}

      {related.length > 0 && (
        <section class="blog-related">
          <div class="related-label">{relatedLabel}</div>
          <ul class="related-list">
            {related.map((r) => (
              <li>
                <a href={`${blogPath}/${r.slug}`} class="related-item">
                  <div
                    class="related-thumb"
                    style={`background-image:url('${r.cover ?? ""}')`}
                  ></div>
                  <div class="related-body">
                    <div class="related-cat">
                      {r.category} · {r.date}
                    </div>
                    <div class="related-title">{r.title}</div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* v24 typography palette — scoped to blog article pages. */
  .blog-page {
    --bl-display: "Sora", system-ui, -apple-system, sans-serif;
    --bl-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --bl-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --bl-text-1: #1a1a1a;
    --bl-text-2: #3a3a3a;
    --bl-text-3: #5a5a5a;
    --bl-text-4: #9a9a9a;

    background: var(--lemma-cream);
    color: var(--bl-text-2);
    font-family: var(--bl-body);
    font-weight: 400;
    line-height: 1.85;
    padding: 0 0 96px;
    margin-top: 64px;
  }
  :root[lang="en"] .blog-page {
    --bl-body: "Sora", system-ui, sans-serif;
  }

  .blog-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── BREADCRUMB ─── */
  .blog-breadcrumb {
    font-family: var(--bl-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bl-text-4);
    padding: 36px 0 0;
  }
  .blog-breadcrumb a {
    color: var(--bl-text-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .blog-breadcrumb a:hover {
    color: var(--accent);
  }
  .blog-breadcrumb-sep {
    color: var(--lemma-line);
    margin: 0 8px;
  }

  /* ─── HERO ─── */
  .blog-hero {
    padding: 32px 0 32px;
  }
  .blog-eyebrow {
    font-family: var(--bl-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bl-text-4);
    margin: 0 0 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .eyebrow-cat {
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.22em;
  }
  .eyebrow-sep {
    color: var(--lemma-line);
  }
  .blog-h1 {
    font-family: var(--bl-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1.06;
    margin: 0 0 22px;
    color: var(--black);
    letter-spacing: -0.03em;
  }
  :root[lang="ja"] .blog-h1 {
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .blog-abstract {
    font-family: var(--bl-display);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--bl-text-2);
    margin: 0;
    letter-spacing: -0.015em;
  }

  /* ─── COVER ─── */
  .blog-cover {
    margin: 24px 0 56px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--lemma-cream-deep);
    aspect-ratio: 16 / 9;
  }
  .blog-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── BODY (rendered markdown HTML) ─── */
  .blog-body {
    font-feature-settings: "palt" 1;
    max-width: 100%;
    overflow-wrap: break-word;
    font-size: 16px;
    line-height: 1.85;
    color: var(--bl-text-2);
  }
  .blog-body :global(h2[id]),
  .blog-body :global(h3[id]) {
    scroll-margin-top: 96px;
  }
  .blog-body :global(h2) {
    font-family: var(--bl-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--black);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 64px 0 24px;
  }
  :root[lang="ja"] .blog-body :global(h2) {
    line-height: 1.35;
  }
  .blog-body :global(h2:first-child) {
    margin-top: 0;
  }
  .blog-body :global(h3) {
    font-family: var(--bl-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--black);
    line-height: 1.35;
    margin: 40px 0 16px;
  }
  .blog-body :global(p) {
    font-family: var(--bl-body);
    font-size: 16px;
    line-height: 1.85;
    color: var(--bl-text-2);
    margin: 0 0 24px;
  }
  .blog-body :global(> p:first-of-type) {
    font-size: 17px;
    color: var(--bl-text-1);
  }
  .blog-body :global(strong) {
    color: var(--black);
    font-weight: 500;
  }
  .blog-body :global(em) {
    font-style: italic;
    color: var(--bl-text-2);
  }
  .blog-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid rgba(139, 69, 19, 0.4);
    transition: border-color 0.15s, color 0.15s;
    overflow-wrap: anywhere;
  }
  .blog-body :global(a:hover) {
    border-bottom-color: var(--accent);
    color: #6e3610;
  }

  /* Lists — brown diamond ul, mono brown ol */
  .blog-body :global(ul) {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }
  .blog-body :global(ul li) {
    position: relative;
    padding-left: 24px;
    margin: 0 0 10px;
    line-height: 1.75;
    font-size: 16px;
  }
  .blog-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 4px;
    top: 13px;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }
  .blog-body :global(ol) {
    list-style: none;
    margin: 0 0 24px;
    padding: 0 0 0 4px;
    counter-reset: bloglist;
  }
  .blog-body :global(ol li) {
    counter-increment: bloglist;
    position: relative;
    padding-left: 32px;
    margin: 0 0 12px;
    line-height: 1.75;
    font-size: 16px;
  }
  .blog-body :global(ol li::before) {
    content: counter(bloglist);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--bl-mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
  }

  /* Pull-quote (single italic paragraph) */
  .blog-body :global(p:has(> em:only-child)) {
    font-family: var(--bl-display);
    font-size: 20px;
    font-style: italic;
    line-height: 1.55;
    color: var(--bl-text-1);
    margin: 48px 0;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    overflow-wrap: anywhere;
  }
  .blog-body :global(p:has(> em:only-child) em) {
    font-style: italic;
    color: inherit;
  }
  .blog-body :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 24px;
    margin: 40px 0;
    font-style: italic;
    color: var(--bl-text-1);
  }
  .blog-body :global(blockquote p) {
    margin-bottom: 0;
  }
  .blog-body :global(hr) {
    border: none;
    border-top: 0.5px solid var(--lemma-line);
    margin: 48px 0;
  }

  /* Tables */
  .blog-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--bl-body);
    font-size: 14px;
    margin: 32px 0;
  }
  .blog-body :global(thead tr) {
    background: var(--lemma-cream-deep);
  }
  .blog-body :global(th) {
    padding: 12px 14px;
    font-family: var(--bl-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bl-text-3);
    text-align: left;
    border-bottom: 0.5px solid var(--lemma-line);
    white-space: nowrap;
  }
  .blog-body :global(td) {
    padding: 12px 14px;
    border-bottom: 0.5px solid var(--lemma-line);
    color: var(--bl-text-2);
    line-height: 1.65;
    vertical-align: top;
  }

  /* Code */
  .blog-body :global(code:not(pre code)) {
    font-family: var(--bl-mono);
    font-size: 0.86em;
    background: var(--lemma-cream-deep);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    color: var(--bl-text-1);
  }
  .blog-body :global(pre) {
    margin: 28px 0;
    padding: 22px 24px;
    background: #1a1a1a;
    color: #e8e2d4;
    border-radius: 12px;
    overflow-x: auto;
    font-family: var(--bl-mono);
    font-size: 12.5px;
    line-height: 1.75;
  }
  .blog-body :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  /* Inline images */
  .blog-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 32px 0;
  }

  /* ─── RESOURCES (related links) ─── */
  .blog-resources {
    margin: 64px 0 0;
    padding: 32px 0 0;
    border-top: 0.5px solid var(--lemma-line);
  }
  .resources-label {
    font-family: var(--bl-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bl-text-3);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .resources-label::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--accent);
    display: inline-block;
  }
  .resources-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .resources-item {
    padding: 0;
  }
  .resources-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: var(--white);
    border: 0.5px solid var(--lemma-line);
    border-radius: 10px;
    margin: 0 0 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  .resources-link:hover {
    border-color: rgba(139, 69, 19, 0.4);
    background: var(--lemma-cream-deep);
  }
  .resources-link-label {
    font-family: var(--bl-display);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--black);
    letter-spacing: -0.005em;
  }
  .resources-link-href {
    font-family: var(--bl-mono);
    font-size: 11px;
    color: var(--accent);
    word-break: break-all;
  }

  /* ─── TAGS ─── */
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 56px 0 0;
    padding-top: 28px;
    border-top: 0.5px solid var(--lemma-line);
  }
  .blog-tag {
    font-family: var(--bl-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--bl-text-3);
    background: var(--lemma-cream-deep);
    padding: 5px 10px;
    border-radius: 999px;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .blog-tag-link:hover {
    color: var(--accent);
    background: var(--lemma-brown-light);
  }

  /* ─── CTA (cream-deep card, no longer black hero) ─── */
  .blog-cta {
    margin: 80px 0 0;
    background: var(--lemma-cream-deep);
    border-radius: 16px;
    padding: 48px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .blog-cta::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 0;
  }
  .cta-eyebrow {
    font-family: var(--bl-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }
  .cta-h2 {
    font-family: var(--bl-display);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    color: var(--black);
    line-height: 1.1;
    margin: 0 0 18px;
    letter-spacing: -0.025em;
  }
  .cta-h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .cta-text {
    font-family: var(--bl-body);
    font-size: 14px;
    color: var(--bl-text-2);
    line-height: 1.75;
    max-width: 460px;
    margin: 0 auto 32px;
  }
  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-cta-main {
    background: var(--accent);
    color: var(--lemma-cream);
    padding: 14px 32px;
    font-family: var(--bl-display);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .btn-cta-main:hover {
    background: #6e3610;
  }
  .btn-cta-outline {
    background: var(--white);
    color: var(--accent);
    padding: 14px 30px;
    font-family: var(--bl-display);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    border: 0.5px solid var(--lemma-line);
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-cta-outline:hover {
    border-color: var(--accent);
    background: var(--lemma-brown-light);
  }

  /* ─── PREV / NEXT ─── */
  .blog-prevnext {
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .prevnext-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
