---
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { getTagDestination, isBlogCategory, categorySlug } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import SchemaOrg from "@/components/SchemaOrg";
import defaultCover from "../assets/default-blog-cover.png";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface BlogArticleTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  post: BlogPost;
  navigation: {
    prev?: { slug: string; title: string; date: string; category: string };
    next?: { slug: string; title: string; date: string; category: string };
  };
  related: Array<{
    cover?: string;
    category: string;
    date: string;
    title: string;
    slug: string;
  }>;
  partnerCtaTitle: string;
  partnerCtaDesc: string;
  partnerCtaButton: string;
  relatedLabel: string;
  relatedLinksLabel: string;
  tocLabel: string;
  readingTimeLabel: string;
}

const { locale, t, base, blogPath, post, navigation, related, partnerCtaTitle, partnerCtaDesc, partnerCtaButton, relatedLabel, relatedLinksLabel, tocLabel, readingTimeLabel } = Astro.props as BlogArticleTemplateProps;
---

<Layout
  locale={locale}
  title={`${post.title} — Lemma Oracle`}
  description={post.abstract}
  metaType="article"
  post={post}
  blogPath={blogPath}
>
  {post && <SchemaOrg post={post} blogPath={blogPath} />}
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <section class="article-hero">
    <img src={post.cover ?? defaultCover.src} alt="" />
    <div class="article-hero-overlay"></div>
    <div class="article-hero-meta">
      <div class="eyebrow">
        {post.category}
        <span class="eyebrow-date">{post.date}</span>
        <span class="eyebrow-reading-time">{readingTimeLabel}</span>
      </div>
      <h1 class="article-hero-title">{post.title}</h1>
    </div>
  </section>

  <div class="prose-wrap">
    <div class="breadcrumb">
      <a href={blogPath}>Blog</a>
      <span class="breadcrumb-sep">/</span>
      {isBlogCategory(post.category) ? (
        <a href={`${blogPath}/category/${categorySlug(post.category)}`}>{post.category}</a>
      ) : (
        <a href={blogPath}>{post.category}</a>
      )}
    </div>

    {post.headings.length > 1 && (
      <nav class="article-toc" aria-label={tocLabel}>
        <div class="toc-label">{tocLabel}</div>
        <ol class="toc-list">
          {post.headings.map((h) => (
            <li class={`toc-item toc-level-${h.level}`}>
              <a href={`#${h.id}`}>
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body" set:html={post.body} />

    {post.relatedLinks && post.relatedLinks.length > 0 && (
      <div class="resources-section">
        <div class="resources-label">{relatedLinksLabel}</div>
        <ul class="resources-list">
          {post.relatedLinks.map((link) => (
            <li class="resources-item">
              <a href={link.href} class="resources-link" rel="noopener" target="_blank">
                <span class="resources-link-label">{link.label}</span>
                <span class="resources-link-href">{link.href}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {post.tags && post.tags.length > 0 && (
      <nav class="tag-strip" aria-label="Related topics">
        {post.tags.map((tag) => {
          const href = getTagDestination(tag, base);
          return href ? (
            <a class="tag-chip tag-chip-link" href={href}>#{tag}</a>
          ) : (
            <span class="tag-chip">#{tag}</span>
          );
        })}
      </nav>
    )}

    <div class="article-cta">
      <div class="article-cta-eyebrow">{partnerCtaTitle}</div>
      <h2>Built for decisions<br><em>that matter.</em></h2>
      <div class="article-cta-rule"></div>
      <p>{partnerCtaDesc}</p>
      <div class="article-cta-btns">
        <a
          href={locale === "ja" ? "https://tally.so/r/xX0VYv" : "https://tally.so/r/7RJXdR"}
          class="btn-cta-main"
          target="_blank"
          rel="noopener"
        >{t.ctaSection.finalWpText}</a>
        <a href={DISCOVERY_CALL_URL[locale]} class="btn-cta-outline" target="_blank" rel="noopener">{partnerCtaButton}</a>
      </div>
    </div>
  </div>

  <div class="prevnext">
    {navigation.prev && (
      <a href={`${blogPath}/${navigation.prev.slug}`} class="prevnext-item">
        <div class="prevnext-dir">← Previous</div>
        <div class="prevnext-title">{navigation.prev.title}</div>
        <div class="prevnext-date">{navigation.prev.date} · {navigation.prev.category}</div>
      </a>
    )}
    {navigation.next && (
      <a href={`${blogPath}/${navigation.next.slug}`} class="prevnext-item">
        <div class="prevnext-dir right">Next →</div>
        <div class="prevnext-title right">{navigation.next.title}</div>
        <div class="prevnext-date right">{navigation.next.date} · {navigation.next.category}</div>
      </a>
    )}
  </div>

  {related.length > 0 && (
    <div class="related-section">
      <div class="related-label">{relatedLabel}</div>
      <div class="related-list">
        {related.map((r) => (
          <a href={`${blogPath}/${r.slug}`} class="related-item">
            <div class="related-thumb" style={`background-image:url('${r.cover ?? ""}')`}></div>
            <div class="related-body">
              <div class="related-cat">{r.category} · {r.date}</div>
              <div class="related-title">{r.title}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .article-hero { margin-top: 64px; position: relative; height: 56vh; min-height: 400px; overflow: hidden; }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.5) brightness(.8); }
  .article-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg,rgba(0,0,0,.1) 0%,rgba(0,0,0,.72) 100%); }
  .article-hero-meta { position: absolute; bottom: 0; left: 0; right: 0; padding: 0 max(5%, calc(50% - 420px)) 52px; }
  .eyebrow { font-size: 10px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: #8B4513; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
  .eyebrow::before { content: ''; width: 20px; height: 1px; background: #8B4513; display: block; }
  .eyebrow-date { font-size: 11px; color: rgba(255,255,255,.4); margin-left: 12px; }
  .eyebrow-reading-time { font-size: 11px; color: rgba(255,255,255,.4); letter-spacing: .12em; text-transform: none; padding-left: 12px; border-left: 1px solid rgba(255,255,255,.18); }
  .article-hero-title { font-family: var(--font-display); font-size: clamp(30px,4.5vw,54px); font-weight: 500; color: #fff; line-height: 1.1; max-width: 720px; }

  .prose-wrap { max-width: 920px; margin: 0 auto; padding: 64px 24px 0; }

  .breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; font-size: 11px; color: var(--gray-500); flex-wrap: wrap; }
  .breadcrumb a { color: var(--gray-500); transition: color .2s; text-decoration: none; }
  .breadcrumb a:hover { color: #000; }
  .breadcrumb-sep { color: var(--gray-200); }

  .tag-strip { display: flex; flex-wrap: wrap; gap: 8px 14px; margin: 56px 0 0; padding-top: 28px; border-top: 1px solid var(--gray-200); }
  .tag-chip { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; color: var(--gray-500); letter-spacing: .02em; text-decoration: none; transition: color .2s; }
  .tag-chip-link:hover { color: var(--accent, #8B4513); }

  .article-toc { margin: 0 0 56px; padding: 24px 28px; border: 1px solid var(--gray-200); border-radius: 2px; background: #fafafa; }
  .toc-label { font-size: 10px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: var(--gray-500); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
  .toc-label::before { content: ''; width: 18px; height: 1px; background: var(--gray-200); display: block; }
  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-item { padding: 0; }
  .toc-item a { display: flex; align-items: baseline; gap: 14px; padding: 7px 0; color: var(--gray-700, #444); text-decoration: none; transition: color .2s; line-height: 1.45; }
  .toc-item a:hover { color: #000; }
  .toc-item.toc-level-3 { padding-left: 0; }
  .toc-text { font-size: 14px; }
  .article-body :global(h2[id]), .article-body :global(h3[id]) { scroll-margin-top: 96px; }
  @media (max-width: 640px) {
    .article-toc { padding: 18px 20px; margin-bottom: 40px; }
    .toc-text { font-size: 13px; }
  }

  .article-body { font-feature-settings: "palt" 1; max-width: 100%; overflow-wrap: break-word; }
  .article-body :global(h2) { font-family: var(--font-display); font-size: clamp(28px,3.4vw,36px); font-weight: 500; color: #000; line-height: 1.25; margin: 96px 0 28px; }
  .article-body :global(h2:first-child) { margin-top: 0; }
  .article-body :global(h3) { font-family: var(--font-display); font-size: 20px; font-weight: 600; color: #000; margin: 48px 0 16px; line-height: 1.35; }
  .article-body :global(> p:first-of-type) { font-size: 18px; line-height: 1.7; color: #2a2a2a; margin-bottom: 32px; }
  .article-body :global(p) { font-family: var(--font-body); font-size: 17px; font-weight: 400; line-height: 1.85; color: var(--gray-800); margin-bottom: 32px; }
  .article-body :global(ul) { list-style: none; margin: 0 0 32px; padding: 0; }
  .article-body :global(ul li) { font-family: var(--font-body); font-size: 17px; font-weight: 400; line-height: 1.8; color: var(--gray-800); padding: 6px 0 6px 24px; position: relative; }
  .article-body :global(ul li::before) { content: '◆'; position: absolute; left: 0; color: var(--accent); font-size: 8px; top: 13px; }
  .article-body :global(ol) { list-style: none; margin: 0 0 32px; padding: 0; counter-reset: item; }
  .article-body :global(ol li) { font-family: var(--font-body); font-size: 17px; font-weight: 400; line-height: 1.8; color: var(--gray-800); padding: 6px 0 6px 36px; position: relative; counter-increment: item; }
  .article-body :global(ol li::before) { content: counter(item) "."; position: absolute; left: 0; top: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; font-weight: 500; letter-spacing: .04em; color: var(--accent); }
  .article-body :global(a) { color: var(--accent); border-bottom: 1px solid rgba(139,69,19,.28); text-decoration: none; transition: border-color .2s, color .2s; }
  .article-body :global(a:hover) { border-bottom-color: var(--accent); color: #6e3610; }
  .article-body :global(strong) { font-weight: 600; color: #000; }
  .article-body :global(em) { font-style: italic; color: #444; }
  .article-body :global(p:has(> em:only-child)) {
    font-size: 19px;
    line-height: 1.55;
    color: #2a2a2a;
    margin: 56px 0;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    overflow-wrap: anywhere;
  }
  .article-body :global(p:has(> em:only-child) em) { font-style: italic; color: inherit; }
  .article-body :global(blockquote) { border-left: 2px solid var(--accent); padding: 4px 0 4px 24px; margin: 48px 0; font-style: italic; color: #444; }
  .article-body :global(blockquote p) { margin-bottom: 0; }
  .article-body :global(hr) { border: none; border-top: 1px solid var(--gray-200); margin: 56px 0; }
  .article-body :global(table) { display: block; width: 100%; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; border-collapse: collapse; font-size: 15px; margin: 40px 0; }
  .article-body :global(table thead), .article-body :global(table tbody) { display: table; width: 100%; min-width: 560px; }
  .article-body :global(thead tr) { background: #000; color: #fff; }
  .article-body :global(th) { padding: 14px 18px; font-size: 10px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; text-align: left; white-space: nowrap; }
  .article-body :global(td) { padding: 14px 18px; border-bottom: 1px solid var(--gray-200); color: var(--gray-800); line-height: 1.65; vertical-align: top; }
  .article-body :global(tr:nth-child(odd) td) { background: var(--gray-50); }
  .article-body :global(pre) { margin: 32px 0; padding: 24px; background: #1a1a1a; border-radius: 4px; overflow-x: auto; }
  /* Inline `<code>` chip. Scoped with :not(pre code) so the
     light-grey chip styling doesn't leak into Shiki-highlighted
     code blocks, where it produced a per-line white box against
     the dark pre background. */
  .article-body :global(code:not(pre code)) { font-family: var(--default-mono-font-family, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace); font-size: 0.8em; border-radius: 0.3em; padding: 0.1em 0.3em; background-color: #f5f5f5; }
  .article-body :global(pre code) { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 14px; line-height: 1.7; color: #e1e4e8; background: transparent; padding: 0; border-radius: 0; }

  .resources-section { margin: 64px 0 0; padding-top: 32px; border-top: 1px solid var(--gray-200); }
  .resources-label { font-size: 10px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: var(--gray-500); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
  .resources-label::before { content: ''; width: 18px; height: 1px; background: var(--gray-200); display: block; }
  .resources-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .resources-item { padding: 0; }
  .resources-link { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; border-bottom: 1px solid var(--gray-200); text-decoration: none; color: inherit; transition: opacity .2s; }
  .resources-list .resources-item:first-child .resources-link { border-top: 1px solid var(--gray-200); }
  .resources-link:hover { opacity: .65; }
  .resources-link-label { font-family: var(--font-body); font-size: 16px; font-weight: 400; color: #000; }
  .resources-link-href { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; color: var(--gray-500); word-break: break-all; }

  .article-cta { margin: 80px -24px 0; background: #000; padding: 64px 48px; text-align: center; border-top: 3px solid #8B4513; }
  .article-cta-eyebrow { font-size: 10px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase; color: #8B4513; margin-bottom: 20px; }
  .article-cta h2 { font-family: var(--font-display); font-size: clamp(28px,4vw,44px); font-weight: 300; color: #fff; line-height: 1.1; margin-bottom: 16px; }
  .article-cta h2 em { font-style: italic; }
  .article-cta-rule { width: 40px; height: 1px; background: #8B4513; margin: 24px auto; }
  .article-cta p { font-size: 15px; color: rgba(255,255,255,.45); line-height: 1.75; max-width: 400px; margin: 0 auto 40px; }
  .article-cta-btns {
    display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
  }
  .btn-cta-main {
    background: #fff; color: #000; padding: 18px 52px; font-size: 12px; font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase; border: none; cursor: pointer; display: inline-block;
    text-decoration: none;
    transition: background .2s, color .2s;
  }
  .btn-cta-main:hover { background: #8B4513; color: #fff; }
  .btn-cta-outline {
    background: transparent; color: rgba(255,255,255,0.65); padding: 17px 44px;
    font-size: 12px; font-weight: 400; letter-spacing: .16em; text-transform: uppercase;
    border: 1px solid rgba(255,255,255,0.28); cursor: pointer; display: inline-block;
    text-decoration: none;
    transition: border-color .2s, color .2s;
  }
  .btn-cta-outline:hover { border-color: rgba(255,255,255,0.6); color: #fff; }
  @media (max-width: 640px) {
    .article-cta-btns { flex-direction: column; align-items: center; }
  }

  .prevnext { max-width: 680px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--gray-200); margin-top: 2px; }
  .prevnext-item { background: #fff; padding: 28px 32px; border-top: 2px solid transparent; transition: border-color .2s; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: inherit; }
  .prevnext-item:hover { border-top-color: #8B4513; }
  .prevnext-dir { font-size: 10px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: #8B4513; }
  .prevnext-dir.right { text-align: right; }
  .prevnext-title { font-family: var(--font-display); font-size: 16px; font-weight: 400; color: #000; line-height: 1.35; }
  .prevnext-title.right { text-align: right; }
  .prevnext-date { font-size: 11px; color: var(--gray-500); }
  .prevnext-date.right { text-align: right; }

  .related-section { max-width: 680px; margin: 72px auto 0; padding: 0 24px; }
  .related-label { font-size: 10px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: var(--gray-500); margin-bottom: 28px; display: flex; align-items: center; gap: 10px; }
  .related-label::before { content: ''; width: 18px; height: 1px; background: var(--gray-200); display: block; }
  .related-list { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--gray-200); }
  .related-item { display: flex; align-items: flex-start; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--gray-200); transition: opacity .2s; text-decoration: none; color: inherit; }
  .related-item:hover { opacity: .75; }
  .related-thumb { width: 100px; height: 64px; flex-shrink: 0; background-size: cover; background-position: center; filter: saturate(.4) brightness(.88); }
  .related-body { flex: 1; display: flex; flex-direction: column; gap: 5px; }
  .related-cat { font-size: 10px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: #8B4513; }
  .related-title { font-family: var(--font-display); font-size: 17px; font-weight: 400; color: #000; line-height: 1.3; }

  @media(max-width:768px) {
    .prose-wrap { padding: 32px 20px 0; }
    .breadcrumb { margin-bottom: 16px; }
    .tag-strip { margin-top: 40px; padding-top: 20px; }
    .article-cta { margin: 64px -20px 0; padding: 48px 28px; }
    .prevnext { margin-left: 0; margin-right: 0; grid-template-columns: 1fr; }
    .related-section { padding: 0 20px; }
  }
</style>
