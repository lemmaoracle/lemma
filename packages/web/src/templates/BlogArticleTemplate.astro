---
/**
 * Lemma blog — 記事詳細ページ。モック `lemma_article_mock_v10.html` の面。
 *
 * #713 で slug 1本（`lemma-oracle-specs`）だけに入れていた面を、**全記事へ
 * 展開した**もの。あのときの `DESIGN_V2_SLUGS` と `.blog-page:not(.v2)` の
 * 旧スタイル（v24 のクリーム地・Sora・saddle brown）はここで消えている。
 *
 * トークンの値は /ja/preview/top/（PreviewTopTemplate の .pv）と同じ。
 * フォントは **Layout が実際に読み込むもの**だけを指す（モックの
 * Space Grotesk は読み込んでいない＝指定しても入っている端末でしか出ない）。
 *
 * v6 から v10 で変わったのは本文の組みで、他8記事の実測を反映したもの:
 * h4 を追加／h2 の上罫を細いライムの線に変える／h2 直前の `hr` を消す
 * （`---` のあとに `##` が来る書き方で線が二重になる）／表を主要素として
 * 整備（見出しをモノスペースの小さいラベルから本文フォントへ）／入れ子の
 * リスト・図（figure/figcaption）を追加。
 *
 * 本文の HTML（`post.body`）は触っていない。**モックにあるメガメニューと
 * 新フッターはサイト共通のガラなので、ここでは入れない**（リニューアル本体
 * の範囲。#713 と同じ線引き）。
 */
import type { Locale, Translations } from "../i18n/translations";
import type { BlogPost } from "../data/blog";
import { getTagDestination, isBlogCategory, categorySlug } from "../data/blog";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import NewsletterEmbed from "../components/NewsletterEmbed.astro";
import SchemaOrg from "@/components/SchemaOrg";
import BlogCover from "../components/BlogCover.astro";
import { resolveCoverImage } from "../lib/coverPhoto";
import { DISCOVERY_CALL_URL } from "../config/cta";

export interface BlogArticleTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  blogPath: string;
  post: BlogPost;
  navigation: {
    prev?: { slug: string; title: string; date: string; category: string };
    next?: { slug: string; title: string; date: string; category: string };
  };
  related: Array<{
    cover?: string;
    category: string;
    date: string;
    title: string;
    slug: string;
  }>;
  partnerCtaTitle: string;
  partnerCtaDesc: string;
  partnerCtaButton: string;
  relatedLabel: string;
  relatedLinksLabel: string;
  readingTimeLabel: string;
}

const {
  locale,
  t,
  base,
  blogPath,
  post,
  navigation,
  related,
  partnerCtaTitle,
  partnerCtaDesc,
  partnerCtaButton,
  relatedLabel,
  relatedLinksLabel,
  readingTimeLabel,
} = Astro.props as BlogArticleTemplateProps;

const homeLabel = locale === "ja" ? "ホーム" : "Home";
const isJa = locale === "ja";

/* 写真カバー（§C-2）: coverPhoto が指定され public/ に実在するときだけ。
   無ければ従来どおり category+slug の抽象パターンに落ちる。 */
const coverPhotoSrc = resolveCoverImage(post);

/* 証拠ブロック（§B）の文言。数字の説明責任は検証センター1枚に集約する
   ため、`GET /v1/counters` は呼ばない（§B-6）。EN は ¥ を出さない（§B-5）。 */
const evidence = isJa
  ? {
      eyebrow: "確かめる",
      facts: [
        { v: "¥0", em: false, d: "検証は無料。API キーも要りません。何度でも実行できます。" },
        { v: "$0.005", em: false, d: "発行は一度だけ、約0.8円。以降の検証に課金はありません。" },
        { v: "ハッシュだけ", em: true, d: "Lemma が受け取るのはハッシュです。原本は手元から出ません。" },
      ],
      go: "発行と検証の実数を、検証センターで見る →",
    }
  : {
      eyebrow: "Verify",
      facts: [
        { v: "Free", em: false, d: "Verification is free. No API key required. Run it as many times as you like." },
        { v: "$0.005", em: false, d: "Issuing costs $0.005, once. Verifying afterwards is never charged." },
        { v: "Hash only", em: true, d: "Lemma receives only a hash. The original never leaves your side." },
      ],
      go: "See real issuance and verification numbers in the Verify Center →",
    };
const builtForHeading = isJa
  ? "意思決定のために"
  : "Built for decisions";
const builtForHeadingItalic = isJa ? "つくられている。" : "that matter.";
---

<Layout
  locale={locale}
  title={`${post.title} — Lemma`}
  description={post.abstract}
  metaType="article"
  post={post}
  blogPath={blogPath}
  ogImage={`https://lemma.frame00.com/og/blog/${locale}/${post.slug}.png`}
>
  {post && <SchemaOrg post={post} blogPath={blogPath} />}
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="blog-page">
    <div class="blog-container">
      <div class="blog-breadcrumb">
        <a href={base || "/"}>{homeLabel}</a>
        <span class="blog-breadcrumb-sep">/</span>
        <a href={blogPath}>Blog</a>
        <span class="blog-breadcrumb-sep">/</span>
        {isBlogCategory(post.category) ? (
          <a href={`${blogPath}/category/${categorySlug(post.category)}`}>
            {post.category}
          </a>
        ) : (
          <span>{post.category}</span>
        )}
      </div>

      <section class="blog-hero">
        {/* カテゴリはチップ、日付・読了はモノスペースの間隔で分かれるので、
            区切りの「·」は置かない。 */}
        <div class="blog-eyebrow">
          <span class="eyebrow-cat">{post.category}</span>
          <span class="eyebrow-date">{post.date}</span>
          <span class="eyebrow-time">{readingTimeLabel}</span>
        </div>
        <h1 class="blog-h1">{post.title}</h1>
        {post.abstract && <p class="blog-abstract">{post.abstract}</p>}
      </section>

      {/* カバー。coverPhoto が public/ に実在すれば写真（色調・ヴェール・
          走査線は CSS 加工 — §C-3、JPEG に焼き込まない）、無ければ従来の
          カテゴリ+slug 抽象パターン。索引・関連カード・OGP は写真対応まで
          抽象のまま（§C-4 は写真到着後に確定）。 */}
      {coverPhotoSrc ? (
        <figure class="blog-cover cover--photo">
          <img src={coverPhotoSrc} alt="" loading="eager" />
        </figure>
      ) : (
        <figure class="blog-cover">
          <BlogCover category={post.category} slug={post.slug} />
        </figure>
      )}

      <div class="blog-body" set:html={post.body} />

      {post.relatedLinks && post.relatedLinks.length > 0 && (
        <section class="blog-resources">
          <div class="resources-label">{relatedLinksLabel}</div>
          <ul class="resources-list">
            {post.relatedLinks.map((link) => (
              <li class="resources-item">
                <a
                  href={link.href}
                  class="resources-link"
                  rel="noopener"
                  target="_blank"
                >
                  <span class="resources-link-label">{link.label}</span>
                  <span class="resources-link-href">{link.href}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 証拠ブロック（§B・バリアントA 計器帯）。面を持たせない・ボタンを
          置かない — アクションは末尾のスレートCTAの専任で、ここは事実を
          置いて検証センターへ上がる踏み台に徹する（§B-4）。ブログ記事
          テンプレート限定で、Critical Brief には入れない（§B-1）。 */}
      <section class="evidence">
        <div class="evidence__eyebrow">{evidence.eyebrow}</div>
        <div class="evidence__facts">
          {evidence.facts.map((f) => (
            <div class="evidence__f">
              <div class="evidence__v">{f.em ? <em>{f.v}</em> : f.v}</div>
              <div class="evidence__d">{f.d}</div>
            </div>
          ))}
        </div>
        <div class="evidence__go">
          <a href={`${base}/verify/`}>{evidence.go}</a>
        </div>
      </section>

      {post.tags && post.tags.length > 0 && (
        <nav class="blog-tags" aria-label="Related topics">
          {post.tags.map((tag) => {
            const href = getTagDestination(tag, base);
            return href ? (
              <a class="blog-tag blog-tag-link" href={href}>#{tag}</a>
            ) : (
              <span class="blog-tag">#{tag}</span>
            );
          })}
        </nav>
      )}

      {(navigation.prev || navigation.next) && (
        <section class="blog-prevnext">
          {navigation.prev && (
            <a
              href={`${blogPath}/${navigation.prev.slug}`}
              class="prevnext-card prev"
            >
              <div class="prevnext-dir">← Previous</div>
              <div class="prevnext-title">{navigation.prev.title}</div>
              <div class="prevnext-date">
                {navigation.prev.date} · {navigation.prev.category}
              </div>
            </a>
          )}
          {navigation.next && (
            <a
              href={`${blogPath}/${navigation.next.slug}`}
              class="prevnext-card next"
            >
              <div class="prevnext-dir">Next →</div>
              <div class="prevnext-title">{navigation.next.title}</div>
              <div class="prevnext-date">
                {navigation.next.date} · {navigation.next.category}
              </div>
            </a>
          )}
        </section>
      )}

      {related.length > 0 && (
        <section class="blog-related">
          <div class="related-label">{relatedLabel}</div>
          <ul class="related-list">
            {related.map((r) => (
              <li>
                <a href={`${blogPath}/${r.slug}`} class="related-item">
                  <div class="related-thumb">
                    <BlogCover category={r.category} slug={r.slug} />
                  </div>
                  <div class="related-body">
                    <div class="related-cat">
                      {r.category} · {r.date}
                    </div>
                    <div class="related-title">{r.title}</div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <NewsletterEmbed locale={locale} placement="blog-footer" />

      {/* CTA は本文のいちばん外側＝フッターの直前（指示書 §2.1 の 9 番）。
          v10 までは タグ → CTA → 前後記事 の順で、記事の続きが CTA の
          あとに来ていた。 */}
      <section class="blog-cta">
        <div class="cta-eyebrow">{partnerCtaTitle}</div>
        <h2 class="cta-h2">
          {builtForHeading}<br />
          <em>{builtForHeadingItalic}</em>
        </h2>
        <p class="cta-text">{partnerCtaDesc}</p>
        <div class="cta-btns">
          <button
            type="button"
            class="btn-cta-main"
            data-tally-open={isJa ? "xX0VYv" : "7RJXdR"}
            data-tally-emoji-text=""
          >
            {t.ctaSection.finalWpText}
          </button>
          <a
            href={DISCOVERY_CALL_URL[locale]}
            class="btn-cta-outline"
            target="_blank"
            rel="noopener"
          >
            {partnerCtaButton}
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* ─────────────────────────────────────────────────────────────
     モック `lemma_article_mock_v10.html` の面。トークンの値は
     /ja/preview/top/（PreviewTopTemplate の .pv）と同じものを使う——
     リニューアル後に2種類の緑・2種類の紙色が並ばないようにするため。
     ────────────────────────────────────────────────────────── */
  .blog-page {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ok-light: #4e7a00;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.09), 0 2px 6px rgba(14, 18, 16, 0.05);
    /* Latin は Space Grotesk、和文はその後ろの Noto に落ちる。数字は Inter、
       ラベルは Space Mono（指示書 §2.3。Cormorant Garamond は使わない）。 */
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-num: "Inter", "Noto Sans JP", sans-serif;
    --font-mono: "Space Mono", monospace;

    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    /* 下の余白は新フッターの `margin-top:80px` が持つ（モックと同じ）。 */
    padding: 0;
    padding-top: 64px; /* sticky ナビ時代の margin-top:64px を padding に変換 — body 背景色の帯を出さない（H1 上の空白修正） */
  }
  .blog-container {
    max-width: calc(760px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
  }

  /* ─── BREADCRUMB ─── */
  .blog-breadcrumb {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    align-items: center;
    padding: 34px 0 0;
    font-size: 12px;
    color: var(--muted);
  }
  .blog-breadcrumb a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .blog-breadcrumb a:hover {
    color: var(--tx);
    border-color: var(--line);
  }
  .blog-breadcrumb-sep {
    opacity: 0.5;
    color: var(--muted);
  }

  /* ─── HERO ─── */
  .blog-hero {
    padding: 26px 0 0;
  }
  .blog-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 20px;
  }
  .eyebrow-cat {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ok-ink);
    border: 1px solid rgba(124, 175, 0, 0.45);
    background: rgba(168, 224, 16, 0.09);
    border-radius: 5px;
    padding: 4px 9px;
  }
  .eyebrow-date,
  .eyebrow-time {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .blog-h1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(27px, 3.6vw, 40px);
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 0 0 22px;
    word-break: keep-all;
  }
  .blog-abstract {
    font-size: 15.5px;
    line-height: 2;
    color: var(--tx-soft);
    margin: 0 0 26px;
    padding-left: 20px;
    border-left: 2px solid var(--ok);
  }

  /* ─── COVER ─── */
  .blog-cover {
    margin: 30px 0 0;
  }
  /* 濃い面には枠線を付けず、輪郭は影で出す（指示書 §6-4）。 */
  .blog-cover :global(svg) {
    width: 100%;
    aspect-ratio: 1200 / 630;
    display: block;
    border-radius: 14px;
    box-shadow: 0 18px 44px rgba(24, 36, 26, 0.13);
  }
  /* 写真カバー（刷新指示 §C-3）。画像は無加工で入稿され、色調・暗い
     ヴェール・ライムの走査線はすべてここで掛ける（JPEG に焼き込まない）。
     走査線の位置・太さは実写1枚が届いた時点で確定するため CSS 変数
     （暫定 62% / 2px）。枠は抽象カバーと同じ角丸+影で揃える。 */
  .cover--photo {
    --cover-scan-top: 62%;
    --cover-scan-height: 2px;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(24, 36, 26, 0.13);
  }
  .cover--photo img {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    display: block;
    filter: sepia(0.16) saturate(0.62) hue-rotate(-8deg) contrast(1.04);
  }
  /* 暗いヴェール — ユースケース索引サムネ（usecases-v14 の .ux-thv）と同一。
     業界ページの写真より鮮やかに見える、という作者フィードバックで統一。 */
  .cover--photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      200deg,
      rgba(16, 22, 17, 0.06) 0%,
      rgba(16, 22, 17, 0.3) 62%,
      rgba(16, 22, 17, 0.52) 100%
    );
    pointer-events: none;
  }
  /* ライムの走査線 — 抽象カバーと同じ「検証済み」の記号 */
  .cover--photo::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: var(--cover-scan-top);
    height: var(--cover-scan-height);
    background: var(--ok);
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
  }

  /* ─── BODY (rendered markdown HTML) ─── */
  .blog-body {
    padding: 14px 0 0;
    font-size: 16px;
    line-height: 2.05;
    color: var(--tx-soft);
    font-feature-settings: "palt" 1;
    overflow-wrap: break-word;
  }
  .blog-body :global(> *) {
    max-width: 100%;
  }
  .blog-body :global(h2[id]),
  .blog-body :global(h3[id]) {
    scroll-margin-top: 96px;
  }
  /* h2 の上の線は罫ではなく、見出しの前に置く短いライムの線
     （v6 の border-top は `hr` と重なって二重に見えたのでやめた）。 */
  .blog-body :global(h2) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(20px, 2.1vw, 24px);
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--tx);
    margin: 68px 0 20px;
  }
  .blog-body :global(h2::before) {
    content: "";
    display: block;
    width: 28px;
    height: 2px;
    border-radius: 2px;
    background: var(--ok);
    margin-bottom: 18px;
  }
  .blog-body :global(> h2:first-child) {
    margin-top: 44px;
  }
  .blog-body :global(h3) {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--tx);
    margin: 46px 0 14px;
    padding-left: 16px;
    position: relative;
  }
  .blog-body :global(h3::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--ok-ink);
  }
  .blog-body :global(h2 + h3) {
    margin-top: 30px;
  }
  .blog-body :global(h4) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: 0.06em;
    color: var(--tx);
    margin: 30px 0 10px;
  }
  .blog-body :global(p) {
    margin: 0 0 22px;
  }
  .blog-body :global(strong) {
    font-weight: 600;
    color: var(--tx);
  }
  .blog-body :global(li > strong:first-child) {
    letter-spacing: 0.03em;
  }
  .blog-body :global(a) {
    color: var(--ok-light);
    text-decoration: none;
    border-bottom: 1px solid rgba(78, 122, 0, 0.35);
    transition: border-color 0.15s;
    overflow-wrap: anywhere;
  }
  .blog-body :global(a:hover) {
    border-bottom-color: var(--ok-light);
  }

  /* ─── LISTS ─── */
  .blog-body :global(ul),
  .blog-body :global(ol) {
    margin: 0 0 24px;
    padding-left: 0;
    list-style: none;
  }
  .blog-body :global(ol) {
    counter-reset: bloglist;
  }
  .blog-body :global(li) {
    position: relative;
    padding-left: 26px;
    margin-bottom: 15px;
    line-height: 1.95;
  }
  .blog-body :global(li:last-child) {
    margin-bottom: 0;
  }
  .blog-body :global(ul li::before) {
    content: "";
    position: absolute;
    left: 3px;
    top: 15px;
    width: 10px;
    height: 2px;
    background: var(--ok-ink);
    border-radius: 2px;
  }
  .blog-body :global(ol li) {
    counter-increment: bloglist;
  }
  .blog-body :global(ol li::before) {
    content: counter(bloglist);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ok-ink);
  }
  /* 入れ子（実測で2〜3段まで出てくる）。段が下がるほど印を弱くする。 */
  .blog-body :global(li > ul),
  .blog-body :global(li > ol) {
    margin: 14px 0 2px;
  }
  .blog-body :global(li:has(> ul)),
  .blog-body :global(li:has(> ol)) {
    margin-bottom: 22px;
  }
  .blog-body :global(li li) {
    margin-bottom: 12px;
    padding-left: 22px;
  }
  .blog-body :global(li li::before) {
    left: 2px;
    top: 14px;
    width: 7px;
    background: var(--muted);
  }
  .blog-body :global(li li li::before) {
    width: 5px;
    background: #a9afa4;
  }

  /* ─── QUOTES ─── */
  .blog-body :global(blockquote),
  .blog-body :global(p:has(> em:only-child)) {
    margin: 0 0 24px;
    padding: 2px 0 2px 22px;
    border-left: 2px solid var(--ok);
    font-family: var(--font-serif-jp);
    font-size: 16px;
    line-height: 1.95;
    color: var(--tx);
    font-style: normal;
