                      {b.data.impact && <span class="ix-row-i">{b.data.impact}</span>}
                    </span>
                    <span class="ix-arrow" aria-hidden="true">→</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}

        <nav class="cb-pager" data-pager hidden aria-label="Pagination"></nav>

        <div class="cb-no-results" hidden>{labels.noResults}</div>
      </section>
      )}

      {/* アーカイブ末尾にも戻り導線（長い一覧を下まで見た人向け）。 */}
      {isArchive && (
        <a class="cb-seeall cb-seeall--back" href={indexHref}>
          <span class="cb-seeall-arrow" aria-hidden="true">←</span>
          <span>{labels.backToLatest}</span>
        </a>
      )}

    </div>

  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

