---
/**
 * Lemma Critical Brief — shared Index template for /ja/ and /en/.
 *
 * モック `lemma_brief_index_mock_v5.html` の面
 * （`Lemma_コンテンツテンプレート_実装指示_v1_2026-07-30.md` §4）。
 *
 * 在庫が 130 本を超えたため、2026-08-21 から**面を2つに割った**。同じ
 * テンプレートを `variant` で切り替える（カード・トークン・CSS を1本に保つ）。
 *
 *   variant="latest"（既定・`/critical/briefs/`）
 *     ヒーロー → 脅威タイプで探す（アーカイブへのリンク）→ よく見られている
 *     → **最新 LATEST_COUNT 本をフラットに**（月見出しなし・タイトル一段大きく・
 *     カード間の余白を広げる）→「すべての Brief を見る（全 N 本）」→
 *     ニュースレター。全件はここには出さない。
 *
 *   variant="archive"（`/critical/briefs/archive/`）
 *     旧一覧の月別 UI をそのまま移設。戻り導線 → 脅威タイプで探す（絞り込み
 *     ボタン）→ すべての Brief（右端に虫眼鏡の検索）→ 月見出し＋2列カード。
 *
 * やらないこと（§4.3）: カバー画像／冒頭の統計パネル／「読み方」ブロック。
 *
 * アーカイブは SSR で全件を出し（SEO と no-JS フォールバック、§4.4）、表示だけ
 * クライアント側で PAGE_SIZE 件ずつの**ページ送り**にする（2026-07-30 レビュー
 * での指示）。月見出しの件数はフィルタ後の月内総数、月の表示はそのページに
 * 1件でもあるかで決める——ページを跨ぐ月は次ページでも同じ見出しで続く。
 *
 * フィルタ・検索はクライアント側の progressive enhancement で、従来どおり
 * URL パラメータ（?category=<slug> / ?pillar=p1..p4 / ?q=<keyword>）を
 * 読み書きする——Brief 記事のタグや柱ページからの deep link を壊さない。
 * ただし**受け口はアーカイブ側**に移ったので、トップに旧クエリ付きで来た
 * 訪問者はアーカイブへ送る（`briefIndex.ts` 参照）。旧デザインのソート／
 * 密度切替は、月見出しの時系列一覧に役割を吸収されたので持たない。
 *
 * 並び順は **published（＝カードに出る日付）の降順**。`incident_date` は
 * 事案の発生日で、公開日と 124/133 本でずれる（例: No.126 は 2024-10-02）。
 * 事案日で並べるとカード上の日付と一致せず一覧が乱れて見えるので、表示日で
 * 並べる。番号が前後する（6月に 42/61 が混じる等）のは欠番と再編集の結果で、
 * 日付順が主というのが仕様。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import { getTranslations, type Locale } from "../i18n/translations";
import {
  categoryLabel,
  type PillarSlug,
  type CategorySlug,
} from "../data/criticalBriefs";
import { getEnBriefMap } from "../data/getEnBriefMap";
import { POPULAR_BRIEF_SLUGS } from "../data/popularBriefs";
import {
  LATEST_COUNT,
  briefsArchiveHref,
  briefsIndexHref,
  briefsCategoryHref,
} from "../data/briefIndex";
import NewsletterEmbed from "../components/NewsletterEmbed.astro";

export interface BriefIndexTemplateProps {
  locale: Locale;
  /** "latest" = 一覧トップ（既定） / "archive" = 全件の月別アーカイブ */
  variant?: "latest" | "archive";
}

const { locale, variant = "latest" } = Astro.props as BriefIndexTemplateProps;
const t = getTranslations(locale);
const isJa = locale === "ja";
const isArchive = variant === "archive";
const base = isJa ? "/ja" : "";
const pagePath = isArchive
  ? "/critical/briefs/archive/"
  : "/critical/briefs/";
const indexHref = briefsIndexHref(base);
const archiveHref = briefsArchiveHref(base);

const PILLAR_PARAM: Record<PillarSlug, string> = {
  "01-verifiable-origin": "p1",
  "02-verifiable-ai": "p2",
  "03-agent-authority": "p3",
  "04-regulatory-attribute": "p4",
};

type AnyBrief =
  | CollectionEntry<"critical-briefs">
  | CollectionEntry<"critical-briefs-en">;

const allJaBriefs = await getCollection("critical-briefs");
const enById = isJa ? null : await getEnBriefMap();

const allBriefs: ReadonlyArray<AnyBrief> = allJaBriefs.map((ja) =>
  enById?.get(ja.id) ?? ja,
);

// Sort by published desc, breaking same-day ties on brief_no desc.
const briefsByPublishedDesc: ReadonlyArray<AnyBrief> = [...allBriefs].sort(
  (a, b) => {
    const diff = b.data.published.getTime() - a.data.published.getTime();
    if (diff !== 0) return diff;
    return b.data.brief_no - a.data.brief_no;
  },
);

// 月見出し（`2026年7月 · 6件`）ごとのグループ。published の降順のまま切る。
interface MonthGroup {
  key: string; // "2026-07"
  label: string;
  briefs: AnyBrief[];
}
const monthGroups: MonthGroup[] = [];
for (const b of briefsByPublishedDesc) {
  const d = b.data.published;
  const key = d.toISOString().slice(0, 7);
  let group = monthGroups[monthGroups.length - 1];
  if (!group || group.key !== key) {
    const y = d.getUTCFullYear();
    const m = d.getUTCMonth();
    const label = isJa
      ? `${y}年${m + 1}月`
      : `${["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"][m]} ${y}`;
    group = { key, label, briefs: [] };
    monthGroups.push(group);
  }
  group.briefs.push(b);
}

// 一覧トップに出す最新分（月見出しなしのフラットな新着順）。件数は
// `briefIndex.ts` の LATEST_COUNT 1箇所で調整する。
const latestBriefs = briefsByPublishedDesc.slice(0, LATEST_COUNT);

// Manually-curated "most-read" ranking (src/data/popularBriefs.ts), resolved to
// Brief entries in listed order; unknown slugs are dropped.
const briefById = new Map(allBriefs.map((b) => [b.id, b]));
const popularBriefs = POPULAR_BRIEF_SLUGS.map((s) => briefById.get(s)).filter(
  (b): b is AnyBrief => Boolean(b),
);

// Category usage: count primary + secondary occurrences across all Briefs.
const categoryUsage = new Map<CategorySlug, number>();
for (const b of allBriefs) {
  const prim = b.data.primary_category as CategorySlug;
  categoryUsage.set(prim, (categoryUsage.get(prim) ?? 0) + 1);
  for (const sc of b.data.secondary_categories) {
    const cat = sc as CategorySlug;
    categoryUsage.set(cat, (categoryUsage.get(cat) ?? 0) + 1);
  }
}
const sortedCategories = Array.from(categoryUsage.entries()).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const maxCategoryCount = sortedCategories[0]?.[1] ?? 1;

const briefsCount = allBriefs.length;
/**
 * 通し番号は欠番があるので、公開実数（briefsCount）と最新番号は一致しない。
 * 「全 133 本 / 最新 No.135」のように**分けて**出し、どちらかで他方を
 * 代弁させない。
 */
const latestBriefNo = allBriefs.reduce(
  (max, b) => Math.max(max, b.data.brief_no),
  0,
);

/**
 * 脅威タイプの 16px ラインアイコン（モックのものをカテゴリ slug に対応）。
 * `model-supply-chain` と `agent-payment-abuse` はモックの一覧に無いので
 * 同じ線の言語（1.3px・round）で補作。未登録は既定の円。
 */
const CATEGORY_ICONS: Partial<Record<CategorySlug, string>> = {
  "identity-auth": '<circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="2.4"/>',
  "agent-infrastructure":
    '<circle cx="4" cy="5" r="1.8"/><circle cx="12" cy="5" r="1.8"/><circle cx="8" cy="12" r="1.8"/><path d="M5.4 6.2 7 10.4M10.6 6.2 9 10.4M5.8 5h4.4"/>',
  "attribute-proof-bypass":
    '<rect x="2.5" y="3.5" width="11" height="9" rx="2.5" stroke-dasharray="2.6 2.2"/><path d="M4 12.5 12 3.5"/>',
  "data-provenance":
    '<circle cx="3" cy="8" r="1.6"/><circle cx="8" cy="8" r="1.6"/><path d="M4.8 8h1.4M9.8 8h1.6"/><path d="M11.6 5.6 14 8l-2.4 2.4"/>',
  "ai-decision-integrity":
    '<path d="M2 8.5c1.6 0 1.6-4 3.2-4s1.6 7 3.2 7 1.6-5 3.2-5 1.6 2 2.4 2"/>',
  "code-provenance": '<path d="M5.6 4.5 2.5 8l3.1 3.5M10.4 4.5 13.5 8l-3.1 3.5"/>',
  "bridge-config-trust":
    '<circle cx="3" cy="8" r="1.7"/><circle cx="13" cy="8" r="1.7"/><path d="M4.9 8h6.2" stroke-dasharray="2.4 2"/>',
  "agent-runaway":
    '<rect x="2.5" y="4" width="7" height="8" rx="2"/><path d="M9.6 8h4M11.8 6.2 13.8 8l-2 1.8"/>',
  "training-data-provenance":
    '<path d="M2.6 5.4 8 3l5.4 2.4L8 7.8z"/><path d="M2.6 8.6 8 11l5.4-2.4M2.6 11.4 8 13.8l5.4-2.4"/>',
  "kyc-aml-disclosure":
    '<circle cx="8" cy="8" r="5.6"/><path d="M8 2.4v11.2"/><path d="M8 2.4a5.6 5.6 0 0 1 0 11.2z" fill="currentColor" stroke="none" opacity=".22"/>',
  "ai-bias-harm":
    '<path d="M8 2.6v10.8M3 6.4h10"/><path d="M3 6.4 1.4 10h3.2zM13 6.4 11.4 10h3.2z"/>',
  "model-supply-chain":
    '<rect x="2.5" y="2.5" width="4.6" height="4.6" rx="1.2"/><rect x="8.9" y="8.9" width="4.6" height="4.6" rx="1.2"/><path d="M7.1 4.8h4.1v4.1M8.9 11.2H4.8V7.1"/>',
  "agent-payment-abuse":
    '<circle cx="6.5" cy="8" r="4.5"/><path d="M4.7 6.6 6.5 8.6l1.8-2M6.5 8.6v2.4M5 9.8h3M12 5.5 14.5 8 12 10.5"/>',
};
const DEFAULT_ICON = '<circle cx="8" cy="8" r="6"/>';

// Per-card derived data (one source of truth)
function briefCardData(b: AnyBrief) {
  const titleLoc = isJa ? b.data.title : b.data.title_en;
  const mainTitle = titleLoc.split(" — ")[0];
  const publishedStr = b.data.published.toISOString().slice(0, 10);
  const briefNoPad = String(b.data.brief_no).padStart(3, "0");
  const pillar = b.data.pillar as PillarSlug;
  const primarySlug = b.data.primary_category as CategorySlug;
  const secondarySlugs = b.data.secondary_categories as CategorySlug[];
  const primaryCatLabel = categoryLabel(primarySlug, locale);
  const secondaryCatLabels = secondarySlugs.map((c) =>
    categoryLabel(c as CategorySlug, locale),
  );
  const cats = [primarySlug, ...secondarySlugs].join(",");
  const searchBlob = [
    mainTitle,
    primaryCatLabel,
    ...secondaryCatLabels,
    `no${briefNoPad}`,
    `no.${briefNoPad}`,
  ]
    .join(" ")
    .toLowerCase();
  return {
    href: `${base}/critical/briefs/${b.id}/`,
    briefNoPad,
    briefNo: b.data.brief_no,
    publishedStr,
    dateShort: publishedStr.slice(5), // "07-28"
    pillarParam: PILLAR_PARAM[pillar],
    mainTitle,
    primarySlug,
    primaryCatLabel,
    cats,
    searchBlob,
  };
}

const labels = isJa
  ? {
      eyebrow: "Lemma Critical Brief",
      h1Lead: "脅威インテリジェンス ×",
      h1Accent: "信頼インフラ。",
      descLead:
        "AI・暗号インフラ・サプライチェーン・規制属性領域で起きた重大事案を、Lemma が構造的に解析。各 Brief は「検出と証明の落差」を明示し、",
      descStrong: "リスク評価・規制対応・信頼インフラ設計",
      descEnd: "に活用できるリファレンス集です。",
      rssLabel: "RSS フィード",
      methodologyLabel: "メソドロジー",
      newsletterLabel: "ニュースレター",
      threatTypes: "脅威タイプで探す",
      threatTypesEn: `Threat Types · ${sortedCategories.length}`,
      popular: "よく見られている",
      popularEn: "Popular",
      allBriefs: "すべての Brief",
      allChip: "すべて",
      searchPlaceholder: "絞り込む",
      searchAria: "Brief を絞り込む",
      countUnit: (n: number) => `${n} 件`,
      noResults: "該当する Brief が見つかりませんでした。",
      showAll: "すべて表示",
      latest: "最新の Brief",
      latestEn: `Latest · ${LATEST_COUNT}`,
      seeAll: `すべての Brief を見る（全 ${briefsCount} 本）`,
      backToLatest: "最新の Brief へ戻る",
      archiveH1: "Brief アーカイブ",
      archiveMeta: `全 ${briefsCount} 本 · 最新は No.${latestBriefNo} · 公開月順`,
      pageTitle:
        "Lemma Critical Brief — 脅威インテリジェンス × 信頼インフラ",
      description:
        "AI・暗号インフラ・サプライチェーン・規制属性領域の重大事案を Lemma が構造的に解析するリファレンス集。各 Brief は「検出と証明の落差」を明示し、リスク評価・規制対応・信頼インフラ設計に活用できる。",
      archivePageTitle: `Brief アーカイブ（全 ${briefsCount} 本）— Lemma Critical Brief`,
      archiveDescription: `Lemma Critical Brief の全 ${briefsCount} 本を公開月ごとに一覧。AI・暗号インフラ・サプライチェーン・規制属性領域の重大事案を、脅威タイプとキーワードで絞り込める。`,
    }
  : {
      eyebrow: "Lemma Critical Brief",
      h1Lead: "threat intelligence ×",
      h1Accent: "trust infrastructure.",
      descLead:
        "Lemma's structured analysis of major incidents across AI, cryptographic infrastructure, supply chains, and regulated attributes. Each Brief makes the gap between detection and proof explicit — a reference for ",
      descStrong:
        "risk assessment, regulatory response, and trust-infrastructure design",
      descEnd: ".",
      rssLabel: "RSS feed",
      methodologyLabel: "Methodology",
      newsletterLabel: "Newsletter",
      threatTypes: "Browse by threat type",
      threatTypesEn: `Threat Types · ${sortedCategories.length}`,
      popular: "Most-read",
      popularEn: "Popular",
      allBriefs: "All Briefs",
      allChip: "All",
      searchPlaceholder: "Filter",
      searchAria: "Filter Briefs",
      countUnit: (n: number) => `${n} brief${n === 1 ? "" : "s"}`,
      noResults: "No Briefs matched your filters.",
      showAll: "Show all",
      latest: "Latest Briefs",
      latestEn: `Latest · ${LATEST_COUNT}`,
      seeAll: `Browse all ${briefsCount} Briefs`,
      backToLatest: "Back to the latest Briefs",
      archiveH1: "Brief archive",
      archiveMeta: `${briefsCount} Briefs · latest No.${latestBriefNo} · by month of publication`,
      pageTitle:
        "Lemma Critical Brief — threat intelligence × trust infrastructure",
      description:
        "A structured-incident-analysis reference from Lemma. Major incidents across AI, cryptographic infrastructure, supply chains, and regulated attributes — each Brief makes the gap between detection and proof explicit for risk assessment, regulatory response, and trust-infrastructure design.",
      archivePageTitle: `Brief archive (all ${briefsCount}) — Lemma Critical Brief`,
      archiveDescription: `All ${briefsCount} Lemma Critical Briefs, grouped by month of publication. Major incidents across AI, cryptographic infrastructure, supply chains, and regulated attributes — filter by threat type or search by keyword.`,
    };

const rssHref = `${base}/critical/briefs/feed.xml`;
const methodologyHref = `${base}/critical/briefs/methodology/`;
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  title={isArchive ? labels.archivePageTitle : labels.pageTitle}
  description={isArchive ? labels.archiveDescription : labels.description}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="cb-page" data-variant={variant} data-archive-href={archiveHref}>
    <div class="cb-wrap">
      {/* Hero — アーカイブ側は戻り導線つきの簡素版 */}
      {isArchive ? (
        <section class="cb-hero cb-hero--archive">
          <a class="cb-back" href={indexHref}>
            <span aria-hidden="true">←</span> {labels.backToLatest}
          </a>
          <h1>{labels.archiveH1}</h1>
          <p class="cb-archive-meta">{labels.archiveMeta}</p>
        </section>
      ) : (
        <section class="cb-hero">
          <div class="cb-kicker">{labels.eyebrow}</div>
          <h1>{labels.h1Lead}<br />{labels.h1Accent}</h1>
          <p>
            {labels.descLead}<strong>{labels.descStrong}</strong>{labels.descEnd}
          </p>
          <div class="cb-acts">
            <a href={rssHref}>{labels.rssLabel}</a>
            <a href={methodologyHref}>{labels.methodologyLabel}</a>
            <a href="#newsletter">{labels.newsletterLabel}</a>
          </div>
        </section>
      )}

      {/* 脅威タイプで探す。
          トップ = 2列・件数の横バー（アーカイブへのリンク）。
          アーカイブ = 横並びの小さいチップ（絞り込みボタン）。同じ面が2枚続くと
          「遷移した感じ」が出ないので、アーカイブ側は畳んで一覧を上に出す。 */}
      <section aria-label={labels.threatTypes} class={isArchive ? "cb-threats--chips" : undefined}>
        {!isArchive && (
          <div class="cb-label">
            <b>{labels.threatTypes}</b><span>{labels.threatTypesEn}</span>
          </div>
        )}
        {isArchive ? (
          <button type="button" class="cb-allpill is-active" data-cat="all">
            {labels.allChip} <i>{briefsCount}</i>
          </button>
        ) : (
          <a class="cb-allpill" href={archiveHref}>
            {labels.allChip} <i>{briefsCount}</i>
          </a>
        )}
        <div class="cb-distwrap">
          {sortedCategories.map(([cat, count]) => {
            const Tag = isArchive ? "button" : "a";
            const tagProps = isArchive
              ? { type: "button" as const }
              : { href: briefsCategoryHref(base, cat) };
            return (
            <Tag class="cb-dist" data-cat={cat} {...tagProps}>
              <span class="di">
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={CATEGORY_ICONS[cat] ?? DEFAULT_ICON}
                />
              </span>
              <span class="dn">{categoryLabel(cat, locale)}</span>
              <span class="db">
                <i style={`width:${Math.round((count / maxCategoryCount) * 100)}%`}></i>
              </span>
              <span class="dc">{count}</span>
            </Tag>
            );
          })}
        </div>
      </section>

      {/* よく見られている（トップのみ）: GA4 実測ベースのランキング。
          並びは popularBriefs.ts 1ファイル、更新は scripts/refresh-popular-briefs.py。 */}
      {!isArchive && popularBriefs.length > 0 && (
        <section aria-label={labels.popular}>
          <div class="cb-label">
            <b>{labels.popular}</b><span>{labels.popularEn}</span>
          </div>
          <div class="cb-popwrap">
            {popularBriefs.map((b, i) => {
              const c = briefCardData(b);
              return (
                <a class="cb-poprow" href={c.href}>
                  <span class="rk">{i + 1}</span>
                  <span class="pt">{c.mainTitle}</span>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* 最新（トップのみ）— 月見出しなしのフラットな新着順・カードは拡大版。 */}
      {!isArchive && (
        <section aria-label={labels.latest}>
          <div class="cb-label">
            <b>{labels.latest}</b><span>{labels.latestEn}</span>
          </div>
          <div class="cb-bcdgrid cb-bcdgrid--lg">
            {latestBriefs.map((b) => {
              const c = briefCardData(b);
              return (
                <a href={c.href} class="cb-bcd cb-bcd--lg">
                  <div class="cb-bcd-no">{c.briefNo}</div>
                  <div>
                    <div class="cb-bcd-t">{c.mainTitle}</div>
                    <div class="cb-bcd-foot">
                      <span class="cb-bcd-tag">{c.primaryCatLabel}</span>
                      <span class="cb-bcd-d">{c.dateShort}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
          <a class="cb-seeall" href={archiveHref}>
            <span>{labels.seeAll}</span>
            <span class="cb-seeall-arrow" aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {/* すべての Brief（アーカイブのみ・見出し行の右端に虫眼鏡の検索） */}
      {isArchive && (
      <section aria-label={labels.allBriefs}>
        <div class="cb-listhead">
          <b>{labels.allBriefs}</b>
          <span class="lh-en">All — {briefsCount}</span>
          <span class="lh-rule"></span>
          <label class="cb-search">
            <span class="mg">
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="7" cy="7" r="4.6"></circle>
                <path d="m10.4 10.4 3.2 3.2"></path>
              </svg>
            </span>
            <input
              type="text"
              name="q"
              placeholder={labels.searchPlaceholder}
              aria-label={labels.searchAria}
              autocomplete="off"
            />
          </label>
        </div>

        {/* フィルタ中の件数と解除（月見出しの一覧はフィルタで隠れる）。 */}
        <div class="cb-fctx" data-filter-context hidden>
          <span data-fctx-label></span>
          <button type="button" data-fctx-clear>{labels.showAll}</button>
        </div>

        {monthGroups.map((g) => (
          <div class="cb-month" data-month>
            <div class="cb-mhead">
              <b>{g.label}</b>
              <span data-month-count>{labels.countUnit(g.briefs.length)}</span>
            </div>
            <div class="cb-bcdgrid">
              {g.briefs.map((b) => {
                const c = briefCardData(b);
                return (
                  <a
                    href={c.href}
                    class="cb-bcd"
                    data-pillar={c.pillarParam}
                    data-cats={c.cats}
                    data-search={c.searchBlob}
                  >
                    <div class="cb-bcd-no">{c.briefNo}</div>
                    <div>
                      <div class="cb-bcd-t">{c.mainTitle}</div>
                      <div class="cb-bcd-foot">
                        <span class="cb-bcd-tag">{c.primaryCatLabel}</span>
                        <span class="cb-bcd-d">{c.dateShort}</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}

        <nav class="cb-pager" data-pager hidden aria-label="Pagination"></nav>

        <div class="cb-no-results" hidden>{labels.noResults}</div>
      </section>
      )}

      {/* アーカイブ末尾にも戻り導線（長い一覧を下まで見た人向け）。 */}
      {isArchive && (
        <a class="cb-seeall cb-seeall--back" href={indexHref}>
          <span class="cb-seeall-arrow" aria-hidden="true">←</span>
          <span>{labels.backToLatest}</span>
        </a>
      )}

      <section id="newsletter" class="cb-newsletter">
        <NewsletterEmbed locale={locale} placement="briefs-index" />
      </section>
    </div>

    {/* Dismissible sticky newsletter bar — tucks away at the footer #newsletter. */}
    <div class="cb-nlbar" data-nlbar>
      <div class="cb-nlbar-inner">
        <div class="cb-nlbar-text">
          <span class="cb-nlbar-title">Lemma Critical Weekly</span>
          <span class="cb-nlbar-lead">
            {isJa
              ? "重大リスク事案の構造分析を、毎週メールで。"
              : "Structural analysis of major risk incidents — weekly, by email."}
          </span>
        </div>
        <div class="cb-nlbar-actions">
          <button
            type="button"
            class="cb-nlbar-cta"
            data-tally-open={isJa ? "EkMj82" : "rjvN2X"}
            data-tally-layout="modal"
            data-tally-width="540"
            data-tally-emoji-text=""
          >{isJa ? "メールで購読" : "Subscribe"}</button>
          <button
            type="button"
            class="cb-nlbar-close"
            data-nlbar-close
            aria-label={isJa ? "閉じる" : "Dismiss"}
          >✕</button>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* トークンの値は記事テンプレート（BlogArticleTemplate）と同じもの。 */
  .cb-page {
    --ok: #a8e010;
    --ok-ink: #6f9c00;
    --ok-light: #4e7a00;
    --ink: #0f1412;
    --lite: #f3f4f1;
    --lite-2: #eceee9;
    --card: #fff;
    --tx: #12140e;
    --tx-soft: #2f332b;
    --muted: #5c6156;
    --line: #e1e3dd;
    --sh-s: 0 4px 14px rgba(14, 18, 16, 0.06);
    --sh-m: 0 14px 40px rgba(14, 18, 16, 0.09), 0 2px 6px rgba(14, 18, 16, 0.05);
    --font-serif-jp: "Space Grotesk", "Noto Serif JP", Georgia, serif;
    --font-body: "Space Grotesk", "Noto Sans JP", "Hiragino Sans", sans-serif;
    --font-num: "Inter", "Noto Sans JP", sans-serif;
    --font-mono: "Space Mono", monospace;

    background: var(--lite);
    color: var(--tx-soft);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    padding: 0;
    padding-top: 64px; /* sticky ナビ時代の margin-top:64px を padding に変換 — body 背景色の帯を出さない（H1 上の空白修正） */
  }
  .cb-wrap {
    max-width: calc(1180px + 12vw);
    margin: 0 auto;
    padding: 0 6vw;
  }

  /* ─── HERO ─── */
  .cb-hero {
    padding: 44px 0 0;
    max-width: 70ch;
  }
  .cb-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cb-hero h1 {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.55;
    letter-spacing: 0.03em;
    color: var(--tx);
    margin: 14px 0 14px;
  }
  .cb-hero p {
    margin: 0 0 18px;
    font-size: 14.5px;
    line-height: 1.95;
    color: var(--tx-soft);
  }
  .cb-hero strong {
    font-weight: 600;
    color: var(--tx);
  }
  .cb-acts {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 12.5px;
  }
  .cb-acts a {
    color: var(--ok-light);
    text-decoration: none;
    border-bottom: 1px solid rgba(78, 122, 0, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }
  .cb-acts a:hover {
    border-color: var(--ok-light);
  }

  /* ─── SECTION LABEL ───
     ラベル行の罫線が上境界を兼ねる。直下に別の全幅罫線は置かない（§6-2）。 */
  .cb-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 44px 0 18px;
  }
  .cb-label b {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.06em;
    color: var(--tx);
  }
  .cb-label span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cb-label::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }

  /* ─── 脅威タイプで探す ─── */
  /* `.cb-allpill` / `.cb-dist` はトップでは <a>、アーカイブでは <button>。
     どちらでも同じ見た目になるようリンクの既定を打ち消す。 */
  .cb-allpill,
  .cb-dist {
    text-decoration: none;
    color: inherit;
  }
  .cb-allpill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-size: 13px;
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--tx-soft);
    border-radius: 99px;
    padding: 8px 16px;
    margin-bottom: 16px;
    cursor: pointer;
    font-weight: 400;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .cb-allpill:hover {
    border-color: rgba(124, 175, 0, 0.5);
    color: var(--tx);
  }
  .cb-allpill.is-active {
    background: var(--ok);
    border-color: var(--ok);
    color: var(--ink);
    font-weight: 600;
  }
  .cb-allpill i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }
  .cb-allpill.is-active i {
    color: var(--ink);
    opacity: 0.65;
  }
  .cb-distwrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px 40px;
  }
  .cb-dist {
    display: grid;
    grid-template-columns: 16px 118px 1fr 30px;
    gap: 12px;
    align-items: center;
    padding: 8px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-body);
    transition: color 0.15s;
  }
  .cb-dist .di {
    width: 16px;
    height: 16px;
    color: var(--muted);
    flex: none;
    display: grid;
    place-items: center;
  }
  .cb-dist .di svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .cb-dist:hover .di,
  .cb-dist.is-active .di {
    color: var(--ok-ink);
  }
  .cb-dist .dn {
    font-size: 12.5px;
    color: var(--tx-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s;
  }
  .cb-dist:hover .dn {
    color: var(--ok-ink);
  }
  .cb-dist.is-active .dn {
    color: var(--ok-ink);
    font-weight: 600;
  }
  .cb-dist .db {
    height: 6px;
    border-radius: 99px;
    background: #e4e7e1;
    overflow: hidden;
  }
  .cb-dist .db i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, #8cbe0e, var(--ok));
  }
  .cb-dist .dc {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    text-align: right;
  }

  /* ─── よく見られている（2列・1行クランプ） ─── */
  .cb-popwrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }
  .cb-poprow {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 0.15s;
  }
  .cb-poprow .rk {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ok-ink);
  }
  .cb-poprow .pt {
    font-size: 13px;
    line-height: 1.65;
    color: var(--tx);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }
  .cb-poprow:hover .pt {
    color: var(--ok-ink);
  }

  /* ─── すべての Brief: 見出し行＋検索 ─── */
  .cb-listhead {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 40px 0 10px;
  }
  .cb-listhead b {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: 0.06em;
    color: var(--tx);
  }
  .lh-en {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lh-rule {
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .cb-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 7px 14px;
    width: 196px;
    transition: border-color 0.15s, width 0.15s;
  }
  .cb-search:focus-within {
    border-color: rgba(124, 175, 0, 0.55);
    width: 260px;
  }
  .cb-search .mg {
    width: 15px;
    height: 15px;
    color: var(--muted);
    flex: none;
    display: grid;
    place-items: center;
  }
  .cb-search .mg svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .cb-search input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: none;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--tx);
  }
  .cb-search input::placeholder {
    color: var(--muted);
  }

  /* ─── フィルタ中の文脈行 ─── */
  .cb-fctx {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 10px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }
  .cb-fctx[hidden] {
    display: none;
  }
  .cb-fctx button {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ok-ink);
    background: none;
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 4px 11px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .cb-fctx button:hover {
    border-color: rgba(124, 175, 0, 0.5);
    color: var(--tx);
  }

  /* ─── 月見出し＋2列カード ─── */
  .cb-mhead {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 22px 0 14px;
  }
  .cb-mhead b {
    font-family: var(--font-serif-jp);
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: 0.06em;
    color: var(--tx);
  }
  .cb-mhead span {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
  }
  .cb-mhead::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .cb-month[hidden] {
    display: none;
  }
  .cb-bcdgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .cb-bcd {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px 16px;
    text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
    position: relative;
    overflow: hidden;
  }
  .cb-bcd[hidden] {
    display: none;
  }
  /* ホバーで左辺にライムのバーが上から伸びる（§4.2）。 */
  .cb-bcd::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--ok);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s;
  }
  .cb-bcd:hover {
    border-color: rgba(124, 175, 0, 0.45);
    box-shadow: var(--sh-m);
    transform: translateY(-2px);
  }
  .cb-bcd:hover::before {
    transform: scaleY(1);
  }
  .cb-bcd-no {
    font-family: var(--font-num);
    font-weight: 200;
    font-size: 30px;
    line-height: 1;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
    transition: color 0.18s;
  }
  .cb-bcd:hover .cb-bcd-no {
    color: var(--ok-ink);
  }
  .cb-bcd-t {
    font-size: 13.8px;
    line-height: 1.75;
    color: var(--tx);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cb-bcd-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }
  .cb-bcd-tag {
    color: var(--ok-ink);
  }
  .cb-bcd-d {
    margin-left: auto;
  }

  /* ─── 最新（トップ）: タイトルを一段大きく・カード間の余白を広げる ───
     1タイトルが主役になる密度。既定 12 本で 2 列 × 6 行。 */
  .cb-bcdgrid--lg {
    gap: 22px 20px;
  }
  .cb-bcd--lg {
    grid-template-columns: 72px 1fr;
    padding: 24px 24px 22px;
    border-radius: 14px;
  }
  .cb-bcd--lg .cb-bcd-no {
    font-size: 34px;
  }
  .cb-bcd--lg .cb-bcd-t {
    font-size: 16.5px;
    line-height: 1.72;
    letter-spacing: 0.01em;
  }
  .cb-bcd--lg .cb-bcd-foot {
    margin-top: 16px;
  }

  /* 「すべての Brief を見る（全 N 本）」— セクション末尾の遷移。 */
  .cb-seeall {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 26px 0 0;
    padding: 11px 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--tx);
    text-decoration: none;
    transition: border-color 0.18s, box-shadow 0.18s, color 0.18s;
  }
  .cb-seeall:hover {
    border-color: rgba(124, 175, 0, 0.5);
    box-shadow: var(--sh-s);
    color: var(--ok-light);
  }
  .cb-seeall-arrow {
    font-family: var(--font-mono);
    color: var(--muted);
    transition: transform 0.18s, color 0.18s;
  }
  .cb-seeall:hover .cb-seeall-arrow {
    color: var(--ok-light);
    transform: translateX(2px);
  }
  .cb-seeall--back {
    margin-top: 34px;
  }
  .cb-seeall--back:hover .cb-seeall-arrow {
    transform: translateX(-2px);
  }

  /* ─── アーカイブのヒーロー（戻り導線つき・1行に圧縮） ───
     トップと同じ面が2枚続くと遷移した感じが出ないので、eyebrow・リード段落・
     RSS 行は落として、一覧を最初の画面に入れる。 */
  .cb-hero--archive {
    padding-bottom: 4px;
  }
  .cb-hero--archive h1 {
    font-size: clamp(23px, 2.2vw, 28px);
    margin: 6px 0 8px;
  }
  .cb-archive-meta {
    margin: 0 !important;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /* ─── 脅威タイプ: アーカイブ側の横並びチップ ───
     `.cb-dist` のままなのでスクリプトの絞り込みはそのまま効く。横バーは隠す。 */
  .cb-threats--chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 18px 0 4px;
  }
  .cb-threats--chips .cb-allpill {
    margin: 0;
  }
  .cb-threats--chips .cb-distwrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cb-threats--chips .cb-dist {
    grid-template-columns: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--card);
    transition: border-color 0.15s, color 0.15s;
  }
  .cb-threats--chips .cb-dist:hover,
  .cb-threats--chips .cb-dist.is-active {
    border-color: rgba(124, 175, 0, 0.5);
  }
  .cb-threats--chips .cb-dist.is-active {
    background: var(--ok);
    border-color: var(--ok);
  }
  .cb-threats--chips .cb-dist.is-active .di,
  .cb-threats--chips .cb-dist.is-active .dn,
  .cb-threats--chips .cb-dist.is-active .dc {
    color: var(--ink);
  }
  .cb-threats--chips .cb-dist .dn {
    font-size: 12px;
  }
  .cb-threats--chips .cb-dist .db {
    display: none;
  }
  .cb-threats--chips .cb-dist .dc {
    font-size: 10.5px;
  }
  /* チップ行の直後は見出しの余白を詰める（罫線が二重に見えないように）。 */
  .cb-threats--chips + section .cb-listhead {
    margin-top: 26px;
  }
  .cb-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .cb-back:hover {
    color: var(--ok-light);
  }

  /* ─── ページ送り ─── */
  .cb-pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin: 30px 0 0;
  }
  .cb-pager[hidden] {
    display: none;
  }
  .cb-pager :global(.cb-pager-btn) {
    min-width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0 8px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .cb-pager :global(.cb-pager-btn:hover:not([disabled])) {
    border-color: rgba(124, 175, 0, 0.5);
    color: var(--tx);
  }
  /* 現在ページは蛍光地に墨文字（ピル・タブと同じ選択の言語）。 */
  .cb-pager :global(.cb-pager-btn.is-active) {
    background: var(--ok);
    border-color: var(--ok);
    color: var(--ink);
    font-weight: 700;
    cursor: default;
  }
  .cb-pager :global(.cb-pager-btn[disabled]) {
    opacity: 0.4;
    cursor: default;
  }

  .cb-no-results {
    margin: 26px 0 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .cb-no-results[hidden] {
    display: none;
  }

  /* ─── NEWSLETTER ─── */
  .cb-newsletter {
    margin-top: 64px;
  }
  .cb-page :global(.newsletter-embed) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  /* ─── STICKY NEWSLETTER BAR ─── */
  .cb-nlbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    transform: translateY(110%);
    transition: transform 0.3s ease;
    pointer-events: none;
  }
  .cb-nlbar.is-visible {
    transform: translateY(0);
    pointer-events: auto;
  }
  .cb-nlbar-inner {
    display: flex;
    align-items: center;
    gap: 14px 22px;
    flex-wrap: wrap;
    max-width: 860px;
    margin: 0 auto 14px;
    padding: 13px 20px;
    background: linear-gradient(172deg, #3c443d 0%, #333b34 55%, #2e362f 100%);
    border-radius: 12px;
    box-shadow: 0 18px 44px rgba(22, 30, 24, 0.3);
  }
  .cb-nlbar-text {
    flex: 1;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cb-nlbar-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #a8e010;
  }
  .cb-nlbar-lead {
    font-size: 12.5px;
    line-height: 1.7;
    color: #d8ddd1;
  }
  .cb-nlbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cb-nlbar-cta {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    color: #0f1412;
    background: #a8e010;
    border: none;
    border-radius: 7px;
    padding: 9px 16px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(168, 224, 16, 0.3);
    transition: filter 0.15s;
  }
  .cb-nlbar-cta:hover {
    filter: brightness(1.06);
  }
  .cb-nlbar-close {
    background: none;
    border: none;
    color: #9ba296;
    font-size: 13px;
    cursor: pointer;
    padding: 6px;
    transition: color 0.15s;
  }
  .cb-nlbar-close:hover {
    color: #fff;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1020px) {
    .cb-bcd--lg {
      grid-template-columns: 60px 1fr;
      padding: 20px 20px 18px;
    }
    .cb-bcd--lg .cb-bcd-no {
      font-size: 30px;
    }
    .cb-bcd--lg .cb-bcd-t {
      font-size: 15.5px;
    }
    .cb-distwrap,
    .cb-popwrap,
    .cb-bcdgrid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .cb-wrap {
      padding: 0 24px;
    }
    .cb-listhead {
      flex-wrap: wrap;
    }
    .cb-search,
    .cb-search:focus-within {
      width: 100%;
    }
  }
  @media (max-width: 640px) {
    /* チップを折り返すと 12 個で 400px 超を占めて一覧が画面外へ落ちるので、
       スマホでは1行の横スクロールにする（スクロールバーは出さない）。 */
    .cb-threats--chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
      /* 端で切れて見えるよう、ラッパーのパディング分だけ外へ出す。 */
      margin-inline: -24px;
      padding-inline: 24px;
    }
    .cb-threats--chips::-webkit-scrollbar {
      display: none;
    }
    .cb-threats--chips .cb-distwrap {
      flex-wrap: nowrap;
    }
    .cb-threats--chips .cb-allpill,
    .cb-threats--chips .cb-dist {
      flex: none;
    }
    /* モバイルは1列。拡大カードは行間を詰めすぎない（12本で過密にしない）。 */
    .cb-bcdgrid--lg {
      gap: 16px;
    }
    .cb-bcd--lg .cb-bcd-t {
      font-size: 15px;
      line-height: 1.78;
    }
    .cb-seeall {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cb-bcd,
    .cb-bcd::before,
    .cb-seeall,
    .cb-seeall-arrow,
    .cb-nlbar {
      transition: none;
    }
  }
</style>

<script>
  // フィルタ／検索 — progressive enhancement。アーカイブ側で SSR 全件を
  // 出したうえで表示だけを切り替え、URL パラメータ（?category / ?pillar /
  // ?q）を従来どおり読み書きする。
  (function () {
    const root = document.querySelector<HTMLElement>(".cb-page");
    if (!root) return;

    // 一覧トップには全件が無いので、絞り込みの受け口はアーカイブ側だけ。
    // 旧 deep link（Brief 記事のタグ・外部からのブックマーク）でトップに
    // 来た訪問者は、同じクエリのままアーカイブへ送る。
    if (root.dataset.variant !== "archive") {
      const legacy = new URLSearchParams(location.search);
      const archive = root.dataset.archiveHref;
      if (
        archive &&
        (legacy.has("category") || legacy.has("pillar") || legacy.has("q"))
      ) {
        location.replace(archive + "?" + legacy.toString());
      }
      return;
    }

    const cards = Array.from(root.querySelectorAll<HTMLElement>(".cb-bcd"));
    const months = Array.from(root.querySelectorAll<HTMLElement>("[data-month]"));
    const allPill = root.querySelector<HTMLElement>(".cb-allpill");
    const dists = Array.from(root.querySelectorAll<HTMLElement>(".cb-dist"));
    const searchInput = root.querySelector<HTMLInputElement>(".cb-search input");
    const noResults = root.querySelector<HTMLElement>(".cb-no-results");
    const fctx = root.querySelector<HTMLElement>("[data-filter-context]");
    const fctxLabel = root.querySelector<HTMLElement>("[data-fctx-label]");
    const fctxClear = root.querySelector<HTMLElement>("[data-fctx-clear]");
    const pager = root.querySelector<HTMLElement>("[data-pager]");
    const listHead = root.querySelector<HTMLElement>(".cb-listhead");
    const countUnit = (n: number) =>
      document.documentElement.lang === "ja"
        ? `${n} 件`
        : `${n} brief${n === 1 ? "" : "s"}`;

    // mode: "all" | "category" | "pillar" | "search"
    let mode = "all";
    let activeCat = "all";
    let activePillar = "";
    let query = "";
    let currentPage = 1;
    const PAGE_SIZE = 20;

    function cardMatches(card: HTMLElement): boolean {
      if (mode === "category")
        return (card.dataset.cats || "").split(",").includes(activeCat);
      if (mode === "pillar") return card.dataset.pillar === activePillar;
      if (mode === "search") {
        if (!query) return true;
        return (card.dataset.search || "").includes(query);
      }
      return true;
    }

    function apply() {
      // DOM 順＝published 降順。マッチ集合を出してから現在ページ分だけ見せる。
      const matching = cards.filter(cardMatches);
      const totalPages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      const start = (currentPage - 1) * PAGE_SIZE;
      const pageSet = new Set(matching.slice(start, start + PAGE_SIZE));
      cards.forEach((c) => {
        c.hidden = !pageSet.has(c);
      });
      // 月見出しの件数は**フィルタ後の月内総数**（ページを跨ぐ月は次ページ
      // でも同じ見出し・同じ件数で続く）。月の表示はこのページに1件でも
      // あるかどうか。
      months.forEach((m) => {
        const inMonth = Array.from(m.querySelectorAll<HTMLElement>(".cb-bcd"));
        const matched = inMonth.filter(cardMatches).length;
        const visible = inMonth.filter((c) => !c.hidden).length;
        m.hidden = visible === 0;
        const cnt = m.querySelector<HTMLElement>("[data-month-count]");
        if (cnt) cnt.textContent = countUnit(matched);
      });
      renderPager(totalPages);
      if (noResults) noResults.hidden = matching.length !== 0;
      // フィルタ文脈行
      if (fctx && fctxLabel) {
        if (mode === "category") {
          const tile = dists.find((d) => d.dataset.cat === activeCat);
          const name =
            tile?.querySelector<HTMLElement>(".dn")?.textContent || activeCat;
          fctxLabel.textContent = `${name} — ${countUnit(matching.length)}`;
          fctx.hidden = false;
        } else if (mode === "pillar" || (mode === "search" && query)) {
          fctxLabel.textContent = countUnit(matching.length);
          fctx.hidden = false;
        } else {
          fctx.hidden = true;
        }
      }
    }

    function renderPager(totalPages: number) {
      if (!pager) return;
      if (totalPages <= 1) {
        pager.innerHTML = "";
        pager.hidden = true;
        return;
      }
      let html =
        '<button type="button" class="cb-pager-btn cb-pager-arrow" data-page="prev" aria-label="Previous"' +
        (currentPage === 1 ? " disabled" : "") +
        ">‹</button>";
      for (let p = 1; p <= totalPages; p++) {
        html +=
          '<button type="button" class="cb-pager-btn' +
          (p === currentPage ? " is-active" : "") +
          '" data-page="' +
          String(p) +
          '"' +
          (p === currentPage ? ' aria-current="page"' : "") +
          ">" +
          String(p) +
          "</button>";
      }
      html +=
        '<button type="button" class="cb-pager-btn cb-pager-arrow" data-page="next" aria-label="Next"' +
        (currentPage === totalPages ? " disabled" : "") +
        ">›</button>";
      pager.innerHTML = html;
      pager.hidden = false;
    }

    function syncPills() {
      if (allPill)
        allPill.classList.toggle("is-active", mode === "all");
      dists.forEach((d) =>
        d.classList.toggle(
          "is-active",
          mode === "category" && d.dataset.cat === activeCat,
        ),
      );
    }

    function setURL() {
      const params = new URLSearchParams();
      if (mode === "category") params.set("category", activeCat);
      else if (mode === "pillar") params.set("pillar", activePillar);
      else if (mode === "search" && query) params.set("q", query);
      const qs = params.toString();
      history.replaceState(null, "", location.pathname + (qs ? `?${qs}` : ""));
    }

    function update(writeURL = true) {
      currentPage = 1;
      syncPills();
      apply();
      if (writeURL) setURL();
    }

    function reset() {
      mode = "all";
      activeCat = "all";
      activePillar = "";
      query = "";
      if (searchInput) searchInput.value = "";
      update();
    }

    if (allPill) allPill.addEventListener("click", reset);
    if (fctxClear) fctxClear.addEventListener("click", reset);

    // ページ送り: ページを変えたら一覧の頭へ戻す（月見出しが変わるため）。
    if (pager) {
      pager.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-page]");
        if (!btn || btn.hasAttribute("disabled")) return;
        const totalPages = Math.max(
          1,
          Math.ceil(cards.filter(cardMatches).length / PAGE_SIZE),
        );
        const v = btn.dataset.page;
        if (v === "prev") currentPage = Math.max(1, currentPage - 1);
        else if (v === "next") currentPage = Math.min(totalPages, currentPage + 1);
        else currentPage = Number(v) || 1;
        apply();
        if (listHead) {
          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          listHead.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
        }
      });
    }

    dists.forEach((d) => {
      d.addEventListener("click", () => {
        const cat = d.dataset.cat || "";
        if (mode === "category" && activeCat === cat) {
          reset();
          return;
        }
        mode = "category";
        activeCat = cat;
        activePillar = "";
        query = "";
        if (searchInput) searchInput.value = "";
        update();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        query = searchInput.value.trim().toLowerCase();
        if (query) {
          mode = "search";
          activeCat = "all";
          activePillar = "";
        } else {
          mode = "all";
        }
        update();
      });
    }

    // Initial state from URL
    const params = new URLSearchParams(location.search);
    const urlCat = params.get("category");
    const urlPillar = params.get("pillar");
    const urlQ = params.get("q");
    if (urlCat && dists.some((d) => d.dataset.cat === urlCat)) {
      mode = "category";
      activeCat = urlCat;
    } else if (urlPillar && /^p[1-4]$/.test(urlPillar)) {
      mode = "pillar";
      activePillar = urlPillar;
    } else if (urlQ) {
      mode = "search";
      query = urlQ.trim().toLowerCase();
      if (searchInput) searchInput.value = urlQ;
    }
    update(false);
  })();
</script>

<!-- Sticky newsletter bar: reveal after scroll, hide near the footer #newsletter,
     dismiss persists via localStorage. -->
<script is:inline>
  (function () {
    var bar = document.querySelector("[data-nlbar]");
    if (!bar) return;
    try {
      if (window.localStorage.getItem("lemma_nlbar_dismissed")) return;
    } catch (e) {}
    var nlSection = document.getElementById("newsletter");
    var footerInView = false;
    var revealed = false;
    function sync() {
      bar.classList.toggle("is-visible", revealed && !footerInView);
    }
    if (nlSection && "IntersectionObserver" in window) {
      new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            footerInView = e.isIntersecting;
            sync();
          });
        },
        { rootMargin: "0px 0px -40px 0px" },
      ).observe(nlSection);
    }
    function onScroll() {
      if (!revealed && (window.scrollY || 0) > 300) {
        revealed = true;
        sync();
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    var closeBtn = bar.querySelector("[data-nlbar-close]");
    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        bar.classList.remove("is-visible");
        try {
          window.localStorage.setItem("lemma_nlbar_dismissed", "1");
        } catch (e) {}
      });
    }
  })();
</script>
