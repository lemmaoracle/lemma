<script>
  (() => {
    const root = document.querySelector<HTMLElement>(".bi-page");
    if (!root) return;

    const gridSection = root.querySelector<HTMLElement>(".bi-grid-section");
    const filterContext = root.querySelector<HTMLElement>("[data-filter-context]");
    const fctxLabel = root.querySelector<HTMLElement>("[data-fctx-label]");
    const fctxDesc = root.querySelector<HTMLElement>("[data-fctx-desc]");
    const fctxClear = root.querySelector<HTMLElement>("[data-fctx-clear]");
    const allCards = Array.from(
      root.querySelectorAll<HTMLElement>(".bi-brief-card"),
    );
    const chips = Array.from(root.querySelectorAll<HTMLElement>(".bi-tile"));
    const sortSel = root.querySelector<HTMLSelectElement>(".bi-sort");
    const densityBtns = Array.from(
      root.querySelectorAll<HTMLElement>(".bi-density button"),
    );
    const grids = Array.from(
      root.querySelectorAll<HTMLElement>(".bi-brief-grid"),
    );
    const search = root.querySelector<HTMLFormElement>(".bi-search");
    const searchInput = root.querySelector<HTMLInputElement>(".bi-search input");
    const resultsStrong = root.querySelector<HTMLElement>(".bi-results-strong");
    const noResults = root.querySelector<HTMLElement>(".bi-no-results");
    const pager = root.querySelector<HTMLElement>("[data-pager]");
    const carousel = root.querySelector<HTMLElement>(".bi-carousel");
    const carPrev = root.querySelector<HTMLElement>(".bi-car-prev");
    const carNext = root.querySelector<HTMLElement>(".bi-car-next");
    if (!gridSection) return;

    // mode: "grouped" | "category" | "pillar" | "search"
    let mode = "grouped";
    let activeCat = "all";
    let activePillar = "";
    let query = "";
    let currentPage = 1;
    const PAGE_SIZE = 12;

    function cardMatches(card: HTMLElement): boolean {
      if (mode === "category")
        return (card.dataset.cats || "").split(",").includes(activeCat);
      if (mode === "pillar") return card.dataset.pillar === activePillar;
      if (mode === "search") {
        if (!query) return true;
        return (card.dataset.search || "").includes(query);
      }
      return true;
    }

    function sortCards() {
      const order = sortSel ? sortSel.value : "newest";
      grids.forEach((grid) => {
        const cards = Array.from(grid.children) as HTMLElement[];
        cards.sort((a, b) => {
          const tsA = Number(a.dataset.ts || 0);
          const tsB = Number(b.dataset.ts || 0);
          const noA = Number(a.dataset.no || 0);
          const noB = Number(b.dataset.no || 0);
          if (order === "oldest") return tsA - tsB || noA - noB;
          if (order === "category")
            return (
              (a.dataset.catkey || "").localeCompare(b.dataset.catkey || "") ||
              tsB - tsA
            );
          return tsB - tsA || noB - noA; // newest
        });
        cards.forEach((c) => grid.appendChild(c));
      });
    }

    function apply() {
      sortCards();
      const grid = grids[0];
      const ordered = grid
        ? (Array.from(grid.children) as HTMLElement[])
        : allCards;
      const matching = ordered.filter(cardMatches);
      const totalPages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      const start = (currentPage - 1) * PAGE_SIZE;
      allCards.forEach((c) => c.classList.add("is-hidden"));
      matching
        .slice(start, start + PAGE_SIZE)
        .forEach((c) => c.classList.remove("is-hidden"));
      renderPagination(totalPages);
      updateFilterContext();
      if (resultsStrong) resultsStrong.textContent = String(matching.length);
      if (noResults) noResults.hidden = matching.length !== 0;
    }

    function renderPagination(totalPages: number) {
      if (!pager) return;
      if (totalPages <= 1) {
        pager.innerHTML = "";
        pager.hidden = true;
        return;
      }
      let html =
        '<button type="button" class="bi-pager-btn bi-pager-arrow" data-page="prev" aria-label="Previous"' +
        (currentPage === 1 ? " disabled" : "") +
        ">‹</button>";
      for (let p = 1; p <= totalPages; p++) {
        html +=
          '<button type="button" class="bi-pager-btn' +
          (p === currentPage ? " is-active" : "") +
          '" data-page="' +
          p +
          '">' +
          p +
          "</button>";
      }
      html +=
        '<button type="button" class="bi-pager-btn bi-pager-arrow" data-page="next" aria-label="Next"' +
        (currentPage === totalPages ? " disabled" : "") +
        ">›</button>";
      pager.innerHTML = html;
      pager.hidden = false;
    }

    function updateFilterContext() {
      if (!filterContext) return;
      if (mode === "category") {
        const tile = chips.find((c) => c.dataset.cat === activeCat);
        if (fctxLabel) fctxLabel.textContent = tile?.dataset.label || "";
        if (fctxDesc) fctxDesc.textContent = tile?.dataset.desc || "";
        filterContext.hidden = false;
      } else {
        filterContext.hidden = true;
      }
    }

    function syncChips() {
      chips.forEach((chip) =>
        chip.classList.toggle(
          "is-active",
          mode === "category"
            ? chip.dataset.cat === activeCat
            : chip.dataset.cat === "all",
        ),
      );
    }

    function setURL() {
      const params = new URLSearchParams();
      if (mode === "category") params.set("category", activeCat);
      else if (mode === "pillar") params.set("pillar", activePillar);
      else if (mode === "search" && query) params.set("q", query);
      const qs = params.toString();
      history.replaceState(
        null,
        "",
        location.pathname + (qs ? `?${qs}` : ""),
      );
    }

    function update(writeURL = true) {
      currentPage = 1;
      syncChips();
      apply();
      if (writeURL) setURL();
    }

    // Chips → category filter
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const cat = chip.dataset.cat || "all";
        if (cat === "all") {
          mode = "grouped";
          activeCat = "all";
        } else {
          mode = "category";
          activeCat = cat;
        }
        activePillar = "";
        query = "";
        if (searchInput) searchInput.value = "";
        update();
      });
    });

    // Filter-context "show all" → clear the active category filter
    if (fctxClear) {
      fctxClear.addEventListener("click", () => {
        mode = "grouped";
        activeCat = "all";
        activePillar = "";
        query = "";
        if (searchInput) searchInput.value = "";
        update();
      });
    }

    // Search
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        query = searchInput.value.trim().toLowerCase();
        if (query) {
          mode = "search";
          activeCat = "all";
          activePillar = "";
        } else {
          mode = "grouped";
        }
        update();
      });
    }
    if (search) {
      search.addEventListener("submit", (e) => {
        e.preventDefault();
        gridSection.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    // Sort
    if (sortSel)
      sortSel.addEventListener("change", () => {
        currentPage = 1;
        apply();
      });

    // Pagination
    if (pager) {
      pager.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-page]");
        if (!btn || btn.hasAttribute("disabled")) return;
        const grid = grids[0];
        const matchCount = grid
          ? (Array.from(grid.children) as HTMLElement[]).filter(cardMatches)
              .length
          : 0;
        const totalPages = Math.max(1, Math.ceil(matchCount / PAGE_SIZE));
        const v = btn.dataset.page;
        if (v === "prev") currentPage = Math.max(1, currentPage - 1);
        else if (v === "next")
          currentPage = Math.min(totalPages, currentPage + 1);
        else currentPage = Number(v) || 1;
        apply();
        gridSection.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    // Density
    densityBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        densityBtns.forEach((b) =>
          b.classList.toggle("is-active", b === btn),
        );
        const list = btn.dataset.density === "list";
        grids.forEach((g) => g.classList.toggle("list", list));
      });
    });

    // Carousel nav
    if (carousel) {
      const step = 334;
      carPrev?.addEventListener("click", () =>
        carousel.scrollBy({ left: -step, behavior: "smooth" }),
      );
      carNext?.addEventListener("click", () =>
        carousel.scrollBy({ left: step, behavior: "smooth" }),
      );
    }

    // Initial state from URL
    const params = new URLSearchParams(location.search);
    const urlCat = params.get("category");
    const urlPillar = params.get("pillar");
    const urlQ = params.get("q");
    if (urlCat && chips.some((c) => c.dataset.cat === urlCat)) {
      mode = "category";
      activeCat = urlCat;
    } else if (urlPillar && /^p[1-4]$/.test(urlPillar)) {
      mode = "pillar";
      activePillar = urlPillar;
    } else if (urlQ) {
      mode = "search";
      query = urlQ.trim().toLowerCase();
      if (searchInput) searchInput.value = urlQ;
    }
    update(false);
  })();
</script>

<!-- 導線 v1: forward Brief→LP/Call CTA clicks to GA4 (surface=brief_index). -->
<script is:inline>
  (function () {
    function wire() {
      var root = document.querySelector(".bi-page");
      if (!root) return;
      var sel = ".bi-cta-banner-wrap [data-ev], .bi-cta-tail [data-ev]";
      root.querySelectorAll(sel).forEach(function (el) {
        el.addEventListener("click", function () {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", el.getAttribute("data-ev"), {
            surface: "brief_index",
            cta_label: el.getAttribute("data-cta"),
            destination: el.getAttribute("href"),
          });
        });
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wire);
    } else {
      wire();
    }
  })();
</script>

<!-- Sticky newsletter bar: reveal after scroll, hide near the footer #newsletter,
     dismiss persists via localStorage. -->
<script is:inline>
  (function () {
    var bar = document.querySelector("[data-nlbar]");
    if (!bar) return;
    try {
      if (window.localStorage.getItem("lemma_nlbar_dismissed")) return;
    } catch (e) {}
    var nlSection = document.getElementById("newsletter");
    var footerInView = false;
    var revealed = false;
    function sync() {
      bar.classList.toggle("is-visible", revealed && !footerInView);
    }
    if (nlSection && "IntersectionObserver" in window) {
      new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            footerInView = e.isIntersecting;
            sync();
          });
        },
        { rootMargin: "0px 0px -40px 0px" },
      ).observe(nlSection);
    }
    function onScroll() {
      if (!revealed && (window.scrollY || 0) > 300) {
        revealed = true;
        sync();
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    var closeBtn = bar.querySelector("[data-nlbar-close]");
    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        bar.classList.remove("is-visible");
        try {
          window.localStorage.setItem("lemma_nlbar_dismissed", "1");
        } catch (e) {}
      });
    }
  })();
</script>
