              <select name="country">
                <option value="">{labels.fCountry}</option>
                {usedCountries.map((f) => <option value={f.slug}>{f[loc]}</option>)}
              </select>
            </label>
            <label><span class="sr">{labels.fIndustry}</span>
              <select name="industry">
                <option value="">{labels.fIndustry}</option>
                {usedIndustries.map((f) => <option value={f.slug}>{f[loc]}</option>)}
              </select>
            </label>
            <label><span class="sr">{labels.fOperation}</span>
              <select name="operation">
                <option value="">{labels.fOperation}</option>
                {usedOperations.map((f) => <option value={f.slug}>{f[loc]}</option>)}
              </select>
            </label>
            <label><span class="sr">{labels.fAttack}</span>
              <select name="attack">
                <option value="">{labels.fAttack}</option>
                {usedAttacks.map((f) => <option value={f.slug}>{f[loc]}</option>)}
              </select>
            </label>
            <label class="ix-q"><span class="sr">{labels.fKeyword}</span>
              <input type="search" name="q" placeholder={labels.fKeyword} />
            </label>
            <button type="submit">{labels.fGo}</button>
          </form>
          <div class="ix-list">
            {restLatest.map((b) => {
              const c = briefCardData(b);
              const meta = [c.publishedStr, industryLabel(b), attackLabel(b)].filter(Boolean).join(" · ");
              return (
                <a class="ix-row" href={c.href}>
                  <span class="ix-row-body">
                    <span class="ix-row-m">{countryLabel(b) && <span class="ix-ctry">{countryLabel(b)}</span>}{meta}</span>
                    <span class="ix-row-t">{shortTitle(b)}</span>
                    {b.data.impact && <span class="ix-row-i">{b.data.impact}</span>}
                  </span>
                  <span class="ix-arrow" aria-hidden="true">→</span>
                </a>
              );
            })}
          </div>
          <a class="cb-seeall" href={archiveHref}>
            <span>{labels.seeAll}</span>
            <span class="cb-seeall-arrow" aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {/* すべての Brief（アーカイブのみ・見出し行の右端に虫眼鏡の検索） */}
      {isArchive && (
      <section aria-label={labels.allBriefs}>
        <div class="cb-listhead ix-filter ix-filter--arc">
          <h2 class="ix-h">{labels.allBriefs} <span class="ix-h-n">{briefsCount}</span></h2>
          <label><span class="sr">{labels.fCountry}</span>
            <select data-facet="country">
              <option value="">{labels.fCountry}</option>
              {usedCountries.map((f) => <option value={f.slug}>{f[loc]}</option>)}
            </select>
          </label>
          <label><span class="sr">{labels.fIndustry}</span>
            <select data-facet="industry">
              <option value="">{labels.fIndustry}</option>
              {usedIndustries.map((f) => <option value={f.slug}>{f[loc]}</option>)}
            </select>
          </label>
          <label><span class="sr">{labels.fOperation}</span>
            <select data-facet="operation">
              <option value="">{labels.fOperation}</option>
              {usedOperations.map((f) => <option value={f.slug}>{f[loc]}</option>)}
            </select>
          </label>
          <label><span class="sr">{labels.fAttack}</span>
            <select data-facet="attack">
              <option value="">{labels.fAttack}</option>
              {usedAttacks.map((f) => <option value={f.slug}>{f[loc]}</option>)}
            </select>
          </label>
          <label><span class="sr">{labels.fControl}</span>
            <select data-facet="control">
              <option value="">{labels.fControl}</option>
              {controlTiles.map((c) => <option value={c.slug}>{c.label}</option>)}
            </select>
          </label>
          <label class="cb-search ix-q"><span class="sr">{labels.searchAria}</span>
            <input
              type="search"
              name="q"
              placeholder={labels.fKeyword}
              autocomplete="off"
            />
          </label>
        </div>
        <details class="ix-detail">
          <summary>{labels.detailCats}</summary>
          <div class="cb-threats--chips">
        {isArchive ? (
          <button type="button" class="cb-allpill is-active" data-cat="all">
            {labels.allChip} <i>{briefsCount}</i>
          </button>
        ) : (
          <a class="cb-allpill" href={archiveHref}>
            {labels.allChip} <i>{briefsCount}</i>
          </a>
        )}
        <div class="cb-distwrap">
          {sortedCategories.map(([cat, count]) => {
            const Tag = isArchive ? "button" : "a";
            const tagProps = isArchive
              ? { type: "button" as const }
              : { href: briefsCategoryHref(base, cat) };
            return (
            <Tag class="cb-dist" data-cat={cat} {...tagProps}>
              <span class="di">
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={CATEGORY_ICONS[cat] ?? DEFAULT_ICON}
                />
              </span>
              <span class="dn">{categoryLabel(cat, locale)}</span>
              <span class="db">
                <i style={`width:${Math.round((count / maxCategoryCount) * 100)}%`}></i>
              </span>
              <span class="dc">{count}</span>
            </Tag>
            );
          })}
        </div>
          </div>
        </details>

        {/* フィルタ中の件数と解除（月見出しの一覧はフィルタで隠れる）。 */}
        <div class="cb-fctx" data-filter-context hidden>
          <span data-fctx-label></span>
          <button type="button" data-fctx-clear>{labels.showAll}</button>
        </div>

        {monthGroups.map((g) => (
          <div class="cb-month" data-month>
            <div class="cb-mhead">
              <b>{g.label}</b>
              <span data-month-count>{labels.countUnit(g.briefs.length)}</span>
            </div>
            <div class="ix-list">
              {g.briefs.map((b) => {
                const c = briefCardData(b);
                const meta = [c.publishedStr, industryLabel(b), attackLabel(b)].filter(Boolean).join(" · ");
                return (
                  <a
                    href={c.href}
                    class="ix-row"
                    data-card
                    data-pillar={c.pillarParam}
                    data-cats={c.cats}
                    data-search={c.searchBlob}
                    data-industry={c.facetInd}
                    data-operation={c.facetOps}
                    data-attack={c.facetAttack}
                    data-country={c.facetCountry}
                    data-control={c.facetCtl}
