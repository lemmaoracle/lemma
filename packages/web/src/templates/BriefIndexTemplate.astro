---
/**
 * Lemma Critical Brief — shared Index template for /ja/ and /en/.
 *
 * モック `lemma_brief_index_mock_v5.html` の面
 * （`Lemma_コンテンツテンプレート_実装指示_v1_2026-07-30.md` §4）。
 *
 * 在庫が 130 本を超えたため、2026-08-21 から**面を2つに割った**。同じ
 * テンプレートを `variant` で切り替える（カード・トークン・CSS を1本に保つ）。
 *
 *   variant="latest"（既定・`/critical/briefs/`）
 *     ヒーロー → 脅威タイプで探す（アーカイブへのリンク）→ よく見られている
 *     → **最新 LATEST_COUNT 本をフラットに**（月見出しなし・タイトル一段大きく・
 *     カード間の余白を広げる）→「すべての Brief を見る（全 N 本）」。
 *     全件はここには出さない。
 *
 *   variant="archive"（`/critical/briefs/archive/`）
 *     旧一覧の月別 UI をそのまま移設。戻り導線 → 脅威タイプで探す（絞り込み
 *     ボタン）→ すべての Brief（右端に虫眼鏡の検索）→ 月見出し＋2列カード。
 *
 * やらないこと（§4.3）: カバー画像／冒頭の統計パネル／「読み方」ブロック。
 *
 * アーカイブは SSR で全件を出し（SEO と no-JS フォールバック、§4.4）、表示だけ
 * クライアント側で PAGE_SIZE 件ずつの**ページ送り**にする（2026-07-30 レビュー
 * での指示）。月見出しの件数はフィルタ後の月内総数、月の表示はそのページに
 * 1件でもあるかで決める——ページを跨ぐ月は次ページでも同じ見出しで続く。
 *
 * フィルタ・検索はクライアント側の progressive enhancement で、従来どおり
 * URL パラメータ（?category=<slug> / ?pillar=p1..p4 / ?q=<keyword>）を
 * 読み書きする——Brief 記事のタグや柱ページからの deep link を壊さない。
 * ただし**受け口はアーカイブ側**に移ったので、トップに旧クエリ付きで来た
 * 訪問者はアーカイブへ送る（`briefIndex.ts` 参照）。旧デザインのソート／
 * 密度切替は、月見出しの時系列一覧に役割を吸収されたので持たない。
 *
 * 並び順は **published（＝カードに出る日付）の降順**。`incident_date` は
 * 事案の発生日で、公開日と 124/133 本でずれる（例: No.126 は 2024-10-02）。
 * 事案日で並べるとカード上の日付と一致せず一覧が乱れて見えるので、表示日で
 * 並べる。番号が前後する（6月に 42/61 が混じる等）のは欠番の再利用と再編集の結果で、
 * 日付順が主というのが仕様。
 */
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/FooterRenewal.astro";
import { getTranslations, type Locale } from "../i18n/translations";
import {
  categoryLabel,
  type PillarSlug,
  type CategorySlug,
} from "../data/criticalBriefs";
import { getEnBriefMap } from "../data/getEnBriefMap";
import { BRIEF_PICKS } from "../config/briefPicks";
import {
  BRIEF_ATTACKS,
  BRIEF_CONTROLS,
  BRIEF_CONTROL_SLUGS,
  BRIEF_COUNTRIES,
  briefCountryLabel,
  BRIEF_INDUSTRIES,
  BRIEF_OPERATIONS,
  FACET_ICON_ATTRS,
  FACET_ICON_VIEWBOX,
  type BriefAttackSlug,
  type BriefIndustrySlug,
  type BriefOperationSlug,
} from "../config/briefFacets";
import { indexBannerFor } from "../config/briefServiceBanner";
import {
  LATEST_COUNT,
  briefsArchiveHref,
  briefsIndexHref,
  briefsCategoryHref,
} from "../data/briefIndex";

export interface BriefIndexTemplateProps {
  locale: Locale;
  /** "latest" = 一覧トップ（既定） / "archive" = 全件の月別アーカイブ */
  variant?: "latest" | "archive";
}

const { locale, variant = "latest" } = Astro.props as BriefIndexTemplateProps;
const t = getTranslations(locale);
const isJa = locale === "ja";
const isArchive = variant === "archive";
const base = isJa ? "/ja" : "";
const pagePath = isArchive
  ? "/critical/briefs/archive/"
  : "/critical/briefs/";
const indexHref = briefsIndexHref(base);
const archiveHref = briefsArchiveHref(base);

const PILLAR_PARAM: Record<PillarSlug, string> = {
  "01-verifiable-origin": "p1",
  "02-verifiable-ai": "p2",
  "03-agent-authority": "p3",
  "04-regulatory-attribute": "p4",
};

type AnyBrief =
  | CollectionEntry<"critical-briefs">
  | CollectionEntry<"critical-briefs-en">;

const allJaBriefs = await getCollection("critical-briefs");
const enById = isJa ? null : await getEnBriefMap();

const allBriefs: ReadonlyArray<AnyBrief> = allJaBriefs.map((ja) =>
  enById?.get(ja.id) ?? ja,
);

// Sort by published desc, breaking same-day ties on brief_no desc.
const briefsByPublishedDesc: ReadonlyArray<AnyBrief> = [...allBriefs].sort(
  (a, b) => {
    const diff = b.data.published.getTime() - a.data.published.getTime();
    if (diff !== 0) return diff;
    return b.data.brief_no - a.data.brief_no;
  },
);

// 月見出し（`2026年7月 · 6件`）ごとのグループ。published の降順のまま切る。
interface MonthGroup {
  key: string; // "2026-07"
  label: string;
  briefs: AnyBrief[];
}
const monthGroups: MonthGroup[] = [];
for (const b of briefsByPublishedDesc) {
  const d = b.data.published;
  const key = d.toISOString().slice(0, 7);
  let group = monthGroups[monthGroups.length - 1];
  if (!group || group.key !== key) {
    const y = d.getUTCFullYear();
    const m = d.getUTCMonth();
    const label = isJa
      ? `${y}年${m + 1}月`
      : `${["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"][m]} ${y}`;
    group = { key, label, briefs: [] };
    monthGroups.push(group);
  }
  group.briefs.push(b);
}

// 一覧トップに出す最新分（月見出しなしのフラットな新着順）。件数は
// `briefIndex.ts` の LATEST_COUNT 1箇所で調整する。
const latestBriefs = briefsByPublishedDesc.slice(0, LATEST_COUNT);

const briefById = new Map(allBriefs.map((b) => [b.id, b]));

/* ── 一覧トップ（2026-10-17・承認済みモック v6）────────────────────────
 * いま読む 3 本（config/briefPicks.ts）→ 対策から読む（4 タイル）＋点検の帯
 * → そのほかの新着（2 列・影響を言葉で）。脅威タイプ（13）と「よく見られて
 * いる」はトップから外した（脅威タイプ別ページは 90 日で計 2 PV）。脅威タイプ
 * の絞り込みはアーカイブ側に残す。 */
const loc = isJa ? "ja" : "en";
const attackLabel = (b: AnyBrief): string | null => {
  const a = b.data.attack_method as BriefAttackSlug | undefined;
  return a ? BRIEF_ATTACKS[a][loc] : null;
};
const industryLabel = (b: AnyBrief): string | null => {
  const i = (b.data.industries as BriefIndustrySlug[] | undefined)?.[0];
  return i ? BRIEF_INDUSTRIES[i][loc] : null;
};
const countryLabel = (b: AnyBrief): string | null =>
  briefCountryLabel(b.data.countries as string[] | undefined, loc);
const shortTitle = (b: AnyBrief): string => {
  const lead = isJa ? b.data.og_lead_ja : b.data.og_lead_en;
  return lead ?? (isJa ? b.data.title : b.data.title_en).split(" — ")[0];
};
const takeawayOf = (b: AnyBrief): string => {
  if (b.data.takeaway) return b.data.takeaway as string;
  const tail = (isJa ? b.data.title : b.data.title_en).split(" — ")[1];
  return tail ?? "";
};
const pickBriefs = BRIEF_PICKS.map((id) => briefById.get(id)).filter(
  (b): b is AnyBrief => Boolean(b),
);
const pickIds = new Set(pickBriefs.map((b) => b.id));
const restLatest = briefsByPublishedDesc
  .filter((b) => !pickIds.has(b.id))
  .slice(0, LATEST_COUNT);
const controlTiles = BRIEF_CONTROL_SLUGS.map((slug) => ({
  slug,
  label: BRIEF_CONTROLS[slug][loc],
  icon: BRIEF_CONTROLS[slug].icon,
  count: allBriefs.filter((b) =>
    ((b.data.controls as { slug: string }[] | undefined) ?? []).some((c) => c.slug === slug),
  ).length,
  href: `${archiveHref}?control=${slug}`,
}));
const indexBanner = indexBannerFor(locale);
/* 一覧の絞り込み（業界・業務・手口）で出す候補。タグの付いた Brief がある値だけ。 */
const usedIndustries = Object.values(BRIEF_INDUSTRIES).filter((f) =>
  allBriefs.some((b) => (b.data.industries as string[] | undefined)?.includes(f.slug)),
);
const usedOperations = Object.values(BRIEF_OPERATIONS).filter((f) =>
  allBriefs.some((b) => (b.data.operations as string[] | undefined)?.includes(f.slug)),
);
const usedAttacks = Object.values(BRIEF_ATTACKS).filter((f) =>
  allBriefs.some((b) => b.data.attack_method === f.slug),
);
const usedCountries = Object.values(BRIEF_COUNTRIES).filter((f) =>
  allBriefs.some((b) => (b.data.countries as string[] | undefined)?.includes(f.slug)),
);
/* アーカイブの絞り込み表示用のラベル（?industry= 等の値 → 表示名）。 */
const facetLabels: Record<string, string> = {};
for (const f of Object.values(BRIEF_INDUSTRIES)) facetLabels[`industry:${f.slug}`] = f[loc];
for (const f of Object.values(BRIEF_OPERATIONS)) facetLabels[`operation:${f.slug}`] = f[loc];
for (const f of Object.values(BRIEF_ATTACKS)) facetLabels[`attack:${f.slug}`] = f[loc];
for (const f of Object.values(BRIEF_COUNTRIES)) facetLabels[`country:${f.slug}`] = f[loc];
for (const slug of BRIEF_CONTROL_SLUGS) facetLabels[`control:${slug}`] = BRIEF_CONTROLS[slug][loc];

// Category usage: count primary + secondary occurrences across all Briefs.
const categoryUsage = new Map<CategorySlug, number>();
for (const b of allBriefs) {
  const prim = b.data.primary_category as CategorySlug;
  categoryUsage.set(prim, (categoryUsage.get(prim) ?? 0) + 1);
  for (const sc of b.data.secondary_categories) {
    const cat = sc as CategorySlug;
    categoryUsage.set(cat, (categoryUsage.get(cat) ?? 0) + 1);
  }
}
const sortedCategories = Array.from(categoryUsage.entries()).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const maxCategoryCount = sortedCategories[0]?.[1] ?? 1;

const briefsCount = allBriefs.length;
/**
 * 公開実数（briefsCount）と最新の番号は一致しないことがある。
 * 「全 133 本 / 最新 No.135」のように**分けて**出し、どちらかで他方を
 * 代弁させない。「最新」は最も新しく公開された Brief の番号——欠番を
 * 再利用するので、最大の番号とは限らない。
 */
const latestBriefNo = briefsByPublishedDesc[0]?.data.brief_no ?? 0;

/**
 * 脅威タイプの 16px ラインアイコン（モックのものをカテゴリ slug に対応）。
 * `model-supply-chain` と `agent-payment-abuse` はモックの一覧に無いので
 * 同じ線の言語（1.3px・round）で補作。未登録は既定の円。
 */
const CATEGORY_ICONS: Partial<Record<CategorySlug, string>> = {
  "identity-auth": '<circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="2.4"/>',
  "agent-infrastructure":
    '<circle cx="4" cy="5" r="1.8"/><circle cx="12" cy="5" r="1.8"/><circle cx="8" cy="12" r="1.8"/><path d="M5.4 6.2 7 10.4M10.6 6.2 9 10.4M5.8 5h4.4"/>',
  "attribute-proof-bypass":
    '<rect x="2.5" y="3.5" width="11" height="9" rx="2.5" stroke-dasharray="2.6 2.2"/><path d="M4 12.5 12 3.5"/>',
  "data-provenance":
    '<circle cx="3" cy="8" r="1.6"/><circle cx="8" cy="8" r="1.6"/><path d="M4.8 8h1.4M9.8 8h1.6"/><path d="M11.6 5.6 14 8l-2.4 2.4"/>',
  "ai-decision-integrity":
    '<path d="M2 8.5c1.6 0 1.6-4 3.2-4s1.6 7 3.2 7 1.6-5 3.2-5 1.6 2 2.4 2"/>',
  "code-provenance": '<path d="M5.6 4.5 2.5 8l3.1 3.5M10.4 4.5 13.5 8l-3.1 3.5"/>',
  "bridge-config-trust":
    '<circle cx="3" cy="8" r="1.7"/><circle cx="13" cy="8" r="1.7"/><path d="M4.9 8h6.2" stroke-dasharray="2.4 2"/>',
  "agent-runaway":
    '<rect x="2.5" y="4" width="7" height="8" rx="2"/><path d="M9.6 8h4M11.8 6.2 13.8 8l-2 1.8"/>',
  "training-data-provenance":
    '<path d="M2.6 5.4 8 3l5.4 2.4L8 7.8z"/><path d="M2.6 8.6 8 11l5.4-2.4M2.6 11.4 8 13.8l5.4-2.4"/>',
  "kyc-aml-disclosure":
    '<circle cx="8" cy="8" r="5.6"/><path d="M8 2.4v11.2"/><path d="M8 2.4a5.6 5.6 0 0 1 0 11.2z" fill="currentColor" stroke="none" opacity=".22"/>',
  "ai-bias-harm":
    '<path d="M8 2.6v10.8M3 6.4h10"/><path d="M3 6.4 1.4 10h3.2zM13 6.4 11.4 10h3.2z"/>',
  "model-supply-chain":
    '<rect x="2.5" y="2.5" width="4.6" height="4.6" rx="1.2"/><rect x="8.9" y="8.9" width="4.6" height="4.6" rx="1.2"/><path d="M7.1 4.8h4.1v4.1M8.9 11.2H4.8V7.1"/>',
  "agent-payment-abuse":
    '<circle cx="6.5" cy="8" r="4.5"/><path d="M4.7 6.6 6.5 8.6l1.8-2M6.5 8.6v2.4M5 9.8h3M12 5.5 14.5 8 12 10.5"/>',
};
const DEFAULT_ICON = '<circle cx="8" cy="8" r="6"/>';

// Per-card derived data (one source of truth)
function briefCardData(b: AnyBrief) {
  const titleLoc = isJa ? b.data.title : b.data.title_en;
  const mainTitle = titleLoc.split(" — ")[0];
  const publishedStr = b.data.published.toISOString().slice(0, 10);
  const briefNoPad = String(b.data.brief_no).padStart(3, "0");
  const pillar = b.data.pillar as PillarSlug;
  const primarySlug = b.data.primary_category as CategorySlug;
  const secondarySlugs = b.data.secondary_categories as CategorySlug[];
  const primaryCatLabel = categoryLabel(primarySlug, locale);
  const secondaryCatLabels = secondarySlugs.map((c) =>
    categoryLabel(c as CategorySlug, locale),
  );
  const cats = [primarySlug, ...secondarySlugs].join(",");
  const searchBlob = [
    mainTitle,
    briefCountryLabel(b.data.countries as string[] | undefined, loc) ?? "",
    primaryCatLabel,
    ...secondaryCatLabels,
    `no${briefNoPad}`,
    `no.${briefNoPad}`,
  ]
    .join(" ")
    .toLowerCase();
  return {
    href: `${base}/critical/briefs/${b.id}/`,
    briefNoPad,
    briefNo: b.data.brief_no,
    publishedStr,
    dateShort: publishedStr.slice(5), // "07-28"
    pillarParam: PILLAR_PARAM[pillar],
    mainTitle,
    primarySlug,
    primaryCatLabel,
    cats,
    searchBlob,
    facetInd: ((b.data.industries as string[] | undefined) ?? []).join(","),
    facetOps: ((b.data.operations as string[] | undefined) ?? []).join(","),
    facetAttack: (b.data.attack_method as string | undefined) ?? "",
    facetCountry: ((b.data.countries as string[] | undefined) ?? []).join(","),
    facetCtl: ((b.data.controls as { slug: string }[] | undefined) ?? [])
      .map((c) => c.slug)
      .join(","),
  };
}

const labels = isJa
  ? {
      eyebrow: "Lemma Critical Brief",
      heroH1: "攻撃と事故の構造を読む",
      heroDesc:
        "実際に起きたサイバー攻撃と事故を公表資料から読み解き、何が欠けていたか、どう防ぐかまでを整理する解説レポートです。",
      picks: "いま読む 3 本",
      controlsH: "対策から読む",
      controlCount: (n: number) => `解説 ${n} 本`,
      restH: "そのほかの新着",
      readMore: "読む",
      fCountry: "国・地域",
      fIndustry: "業界",
      fOperation: "業務",
      fAttack: "手口",
      fControl: "対策",
      detailCats: "詳細分類（脅威タイプ）",
      fAny: "すべて",
      fKeyword: "キーワード",
      fGo: "絞り込む",
      h1Lead: "脅威インテリジェンス ×",
      h1Accent: "信頼インフラ。",
      descLead:
        "AI・暗号インフラ・サプライチェーン・規制属性領域で起きた重大事案を、Lemma が構造的に解析。各 Brief は「検出と証明の落差」を明示し、",
      descStrong: "リスク評価・規制対応・信頼インフラ設計",
      descEnd: "に活用できるリファレンス集です。",
      rssLabel: "RSS フィード",
      methodologyLabel: "メソドロジー",
      threatTypes: "脅威タイプで探す",
      threatTypesEn: `Threat Types · ${sortedCategories.length}`,
      popular: "よく見られている",
      popularEn: "Popular",
      allBriefs: "すべての Brief",
      allChip: "すべて",
      searchPlaceholder: "絞り込む",
      searchAria: "Brief を絞り込む",
      countUnit: (n: number) => `${n} 件`,
      noResults: "該当する Brief が見つかりませんでした。",
      showAll: "すべて表示",
      latest: "最新の Brief",
      latestEn: `Latest · ${LATEST_COUNT}`,
      seeAll: `すべての Brief を見る（全 ${briefsCount} 本）`,
      backToLatest: "最新の Brief へ戻る",
      archiveH1: "Brief アーカイブ",
      archiveMeta: `全 ${briefsCount} 本 · 最新は No.${latestBriefNo} · 公開月順`,
      pageTitle: "Lemma Critical Brief — 攻撃と事故の構造を読む",
      description:
        "実際に起きたサイバー攻撃と事故を公表資料から読み解き、何が欠けていたか、どう防ぐかまでを整理する解説レポート。業界・手口・対策から探せる。",
      archivePageTitle: `Brief アーカイブ（全 ${briefsCount} 本）— Lemma Critical Brief`,
      archiveDescription: `Lemma Critical Brief の全 ${briefsCount} 本を公開月ごとに一覧。AI・暗号インフラ・サプライチェーン・規制属性領域の重大事案を、脅威タイプとキーワードで絞り込める。`,
    }
  : {
      eyebrow: "Lemma Critical Brief",
      heroH1: "How attacks and accidents get through",
      heroDesc:
        "Real cyber attacks and incidents, read from public disclosures: what was missing, and how to counter it.",
      picks: "Read now",
      controlsH: "Browse by control",
      controlCount: (n: number) => `${n} brief${n === 1 ? "" : "s"}`,
      restH: "More recent briefs",
      readMore: "Read",
      fCountry: "Country",
      fIndustry: "Industry",
      fOperation: "Operation",
      fAttack: "Attack method",
      fControl: "Control",
      detailCats: "Detailed classification (threat type)",
      fAny: "All",
      fKeyword: "Keyword",
      fGo: "Filter",
      h1Lead: "threat intelligence ×",
      h1Accent: "trust infrastructure.",
      descLead:
        "Lemma's structured analysis of major incidents across AI, cryptographic infrastructure, supply chains, and regulated attributes. Each Brief makes the gap between detection and proof explicit — a reference for ",
      descStrong:
        "risk assessment, regulatory response, and trust-infrastructure design",
      descEnd: ".",
      rssLabel: "RSS feed",
      methodologyLabel: "Methodology",
      threatTypes: "Browse by threat type",
      threatTypesEn: `Threat Types · ${sortedCategories.length}`,
      popular: "Most-read",
      popularEn: "Popular",
      allBriefs: "All Briefs",
      allChip: "All",
      searchPlaceholder: "Filter",
      searchAria: "Filter Briefs",
      countUnit: (n: number) => `${n} brief${n === 1 ? "" : "s"}`,
      noResults: "No Briefs matched your filters.",
      showAll: "Show all",
      latest: "Latest Briefs",
      latestEn: `Latest · ${LATEST_COUNT}`,
      seeAll: `Browse all ${briefsCount} Briefs`,
      backToLatest: "Back to the latest Briefs",
      archiveH1: "Brief archive",
      archiveMeta: `${briefsCount} Briefs · latest No.${latestBriefNo} · by month of publication`,
      pageTitle: "Lemma Critical Brief — how attacks and accidents get through",
      description:
        "Real cyber attacks and incidents, read from public disclosures: what was missing, and how to counter it. Browse by industry, attack method or control.",
      archivePageTitle: `Brief archive (all ${briefsCount}) — Lemma Critical Brief`,
      archiveDescription: `All ${briefsCount} Lemma Critical Briefs, grouped by month of publication. Major incidents across AI, cryptographic infrastructure, supply chains, and regulated attributes — filter by threat type or search by keyword.`,
    };

const rssHref = `${base}/critical/briefs/feed.xml`;
const methodologyHref = `${base}/critical/briefs/methodology/`;
---

<Layout
  locale={locale}
  metaType="page"
  pagePath={pagePath}
  title={isArchive ? labels.archivePageTitle : labels.pageTitle}
  description={isArchive ? labels.archiveDescription : labels.description}
>
  <Navigation locale={locale} t={t.nav} base={base} />

  <main class="cb-page" data-variant={variant} data-archive-href={archiveHref} data-facet-labels={JSON.stringify(facetLabels)}>
    <div class="cb-wrap">
      {/* Hero — アーカイブ側は戻り導線つきの簡素版 */}
      {isArchive ? (
        <section class="cb-hero cb-hero--archive">
          <a class="cb-back" href={indexHref}>
            <span aria-hidden="true">←</span> {labels.backToLatest}
          </a>
          <h1>{labels.archiveH1}</h1>
          <p class="cb-archive-meta">{labels.archiveMeta}</p>
        </section>
      ) : (
        <section class="cb-hero">
          <div class="cb-kicker">{labels.eyebrow}</div>
          <h1>{labels.heroH1}</h1>
          <p>{labels.heroDesc}</p>
          <div class="cb-acts">
            <a href={rssHref}>{labels.rssLabel}</a>
            <a href={methodologyHref}>{labels.methodologyLabel}</a>
          </div>
        </section>
      )}

      {/* 日本語だけ：業務別のセルフチェック（LP）への入口（2026-10-24）。 */}
      {isJa && !isArchive && (
        <a class="ix-self" href="/ja/critical/self-check/">
          <span class="ix-self-k">無料・登録不要</span>
          <b>実際に起きた手口が、自社で通らないか。業務別セルフチェック</b>
          <span class="ix-self-go">始める →</span>
        </a>
      )}

      {/* 脅威タイプで探す。
          トップ = 2列・件数の横バー（アーカイブへのリンク）。
          アーカイブ = 横並びの小さいチップ（絞り込みボタン）。同じ面が2枚続くと
          「遷移した感じ」が出ないので、アーカイブ側は畳んで一覧を上に出す。 */}
      {!isArchive && pickBriefs.length > 0 && (
        <section class="ix-picks" aria-label={labels.picks}>
          <h2 class="ix-h">{labels.picks}</h2>
          <div class="ix-picks-grid">
            {pickBriefs.map((b, i) => {
              const c = briefCardData(b);
              const ind = industryLabel(b);
              const atk = attackLabel(b);
              const ctry = countryLabel(b);
              return (
                <a class="ix-pick" href={c.href}>
                  <div class={`ix-cover ix-cover--${i % 3}`}>
                    <span class="ix-cover-meta">
                      {ctry && <span class="ix-ctry ix-ctry--dark">{ctry}</span>}
                      {ind && <b>{ind}</b>}{ind && atk && " · "}{atk}
                    </span>
                    {b.data.impact && <span class="ix-cover-impact">{b.data.impact}</span>}
                  </div>
                  <span class="ix-pick-t">{shortTitle(b)}</span>
                  <span class="ix-pick-w">{takeawayOf(b)}</span>
                  <span class="ix-more">{labels.readMore}<span aria-hidden="true"> →</span></span>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {!isArchive && (
        <section class="ix-controls" aria-label={labels.controlsH}>
          <h2 class="ix-h">{labels.controlsH}</h2>
          <div class="ix-ctl-grid">
            {controlTiles.map((c) => (
              <a class="ix-ctl" href={c.href} data-index-ev="brief_index_control_click" data-cta={c.slug}>
                <span class="ix-ctl-ic">
                  <svg viewBox={FACET_ICON_VIEWBOX} {...FACET_ICON_ATTRS} aria-hidden="true" set:html={c.icon} />
                </span>
                <span class="ix-ctl-tx">
                  <b>{c.label}</b>
                  <span>{labels.controlCount(c.count)}</span>
                </span>
                <span class="ix-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          <aside class="ix-banner" aria-label={indexBanner.label} data-index-banner>
            <span class="ix-banner-pr">PR</span>
            <span class="ix-banner-tx">
              <span class="ix-banner-k">{indexBanner.label}</span>
              <b>{indexBanner.head}</b>
              <span class="ix-banner-b">{indexBanner.body}</span>
            </span>
            <a class="ix-banner-btn" href={indexBanner.href} target="_blank" rel="noopener" data-index-ev="brief_index_banner_click" data-cta="index_banner">{indexBanner.button}</a>
