            <p class="hp-schema-can"><strong>{C.canLabel}</strong> {p.can}</p>
            <p class="hp-schema-where"><span class="k">{C.whereLabel}</span> {p.where}</p>
            <div class="hp-schema-rows">
              {p.rows.map((r) => (
                <div class="hp-schema-row"><span>{r.l}</span><span class="hp-schema-row-val">{r.v}</span></div>
