---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import CtaSection from "../components/CtaSection.astro";
import HeroCover from "../assets/cover.jpg";

export interface IndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  description: string;
  recentPosts: ReadonlyArray<{
    readonly category: string;
    readonly date: string;
    readonly title: string;
    readonly slug: string;
  }>;
}

const { locale, t, base, description, recentPosts } = Astro.props as IndexTemplateProps;
const ix = t.index;

const pillarsOverviewHref = base ? `${base}/pillars/` : "/pillars/";
const docsHref = base ? `${base}/guides/` : "/guides/";
const trust402Href = "/trust402/";
const blogIndexHref = `${base}/blog/`;
const thinking = recentPosts.slice(0, 6);
---

<Layout locale={locale} metaType="home" description={description}>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main>
    <!-- ─── HERO ─── -->
    <section class="hero">
      <img
        class="hero-bg"
        id="heroBg"
        src={HeroCover.src}
        alt=""
        width={HeroCover.width}
        height={HeroCover.height}
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-overlay"></div>
      <div class="hero-content" id="heroContent">
        <div class="hero-eyebrow">{ix.hero.eyebrow}</div>
        <h1 class="hero-h1">{ix.hero.h1}</h1>
        <p class="hero-sub">{ix.hero.sub}</p>
        <div class="hero-cta-row">
          <a href={pillarsOverviewHref} class="btn btn-primary">{ix.hero.primaryCta} <span aria-hidden="true">→</span></a>
          <a href={docsHref} class="btn btn-ghost">{ix.hero.secondaryCta}</a>
        </div>
      </div>
    </section>

    <!-- ─── TRUST LAYER (Section 2: D-diagram, 4 modules over the trust-layer bar) ─── -->
    <section class="trust-layer-section">
      <div class="trust-layer-inner reveal">
        <div class="trust-layer-eyebrow">{ix.trustLayer.eyebrow}</div>
        <h2 class="trust-layer-h2">{ix.trustLayer.h2}</h2>

        <div class="tl-diagram">
          <div class="tl-modules">
            {[ix.trustLayer.modules.origin, ix.trustLayer.modules.ai, ix.trustLayer.modules.authority, ix.trustLayer.modules.regulatory].map((m) => (
              <a href={`${base}${m.href}`} class="tl-module">
                <div class="tl-module-title">{m.title}</div>
                <p class="tl-module-desc">{m.desc}</p>
                <div class="tl-module-tech">{m.tech}</div>
              </a>
            ))}
          </div>
          <div class="tl-bar" aria-hidden="true">
            <span class="tl-bar-label">{ix.trustLayer.barLabel}</span>
          </div>
          <div class="tl-bar-foot">{ix.trustLayer.barFoot}</div>
        </div>
      </div>
    </section>

    <!-- ─── FEATURED PANEL (Trust402) ─── -->
    <section id="featured" class="featured">
      <a class="featured-panel reveal" href={trust402Href}>
        <div class="featured-content">
          <div class="featured-eyebrow">{ix.featured.eyebrow}</div>
          <h2 class="featured-title">{ix.featured.title}</h2>
          <p class="featured-subtitle">{ix.featured.subtitle}</p>
          <span class="featured-cta">{ix.featured.cta} <span aria-hidden="true">→</span></span>
        </div>
        <div class="featured-visual" aria-hidden="true"></div>
      </a>
    </section>

    <!-- ─── INDUSTRY APPLICATIONS (Section 3 — audience use-case cards) ─── -->
    <section class="for-x">
      <div class="for-x-inner reveal">
        <div class="for-x-eyebrow">{ix.lemmaFor.eyebrow}</div>
        <h2 class="for-x-h2">{ix.lemmaFor.h2Line1}<br/>{ix.lemmaFor.h2Line2}</h2>
        <p class="for-x-lead">{ix.lemmaFor.lead}</p>

        <div class="for-x-grid">
          {ix.lemmaFor.cards.map((card) => (
            <a class="for-x-card" href={card.href}>
              <div class="for-x-card-content">
                <div class="for-x-card-tag">{card.tag}</div>
                <h3 class="for-x-card-title">{card.titleLine1}<br/>{card.titleLine2}</h3>
                <p class="for-x-card-body">{card.body}</p>
                <div class="for-x-card-cases">{card.cases}</div>
              </div>
              <span class="for-x-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="for-x-see-all">
          <a class="for-x-see-all-link" href={ix.lemmaFor.seeAllHref}>{ix.lemmaFor.seeAll}</a>
        </div>
      </div>
    </section>

    <!-- ─── NOW BANNER (Mythos / pre-execution attestation context) ─── -->
    <section class="now-banner">
      <div class="now-banner-inner reveal">
        <div class="now-banner-eyebrow">{ix.nowBanner.eyebrow}</div>
        <p class="now-banner-text">{ix.nowBanner.text}</p>
        <a class="now-banner-link" href={ix.nowBanner.href}>{ix.nowBanner.cta} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ─── RECENT THINKING ─── -->
    <section class="thinking">
      <div class="thinking-inner reveal">
        <div>
          <h2 class="thinking-title">{ix.thinking.title}</h2>
          <p class="thinking-lead">{ix.thinking.lead}</p>
          <a class="thinking-see-all" href={blogIndexHref}>{ix.thinking.seeAll}</a>
        </div>
        <div class="thinking-list">
          {thinking.map((post) => (
            <a class="thinking-item" href={`${base}/blog/${post.slug}/`}>
              <span class="thinking-item-title">{post.title}</span>
              <span class="thinking-item-meta">{post.date}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── PARTNER PROGRAM / DISCOVERY CALL CTA ─── -->
    <div id="contact">
      <CtaSection bgImageSrc={HeroCover.src} base={base} locale={locale} />
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* Cormorant Garamond (display) is kept; h1/h2/h3 use --font-display. */
  main { color: var(--gray-800, #1A1A1A); }

  /* ─── BUTTONS ─── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: background 0.25s ease, color 0.25s ease;
    cursor: pointer;
    text-decoration: none;
  }
  .btn-primary { background: #fff; color: #000; }
  .btn-primary:hover { background: var(--accent); color: #fff; }
  .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .btn-ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: 160px 8% 100px;
    overflow: hidden;
    background: var(--black);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.7) brightness(0.9);
    transform: scale(1.04);
    transition: transform 10s ease-out;
  }
  .hero-bg.ready { transform: scale(1); }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 980px;
    margin: 0 auto;
    width: 100%;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.95s ease, transform 0.95s ease;
  }
  .hero-content.visible { opacity: 1; transform: translateY(0); }
  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #B8723A;
    margin-bottom: 22px;
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 6.5vw, 72px);
    font-weight: 500;
    color: #fff;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.25vw, 18px);
    color: rgba(255,255,255,0.78);
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 640px;
  }
  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ─── TRUST LAYER SECTION (D-diagram) ─── */
  .trust-layer-section {
    background: #fff;
    border-top: 8px solid #000;
    padding: 72px 5% 80px;
  }
  .trust-layer-inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .trust-layer-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent, #8B4513);
    margin-bottom: 18px;
  }
  .trust-layer-h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 500;
    color: #1A1A1A;
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0 0 44px;
    max-width: 880px;
  }
  .tl-diagram {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .tl-modules {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 14px;
  }
  .tl-module {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.12);
    border-top: 2px solid var(--accent, #8B4513);
    padding: 22px 20px 24px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .tl-module:hover {
    border-color: rgba(0,0,0,0.32);
    border-top-color: var(--accent, #8B4513);
    box-shadow: 0 6px 24px rgba(0,0,0,0.06);
    transform: translateY(-2px);
  }
  .tl-module-title {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: #1A1A1A;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .tl-module-desc {
    font-family: var(--font-body);
    font-size: 13px;
    color: rgba(0,0,0,0.65);
    line-height: 1.5;
    margin: 0 0 16px;
    flex: 1;
  }
  .tl-module-tech {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    color: rgba(0,0,0,0.45);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
  .tl-bar {
    background: #000;
    color: #fff;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tl-bar-label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #fff;
  }
  .tl-bar-foot {
    margin-top: 10px;
    font-family: var(--font-body);
    font-size: 11px;
    color: rgba(0,0,0,0.45);
    letter-spacing: 0.02em;
    text-align: center;
  }
  @media (max-width: 900px) {
    .tl-modules { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .trust-layer-section { padding: 56px 6% 64px; }
    .tl-modules { grid-template-columns: 1fr; gap: 12px; }
    .tl-bar-label { letter-spacing: 0.2em; font-size: 11px; }
  }

  /* ─── FEATURED PANEL ─── */
  .featured {
    background: var(--white);
    padding: 60px 8% 60px;
  }
  .featured-panel {
    max-width: 1280px;
    margin: 0 auto;
    background: #000;
    color: #fff;
    overflow: hidden;
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: 480px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
  }
  .featured-panel:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
  }
  .featured-content {
    padding: 72px 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-eyebrow {
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: #fff;
    margin-bottom: 22px;
  }
  .featured-subtitle {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.1vw, 16px);
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 420px;
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #000;
    padding: 12px 28px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: flex-start;
    transition: all 0.25s ease;
  }
  .featured-panel:hover .featured-cta {
    background: var(--accent);
    color: #fff;
  }
  .featured-visual {
    position: relative;
    overflow: hidden;
    background: #000;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }
  .featured-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px, 48px 48px;
    pointer-events: none;
  }
  .featured-visual::after {
    content: "x402";
    position: absolute;
    right: 48px;
    bottom: 36px;
    font-family: var(--font-body);
    font-size: clamp(72px, 12vw, 160px);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.07);
    letter-spacing: -0.03em;
    line-height: 1;
    pointer-events: none;
  }
  @media (max-width: 900px) {
    .featured-panel { grid-template-columns: 1fr; min-height: auto; }
    .featured-content { padding: 56px 40px 40px; }
    .featured-visual { height: 280px; }
    .featured-visual::after { right: 28px; bottom: 24px; }
  }

  /* ─── NOW BANNER ─── */
  .now-banner {
    background: var(--gray-50);
    padding: 48px 8%;
    border-top: 1px solid var(--gray-200);
    border-bottom: 1px solid var(--gray-200);
  }
  .now-banner-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .now-banner-eyebrow {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .now-banner-eyebrow::before {
    content: "";
    width: 18px;
    height: 1px;
    background: currentColor;
    display: block;
  }
  .now-banner-text {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--gray-800);
    margin: 0 0 18px;
    max-width: 760px;
  }
  .now-banner-link {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.25s;
  }
  .now-banner-link:hover { gap: 12px; }

  /* ─── INDUSTRY APPLICATIONS (audience cards) ─── */
  .for-x {
    background: var(--gray-50);
    padding: 140px 8%;
  }
  .for-x-inner { max-width: 1200px; margin: 0 auto; }
  .for-x-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent, #8B4513);
    margin-bottom: 18px;
  }
  .for-x-h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 500;
    color: var(--gray-800);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 24px;
    max-width: 700px;
  }
  .for-x-lead {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 80px;
    max-width: 620px;
  }
  .for-x-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .for-x-card {
    background: #fff;
    border-top: 2px solid var(--accent);
    padding: 48px 40px 40px;
    transition: background 0.25s ease, transform 0.25s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 280px;
    text-decoration: none;
    color: inherit;
  }
  .for-x-card:hover {
    background: var(--accent-bg);
    transform: translateY(-2px);
  }
  .for-x-card-tag {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .for-x-card-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--gray-800);
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }
  .for-x-card-body {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 32px;
  }
  .for-x-card-cases {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 13px;
    line-height: 1.85;
    margin-bottom: 28px;
    border-top: 1px solid var(--gray-200);
    padding-top: 20px;
  }
  .for-x-card-arrow {
    color: var(--gray-500);
    font-size: 18px;
    align-self: flex-end;
    transition: color 0.25s, transform 0.25s;
  }
  .for-x-card:hover .for-x-card-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
  .for-x-see-all {
    margin-top: 40px;
    text-align: center;
  }
  .for-x-see-all-link {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.25s;
  }
  .for-x-see-all-link:hover { gap: 12px; }
  @media (max-width: 1024px) {
    .for-x-grid { grid-template-columns: 1fr; }
  }

  /* ─── RECENT THINKING ─── */
  .thinking {
    background: var(--gray-50);
    padding: 140px 8%;
  }
  .thinking-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 80px;
    align-items: start;
  }
  .thinking-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 38px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--gray-800);
    margin-bottom: 16px;
  }
  .thinking-lead {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .thinking-see-all {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .thinking-list {
    display: flex;
    flex-direction: column;
  }
  .thinking-item {
    padding: 28px 0;
    border-bottom: 1px solid var(--gray-200);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.25s;
  }
  .thinking-item:hover { padding-left: 12px; }
  .thinking-item:first-child { padding-top: 0; }
  .thinking-item:last-child { border-bottom: none; }
  .thinking-item-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--gray-800);
    letter-spacing: -0.005em;
  }
  .thinking-item-meta {
    font-family: var(--font-body);
    color: var(--gray-500);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .thinking-inner { grid-template-columns: 1fr; gap: 40px; }
  }

  /* ─── REVEAL ─── */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.on { opacity: 1; transform: translateY(0); }

  /* ─── MOBILE ─── */
  @media (max-width: 640px) {
    .hero { padding: 140px 6% 80px; }
    .featured { padding: 32px 6%; }
    .featured-content { padding: 36px 24px 28px; }
    .featured-title { font-size: clamp(34px, 9vw, 44px); margin-bottom: 14px; }
    .featured-subtitle { margin-bottom: 28px; }
    .featured-visual { height: 160px; }
    .now-banner { padding: 32px 6%; }
    .for-x { padding: 100px 6%; }
    .thinking { padding: 100px 6%; }
  }
</style>

<script is:inline>
  window.addEventListener("load", function () {
    var bg = document.getElementById("heroBg");
    var content = document.getElementById("heroContent");
    if (bg) bg.classList.add("ready");
    setTimeout(function () { if (content) content.classList.add("visible"); }, 150);
  });

  var io = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("on");
        io.unobserve(entry.target);
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
  );

  document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });
</script>
