  .hp-mech-halo {
    transform-origin: center;
    transform-box: fill-box;
    animation: hp-mech-halo 3s ease-out infinite;
  }
  .hp-mech-halo--delay { animation-delay: 1.5s; }
  @keyframes hp-mech-halo {
    0% { opacity: 0.55; transform: scale(1); }
