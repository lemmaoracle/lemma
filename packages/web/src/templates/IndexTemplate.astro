  .hp-accent-light { color: var(--hp-brown-light); }

  /* HERO */
  .hp-hero { max-width: 1320px; margin: 0 auto; padding: 96px 40px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 80px; align-items: center; }
  .hp-hero h1 { font-family: var(--hp-display); font-size: 76px; line-height: 1.04; letter-spacing: -0.035em; color: #000; margin: 0 0 28px; font-weight: 600; }
  .hp-hero-sub { font-size: 17px; line-height: 1.8; color: var(--hp-text-2); margin: 0 0 40px; max-width: 520px; }
  .hp-hero-sub-chord { color: var(--hp-text-3); }
  .hp-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hp-btn-primary { background: #000; color: var(--hp-cream); padding: 14px 26px; border-radius: 999px; font-family: var(--hp-display); font-size: 14px; font-weight: 500; transition: background 0.15s; }
  .hp-btn-primary:hover { background: var(--hp-brown); }
  .hp-btn-secondary { background: transparent; color: var(--hp-text-1); padding: 14px 26px; border: 0.5px solid var(--hp-text-1); border-radius: 999px; font-family: var(--hp-display); font-size: 14px; font-weight: 500; transition: all 0.15s; }
  .hp-btn-secondary:hover { background: var(--hp-cream-d); border-color: var(--hp-brown); color: var(--hp-brown); }

  .hp-hero-visual { background: var(--hp-code-bg); border-radius: 16px; padding: 24px; box-shadow: 0 30px 70px rgba(43, 30, 18, 0.18); overflow: hidden; min-width: 0; }
  .hp-term-chrome { display: flex; align-items: center; gap: 6px; margin-bottom: 18px; }
  .hp-term-chrome span:not(.hp-term-label) { width: 11px; height: 11px; border-radius: 50%; background: #3a3530; flex-shrink: 0; display: inline-block; }
  .hp-term-label { margin-left: 12px; font-family: var(--hp-mono); font-size: 10.5px; color: #6a655d; letter-spacing: 0.08em; }
  .hp-term-body { font-family: var(--hp-mono); font-size: 12.5px; line-height: 1.95; color: var(--hp-code-text); }
  .hp-term-line { display: block; opacity: 0; animation: hp-term 0.45s ease forwards; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hp-term-line .hp-prompt { color: var(--hp-brown-light); }
  .hp-term-line .hp-cmd { color: #f5ebdc; }
  .hp-term-line .hp-ok { color: #6ec27a; }
  .hp-term-line .hp-key { color: #d4a574; }
  .hp-term-line .hp-str { color: #9ec5e8; }
  .hp-term-line .hp-comm { color: #6a655d; }
  .hp-term-line:nth-child(1)  { animation-delay: 0.2s; }
  .hp-term-line:nth-child(2)  { animation-delay: 0.5s; }
  .hp-term-line:nth-child(3)  { animation-delay: 0.8s; }
  .hp-term-line:nth-child(4)  { animation-delay: 1.1s; }
  .hp-term-line:nth-child(5)  { animation-delay: 1.4s; }
  .hp-term-line:nth-child(6)  { animation-delay: 1.7s; }
  .hp-term-line:nth-child(7)  { animation-delay: 2.0s; }
  .hp-term-line:nth-child(8)  { animation-delay: 2.3s; }
  .hp-term-line:nth-child(9)  { animation-delay: 2.6s; }
  .hp-term-line:nth-child(10) { animation-delay: 2.9s; }
  @keyframes hp-term { from { opacity: 0; transform: translateX(-3px); } to { opacity: 1; transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .hp-term-line { opacity: 1; animation: none; } }

  /* ECO STRIP */
  .hp-eco { border-top: 0.5px solid var(--hp-line); border-bottom: 0.5px solid var(--hp-line); background: var(--hp-cream-d); padding: 56px 0; }
  .hp-eco-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; display: flex; align-items: center; gap: 56px; flex-wrap: wrap; }
