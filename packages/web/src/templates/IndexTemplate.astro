  }

  .hp-mech-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 72px; padding-top: 36px; border-top: 0.5px solid #3a3025; flex-wrap: wrap; gap: 20px; }
  .hp-mech-stack { display: flex; gap: 28px; flex-wrap: wrap; }
  .hp-mech-stack-item { font-family: var(--hp-mono); font-size: 11.5px; color: var(--hp-brown-light); letter-spacing: 0.06em; }
