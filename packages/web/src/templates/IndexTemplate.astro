  { id: "p1", pill: "P1 · " + C.tabP1, h4: C.p1Title, desc: C.p1Desc, can: C.p1Can, where: C.p1Where,
    rows: [{ l: C.p1Row1, v: C.p1Row1Val }, { l: C.p1Row2, v: C.p1Row2Val }, { l: C.p1Row3, v: C.p1Row3Val }] },
  { id: "p2", pill: "P2 · " + C.tabP2, h4: C.p2Title, desc: C.p2Desc, can: C.p2Can, where: C.p2Where,
    rows: [{ l: C.p2Row1, v: C.p2Row1Val }, { l: C.p2Row2, v: C.p2Row2Val }, { l: C.p2Row3, v: C.p2Row3Val }, { l: C.p2Row4, v: C.p2Row4Val }] },
  { id: "p3", pill: "P3 · " + C.tabP3, h4: C.p3Title, desc: C.p3Desc, can: C.p3Can, where: C.p3Where,
    rows: [{ l: C.p3Row1, v: C.p3Row1Val }, { l: C.p3Row2, v: C.p3Row2Val }, { l: C.p3Row3, v: C.p3Row3Val }, { l: C.p3Row4, v: C.p3Row4Val }] },
  { id: "p4", pill: "P4 · " + C.tabP4, h4: C.p4Title, desc: C.p4Desc, can: C.p4Can, where: C.p4Where,
    rows: [{ l: C.p4Row1, v: C.p4Row1Val }, { l: C.p4Row2, v: C.p4Row2Val }, { l: C.p4Row3, v: C.p4Row3Val }, { l: C.p4Row4, v: C.p4Row4Val }] },
];

// §1 workflow phases (Input → Inference → Decision → Delegation). Each card
// links to the matching Solutions § anchor (business-theme, spans multiple UCs).
const cap1 = [
  { num: "01", name: C.capP1Name, h3: C.capP1H3, p: C.capP1P, href: `${base}/solutions/#input-provenance` },
  { num: "02", name: C.capP2Name, h3: C.capP2H3, p: C.capP2P, href: `${base}/solutions/#verifiable-ai` },
  { num: "03", name: C.capP3Name, h3: C.capP3H3, p: C.capP3P, href: `${base}/solutions/#regulatory` },
  { num: "04", name: C.capP4Name, h3: C.capP4H3, p: C.capP4P, href: `${base}/solutions/#agent-authority` },
];
---

<Layout
  locale={locale}
  metaType="home"
  title={C.pageTitle}
  description={C.metaDescription}
  ogImage={`https://lemma.frame00.com/og/home/${locale}.png`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="hp">

    <!-- HERO -->
    <section class="hp-hero">
      <div class="hp-hero-text">
        <h1>{C.heroH1Line1}<br /><span class="hp-accent">{C.heroH1Accent}</span>{C.heroH1Tail}</h1>
        <p class="hp-hero-sub">{C.heroSubLead} <span class="hp-hero-sub-chord">{C.heroSubChord}</span></p>
        <div class="hp-hero-ctas">
          <a href={DASHBOARD_URL} target="_blank" rel="noopener" class="hp-btn-primary">{C.heroPrimaryCta} ↗</a>
          <a href={pillarsHref} class="hp-btn-secondary">{C.heroSecondaryCta} →</a>
        </div>
      </div>

      <div class="hp-hero-visual" aria-hidden="true">
        <div class="hp-term-chrome">
          <span></span><span></span><span></span>
          <span class="hp-term-label">{C.termLabel}</span>
        </div>
        <div class="hp-term-body">
          <span class="hp-term-line"><span class="hp-prompt">$</span> <span class="hp-cmd">lemma verify --target agent-payment</span></span>
          <span class="hp-term-line"><span class="hp-comm"># {C.termComm1}</span></span>
          <span class="hp-term-line">✓ <span class="hp-key">provenance</span>: <span class="hp-str">"raw_source"</span> — <span class="hp-ok">verified</span></span>
          <span class="hp-term-line"><span class="hp-comm"># {C.termComm2}</span></span>
          <span class="hp-term-line">✓ <span class="hp-key">model_attestation</span>: <span class="hp-str">"claude-3.7-sonnet"</span> — <span class="hp-ok">verified</span></span>
          <span class="hp-term-line"><span class="hp-comm"># {C.termComm3}</span></span>
          <span class="hp-term-line">✓ <span class="hp-key">role</span>: <span class="hp-str">"treasury_agent"</span> · <span class="hp-key">spend_limit</span>: <span class="hp-str">"$500/day"</span> — <span class="hp-ok">in policy</span></span>
          <span class="hp-term-line"><span class="hp-comm"># {C.termComm4}</span></span>
          <span class="hp-term-line">✓ <span class="hp-key">jurisdiction</span>: <span class="hp-str">"JP-fin"</span> · <span class="hp-key">attribute</span>: <span class="hp-str">"licensed"</span> — <span class="hp-ok">satisfied</span></span>
          <span class="hp-term-line"><span class="hp-prompt">→</span> <span class="hp-ok">{C.termFinal}</span> · <span class="hp-comm">{C.termFinalSub}</span></span>
        </div>
      </div>
    </section>

    <!-- ECOSYSTEM STRIP -->
    <div class="hp-eco">
      <div class="hp-eco-inner">
        <div class="hp-eco-label">{C.ecoLabel}</div>
        <div class="hp-eco-items">
          {ecoItems.map((e) => (
            <div class="hp-eco-item">
              <div class="hp-eco-name">{e.accent
                ? <>x<span class="hp-accent">{e.accent}</span></>
                : e.name}</div>
              <div class="hp-eco-meta">{e.meta}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- §2 CAPABILITY-FIRST BAND (v29) -->
    <section class="hp-cap">
      <div class="hp-cap-inner">
        <h2 class="hp-cap-h2" set:html={C.capH2Html} />

        <div class="hp-wf-strip">
          {cap1.map((p) => (
            <div class="hp-wf-pill"><span class="hp-wf-num">{p.num}</span>{p.name}</div>
          ))}
        </div>

        <div class="hp-phase-grid">
          <a class="hp-phase-card" href={cap1[0].href}>
            <svg class="hp-phase-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="5"/>
              <circle cx="21" cy="21" r="5"/>
              <line x1="15" y1="15" x2="17" y2="17" stroke-width="2"/>
            </svg>
            <div class="hp-phase-tag">{cap1[0].name}</div>
            <h3 class="hp-phase-h3">{cap1[0].h3}</h3>
            <p class="hp-phase-p">{cap1[0].p}</p>
            <div class="hp-phase-link"><span class="hp-phase-arrow">{C.capCardLink}</span></div>
          </a>

          <a class="hp-phase-card" href={cap1[1].href}>
            <svg class="hp-phase-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="6" y="8" width="20" height="14" rx="2"/>
              <circle cx="12" cy="15" r="1.5" fill="currentColor"/>
              <circle cx="16" cy="15" r="1.5" fill="currentColor"/>
              <circle cx="20" cy="15" r="1.5" fill="currentColor"/>
              <path d="M11 26 L13 28 L17 24" stroke-width="2"/>
            </svg>
            <div class="hp-phase-tag">{cap1[1].name}</div>
            <h3 class="hp-phase-h3">{cap1[1].h3}</h3>
            <p class="hp-phase-p">{cap1[1].p}</p>
            <div class="hp-phase-link"><span class="hp-phase-arrow">{C.capCardLink}</span></div>
          </a>

          <a class="hp-phase-card" href={cap1[2].href}>
            <svg class="hp-phase-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16 4 L26 8 V16 a10 12 0 0 1 -10 12 a10 12 0 0 1 -10 -12 V8 Z"/>
              <path d="M11 15 L15 19 L21 12"/>
            </svg>
            <div class="hp-phase-tag">{cap1[2].name}</div>
            <h3 class="hp-phase-h3">{cap1[2].h3}</h3>
            <p class="hp-phase-p">{cap1[2].p}</p>
            <div class="hp-phase-link"><span class="hp-phase-arrow">{C.capCardLink}</span></div>
          </a>

          <a class="hp-phase-card" href={cap1[3].href}>
            <svg class="hp-phase-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="6" y="10" width="14" height="18" rx="2"/>
              <circle cx="13" cy="17" r="2"/>
              <line x1="13" y1="19" x2="13" y2="24"/>
              <path d="M20 14 H26 V20"/>
            </svg>
            <div class="hp-phase-tag">{cap1[3].name}</div>
            <h3 class="hp-phase-h3">{cap1[3].h3}</h3>
            <p class="hp-phase-p">{cap1[3].p}</p>
            <div class="hp-phase-link"><span class="hp-phase-arrow">{C.capCardLink}</span></div>
          </a>
        </div>
      </div>
    </section>

    <!-- THREE DOORS -->
    <section class="hp-block">
      <h2 class="hp-h2">{C.doorsH2Line1}<br /><span class="hp-accent">{C.doorsH2Accent}</span>{C.doorsH2Tail}</h2>

      <div class="hp-doors">
        <a href={sealHref} class="hp-door">
          <div class="hp-door-top">
            <div class="hp-door-icon">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="28" cy="28" r="23" stroke="currentColor" stroke-width="2.5" />
                <circle cx="28" cy="28" r="4" fill="currentColor" opacity="0.45" />
              </svg>
            </div>
            <div class="hp-door-name">Seal</div>
          </div>
          <div class="hp-door-bottom">
            <span class="hp-door-aud">{C.sealAud}</span>
            <h3 class="hp-door-tag">{C.sealTagline}</h3>
            <p class="hp-door-desc">{C.sealDesc}</p>
            <span class="hp-door-url">/seal →</span>
          </div>
        </a>

        <a href={trust402Href} class="hp-door">
          <div class="hp-door-top">
            <div class="hp-door-icon">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M14 12 L46 28 L14 44 Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" fill="none" />
                <line x1="25" y1="21" x2="25" y2="35" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
              </svg>
            </div>
            <div class="hp-door-name">Trust<span class="hp-accent">402</span></div>
          </div>
          <div class="hp-door-bottom">
            <span class="hp-door-aud">{C.trust402Aud}</span>
            <h3 class="hp-door-tag">{C.trust402Tagline}</h3>
            <p class="hp-door-desc">{C.trust402Desc}</p>
            <span class="hp-door-url">/trust402 →</span>
          </div>
        </a>

        <a href={industriesHref} class="hp-door">
          <div class="hp-door-top">
            <div class="hp-door-icon">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="7" y="11" width="42" height="34" rx="2" stroke="currentColor" stroke-width="2.5" />
                <line x1="20" y1="19" x2="20" y2="37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
                <line x1="28" y1="19" x2="28" y2="37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
                <line x1="36" y1="19" x2="36" y2="37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
              </svg>
            </div>
            <div class="hp-door-name">Industries</div>
          </div>
          <div class="hp-door-bottom">
            <span class="hp-door-aud">{C.industriesAud}</span>
            <h3 class="hp-door-tag">{C.industriesTagline}</h3>
            <p class="hp-door-desc">{C.industriesDesc}</p>
            <span class="hp-door-url">/pricing →</span>
          </div>
        </a>
      </div>
    </section>

    <!-- MECHANISM -->
    <section class="hp-mech">
      <div class="hp-mech-inner">
        <h2 class="hp-h2 hp-on-dark">{C.mechH2Line1}<br /><span class="hp-accent-light">{C.mechH2Accent}</span>{C.mechH2Tail}</h2>
        <p class="hp-sub hp-on-dark">{C.mechSub}</p>

        <div class="hp-mech-flow">

          <!-- PHASE 01 — ISSUE -->
          <div class="hp-mech-phase">
            <div class="hp-mech-viz">
              <svg viewBox="0 0 280 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Source data box (encrypted lines) -->
                <rect x="22" y="22" width="76" height="46" rx="3" stroke="#d4a574" stroke-width="1.2" fill="none" />
                <line x1="32" y1="32" x2="88" y2="32" stroke="#d4a574" stroke-width="0.8" opacity="0.45" />
                <line x1="32" y1="40" x2="88" y2="40" stroke="#d4a574" stroke-width="0.8" opacity="0.45" />
                <line x1="32" y1="48" x2="88" y2="48" stroke="#d4a574" stroke-width="0.8" opacity="0.45" />
                <line x1="32" y1="56" x2="88" y2="56" stroke="#d4a574" stroke-width="0.8" opacity="0.45" />
                <text x="60" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#8a857d" letter-spacing="0.1em">SOURCE</text>
                <!-- Arrow (dashflow) -->
                <path class="hp-mech-dashflow" d="M 115 45 L 175 45" stroke="#d4a574" stroke-width="1.2" fill="none" />
                <path d="M 170 41 L 175 45 L 170 49" stroke="#d4a574" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                <text x="145" y="36" text-anchor="middle" font-family="Space Mono" font-size="8" fill="#d4a574" letter-spacing="0.1em">ISSUE</text>
                <!-- Proof token (focal): cream tones + sonar halo (2 layers) + inner pulse + 4 dots -->
                <circle class="hp-mech-halo" cx="225" cy="45" r="24" stroke="#FCFAF5" stroke-width="1" fill="none" />
                <circle class="hp-mech-halo hp-mech-halo--delay" cx="225" cy="45" r="24" stroke="#FCFAF5" stroke-width="1" fill="none" />
                <circle cx="225" cy="45" r="24" stroke="#FCFAF5" stroke-width="1.6" fill="none" />
                <circle class="hp-mech-token-pulse" cx="225" cy="45" r="10" stroke="#FCFAF5" stroke-width="1.2" fill="none" opacity="0.5" />
                <circle cx="225" cy="27" r="2.5" fill="#FCFAF5" />
                <circle cx="225" cy="63" r="2.5" fill="#FCFAF5" />
                <circle cx="207" cy="45" r="2.5" fill="#FCFAF5" />
                <circle cx="243" cy="45" r="2.5" fill="#FCFAF5" />
                <text x="225" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">PROOF</text>
              </svg>
            </div>
            <div class="hp-mech-step">{phases[0].step}</div>
            <h3 class="hp-mech-title">{phases[0].title}</h3>
            <p class="hp-mech-desc">{phases[0].desc}</p>
            <div class="hp-mech-prims">
              {phases[0].prims.map((pr) => <div class="hp-mech-prim">{pr}</div>)}
            </div>
          </div>

          <div class="hp-mech-arrow" aria-hidden="true">→</div>

          <!-- PHASE 02 — PROVE -->
          <div class="hp-mech-phase">
            <div class="hp-mech-viz">
              <svg viewBox="0 0 280 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Full proof token (cream, 4 dots solid) -->
                <circle cx="50" cy="45" r="22" stroke="#FCFAF5" stroke-width="1.6" fill="none" />
                <circle cx="50" cy="29" r="2.5" fill="#FCFAF5" />
                <circle cx="50" cy="61" r="2.5" fill="#FCFAF5" />
                <circle cx="34" cy="45" r="2.5" fill="#FCFAF5" />
                <circle cx="66" cy="45" r="2.5" fill="#FCFAF5" />
                <text x="50" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">PROOF</text>
                <!-- ZK transformation box (support role: brown, stroke pulse) -->
                <rect class="hp-mech-zk-pulse" x="105" y="28" width="70" height="34" rx="4" stroke="#d4a574" stroke-width="1.2" stroke-dasharray="3,2" fill="none" />
                <text x="140" y="49" text-anchor="middle" font-family="Sora" font-size="11" fill="#d4a574" font-weight="600" letter-spacing="0.08em">ZK</text>
                <text x="140" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#8a857d" letter-spacing="0.1em">SELECT</text>
                <!-- Disclosed proof token (focal, cream + halo, 1 solid + 3 faded dots) -->
                <circle class="hp-mech-halo" cx="225" cy="45" r="22" stroke="#FCFAF5" stroke-width="1" fill="none" />
                <circle class="hp-mech-halo hp-mech-halo--delay" cx="225" cy="45" r="22" stroke="#FCFAF5" stroke-width="1" fill="none" />
                <circle cx="225" cy="45" r="22" stroke="#FCFAF5" stroke-width="1.6" fill="none" />
                <circle cx="225" cy="29" r="2.5" fill="#FCFAF5" />
                <circle class="hp-mech-dot-fade" cx="225" cy="61" r="2.5" fill="#FCFAF5" opacity="0.18" />
                <circle class="hp-mech-dot-fade" cx="209" cy="45" r="2.5" fill="#FCFAF5" opacity="0.18" />
                <circle class="hp-mech-dot-fade" cx="241" cy="45" r="2.5" fill="#FCFAF5" opacity="0.18" />
                <text x="225" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">DISCLOSED</text>
              </svg>
            </div>
            <div class="hp-mech-step">{phases[1].step}</div>
            <h3 class="hp-mech-title">{phases[1].title}</h3>
            <p class="hp-mech-desc">{phases[1].desc}</p>
            <div class="hp-mech-prims">
              {phases[1].prims.map((pr) => <div class="hp-mech-prim">{pr}</div>)}
            </div>
          </div>

          <div class="hp-mech-arrow" aria-hidden="true">→</div>

          <!-- PHASE 03 — VERIFY -->
          <div class="hp-mech-phase">
            <div class="hp-mech-viz">
              <svg viewBox="0 0 280 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Incoming proof (focal: cream + halo, 1 highlighted dot) -->
                <circle class="hp-mech-halo" cx="40" cy="45" r="20" stroke="#FCFAF5" stroke-width="1" fill="none" />
                <circle class="hp-mech-halo hp-mech-halo--delay" cx="40" cy="45" r="20" stroke="#FCFAF5" stroke-width="1" fill="none" />
                <circle cx="40" cy="45" r="20" stroke="#FCFAF5" stroke-width="1.6" fill="none" />
                <circle cx="40" cy="31" r="2" fill="#FCFAF5" />
                <circle cx="40" cy="59" r="2" fill="#FCFAF5" opacity="0.18" />
                <circle cx="26" cy="45" r="2" fill="#FCFAF5" opacity="0.18" />
                <circle cx="54" cy="45" r="2" fill="#FCFAF5" opacity="0.18" />
                <text x="40" y="82" text-anchor="middle" font-family="Space Mono" font-size="9.5" fill="#FCFAF5" font-weight="700" letter-spacing="0.18em">PROOF</text>
                <!-- Arrow → pubkey -->
                <path class="hp-mech-dashflow" d="M 70 45 L 105 45" stroke="#d4a574" stroke-width="1.2" fill="none" />
                <path d="M 100 41 L 105 45 L 100 49" stroke="#d4a574" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                <!-- Public key verifier -->
                <rect x="110" y="28" width="60" height="34" rx="4" stroke="#d4a574" stroke-width="1.5" fill="none" />
                <circle cx="124" cy="45" r="6" stroke="#d4a574" stroke-width="1.4" fill="none" />
                <line x1="130" y1="45" x2="162" y2="45" stroke="#d4a574" stroke-width="1.4" stroke-linecap="round" />
                <line x1="155" y1="45" x2="155" y2="51" stroke="#d4a574" stroke-width="1.4" stroke-linecap="round" />
                <line x1="162" y1="45" x2="162" y2="53" stroke="#d4a574" stroke-width="1.4" stroke-linecap="round" />
                <text x="140" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#8a857d" letter-spacing="0.1em">PUBKEY</text>
                <!-- Arrow → verified -->
                <path class="hp-mech-dashflow" d="M 178 45 L 210 45" stroke="#d4a574" stroke-width="1.2" fill="none" />
                <path d="M 205 41 L 210 45 L 205 49" stroke="#d4a574" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                <!-- Verified ring + checkmark (gentle glow) -->
                <circle class="hp-mech-check-glow" cx="240" cy="45" r="20" stroke="#6ec27a" stroke-width="1.5" fill="none" />
                <path d="M 228 45 L 237 53 L 252 36" stroke="#6ec27a" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                <text x="240" y="82" text-anchor="middle" font-family="Space Mono" font-size="9" fill="#6ec27a" letter-spacing="0.1em">VERIFIED</text>
              </svg>
            </div>
            <div class="hp-mech-step">{phases[2].step}</div>
            <h3 class="hp-mech-title">{phases[2].title}</h3>
            <p class="hp-mech-desc">{phases[2].desc}</p>
            <div class="hp-mech-prims">
              {phases[2].prims.map((pr) => <div class="hp-mech-prim">{pr}</div>)}
            </div>
          </div>
        </div>

        <div class="hp-mech-bottom">
          <div class="hp-mech-stack">
            {stack.map((s) => (
              <div class="hp-mech-stack-item">{s.label} <span class="hp-mech-stack-meta">{s.meta}</span></div>
            ))}
          </div>
          <a href={guidesHref} class="hp-mech-cta">{C.mechCta} →</a>
        </div>
      </div>
    </section>

    <!-- SCHEMA TABS -->
    <section class="hp-block">
      <h2 class="hp-h2">{C.schemaH2Line1}<br /><span class="hp-accent">{C.schemaH2Accent}</span>{C.schemaH2Tail}</h2>
      <p class="hp-sub">
        {C.schemaSub1}<code class="hp-inline-code">{C.schemaSubCode}</code>{C.schemaSub2}
      </p>

      <div class="hp-schema-tabs" role="tablist">
        {tabs.map((t, i) => (
