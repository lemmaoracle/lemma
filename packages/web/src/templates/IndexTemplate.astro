  .hp-schema-side h4 { font-family: var(--hp-display); font-size: 18px; font-weight: 600; color: #000; margin: 0; letter-spacing: -0.015em; }
  .hp-schema-side p { font-size: 13.5px; line-height: 1.8; color: var(--hp-text-2); margin: 0; }
  .hp-schema-rows { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 0.5px solid var(--hp-line); margin-top: auto; }
  .hp-schema-row { display: flex; justify-content: space-between; align-items: center; font-family: var(--hp-mono); font-size: 11px; color: var(--hp-text-3); }
  .hp-schema-row-val { color: var(--hp-brown); font-weight: 500; }

  /* BRIEF */
  .hp-brief { background: var(--hp-cream-d); padding: 120px 0; }
  .hp-brief-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; }
  .hp-brief-feat { background: var(--hp-code-bg); border-radius: 18px; padding: 48px 56px; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; transition: all 0.2s; margin-top: 40px; }
  .hp-brief-feat:hover { transform: translateY(-2px); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18); }
  .hp-brief-feat-meta { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--hp-brown-light); margin: 0 0 14px; }
  .hp-brief-feat-h { font-family: var(--hp-display); font-size: 26px; font-weight: 600; line-height: 1.35; letter-spacing: -0.018em; color: var(--hp-cream); margin: 0 0 12px; }
  .hp-brief-feat-tldr { font-size: 14px; line-height: 1.8; color: #b8b3a9; margin: 0; max-width: 720px; }
  .hp-brief-feat-cta { font-family: var(--hp-display); font-size: 13.5px; color: var(--hp-brown-light); white-space: nowrap; }
  .hp-brief-bottom { margin-top: 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  .hp-brief-list { font-family: var(--hp-display); font-size: 13.5px; color: var(--hp-brown); font-weight: 500; }
  .hp-brief-list:hover { color: var(--hp-brown-deep); }
  .hp-brief-wp { font-size: 13px; color: var(--hp-text-3); }
  .hp-brief-wp a { color: var(--hp-brown); text-decoration: underline; text-underline-offset: 3px; }

  /* CLOSING */
  .hp-closing { background: #0a0807; padding: 140px 40px; text-align: center; }
  .hp-closing-inner { max-width: 920px; margin: 0 auto; }
  .hp-closing-h { font-family: var(--hp-display); font-size: 60px; font-weight: 700; line-height: 1.12; letter-spacing: -0.028em; color: var(--hp-cream); margin: 0 0 48px; }
  .hp-closing-ctas { display: flex; gap: 28px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .hp-btn-brown-pill { background: var(--hp-brown); color: var(--hp-cream); padding: 16px 32px; border-radius: 999px; font-family: var(--hp-display); font-size: 15px; font-weight: 500; box-shadow: 0 8px 28px rgba(139, 69, 19, 0.4); transition: background 0.15s; }
  .hp-btn-brown-pill:hover { background: var(--hp-brown-deep); }
  .hp-closing-link { font-family: var(--hp-display); font-size: 15px; color: var(--hp-brown-light); transition: color 0.15s; }
  .hp-closing-link:hover { color: var(--hp-cream); }

  /* RESPONSIVE */
  @media (max-width: 980px) {
    .hp-hero { grid-template-columns: 1fr; gap: 48px; padding: 56px 24px 72px; }
    .hp-hero h1 { font-size: 52px; margin: 0 0 22px; }
    .hp-hero-sub { font-size: 16px; margin: 0 0 32px; }
    .hp-h2 { font-size: 40px; }
    .hp-closing-h { font-size: 40px; }
    .hp-block { padding: 80px 24px; }
    .hp-closing { padding: 100px 24px; }
    .hp-doors { grid-template-columns: 1fr; }
    /* Mechanism flow: stack the 3 phase cards vertically, rotate arrows to point down */
    .hp-mech-flow { grid-template-columns: 1fr; }
    .hp-mech-arrow { transform: rotate(90deg); padding: 8px 0; }
    .hp-schema-pane.is-active { grid-template-columns: 1fr; }
    .hp-brief-feat { grid-template-columns: 1fr; padding: 36px; }
  }
  @media (max-width: 560px) {
    .hp-hero { padding: 40px 22px 56px; gap: 36px; }
    .hp-hero h1 { font-size: 34px; line-height: 1.1; }
    .hp-hero-sub { font-size: 15px; line-height: 1.75; margin: 0 0 28px; }

    .hp-h2 { font-size: 32px; }

    /* Schema tabs: 2×2 grid so the 4 pillars don't stack to a tall column */
    .hp-schema-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .hp-schema-tab {
      padding: 11px 10px;
      font-size: 12.5px;
      line-height: 1.25;
      display: flex; flex-direction: column; align-items: flex-start; gap: 3px;
    }
    .hp-tab-pill { margin: 0; font-size: 9.5px; opacity: 0.75; }

    /* Brief featured: cap title at 3 lines so a long brief headline
