---
/**
 * Home page — v28 redesign.
 *
 * Sections (per Lemma_homepage_v28 mockup):
 *   1. Hero (title + sub + 2 CTAs + verify-terminal animation)
 *   2. Ecosystem strip (MCP / A2A / x402 / C2PA / W3C VC)
 *   3. Three product doors (Seal / Trust402 / Industries)
 *   4. Mechanism (dark; source → attestation → selective disclosure → verifier + 3-phase row)
 *   5. Schema tabs (4 trust layers as your.*.v1 examples — P1 / P2 / P3 / P4)
 *   6. Critical Brief feature (latest brief)
 *   7. Closing CTA (dark slim)
 *
 * Copy is locale-resolved via a single C object below (rather than expanding
 * the t.index translations namespace) — homepage copy is tightly bound to
 * the v28 layout and not reused elsewhere.
 */
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import { DISCOVERY_CALL_URL } from "../config/cta";
import { getCollection } from "astro:content";
import { extractTldr } from "../data/extractTldr";

export interface IndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  description: string;
}

const { locale, t, base, description } = Astro.props as IndexTemplateProps;
const isJa = locale === "ja";

// ── Routes ────────────────────────────────────────────────────────
const contactHref = DISCOVERY_CALL_URL[locale];
const useCasesHref = `${base}/solutions/use-cases/`;
const guidesHref = `${base}/guides/`;
const trust402Href = "/trust402/";
const industriesHref = `${base}/pricing/`;
const sealHref = `${base}/seal/`;
const briefIndexHref = `${base}/critical/briefs/`;
const whitepaperHref = "https://tally.so/r/xX0VYv";

// ── Latest Critical Brief (featured row) ──────────────────────────
const allBriefs = await getCollection("critical-briefs");
const briefsByDate = [...allBriefs].sort((a, b) => {
  const diff = b.data.published.getTime() - a.data.published.getTime();
  return diff !== 0 ? diff : b.data.brief_no - a.data.brief_no;
});
const featured = briefsByDate[0];
const featuredTldr = featured ? extractTldr(featured.body ?? "", 180) : "";
const featuredHref = featured ? `${base}/critical/briefs/${featured.id}/` : briefIndexHref;
const featuredTitle = featured
  ? (isJa ? featured.data.title : (featured.data.title_en ?? featured.data.title))
  : "";
const featuredDate = featured ? featured.data.published.toISOString().slice(0, 10) : "";

// ── Copy (locale-resolved) ────────────────────────────────────────
