                &nbsp;&nbsp;<span class="hp-jk">"lineageChain"</span><span class="hp-jp">:</span> <span class="hp-jp">[</span><span class="hp-js">"sensor"</span><span class="hp-jp">,</span> <span class="hp-js">"scada"</span><span class="hp-jp">,</span> <span class="hp-js">"oracle"</span><span class="hp-jp">],</span><br />
                &nbsp;&nbsp;<span class="hp-jk">"recordedAt"</span><span class="hp-jp">:</span> <span class="hp-js">"2026-06-02T14:30:00Z"</span><span class="hp-jp">,</span><br />
                &nbsp;&nbsp;<span class="hp-jk">"integrity"</span><span class="hp-jp">:</span> <span class="hp-js">"poseidon-merkle"</span><span class="hp-jp">,</span><br />
                &nbsp;&nbsp;<span class="hp-jk">"proof"</span><span class="hp-jp">:</span> <span class="hp-jp">{"{"}</span><br />
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hp-jk">"type"</span><span class="hp-jp">:</span> <span class="hp-js">"BBS+Signature2020"</span><span class="hp-jp">,</span><br />
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hp-jk">"value"</span><span class="hp-jp">:</span> <span class="hp-js">"0x4a2b...e1d3"</span><br />
                &nbsp;&nbsp;<span class="hp-jp">{"}"}</span><br />
                <span class="hp-jp">{"}"}</span>
