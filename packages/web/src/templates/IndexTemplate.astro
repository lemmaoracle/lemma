const phases = [
  { step: C.phase1Step, title: C.phase1Title, desc: C.phase1Desc, prims: ["BBS+ Signature", "Poseidon Hash", "DID / VC (W3C)"] },
  { step: C.phase2Step, title: C.phase2Title, desc: C.phase2Desc, prims: ["Groth16 / BN254", "Circom 2.x Circuit", "Selective Disclosure"] },
  { step: C.phase3Step, title: C.phase3Title, desc: C.phase3Desc, prims: ["Public verify (no trust)", "EIP-712 attestation", "audit anchor (optional)"] },
];
const stack = [
  { label: C.stack1Label, meta: "Groth16 / BN254" },
  { label: C.stack2Label, meta: "BBS+ / EdDSA" },
  { label: C.stack3Label, meta: "Poseidon / Keccak" },
  { label: C.stack4Label, meta: "W3C DID/VC" },
  { label: C.stack5Label, meta: "EIP-712 / x402" },
];
const ecoItems = [
  { name: "MCP", meta: "Model Context Protocol" },
  { name: "A2A", meta: "Agent2Agent · Google" },
  { name: "x402", meta: "HTTP 402 · Coinbase", accent: "402" },
  { name: "C2PA", meta: "Content Provenance" },
  { name: "W3C VC", meta: "Verifiable Credentials" },
];
const tabs = [
  { id: "p1", pill: "P1", label: C.tabP1 },
  { id: "p2", pill: "P2", label: C.tabP2 },
  { id: "p3", pill: "P3", label: C.tabP3 },
  { id: "p4", pill: "P4", label: C.tabP4 },
];
const panes = [
  { id: "p1", pill: "P1 · " + C.tabP1, h4: C.p1Title, desc: C.p1Desc, can: C.p1Can, where: C.p1Where,
    rows: [{ l: C.p1Row1, v: C.p1Row1Val }, { l: C.p1Row2, v: C.p1Row2Val }, { l: C.p1Row3, v: C.p1Row3Val }] },
  { id: "p2", pill: "P2 · " + C.tabP2, h4: C.p2Title, desc: C.p2Desc, can: C.p2Can, where: C.p2Where,
    rows: [{ l: C.p2Row1, v: C.p2Row1Val }, { l: C.p2Row2, v: C.p2Row2Val }, { l: C.p2Row3, v: C.p2Row3Val }, { l: C.p2Row4, v: C.p2Row4Val }] },
  { id: "p3", pill: "P3 · " + C.tabP3, h4: C.p3Title, desc: C.p3Desc, can: C.p3Can, where: C.p3Where,
    rows: [{ l: C.p3Row1, v: C.p3Row1Val }, { l: C.p3Row2, v: C.p3Row2Val }, { l: C.p3Row3, v: C.p3Row3Val }, { l: C.p3Row4, v: C.p3Row4Val }] },
  { id: "p4", pill: "P4 · " + C.tabP4, h4: C.p4Title, desc: C.p4Desc, can: C.p4Can, where: C.p4Where,
    rows: [{ l: C.p4Row1, v: C.p4Row1Val }, { l: C.p4Row2, v: C.p4Row2Val }, { l: C.p4Row3, v: C.p4Row3Val }, { l: C.p4Row4, v: C.p4Row4Val }] },
];

// §1 workflow phases (Input → Inference → Decision → Delegation). Each card
// links to the matching Solutions § anchor (business-theme, spans multiple UCs).
const cap1 = [
  { num: "01", name: C.capP1Name, h3: C.capP1H3, p: C.capP1P, href: `${base}/solutions/#input-provenance` },
  { num: "02", name: C.capP2Name, h3: C.capP2H3, p: C.capP2P, href: `${base}/solutions/#verifiable-ai` },
  { num: "03", name: C.capP3Name, h3: C.capP3H3, p: C.capP3P, href: `${base}/solutions/#regulatory` },
  { num: "04", name: C.capP4Name, h3: C.capP4H3, p: C.capP4P, href: `${base}/solutions/#agent-authority` },
];
---

<Layout
  locale={locale}
  metaType="home"
  title={C.pageTitle}
  description={C.metaDescription}
  ogImage={`https://lemma.frame00.com/og/home/${locale}.png`}
>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main class="hp">

    <!-- HERO -->
    <section class="hp-hero">
      <div class="hp-hero-text">
        <h1>{C.heroH1Line1}<br /><span class="hp-accent">{C.heroH1Accent}</span>{C.heroH1Tail}</h1>
        <p class="hp-hero-sub">{C.heroSubLead} <span class="hp-hero-sub-chord">{C.heroSubChord}</span></p>
        <div class="hp-hero-ctas">
          <a href={DASHBOARD_URL} target="_blank" rel="noopener" class="hp-btn-primary">{C.heroPrimaryCta} ↗</a>
          <a href={pillarsHref} class="hp-btn-secondary">{C.heroSecondaryCta} →</a>
        </div>
      </div>

      <div class="hp-hero-visual">
        <svg id="hpHeroFig" class="hp-hero-fig" viewBox="0 0 430 168" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={FIG.aria}>
          <defs><marker id="hpHeroAr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="#CBB89F" stroke-width="1.5" stroke-linecap="round"/></marker></defs>
          <rect x="6" y="46" width="106" height="64" rx="9" fill="#FBF7F1" stroke="#E7DACA"/>
          <text x="59" y="76" text-anchor="middle" fill="#3D2A1C" font-size="15" font-weight="500">{FIG.source}</text>
          <rect class="hp-fig-mrow" x="22" y="88" width="74" height="9" rx="3" fill="#EDE0CF"/>
          <line x1="112" y1="78" x2="138" y2="78" stroke="#CBB89F" stroke-width="1.5" marker-end="url(#hpHeroAr)"/>
          <rect x="140" y="54" width="98" height="50" rx="9" fill="#EAD8C2" stroke="#B5703A"/>
          <text x="189" y="76" text-anchor="middle" fill="#6E3A12" font-size="15" font-weight="500">Lemma</text>
          <text x="189" y="93" text-anchor="middle" fill="#6E3A12" font-size="10" class="hp-fig-mono">{FIG.issue}</text>
          <rect x="276" y="30" width="56" height="16" rx="8" fill="#FBF7F1" stroke="#E7DACA"/><text x="304" y="42" text-anchor="middle" fill="#8A7A68" font-size="10">{FIG.border}</text>
          <line class="hp-fig-bd" x1="304" y1="48" x2="304" y2="146" stroke="#D8C8B4" stroke-width="1.6" stroke-dasharray="5 4"/>
          <g class="hp-fig-tok">
            <rect x="220" y="66" width="72" height="30" rx="8" fill="#E3CBAD" stroke="#8B4513"/>
            <text x="256" y="80" text-anchor="middle" fill="#5E2F0E" font-size="12" font-weight="500">{FIG.proof}</text>
            <text x="256" y="91" text-anchor="middle" fill="#5E2F0E" font-size="9" class="hp-fig-mono">~200B</text>
          </g>
          <rect x="324" y="54" width="82" height="50" rx="9" fill="#FBF7F1" stroke="#E7DACA"/>
          <text x="365" y="83" text-anchor="middle" fill="#3D2A1C" font-size="13" font-weight="500">{FIG.verifier}</text>
          <g class="hp-fig-tick"><circle cx="319" cy="79" r="9" fill="#2A9D6A"/><text x="319" y="83" text-anchor="middle" fill="#fff" font-size="11">✓</text></g>
          <text x="6" y="160" fill="#8A7A68" font-size="11" class="hp-fig-mono">{FIG.eq}</text>
        </svg>
        <div class="hp-hero-code">$ lemma verify &nbsp;→&nbsp; proof verified · data never left source <span class="hp-hero-ok">✓</span></div>
      </div>
    </section>

    <!-- §1 · 4 PHASES (unified phase cards) -->
    <section class="hp-s1">
      <div class="hp-s1-inner">
        <h2 class="hp-s1-h2" set:html={C.capH2Html} />
        <div class="hp-unified-cards">
          {cap1.map((p) => (
            <a class="hp-u-card" href={p.href}>
              <div class="hp-u-num">{p.num}</div>
              <div class="hp-u-tag">{p.name}</div>
              <h3 class="hp-u-h3">{p.h3}</h3>
              <p class="hp-u-p">{p.p}</p>
              <span class="hp-u-arrow">{C.capCardLink}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- §対応標準 (ecosystem strip) -->
    <div class="hp-eco">
      <div class="hp-eco-inner">
        <div class="hp-eco-label">{C.ecoLabel}</div>
        <div class="hp-eco-items">
          {ecoItems.map((e) => (
            <div class="hp-eco-item">
              <div class="hp-eco-name">{e.accent
                ? <>x<span class="hp-accent">{e.accent}</span></>
                : e.name}</div>
              <div class="hp-eco-meta">{e.meta}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- §3 · VALUES BANNER -->
    <section class="hp-values">
      <div class="hp-values-inner">
        <h2 class="hp-values-h2" set:html={C.valuesH2Html} />
        <div class="hp-values-grid">
          <div class="hp-value-card">
            <svg class="hp-value-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <ellipse cx="24" cy="24" rx="14" ry="9"/>
              <circle cx="24" cy="24" r="4"/>
              <line x1="10" y1="10" x2="38" y2="38" stroke-width="2.5"/>
            </svg>
            <div class="hp-value-label">{C.val1Label}</div>
            <h3 class="hp-value-h3">{C.val1H3}</h3>
            <p class="hp-value-desc">{C.val1Desc}</p>
          </div>
          <div class="hp-value-card">
            <svg class="hp-value-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 8 H30 L36 14 V40 H14 Z"/>
              <path d="M30 8 V14 H36"/>
              <line x1="19" y1="22" x2="29" y2="22"/>
              <path d="M19 28 L22 31 L31 24" stroke-width="2.5"/>
            </svg>
            <div class="hp-value-label">{C.val2Label}</div>
            <h3 class="hp-value-h3">{C.val2H3}</h3>
            <p class="hp-value-desc">{C.val2Desc}</p>
          </div>
          <div class="hp-value-card">
            <svg class="hp-value-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="12" y="22" width="24" height="18" rx="2"/>
              <path d="M17 22 V15 a7 7 0 0 1 14 0 V22"/>
              <circle cx="24" cy="30" r="2.5" fill="currentColor"/>
            </svg>
            <div class="hp-value-label">{C.val3Label}</div>
            <h3 class="hp-value-h3">{C.val3H3}</h3>
            <p class="hp-value-desc">{C.val3Desc}</p>
          </div>
        </div>
        <a href={pillarsHref} class="hp-values-link">{C.valuesLink} <span class="hp-arrow">→</span></a>
      </div>
    </section>

    <!-- §5 · TAKE IT IN (industries) -->
    <section class="hp-scenes">
      <div class="hp-scenes-inner">
        <h2 class="hp-scenes-h2" set:html={C.scenesH2Html} />
        <div class="hp-industries-grid">
          <div class="hp-industry-card">
            <svg class="hp-industry-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="14" width="6" height="7"/><rect x="10" y="9" width="6" height="12"/><rect x="17" y="5" width="4" height="16"/>
            </svg>
            <div class="hp-industry-name">{C.ind1Name}</div>
            <p class="hp-industry-desc">{C.ind1Desc}</p>
          </div>
          <div class="hp-industry-card">
            <svg class="hp-industry-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7 8 L11 16 M17 8 L13 16"/>
            </svg>
            <div class="hp-industry-name">{C.ind2Name}</div>
            <p class="hp-industry-desc">{C.ind2Desc}</p>
          </div>
          <div class="hp-industry-card">
            <svg class="hp-industry-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M5 4 H15 L19 8 V20 H5 Z"/><line x1="8" y1="11" x2="16" y2="11"/><path d="M8 15 L10 17 L14 13"/>
            </svg>
            <div class="hp-industry-name">{C.ind3Name}</div>
            <p class="hp-industry-desc">{C.ind3Desc}</p>
          </div>
          <div class="hp-industry-card">
            <svg class="hp-industry-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M3 21 V11 L12 5 L21 11 V21 Z"/><line x1="9" y1="21" x2="9" y2="15"/><line x1="15" y1="21" x2="15" y2="15"/>
            </svg>
            <div class="hp-industry-name">{C.ind4Name}</div>
            <p class="hp-industry-desc">{C.ind4Desc}</p>
          </div>
        </div>
        <div class="hp-lens-foot">
          <p class="hp-lens-note"><strong>{C.lensFootStrong}</strong>{C.lensFootRest}</p>
          <div class="hp-lens-buttons">
            <a href={`${base}/solutions/use-cases/`} class="hp-lens-btn primary">{C.lensAll} <span class="hp-arrow">→</span></a>
            <a href={briefIndexHref} class="hp-lens-btn">{C.lensRisk} <span class="hp-arrow">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- §6 · PRODUCTS (THREE DOORS — original card design, lowered after take-it-in) -->
    <section class="hp-block">
      <h2 class="hp-h2">{C.doorsH2Line1}<br /><span class="hp-accent">{C.doorsH2Accent}</span>{C.doorsH2Tail}</h2>

      <div class="hp-doors">
        <a href={sealHref} class="hp-door">
          <div class="hp-door-top">
            <div class="hp-door-icon">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="28" cy="28" r="23" stroke="currentColor" stroke-width="2.5" />
                <circle cx="28" cy="28" r="4" fill="currentColor" opacity="0.45" />
              </svg>
            </div>
            <div class="hp-door-name">Seal</div>
          </div>
          <div class="hp-door-bottom">
            <span class="hp-door-aud">{C.sealAud}</span>
            <h3 class="hp-door-tag">{C.sealTagline}</h3>
            <p class="hp-door-desc">{C.sealDesc}</p>
            <span class="hp-door-url">/seal →</span>
          </div>
        </a>

        <a href={trust402Href} class="hp-door">
          <div class="hp-door-top">
            <div class="hp-door-icon">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M14 12 L46 28 L14 44 Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" fill="none" />
                <line x1="25" y1="21" x2="25" y2="35" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
              </svg>
            </div>
            <div class="hp-door-name">Trust<span class="hp-accent">402</span></div>
          </div>
          <div class="hp-door-bottom">
            <span class="hp-door-aud">{C.trust402Aud}</span>
            <h3 class="hp-door-tag">{C.trust402Tagline}</h3>
            <p class="hp-door-desc">{C.trust402Desc}</p>
            <span class="hp-door-url">/trust402 →</span>
          </div>
        </a>

        <a href={industriesHref} class="hp-door">
          <div class="hp-door-top">
            <div class="hp-door-icon">
              <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="7" y="11" width="42" height="34" rx="2" stroke="currentColor" stroke-width="2.5" />
                <line x1="20" y1="19" x2="20" y2="37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
                <line x1="28" y1="19" x2="28" y2="37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
                <line x1="36" y1="19" x2="36" y2="37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
              </svg>
            </div>
            <div class="hp-door-name">Industries</div>
          </div>
          <div class="hp-door-bottom">
            <span class="hp-door-aud">{C.industriesAud}</span>
            <h3 class="hp-door-tag">{C.industriesTagline}</h3>
            <p class="hp-door-desc">{C.industriesDesc}</p>
            <span class="hp-door-url">/pricing →</span>
          </div>
        </a>
      </div>
    </section>

    <!-- §7 · DISCOVERY + dev tail -->
    <section class="hp-disc">
      <div class="hp-disc-inner">
        <p class="hp-disc-eyebrow">{C.closingEyebrow}</p>
        <h2 class="hp-disc-h2">{C.discoveryH2Pre}<span class="hp-accent">{C.discoveryH2Accent}</span>{C.discoveryH2Tail}</h2>
        <p class="hp-disc-body">{C.discoveryBody}</p>
        <div class="hp-disc-ctas">
          <a href={contactHref} target="_blank" rel="noopener" class="hp-disc-primary">{C.discoveryPrimary} →</a>
          <a href={whitepaperHref} target="_blank" rel="noopener" class="hp-disc-secondary">{C.discoverySecondary} →</a>
        </div>
      </div>
      <div class="hp-dev-tail">
        <p class="hp-dev-text"><span class="hp-dev-label">{C.devLabel}</span> <strong>{C.devTailStrong}</strong> {C.devTailRest}</p>
        <div class="hp-dev-links">
          <a href={DASHBOARD_URL} target="_blank" rel="noopener" class="hp-dev-link">{C.devDash} <span class="hp-arrow">↗</span></a>
          <a href={sealHref} class="hp-dev-link">{C.devDocs} <span class="hp-arrow">→</span></a>
        </div>
      </div>
    </section>

  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  .hp {
    --hp-cream: #fcfaf5;
    --hp-cream-d: #f2eedf;
    --hp-line: #e5e0d5;
    --hp-text-1: #1a1a1a;
    --hp-text-2: #2a2622;
    --hp-text-3: #5a544d;
    --hp-text-4: #9a938a;
    --hp-brown: #8b4513;
    --hp-brown-deep: #6b340e;
    --hp-brown-light: #f5ebdc;
    --hp-green: #5c7a4a;
    --hp-code-bg: #1a1612;
    --hp-code-text: #d4cfc4;
    --hp-display: "Sora", system-ui, sans-serif;
    --hp-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
    --hp-mono: "Space Mono", ui-monospace, monospace;

    background: var(--hp-cream);
    color: var(--hp-text-2);
    font-family: var(--hp-body);
    line-height: 1.75;
    font-size: 14.5px;
  }
  .hp a { text-decoration: none; }
  .hp-accent { color: var(--hp-brown); }
  .hp-accent-light { color: var(--hp-brown-light); }

  /* HERO */
  .hp-hero { max-width: 1320px; margin: 0 auto; padding: 96px 40px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 80px; align-items: center; }
  .hp-hero h1 { font-family: var(--hp-display); font-size: 76px; line-height: 1.04; letter-spacing: -0.035em; color: #000; margin: 0 0 28px; font-weight: 600; }
  .hp-hero-sub { font-size: 17px; line-height: 1.8; color: var(--hp-text-2); margin: 0 0 40px; max-width: 520px; }
  .hp-hero-sub-chord { color: var(--hp-text-3); }
  .hp-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hp-btn-primary { background: #000; color: var(--hp-cream); padding: 14px 26px; border-radius: 999px; font-family: var(--hp-display); font-size: 14px; font-weight: 500; transition: background 0.15s; }
  .hp-btn-primary:hover { background: var(--hp-brown); }
  .hp-btn-secondary { background: transparent; color: var(--hp-text-1); padding: 14px 26px; border: 0.5px solid var(--hp-text-1); border-radius: 999px; font-family: var(--hp-display); font-size: 14px; font-weight: 500; transition: all 0.15s; }
  .hp-btn-secondary:hover { background: var(--hp-cream-d); border-color: var(--hp-brown); color: var(--hp-brown); }

  /* Hero visual — v5 proof-crossing-the-border animation (light tonal-brown
     surface). The animated figure is the lead visual; the CLI is demoted to a
     single-line strip below it. Only the proof token crosses the Border; the
     Source data never moves (this embodies the difference from MPC). */
  .hp-hero-visual { background: #F4EEE6; border: 0.5px solid var(--hp-line); border-radius: 16px; padding: 28px; box-shadow: 0 24px 56px rgba(43, 30, 18, 0.10); overflow: hidden; min-width: 0; }
  .hp-hero-fig { width: 100%; height: auto; display: block; }
  .hp-fig-mono { font-family: var(--hp-mono); }
  .hp-fig-tok { animation: hpHeroTok 5s infinite; }
  .hp-fig-bd { animation: hpHeroBd 5s infinite; }
  .hp-fig-tick { transform-box: fill-box; transform-origin: center; animation: hpHeroTick 5s infinite; }
  .hp-fig-mrow { animation: hpHeroHold 5s infinite; }
  @keyframes hpHeroTok { 0%,10% { opacity: 0; transform: translateX(0); } 16% { opacity: 1; transform: translateX(0); } 46% { opacity: 1; transform: translateX(72px); } 54%,100% { opacity: 0; transform: translateX(72px); } }
  @keyframes hpHeroBd { 0%,30% { stroke: #D8C8B4; } 36% { stroke: #8B4513; } 44%,100% { stroke: #D8C8B4; } }
  @keyframes hpHeroTick { 0%,48% { opacity: 0; transform: scale(.5); } 56% { opacity: 1; transform: scale(1); } 92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes hpHeroHold { 0%,100% { opacity: .5; } 50% { opacity: .9; } }
  .hp-hero-code { margin-top: 14px; background: #FBF7F1; border: 1px solid #E7DACA; border-radius: 8px; padding: 10px 14px; font-family: var(--hp-mono); font-size: 12px; color: #8A7A68; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .hp-hero-ok { color: #2A9D6A; }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero-fig * { animation: none !important; }
    .hp-fig-tok { opacity: 1; transform: translateX(40px); }
    .hp-fig-tick { opacity: 1; }
  }
  .hp-term-chrome { display: flex; align-items: center; gap: 6px; margin-bottom: 18px; }
  .hp-term-chrome span:not(.hp-term-label) { width: 11px; height: 11px; border-radius: 50%; background: #3a3530; flex-shrink: 0; display: inline-block; }
  .hp-term-label { margin-left: 12px; font-family: var(--hp-mono); font-size: 10.5px; color: #6a655d; letter-spacing: 0.08em; }
  .hp-term-body { font-family: var(--hp-mono); font-size: 12.5px; line-height: 1.95; color: var(--hp-code-text); }
  .hp-term-line { display: block; opacity: 0; animation: hp-term 0.45s ease forwards; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hp-term-line .hp-prompt { color: var(--hp-brown-light); }
  .hp-term-line .hp-cmd { color: #f5ebdc; }
  .hp-term-line .hp-ok { color: #6ec27a; }
  .hp-term-line .hp-key { color: #d4a574; }
  .hp-term-line .hp-str { color: #9ec5e8; }
  .hp-term-line .hp-comm { color: #6a655d; }
  .hp-term-line:nth-child(1)  { animation-delay: 0.2s; }
  .hp-term-line:nth-child(2)  { animation-delay: 0.5s; }
  .hp-term-line:nth-child(3)  { animation-delay: 0.8s; }
  .hp-term-line:nth-child(4)  { animation-delay: 1.1s; }
  .hp-term-line:nth-child(5)  { animation-delay: 1.4s; }
  .hp-term-line:nth-child(6)  { animation-delay: 1.7s; }
  .hp-term-line:nth-child(7)  { animation-delay: 2.0s; }
  .hp-term-line:nth-child(8)  { animation-delay: 2.3s; }
  .hp-term-line:nth-child(9)  { animation-delay: 2.6s; }
  .hp-term-line:nth-child(10) { animation-delay: 2.9s; }
  @keyframes hp-term { from { opacity: 0; transform: translateX(-3px); } to { opacity: 1; transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .hp-term-line { opacity: 1; animation: none; } }

  /* ECO STRIP */
  .hp-eco { border-top: 0.5px solid var(--hp-line); border-bottom: 0.5px solid var(--hp-line); background: var(--hp-cream-d); padding: 56px 0; }
  .hp-eco-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; display: flex; align-items: center; gap: 56px; flex-wrap: wrap; }
  .hp-eco-label { font-family: var(--hp-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--hp-brown); display: flex; align-items: center; gap: 12px; }
  .hp-eco-label::before { content: ""; width: 28px; height: 1px; background: var(--hp-brown); }
  .hp-eco-items { display: flex; gap: 44px; flex-wrap: wrap; flex: 1; }
  .hp-eco-item { display: flex; flex-direction: column; gap: 4px; }
  .hp-eco-name { font-family: var(--hp-display); font-size: 28px; font-weight: 700; color: #000; letter-spacing: -0.025em; line-height: 1; }
  .hp-eco-meta { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--hp-text-3); }

  /* SECTION COMMON */
  .hp-block { max-width: 1320px; margin: 0 auto; padding: 120px 40px; }
  .hp-eyebrow { font-family: var(--hp-mono); font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--hp-brown); margin: 0 0 20px; display: flex; align-items: center; gap: 12px; }
  .hp-eyebrow::before { content: ""; width: 32px; height: 1px; background: var(--hp-brown); }
  .hp-eyebrow.hp-on-dark { color: var(--hp-brown-light); }
  .hp-eyebrow.hp-on-dark::before { background: var(--hp-brown-light); }
  .hp-h2 { font-family: var(--hp-display); font-size: 56px; line-height: 1.08; letter-spacing: -0.03em; color: #000; margin: 0 0 24px; font-weight: 700; }
  .hp-h2.hp-on-dark { color: var(--hp-cream); }
  .hp-sub { font-size: 16px; line-height: 1.85; color: var(--hp-text-2); max-width: 720px; margin: 0 0 56px; }
  .hp-sub.hp-on-dark { color: #b8b3a9; }
  .hp-inline-code { font-family: var(--hp-mono); font-size: 12.5px; color: var(--hp-brown); }

  /* DOORS */
  .hp-doors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 56px; }
  .hp-door { background: #fff; border: 0.5px solid var(--hp-line); border-radius: 22px; transition: all 0.2s; display: flex; flex-direction: column; overflow: hidden; }
  .hp-door:hover { border-color: var(--hp-brown); transform: translateY(-3px); box-shadow: 0 16px 40px rgba(139, 69, 19, 0.10); }
  .hp-door-top { background: var(--hp-cream-d); padding: 60px 36px 52px; display: flex; flex-direction: column; align-items: center; gap: 32px; }
  .hp-door-icon { color: var(--hp-brown); }
  .hp-door-icon svg { width: 56px; height: 56px; display: block; }
  .hp-door-name { font-family: var(--hp-display); font-size: 48px; font-weight: 700; color: #000; letter-spacing: -0.03em; line-height: 1; }
  .hp-door-bottom { padding: 36px; display: flex; flex-direction: column; gap: 14px; flex-grow: 1; background: #fff; }
  .hp-door-aud { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.24em; color: var(--hp-brown); display: inline-flex; align-items: center; gap: 8px; }
  .hp-door-aud::before { content: "●"; font-size: 8px; }
  .hp-door-tag { font-family: var(--hp-display); font-size: 22px; font-weight: 700; color: #000; letter-spacing: -0.02em; line-height: 1.45; margin: 4px 0 0; }
  .hp-door-desc { font-size: 13.5px; color: var(--hp-text-3); line-height: 1.75; margin: 0; }
  .hp-door-url { font-family: var(--hp-mono); font-size: 11.5px; color: var(--hp-text-2); margin-top: auto; padding-top: 20px; border-top: 0.5px solid var(--hp-line); display: inline-flex; align-items: center; gap: 6px; }

  /* MECHANISM — 3 phase cards with per-phase mini diagrams */
  .hp-mech { background: var(--hp-code-bg); color: var(--hp-code-text); padding: 120px 0; }
  .hp-mech-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; }

  .hp-mech-flow { display: grid; grid-template-columns: 1fr 32px 1fr 32px 1fr; gap: 0; align-items: stretch; margin-top: 56px; }
  .hp-mech-phase { background: #2A2118; border: 0.5px solid #3a3025; border-radius: 16px; padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 14px; }
  .hp-mech-viz { padding-bottom: 18px; margin-bottom: 4px; border-bottom: 0.5px solid #3a3025; }
  .hp-mech-viz svg { width: 100%; height: auto; display: block; }
  .hp-mech-step { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.24em; color: var(--hp-brown-light); }
  .hp-mech-title { font-family: var(--hp-display); font-size: 22px; font-weight: 600; color: var(--hp-cream); letter-spacing: -0.015em; line-height: 1.35; margin: 0; }
  .hp-mech-desc { font-size: 13.5px; line-height: 1.8; color: #c8c2b6; margin: 0; }
  .hp-mech-prims { display: flex; flex-direction: column; gap: 6px; padding-top: 16px; border-top: 0.5px solid #3a3025; margin-top: auto; }
  .hp-mech-prim { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--hp-brown-light); display: flex; align-items: center; gap: 8px; }
  .hp-mech-prim::before { content: "›"; font-size: 12px; color: var(--hp-brown); }
  .hp-mech-arrow { display: flex; align-items: center; justify-content: center; color: var(--hp-brown); font-family: var(--hp-mono); font-size: 18px; }

  /* Per-phase SVG animations — subtle, on-loop, motion-safe */
  .hp-mech-dashflow { stroke-dasharray: 3 3; animation: hp-mech-dashflow 1.4s linear infinite; }
  @keyframes hp-mech-dashflow { to { stroke-dashoffset: -12; } }

  .hp-mech-token-pulse { animation: hp-mech-tokenpulse 2.6s ease-in-out infinite; }
  @keyframes hp-mech-tokenpulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.95; }
  }

  /* Sonar halo on focal Proof tokens — 2 staggered rings that scale out and
     fade, looped. Emphasises "proof is broadcasting trust" on a quiet beat. */
  .hp-mech-halo {
    transform-origin: center;
    transform-box: fill-box;
    animation: hp-mech-halo 3s ease-out infinite;
  }
  .hp-mech-halo--delay { animation-delay: 1.5s; }
  @keyframes hp-mech-halo {
    0% { opacity: 0.55; transform: scale(1); }
    80%, 100% { opacity: 0; transform: scale(1.7); }
  }

  .hp-mech-zk-pulse { animation: hp-mech-zkpulse 2.4s ease-in-out infinite; }
  @keyframes hp-mech-zkpulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.65; }
  }

  .hp-mech-dot-fade { animation: hp-mech-dotfade 2.6s ease-in-out infinite; }
  .hp-mech-dot-fade:nth-of-type(2n) { animation-delay: 0.6s; }
  .hp-mech-dot-fade:nth-of-type(3n) { animation-delay: 1.2s; }
  @keyframes hp-mech-dotfade {
    0%, 100% { opacity: 0.18; }
    50% { opacity: 0.38; }
  }

  .hp-mech-check-glow { animation: hp-mech-checkglow 2.6s ease-in-out infinite; }
  @keyframes hp-mech-checkglow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-mech-dashflow,
    .hp-mech-token-pulse,
    .hp-mech-zk-pulse,
    .hp-mech-dot-fade,
    .hp-mech-check-glow,
    .hp-mech-halo { animation: none; }
    .hp-mech-halo { opacity: 0; }
  }

  .hp-mech-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 72px; padding-top: 36px; border-top: 0.5px solid #3a3025; flex-wrap: wrap; gap: 20px; }
  .hp-mech-stack { display: flex; gap: 28px; flex-wrap: wrap; }
  .hp-mech-stack-item { font-family: var(--hp-mono); font-size: 11.5px; color: var(--hp-brown-light); letter-spacing: 0.06em; }
  .hp-mech-stack-meta { color: var(--hp-text-4); margin-left: 4px; }
  .hp-mech-cta { font-family: var(--hp-display); font-size: 13.5px; color: var(--hp-brown-light); }
  .hp-mech-cta:hover { color: var(--hp-cream); }

  /* SCHEMA TABS */
  .hp-schema-tabs { display: flex; gap: 6px; padding: 6px; background: #fff; border: 0.5px solid var(--hp-line); border-radius: 12px; flex-wrap: wrap; margin-top: 16px; }
  .hp-schema-tab { font-family: var(--hp-display); font-size: 11px; letter-spacing: 0.1em; color: var(--hp-text-3); background: transparent; border: 0; padding: 10px 16px; border-radius: 8px; cursor: pointer; transition: all 0.15s; font-weight: 500; }
  .hp-schema-tab:hover { background: var(--hp-cream-d); color: var(--hp-brown); }
  .hp-schema-tab.is-active { background: var(--hp-brown); color: var(--hp-cream); }
  .hp-tab-pill { opacity: 0.7; margin-right: 6px; font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.1em; }
  .hp-schema-pane { display: none; grid-template-columns: 1fr 0.9fr; gap: 24px; align-items: stretch; margin-top: 24px; }
  .hp-schema-pane.is-active { display: grid; }
  .hp-schema-code { background: var(--hp-code-bg); border-radius: 16px; padding: 28px 30px; font-family: var(--hp-mono); font-size: 12.5px; line-height: 1.85; color: var(--hp-code-text); overflow-x: auto; }
  .hp-schema-code .hp-jk { color: #d4a574; }
  .hp-schema-code .hp-js { color: #9ec5e8; }
  .hp-schema-code .hp-jn { color: #ddc788; }
  .hp-schema-code .hp-jp { color: #8a857d; }
  .hp-schema-side { background: #fff; border: 0.5px solid var(--hp-line); border-radius: 16px; padding: 32px 30px; display: flex; flex-direction: column; gap: 14px; }
  .hp-schema-pill { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.2em; color: var(--hp-brown); margin: 0; }
  .hp-schema-side h4 { font-family: var(--hp-display); font-size: 18px; font-weight: 600; color: #000; margin: 0; letter-spacing: -0.015em; }
  .hp-schema-side p { font-size: 13.5px; line-height: 1.8; color: var(--hp-text-2); margin: 0; }
  .hp-schema-rows { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 0.5px solid var(--hp-line); margin-top: auto; }
  .hp-schema-row { display: flex; justify-content: space-between; align-items: center; font-family: var(--hp-mono); font-size: 11px; color: var(--hp-text-3); }
  .hp-schema-row-val { color: var(--hp-brown); font-weight: 500; }

  /* BRIEF */
  .hp-brief { background: var(--hp-cream-d); padding: 120px 0; }
  .hp-brief-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; }

  /* SPOTLIGHT — 2-col grid pairing the operational lens (left) with the incident lens (right) */
  .hp-spotlight-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; }
  .hp-spotlight-col { display: flex; flex-direction: column; gap: 20px; }
  /* Column heading doubles as the section's primary CTA — large display
     type, brown accent, with a trailing arrow that tilts on hover. */
  .hp-spotlight-heading {
    font-family: var(--hp-display);
    font-size: 26px; font-weight: 600; line-height: 1.32; letter-spacing: -0.012em;
    color: #000;
    display: inline-flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
    transition: color 0.2s;
  }
  .hp-spotlight-heading-arr {
    font-family: var(--hp-display);
    font-size: 22px; color: var(--hp-brown);
    transition: transform 0.2s;
    display: inline-block;
  }
  .hp-spotlight-heading:hover { color: var(--hp-brown); }
  .hp-spotlight-heading:hover .hp-spotlight-heading-arr { transform: translateX(4px); }

  /* Use-case card (cream surface) */
  .hp-spotlight-uc {
    display: flex; flex-direction: column;
    background: #fff; border: 0.5px solid var(--hp-line); border-radius: 18px;
    padding: 32px 32px 28px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    flex: 1;
  }
  .hp-spotlight-uc:hover { border-color: var(--hp-brown); transform: translateY(-2px); box-shadow: 0 16px 36px rgba(139, 69, 19, 0.08); }
  .hp-spotlight-uc-pillar {
    font-family: var(--hp-mono); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--hp-brown); margin: 0 0 14px;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .hp-spotlight-uc-pillar::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--hp-brown); }
  .hp-spotlight-uc-h {
    font-family: var(--hp-display); font-size: 22px; font-weight: 600;
    line-height: 1.32; letter-spacing: -0.012em; color: #000; margin: 0 0 12px;
  }
  .hp-spotlight-uc-summary {
    font-size: 14px; line-height: 1.7; color: var(--hp-text-3); margin: 0 0 18px;
  }
  .hp-spotlight-uc-cta {
    font-family: var(--hp-display); font-size: 13.5px; color: var(--hp-brown); font-weight: 500;
    margin-top: auto;
  }
  .hp-spotlight-uc:hover .hp-spotlight-uc-cta { color: var(--hp-brown-deep); }

  /* Brief card (dark surface) */
  .hp-spotlight-brief {
    display: flex; flex-direction: column;
    background: var(--hp-code-bg); border-radius: 18px;
    padding: 32px 32px 28px;
    transition: transform 0.2s, box-shadow 0.2s;
    flex: 1;
  }
  .hp-spotlight-brief:hover { transform: translateY(-2px); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18); }
  .hp-spotlight-brief .hp-brief-feat-meta { margin: 0 0 12px; }
  .hp-spotlight-brief .hp-brief-feat-h { font-size: 22px; line-height: 1.32; margin: 0 0 12px; }
  .hp-spotlight-brief .hp-brief-feat-tldr {
    font-size: 14px; margin: 0 0 18px;
    display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .hp-spotlight-brief .hp-brief-feat-cta { margin-top: auto; }

  .hp-brief-feat-meta { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--hp-brown-light); }
  .hp-brief-feat-h { font-family: var(--hp-display); font-size: 26px; font-weight: 600; line-height: 1.35; letter-spacing: -0.018em; color: var(--hp-cream); }
  .hp-brief-feat-tldr { font-size: 14px; line-height: 1.8; color: #b8b3a9; max-width: 720px; }
  .hp-brief-feat-cta { font-family: var(--hp-display); font-size: 13.5px; color: var(--hp-brown-light); white-space: nowrap; }

  .hp-brief-bottom { margin-top: 28px; display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: 16px; }
  .hp-brief-wp { font-size: 13px; color: var(--hp-text-3); }
  .hp-brief-wp a { color: var(--hp-brown); text-decoration: underline; text-underline-offset: 3px; }

  /* CLOSING */
  .hp-closing { background: #0a0807; padding: 120px 40px; text-align: center; }
  .hp-closing-inner { max-width: 920px; margin: 0 auto; }
  .hp-closing-eyebrow { font-family: var(--hp-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--hp-brown-light); margin: 0 0 22px; }
  .hp-closing-h { font-family: var(--hp-display); font-size: 56px; font-weight: 700; line-height: 1.14; letter-spacing: -0.028em; color: var(--hp-cream); margin: 0 0 20px; }
