---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import HomeSchemaOrg from "@/components/HomeSchemaOrg";
import HeroCover from "../assets/cover.jpg";
import WhyBg from "../assets/rag.jpg";
import Trust402Bg from "../assets/trust402-canyon.jpg";
import FinanceBg from "../assets/finance-iceberg.jpg";

export interface IndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  description: string;
  featured: Array<{
    cover?: string;
    category: string;
    date: string;
    title: string;
    abstract: string;
    slug: string;
  }>;
  mini: Array<{
    category: string;
    date: string;
    title: string;
    slug: string;
  }>;
  layerGuideLinks: ReadonlyArray<string>;
}

const { locale, t, base, description, featured, mini, layerGuideLinks } = Astro.props as IndexTemplateProps;
const ix = t.index;

const heroCta = "#demos";
const wpLink = locale === "ja"
  ? `${base}/blog/whitepaper-v1-prove-ai-decisions/`
  : "/blog/whitepaper-v1-prove-ai-decisions/";
const trust402Href = "/trust402/";
const trust402ProductHref = "/trust402/";
const financeHref = `${base}/blog/verifiable-origin-bridge-exploits-2026/`;
const financeAnalysisHref = `${base}/blog/verifiable-origin-bridge-exploits-2026/`;
const specsHref = `${base}/blog/lemma-oracle-specs/`;
const partnerHref = `${base}/services/`;
const featuredLg = featured[0];
const featuredAside = featured.slice(1, 3);
---

<Layout locale={locale} metaType="home" description={description}>
  <HomeSchemaOrg description={description} base={base} />
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main>
    <!-- ─── HERO ─── -->
    <section class="hero">
      <div class="hero-bg" id="heroBg" style={`background-image: url(${HeroCover.src})`}></div>
      <div class="hero-overlay"></div>
      <div class="hero-content" id="heroContent">
        <div class="hero-eyebrow">
          <span class="hero-live-dot"></span>
          {ix.hero.liveBadge}
        </div>
        <h1 class="hero-h1">
          {ix.hero.h1Line1}<br/>{ix.hero.h1Line2}
        </h1>
        <p class="hero-sub">{ix.hero.sub}</p>

        <div class="hero-marks">
          {ix.hero.marks.map((mark) => (
            <span class="mark"><span class="mark-dot"></span>{mark}</span>
          ))}
        </div>

        <div class="hero-divider"></div>

        <p class="hero-status">
          <span>{ix.hero.statusLicense}</span>
          <span class="hero-status-sep">·</span>
          <span class="hero-status-mono">{ix.hero.statusNpm}</span>
        </p>

        <div class="hero-cta">
          <a href={heroCta} class="btn btn-primary">{ix.hero.primaryCta}</a>
          <a href={wpLink} class="btn btn-ghost-light">{ix.hero.secondaryCta}</a>
        </div>
      </div>
      <div class="hero-scroll">{ix.hero.scroll}</div>
    </section>

    <!-- ─── DEMO SPOTLIGHT ─── -->
    <section id="demos" class="demos">
      <div class="demos-intro reveal">
        <div class="section-label">{ix.demos.label}</div>
        <h2 class="section-h2">{ix.demos.h2Line1}<br/>{ix.demos.h2Line2}</h2>
        <p class="section-lede">{ix.demos.lede}</p>
      </div>

      <div class="demos-grid">
        <a href={trust402Href} class="demo demo-trust402">
          <div class="demo-bg" style={`background-image: url(${Trust402Bg.src})`}></div>
          <div class="demo-overlay"></div>
          <div class="demo-content">
            <div class="demo-tag">{ix.demos.trust402.tag}</div>
            <h3 class="demo-title">{ix.demos.trust402.titleLine1}<br/>{ix.demos.trust402.titleLine2}</h3>
            <p class="demo-claim">{ix.demos.trust402.claim}</p>
            <div class="demo-meta">
              {ix.demos.trust402.metaPills.map((pill, i) => (
                <span class={`meta-pill${i === 2 ? " mono" : ""}`}>{pill}</span>
              ))}
            </div>
            <div class="demo-cta">
              <span class="btn btn-primary">{ix.demos.trust402.primaryCta}</span>
              <span class="btn btn-ghost-light">{ix.demos.trust402.secondaryCta}</span>
            </div>
          </div>
        </a>

        <a href={financeHref} class="demo demo-finance">
          <div class="demo-bg" style={`background-image: url(${FinanceBg.src})`}></div>
          <div class="demo-overlay"></div>
          <div class="demo-content">
            <div class="demo-tag">{ix.demos.finance.tag}</div>
            <h3 class="demo-title">{ix.demos.finance.titleLine1}<br/>{ix.demos.finance.titleLine2}</h3>
            <p class="demo-claim">{ix.demos.finance.claim}</p>
            <div class="demo-meta">
              {ix.demos.finance.metaPills.map((pill) => (
                <span class="meta-pill">{pill}</span>
              ))}
            </div>
            <div class="demo-cta">
              <span class="btn btn-primary">{ix.demos.finance.primaryCta}</span>
              <span class="btn btn-ghost-light">{ix.demos.finance.secondaryCta}</span>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- ─── HOW IT WORKS / ARCHITECTURE ─── -->
    <section id="how" class="how reveal">
      <div class="how-head">
        <div class="section-label">{ix.architecture.label}</div>
        <h2 class="section-h2 how-h2">{ix.architecture.h2}</h2>
        <p class="section-lede how-lede">{ix.architecture.lede}</p>
      </div>

      <div class="how-layers">
        {ix.architecture.layers.map((layer, i) => (
          <div class="layer">
            <div class="layer-num">{layer.num}</div>
            <div class="layer-title" set:html={layer.title.replace(/、/, "、<br/>")}></div>
            <div class="layer-body">
              {layer.body}
              {layerGuideLinks[i] && (
                <a href={layerGuideLinks[i]} class="layer-link">{ix.architecture.guideCta}</a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── WHY IT MATTERS ─── -->
    <section id="why" class="why reveal">
      <div class="why-bg" style={`background-image: url(${WhyBg.src})`}></div>
      <div class="why-overlay"></div>
      <div class="why-inner">
        <div class="why-label">{ix.why.label}</div>
        <h2 class="why-h2">{ix.why.h2Line1}<br/>{ix.why.h2Line2}</h2>
        <div class="why-rule"></div>
        <p class="why-body">{ix.why.body}</p>
        <a href={specsHref} class="why-btn">{ix.why.ctaText}</a>

        <div class="why-metrics">
          {ix.why.metrics.map((metric) => (
            <div class="why-metric">
              <div class="why-metric-num">
                {metric.num}
                {metric.unit && <span class="why-metric-unit">{metric.unit}</span>}
              </div>
              <div class="why-metric-sub">{metric.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── ESSAYS ─── -->
    <section id="essays" class="essays reveal">
      <div class="essays-intro">
        <div class="section-label">{ix.essays.tag}</div>
        <h2 class="section-h2">{ix.essays.h2}</h2>
        <p class="section-lede">{ix.essays.p}</p>
      </div>

      {featuredLg && (
        <div class="essays-featured">
          <a href={`${base}/blog/${featuredLg.slug}/`} class="essay-card essay-card-lg">
            <div
              class="essay-thumb"
              style={`background-image: url('${featuredLg.cover ?? ""}')`}
            ></div>
            <div class="essay-body-lg">
              <div class="essay-meta">
                <span class="essay-cat">{featuredLg.category}</span>
                <span class="essay-date">{featuredLg.date}</span>
              </div>
              <h3 class="essay-title essay-title-lg">{featuredLg.title}</h3>
              <p class="essay-excerpt">{featuredLg.abstract}</p>
            </div>
          </a>

          <div class="essays-aside">
            {featuredAside.map((post) => (
              <a href={`${base}/blog/${post.slug}/`} class="essay-card essay-card-sm">
                <div class="essay-meta">
                  <span class="essay-cat">{post.category}</span>
                  <span class="essay-date">{post.date}</span>
                </div>
                <h3 class="essay-title essay-title-sm">{post.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="essays-list">
        {mini.map((post) => (
          <a href={`${base}/blog/${post.slug}/`} class="essay-card essay-card-mini">
            <div class="essay-meta">
              <span class="essay-cat">{post.category}</span>
              <span class="essay-date">{post.date}</span>
            </div>
            <h3 class="essay-title essay-title-mini">{post.title}</h3>
          </a>
        ))}
      </div>
    </section>

    <!-- ─── PARTNER PROGRAM ─── -->
    <section class="partner reveal">
      <div class="partner-inner">
        <div class="section-label partner-label">{ix.partner.label}</div>
        <h2 class="partner-h2">{ix.partner.h2Line1}<br/>{ix.partner.h2Line2}</h2>
        <div class="partner-rule"></div>
        <p class="partner-body">{ix.partner.body}</p>
        <div class="partner-cta">
          <a href={partnerHref} class="btn btn-primary">{ix.partner.primaryCta}</a>
          <a href={wpLink} class="btn btn-ghost-light">{ix.partner.secondaryCta}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* ─── SHARED TOKENS (extends global :root) ─── */
  :global(:root) { --accent-lt: #A0522D; }

  main { color: var(--gray-800, #1A1A1A); }

  /* ─── BUTTONS ─── */
  .btn {
    display: inline-block;
    padding: 14px 32px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 0;
    border: 1px solid transparent;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    cursor: pointer;
    text-decoration: none;
  }
  .btn-primary { background: #fff; color: #000; }
  .btn-primary:hover { background: var(--accent); color: #fff; }
  .btn-ghost-light {
    background: transparent;
    color: #fff;
    border-color: rgba(255,255,255,0.5);
  }
  .btn-ghost-light:hover { border-color: #fff; background: rgba(255,255,255,0.08); }

  /* ─── SECTION LABELS / TYPOGRAPHY ─── */
  .section-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 24px;
  }
  .section-h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--black);
    max-width: 760px;
  }
  .section-lede {
    font-size: 16px;
    line-height: 1.75;
    color: var(--gray-500);
    margin-top: 24px;
    max-width: 620px;
  }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 96px 10% 80px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: center/cover no-repeat;
    background-position: center 40%;
    filter: saturate(0.7) brightness(0.9);
    transform: scale(1.04);
    transition: transform 10s ease-out;
  }
  .hero-bg.ready { transform: scale(1); }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.95s ease, transform 0.95s ease;
  }
  .hero-content.visible { opacity: 1; transform: translateY(0); }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
    padding: 9px 16px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.22);
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 11.5px;
    backdrop-filter: blur(4px);
  }
  .hero-live-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-lt);
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(160, 82, 45, 0.25);
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 500;
    color: #fff;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-size: 17px;
    color: rgba(255,255,255,0.78);
    line-height: 1.7;
    margin-top: 28px;
    max-width: 560px;
  }
  .hero-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
    max-width: 640px;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 11px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.75);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.18);
  }
  .mark-dot {
    width: 4px;
    height: 4px;
    background: var(--accent-lt);
    flex-shrink: 0;
  }
  .hero-divider {
    width: 40px;
    height: 1px;
    background: var(--accent);
    margin: 36px 0 28px;
  }
  .hero-status {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.65);
    margin-bottom: 28px;
  }
  .hero-status-sep { color: rgba(255,255,255,0.35); }
  .hero-status-mono {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    color: rgba(255,255,255,0.85);
  }
  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-scroll {
    position: absolute;
    right: 5%;
    bottom: 32px;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    z-index: 2;
  }

  /* ─── DEMO SPOTLIGHT ─── */
  .demos { background: var(--white); }
  .demos-intro { padding: 120px 10% 80px; }
  .demos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
  }
  .demo {
    position: relative;
    padding: 80px 8%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    overflow: hidden;
    text-decoration: none;
  }
  .demo-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: saturate(0.65) brightness(0.85);
    transition: filter 0.6s ease;
  }
  .demo-trust402 .demo-bg { background-position: 60% 50%; }
  .demo-finance .demo-bg { background-position: 30% 60%; }
  .demo:hover .demo-bg { filter: saturate(0.75) brightness(0.9); }
  .demo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
  }
  .demo-trust402 .demo-overlay { background: rgba(0,0,0,0.40); }
  .demo-content { position: relative; z-index: 2; max-width: 480px; }
  .demo-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-lt);
    margin-bottom: 20px;
  }
  .demo-title {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
    color: #fff;
  }
  .demo-claim {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255,255,255,0.82);
    margin-bottom: 24px;
  }
  .demo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 24px;
  }
  .meta-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.78);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.18);
  }
  .meta-pill.mono {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 10.5px;
  }
  .demo-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .demo-cta .btn {
    padding: 10px 20px;
    font-size: 11.5px;
  }

  /* ─── HOW IT WORKS ─── */
  .how {
    background: var(--gray-50);
    padding: 96px 10%;
  }
  .how-head { max-width: 720px; margin-bottom: 48px; }
  .how-h2 { font-size: clamp(28px, 3.4vw, 36px); line-height: 1.3; }
  .how-lede { font-size: 14.5px; line-height: 1.7; }
  .how-layers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--gray-200);
  }
  .layer {
    display: grid;
    grid-template-columns: 56px 240px 1fr;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--gray-200);
  }
  .layer-num {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .layer-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
    padding-right: 20px;
  }
  .layer-body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--gray-800, #1A1A1A);
    max-width: 580px;
  }
  .layer-link {
    display: inline-block;
    margin-top: 10px;
    margin-left: 8px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: color 0.2s;
    text-decoration: none;
  }
  .layer-link:hover { color: var(--accent-lt); }

  /* ─── WHY IT MATTERS ─── */
  .why {
    position: relative;
    overflow: hidden;
    background: var(--black);
    color: #fff;
  }
  .why-bg {
    position: absolute;
    inset: 0;
    background: center/cover no-repeat;
    background-position: center 40%;
    filter: saturate(0.65) brightness(0.85);
  }
  .why-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.50) 55%, rgba(0,0,0,0.35) 100%);
  }
  .why-inner {
    position: relative;
    z-index: 2;
    padding: 96px 10%;
    max-width: 1200px;
  }
  .why-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent-lt);
    margin-bottom: 24px;
  }
  .why-h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
    margin-bottom: 28px;
    letter-spacing: -0.01em;
    max-width: 640px;
  }
  .why-rule {
    width: 48px;
    height: 1px;
    background: var(--accent-lt);
    margin-bottom: 24px;
  }
  .why-body {
    font-size: 14.5px;
    line-height: 1.8;
    color: rgba(255,255,255,0.78);
    max-width: 520px;
    margin-bottom: 32px;
  }
  .why-btn {
    display: inline-block;
    background: #fff;
    color: #000;
    padding: 12px 28px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    margin-bottom: 56px;
    transition: background 0.2s, color 0.2s;
  }
  .why-btn:hover { background: var(--accent-lt); color: #fff; }
  .why-metrics {
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,0.18);
    padding-top: 28px;
    max-width: 720px;
  }
  .why-metric-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 6px;
    line-height: 1;
  }
  .why-metric-unit {
    font-size: 13px;
    font-weight: 400;
    color: rgba(255,255,255,0.78);
    margin-left: 4px;
    font-family: var(--font-body);
  }
  .why-metric-sub {
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.02em;
  }

  /* ─── ESSAYS ─── */
  .essays {
    background: var(--gray-50);
    padding: 120px 10%;
  }
  .essays-intro { max-width: 720px; margin-bottom: 56px; }
  .essays-featured {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
    align-items: stretch;
  }
