  .hp-mech-prim { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--hp-brown-light); display: flex; align-items: center; gap: 8px; }
  .hp-mech-prim::before { content: "›"; font-size: 12px; color: var(--hp-brown); }
  .hp-mech-arrow { display: flex; align-items: center; justify-content: center; color: var(--hp-brown); font-family: var(--hp-mono); font-size: 18px; }

  /* Per-phase SVG animations — subtle, on-loop, motion-safe */
  .hp-mech-dashflow { stroke-dasharray: 3 3; animation: hp-mech-dashflow 1.4s linear infinite; }
  @keyframes hp-mech-dashflow { to { stroke-dashoffset: -12; } }

  .hp-mech-token-pulse { animation: hp-mech-tokenpulse 2.6s ease-in-out infinite; }
  @keyframes hp-mech-tokenpulse {
