---
import type { Locale, Translations } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HubSpotDrawer from "../components/HubSpotDrawer.astro";
import CtaSection from "../components/CtaSection.astro";
import HeroCover from "../assets/cover.jpg";

export interface IndexTemplateProps {
  locale: Locale;
  t: Translations;
  base: string;
  description: string;
  recentPosts: ReadonlyArray<{
    readonly category: string;
    readonly date: string;
    readonly title: string;
    readonly slug: string;
  }>;
}

const { locale, t, base, description, recentPosts } = Astro.props as IndexTemplateProps;
const ix = t.index;

const heroCta = "#featured";
const trust402Href = "/trust402/";
const blogIndexHref = `${base}/blog/`;
const thinking = recentPosts.slice(0, 6);
---

<Layout locale={locale} metaType="home" description={description}>
  <Navigation locale={locale} t={t.nav} base={base} />
  <HubSpotDrawer />

  <main>
    <!-- ─── HERO ─── -->
    <section class="hero">
      <img
        class="hero-bg"
        id="heroBg"
        src={HeroCover.src}
        alt=""
        width={HeroCover.width}
        height={HeroCover.height}
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-overlay"></div>
      <div class="hero-content" id="heroContent">
        <h1 class="hero-h1">{ix.hero.h1}</h1>
        <p class="hero-sub">
          <strong>{ix.hero.subLine1}</strong><br/>{ix.hero.subLine2}
        </p>
        <a href={heroCta} class="btn btn-primary">{ix.hero.primaryCta} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ─── FEATURED PANEL (Trust402) ─── -->
    <section id="featured" class="featured">
      <a class="featured-panel reveal" href={trust402Href}>
        <div class="featured-content">
          <div class="featured-eyebrow">{ix.featured.eyebrow}</div>
          <h2 class="featured-title">{ix.featured.title}</h2>
          <p class="featured-subtitle">{ix.featured.subtitle}</p>
          <span class="featured-cta">{ix.featured.cta} <span aria-hidden="true">→</span></span>
        </div>
        <div class="featured-visual" aria-hidden="true"></div>
      </a>
    </section>

    <!-- ─── TRUSTED BY ─── -->
    <section class="trusted">
      <div class="trusted-inner">
        <div class="trusted-label">{ix.trustedBy.label}</div>
        <div class="trusted-list reveal">
          {ix.trustedBy.items.map((item) => (
            <span class="trusted-item">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── LEMMA FOR (Audience cards) ─── -->
    <section class="for-x">
      <div class="for-x-inner reveal">
        <h2 class="for-x-h2">{ix.lemmaFor.h2Line1}<br/>{ix.lemmaFor.h2Line2}</h2>
        <p class="for-x-lead">{ix.lemmaFor.lead}</p>

        <div class="for-x-grid">
          {ix.lemmaFor.cards.map((card) => (
            <a class="for-x-card" href={card.href}>
              <div class="for-x-card-content">
                <div class="for-x-card-tag">{card.tag}</div>
                <h3 class="for-x-card-title">{card.titleLine1}<br/>{card.titleLine2}</h3>
                <p class="for-x-card-body">{card.body}</p>
                <div class="for-x-card-cases">{card.cases}</div>
              </div>
              <span class="for-x-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="for-x-see-all">
          <a class="for-x-see-all-link" href={ix.lemmaFor.seeAllHref}>{ix.lemmaFor.seeAll}</a>
        </div>
      </div>
    </section>

    <!-- ─── HOW IT WORKS (one-liner) ─── -->
    <section class="how">
      <div class="how-inner reveal">
        <p class="how-text">{ix.how.text}</p>
        <a class="how-link" href={ix.how.href}>{ix.how.link} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ─── RECENT THINKING ─── -->
    <section class="thinking">
      <div class="thinking-inner reveal">
        <div>
          <h2 class="thinking-title">{ix.thinking.title}</h2>
          <p class="thinking-lead">{ix.thinking.lead}</p>
          <a class="thinking-see-all" href={blogIndexHref}>{ix.thinking.seeAll}</a>
        </div>
        <div class="thinking-list">
          {thinking.map((post) => (
            <a class="thinking-item" href={`${base}/blog/${post.slug}/`}>
              <span class="thinking-item-title">{post.title}</span>
              <span class="thinking-item-meta">{post.date}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── PARTNER PROGRAM / DISCOVERY CALL CTA ─── -->
    <div id="contact">
      <CtaSection bgImageSrc={HeroCover.src} base={base} locale={locale} />
    </div>
  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<style>
  /* Cormorant Garamond (display) is kept; h1/h2/h3 use --font-display. */
  main { color: var(--gray-800, #1A1A1A); }

  /* ─── BUTTONS ─── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: background 0.25s ease, color 0.25s ease;
    cursor: pointer;
    text-decoration: none;
  }
  .btn-primary { background: #fff; color: #000; }
  .btn-primary:hover { background: var(--accent); color: #fff; }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: 160px 8% 100px;
    overflow: hidden;
    background: var(--black);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.7) brightness(0.9);
    transform: scale(1.04);
    transition: transform 10s ease-out;
  }
  .hero-bg.ready { transform: scale(1); }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 980px;
    margin: 0 auto;
    width: 100%;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.95s ease, transform 0.95s ease;
  }
  .hero-content.visible { opacity: 1; transform: translateY(0); }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 6.5vw, 72px);
    font-weight: 500;
    color: #fff;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 28px;
  }
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.2vw, 18px);
    color: rgba(255,255,255,0.72);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 580px;
  }
  .hero-sub strong { color: #fff; font-weight: 500; }

  /* ─── FEATURED PANEL ─── */
  .featured {
    background: var(--white);
    padding: 60px 8% 60px;
  }
  .featured-panel {
    max-width: 1280px;
    margin: 0 auto;
    background: #000;
    color: #fff;
    overflow: hidden;
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: 480px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
  }
  .featured-panel:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
  }
  .featured-content {
    padding: 72px 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-eyebrow {
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: #fff;
    margin-bottom: 22px;
  }
  .featured-subtitle {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.1vw, 16px);
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 420px;
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #000;
    padding: 12px 28px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: flex-start;
    transition: all 0.25s ease;
  }
  .featured-panel:hover .featured-cta {
    background: var(--accent);
    color: #fff;
  }
  .featured-visual {
    position: relative;
    overflow: hidden;
    background: #000;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }
  .featured-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px, 48px 48px;
    pointer-events: none;
  }
  .featured-visual::after {
    content: "x402";
    position: absolute;
    right: 48px;
    bottom: 36px;
    font-family: var(--font-body);
    font-size: clamp(72px, 12vw, 160px);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.07);
    letter-spacing: -0.03em;
    line-height: 1;
    pointer-events: none;
  }
  @media (max-width: 900px) {
    .featured-panel { grid-template-columns: 1fr; min-height: auto; }
    .featured-content { padding: 56px 40px 40px; }
    .featured-visual { height: 280px; }
    .featured-visual::after { right: 28px; bottom: 24px; }
  }

  /* ─── TRUSTED BY ─── */
  .trusted {
    background: var(--white);
    padding: 80px 8% 100px;
  }
  .trusted-inner { max-width: 1200px; margin: 0 auto; }
  .trusted-label {
    color: var(--gray-500);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 32px;
    text-align: center;
  }
  .trusted-list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--gray-200);
    border-bottom: 1px solid var(--gray-200);
  }
  .trusted-item {
    text-align: center;
    color: var(--gray-700, #5F5F5F);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 32px 16px;
    border-right: 1px solid var(--gray-200);
    transition: color 0.2s, background 0.2s;
  }
  .trusted-item:last-child { border-right: none; }
  .trusted-item:hover {
    color: var(--gray-800);
    background: rgba(0,0,0,0.02);
  }
  @media (max-width: 768px) {
    .trusted-list { grid-template-columns: 1fr 1fr; }
    .trusted-item { border-right: none; border-bottom: 1px solid var(--gray-200); }
    .trusted-item:nth-child(odd) { border-right: 1px solid var(--gray-200); }
    .trusted-item:nth-last-child(-n+2) { border-bottom: none; }
  }

  /* ─── LEMMA FOR (audience cards) ─── */
  .for-x {
    background: var(--gray-50);
    padding: 140px 8%;
  }
  .for-x-inner { max-width: 1200px; margin: 0 auto; }
  .for-x-h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 500;
    color: var(--gray-800);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 24px;
    max-width: 700px;
  }
  .for-x-lead {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 80px;
    max-width: 620px;
  }
  .for-x-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .for-x-grid > .for-x-card:first-child {
    grid-column: 1 / -1;
    border-top-width: 3px;
  }
  .for-x-grid > .for-x-card:first-child .for-x-card-content {
    max-width: 760px;
  }
  .for-x-grid > .for-x-card:first-child .for-x-card-title {
    font-size: clamp(28px, 3vw, 32px);
  }
  .for-x-card {
    background: #fff;
    border-top: 2px solid var(--accent);
    padding: 48px 40px 40px;
    transition: background 0.25s ease, transform 0.25s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 280px;
    text-decoration: none;
    color: inherit;
  }
  .for-x-card:hover {
    background: var(--accent-bg);
    transform: translateY(-2px);
  }
  .for-x-card-tag {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .for-x-card-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--gray-800);
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }
  .for-x-card-body {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 32px;
  }
  .for-x-card-cases {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 13px;
    line-height: 1.85;
    margin-bottom: 28px;
    border-top: 1px solid var(--gray-200);
    padding-top: 20px;
  }
  .for-x-card-arrow {
    color: var(--gray-500);
    font-size: 18px;
    align-self: flex-end;
    transition: color 0.25s, transform 0.25s;
  }
  .for-x-card:hover .for-x-card-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
  .for-x-see-all {
    margin-top: 40px;
    text-align: right;
  }
  .for-x-see-all-link {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.25s;
  }
  .for-x-see-all-link:hover { gap: 12px; }
  @media (max-width: 1024px) {
    .for-x-grid { grid-template-columns: 1fr; }
    .for-x-grid > .for-x-card:first-child { grid-column: auto; }
    .for-x-see-all { text-align: left; }
  }

  /* ─── HOW (one-liner) ─── */
  .how {
    background: var(--white);
    padding: 120px 8%;
    text-align: center;
  }
  .how-inner { max-width: 700px; margin: 0 auto; }
  .how-text {
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 500;
    color: var(--gray-800);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .how-link {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.25s;
  }
  .how-link:hover { gap: 12px; }

  /* ─── RECENT THINKING ─── */
  .thinking {
    background: var(--gray-50);
    padding: 140px 8%;
  }
  .thinking-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 80px;
    align-items: start;
  }
  .thinking-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 38px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--gray-800);
    margin-bottom: 16px;
  }
  .thinking-lead {
    font-family: var(--font-body);
    color: var(--gray-700, #5F5F5F);
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .thinking-see-all {
    font-family: var(--font-body);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .thinking-list {
    display: flex;
    flex-direction: column;
  }
  .thinking-item {
    padding: 28px 0;
    border-bottom: 1px solid var(--gray-200);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.25s;
  }
  .thinking-item:hover { padding-left: 12px; }
  .thinking-item:first-child { padding-top: 0; }
  .thinking-item:last-child { border-bottom: none; }
  .thinking-item-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--gray-800);
    letter-spacing: -0.005em;
  }
  .thinking-item-meta {
    font-family: var(--font-body);
    color: var(--gray-500);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .thinking-inner { grid-template-columns: 1fr; gap: 40px; }
  }

  /* ─── REVEAL ─── */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.on { opacity: 1; transform: translateY(0); }

  /* ─── MOBILE ─── */
  @media (max-width: 640px) {
    .hero { padding: 140px 6% 80px; }
    .featured { padding: 40px 6%; }
    .featured-content { padding: 48px 28px 32px; }
    .trusted { padding: 64px 6% 80px; }
    .for-x { padding: 100px 6%; }
    .how { padding: 80px 6%; }
    .thinking { padding: 100px 6%; }
  }
</style>

<script is:inline>
  window.addEventListener("load", function () {
    var bg = document.getElementById("heroBg");
    var content = document.getElementById("heroContent");
    if (bg) bg.classList.add("ready");
    setTimeout(function () { if (content) content.classList.add("visible"); }, 150);
  });

  var io = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("on");
        io.unobserve(entry.target);
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
  );

  document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });
</script>
