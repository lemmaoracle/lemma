// ── Routes ────────────────────────────────────────────────────────
const contactHref = DISCOVERY_CALL_URL[locale];
const useCasesHref = `${base}/solutions/use-cases/`;
const pillarsHref = `${base}/pillars/`;
const guidesHref = `${base}/guides/`;
const trust402Href = base ? `${base}/trust402/` : "/trust402/";
const industriesHref = `${base}/solutions/`;
const sealHref = `${base}/seal/`;
const briefIndexHref = `${base}/critical/briefs/`;
const whitepaperHref =
  locale === "ja" ? "https://tally.so/r/xX0VYv" : "https://tally.so/r/7RJXdR";
// §8 closing CTAs. JA books a Discovery Call; EN has no call staff, so it
// sends visitors straight to the products to try them hands-on.
const closingPrimaryHref = locale === "ja" ? contactHref : sealHref;
const closingSecondaryHref = locale === "ja" ? whitepaperHref : trust402Href;

// ── Latest Critical Brief (featured row) ──────────────────────────
// Slug enumeration + sort uses the JA collection (source of truth for brief
// numbers / dates). The TL;DR teaser, however, has to come from the
// locale-appropriate body — on the EN homepage we prefer the entry from
// `critical-briefs-en` so the teaser isn't JA text, falling back to the JA
// body for briefs that have not yet been translated.
const allBriefs = await getCollection("critical-briefs");
const briefsByDate = [...allBriefs].sort((a, b) => {
  const diff = b.data.published.getTime() - a.data.published.getTime();
  return diff !== 0 ? diff : b.data.brief_no - a.data.brief_no;
});
const featured = briefsByDate[0];
const enBriefMap = isJa ? null : await getEnBriefMap();
const featuredForBody = featured
  ? (enBriefMap?.get(featured.id) ?? featured)
  : null;
const featuredTldr = featuredForBody ? extractTldr(featuredForBody.body ?? "", 180) : "";
const featuredHref = featured ? `${base}/critical/briefs/${featured.id}/` : briefIndexHref;
const featuredTitle = featured
  ? (isJa ? featured.data.title : (featured.data.title_en ?? featured.data.title))
  : "";
const featuredDate = featured ? featured.data.published.toISOString().slice(0, 10) : "";

// ── Featured use case for the spotlight pair (operational lens) ────
const SPOTLIGHT_USE_CASE_SLUG = "counterparty-screening";
const spotlightUseCase = await getUseCaseBySlug(SPOTLIGHT_USE_CASE_SLUG, locale);
const spotlightUseCaseHref = `${base}/solutions/use-cases/${SPOTLIGHT_USE_CASE_SLUG}/`;
const allPillars = getAllPillars();
const spotlightUseCasePillar = spotlightUseCase
  ? allPillars.find((p) => p.slug === spotlightUseCase.pillar)
  : undefined;

