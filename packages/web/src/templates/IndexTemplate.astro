  .hp-schema-tab:hover { background: var(--hp-cream-d); color: var(--hp-brown); }
  .hp-schema-tab.is-active { background: var(--hp-brown); color: var(--hp-cream); }
  .hp-tab-pill { opacity: 0.7; margin-right: 6px; font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.1em; }
  .hp-schema-pane { display: none; grid-template-columns: 1fr 0.9fr; gap: 24px; align-items: stretch; margin-top: 24px; }
  .hp-schema-pane.is-active { display: grid; }
  .hp-schema-code { background: var(--hp-code-bg); border-radius: 16px; padding: 28px 30px; font-family: var(--hp-mono); font-size: 12.5px; line-height: 1.85; color: var(--hp-code-text); overflow-x: auto; }
  .hp-schema-code .hp-jk { color: #d4a574; }
  .hp-schema-code .hp-js { color: #9ec5e8; }
  .hp-schema-code .hp-jn { color: #ddc788; }
  .hp-schema-code .hp-jp { color: #8a857d; }
