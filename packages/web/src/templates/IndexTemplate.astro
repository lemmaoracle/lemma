  .hp-mech-viz svg { width: 100%; height: auto; display: block; }
  .hp-mech-step { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.24em; color: var(--hp-brown-light); }
  .hp-mech-title { font-family: var(--hp-display); font-size: 22px; font-weight: 600; color: var(--hp-cream); letter-spacing: -0.015em; line-height: 1.35; margin: 0; }
  .hp-mech-desc { font-size: 13.5px; line-height: 1.8; color: #c8c2b6; margin: 0; }
