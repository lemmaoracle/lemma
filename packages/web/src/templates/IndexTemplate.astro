  .hp-term-label { margin-left: 12px; font-family: var(--hp-mono); font-size: 10.5px; color: #6a655d; letter-spacing: 0.08em; }
  .hp-term-body { font-family: var(--hp-mono); font-size: 12.5px; line-height: 1.95; color: var(--hp-code-text); }
  .hp-term-line { display: block; opacity: 0; animation: hp-term 0.45s ease forwards; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hp-term-line .hp-prompt { color: var(--hp-brown-light); }
  .hp-term-line .hp-cmd { color: #f5ebdc; }
  .hp-term-line .hp-ok { color: #6ec27a; }
  .hp-term-line .hp-key { color: #d4a574; }
  .hp-term-line .hp-str { color: #9ec5e8; }
