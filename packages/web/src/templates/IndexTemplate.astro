  .hp-doors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 56px; }
  .hp-door { background: #fff; border: 0.5px solid var(--hp-line); border-radius: 22px; transition: all 0.2s; display: flex; flex-direction: column; overflow: hidden; }
