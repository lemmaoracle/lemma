  .hp-door-top { background: var(--hp-cream-d); padding: 60px 36px 52px; display: flex; flex-direction: column; align-items: center; gap: 32px; }
  .hp-door-icon { color: var(--hp-brown); }
  .hp-door-icon svg { width: 56px; height: 56px; display: block; }
  .hp-door-name { font-family: var(--hp-display); font-size: 48px; font-weight: 700; color: #000; letter-spacing: -0.03em; line-height: 1; }
  .hp-door-bottom { padding: 36px; display: flex; flex-direction: column; gap: 14px; flex-grow: 1; background: #fff; }
  .hp-door-aud { font-family: var(--hp-mono); font-size: 10.5px; letter-spacing: 0.24em; color: var(--hp-brown); display: inline-flex; align-items: center; gap: 8px; }
  .hp-door-aud::before { content: "●"; font-size: 8px; }
  .hp-door-tag { font-family: var(--hp-display); font-size: 22px; font-weight: 700; color: #000; letter-spacing: -0.02em; line-height: 1.45; margin: 4px 0 0; }
  .hp-door-desc { font-size: 13.5px; color: var(--hp-text-3); line-height: 1.75; margin: 0; }
  .hp-door-url { font-family: var(--hp-mono); font-size: 11.5px; color: var(--hp-text-2); margin-top: auto; padding-top: 20px; border-top: 0.5px solid var(--hp-line); display: inline-flex; align-items: center; gap: 6px; }

  /* MECHANISM — 3 phase cards with per-phase mini diagrams */
  .hp-mech { background: var(--hp-code-bg); color: var(--hp-code-text); padding: 120px 0; }
  .hp-mech-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; }

  .hp-mech-flow { display: grid; grid-template-columns: 1fr 32px 1fr 32px 1fr; gap: 0; align-items: stretch; margin-top: 56px; }
  .hp-mech-phase { background: #2A2118; border: 0.5px solid #3a3025; border-radius: 16px; padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 14px; }
