            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- SPOTLIGHT — operational lens (use case) paired with incident lens (Brief) -->
    <section class="hp-brief">
      <div class="hp-brief-inner">
        <p class="hp-eyebrow">{C.briefEyebrow}</p>
        <h2 class="hp-h2">{C.briefH2Line1}<br /><span class="hp-accent">{C.briefH2Accent}</span>{C.briefH2Tail}</h2>
        <p class="hp-sub">{C.briefSub}</p>

        <div class="hp-spotlight-grid">
          <!-- LEFT: featured use case (cream card) -->
          {spotlightUseCase && (
            <div class="hp-spotlight-col">
              <a href={useCasesHref} class="hp-spotlight-heading">{C.spotlightUcHeading} <span class="hp-spotlight-heading-arr">→</span></a>
              <a href={spotlightUseCaseHref} class="hp-spotlight-uc">
                {spotlightUseCasePillar && (
                  <span class="hp-spotlight-uc-pillar">P{spotlightUseCasePillar.order} · {spotlightUseCasePillar.title[locale]}</span>
                )}
                <h3 class="hp-spotlight-uc-h">{spotlightUseCase.title}</h3>
                <p class="hp-spotlight-uc-summary">{spotlightUseCase.cardSummary || spotlightUseCase.thesis}</p>
                <span class="hp-spotlight-uc-cta">{C.briefFeatCta} →</span>
              </a>
            </div>
          )}

          <!-- RIGHT: featured brief (dark card) -->
          {featured && (
            <div class="hp-spotlight-col">
              <a href={briefIndexHref} class="hp-spotlight-heading">{C.spotlightBriefHeading} <span class="hp-spotlight-heading-arr">→</span></a>
              <a href={featuredHref} class="hp-spotlight-brief">
                <p class="hp-brief-feat-meta">{C.briefFeatMetaPrefix} {featuredDate}</p>
                <h3 class="hp-brief-feat-h">{featuredTitle}</h3>
                <p class="hp-brief-feat-tldr">{featuredTldr}</p>
                <span class="hp-brief-feat-cta">{C.briefFeatCta} →</span>
              </a>
            </div>
          )}
        </div>

        <div class="hp-brief-bottom">
          <span class="hp-brief-wp">{C.briefWpHintBefore}<a href={whitepaperHref} target="_blank" rel="noopener">{C.briefWpHintLink}</a>{C.briefWpHintAfter}</span>
        </div>
      </div>
    </section>

    <!-- CLOSING -->
    <!-- §8 DISCOVERY CALL CTA (v29 — dark v28 register kept, content updated) -->
    <section class="hp-closing">
      <div class="hp-closing-inner">
        <p class="hp-closing-eyebrow">{C.closingEyebrow}</p>
        <h2 class="hp-closing-h">{C.closingH1Line1}<span class="hp-accent-light">{C.closingH1Accent}</span>{C.closingH1Tail}</h2>
        <p class="hp-closing-sub">{C.closingSub}</p>
        <div class="hp-closing-ctas">
          <a href={closingPrimaryHref} class="hp-btn-brown-pill">{C.closingPrimary} →</a>
          <a href={closingSecondaryHref} target={locale === "ja" ? "_blank" : undefined} rel={locale === "ja" ? "noopener" : undefined} class="hp-closing-link">{C.closingSecondary} →</a>
        </div>
        <p class="hp-closing-foot">{C.closingFootPre}<a href={briefIndexHref}>{C.closingFootBrief}</a>{C.closingFootMid}<a href={industriesHref}>{C.closingFootSolutions}</a></p>
      </div>
    </section>

  </main>

  <Footer locale={locale} t={t.nav} footerT={t.footer} base={base} />
</Layout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".hp-schema-tab"));
  const panes = Array.from(document.querySelectorAll<HTMLDivElement>(".hp-schema-pane"));
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach((x) => {
        x.classList.remove("is-active");
        x.setAttribute("aria-selected", "false");
      });
      panes.forEach((p) => p.classList.remove("is-active"));
      tab.classList.add("is-active");
      tab.setAttribute("aria-selected", "true");
      const pane = document.querySelector(`.hp-schema-pane[data-pane="${target}"]`);
      pane?.classList.add("is-active");
    });
  });
</script>

<style>
  .hp {
    --hp-cream: #fcfaf5;
    --hp-cream-d: #f2eedf;
    --hp-line: #e5e0d5;
    --hp-text-1: #1a1a1a;
    --hp-text-2: #2a2622;
    --hp-text-3: #5a544d;
    --hp-text-4: #9a938a;
    --hp-brown: #8b4513;
    --hp-brown-deep: #6b340e;
    --hp-brown-light: #f5ebdc;
    --hp-green: #5c7a4a;
    --hp-code-bg: #1a1612;
    --hp-code-text: #d4cfc4;
    --hp-display: "Sora", system-ui, sans-serif;
    --hp-body: "Noto Sans JP", "Sora", system-ui, sans-serif;
