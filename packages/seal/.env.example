# Copy to `.env` and fill in real values before running
# `npm run register:circuit`. This file is committed; `.env` is not.

# Lemma API key — authenticates circuit registration with the workers API.
LEMMA_API_KEY=lemma_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pinata (IPFS) credentials — pin the compiled .wasm / .zkey artifacts.
# Create a key at https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key

# Optional — override the Lemma API base URL. Defaults to the SDK default
# (https://workers.lemma.workers.dev) when unset.
# LEMMA_API_BASE=http://localhost:8787
