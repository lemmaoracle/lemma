{
  "name": "@lemmaoracle/seal",
  "version": "0.3.5",
  "description": "Seal — ZK auth circuit for Lemma dashboard Proof-based sign-in. Proves knowledge of a secret pre-image without revealing the secret or its hash (v2: Poseidon nullifier).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vkey": {
      "types": "./dist/vkey.d.ts",
      "import": "./dist/vkey.js"
    }
  },
  "files": [
    "dist",
    "circuits/src/seal-identity.circom",
    "circuits/scripts/build.sh",
    "scripts/setup-toolchain.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:circuit": "cd circuits && npm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:circuit": "cd circuits && npx vitest run",
    "register:circuit": "tsx scripts/register-circuit.ts"
  },
  "keywords": [
    "lemma",
    "seal",
    "auth",
    "zk",
    "circuit",
    "sign-in"
  ],
  "dependencies": {
    "@lemmaoracle/sdk": "workspace:*",
    "@lemmaoracle/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/snarkjs": "^0.7.9",
    "dotenv": "16.4.7",
    "poseidon-lite": "0.3.0",
    "tsx": "^4.19.0",
    "typescript": "5.8.3",
    "vitest": "^3.1.1"
  },
  "author": "Lemma Oracle",
  "license": "MIT"
}
