{
  "name": "@lemmaoracle/verify",
  "version": "0.0.4",
  "description": "Verify — Lemma's verification SDK. Circuit-agnostic claim verification: proof guardrails, settlement (着金) checks, and future verification APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run"
  },
  "keywords": [
    "lemma",
    "verify",
    "verification",
    "guardrail",
    "settlement",
    "zk",
    "proof",
    "gate"
  ],
  "dependencies": {
    "@lemmaoracle/sdk": "workspace:^",
    "@lemmaoracle/spec": "workspace:^",
    "ramda": "^0.30.1"
  },
  "devDependencies": {
    "@types/ramda": "^0.30.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-functional": "^9.0.4",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
