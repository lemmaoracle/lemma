---
import Layout from "../layouts/Layout.astro";
import { SAMPLES, type Sample } from "../data/fixtures";
import {
  PIPELINE_FIXTURES,
  SCHEMA_FAMILY,
  SCHEMA_LABEL,
  formatRelative,
  truncateHash,
} from "../data/pipelineFixtures";
import { getTranslations, type Locale } from "../i18n/translations";
import pkg from "../../package.json";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const otherLocale: Locale = locale === "ja" ? "en" : "ja";
const otherLocaleHref = otherLocale === "ja" ? "/ja/" : "/";

const industryLabel = (sample: Sample): string => {
  if (sample.industry === "Financial") return t.sampleStrip.industryFinancial;
  if (sample.industry === "Manufacturing")
    return t.sampleStrip.industryManufacturing;
  return t.sampleStrip.industryAgent;
};

const statusLabel = (status: string): string => {
  switch (status) {
    case "received": return t.tabs.received;
    case "verifying": return t.tabs.verifying;
    case "verified": return t.tabs.verified;
    case "onchain": return t.tabs.onchain;
    case "rejected": return t.tabs.rejected;
    default: return status;
  }
};

const totalCount = PIPELINE_FIXTURES.length;
const showingLabel = t.table.showing.replace("{n}", String(totalCount));
---

<Layout locale={locale} title={t.meta.title} description={t.meta.description}>
  <div class="shell">
    <aside class="sidebar">
      <a class="brand" href={otherLocale === "ja" ? "/" : "/"}>
        <span class="brand-mark">L</span>
        <span class="brand-name">{t.brand.name}</span>
      </a>

      <nav class="sidebar-nav" aria-label="Sections">
        <a class="nav-item is-active" href="#overview">
          <svg
            class="nav-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="2" width="5.5" height="5.5" rx="1" />
            <rect x="8.5" y="2" width="5.5" height="5.5" rx="1" />
            <rect x="2" y="8.5" width="5.5" height="5.5" rx="1" />
            <rect x="8.5" y="8.5" width="5.5" height="5.5" rx="1" />
          </svg>
          {t.nav.overview}
        </a>
      </nav>

      <div class="sidebar-foot">
        <div class="status-line">
          <span class="status-dot network"></span>
          {t.footbar.network}
        </div>
        <div class="status-line is-faint">
          <span class="status-dot online"></span>
          {t.footbar.apiHealthy}
        </div>
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <h1 class="topbar-title">{t.topbar.title}</h1>
        <span class="topbar-sub">{t.topbar.subtitle}</span>
        <span class="topbar-spacer"></span>
        <div class="search">
          <svg
            class="search-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="7" cy="7" r="4.5" />
            <line x1="10.4" y1="10.4" x2="13.5" y2="13.5" />
          </svg>
          <input
            id="pipeline-search"
            class="search-input"
            type="search"
            placeholder={t.topbar.searchPlaceholder}
            autocomplete="off"
          />
        </div>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label={t.topbar.themeToggleLabel}
        >
          <svg
            class="theme-icon-sun"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3" />
            <line x1="8" y1="1.5" x2="8" y2="3" />
            <line x1="8" y1="13" x2="8" y2="14.5" />
            <line x1="1.5" y1="8" x2="3" y2="8" />
            <line x1="13" y1="8" x2="14.5" y2="8" />
            <line x1="3.2" y1="3.2" x2="4.3" y2="4.3" />
            <line x1="11.7" y1="11.7" x2="12.8" y2="12.8" />
            <line x1="3.2" y1="12.8" x2="4.3" y2="11.7" />
            <line x1="11.7" y1="4.3" x2="12.8" y2="3.2" />
          </svg>
          <svg
            class="theme-icon-moon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M13 9.5A5.5 5.5 0 0 1 6.5 3 5.5 5.5 0 1 0 13 9.5z" />
          </svg>
        </button>
        <a
          href={otherLocaleHref}
          class="theme-toggle"
          aria-label={t.topbar.langToggleLabel}
          style="width:auto;padding:0 10px;font-size:11px;color:var(--text-muted);"
        >
          {t.topbar.otherLocaleLabel}
        </a>
      </header>

      <section class="demo-banner" aria-label="Demo notice">
        <div class="demo-banner-headline">
          <span class="demo-pill">{t.demoBanner.pill}</span>
          <span class="demo-banner-title">{t.demoBanner.title}</span>
        </div>
        <span class="demo-banner-walkthrough">{t.demoBanner.walkthrough}</span>
        <p class="demo-banner-body">{t.demoBanner.body}</p>
      </section>

      <section class="sample-strip" aria-label={t.sampleStrip.label}>
        <div class="sample-strip-head">
          <span class="sample-strip-label">{t.sampleStrip.label}</span>
          <span class="sample-strip-hint">{t.sampleStrip.hint}</span>
        </div>
        <div class="sample-chips" role="group">
          {SAMPLES.map((sample) => {
            const copy = t.samples[sample.id];
            const label = copy ? copy.chip : sample.id;
            return (
              <button
                type="button"
                class="sample-chip"
                data-sample-id={sample.id}
                data-result={sample.expectedResult}
              >
                <span class="sample-chip-dot" aria-hidden="true"></span>
                <span class="sample-chip-industry">{industryLabel(sample)}</span>
                <span>·</span>
                <span>{label}</span>
              </button>
            );
          })}
        </div>
      </section>

      <section class="pipeline" id="overview">
        <div class="pipeline-headrow">
          <div class="tabs" role="tablist" aria-label="Pipeline filter">
            <button
              class="tab is-active"
              data-filter="all"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="pipeline-tabpanel"
            >
              {t.tabs.all}
            </button>
            <button
              class="tab"
              data-filter="received"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="pipeline-tabpanel"
            >
              {t.tabs.received}
            </button>
            <button
              class="tab"
              data-filter="verifying"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="pipeline-tabpanel"
            >
              {t.tabs.verifying}
            </button>
            <button
              class="tab"
              data-filter="verified"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="pipeline-tabpanel"
            >
              {t.tabs.verified}
            </button>
            <button
              class="tab"
              data-filter="onchain"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="pipeline-tabpanel"
            >
              {t.tabs.onchain}
            </button>
            <button
              class="tab"
              data-filter="rejected"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="pipeline-tabpanel"
            >
              {t.tabs.rejected}
            </button>
          </div>
          <span class="pipeline-count" id="pipeline-count">{showingLabel}</span>
        </div>

        <div
          class="table-wrap"
          id="pipeline-tabpanel"
          role="tabpanel"
          aria-label={t.topbar.title}
        >
          <div class="table-scroll">
            <table class="pipeline-table">
              <thead>
                <tr>
                  <th>{t.table.document}</th>
                  <th>{t.table.schema}</th>
                  <th>{t.table.status}</th>
                  <th class="col-chain">{t.table.chain}</th>
                  <th>{t.table.updated}</th>
                </tr>
              </thead>
              <tbody id="pipeline-tbody">
                {PIPELINE_FIXTURES.map((row) => (
                  <tr
                    data-doc-hash={row.docHash}
                    data-status={row.status}
                    data-schema={row.schema}
                  >
                    <td>
                      <span class="cell-hash">{truncateHash(row.docHash)}</span>
                    </td>
                    <td>
                      <span class="cell-schema">
                        <span class={`schema-dot ${SCHEMA_FAMILY[row.schema]}`}></span>
                        {SCHEMA_LABEL[row.schema]}
                      </span>
                    </td>
                    <td>
                      <span class={`status-pill ${row.status}`}>
                        {statusLabel(row.status)}
                      </span>
                    </td>
                    <td class="col-chain cell-chain">{row.chain}</td>
                    <td class="cell-updated" data-iso={row.updatedAt}>
                      {formatRelative(row.updatedAt)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <footer class="footbar">
        <span class="footbar-item">
          <span class="status-dot network"></span>
          {t.footbar.network}
        </span>
        <span class="footbar-item">
          <span class="status-dot online"></span>
          {t.footbar.apiHealthy}
        </span>
        <span class="footbar-item is-faint">
          {t.footbar.browserOnly} · {t.brand.demoBadge} {t.brand.versionPrefix}{pkg.version}
        </span>
        <span class="footbar-spacer"></span>
        <a class="footbar-link" href={t.footbar.githubHref} target="_blank" rel="noopener">
          {t.footbar.github}
        </a>
        <a class="footbar-link" href={t.footbar.privacyHref} rel="noopener">
          {t.footbar.privacy}
        </a>
        <a class="footbar-link" href={t.footbar.micrositeHref} rel="noopener">
          {t.footbar.microsite}
        </a>
      </footer>
    </div>
  </div>

  <div class="detail-overlay" id="detail-overlay" aria-hidden="true"></div>
  <aside
    class="detail"
    id="detail"
    role="dialog"
    aria-labelledby="detail-title"
    aria-hidden="true"
  >
    <div class="detail-head">
      <h2 class="detail-title" id="detail-title"></h2>
      <button
        type="button"
        class="detail-close"
        id="detail-close"
        aria-label={t.detail.closeLabel}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="2.5" y1="2.5" x2="9.5" y2="9.5" />
          <line x1="9.5" y1="2.5" x2="2.5" y2="9.5" />
        </svg>
      </button>
    </div>
    <div class="detail-body" id="detail-body"></div>
  </aside>

  <script
    define:vars={{
      locale,
      i18n: t,
      schemaFamily: SCHEMA_FAMILY,
      schemaLabel: SCHEMA_LABEL,
    }}
  >
    window.__LEMMA_DEMO_I18N__ = {
      locale,
      i18n,
      schemaFamily,
      schemaLabel,
    };
  </script>
  <script>
    import { mount } from "../scripts/main";
    mount();
  </script>
</Layout>
