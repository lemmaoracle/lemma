---
/**
 * Industry icon next to the sample chooser's industry-label (spec v0.3.3
 * scenario icons). Inline SVG, 16x16, currentColor stroke so the icon
 * inherits the accent color from the .industry-label rule. Decorative —
 * `aria-hidden="true"` so the text label remains the accessible source
 * of truth.
 *
 * Locked vocabulary mirrors `Industry` in `data/fixtures.ts` (spec §3a):
 * Financial / Manufacturing / Agent.
 */
import type { Industry } from "../data/fixtures";

export interface Props {
  industry: Industry;
}

const { industry } = Astro.props;
---

{industry === "Financial" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" class="industry-icon">
    <path d="M3 21h18" />
    <path d="M3 10h18" />
    <path d="M12 3 2.5 9.5" />
    <path d="M12 3l9.5 6.5" />
    <path d="M5 10v8" />
    <path d="M9.5 10v8" />
    <path d="M14.5 10v8" />
    <path d="M19 10v8" />
  </svg>
)}
{industry === "Manufacturing" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" class="industry-icon">
    <path d="M3 21V11l5 3V11l5 3V11l5 3V7l3-2v16Z" />
    <path d="M3 21h18" />
    <path d="M7.5 17h1" />
    <path d="M12 17h1" />
    <path d="M16.5 17h1" />
  </svg>
)}
{industry === "Agent" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" class="industry-icon">
    <circle cx="12" cy="5" r="2" />
    <circle cx="5" cy="19" r="2" />
    <circle cx="19" cy="19" r="2" />
    <path d="M12 7v2.5" />
    <path d="M11 9.5 6.4 17.2" />
    <path d="M13 9.5l4.6 7.7" />
    <path d="M7 19h10" />
  </svg>
)}

<style>
  .industry-icon {
    display: inline-block;
    flex-shrink: 0;
  }
</style>
