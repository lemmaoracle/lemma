---
import "../styles/global.css";
import type { Locale } from "../i18n/translations";

export interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;

const canonicalRoot = "https://demo-lemma.frame00.com";
const canonical = locale === "ja" ? `${canonicalRoot}/ja/` : `${canonicalRoot}/`;
const enHref = `${canonicalRoot}/`;
const jaHref = `${canonicalRoot}/ja/`;
---

<!doctype html>
<html lang={locale === "ja" ? "ja" : "en"} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ja" href={jaHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Theme preference: read persisted choice, otherwise honour
      // prefers-color-scheme. Falls back to "dark" since the dashboard
      // demo reads better against a dark canvas.
      (function () {
        try {
          var saved = window.localStorage.getItem("lemma-demo-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
            return;
          }
        } catch (_) {
          /* localStorage may throw in private modes */
        }
        var prefersLight =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.dataset.theme = prefersLight
          ? "light"
          : "dark";
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
