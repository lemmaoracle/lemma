---
import Layout from "../layouts/Layout.astro";
import { SAMPLES } from "../data/fixtures";

// Group samples by industry, preserving fixture order.
const grouped = (() => {
  const map = new Map<string, typeof SAMPLES>();
  for (const s of SAMPLES) {
    const list = map.get(s.industry) ?? [];
    map.set(s.industry, [...list, s] as typeof SAMPLES);
  }
  return Array.from(map.entries());
})();
---

<Layout>
  <header class="hero">
    <div class="hero-inner">
      <div class="eyebrow">Provenance verification</div>
      <h1 class="hero-h1">Models change.<br />Proofs remain.</h1>
      <p class="lead">
        Verify that an AI output came from a specific model, with a specific
        input, under a specific policy.
      </p>
      <p class="equation">Finds bugs ≠ proves decisions.</p>
    </div>
  </header>

  <main class="main">
    <section class="section">
      <h2 class="section-h2">Pick a sample</h2>
      <p class="section-sub">
        Six bundled samples cover three industries with one valid and one
        invalid pair each. Or upload your own proof bundle — verification runs
        entirely in your browser.
      </p>

      <div class="samples" role="radiogroup" aria-label="Sample chooser">
        {grouped.map(([industry, items]) => (
          <div class="industry-group">
            <div class="industry-label">{industry}</div>
            {items.map((sample) => (
              <label class="sample">
                <input
                  type="radio"
                  name="sample"
                  value={sample.id}
                  data-sample-id={sample.id}
                />
                <div class="sample-content">
                  <div class="sample-title">{sample.label}</div>
                  <div class="sample-summary">{sample.summary}</div>
                </div>
                <div
                  class={`sample-tag sample-tag-${sample.expectedResult}`}
                  aria-hidden="true"
                >
                  {sample.expectedResult === "pass" ? "Valid" : "Invalid"}
                </div>
              </label>
            ))}
          </div>
        ))}
      </div>

      <div class="custom-upload">
        <label class="custom-upload-label">
          <input
            type="file"
            id="custom-file"
            accept="application/json,.json"
          />
          <span class="custom-upload-cta">Upload a custom proof JSON</span>
          <span class="custom-upload-note" id="custom-file-name"
            >Stays in your browser. We never receive the file.</span
          >
        </label>
      </div>

      <div class="verify-row">
        <button id="verify-btn" class="btn-primary" type="button" disabled>
          Verify
        </button>
        <span class="verify-hint" id="verify-hint">Pick a sample to begin.</span>
      </div>
    </section>

    <section class="section result-section" aria-live="polite">
      <div id="result" class="result hidden">
        <div class="result-header">
          <div class="result-overall" id="result-overall"></div>
          <div class="result-time" id="result-time"></div>
        </div>
        <ol class="result-checks" id="result-checks"></ol>
        <p class="result-failure hidden" id="result-failure"></p>
      </div>

      <div class="cta-row hidden" id="cta-row">
        <a
          class="cta cta-sales"
          id="cta-sales"
          href="https://lemma.frame00.com/services/?utm_source=demo&utm_medium=web&utm_campaign=cyberlabs_response"
          target="_blank"
          rel="noopener"
        >
          <div class="cta-label">Enterprise</div>
          <div class="cta-title">Talk to us about your use case</div>
        </a>
        <a
          class="cta cta-waitlist"
          id="cta-waitlist"
          href="https://tally.so/r/kd0bZR?utm_source=demo&utm_medium=web&utm_campaign=cyberlabs_response"
          target="_blank"
          rel="noopener"
        >
          <div class="cta-label">Builders</div>
          <div class="cta-title">Join Trust402 waitlist</div>
        </a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-tagline">Built for decisions that matter.</div>
    <ul class="footer-links">
      <li>
        <a href="https://lemma.frame00.com/" rel="noopener">Lemma microsite</a>
      </li>
      <li>
        <a
          href="https://github.com/lemmaoracle/lemma"
          target="_blank"
          rel="noopener">GitHub</a
        >
      </li>
      <li>
        <a href="https://lemma.frame00.com/privacy" rel="noopener">Privacy</a>
      </li>
    </ul>
    <div class="footer-note">
      Verification runs entirely in your browser. Files you upload never reach
      our servers.
    </div>
  </footer>

  <script>
    import { mount } from "../scripts/main";
    mount();
  </script>
</Layout>

<style>
  .hero {
    background: var(--black);
    color: var(--white);
    padding: 96px 8% 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .hero-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-lt);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--accent-lt);
    display: block;
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 6.5vw, 80px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 32px;
    color: var(--white);
  }
  .lead {
    font-size: 19px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 640px;
    margin: 0 0 24px;
  }
  .equation {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--accent-lt);
    margin: 0;
  }

  .main {
    max-width: 880px;
    margin: 0 auto;
    padding: 80px 8% 40px;
  }

  .section {
    margin-bottom: 64px;
  }
  .section-h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 36px);
    font-weight: 500;
    color: var(--black);
    margin: 0 0 12px;
  }
  .section-sub {
    font-size: 15px;
    color: var(--gray-500);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 0 36px;
  }

  /* ─── Sample chooser ─── */
  .samples {
    display: grid;
    gap: 20px;
  }
  .industry-group {
    display: grid;
    gap: 8px;
  }
  .industry-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .sample {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border: 1px solid var(--gray-200);
    background: var(--white);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .sample:hover {
    border-color: var(--accent-lt);
    background: var(--accent-bg);
  }
  .sample input[type="radio"] {
    margin: 0;
    accent-color: var(--accent);
  }
  .sample input[type="radio"]:checked ~ * {
    /* visual emphasis carried via outer rule */
  }
  .sample:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-bg);
  }
  .sample-content {
    min-width: 0;
  }
  .sample-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--black);
  }
  .sample-summary {
    font-size: 13px;
    color: var(--gray-500);
    margin-top: 2px;
  }
  .sample-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid currentColor;
  }
  .sample-tag-pass {
    color: var(--green);
  }
  .sample-tag-fail {
    color: var(--red);
  }

  .custom-upload {
    margin-top: 24px;
    padding: 20px;
    border: 1px dashed var(--gray-200);
  }
  .custom-upload-label {
    display: grid;
    gap: 4px;
    cursor: pointer;
  }
  .custom-upload-label input {
    display: none;
  }
  .custom-upload-cta {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    border-bottom: 1px solid rgba(139, 69, 19, 0.28);
    padding-bottom: 1px;
    width: fit-content;
  }
  .custom-upload-label:hover .custom-upload-cta {
    border-bottom-color: var(--accent);
  }
  .custom-upload-note {
    font-size: 12px;
    color: var(--gray-500);
  }

  /* ─── Verify ─── */
  .verify-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--black);
    color: var(--white);
    padding: 14px 32px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .btn-primary:hover:not(:disabled) {
    background: var(--accent);
  }
  .btn-primary:disabled {
    background: var(--gray-200);
    color: var(--gray-500);
    cursor: not-allowed;
  }
  .verify-hint {
    font-size: 12px;
    color: var(--gray-500);
  }

  /* ─── Result ─── */
  .result {
    border: 1px solid var(--gray-200);
    background: var(--gray-50);
    padding: 32px;
    margin-bottom: 32px;
  }
  .result.hidden,
  .cta-row.hidden,
  .result-failure.hidden {
    display: none;
  }
  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .result-overall {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .result-overall.pass {
    color: var(--green);
  }
  .result-overall.fail {
    color: var(--red);
  }
  .result-time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gray-500);
  }
  .result-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .result-check {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--gray-200);
  }
  .result-check:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .result-check-icon {
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .result-check-icon.pass {
    color: var(--green);
  }
  .result-check-icon.fail {
    color: var(--red);
  }
  .result-check-icon.skip {
    color: var(--gray-500);
  }
  .result-check-label {
    font-size: 14px;
    color: var(--gray-800);
  }
  .result-check-scheme {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--gray-500);
    text-align: right;
  }
  .result-failure {
    margin-top: 24px;
    padding: 16px;
    border-left: 2px solid var(--red);
    background: rgba(184, 50, 59, 0.06);
    font-size: 14px;
    color: var(--gray-800);
  }

  /* ─── CTAs ─── */
  .cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .cta {
    border: 1px solid var(--gray-200);
    padding: 24px 28px;
    background: var(--white);
    color: inherit;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .cta:hover {
    border-color: var(--accent);
    background: var(--accent-bg);
  }
  .cta-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .cta-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--black);
  }

  /* ─── Footer ─── */
  .footer {
    border-top: 1px solid var(--gray-200);
    padding: 48px 8% 56px;
    text-align: center;
  }
  .footer-tagline {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--black);
    margin-bottom: 16px;
  }
  .footer-links {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--gray-500);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .footer-links a:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }
  .footer-note {
    font-size: 11px;
    color: var(--gray-500);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .hero {
      padding: 72px 6% 56px;
    }
    .main {
      padding: 56px 6% 32px;
    }
    .sample {
      grid-template-columns: 22px 1fr;
      grid-template-rows: auto auto;
    }
    .sample-tag {
      grid-column: 2;
      justify-self: start;
    }
    .cta-row {
      grid-template-columns: 1fr;
    }
    .result-check {
      grid-template-columns: 22px 1fr;
    }
    .result-check-scheme {
      grid-column: 2;
      text-align: left;
      margin-top: 4px;
    }
  }
</style>
