  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemmaoracle/lemma.git",
    "directory": "packages/fetcher"
  },
  "homepage": "https://github.com/lemmaoracle/lemma/tree/main/packages/fetcher#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
