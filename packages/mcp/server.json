{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lemmaoracle/mcp",
  "description": "Query ZK-verified attributes, selective disclosure, and on-chain provenance from Lemma Oracle.",
  "repository": {
    "url": "https://github.com/lemmaoracle/lemma",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "websiteUrl": "https://lemma.frame00.com",
  "version": "0.0.14",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@lemmaoracle/mcp",
      "version": "0.0.14",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LEMMA_API_KEY",
          "description": "Lemma API key (Bearer token).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "LEMMA_API_BASE",
          "description": "Optional API base URL. Defaults to production endpoint.",
          "isRequired": false
        }
      ]
    }
  ]
}
